e': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Public Broadcasting Service', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Great British Baking Show (TV Program)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Berry, Mary (1935- )', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Hollywood, Paul', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-12-27T21:27:12+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5fef5428-3d89-5e97-ad1a-e1a6b45fceef', 'word_count': 163, 'uri': 'nyt://article/5fef5428-3d89-5e97-ad1a-e1a6b45fceef'}, {'abstract': 'The Clarion Music Society and the New York String Orchestra offer a transcendental way to usher out the old and welcome in the new.', 'web_url': 'https://www.nytimes.com/2014/12/28/arts/music/new-years-vespers-and-youth-strings.html', 'snippet': 'The Clarion Music Society and the New York String Orchestra offer a transcendental way to usher out the old and welcome in the new.', 'lead_paragraph': 'Steven Fox and the Clarion Music Society offer a transcendental way to usher out the old and welcome in the new, with performances of Rachmaninoff’s Vespers (also known as the All Night Vigil) on New Year’s Eve and New Year’s Day. The a cappella work is austere compared with the lush Romanticism of Rachmaninoff’s virtuoso piano works, but the setting of traditional texts from the canonical hours of the Russian Orthodox Church is harmonically gorgeous. (6 p.m., Dec. 31 and Jan. 1, Trinity Church, Broadway and Wall Street, 212-602-0800, clarionsociety.org.)', 'print_section': 'AR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/28/arts/28GUIDE3/28GUIDE3-articleLarge.jpg', 'height': 233, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/12/28/arts/28GUIDE3/28GUIDE3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 233}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/28/arts/28GUIDE3/28GUIDE3-jumbo.jpg', 'height': 398, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/28/arts/28GUIDE3/28GUIDE3-superJumbo.jpg', 'height': 797, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/28/arts/28GUIDE3/28GUIDE3-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/12/28/arts/28GUIDE3/28GUIDE3-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/28/arts/28GUIDE3/28GUIDE3-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'New Year’s Vespers and Youth Strings', 'kicker': 'Classical', 'content_kicker': None, 'print_headline': 'New Year’s Vespers and Youth Strings', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Classical Music', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Clarion Music Society', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Fox, Steven (1978- )', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Rachmaninoff, Sergei', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Trinity Church (Manhattan, NY)', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'New York String Orchestra', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Laredo, Jaime', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Carnegie Hall', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Hadelich, Augustin', 'rank': 9, 'major': 'N'}], 'pub_date': '2014-12-27T21:27:12+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Vivien Schweitzer', 'person': [{'firstname': 'Vivien', 'middlename': None, 'lastname': 'Schweitzer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ddaa9f88-7b72-5ce7-af40-e04b09df9a61', 'word_count': 150, 'uri': 'nyt://article/ddaa9f88-7b72-5ce7-af40-e04b09df9a61'}, {'abstract': 'In “The Shell-Shocked Nut,” a war veteran with post-traumatic stress disorder finds herself on a bench in a park.', 'web_url': 'https://www.nytimes.com/2014/12/28/arts/dance/a-war-informed-nutcracker.html', 'snippet': 'In “The Shell-Shocked Nut,” a war veteran with post-traumatic stress disorder finds herself on a bench in a park.', 'lead_paragraph': 'The East Village has a “Nutcracker” of its own and, fittingly, it’s on the gritty side. In “The Shell-Shocked Nut” — conceived and directed by Martha Tornay, the artistic director of the East Village Dance Project — a war veteran with post-traumatic stress disorder finds herself on a bench in a park. There’s a blizzard; a child appears to comfort her, and they travel to classic spots in the East Village. The production, with performers between the ages of 4 and 60, was conceived after Hurricane Sandy. Even though there was no heat in her dance studio, Ms. Tornay held classes; one student requested that they learn choreography from “The Nutcracker.” Afterward, she recalled in an interview, they were beaming. “I started thinking about that cathartic process of working through a stressful situation,” Ms. Tornay said. That year, she made a 30-minute version for parents. Now, the work runs over an hour. (7 p.m. Jan. 2, 3 p.m. and 7 p.m. Jan. 3, 3 p.m. Jan 4., La MaMa Ellen Stewart Theater, 66 East Fourth Street, East Village; 646-430-5374, eastvillagedanceproject.com.)', 'print_section': 'AR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/28/arts/28GUIDE7/28GUIDE7-articleLarge.jpg', 'height': 599, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/12/28/arts/28GUIDE7/28GUIDE7-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 599}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/28/arts/28GUIDE7/28GUIDE7-jumbo.jpg', 'height': 1022, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/28/arts/28GUIDE7/28GUIDE7-superJumbo.jpg', 'height': 1795, 'width': 1799, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/28/arts/28GUIDE7/28GUIDE7-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/12/28/arts/28GUIDE7/28GUIDE7-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/28/arts/28GUIDE7/28GUIDE7-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'l