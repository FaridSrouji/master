h': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/20/sports/Y-BECKLEY/Y-BECKLEY-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/12/20/sports/Y-BECKLEY/Y-BECKLEY-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/20/sports/Y-BECKLEY/Y-BECKLEY-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Trading to Win Now (Mavericks) and Later (Celtics)', 'kicker': 'Analysis', 'content_kicker': None, 'print_headline': 'Trading to Win Now (Mavericks) and Later (Celtics)', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Mason, Beckley', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Basketball', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Rondo, Rajon', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Crowder, Jae', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Nelson, Jameer', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Wright, Brandan', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Nowitzki, Dirk', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Carlisle, Rick', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Boston Celtics', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'Dallas Mavericks', 'rank': 10, 'major': 'N'}], 'pub_date': '2014-12-19T16:09:09+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Basketball', 'byline': {'original': 'By Beckley Mason', 'person': [{'firstname': 'Beckley', 'middlename': None, 'lastname': 'Mason', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/493a4786-39b8-5de3-bee7-504c4960ec66', 'word_count': 855, 'uri': 'nyt://article/493a4786-39b8-5de3-bee7-504c4960ec66'}, {'abstract': 'Héctor Tobar, whose “Deep Down Dark” is No. 15 on the hardcover nonfiction list, worked alongside Michael Connelly when they were both young reporters for the Los Angeles Times.', 'web_url': 'https://www.nytimes.com/2014/12/28/books/review/inside-the-list.html', 'snippet': 'Héctor Tobar, whose “Deep Down Dark” is No. 15 on the hardcover nonfiction list, worked alongside Michael Connelly when they were both young reporters for the Los Angeles Times.', 'lead_paragraph': 'Bidding Adiós: Héctor Tobar’s new book, “Deep Down Dark” — about the 2010 mine collapse that trapped 33 workers beneath the Chilean desert for months — enters the hardcover nonfiction list at No. 15. If you lived in Southern California in the 1990s, as I did, and paid any attention to newspaper journalism, you quickly learned to seek out Tobar’s byline in The Los Angeles Times. Whether reporting on murder trials or lottery winners, Tobar had an eye for humanizing details: the wife in the back of the courtroom reading a book about her husband’s case, say, or the small African-\xadAmerican barbershop persevering as its neighborhood became increasingly Latino. Those were glory days at the newspaper; Tobar sometimes shared a byline with a young crime reporter named Michael Connelly. But in September, Tobar — the son of Guatemalan immigrants, whose father used to deliver The Times — announced he was leaving after more than 20 years to teach at the University of Oregon. He does plan to keep writing books. (“Deep Down Dark” is his fourth, after a couple of novels and “Translation Nation,” a look at Spanish-speaking communities across America.) “For the first time in my life,” he explained on Facebook, “I gave myself permission to think of myself as an artist — not an easy thing for me or any other son of immigrants to do.”', 'print_section': 'BR', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/21/books/review/21tobar/21tobar-jumbo.jpg', 'height': 450, 'width': 455, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/21/books/review/21tobar/21tobar-superJumbo.jpg', 'height': 450, 'width': 455, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/21/books/review/21tobar/21tobar-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/12/21/books/review/21tobar/21tobar-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/21/books/review/21tobar/21tobar-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Inside the List', 'kicker': None, 'content_kicker': None, 'print_headline': 'Inside the List', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Tobar, Hector', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-12-19T16:10:03+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Gregory Cowles', 'person': [{'firstname': 'Gregory', 'middlename': None, 'lastname': 'Cowles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}