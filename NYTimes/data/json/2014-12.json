ank': 14, 'major': 'N'}, {'name': 'persons', 'value': 'Keaton, Michael', 'rank': 15, 'major': 'N'}, {'name': 'persons', 'value': 'McConaughey, Matthew', 'rank': 16, 'major': 'N'}, {'name': 'persons', 'value': 'Nolan, Christopher', 'rank': 17, 'major': 'N'}, {'name': 'persons', 'value': 'Russo, Rene', 'rank': 18, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 19, 'major': 'N'}], 'pub_date': '2014-12-03T22:43:48+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Frank Bruni and Ross Douthat', 'person': [{'firstname': 'Frank', 'middlename': None, 'lastname': 'Bruni', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Ross', 'middlename': None, 'lastname': 'Douthat', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bd1c04af-bb08-5ae3-9179-ec11e1f3c256', 'word_count': 3119, 'uri': 'nyt://article/bd1c04af-bb08-5ae3-9179-ec11e1f3c256'}, {'abstract': 'Iron From Ice is the first installment of a video game based on the TV show “Game of Thrones.”', 'web_url': 'https://www.nytimes.com/2014/12/04/arts/video-games/video-game-review-game-of-thrones-iron-from-ice.html', 'snippet': 'Iron From Ice is the first installment of a video game based on the TV show “Game of Thrones.”', 'lead_paragraph': 'To a viewer of prestige cable, Iron From Ice, the first episode of the new Game of Thrones video game, might seem inferior to HBO’s “Game of Thrones” in nearly every way imaginable. The writing is worse. The acting is worse. The scenery and cinematography — animated instead of captured with a camera — are less gorgeous. There is no frequent, graphic sex to punctuate the conniving and the swordplay.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, '