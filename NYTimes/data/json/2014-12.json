 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Ailing U.N. News Service Gets $25 Million', 'kicker': None, 'content_kicker': None, 'print_headline': 'Ailing U.N. News Service Gets $25 Million', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Cumming-Bruce, Nick', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Integrated Regional Information Networks (IRIN)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Jynwel Foundation', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Low, Jho', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'United Nations', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'News and News Media', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Philanthropy', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Nonprofit Organizations', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Hong Kong', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Geneva (Switzerland)', 'rank': 10, 'major': 'N'}], 'pub_date': '2014-12-01T02:05:45+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Nick Cumming-Bruce', 'person': [{'firstname': 'Nick', 'middlename': None, 'lastname': 'Cumming-Bruce', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e0afc8b4-8239-5773-bbac-889375426d9e', 'word_count': 645, 'uri': 'nyt://article/e0afc8b4-8239-5773-bbac-889375426d9e'}, {'abstract': 'Embedding reporters with soldiers was fraught with risk, ethical dilemmas and a fair share of drama.', 'web_url': 'https://www.nytimes.com/2014/12/01/opinion/ground-wars-end-and-so-does-a-chapter-in-military-press-relationships.html', 'snippet': 'Embedding reporters with soldiers was fraught with risk, ethical dilemmas and a fair share of drama.', 'lead_paragraph': 'During the eight years I covered the wars in Iraq and Afghanistan, I came to see being embedded with American military units as a bit like going on blind dates.', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/12/opinion/12observer1/12observer1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/12/12/opinion/12observer1/12observer1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/12/opinion/12observer1/12observer1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/12/opinion/12observer1/12observer1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/12/opinion/12observer1/12observer1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/12/12/opinion/12observer1/12observer1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/12/opinion/12observer1/12observer1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Ground Wars End, and So Does a Chapter in Military-Press Relationships', 'kicker': None, 'content_kicker': None, 'print_headline': 'Ground Wars End, and So Does a Chapter in Military-Press Relationships', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Londono, Ernesto', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Iraq War (2003-11)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Afghanistan War (2001- )', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'News and News Media', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Ethics (Personal)', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'AFGHANISTAN', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Iraq', 'rank': 9, 'major': 'N'}], 'pub_date': '2014-12-01T02:06:32+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By Ernesto Londoño', 'person': [{'firstname': 'Ernesto', 'middlename': None, 'lastname': 'Londoño', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/570d3e18-fb63-53e9-90fa-ede14028b16b', 'word_count': 946, 'uri': 'nyt://article/570d3e18-fb63-53e9-90fa-ede14028b16b'}, {'abstract': 'As frequencies become more valuable, the government should make sure spectrum is used efficiently.', 'web_url': 'https://www.nytimes.com/2014/12/01/opinion/a-blockbuster-wireless-auction.html', 'snippet': 'As frequencies become more valuable, the government should make sure spectrum is used efficiently.', 'lead_paragraph': 'The eye-popping bids in the current auction of wireless frequencies by the Federal Communications Commission are a testament to soaring demand for mobile Internet service. As of last week, bids in the auction exceeded $38 billion, far more than the $10.5 billion reserve price set by the F.C.C. These frequencies, also known as spectrum, are needed to expand cellular networks so they can carry more phone calls and data.', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Blockbuster Wireless Auction', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'A Blockbuster Wireless Auction', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Radio Spectrum', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Wireless Communications', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Federal Communications Commission', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Net Neutrality', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Telephones and Telecommunications', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 8, 'major': 'N'}], 'pub_date': '2014-12-01T02:08:15+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/f9cc7e0b-c882-58db-8f40-9e144a6b3849', 'word_count': 490, 'uri': 'nyt://article/f9cc7e0b-c882-58db-8f40-9e144a6b3849'}, {'abstract': 'Pregnant workers should not be treated worse than employees who are injured on the job.', 'web_url': 'https://www.nytimes.com/2014/12/01/opinion/women-who-work.html', 'snippet': 'Pregnant workers should not be treated worse than employees who are injured on the job.', 'lead_paragraph': 'If Peggy Young, who was a driver for United Parcel Service, had had an accident that limited her ability to lift heavy packages, or even lost her license because of driving while intoxicated, U.P.S. would have allowed her to go on “light duty” or assigned her another type of work. But Ms. Young got pregnant. When her doctors told her not to lift packages over 20 pounds to avoid jeopardizing the pregnancy, U.P.S. refused to accommodate her and effectively compelled her to go on unpaid medical leave. ', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/12/opinion/12mon1/12mon1-articleLarge.jpg', 'height': 470, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/12/12/opinion/12mon1/12mon1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 470}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/12/opinion/12mon1/12mon1-jumbo.jpg', 'height': 802, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/12/opinion/12mon1/12mon1-superJumbo.jpg', 'height': 1605, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/12/opinion/12mon1/12mon1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/12/12/opinion/12mon1/12mon1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/12/opinion/12mon1/12mon1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Women Who Work', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Women Who Work', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'valu