: 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e6ec4bfe-5af2-5624-a466-7e86348f4281', 'word_count': 324, 'uri': 'nyt://article/e6ec4bfe-5af2-5624-a466-7e86348f4281'}, {'abstract': 'An archaeological team and a documentary crew get stuck in an ancient Egyptian tomb in “The Pyramid,” starring Denis O’Hare and Ashley Hinshaw.', 'web_url': 'https://www.nytimes.com/2014/12/06/arts/the-pyramid-with-denis-ohare-and-ashley-hinshaw.html', 'snippet': 'An archaeological team and a documentary crew get stuck in an ancient Egyptian tomb in “The Pyramid,” starring Denis O’Hare and Ashley Hinshaw.', 'lead_paragraph': 'In “The Pyramid,” an archaeological team and a documentary crew get stuck in an ancient Egyptian tomb that is armed with booby traps and protected by feral, inbred cats. Clearly, this is not a situation to which logic applies. The movie nevertheless adds a veneer of realism, setting the action during the unrest of August 2013. ', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Don’t Say That Word (It Might Come True) ', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'Don’t Say That Word (It Might Come True)', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Hinshaw, Ashley (1988- )', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Nicola, Christa Marie', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': "O'Hare, Denis (1962- )", 'rank': 4, 'major': 'N'}], 'pub_date': '2014-12-05T23:29:11+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Movies', 'byline': {'original': 'By Ben Kenigsberg', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Kenigsberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/0acf4c93-d282-536b-a65c-3cfada0cc550', 'word_count': 241, 'uri': 'nyt://article/0acf4c93-d282-536b-a65c-3cfada0cc550'}, {'abstract': 'The 1927 Ford Model T had been converted for use in the snow and was part of a scientific expedition in the late 1920s.', 'web_url': 'https://www.nytimes.com/2014/12/07/automobiles/labradors-first-snowmobile-heads-down-the-comeback-trail.html', 'snippet': 'The 1927 Ford Model T had been converted for use in the snow and was part of a scientific expedition in the late 1920s.', 'lead_paragraph': 'Scattered in a small clearing in the wilds of northeastern Canada, on the edge of the North Atlantic, a small automotive treasure has been recovered: a Ford Model T that had skis in place of its front wheels. Rescued from the boreal forest where it had been stuck since 1928, much of the time covered in snow, “Labrador’s first snowmobile,” as it is locally known, is undergoing restoration with the goal of having it run on the snowy landscape again.', 'print_section': 'AU', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/07/automobiles/SNOW1/SNOW1-articleLarge.jpg', 'height': 315, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/12/07/automobiles/SNOW1/SNOW1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 315}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/07/automobiles/SNOW1/SNOW1-jumbo.jpg', 'height': 538, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/07/automobiles/SNOW1/SNOW1-superJumbo.jpg', 'height': 682, 'width': 1297, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail',