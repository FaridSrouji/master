 police said.', 'print_section': 'A', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Uber Driver in India, Accused of Rape, Faces Other Charges', 'kicker': None, 'content_kicker': None, 'print_headline': 'Uber Driver in India, Accused of Rape, Faces Other Charges', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Sex Crimes', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Najar, Nida', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New Delhi (India)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Raj, Suhasini', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Uber Technologies Inc', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Yadav, Shiv Kumar', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Car Services and Livery Cabs', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Taxicabs and Taxicab Drivers', 'rank': 8, 'major': 'N'}], 'pub_date': '2014-12-09T15:33:09+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Nida Najar and Suhasini Raj', 'person': [{'firstname': 'Nida', 'middlename': None, 'lastname': 'Najar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Suhasini', 'middlename': None, 'lastname': 'Raj', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/55314135-8ea1-5ccc-99b0-c02c53b0857a', 'word_count': 641, 'uri': 'nyt://article/55314135-8ea1-5ccc-99b0-c02c53b0857a'}, {'abstract': 'Highlights from the report and reaction from across the political spectrum.', 'web_url': 'https://news.blogs.nytimes.com/2014/12/09/cia-torture-report/', 'snippet': 'Highlights from the report and reaction from across the political spectrum.', 'lead_paragraph': 'The Senate Intelli