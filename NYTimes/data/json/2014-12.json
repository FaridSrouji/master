ame': None, 'lastname': 'Grimes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f0dd38e9-572b-52c0-909b-9d45caa1e6d2', 'word_count': 1406, 'uri': 'nyt://article/f0dd38e9-572b-52c0-909b-9d45caa1e6d2'}, {'abstract': 'The reopened Cooper Hewitt, Smithsonian Design Museum lets visitors play with their own design ideas in new interactive exhibitions.', 'web_url': 'https://www.nytimes.com/2014/12/12/arts/design/cooper-hewitt-smithsonian-design-museum-reopens.html', 'snippet': 'The reopened Cooper Hewitt, Smithsonian Design Museum lets visitors play with their own design ideas in new interactive exhibitions.', 'lead_paragraph': 'On Friday, Dec. 12, 1902, Andrew Carnegie moved into his just-finished home at 91st Street and Fifth Avenue, with his wife, Louise, and his 5-year-old daughter, Margaret, to whom he handed the key. By the lights of Manhattan society, the house was in nowheresville, near a former shantytown with only a lemonade stand by way of local shopping. No problem. Wherever Carnegie, a 5-foot-2 master of the universe type, decided to settle became a someplace soon.', 'print_section': 'C', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Newly Playful, by Design', 'kicker': 'Critic’s Notebook', 'content_kicker': None, 'print_headline': 'Newly Playful, by Design', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Cooper Hewitt, Smithsonian Design Museum', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Cotter, Holland', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Design', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Museums', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Carnegie, Andrew', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Kalman, Maira', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Lupton, Ellen', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Manhattan (NYC)', 'rank': 9, 'major': 'N'}], 'pub_date': '2014-12-11T21:23:15+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Holland Cotter', 'person': [{'firstname': 'Holland', 'middlename': None, 'lastname': 'Cotter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ad941933-1998-5ff8-b8f3-ceb9985d597b', 'word_count': 1535, 'uri': 'nyt://article/ad941933-1998-5ff8-b8f3-ceb9985d597b'}, {'abstract': 'This group show explores the gap between painting and sculpture.', 'web_url': 'https://www.nytimes.com/2014/12/12/arts/design/animal-mineral-vegetable.html', 'snippet': 'This group show explores the gap between painting and sculpture.', 'lead_paragraph': 'A familiar 1970s aura hangs over this show of six artists, without dampening its liveliness. Unidentifiable objects — as the title implies — seem to be a goal, along with further adventures in the densely populated gap between painting and sculpture.', 'print_section': 'C', 'print_page': '29', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/12/arts/12ANDREWKREPS-GALLERY3/ANDREWKREPS-GALLERY3-articleLarge.jpg', 'height': 755, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/12/12/arts/12ANDREWKREPS-GALLERY3/ANDREWKREPS-GALLERY3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 755}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/12/arts/12ANDREWKREPS-GALLERY3/ANDREWKREPS-GALLERY3-jumbo.jpg', 'height': 1024, 'width': 814, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'