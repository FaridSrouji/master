/arts/BOOK/BOOK-articleLarge.jpg', 'height': 877, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/12/30/arts/BOOK/BOOK-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 877}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/30/arts/BOOK/BOOK-jumbo.jpg', 'height': 1024, 'width': 701, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/30/arts/BOOK/BOOK-superJumbo.jpg', 'height': 2048, 'width': 1402, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/30/arts/BOOK/BOOK-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/12/30/arts/BOOK/BOOK-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/30/arts/BOOK/BOOK-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Capitalism, as Woven Through Cotton', 'kicker': None, 'content_kicker': None, 'print_headline': 'Capitalism, as Woven Through Cotton', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Beckert, Sven', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Cotton', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'Empire of Cotton: A Global History (Book)', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-12-29T22:06:21+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By Thomas Bender', 'person': [{'f