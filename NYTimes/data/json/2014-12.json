es', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/07/magazine/07Eureka/07Eureka-articleLarge.jpg', 'height': 768, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/12/07/magazine/07Eureka/07Eureka-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 768}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/07/magazine/07Eureka/07Eureka-jumbo.jpg', 'height': 1024, 'width': 800, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/07/magazine/07Eureka/07Eureka-superJumbo.jpg', 'height': 2048, 'width': 1600, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/07/magazine/07Eureka/07Eureka-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/12/07/magazine/07Eureka/07Eureka-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/07/magazine/07Eureka/07Eureka-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Hunting for the Origins of Symbolic Thought', 'kicker': 'Eureka', 'content_kicker': None, 'print_headline': 'Ars Longa', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Jabr, Ferris', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ARCHAEOLOGY', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Brumm, Adam', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value'