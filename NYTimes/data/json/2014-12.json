}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/07/opinion/07sun1/07sun1-superJumbo.jpg', 'height': 1472, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/07/opinion/07sun1/07sun1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/12/07/opinion/07sun1/07sun1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/07/opinion/07sun1/07sun1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': ' Backsliding in Afghanistan', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Backsliding in Afghanistan', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Afghanistan War (2001- )', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'AL QAEDA', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'AFGHANISTAN', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Ghani, Ashraf', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'North Atlantic Treaty Organization', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'ABDULLAH, ABDULLAH', 'rank': 8, 'major': 'N'}], 'pub_date': '2014-12-06T21:43:54+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/824da43f-6016-53df-b1ff-7e827683f250', 'word_count': 746, 'uri': 'nyt://article/824da43f-6016-53df-b1ff-7e827683f250'}, {'abstract': 'Similar patterns showed up in the last Gilded Age, too.', 'web_url': 'https://www.nytimes.com/2014/12/07/opinion/sunday/the-real-reason-richer-people-marry.html', 'snippet': 'Similar patterns showed up in the last Gilded Age, too.', 'lead_paragraph': 'BY now it is common knowledge that professionals are more likely to marry and less likely to divorce than are less educated workers. Among 20- to 49-year-old men in 2013, 56 percent of professional, managerial and technical workers were married, compared with 31 percent of service workers, according to the American Community Survey of the Census Bureau. Some people argue that the gap is largely a result of a decline in traditional values among working-class men, particularly whites who constitute the majority of them. Supposedly they are not as industrious in seeking employment as were their fathers and grandfathers and so fail to secure the steady jobs needed for marriage. ', 'print_section': 'SR', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Real Reason Richer People Marry', 'kicker': 'Opinion', 'content_kicker': None, 'print_headline': 'The Real Reason Richer People Marry', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Income Inequality', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Cherlin, Andrew J', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Marriages', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Social Conditions and Trends', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Wages and Salaries', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-12-06T21:55:36+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Andrew J. Cherlin', 'person': [{'firstname': 'Andrew', 'middlename': 'J.', 'lastname': 'Cherlin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/8b710489-1f3b-55c3-aec8-03f2f632d527', 'word_count': 982, 'uri': 'nyt://article/8b710489-1f3b-55c3-aec8-03f2f632d527'}, {'abstract': 'Readers discuss what the Ferguson decision says about race relations and policing.', 'web_url': 'https://www.nytimes.com/2014/12/07/opinion/sunday/racial-bias-in-america.html', 'snippet': 'Readers discuss what the Ferguson decision says about race relations and policing.', 'lead_paragraph': 'Readers discuss what the Ferguson decision says about race relations and policing.', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/07/sunday-review/l06ferguson/l06ferguson-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/12/07/sunday-review/l06ferguson/l06ferguson-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/07/sunday-review/l06ferguson/l06ferguson-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/07/sunday-review/l06ferguson/l06ferguson-superJumbo.jpg', 'height': 1200, 'width': 1200, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/07/sunday-review/l06ferguson/l06ferguson-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/12/07/