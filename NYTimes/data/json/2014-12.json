/21PLAYLIST3-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Ballads of Loneliness, Electroacoustic Music and Trance-Rock', 'kicker': None, 'content_kicker': None, 'print_headline': 'Ballads of Loneliness, Electroacoustic Music and Trance-Rock', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-12-19T17:00:22+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Ben Ratliff', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Ratliff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b4a303ab-c805-558a-b7a5-5b7154f51ad0', 'word_count': 892, 'uri': 'nyt://article/b4a303ab-c805-558a-b7a5-5b7154f51ad0'}, {'abstract': 'Glyn Johns, who recorded groups like the Rolling Stones, the Who and the Clash, discusses what he liked about Led Zeppelin’s first album and what he didn’t about the Beatles’ last.', 'web_url': 'https://www.nytimes.com/2014/12/21/arts/music/glyn-johns-on-recording-rock-greats.html', 'snippet': 'Glyn Johns, who recorded groups like the Rolling Stones, the Who and the Clash, discusses what he liked about Led Zeppelin’s first album and what he didn’t about the Beatles’ last.', 'lead_paragraph': 'After disembarking from a Los Angeles to London flight in February 1969, the recording engineer and producer Glyn Johns went straight to a studio to work with the Beatles on the album that became “Abbey Road.” That was followed by an all-night session with the Rolling Stones for the album “Let It Bleed,” after which he rejoined the Beatles, then concluded his marathon that day by recording Jimi Hendrix live at Royal Albert Hall.', 'print_section': 'AR', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/21/arts/21JOHNS1/21JOHNS1-articleLarge-v2.jpg', 'height': 898, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/12/21/arts/21JOHNS1/21JOHNS1-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 898}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/21/arts/21JOHNS1/21JOHNS1-jumbo-v2.jpg', 'height': 1024, 'width': 685, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/21/arts/21JOHNS1/21JOHNS1-superJumbo-v2.jpg', 'height': 2048, 'width': 1369, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/21/arts/21JOHNS1/21JOHNS1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/12/21/arts/21JOHNS1/21JOHNS1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/21/arts/21JOHNS1/21JOHNS1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What He Saw From the Control Room ', 'kicker': None, 'content_kicker': None, 'print_headline': 'What He Saw From the Control Room', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Johns, Glyn', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Rock Music', 'rank': 5, 'major': 'N'}], 'pub_da