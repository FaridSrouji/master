': 'Telefonica UK Ltd', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Great Britain', 'rank': 10, 'major': 'N'}], 'pub_date': '2014-12-15T17:48:30+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Chad Bray', 'person': [{'firstname': 'Chad', 'middlename': None, 'lastname': 'Bray', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1b7d070c-7e8a-5818-a62e-9dc8fbf13c50', 'word_count': 599, 'uri': 'nyt://article/1b7d070c-7e8a-5818-a62e-9dc8fbf13c50'}, {'abstract': 'Even for a professional soccer player, my trip to the Camp Nou to see Barcelona play Paris St.-Germain was an eye opener.', 'web_url': 'https://www.nytimes.com/2014/12/16/sports/barcelona-at-field-level-a-pros-eye-view.html', 'snippet': 'Even for a professional soccer player, my trip to the Camp Nou to see Barcelona play Paris St.-Germain was an eye opener.', 'lead_paragraph': 'BARCELONA, Spain — When you can smell the freshly cut and watered grass, you know you are close. When I sat down with my father in the first row at the Camp Nou last week before Barcelona played Paris St.-Germain in the Champions League, the sprinklers were still on, making the glorious green field slick and fast to suit the style of the home team.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Barcelona at Field Level: A Pro’s-Eye View', 'kicker': 'Essay', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Soccer', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'UEFA Champions League (Soccer)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Barcelona (Soccer Team)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Paris St-Germain FC (Soccer Team)', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-12-15T17:49:10+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Yael Averbuch', 'person': [{'firstname': 'Yael', 'middlename': None, 'lastname': 'Averbuch', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/57f7783a-4c6e-56a5-9c06-e33a28cb0879', 'word_count': 803, 'uri': 'nyt://article/57f7783a-4c6e-56a5-9c06-e33a28cb0879'}, {'abstract': 'Projectors enabled the skier Sage Cattabriga-Alosa to use snow as his own canvas.', 'web_url': 'https://www.nytimes.com/2014/12/16/sports/video-skiing-through-art.html', 'snippet': 'Projectors enabled the skier Sage Cattabriga-Alosa to use snow as his own canvas.', 'lead_paragraph': 'For the veteran skier Sage Cattabriga-Alosa, combining his passions for skiing and art had been a lifelong dream.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Video: Skiing Through Art', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Skiing', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Cattabriga-Alosa, Sage', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-12-15T17:49:42+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Teton Gravity Research', 'person': [{'firstname': 'Teton', 'middlename': 'Gravity', 'lastname': 'Research', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1e5b4188-6138-5ac5-8e21-6d6ee36e39b6', 'word_count': 122, 'uri': 'nyt://article/1e5b4188-6138-5ac5-8e21-6d6ee36e39b6'}, {'abstract': 'An app produced by Goldman Sachs enables executives of companies going public to track results of roadshow book-building in real time, Jeffrey Goldfarb of Reuters Breakingviews notes.', 'web_url': 'https://dealbook.nytimes.com/2014/12/15/updating-i-p-o-s-for-the-candy-crush-era/', 'snippet': 'An app produced by Goldman Sachs enables executives of companies going public to track results of roadshow book-building in real time, Jeffrey Goldfarb of Reuters Breakingviews notes.', 'lead_paragraph': 'Bosses of companies heading for the public markets are hooked on an app produced by Goldman Sachs that allows them to track book-building in real time. With Apple and IBM coding mobile software for big companies, the smartphone economy is swiftly moving from the living room to the boardroom.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/15/business/dbpix-goldman-apps/dbpix-goldman-apps-articleLarge.png', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/12/15/business/dbpix-goldman-apps/dbpix-goldman-apps-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/15/business/dbpix-goldman-apps/dbpix-goldman-apps-jumbo.png', 'height': 493, 'width': 739, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/15/business/dbpix-goldman-apps/dbpix-goldman-apps-superJumbo.png', 'height': 493, 'width': 739, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/15/business/dbpix-goldman-apps/dbpix-goldman-apps-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/12/15/business/dbpix-goldman-apps/dbpix-goldman-apps-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'r