nsion was biased.', 'print_section': 'B', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/16/sports/Y-PETERSON/Y-PETERSON-articleLarge.jpg', 'height': 347, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/12/16/sports/Y-PETERSON/Y-PETERSON-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 347}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/16/sports/Y-PETERSON/Y-PETERSON-jumbo.jpg', 'height': 592, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/16/sports/Y-PETERSON/Y-PETERSON-superJumbo.jpg', 'height': 1185, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/16/sports/Y-PETERSON/Y-PETERSON-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/12/16/sports/Y-PETERSON/Y-PETERSON-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/16/sports/Y-PETERSON/Y-PETERSON-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'N.F.L. Sued by Players Union Over Adrian Peterson Ruling', 'kicker': None, 'content_kicker': None, 'print_headline': 'Charging Bias, Players Association Sues N.F.L. Over Peterson Ruling', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Peterson, Adrian', 'rank': 3, 'ma