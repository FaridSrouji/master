ght': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/12/12/arts/12LEGEND/LEGEND-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/12/arts/12LEGEND/LEGEND-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Stranger to Controversy, a Balladeer Gets Political After Police Killings', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Stranger to Controversy, Balladeer Gets Political After Police Killings', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Blacks', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Police Brutality, Misconduct and Shootings', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Brown, Michael (1996-2014)', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Garner, Eric', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Legend, John', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Common', 'rank': 9, 'major': 'N'}], 'pub_date': '2014-12-11T23:38:46+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Joe Coscarelli', 'person': [{'firstname': 'Joe', 'middlename': None, 'lastname': 'Coscarelli', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9d6e3e13-c711-525d-8e77-f25fb53b5fa1', 'word_count': 766, 'uri': 'nyt://article/9d6e3e13-c711-525d-8e77-f25fb53b5fa1'}, {'abstract': 'The composer-pianist Marcos Valle and the singer Stacey Kent bring Brazilian samba to Birdland.', 'web_url': 'https://www.nytimes.com/2014/12/12/arts/music/stacey-kent-performs-with-marcos-valle-at-birdland.html', 'snippet': 'The composer-pianist Marcos Valle and the singer Stacey Kent bring Brazilian samba to Birdland.', 'lead_paragraph': 'As Stacey Kent applied her light, sinuous voice to the music of the Brazilian composer, arranger and keyboardist Marcos Valle on Wednesday evening at Birdland, I was gently lifted out of despondency brought on by a week of bad news. Brazilian samba and bossa nova, when performed by masters, possess a special healing power. In their softer mode, they caress the soul with the bittersweet longing known as saudade. In their more vigorous form, they capture the pulse of life by evoking a harmonious kinship between people and nature with a rhythmic solidity, reminding you that even in the worst of times, the beat goes on.', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/12/arts/12BIRDLAND/BIRDLAND-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/12/12/arts/12BIRDLAND/BIRDLAND-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/12/arts/12BIRDLAND/BIRDLAND-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/12/arts/12BIRDLAND/BIRDLAND-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/12/arts/12BIRDLAND/BIRDLAND-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thum