mbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/18/garden/18SHOP1/18SHOP1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/12/18/garden/18SHOP1/18SHOP1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/18/garden/18SHOP1/18SHOP1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Finding the Right Accessories for ‘Cheese O’Clock’', 'kicker': 'Shopping With Mandy Oser and Amorette Casaus', 'content_kicker': None, 'print_headline': 'However You Slice It', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cheese', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Suqi, Rima', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Knives', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Oser, Mandy', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Casaus, Amorette', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Shopping and Retail', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-12-17T23:52:06+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Rima Suqi', 'person': [{'firstname': 'Rima', 'middlename': None, 'lastname': 'Suqi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/aeed84ab-c01c-5fc3-9fbd-92a23caef32c', 'word_count': 476, 'uri': 'nyt://article/aeed84ab-c01c-5fc3-9fbd-92a23caef32c'}, {'abstract': 'Marcia Hinds, the production designer of the new “Annie,” on the challenges of building a set in a raw space in an unfinished office tower near Ground Zero.', 'web_url': 'https://www.nytimes.com/2014/12/18/garden/how-annie-wound-up-at-the-world-trade-center.html', 'snippet': 'Marcia Hinds, the production designer of the new “Annie,” on the challenges of building a set in a raw space in an unfinished office tower near Ground Zero.', 'lead_paragraph': 'The contemporary version of “Annie,” the 1982 film about a precocious orphan, opens nationwide on Friday with Quvenzhané Wallis in the title role and Jamie Foxx playing Will Stacks, the man who gives her a home. Like Oliver Warbucks before him, Stacks is a successful businessman, but his residence is nothing like Warbucks’s 130-room Versailles-inspired limestone palace in the first film. Instead he lives in a power penthouse with 360-degree views of Manhattan. Marcia Hinds, the film’s production designer, created the set on the 47th floor of the glass office tower at 4 World Trade Center — while it was still under construction. She recently explained to a reporter how her team managed to pull that off. (This interview has been edited and condensed.)', 'print_section': 'D', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/18/garden/18QnA1-copy/18QnA1-articleLarge.jpg', 'height': 429, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/12/18/garden/18QnA1-copy/18QnA1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 429}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/18/garden/18QnA1-copy/18QnA1-jumbo.jpg', 'height': 731, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/18/garden/18QnA1-copy/18QnA1-superJumbo.jpg', 'height': 1463, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'supe