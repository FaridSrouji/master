ame': 'Stephen', 'middlename': None, 'lastname': 'Farrell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/0b26b94c-4d20-513c-ba9c-a61bbbee1e84', 'word_count': 0, 'uri': 'nyt://video/0b26b94c-4d20-513c-ba9c-a61bbbee1e84'}, {'abstract': 'Even atheists find that ritual helps them make sense of the world.', 'web_url': 'https://www.nytimes.com/2014/12/25/opinion/religion-without-god.html', 'snippet': 'Even atheists find that ritual helps them make sense of the world.', 'lead_paragraph': 'THIS Christmas our family will go to church. The service is held in a beautiful old church in the charming town of Walpole, N.H., just over the border from Vermont. The Lord’s Prayer hangs on the wall behind the sanctuary. A lectern rises above the nave to let the pastor look down on his flock. The pews and the side stalls have the stern, pure lineaments suited to the Colonial congregation that once came to church to face God. ', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/25/opinion/25Luhrmann/25Luhrmann-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/12/25/opinion/25Luhrmann/25Luhrmann-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/25/opinion/25Luhrmann/25Luhrmann-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/25/opinion/25Luhrmann/25Luhrmann-superJumbo.jpg', 'height': 1199, 'width': 1800, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/25/opinion/25Luhrmann/25Luhrmann-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/12/25/opinion/25Luhrmann/25Luhrmann-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/25/opinion/25Luhrmann/25Luhrmann-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Religion Without God', 'kicker': 'Contributing Op-Ed Writer', 'content_kicker': None, 'print_headline': 'Religion Without God', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Luhrmann, T M', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Religion and Belief', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Atheism', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Christmas', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Secular Humanism', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'ANTHROPOLOGY', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Sunday Assembly', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Evans, Pippa', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Jones, Sanderson', 'rank': 9, 'major': 'N'}], 'pub_date': '2014-12-24T23:02:19+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By T. M. Luhrmann', 'person': [{'firstname': 'T.', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/14325079-53bc-5aae-855c-09a44129735a', 'word_count': 869, 'uri': 'nyt://article/14325079-53bc-5aae-855c-09a44129735a'}, {'abstract': 'A season to celebrate the golden rule and the possibility of peace.', 'web_url': 'https://www.nytimes.com/2014/12/25/opinion/an-atheists-christmas-dream.html', 'snippet': 'A season to celebrate the golden rule and the possibility of peace.', 'lead_paragraph': 'I’ve spent much of my life trying to ignore Christmas. As a secular Jew, an atheist and a progressive, my reasons are common. It’s a commercial, obnoxious, even dreaded holiday. But it’s not changing anytime soon and we should make the best of it. (Hanukkah, I might note, is no better, although it gives us an excuse to eat latkes.) ', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/bittman-circular/bittman-circular-jumbo-v2.png', 'height': 228, 'width': 228, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/bittman-circular/bittman-circular-superJumbo-v2.png', 'height': 228, 'width': 228, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/bittman-circular/bittman-circular-thumbStandard-v2.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/11/01/opinion/bittman-circular/bittman-circular-thumbStandard-v2.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/bittman-circular/bittman-circular-thumbLarge-v5.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'An Atheist’s Christmas Dream', 'kicker': 'Contributing Op-Ed Writer', 'co