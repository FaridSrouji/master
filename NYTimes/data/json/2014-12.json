'value': 'United States Politics and Government', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-12-12T02:01:11+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Jonathan Weisman', 'person': [{'firstname': 'Jonathan', 'middlename': None, 'lastname': 'Weisman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/43ed4679-4e3b-5b7a-9fc6-c98a17d939bf', 'word_count': 738, 'uri': 'nyt://article/43ed4679-4e3b-5b7a-9fc6-c98a17d939bf'}, {'abstract': 'Mr. Wilson negotiated the terms of the televised debate that John F. Kennedy later said “turned the tide” in the election campaign against Richard M. Nixon.', 'web_url': 'https://www.nytimes.com/2014/12/12/us/william-p-wilson-kennedys-tv-aide-for-historic-1960-debate-is-dead-at-86.html', 'snippet': 'Mr. Wilson negotiated the terms of the televised debate that John F. Kennedy later said “turned the tide” in the election campaign against Richard M. Nixon.', 'lead_paragraph': 'The 1960 presidential campaign that pitted Sen. John F. Kennedy of Massachusetts and Vice President Richard M. Nixon was the first to feature nationally televised debates between the candidates. There were four, but the first, held in Chicago on Sept. 26, is the one remembered best.', 'print_section': 'B', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/12/us/WILSON-obit/WILSON-obit-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/12/12/us/WILSON-obit/WILSON-obit-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', '