jor': 'N'}], 'pub_date': '2014-12-10T23:35:07+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Winnie Hu', 'person': [{'firstname': 'Winnie', 'middlename': None, 'lastname': 'Hu', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/33a9dc3d-e3eb-51e5-bd98-9665fb7268c0', 'word_count': 630, 'uri': 'nyt://article/33a9dc3d-e3eb-51e5-bd98-9665fb7268c0'}, {'abstract': 'For young people, it’s a time of civic awakening, a realization that equality must be won — by every generation — because it will never be freely granted.', 'web_url': 'https://www.nytimes.com/2014/12/11/opinion/charles-blow-this-is-your-moment.html', 'snippet': 'For young people, it’s a time of civic awakening, a realization that equality must be won — by every generation — because it will never be freely granted.', 'lead_paragraph': 'I was born in 1970, on the heels of the civil rights movement. I didn’t witness my parents’ struggles and their parents’ struggles before them. What I knew of darker days I learned in school, read in books or saw on television. Therefore, as a matter of circumstance, there existed a space between that reality and me. It was more pedagogical than experiential.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/blow-circular/blow-circular-articleLarge-v2.jpg', 'height': 601, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/11/01/opinion/blow-circular/blow-circular-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 601}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/blow-circular/blow-circular-jumbo-v5.jpg', 'height': 1024, 'width': 1023, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/blow-circular/blow-circular-superJumbo-v5.jpg', 'height': 1852, 'width': 1850, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/blow-circular/blow-circular-thumbStandard-v5.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/11/01/opinion/blow-circular/blow-circular-thumbStandard-v5.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/blow-circular/blow-circular-thumbLarge-v8.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'This Is Your Moment', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Blacks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Race and Ethnicity', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Police Brutality, Misconduct and Shootings', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Demonstrations, Protests and Riots', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-12-10T23:37:03+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Charles M. Blow', 'person': [{'firstname': 'Charles', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/c83be18e-146c-528b-a41a-b8a1af912727', 'word_count': 911, 'uri': 'nyt