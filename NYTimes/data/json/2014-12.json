irstname': 'Dave', 'middlename': None, 'lastname': 'Itzkoff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ef5d85e9-a4b7-5f80-8ec8-863b1868a27f', 'word_count': 1019, 'uri': 'nyt://article/ef5d85e9-a4b7-5f80-8ec8-863b1868a27f'}, {'abstract': 'More than 200 villagers in the southwestern province of Sichuan, including the boy’s guardian, have signed a petition unanimously calling for the boy’s expulsion.', 'web_url': 'https://sinosphere.blogs.nytimes.com/2014/12/21/a-child-with-h-i-v-shunned-by-his-entire-village/', 'snippet': 'More than 200 villagers in the southwestern province of Sichuan, including the boy’s guardian, have signed a petition unanimously calling for the boy’s expulsion.', 'lead_paragraph': 'Rosy-cheeked, with a mop of black hair and big smile, Kun Kun, 8, just wants to be like the other kids in his village. But because he is H.I.V. positive, his neighbors have denied him the most basic joys of childhood.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Child With H.I.V., Shunned by His Entire Village', 'kicker': 'Sinosphere', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Acquired Immune Deficiency Syndrome', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Discrimination', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': "People's Daily", 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'UNAIDS', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Sichuan Province (China)', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-12-21T22:00:42+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Dan Levin', 'person': [{'firstname': 'Dan', 'middlename': None, 'lastname': 'Levin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9803223d-f2d7-51f5-a48f-c20acdf5bf1c', 'word_count': 686, 'uri': 'nyt://article/9803223d-f2d7-51f5-a48f-c20acdf5bf1c'}, {'abstract': '“The World of Raymond Chandler: In His Own Words” looks at the world and the works of that detective novelist.', 'web_url': 'https://www.nytimes.com/2014/12/22/books/the-world-of-raymond-chandler-edited-by-barry-day.html', 'snippet': '“The World of Raymond Chandler: In His Own Words” looks at the world and the works of that detective novelist.', 'lead_paragraph': 'In Raymond Chandler’s 1940 detective novel, “Farewell, My Lovely,” he took the measure of a rogue cop named Blane in a typical flight of literary fancy: “He was a windblown blossom of some 200 pounds with freckled teeth and the mellow voice of a circus barker.” Blane, of course, is not the character Chandler’s fans remember best. That honor goes to his suave but “shop-soiled” Los Angeles gumshoe, Philip Marlowe.', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/22/arts/BOOK1/BOOK1-articleLarge.jpg', 'height': 940, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/12/22/arts/BOOK1/BOOK1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 940}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/22/arts/BOOK1/BOOK1-jumbo.jpg', 'height': 1024, 'width': 654, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/22/arts/BOOK1/BOOK1-superJumbo.jpg', 'height': 2048, 'width': 1307, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'l