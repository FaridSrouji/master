o': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'ALGERIA', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Gouri, Abdelmalek', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Jund al-Khilafah', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Gourdel, Herve', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Kidnapping and Hostages', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Terrorism', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-12-24T02:30:24+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Africa', 'byline': {'original': 'By Amir Jalal Zerdoumi', 'person': [{'firstname': 'Amir', 'middlename': 'Jalal', 'lastname': 'Zerdoumi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/41de402e-b810-5121-990c-81d1d9e18bf3', 'word_count': 289, 'uri': 'nyt://article/41de402e-b810-5121-990c-81d1d9e18bf3'}, {'abstract': 'Militants in India’s northeastern state of Assam killed at least 33 people Tuesday, firing indiscriminately in attacks on remote tribal villages.', 'web_url': 'https://www.nytimes.com/2014/12/24/world/asia/india-attacks-kill-villagers-in-northeast.html', 'snippet': 'Militants in India’s northeastern state of Assam killed at least 33 people Tuesday, firing indiscriminately in attacks on remote tribal villages.', 'lead_paragraph': 'Militants in India’s northeastern state of Assam killed at least 56 people, firing indiscriminately in remote tribal villages on Tuesday. The militants were believed to be part of the National Democratic Front of Bodoland, which seeks an independent state for members of the Bodo ethnic group. Though the militant group’s leaders recently began peace talks with the state government, one faction opposes negotiation and has staged acts of violence in hopes of stopping the talks. The death toll included women and children and was likely to rise, Sanjukta Parashar, the police chief in Sonitpur district, said Tuesday. Agence France-Presse reported Wednesday that it had risen to 56 from 33. Over the weekend, the police killed two Bodo militants and recovered a cache of arms during a counterterrorism raid, and some officials said the Assam attacks might have been planned as revenge. ', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'India: Attacks Kill Villagers in Northeast', 'kicker': 'World Briefing', 'content_kicker': None, 'print_headline': 'India: Attacks Kill Villagers in Northeast', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'India', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Kumar, Hari', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Bodos (Ethnic Group)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Assam State (India)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Terrorism', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'National Democratic Front of Bodoland', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-12-24T02:40:59+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Hari Kumar', 'person': [{'firstname': 'Hari', 'middlename': None, 'lastname': 'Kumar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/a978af8b-5b07-5acf-b8a4-cb3ffbe6c035', 'word_count': 141, 'uri': 'nyt://article/a978af8b-5b07-5acf-b8a4-cb3ffbe6c035'}, {'abstract': 'Between 2003 and 2012, $6.6 trillion was secretly and illegally funneled out of developing and emerging economies by entities that may have been involved in crime, corruption and tax evasion, according to one study.', 'web_url': 'https://sinosphere.blogs.nytimes