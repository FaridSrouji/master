rce': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Should Developers Be Allowed to Build in and Near the Grand Canyon?', 'kicker': 'The Learning Network', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-12-05T10:00:15+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By Michael Gonchar', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Gonchar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/df8e4d04-6583-55fa-930e-134c22504ad3', 'word_count': 694, 'uri': 'nyt://article/df8e4d04-6583-55fa-930e-134c22504ad3'}, {'abstract': 'A Senegalese has recreated portraits made centuries ago of Africans who lived in Europe and were commemorated in now-forgotten Western art.', 'web_url': 'https://lens.blogs.nytimes.com/2014/12/05/african-diasporas-playing-with-the-past/', 'snippet': 'A Senegalese has recreated portraits made centuries ago of Africans who lived in Europe and were commemorated in now-forgotten Western art.', 'lead_paragraph': 'Omar Victor Diop, a Senegalese photographer, was feeling out of place during an artist residency in Málaga, Spain, when he discovered the seminal series “The Image of the Black in Western Art.” In it, he found centuries-old Western paintings from the Menil Collection in Houston that depicted people of African descent from the Renaissance to the emergence of the slave trade. As an African who was educated in Paris, he was aware of the long history of marginalizing the African diaspora in European museums. Understandably, he was captivated by what he saw.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'African Diasporas, Playing With the Past', 'kicker': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None},