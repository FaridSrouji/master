None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Oil (Petroleum) and Gasoline', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Ruble (Currency)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Kudrin, Aleksei L', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Putin, Vladimir V', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Bank TRUST (Russia)', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Central Bank of Russia', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Gazprom', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Rosneft', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Russia', 'rank': 10, 'major': 'N'}], 'pub_date': '2014-12-26T17:44:40+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By David M. Herszenhorn', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/26e863df-bec5-529c-b9b1-0ebd8235412b', 'word_count': 532, 'uri': 'nyt://article/26e863df-bec5-529c-b9b1-0ebd8235412b'}, {'abstract': 'Will Self’s follow-up to “Umbrella” is set in the 1970s but pivots around a nightmarish episode from World War II.', 'web_url': 'https://www.nytimes.com/2014/12/28/books/review/will-selfs-shark.html', 'snippet': 'Will Self’s follow-up to “Umbrella” is set in the 1970s but pivots around a nightmarish episode from World War II.', 'lead_paragraph': 'Just before the climax of Steven Spielberg’s 1975 blockbuster “Jaws,” the shark hunter Quint tells a harrowing story about the sinking of the U.S.S. Indianapolis, the Navy ship that was torpedoed by a Japanese submarine days after delivering materials for the first atomic bomb. Quint’s tale of sailors drowned and devoured by sharks is so ghoulish and riveting it’s easy to miss a detail he shared before telling it: He’s had his Indianapolis tattoo removed. Bad idea. To paraphrase the old saw, those who try to forget the past are doomed to be gnawed to death by it off the coast of Martha’s Vineyard.', 'print_section': 'BR', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/28/books/review/28ATHITAKIS/1228-bks-Athitakis-articleLarge.jpg', 'height': 625, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/12/28/books/review/28ATHITAKIS/1228-bks-Athitakis-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 625}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/28/books/review/28ATHITAKIS/1228-bks-Athitakis-jumbo.jpg', 'height': 1024, 'width': 984, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/28/books/review/28ATHITAKIS/1228-bks-Athitakis-superJumbo.jpg', 'height': 2048, 'width': 1967, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/28/books/review/28ATHITAKIS/1228-bks-Athitakis-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/12/28/books/review/28ATHITAKIS/1228-bks-Athitakis-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/28/books/review/28ATHITAKIS/1228-bks-Athitakis-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumb