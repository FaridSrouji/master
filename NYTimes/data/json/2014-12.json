name': 'Zimmer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/750bfb08-90ad-5d5a-a125-65a39b01624b', 'word_count': 917, 'uri': 'nyt://article/750bfb08-90ad-5d5a-a125-65a39b01624b'}, {'abstract': 'Gay canvassers can soften the opinions of voters opposed to same-sex marriage by having a face-to-face talk with them, researchers say.', 'web_url': 'https://www.nytimes.com/2014/12/12/health/gay-marriage-canvassing-study-science.html', 'snippet': 'Gay canvassers can soften the opinions of voters opposed to same-sex marriage by having a face-to-face talk with them, researchers say.', 'lead_paragraph': 'Gay political canvassers can soften the opinions of voters opposed to same-sex marriage by having a brief face-to-face discussion about the issue, researchers reported Thursday. The findings could have implications for activists and issues across the political spectrum, experts said.', 'print_section': 'A', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/12/health/12marriage-1/12marriage-1-articleLarge.jpg', 'height': 404, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/12/12/health/12marriage-1/12marriage-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 404}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/12/health/12marriage-1/12marriage-1-jumbo.jpg', 'height': 690, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/12/health/12marriage-1/12marriage-1-superJumbo.jpg', 'height': 1381, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbna