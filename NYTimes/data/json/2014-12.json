ank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/94eada21-3af5-556d-85c3-b2e8e061d200', 'word_count': 106, 'uri': 'nyt://article/94eada21-3af5-556d-85c3-b2e8e061d200'}, {'abstract': 'As a former interrogator in Iraq, I was not surprised by the torture report.', 'web_url': 'https://www.nytimes.com/2014/12/10/opinion/the-torture-report-reminds-us-of-what-america-was.html', 'snippet': 'As a former interrogator in Iraq, I was not surprised by the torture report.', 'lead_paragraph': 'BETHLEHEM, Pa. — I SPENT this semester teaching creative writing at Lehigh University. I’ve been a soldier, a police officer and an interrogator. So hearing students call me “Professor” and assigning homework was a significant change of pace. ', 'print_section': 'A', 'print_page': '35', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/10/opinion/10Fair/10Fair-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/12/10/opinion/10Fair/10Fair-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/10/opinion/10Fair/10Fair-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/10/opinion/10Fair/10Fair-superJumbo.jpg', 'height': 1199, 'width': 1800, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/10/opinion/10Fair/10Fair-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/12/10/opinion/10Fair/10Fair-thumbStandard.