 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/063fe2a0-5f37-5525-8dc1-67f1d80aaa18', 'word_count': 489, 'uri': 'nyt://article/063fe2a0-5f37-5525-8dc1-67f1d80aaa18'}, {'abstract': 'Many hope the federal government will succeed in obtaining an indictment of New York police officers where Staten Island prosecutors failed.', 'web_url': 'https://www.nytimes.com/2014/12/05/nyregion/federal-investigation-into-eric-garners-death-may-be-difficult-to-prove-legal-experts-say.html', 'snippet': 'Many hope the federal government will succeed in obtaining an indictment of New York police officers where Staten Island prosecutors failed.', 'lead_paragraph': 'The Justice Department’s announcement that it would open a civil rights investigation into the chokehold death of Eric Garner has raised hopes among many that the federal government will succeed in obtaining an indictment where Staten Island prosecutors failed.', 'print_section': 'A', 'print_page': '28', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Criminal Civil Rights Case May Be Difficult to Prove', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Federal Case May Be Hard to Prove, Legal Experts Say', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Police Brutality, Misconduct and Shootings', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Civil Rights and Liberties', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Justice Department', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Garner, Eric', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Pantaleo, Daniel', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-12-05T03:14:40+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Benjamin Weiser', 'person': [{'firstname': 'Benjamin', 'middlename': None, 'lastname': 'Weiser', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3378d91b-4851-5f71-b7e1-707791c75c9a', 'word_count': 892, 'uri': 'nyt://article/3378d91b-4851-5f71-b7e1-707791c75c9a'}, {'abstract': 'The United Nations secretary general, Ban Ki-moon, said Thursday that he was optimistic that progress on curbing greenhouse gas emissions would be made at a conference in Lima, Peru.', 'web_url': 'https://www.nytimes.com/2014/12/05/world/americas/secretary-general-expresses-optimism-about-climate-meeting.html', 'snippet': 'The United Nations secretary general, Ban Ki-moon, said Thursday that he was optimistic that progress on curbing greenhouse gas emissions would be made at a conference in Lima, Peru.', 'lead_paragraph': ' The United Nations secretary general, Ban Ki-moon, said Thursday that he was optimistic that progress on curbing greenhouse gas emissions would be made at a conference in Lima, Peru, where delegates from more than 190 countries have begun working on a new agreement to contain global warming. Mr. Ban told reporters at the United Nations he was heartened by recent commitments to curb the use of fossil fuels by the United States, China and the European Union. Mr. Ban, who will attend the conference next week, said the pledges were “encouraging developments” and gave him hope that a draft text of a deal could be adopted next year at a climate summit meeting in Paris. ', 'print_section': 'A', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Secretary General Expresses Optimism About Climate Meeting', 'kicker': 'World Briefing', 'content_kicker': None, 'print_headline': 'Secretary General Expresses Optimism About Climate Meeting', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Ban Ki-moon', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'United Nations', 'rank': 3, 'major': 'N'