umbo.jpg', 'height': 1200, 'width': 1799, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/05/arts/05UZUMASA/UZUMASA-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/12/05/arts/05UZUMASA/UZUMASA-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/05/arts/05UZUMASA/UZUMASA-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In the Samurai Business, We Used to Do Our Own Stunts', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'In the Samurai Business, We Used to Do Our Own Stunts', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Ochiai, Ken', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Fukumoto, Seizo', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'Uzumasa Limelight (Movie)', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-12-04T22:58:43+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Jeannette Catsoulis', 'person': [{'firstname': 'Jeannette', 'middlename': None, 'lastname': 'Catsoulis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/fae997a5-64e2-54ea-838f-06b82d23bcae', 'word_count': 234, 'uri': 'nyt://article/fae997a5-64e2-54ea-838f-06b82d23bcae'}, {'abstract': 'Alexander Tovborg’s “Eternal Feminine,” at Nicelle Beauchene, is a series of eye-catching paintings on felt, each featuring two rainbows.', 'web_url': 'https://www.nytimes.com/2014/12/05/arts/design/alexander-tovborg-eternal-feminine.html', 'snippet': 'Alexander Tovborg’s “Eternal Feminine,” at Nicelle Beauchene, is a series of eye-catching paintings on felt, each featuring two rainbows.', 'lead_paragraph': 'Alexander Tovborg, a Danish artist born in 1983, is making his New York debut with “Eternal Feminine,” a series of eye-catching paintings. In a striking, slightly precious arrangement, they line one wall of the gallery. They initially look identical. Painted on felt, these works exude a distinct softness and warmth. They seem bent on conjuring relatively modest, low-testosterone art media like woodblock prints, richly woven textiles, collage, children’s-book illustrations and stained glass.', 'print_section': 'C', 'print_page': '30', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/05/arts/05TOVBERG-GALLERY5/05TOVBERG-GALLERY5-articleLarge-v2.jpg', 'height': 798, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/12/05/arts/05TOVBERG-GALLERY5/05TOVBERG-GALLERY5-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 798}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/05/arts/05TOVBERG-GALLERY5/05TOVBERG-GALLERY5-jumbo-v2.jpg', 'height': 1024, 'width': 771, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/05/arts/05TOVBERG-GALLERY5/05TOVBERG-GALLERY5-superJumbo-v2.jpg', 'height': 2048, 'width': 1541, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/05/arts/05TOVBERG-GALLERY5/TOVBERG-GALLERY5-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/12/05/arts/05TOVBERG-GALLERY5/TOVBERG-GALLERY5-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/05/arts/05TOVBERG-GALLERY5/TOVBERG-GALLERY5-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Alexander Tovborg: ‘Eternal Feminine’', 'kicker': 'Art in Review', 'content_kicker': None, 'print_headline': 'Alexander Tovborg: ‘Eternal Feminine’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}], 'pub_date': '2014-12-04T22:59:53+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Roberta Smith', 'person': [{'firstname': 'Roberta', 'middlename': None, 'lastname': 'Smith', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/33fb5c9b-c44c-5197-bef9-7782c0ee8c8a', 'word_count': 244, 'uri': 'nyt://article/33fb5c9b-c44c-5197-bef9-7782c0ee8c8a'}, {'abstract': 'As Art Basel kicks off in the city, so do countless alternative art events. Here, a guide to the exhibitions and happenings worth checking out.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2014/12/04/miami-satellite-art-fairs-nada-pulse-untitled-scope-select/', 'snippet': 'As Art Basel kicks off in the city, so do countless alternative art events. Here, a guide to the exhibitions and happenings worth checking out.', 'lead_paragraph': "With nearly two dozen satellite fairs taking place in Miami during the city’s art week, navigating the scene can be difficult for any of the 75,000 or so collectors and art enthusiasts expected to be in town. For the most part, each alternative fair covers a certain niche in the art market; NADA, for instance, is dedicated to “exploring new or underexposed art that is not typical of the ‘art establishment,'” while Pulse calls itself “the premiere satellite fair for the discovery and acquisition of cutting-edge contemporary art.” Select embraces the local community, and, according to its curator, Tim Goossens, positions itself as an “international, smaller-scale, digestible fair with a focus on artist commissions.” Untitled, which attracts visitors with its gorgeous beachfront location, focuses on emerging and midcareer contemporary art. Here, a few of the highlights to scope out.", 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/04/t-magazine/04miami-binlot-1/04miami-binlot-1-articleLarge.jpg', 'height': 507, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/12/04/t-magazine/04miami-binlot-1/04miami-binlot-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 507}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/04/t-magazine/04miami-binlot-1/04miami-binlot-1-jumbo.jpg', 'height': 866, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/04/t-magazine/04miami-binlot-1/04miami-binlot-1-superJumbo.jpg', 'height': 960, 'width': 1135, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/04/t-magazine/04miami-binlot-1/04miami-binlot-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/12/04/t-magazine/04miami-binlot-1/04miami-binlot-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheigh