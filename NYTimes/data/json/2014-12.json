': 'image', 'url': 'images/2014/12/04/business/GADGET1/GADGET1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/04/business/GADGET1/GADGET1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/12/04/business/GADGET1/GADGET1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/04/business/GADGET1/GADGET1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Cross-Country Skis, With Chips and an App ', 'kicker': 'Gadgetwise', 'content_kicker': None, 'print_headline': 'Cross-Country Skis, With Chips and an App', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Madshus', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bell, Jack', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Cross-Country Skiing', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Mobile Applications', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Computer Chips', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-12-03T22:03:31+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'subsection_name': 'Personal Tech', 'byline': {'original': 'By Jack Bell', 'person': [{'firstname': 'Jack', 'middlename': None, 'lastname': 'Bell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/f8baf82c-77a1-5ee9-a1b8-7905b09ea5b8', 'word_count': 779, 'uri': 'nyt://article/f8baf82c-77a1-5ee9-a1b8-7905b09ea5b8'}, {'abstract': 'An attack on the Iranian ambassador’s residence in Sana, the Yemeni capital, killed at least three people.', 'web_url': 'https://www.nytimes.com/2014/12/04/world/middleeast/bombing-in-yemen-targets-iranian-envoys-home.html', 'snippet': 'An attack on the Iranian ambassador’s residence in Sana, the Yemeni capital, killed at least three people.', 'lead_paragraph': 'SANA, Yemen — A huge car bomb attack on the residence of the Iranian ambassador in Yemen’s capital, Sana, killed at least three people on Wednesday, including a guard and civilians, witnesses and a security official said. Guards at the residence said that the ambassador, Hossain Niknam, had not been in the building during the attack, which damaged nearby shops and cars. A Twitter account associated with Al Qaeda in the Arabian Peninsula, a Sunni extremist group in Yemen, carried a statement claiming responsibility. Sunni militants have accused Iran of backing Yemeni rebels known as the Houthis, who seized control of Sana in September and have embarked on a wide-ranging military offensive against Al Qaeda.', 'print_section': 'A', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Bombing in Yemen Targets Iranian Envoy’s Home', 'kicker': 'World Briefing', 'content_kicker': None, 'print_headline': 'Yemen: Envoy’s Home Is Attacked', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Almosawa, Shuaib', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Yemen', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Iran', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Al Qaeda in the Arabian Peninsula', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Niknam, Hossain', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Bombs and Explosives', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Diplomatic Service, Embassies and Consulates', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Terrorism', 'rank': 8, 'major':