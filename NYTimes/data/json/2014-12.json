ia': [], 'headline': {'main': 'Americans Involved in Torture Can Be Prosecuted Abroad, Analysts Say', 'kicker': None, 'content_kicker': None, 'print_headline': 'Americans Involved in Torture Can Be Prosecuted Abroad, Analysts Say', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Central Intelligence Agency', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Torture', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Interrogations', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Detainees', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Terrorism', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'International Criminal Court', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Human Rights and Human Rights Violations', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'International Relations', 'rank': 10, 'major': 'N'}], 'pub_date': '2014-12-11T03:19:03+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Somini Sengupta', 'person': [{'firstname': 'Somini', 'middlename': None, 'lastname': 'Sengupta', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f93516e5-b596-5e46-a14c-7faf695a148b', 'word_count': 858, 'uri': 'nyt://article/f93516e5-b596-5e46-a14c-7faf695a148b'}, {'abstract': 'Miguel De Los Santos received 25 years to life in the death of Manuel Gonzalez, who was killed while armed men were trying to pry information about a relative out of him.', 'web_url': 'https://www.nytimes.com/2014/12/11/nyregion/drug-dealer-sentenced-in-1999-torture-and-murder-of-manhattan-man.html', 'snippet': 'Miguel De Los Santos received 25 years to life in the death of Manuel Gonzalez, who was killed while armed men were trying to pry information about a relative out of him.', 'lead_paragraph': 'It is the sort of case that haunts narcotics investigators: A drug dealer and four gang members tortured and killed a man in his home in Upper Manhattan, in front of his wife, while trying to pry information out of him about a relative.', 'print_section': 'A', 'print_page': '31', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Judge Sentences Drug Dealer in ’99 Manhattan Murder', 'kicker': None, 'content_kicker': None, 'print_headline': 'Judge Sentences Drug Dealer in ’99 Murder', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'De Los Santos, Miguel (1958- )', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Murders, Attempted Murders and Homicides', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Drug Abuse and Traffic', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Gonzalez, Manuel (October 8, 1999, Murder Victim)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Sentences (Criminal)', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Manhattan (NYC)', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-12-11T03:44:46+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By James C. McKinley Jr', 'person': [{'firstname': 'James', 'middlename': 'C.', 'lastname': 'McKinley', 'qualifier': 'Jr', 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/34c62534-38ea-5e55-b7da-b5c6ac112868', 'word_count': 616, 'uri': 'nyt://article/34c62534-38ea-5e55-b7da-b5c6ac112868'}, {'abstract': 'Anthony rested his sore left knee during the Knicks’ loss to the San Antonio Spurs, their ninth straight defeat, and denied that a players-only meeting had been particularly contentious.', 'web_url': 'https://www.nytimes.com/2014/12/11/sports/basketball/carmelo-anthony-sits-and-shrugs-off-talk-of-ny-knicks-discord.html', 'snippet': 'Anthony rested his sore left knee during the Knicks’ loss to the San Antonio Spurs, their ninth straight defeat, and denied that a players-only meeting had been particularly contentious.', 'lead_paragraph': 'SAN ANTONIO — After a brief and eventful stint as a free agent, which included momentary flirtations with other organizations, Carmelo Anthony decided in July to remain with the Knicks. Anthony had said that his priority was winning, and by staying in New York he would assume his rightful position as the centerpiece of a team that would be revamped under the guidance of Phil Jackson, the team’s new president.', 'print_section': 'B', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/11/sports/CITY-KNICKS-2/CITY-KNICKS-2-articleLarge.jpg', 'height': 376, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/12/11/sports/CITY-KNICKS-2/CITY-KNICKS-2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 376}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/11/sports/CITY-KNICKS-2/CITY-KNICKS-2-jumbo.jpg', 'height': 641, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/11/sports/CITY-KNICKS-2/CITY-KNICKS-2-superJumbo.jpg', 'height': 1282, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/11/sports/CITY-KNICKS-2/CITY-KNICKS-2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/12/11/sports/CITY-KNICKS-2/CITY-KNICKS-2-thumbStandard.jpg', 'thumbnail