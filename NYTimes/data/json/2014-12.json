le': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/22ba057f-49d0-5691-a090-37c5e34e7b23', 'word_count': 590, 'uri': 'nyt://article/22ba057f-49d0-5691-a090-37c5e34e7b23'}, {'abstract': 'A long-delayed Senate report documenting the C.I.A.’s torture of terrorism detainees is set to become public on Tuesday.', 'web_url': 'https://www.nytimes.com/politics/first-draft/2014/12/09/today-in-politics-53/', 'snippet': 'A long-delayed Senate report documenting the C.I.A.’s torture of terrorism detainees is set to become public on Tuesday.', 'lead_paragraph': 'Washington Braces for Release of Torture Report', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Today in Politics', 'kicker': 'First Draft', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-12-09T12:17:00+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/b42a15d6-ce08-5f4d-9085-7aaa1e46f0ec', 'word_count': 1390, 'uri': 'nyt://article/b42a15d6-ce08-5f4d-9085-7aaa1e46f0ec'}, {'abstract': 'The shooting in Faisalabad was the latest attack on a health care worker amid the government’s struggle to contain the disease.', 'web_url': 'https://www.nytimes.com/2014/12/10/world/asia/anti-polio-worker-is-killed-in-pakistan.html', 'snippet': 'The shooting in Faisalabad was the latest attack on a health care worker amid the government’s struggle to contain the disease.', 'lead_paragraph': 'ISLAMABAD, Pakistan — A pair of unidentified gunmen killed a polio vaccinator in central Pakistan on Tuesday in yet another assault on workers who are part of a government effort to curb the disease.', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Anti-Polio Worker Slain in Pakistan', 'kicker': None, 'content_kicker': None, 'print_headline': 'Anti-Polio Worker Slain in Pakistan', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Pakistan', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Poliomyelitis', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Vaccination and Immunization', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'North-West Frontier Province (Pakistan)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Murders, Attempted Murders and Homicides', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-12-09T12:18:39+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Salman Masood', 'person': [{'firstname': 'Salman', 'middlename': None, 'lastname': 'Masood', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/45a31180-67fe-5692-b1bf-58b101e85f1c', 'word_count': 243, 'uri': 'nyt://article/45a31180-67fe-5692-b1bf-58b101e85f1c'}, {'abstract': 'New rules have put a brake on inversion deals. | Tech figures back petition site. | U.S. sues Deutsche Bank over taxes. | Sandy Weill’s daughter will become chairwoman of Cornell Weill Medical College.', 'web_url': 'https://dealbook.nytimes.com/2014/12/09/morning-agenda-inversion-deals-in-limbo/', 'snippet': 'New rules have put a brake on inversion deals. | Tech figures back petition site. | U.S. sues Deutsche Bank over taxes. | Sandy Weill’s daughter will become chairwoman of Cornell Weill Medical College.', 'lead_paragraph': 'This was the year of cross-border transactions known as inversions, David Gelles writes in DealBook’s winter special section on the deal cycle. For much of the year, Wall Street advisers scrambled to engineer such transactions, in which a United States company acquires a foreign competitor and reincorporates abroad to reduce its tax bill. But an abrupt change to tax rules in September left the future of inversions in limbo. Although many expect the deals to continue in some form, they are unlikely to take place with the same frequency, or at the same size, as they did earlier this year.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Morning Agenda: Inversion Deals in Limbo', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-12-09T12:54:58+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Sydney Ember', 'person': [{'firstname': 'Sydney', 'middlename': None, 'lastname': 'Ember', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/771f3883-927b-562a-b287-a98f6517a2da', 'word_count': 2322, 'uri': 'nyt://article/771f3883-927b-562a-b287-a98f6517a2da'}, {'abstract': 'The German carmaker said Mr. Reithofer would step down as chief executive in May and would be replaced by Harald Krüger, the head of production.', 'web_url': 'https://www.nytimes.com/2014/12/10/business/bmw-ceo-norbert-reithofer-to-step-down-early.html', 'snippet': 'The German carmaker said Mr. Reithofer would step down as chief executive in May and would be replaced by Harald Krüger, the head of production.', 'lead_paragraph': 'FRANKFURT — BMW said on Tuesday that Norbert Reithofer would step down in May as chief executive of the German luxury carmaker a year earlier than expected, and that he would be replaced by Harald Krüger, the head of production.', 'print_section': 'B', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/1