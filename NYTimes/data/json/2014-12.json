e, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b36e46e0-dad7-55c3-9d81-98af8e48808e', 'word_count': 274, 'uri': 'nyt://article/b36e46e0-dad7-55c3-9d81-98af8e48808e'}, {'abstract': 'The dress, which featured a sweetheart neckline topped with illusion and glittery embellishment resembling icicles was made in the United States, the brand proudly Instagrammed.', 'web_url': 'https://runway.blogs.nytimes.com/2014/12/08/michelle-obama-in-monique-lhuillier-opts-for-a-different-look/', 'snippet': 'The dress, which featured a sweetheart neckline topped with illusion and glittery embellishment resembling icicles was made in the United States, the brand proudly Instagrammed.', 'lead_paragraph': '“Fairy princess” is not a look frequently attempted by Michelle Obama, but that was the association produced by the frosted pale-pink gown the first lady wore last night to the Kennedy Center Honors, hosted by Stephen Colbert. (The Daily News framed this as a sartorial smackdown with the Duchess of Cambridge, Kate Middleton, arriving in New York City with her husband, Prince William, for a much-ballyhooed visit.)', 'print_section': 'E', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Michelle Obama in Monique Lhuillier, Opts For a Different Look', 'kicker': 'On the Runway', 'content_kicker': None, 'print_headline': 'A First Lady in Pink, Fit to Be a Princess', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Kennedy Center Honors', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Lhuillier, Monique', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Michelle', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-12-08T21:16:55+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'byline': {'original': 'By Alexandra Jacobs', 'person': [{'firstname': 'Alexandra', 'middlename': None, 'lastname': 'Jacobs', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6f10b34b-1bf1-5caa-acde-b3e69a64f921', 'word_count': 256, 'uri': 'nyt://article/6f10b34b-1bf1-5caa-acde-b3e69a64f921'}, {'abstract': 'How to run surpluses and still be a vulnerable debtor.', 'web_url': 'https://krugman.blogs.nytimes.com/2014/12/08/is-russia-2015-venezuela-1983/', 'snippet': 'How to run surpluses and still be a vulnerable debtor.', 'lead_paragraph': 'I am trying to get up to speed on the impact of the oil price plunge, and one of the important stories is unfolding in Putin’s Russia. Obviously Russia’s problems stem from other things besides the oil price, namely Ukraine and the fallout thereof. Still, it’s pretty striking just how fast the financial situation seems to be unraveling. The bond vigilantes aren’t invisible in Moscow — 10-year interest rates, which were below 8 percent early this year, hit 12.67 percent today.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Is Russia 2015 Venezuela 1983?', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-12-08T21:32:04+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4a6d0efa-b6e6-5c38-a44b-3ac7bc710a9b', 'word_count': 212, 'uri': 'nyt://article/4a6d0efa-b6e6-5c38-a44b-3ac7bc710a9b'}, {'abstract': 'Apple is trying to get a class-action lawsuit t