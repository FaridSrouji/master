'persons', 'value': 'Shen Yongping', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Xi Jinping', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Zhang Xuezhong', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Communist Party of China', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 8, 'major': 'N'}], 'pub_date': '2014-12-30T12:56:57+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Edward Wong', 'person': [{'firstname': 'Edward', 'middlename': None, 'lastname': 'Wong', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d05df397-5fdd-52ab-a972-708d1298d076', 'word_count': 280, 'uri': 'nyt://article/d05df397-5fdd-52ab-a972-708d1298d076'}, {'abstract': 'Mr. Jones performs a scene from the Broadway revival of the 1936 comedy.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2014/12/30/in-performance-james-earl-jones-of-you-cant-take-it-with-you/', 'snippet': 'Mr. Jones performs a scene from the Broadway revival of the 1936 comedy.', 'lead_paragraph': 'The In Performance series ends 2014 with a prayer from James Earl Jones. In the Broadway revival of Moss Hart and George S. Kaufman’s 1936 comedy “You Can’t Take It With You,” Mr. Jones plays the head of an unconventional family living under the same roof during the Great Depression. In this scene he offers thanks for heavenly guidance through tough but funny times. The show, directed by Scott Ellis, is at the Longacre Theater.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In Performance: James Earl Jones of ‘You Can’t Take It With You’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'pe