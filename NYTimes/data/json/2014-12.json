int_section': 'D', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Ants of Manhattan', 'kicker': 'Take a Number', 'content_kicker': None, 'print_headline': '42', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Nuwer, Rachel', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Ants', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Manhattan (NYC)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Biodiversity', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Savage, Amy M', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Insect Conservation and Diversity (Journal)', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-12-01T19:38:21+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Science', 'byline': {'original': 'By Rachel Nuwer', 'person': [{'firstname': 'Rachel', 'middlename': None, 'lastname': 'Nuwer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/17b71c44-02f2-5c12-b3a0-bb0337c75761', 'word_count': 369, 'uri': 'nyt://article/17b71c44-02f2-5c12-b3a0-bb0337c75761'}, {'abstract': 'Passes sent to riders on the Long Island Rail Road and Metro-North Railroad should have been good for 30 days’ use of the city’s subway and bus systems, but turned out to be good for none.', 'web_url': 'https://www.nytimes.com/2014/12/02/nyregion/metrocard-glitch-snarls-commute-for-nearly-10000-riders.html', 'snippet': 'Passes sent to riders on the Long Island Rail Road and Metro-North Railroad should have been good for 30 days’ use of the city’s subway and bus systems, but turned out to be good for none.', 'lead_paragraph': 'Nearly 10,000 commuters faced a rude welcome to December on Monday morning, when the MetroCards sent to them by the Metropolitan Transportation Authority proved worthless.', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/02/nyregion/METROCARD/METROCARD-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/12/02/nyregion/METROCARD/METROCARD-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/02/nyregion/METROCARD/METROCARD-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/02/nyregion/METROCARD/METROCARD-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/02/nyregion/METROCARD/METROCARD-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/12/02/nyregion/METROCARD/METROCARD-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/02/nyregion/METROCARD/METROCARD-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'MetroCard Coding Error Stalls Nearly 10,000 Riders', 'kicker': None, 'content_kicker': None, 'print_headline': 'MetroCard Coding Error Stalls Nearly 10,000 Riders', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'MetroCard (NYC)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'McGeehan, Patrick', 'rank': 2,