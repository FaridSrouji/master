middlename': None, 'lastname': 'Shaw', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a1057f99-7232-5111-be2f-7f5e9538d6b5', 'word_count': 1046, 'uri': 'nyt://article/a1057f99-7232-5111-be2f-7f5e9538d6b5'}, {'abstract': 'Cruz’s version of credibility.', 'web_url': 'https://krugman.blogs.nytimes.com/2016/01/15/monetary-economics-at-the-gop-debate/', 'snippet': 'Cruz’s version of credibility.', 'lead_paragraph': 'There wasn’t much economics, or for that matter much connection with reality. But Ted Cruz delivered:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Monetary Economics at the GOP Debate', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2016-01-15T17:47:10+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4f49c34d-c860-567c-bcda-fd263b636f45', 'word_count': 83, 'uri': 'nyt://article/4f49c34d-c860-567c-bcda-fd263b636f45'}, {'abstract': 'Scientist may have found the most powerful supernova ever seen.', 'web_url': 'https://www.nytimes.com/2016/01/19/science/ball-of-gas-has-energy-of-hundreds-of-billions-of-suns.html', 'snippet': 'Scientist may have found the most powerful supernova ever seen.', 'lead_paragraph': 'Astronomers have discovered a giant ball of hot gas, billions of light years away, that is radiating the energy of hundreds of billions of suns. The ball may be the most powerful supernova ever seen, a study in the journal Science reports. At the center is an object about 10 miles in diameter that scientists think might be a rare type of star called a magnetar. The gas ball, 3.8 billion light years away, was spotted through the All Sky Automated Survey for Supernovae collaboration. The project, led by researchers at Ohio State University, aims to find supernovae using various small telescopes in the Northern and Southern Hemispheres.', 'print_section': 'D', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/19/science/19obs-supernova/19obs-supernova-articleLarge.jpg', 'height': 394, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/01/19/science/19obs-supernova/19obs-supernova-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 394}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/19/science/19obs-supernova/19obs-supernova-jumbo.jpg', 'height': 673, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/19/science/19obs-supernova/19obs-supernova-superJumbo.jpg', 'height': 1346, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/19/science/19obs-supernova/19obs-supernova-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/01/19/science/19obs-supernova/19obs-supernova-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/19/science/19obs-supernova/19obs-supernova-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Supernova Has Energy of Hundreds of Billions of Suns', 'kicker': 'Observatory', 'content_kicker': None, 'print_headline': 'Astronomy: The Energy of Hundreds of Billions of Suns', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Stars and Galaxies', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Space and Astronomy', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Science (Journal)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Ohio State University', 'rank': 4, 'major': 'N'}], 'pub_date': '2016-01-15T17:50:17+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Science', 'byline': {'original': 'By Sindya N. Bhanoo', 'person': [{'firstname': 'Sindya', 'middlename': 'N.', 'lastname': 'Bhanoo', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ffa81d40-17c4-5b35-8f4c-2b3a0437a489', 'word_count': 108, 'uri': 'nyt://article/ffa81d40-17c4-5b35-8f4c-2b3a0437a489'}, {'abstract': 'President Xi Jinping has not wavered from his view that destabilizing the North would create chaos in the region, scholars and officials said.', 'web_url': 'https://www.nytimes.com/2016/01/16/world/asia/north-korea-xi-jinping-obama.html', 'snippet': 'President Xi Jinping has not wavered from his view that destabilizing the North would create chaos in the region, scholars and officials said.', 'lead_paragraph': 'BEIJING — North Korea had detonated a nuclear bomb, and the president of China was urging caution. It was the fall of 2013, and the North’s third nuclear test in seven years, carried out several months earlier, had rattled much of the world.', 'print_section': 'A', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/16/world/16chinank/16chinank-articleLarge.jpg',