': 'image', 'url': 'images/2016/01/16/arts/FURY/FURY-superJumbo-v3.jpg', 'height': 725, 'width': 533, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/16/arts/FURY/FURY-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/01/16/arts/FURY/FURY-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/16/arts/FURY/FURY-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Kid Fury of ‘The Read’: From Digital Realm to the Stage', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'The Read (Radio Program)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Kid Fury', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'West, Crissle', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Podcasts', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Web-Original Programming', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'YouTube.com', 'rank': 6, 'major': 'N'}, {'name': 'creative_works', 'value': 'Furious Thoughts (Web-Original Program)', 'rank': 7, 'major': 'N'}], 'pub_date': '2016-01-15T23:56:05+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Jada F. Smith', 'person': [{'firstname': 'Jada', 'middlename': 'F.', 'lastname': 'Smith', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6536e2c9-0795-5a64-ba2f-041428f9af19', 'word_count': 514, 'uri': 'nyt://article/6536e2c9-0795-5a64-ba2f-041428f9af19'}, {'abstract': 'Chinese consumers are swapping mass-produced local beers for a bevy of imports and locally brewed brands, and a merged Anheuser-Busch InBev-SABMiller aims to capitalize.', 'web_url': 'https://www.nytimes.com/2016/01/16/business/dealbook/china-embraces-craft-beers-and-brewing-giants-take-notice.html', 'snippet': 'Chinese consumers are swapping mass-produced local beers for a bevy of imports and locally brewed brands, and a merged Anheuser-Busch InBev-SABMiller aims to capitalize.', 'lead_paragraph': 'HONG KONG — When Jin Xin first started selling imported premium beer a decade ago, his bar manager predicted that it would take a month or two just to sell a single case. But within a few years business picked up, and soon customers started frequenting the bar for its India pale ales and other European beers.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/16/business/16CHINABEER/16CHINABEER-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/01/16/business/16CHINABEER/16CHINABEER-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/16/business/16CHINABEER/16CHINABEER-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/16/business/16CHINABEER/16CHINABEER-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/16/business/16CHINABEER/16CH