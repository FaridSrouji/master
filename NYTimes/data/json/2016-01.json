umbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/07/arts/07LANG/07LANG-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/07/arts/07LANG/07LANG-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/01/07/arts/07LANG/07LANG-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/07/arts/07LANG/07LANG-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: Pérotin and Lang, 800 Years Apart, at Trinity Church', 'kicker': None, 'content_kicker': None, 'print_headline': 'Medieval Melismas and Noah’s What-to-Pack List', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'da Fonseca-Wollheim, Corinna', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Trinity Church (Manhattan, NY)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Perotin (1160-1230)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Lang, David', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Lorelei (Music Group)', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Choir of Trinity Wall Street', 'rank': 9, 'major': 'N'}], 'pub_date': '2016-01-06T22:41:36+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Corinna da Fonseca-Wollheim', 'person': [{'firstname': '',