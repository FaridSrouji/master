nk': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/27/us/28xp-seattle/28xp-seattle-superJumbo.jpg', 'height': 1373, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/27/us/28xp-seattle/28xp-seattle-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/01/27/us/28xp-seattle/28xp-seattle-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/27/us/28xp-seattle/28xp-seattle-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Shooting at Seattle Tent City Coincides With Mayor’s Homelessness Speech', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Seattle (Wash)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Homeless Persons', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Murders, Attempted Murders and Homicides', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Murray, Edward B', 'rank': 4, 'major': 'N'}], 'pub_date': '2016-01-27T16:39:29+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Christine Hauser and Ashley Southall', 'person': [{'firstname': 'Christine', 'middlename': None, 'lastname': 'Hauser', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Ashley', 'middlename': None, 'lastname': 'Southall', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/006ddb00-65a0-5677-9e45-584efa8c8664', 'word_count': 862, 'uri': 'nyt://article/006ddb00-65a0-5677-9e45-584efa8c8664'}, {'abstract': 'Erwin Wurm’s “One Minute Sculptures,” blueprints for visitors to enact their own short performances, is coming to the MAK Center for Art and Architecture.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2016/01/27/one-minute-sculptures-invade-the-schindler-house/', 'snippet': 'Erwin Wurm’s “One Minute Sculptures,” blueprints for visitors to enact their own short performances, is coming to the MAK Center for Art and Architecture.', 'lead_paragraph': 'LOS ANGELES — In the participatory vein of Yoko Ono’s instruction pieces but decidedly less dreamy, Erwin Wurm’s “One Minute Sculptures” are blueprints for visitors to enact their own short performances, using directions and household props — a bucket, board, shoe or sweater, for instance — provided by this Vienna-based artist. For nearly two decades he has been staging these so-called sculptures mainly in galleries and museums, where the absurdity of placing a bucket on one’s head disrupts the rite of fine art consumption. Now he is bringing the series to the MAK Center for Art and Architecture here, with an exhibition in its historic Schindler home from Thursday through March 27.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '‘One Minute Sculptures’ Invade the Schindler House', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Historic Buildings and Sites', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Sculpture', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Sneakers', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Ono, Yoko', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'eBay Inc', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Austria', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'Japan', 'rank': 11, 'major': 'N'}, {'name': 'glocations', 'value': 'London (England)', 'rank': 12, 'major': 'N'}, {'name': 'glocations', 'value': 'Los Angeles (Calif)', 'rank': 13, 'major': 'N'}, {'name': 'glocations', 'value': 'Paris (France)', 'rank': 14, 'major': 'N'}, {'name': 'glocations', 'value': 'Vienna (Austria)', 'rank': 15, 'major': 'N'}], 'pub_date': '2016-01-27T16:40:34+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Jori Finkel', 'person': [{'firstname': 'Jori', 'middlename': None, 'lastname': 'Finkel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/da4d8981-4aa5-59da-ae64-e8a9a282a40f', 'word_count': 410, 'uri': 'nyt://article/da4d8981-4aa5-59da-ae64-e8a9a282a40f'}, {'abstract': 'Supporters of the law regularly encounter stony skepticism in the state: “Obamacare is toxic,” said Craig W. Jones of the Oklahoma Hospital Association.', 'web_url': 'https://www.nytimes.com/2016/01/28/us/politics/oklahoma-resists-push-for-enrollment-in-affordable-care-act-coverage.html', 'snippet': 'Supporters of the law regularly encounter stony skepticism in the state: “Obamacare is toxic,” said Craig W. Jones of the Oklahoma Hospital Association.', 'lead_paragraph': 'OKLAHOMA CITY — A resolute band of insurance counselors, undeterred by the politics of health care in this staunchly conservative state, is increasing its efforts to find people who are uninsured and enroll them in coverage before the Affordable Care Act’s third annual open enrollment period ends on Sunday. ', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/27/us/27health-web/27health-web-articleLarge.jpg', 'height': 377, 'width': 