: 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Stately Gift Shops of England', 'kicker': 'Opinion', 'content_kicker': None, 'print_headline': 'The Stately Gift Shops of England', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Great Britain', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Income Inequality', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'High Net Worth Individuals', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'Gosford Park (Movie)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'England', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Social Conditions and Trends', 'rank': 7, 'major': 'N'}, {'name': 'creative_works', 'value': 'Downton Abbey (TV Program)', 'rank': 8, 'major': 'N'}], 'pub_date': '2016-01-02T19:30:09+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Charles Lambert', 'person': [{'firstname': 'Charles', 'middlename': None, 'lastname': 'Lambert', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/74fb3dfc-d6bd-5737-a239-66f89ffa3f44', 'word_count': 846, 'uri': 'nyt://article/74fb3dfc-d6bd-5737-a239-66f89ffa3f44'}, {'abstract': 'Across the country, children are experiencing depression, anxiety and even physical strain because of the pressures of school.', 'web_url': 'https://www.nytimes.com/2016/01/03/opinion/sunday/is-the-drive-for-success-making-our-children-sick.html', 'snippet': 'Across the country, children are experiencing depression, anxiety and even physical strain because of the pressures of school.', 'lead_paragraph': 'STUART SLAVIN, a pediatrician and professor at the Saint Louis University School of Medicine, knows something about the impact 