ages/2016/02/01/arts/01VANGUARD/01VANGUARD-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/02/01/arts/01VANGUARD/01VANGUARD-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'For the Vanguard Jazz Orchestra, Monday Becomes an All-Week Affair', 'kicker': None, 'content_kicker': None, 'print_headline': 'Monday Becomes an All-Week Affair for a Band', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Village Vanguard', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Jazz', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Jones, Thad', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Lewis, Mel (1929-90)', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Vanguard Jazz Orchestra', 'rank': 7, 'major': 'N'}], 'pub_date': '2016-01-31T22:45:44+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Nate Chinen', 'person': [{'firstname': 'Nate', 'middlename': None, 'lastname': 'Chinen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/319cfb80-d7e2-5463-9d95-4c0602975de6', 'word_count': 1012, 'uri': 'nyt://article/319cfb80-d7e2-5463-9d95-4c0602975de6'}, {'abstract': 'The soprano shines in the second of Donizetti’s three Tudor queens she will portray this season at the Metropolitan Opera.', 'web_url': 'https://www.nytimes.com/2016/02/01/arts/music/review-in-maria-stuarda-sondra-radvanovsky-makes-a-vivid-impact.html', 'snippet': 'The soprano shines in the second of Donizetti’s three Tudor queens she will portray this season at the Metropolitan Opera.', 'lead_paragraph': 'When an announcement is made that a singer is sick but will perform anyway, listener sympathy is sought for any potential flaws. But there was no evidence that Sondra Radvanovsky had a cold, as had been indicated, during her magnificent rendering of the title role of Donizetti’s “Maria Stuarda” on Friday evening, when David McVicar’s production returned to the Metropolitan Opera.', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/02/01/arts/01STUARDA/01STUARDA-articleLarge.jpg', 'height': 463, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/02/01/arts/01STUARDA/01STUARDA-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 463}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/02/01/arts/01STUARDA/01STUARDA-jumbo.jpg', 'height': 789, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/02/01/arts/01STUARDA/01STUARDA-superJumbo.jpg', 'height': 1579, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/02/01/arts/01STUARDA/01STUARDA-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/02/01/arts/01STUARDA/01STUARDA-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/02/01/arts/01STUARDA/01STUARDA-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: In