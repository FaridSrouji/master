ail': 'images/2016/01/07/t-magazine/07tmag-viewfinder-slide-JT2D/07tmag-viewfinder-slide-JT2D-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/07/t-magazine/07tmag-viewfinder-slide-JT2D/07tmag-viewfinder-slide-JT2D-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Portraits by Ethan James Green', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Photography', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 2, 'major': 'N'}], 'pub_date': '2016-01-07T21:57:21+0000', 'document_type': 'multimedia', 'news_desk': 'T Magazine', 'section_name': 'T Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/87754872-1c6c-57d2-a17f-20dc333fc540', 'word_count': 0, 'uri': 'nyt://slideshow/87754872-1c6c-57d2-a17f-20dc333fc540'}, {'abstract': 'The photographer (and model) Ethan James Green finds many of the subjects in his ongoing series of creatives on social media.', 'web_url': 'https://www.nytimes.com/2016/01/07/t-magazine/art/intimate-haunting-portraits-of-new-york-city-youth.html', 'snippet': 'The photographer (and model) Ethan James Green finds many of the subjects in his ongoing series of creatives on social media.', 'lead_paragraph': 'While his images are stylistically timeless, the photographer Ethan James Green’s process is entirely contemporary: He actively uses social media as a tool to discover subjects for his ongoing series of New York City creatives. “I think the rules are quickly changing!” Green says. “With social media, DIY has become much easier. Most of the people I photograph knew each other first online and now many are working with each other professionally. I think it has allowed the city to become a bit like the Wild West again.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Intimate, Haunting Portraits of New York City Youth', 'kicker': 'Viewfinder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Photography', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 3, 'major': 'N'}], 'pub_date': '2016-01-07T21:58:58+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'subsection_name': 'Art', 'byline': {'original': 'By Ian Bauman', 'person': [{'firstname': 'Ian', 'middlename': None, 'lastname': 'Bauman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5af09761-39c1-50f0-816e-461508f543db', 'word_count': 207, 'uri': 'nyt://article/5af09761-39c1-50f0-816e-461508f543db'}, {'abstract': 'The Nassau County Museum of Art offers “Family Sundays at the Museum” with hands-on art activities and opportunities to converse and collaborate.', 'web_url': 'https://www.nytimes.com/2016/01/10/nyregion/things-to-do-on-long-island-jan-9-through-17.html', 'snippet': 'The Nassau County Museum of Art offers “Family Sundays at the Museum” with hands-on art activities and opportunities to converse and collaborate.', 'lead_paragraph': 'A guide to cultural and recreational events on Long Island. Items for the calendar should be sent at least three weeks in advance to lical@nytimes.com.', 'print_section': 'LI', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/10/nyregion/10HILI1/10HILI1-articleLarge.jpg', 'height': 749, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/01/10/nyregion/