o': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Photography', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'London (England)', 'rank': 3, 'major': 'N'}], 'pub_date': '2016-01-21T19:36:08+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Hattie Crisell', 'person': [{'firstname': 'Hattie', 'middlename': None, 'lastname': 'Crisell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c8b8882c-68bc-5f96-af3e-01f6ce8dc820', 'word_count': 499, 'uri': 'nyt://article/c8b8882c-68bc-5f96-af3e-01f6ce8dc820'}, {'abstract': 'Brazilian officials said that Zika, a virus linked to brain damage in infants, may be causing an increase in the number of cases of Guillain-Barré, an autoimmune condition.', 'web_url': 'https://www.nytimes.com/2016/01/22/world/americas/zika-virus-may-be-linked-to-surge-in-rare-syndrome-in-brazil.html', 'snippet': 'Brazilian officials said that Zika, a virus linked to brain damage in infants, may be causing an increase in the number of cases of Guillain-Barré, an autoimmune condition.', 'lead_paragraph': 'RIO DE JANEIRO — A mosquito-borne virus that has been linked to severe brain damage in infants may be causing another serious health crisis as well, Brazilian officials and doctors warn: hundreds of cases of a rare syndrome in which patients can be almost completely paralyzed for weeks.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Zika Virus May be Linked to Surge in Rare Syndrome in Brazil', 'kicker': None, 'content_kicker': None, 'print_headline': 'Virus in Brazil May Be Linked to a 2nd Illness', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Zika Virus', 'rank': 1, 'major': 'N'}, {'name'