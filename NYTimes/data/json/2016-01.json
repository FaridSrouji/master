me': 'subject', 'value': 'Football', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Mather, Victor', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Gambling', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Super Bowl', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Carolina Panthers', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Denver Broncos', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-01-27T16:30:12+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Victor Mather', 'person': [{'firstname': 'Victor', 'middlename': None, 'lastname': 'Mather', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0d7228b5-71c0-5ee9-8620-4eed8d5bef3b', 'word_count': 710, 'uri': 'nyt://article/0d7228b5-71c0-5ee9-8620-4eed8d5bef3b'}, {'abstract': 'From the International Herald Tribune archives: Vichy French leaders are required to take an oath of allegiance in 1941.', 'web_url': 'https://iht-retrospective.blogs.nytimes.com/2016/01/27/1941-french-leaders-must-take-oath/', 'snippet': 'From the International Herald Tribune archives: Vichy French leaders are required to take an oath of allegiance in 1941.', 'lead_paragraph': 'VICHY — All French Cabinet ministers, secretaries of state and other high functionaries and notables will henceforth take an oath of allegiance personally to and in the presence of the Chief of the French state, binding themselves to ‘‘discharge their duties for the welfare of the state according to the laws of honor and probity.’’ This is provided for by a constitutional law, promulgated by Premier Marshal Henri Pétain today [Jan. 27]. By virtue of this act the highest state officials will be personally responsible to the Chief of State for their official acts and will be liable to suffer in their persons and in their property for their misdeeds in office.\xa0— New York Herald Tribune, European Edition, Jan. 28, 1941', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/28/blogs/28iht-oldjan28-petain/28iht-oldjan28-petain-articleLarge.jpg', 'height': 848, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/01/28/blogs/28iht-oldjan28-petain/28iht-oldjan28-petain-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 848}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/28/blogs/28iht-oldjan28-petain/28iht-oldjan28-petain-jumbo.jpg', 'height': 1024, 'width': 725, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/28/blogs/28iht-oldjan28-petain/28iht-oldjan28-petain-superJumbo.jpg', 'height': 1256, 'width': 889, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/28/blogs/28iht-oldjan28-petain/28iht-oldjan28-petain-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/01/28/blogs/28iht-oldjan28-petain/28iht-oldjan28-petain-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/28/blogs/28iht-oldjan28-petain/28iht-oldjan28-petain-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '1941: French Leaders Must Take Oath', 'kicker': 'IHT Retrospective', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name'