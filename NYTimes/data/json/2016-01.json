pg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/11/business/11yahoo/11yahoo-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/11/business/11yahoo/11yahoo-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/11/business/11yahoo/11yahoo-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/01/11/business/11yahoo/11yahoo-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/11/business/11yahoo/11yahoo-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Yahoo’s Brain Drain Shows a Loss of Faith Inside the Company', 'kicker': None, 'content_kicker': None, 'print_headline': 'Brain Drain Shows Level of Faith Lost Inside Yahoo', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Yahoo! Inc', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Mayer, Marissa', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Layoffs and Job Reductions', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Bonforte, Jeff', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-01-10T22:14:44+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'byline': {'original': 'By Vindu Goel', 'person': [{'firstname': 'Vindu', 'middlename': None, 'lastname': 'Goel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e7fbb3c5-5388-5010-93d1-ca77c6a1d76c', 'word_count': 1351, 'uri': 'nyt://article/e7fbb3c5-5388-5010-93d1-ca77c6a1d76c'}, {'abstract': 'Evoking a rigid court hierarchy, the work requires its five dancers to sustain muscular tension for long periods.', 'web_url': 'https://www.nytimes.com/2016/01/11/arts/dance/review-in-donna-uchizonos-sticky-majesty-two-queens-and-their-handmaidens.html', 'snippet': 'Evoking a rigid court hierarchy, the work requires its five dancers to sustain muscular tension for long periods.', 'lead_paragraph': 'As its title suggests, the choreographer Donna Uchizono’s “Sticky Majesty” features a pronounced hierarchy. There are only five dancers, all women, divided into groups, one of two and one of three. All have solo opportunities, but it’s the two (Molly Lieber and Heather Olson) who dominate and ordain, and the three (Hadar Ahuvia, Sarah Iguchi, Meg Weeks) who are courtiers or attendants.', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/11/arts/11UCHIZONO1/11UCHIZONO1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/01/11/arts/11UCHIZONO1/11UCHIZONO1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/11/arts/11UCHIZONO1/11UCHIZONO1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/11/arts/11UCHIZONO1/11UCHIZONO1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/11/arts/11UCHIZONO1/11UCHIZONO1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/01/11/arts/11UCHIZONO1/11UCHIZONO1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/11/arts/11UCHIZONO1/11UCHIZONO1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: In Donna Uchizono’s ‘Sticky Majesty,’ Two Queens and Their Handmaidens', 'kicker': None, 'content_kicker': None, 'print_headline': 'In a Ritualistic Hive, Two Queens and Their Handmaidens', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dancing', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Uchizono, Donna', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'Sticky Majesty (Dance)', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Gibney Dance', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-01-10T22:15:36+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Alastair Macaulay', 'person': [{'firstname': 'Alastair', 'middlename': None, 'lastname': 'Macaulay', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/343013cb-3309-51c9-9f4b-00319f109d0a', 'word_count': 541, 'uri': 'nyt://article/343013cb-3309-51c9-9f4b-00319f109d0a'}, {'abstract': 'This benefit concert, organized at short notice after Mr. Boulez’s death, featured some of New York’s most dedicated interpreters of the conductor-composer.', 'web_url': 'https://www.nytimes.com/2016/01/11/arts/music/review-au-revoir-pierre-a-celebration-of-boulez.html', 'snippet': 'This benefit concert, organized at short notice after Mr. Boulez’s death, featured some of New York’s most dedicated interpreters of the conductor-composer.', 'lead_paragraph': 'Organized at short notice after the death of Pierre Boulez on Tuesday, “Au Revoir, Pierre,” a tribute concert on Saturday at Le Poisson Rouge, showed off the qualities long associated with Mr. Boulez and his music: seriousness, precision, experimentation.', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/11/arts/11LPRBOULEZ/11LPRBOULEZ-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/01/11/arts/11LPRBOULEZ/11LPRBOULEZ-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/11/arts/11LPRBOULEZ/11LPRBOULEZ-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/11/arts/11LPRBOULEZ/11LPRBOULEZ-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/11/arts/11LPRBOULEZ/11LPRBOULEZ-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/01/11/arts/11LPRBOULEZ/11LPRBOULEZ-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/11/arts/11LPRBOULEZ/11LPRBOULEZ-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: ‘Au Revoir, Pierre,’ a Celebration of Boulez', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Celebration of Boulez’s Life and Vision, Both Playful and Moody', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Woolfe, Zachary', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Boulez, Pierre', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Le Poisson Rouge', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'New Music USA', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-01-10T22:18:03+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Zachary Woolfe', 'person': [{'firstname': 'Zachary', 'middlename': None, 'lastname': 'Woolfe', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/82ad83fe-4fc8-5620-abe7-26b253a86c97', 'word_count': 497, 'uri': 'nyt://article/82ad83fe-4fc8-5620-abe7-26b253a86c97'}, {'abstract': 'Jaamil Olawale Kosoko, Ligia Lewis and keyon gaskin performed mostly solo pieces at the Abrons Arts Center.', 'web_url': 'https://www.nytimes.com/2016/01/11/arts/dance/review-american-realnessilluminates-racial-identities-with-3-dance-works.html', 'snippet': 'Jaamil Olawale Kosoko, Ligia Lewis and keyon gaskin performed mostly solo pieces at the Abrons Arts Center.', 'lead_paragraph': '“Where may I kiss you?” You don’t expect to hear that question while waiting around a theater lobby for a performance to begin, especially not from a veiled stranger. But Keyon Gaskin established a certain intimacy early on in his 40-minute solo, “its not a thing,” at Abrons Arts Center on Friday. Cloaked in black with a scarf draped over his face, Mr. Gaskin approached individual guests, inquired about their fears (“When were you afraid today?”) and offered a kiss, planted in black lipstick.', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/11/arts/11SIOBHANREALNESS/11SIOBHANREALNESS-articleLarge.jpg', 'height': 393, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/01/11/arts/11SIOBHANREALNESS/11SIOBHANREALNESS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 393}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/11/arts/11SIOBHANREALNESS/11SIOBHANREALNESS-jumbo.jpg', 'height': 670, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/11/arts/11SIOBHANREALNESS/11SIOBHANREALNESS-superJumbo.jpg', 'height': 1340, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/11/arts/11SIOBHANREALNESS/11SIOBHANREALNESS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/01/11/arts/11SIOBHANREALNESS/11SIOBHANREALNESS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/11/arts/11SIOBHANREALNESS/11SIOBHANREALNESS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: American Realness\xa0Illuminates Racial Identities With 3 Dance Works', 'kicker': None, 'content_kicker': None, 'print_headline': 'Illuminating Racial Identities', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dancing', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'American Realness Festival', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Lewis, Ligia', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'ABRONS ARTS CENTER', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Lewis, George Jr (Twin Shadow)', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Gaskin, Keyon', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Kosoko, Jaamil Olawale', 'rank': 8, 'major': 'N'}], 'pub_date': '2016-01-10T22:22:03+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Siobhan Burke', 'person': [{'firstname': 'Siobhan', 'middlename': None, 'lastname': 'Burke', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/fd440357-744f-5a31-942e-00055d784788', 'word_count': 617, 'uri': 'nyt://article/fd440357-744f-5a31-942e-00055d784788'}, {'abstract': 'Ms. del Castillo, a Mexican television star, is believed to have brokered the meeting between the drug lord, Joaquín Guzmán Loera, and Mr. Penn last year.', 'web_url': 'https://www.nytimes.com/2016/01/11/world/americas/mexico-el-chapo-kate-del-castillo-sean-penn.html', 'snippet': 'Ms. del Castillo, a Mexican television star, is believed to have brokered the meeting between the drug lord, Joaquín Guzmán Loera, and Mr. Penn last year.', 'lead_paragraph': 'MEXICO CITY — Last fall was a busy time for the Mexican television star Kate del Castillo. She became an American citizen, advertised her new tequila and appeared tirelessly to promote her new film “The 33,” a retelling of the story of the trapped Chilean miners in 2010, in which she stars alongside Antonio Banderas as his valiant wife.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/11/world/11CASTILLO/11CASTILLO-jumbo.jpg', 'height': 594, 'width': 394, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/11/world/11CASTILLO/11CASTILLO-superJumbo.jpg', 'height': 594, 'width': 394, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/11/world/11CASTILLO/11CASTILLO-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/01/11/world/11CASTILLO/11CASTILLO-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/11/world/11CASTILLO/11CASTILLO-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Kate del Castillo, Actress Tied to ‘El Chapo,’ Set Up Sean Penn Meeting', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Interview: The Actress and the Ethics', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Guzman Loera, Joaquin', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Penn, Sean', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Rolling Stone', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'del Castillo, Kate (1972- )', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Drug Abuse and Traffic', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Mexico', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'ACTORS AND ACTRESSES', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Social Media', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'Twitter', 'rank': 10, 'major': 'N'}, {'name': 'organizations', 'value': 'Telemundo Communications Group Inc', 'rank': 11, 'major': 'N'}, {'name': 'glocations', 'value': 'Sinaloa (Mexico)', 'rank': 12, 'major': 'N'}], 'pub_date': '2016-01-10T22:22:59+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Americas', 'byline': {'original': 'By Elisabeth Malkin', 'person': [{'firstname': 'Elisabeth', 'middlename': None, 'lastname': 'Malkin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fd622eaf-6dc7-52b5-a2a3-885a1251f680', 'word_count': 853, 'uri': 'nyt://article/fd622eaf-6dc7-52b5-a2a3-885a1251f680'}, {'abstract': 'David T. Little and Royce Vavrek’s opera at the Skirball Center depicts a desperate household in a post-apocalyptic landscape.', 'web_url': 'https://www.nytimes.com/2016/01/11/arts/music/review-in-dog-days-a-family-clawing-for-survival.html', 'snippet': 'David T. Little and Royce Vavrek’s opera at the Skirball Center depicts a desperate household in a post-apocalyptic landscape.', 'lead_paragraph': 'It’s not surprising that “Dog Days,” the utterly bleak and musically original if heavy-handed opera by the composer-librettist team of David T. Little and Royce Vavrek, has won widespread attention since its acclaimed 2012 premiere. With its boldly eclectic score and powerful libretto, “Dog Days” tells an apocalyptic story unstintingly. The director Robert Woodruff’s gritty staging opened on Saturday at the Skirball Center for the Performing Arts, presented by the center and Beth Morrison Projects as part of the Prototype Festival. At the end, the courageous cast and creative team received lusty bravos from many in the hall.', 