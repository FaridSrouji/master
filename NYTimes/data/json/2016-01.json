': 'image', 'url': 'images/2016/01/09/travel/08oregon-birders-1/08oregon-birders-1-jumbo.jpg', 'height': 676, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/09/travel/08oregon-birders-1/08oregon-birders-1-superJumbo.jpg', 'height': 1353, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/09/travel/08oregon-birders-1/08oregon-birders-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/01/09/travel/08oregon-birders-1/08oregon-birders-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/09/travel/08oregon-birders-1/08oregon-birders-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Angry Birders: Standoff at Oregon Refuge Has Riled a Passionate Group', 'kicker': 'In Transit', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Wildlife Sanctuaries and Nature Reserves', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Malheur National Wildlife Refuge (Oregon)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Birds', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Oregon', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-01-08T16:18:54+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Dave Seminara', 'person': [{'firstname': 'Dave', 'middlename': None, 'lastname': 'Seminara', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bc701024-5569-5219-a1b7-d58d2ba6e0a7', 'word_count': 833, 'uri': 'nyt://article/bc701024-5569-5219-a1b7-d58d2ba6e0a7'}, {'abstract': 'A harder subject than you think.', 'web_url': 'https://krugman.blogs.nytimes.com/2016/01/08/economists-and-inequality/', 'snippet': 'A harder subject than you think.', 'lead_paragraph': 'I’m a few days late on this characteristically lucid Justin Fox column on why it took so long for economists to focus on income inequality. But as one of the economists who did write about inequality — especially the rise of the one percent — pretty early, I think Fox has missed one important aspect: it’s a hard issue to model.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Economists and Inequality', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2016-01-08T16:19:00+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/395bc80f-834c-5eba-9c97-a8658c855c31', 'word_count': 479, 'uri': 'nyt://article/395bc80f-834c-5eba-9c97-a8658c855c31'}, {'abstract': 'This week’s properties include a four-bedroom in Ocean Grove, N.J., and a six-bedroom in Laurel Hollow, N.Y.', 'web_url': 'https://www.nytimes.com/slideshow/2016/01/10/realestate/on-the-market-in-new-york-and-new-jersey.html', 'snippet': 'This week’s properties include a four-bedroom in Ocean Grove, N.J., and a six-bedroom in Laurel Hollow, N.Y.', 'lead_paragraph': 'This week’s properties include a four-bedroom in Oce