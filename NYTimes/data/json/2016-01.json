': None}, 'keywords': [{'name': 'subject', 'value': 'Editorials', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Worsley, Henry (1960-2016)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'ANTARCTIC REGIONS', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Exploration and Explorers', 'rank': 4, 'major': 'N'}], 'pub_date': '2016-01-27T08:21:03+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/c714a348-f1e0-5b62-bd44-c87267a61d0f', 'word_count': 468, 'uri': 'nyt://article/c714a348-f1e0-5b62-bd44-c87267a61d0f'}, {'abstract': 'The deep divide between optimistic and pessimistic economists has profound implications for the next occupant of the White House.', 'web_url': 'https://www.nytimes.com/2016/01/27/opinion/campaign-stops/boom-or-gloom.html', 'snippet': 'The deep divide between optimistic and pessimistic economists has profound implications for the next occupant of the White House.', 'lead_paragraph': 'Whether the winner of the 2016 presidential election emphasizes optimism or pessimism, he or she will face some sobering economic developments.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/27/opinion/27edsallWeb/27edsallWeb-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/01/27/opinion/27edsallWeb/27edsallWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/27/opinion/27edsallWeb/27edsallWeb-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, '