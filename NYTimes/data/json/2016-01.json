ame': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Scientists, Give Up Your Emails', 'kicker': 'Opinion', 'content_kicker': None, 'print_headline': 'Scientists, Give Up Your Emails', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Thacker, Paul D', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'E-Mail', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Research', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Global Warming', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Smith, Lamar S', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'National Oceanic and Atmospheric Administration', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Colleges and Universities', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Ethics and Official Misconduct', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'Public Library of Science (PLoS)', 'rank': 10, 'major': 'N'}, {'name': 'subject', 'value': 'Freedom of Information Act', 'rank': 11, 'major': 'N'}], 'pub_date': '2016-01-09T19:30:23+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Paul D. Thacker', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/32a40bcb-705a-5ffc-9e2e-71ba22358f07', 'word_count': 1048, 'uri': 'nyt://article/32a40bcb-705a-5ffc-9e2e-71ba22358f07'}, {'abstract': 'Smug, mean and in the lead, Donald Trump and Ted Cruz are rewriting the rules of likability.', 'web_url': 'https://www.nytimes.com/2016/01/10/opinion/sunday/obnoxiousness-is-the-new-charisma.html', 'snippet': 'Smug, mean and in the lead, Donald Trump and Ted Cruz are rewriting the rules of likability.', 'lead_paragraph': 'IN a typical presidential campaign, the most successful candidates lay claim to leadership with their high-mindedness. They reach for poetry. They focus on lifting people up, not tearing them down. They beseech voters to be their biggest, best selves.', 'print_section': 'SR', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/10/opinion/sunday/10bruni-horiz-promo-image/10bruni-horiz-promo-image-articleLarge.jpg', 'height': 356, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/01/10/opinion/sunday/10bruni-horiz-promo-image/10bruni-horiz-promo-image-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 356}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/10/opinion/sunday/10bruni-horiz-promo-image/10bruni-horiz-promo-image-jumbo.jpg', 'height': 607, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/10/opinion/sunday/10bruni-horiz-promo-image/10bruni-horiz-promo-image-superJumbo.jpg', 'height': 1169, 'width': 1971, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/10/opinion/sunday/10bruni-horiz-promo-image/10bruni-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/01/10/opinion/sunday/10bruni-horiz-promo-image/10bruni-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/10/opinion/sunday/10bruni-horiz-promo-image/10bruni-thumbLarge.jpg