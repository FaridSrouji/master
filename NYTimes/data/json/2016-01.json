_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Syrian Opposition Bloc Still Won’t Commit to Joining Peace Talks', 'kicker': None, 'content_kicker': None, 'print_headline': 'Syrian Opposition Bloc Still Won’t Commit to Joining Peace Talks', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Syria', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'United Nations', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Ban Ki-moon', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'International Relations', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Assad, Bashar al-', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Syrian High Negotiations Committee', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Saudi Arabia', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'United States International Relations', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'Russia', 'rank': 11, 'major': 'N'}, {'name': 'persons', 'value': 'de Mistura, Staffan', 'rank': 12, 'major': 'N'}, {'name': 'persons', 'value': 'Hijab, Riyad Farid', 'rank': 13, 'major': 'N'}], 'pub_date': '2016-01-28T18:18:29+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Somini Sengupta and Anne Barnard', 'person': [{'firstname': 'Somini', 'middlename': None, 'lastname': 'Sengupta', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Anne', 'middlename': None, 'lastname': 'Barnard', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/623a1cd9-da26-5c2d-b3b8-90d2f9f5f9e0', 'word_count': 1129, 'uri': 'nyt://article/623a1cd9-da26-5c2d-b3b8-90d2f9f5f9e0'}, {'abstract': 'Between the present and this coming spring, this soprano will assume the roles of Anne Boleyn; Mary, Queen of Scots; and Queen Elizabeth at the Met.', 'web_url': 'https://www.nytimes.com/2016/01/29/arts/music/sondra-radvanovsky-opera-royalty-takes-on-donizettis-triple-crown.html', 'snippet': 'Between the present and this coming spring, this soprano will assume the roles of Anne Boleyn; Mary, Queen of Scots; and Queen Elizabeth at the Met.', 'lead_paragraph': 'ONE of the largest voices in opera was ricocheting through a small Upper West Side apartment recently, as the soprano Sondra Radvanovsky practiced some fiendishly tricky bel canto passages for her radio broadcast singing the title role of Donizetti’s “Anna Bolena” live from the Metropolitan Opera. Then she had to switch hats, or crowns.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/28/arts/music/28QUEENS_COMBO/28QUEENS_COMBO-articleLarge.jpg', 'height': 293, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/01/28/arts/music/28QUEENS_COMBO/28QUEENS_COMBO-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 293}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/28/arts/music/28QUEENS_COMBO/28QUEENS_COMBO-jumbo.jpg', 'height': 500, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/28/arts/music/28QUEENS_COMBO/28QUEENS_COMBO-superJumbo.jpg', 'height': 999, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/28/arts/music/28QUEENS_COMBO/28QUEENS_COMBO-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'lega