ption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/27/business/27dealprof-web/27dealprof-web-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Activist Investors May Have Met Their Match: A Down Market', 'kicker': 'Deal Professor', 'content_kicker': None, 'print_headline': 'Declining Markets Mete Out Stiff Punishments to Activist Investors ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Shareholder Rights and Activism', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Hedge Funds', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Mergers, Acquisitions and Divestitures', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Pershing Square Holdings', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Ackman, William A', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-01-26T17:27:31+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'DealBook', 'byline': {'original': 'By Steven Davidoff Solomon', 'person': [{'firstname': 'Steven', 'middlename': 'Davidoff', 'lastname': 'Solomon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/48b76fe7-eccd-5844-ab9c-3342e7610830', 'word_count': 1028, 'uri': 'nyt://article/48b76fe7-eccd-5844-ab9c-3342e7610830'}, {'abstract': 'How autism came to be viewed not as an exotic disorder but as part of the human condition.', 'web_url': 'https://www.nytimes.com/2016/01/31/books/review/in-a-different-key-the-story-of-autism-by-john-donvan-and-caren-zucker.html', 'snippet': 'How autism came to be viewed not as an exotic disorder but as part of the human condition.', 'lead_paragraph': 'Through history, the commandment to act with empathy has been more honored in the breach than in the observance. In their new book, John Donvan and Caren Zucker chart America’s path to recognizing autism as part of the human condition, making a case that the arts as well as advocacy have been central to the process. The authors come from the world of television news — Donvan is a correspondent for ABC, and Zucker is a journalist and producer — and their book is crafted like a tightly edited news special: The prose is vivid, the tempo rapid and the perspective intimate, as if each character has been filmed with a hand-held camera. They depict history through biography, recounting the stories of individuals with autism and their families, physicians and psychologists — focusing on those who challenged traditional concepts of cognitive and behavioral debility and led the way to broader acceptance of autism.', 'print_section': 'BR', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/31/books/review/31GROOPMAN/31GROOPMAN-articleLarge-v2.jpg', 'height': 424, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/01/31/books/review/31GROOPMAN/31GROOPMAN-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 424}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/31/books/review/31GROOPMAN/31GROOPMAN-jumbo-v2.jpg', 'height': 724, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/31/books/review/31GROOPMAN/31GROOPMAN-superJumbo-v2.jpg', 'height': 1448, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/31/books/review/31GROOPMAN/31GROOPMAN-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'cr