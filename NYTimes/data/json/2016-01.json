: 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/27/blogs/20160127-lens-iowa-slide-TC11/20160127-lens-iowa-slide-TC11-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/27/blogs/20160127-lens-iowa-slide-TC11/20160127-lens-iowa-slide-TC11-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/01/27/blogs/20160127-lens-iowa-slide-TC11/20160127-lens-iowa-slide-TC11-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/27/blogs/20160127-lens-iowa-slide-TC11/20160127-lens-iowa-slide-TC11-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'After Factory Closing, Iowans Live Realities of Global Economy', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2016-01-28T07:05:59+0000', 'document_type': 'multimedia', 'news_desk': 'Blogs', 'section_name': 'Blogs', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/cb820db0-4253-57bb-8332-6b8631c79947', 'word_count': 0, 'uri': 'nyt://slideshow/cb820db0-4253-57bb-8332-6b8631c79947'}, {'abstract': 'Quotation of the Day for Thursday, January 28, 2016.', 'web_url': 'https://www.nytimes.com/2016/01/28/pageoneplus/quotation-of-the-day.html', 'snippet': 'Quotation of the Day for Thursday, January 28, 2016.', 'lead_paragraph': '“They keep telling us, ‘We don’t know when you can drink it again.’ How much longer can we keep doing this, using bottled water for everything?”', 'print_section': 'A', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Quotation of the Day', 'kicker': None, 'content_kicker': None, 'print_headline': 'Quotation of the Day', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2016-01-28T08:00:10+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Quote', '_id': 'nyt://article/d044ab7c-2eb5-537b-9b4e-eb777738aab9', 'word_count': 50, 'uri': 'nyt://article/d044ab7c-2eb5-537b-9b4e-eb777738aab9'}, {'abstract': 'When Electrolux closed its factory in a small Iowa town, residents learned how globalization is more than just a buzzword tossed about during presidential caucuses.', 'web_url': 'https://lens.blogs.nytimes.com/2016/01/28/iowa-brendan-hoffman-factory-electrolux/', 'snippet': 'When Electrolux closed its factory in a small Iowa town, residents learned how globalization is more than just a buzzword tossed about during presidential caucuses.', 'lead_paragraph': 'Every fourth winter, Iowa’s cities and small towns become the center of nonstop attention from political elites as presidential hopefuls court voters while media scrums record closely stage-managed campaign events. For photojournalists, this process of recording campaign set pieces can lead to a distorted and shallow view not just of the candidates but also of Iowans (who are pretty much left alone after the quadrennial spotlight).', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'After Factory Closing, Iowans Live Realities of Global Economy', 'kicker': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Factories and Manufacturing', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Primaries and Caucuses', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Iowa', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-01-28T08:00:11+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By James Estrin', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': 'Estrin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f2068eca-d80a-508a-b334-d8821b227d6d', 'word_count': 645, 'uri': 'nyt://article/f2068eca-d80a-508a-b334-d8821b227d6d'}, {'abstract': 'The World Health Organization must coordinate a broad international response to the spread of the virus.', 'web_url': 'https://www.nytimes.com/2016/01/28/opinion/zika-virus-requires-an-urgent-response.html', 'snippet': 'The World Health Organization must coordinate a broad international response to the spread of the virus.', 'lead_paragraph': 'No sooner was the Ebola virus subdued in Africa than another virus, Zika, began sweeping through South and Central America. It has been linked to serious birth defects and is threatening to invade the United States. It is imperative that the World Health Organization not repeat its sluggish response to the Ebola crisis and act urgently this time to mobilize international action.', 'print_section': 'A', 'print_page': '28', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/28/opinion/28thu3web/28thu3web-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/01/28/opinion/28thu3web/28thu3web-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/28/opinion/28thu3web/28thu3web-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/28/opinion/28thu3web/28thu3web-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/28/opinion/28thu3web/28thu3web-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/01/28/opinion/28thu3web/28thu3web-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/28/opinion/28thu3web/28thu3web-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Zika Virus Requires an Urgent Response', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Another Virus Requiring an Urgent Response', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Editorials', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'World Health Organization', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Centers for Disease Control and Prevention', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Central America', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Epidemics', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Birth Defects', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Pregnancy and Childbirth', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Guillain-Barre Syndrome', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Zika Virus', 'rank': 9, 'major': 'N'}], 'pub_date': '2016-01-28T08:21:04+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/03801f75-e38d-597a-b6a0-cd07691f6e3c', 'word_count': 534, 'uri': 'nyt://article/03801f75-e38d-597a-b6a0-cd07691f6e3c'}, {'abstract': 'Nobody’s sure, but prominent Republicans are not rallying to him.', 'web_url': 'https://www.nytimes.com/2016/01/28/opinion/campaign-stops/why-isnt-marco-rubio-winning.html', 'snippet': 'Nobody’s sure, but prominent Republicans are not rallying to him.', 'lead_paragraph': 'Late in October, when it was still possible to envision a somewhat normal Republican primary season, Marco Rubio and Jeb Bush had a moment on the debate stage that seemed as if it might be a turning point in the campaign.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/28/opinion/28douthatWeb/28douthatWeb-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/01/28/opinion/28douthatWeb/28douthatWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/28/opinion/28douthatWeb/28douthatWeb-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/28/opinion/28douthatWeb/28douthatWeb-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/28/opinion/28douthatWeb/28douthatWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/01/28/opinion/28douthatWeb/28douthatWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/28/opinion/28douthatWeb/28douthatWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Why Isn’t Marco Rubio Winning?', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Rubio, Marco', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Primaries and Caucuses', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Debates (Political)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Bush, Jeb', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Christie, Christopher J', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Cruz, Ted', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Kasich, John R', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 11, 'major': 'N'}, {'name': 'subject', 'value': 'Polls and Public Opinion', 'rank': 12, 'major': 'N'}], 'pub_date': '2016-01-28T08:21:04+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Campaign Stops', 'byline': {'original': 'By Ross Douthat', 'person': [{'firstname': 'Ross', 'middlename': None, 'lastname': 'Douthat', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'ny