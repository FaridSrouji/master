TY-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/06/t-magazine/06tmag-mixology-slide-KOTY/06tmag-mixology-slide-KOTY-superJumbo.jpg', 'height': 1363, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/06/t-magazine/06tmag-mixology-slide-KOTY/06tmag-mixology-slide-KOTY-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/01/06/t-magazine/06tmag-mixology-slide-KOTY/06tmag-mixology-slide-KOTY-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/06/t-magazine/06tmag-mixology-slide-KOTY/06tmag-mixology-slide-KOTY-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Futurist Cocktails in Milan', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cocktails', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Milan (Italy)', 'rank': 2, 'major': 'N'}], 'pub_date': '2016-01-06T19:43:39+0000', 'document_type': 'multimedia', 'news_desk': 'T Magazine', 'section_name': 'T Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/77660ced-31e4-5f68-a881-5e8e922e2480', 'word_count': 0, 'uri': 'nyt://slideshow/77660ced-31e4-5f68-a881-5e8e922e2480'}, {'abstract': 'Several bartenders in Milan have taken to creating drinks, like the Surfer’s Den’s Ape Vigorosa, inspired by the freewheeling Futurist movement.', 'web_url': 'https://www.nytimes.com/2016/01/06/t-magazine/food/milan-futurist-cocktails-grappa.html', 'snippet': 'Several bartenders in Milan have taken to creating drinks, like the Surfer’s Den’s Ape Vigorosa, inspired by the freewheeling Futurist movement.', 'lead_paragraph': 'More than a century ago, the Italian artists of the Futurist movement issued the first of their provocative manifestos — a call for art that would shock the country’s bucolic peasant society into the industrialized age. The artists broadcast their message in paintings of speed and flight, in antagonistic theater pieces that frequently ended in fistfights and eventually — as would happen perhaps only in Italy — in a cookbook. “We will now establish the way of eating best-suited to an ever more high-speed, airborne life,” declared their leader, Filippo Tomasso Marinetti. The “Futurist Cookbook,” published in 1932, detailed multisensory scenarios and the anarchic dishes and drinks that composed the artists’ dinners — events for curious guests and journalists, witnesses to the Futurist demands to refashion Italy from art to plate.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In Milan, a New Spin on a Century-Old Cocktail', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cocktails', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Milan (Italy)', 'rank': 2, 'major': 'N'}], 'pub_date': '2016-01-06T19:45:38+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'subsection_name': 'Food', 'byline': {'original': 'By Laura Rysman', 'person': [{'firstname': 'Laura', 'middlename': None, 'lastname': 'Rysman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6abe2e3f-0aa0-5d5f-a44c-105c004db945', 'word_count': 778, 'uri': 'nyt://article/6abe2e3f-0