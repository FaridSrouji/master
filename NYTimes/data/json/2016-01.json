/12tmag-spiller-slide-SQT7/12tmag-spiller-slide-SQT7-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/12/t-magazine/12tmag-spiller-slide-SQT7/12tmag-spiller-slide-SQT7-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Get the Look: Luke Spiller’s Glam Rock Makeup', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Beauty (Concept)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Rock Music', 'rank': 3, 'major': 'N'}], 'pub_date': '2016-01-15T18:41:16+0000', 'document_type': 'multimedia', 'news_desk': 'T Magazine', 'section_name': 'T Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/af39ef36-d815-55e7-b48f-987f37bb812d', 'word_count': 0, 'uri': 'nyt://slideshow/af39ef36-d815-55e7-b48f-987f37bb812d'}, {'abstract': 'The Struts’ Luke Spiller wears his influences on his sleeve — and no shortage of eyeliner and women’s clothes.', 'web_url': 'https://www.nytimes.com/2016/01/15/t-magazine/entertainment/luke-spiller-struts-interview.html', 'snippet': 'The Struts’ Luke Spiller wears his influences on his sleeve — and no shortage of eyeliner and women’s clothes.', 'lead_paragraph': 'Luke Spiller knows that the Struts are headed for big things. Already, the U.K. rock outfit has played in front of 80,000 people in Paris as the opener for the Rolling Stones. More recently, “Could Have Been Me,” the hard-charging lead single from band’s debut album, “Everybody Wants” (out March 4 via Freesolo/Interscope Records), has racked up more than 7 million plays on Spotify and has become a regular on rock radio. And Spiller, the Struts’ charismatic singer, has garnered comparisons to everyone from Tim Curry to the late Queen frontman Freddie Mercury (to whom he bears an almost eerie resemblance.) But today, he’s worried about just one thing: getting his makeup right. “Does it look all right?” he asks, looking in the mirror.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/12/t-magazine/12tmag-spiller-slide-HZDV/12tmag-spiller-slide-HZDV-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/01/12/t-magazine/12tmag-spiller-slide-HZDV/12tmag-spiller-slide-HZDV-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/12/t-magazine/12tmag-spiller-slide-HZDV/12tmag-spiller-slide-HZDV-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/12/t-magazine/12tmag-spiller-slide-HZDV/12tmag-spiller-slide-HZDV-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/12/t-magazine/12tmag-spiller-slide-HZDV/12tmag-spiller-slide-HZDV-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/01/12/t-magazine/12tmag-spiller-slide-HZDV/12tmag-spiller-slide-HZDV-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/12/t-magazine/12tmag-spiller-slide-HZDV/12tmag-spiller-slide-HZDV-thumbLarge.jpg', 'height': 150, 'w