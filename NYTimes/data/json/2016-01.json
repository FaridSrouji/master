{'name': 'subject', 'value': 'Classical Music', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Carnegie Hall', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Eighth Blackbird', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Sleeping Giant', 'rank': 4, 'major': 'N'}], 'pub_date': '2016-01-14T18:05:04+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Anthony Tommasini', 'person': [{'firstname': 'Anthony', 'middlename': None, 'lastname': 'Tommasini', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d0924299-f6c4-59ee-b9d8-353dc73086b5', 'word_count': 163, 'uri': 'nyt://article/d0924299-f6c4-59ee-b9d8-353dc73086b5'}, {'abstract': 'The film “The Rifleman’s Violin” will be followed by a performance by the violinist Stuart Canin, who played for Churchill, Truman and Stalin in 1945.', 'web_url': 'https://www.nytimes.com/2016/01/17/movies/new-york-jewish-film-festival-looks-to-the-past.html', 'snippet': 'The film “The Rifleman’s Violin” will be followed by a performance by the violinist Stuart Canin, who played for Churchill, Truman and Stalin in 1945.', 'lead_paragraph': 'As the New York Jewish Film Festival (Jan. 13-26) celebrates its 25th season at the Walter Reade Theater, it’s time to look back as well as forward. High points of the retrospective within the festival include Michael Haneke’s 1997 screen adaptation of Franz Kafka’s unfinished final novel, “The Castle” (Monday, Jan. 18); Andrzej Wajda’s World War II drama “Holy Week” (Jan. 17); and “Mahler on the Couch” (Jan. 18), the 2010 drama about the marital woes of Gustav Mahler and his wife, Alma.', 'print_section': 'AR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'ur