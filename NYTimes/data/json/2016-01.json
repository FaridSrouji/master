: 'subject', 'value': 'Government Employees', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Supreme Court (US)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'California', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'California Teachers Assn', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'ALITO, SAMUEL A JR', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Suits and Litigation (Civil)', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Prices (Fares, Fees and Rates)', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'Organized Labor', 'rank': 10, 'major': 'N'}], 'pub_date': '2016-01-09T19:45:33+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/d7c3cabc-b951-55a4-b8fd-84fc22a38757', 'word_count': 589, 'uri': 'nyt://article/d7c3cabc-b951-55a4-b8fd-84fc22a38757'}, {'abstract': 'More commonly known as the BBG, this Long Island steakhouse opened in November and is operated by two former employees of the Old Homestead Steakhouse in Manhattan.', 'web_url': 'https://www.nytimes.com/2016/01/10/nyregion/review-butchers-bar-grill-a-sparkling-newcomer-in-williston-park.html', 'snippet': 'More commonly known as the BBG, this Long Island steakhouse opened in November and is operated by two former employees of the Old Homestead Steakhouse in Manhattan.', 'lead_paragraph': 'You might get confused if you’re looking for the Butcher’s Bar & Grill, a steakhouse in Williston Park that opened in November. The restaurant is more commonly known as the BBG, which is the name on the sign you’ll see over the door as you enter.', 'print_section': 'LI', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': '