ideshow/f5c4dcec-95a6-5713-a54c-3de9a8b7d63a'}, {'abstract': 'The Chinese government has introduced unprecedented measures aimed at shaping the behavior and beliefs of China’s 10 million Uighurs.', 'web_url': 'https://www.nytimes.com/2016/01/03/world/asia/xinjiang-seethes-under-chinese-crackdown.html', 'snippet': 'The Chinese government has introduced unprecedented measures aimed at shaping the behavior and beliefs of China’s 10 million Uighurs.', 'lead_paragraph': 'KASHGAR, China — Families sundered by a wave of detentions. Mosques barred from broadcasting the call to prayer. Restrictions on the movements of laborers that have wreaked havoc on local agriculture. And a battery of ever more intrusive ways to monitor the communications of citizens for possible threats to public security.', 'print_section': 'A', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Xinjiang Seethes Under Chinese Crackdown ', 'kicker': None, 'content_kicker': None, 'print_headline': 'Xinjiang Seethes Under Chinese Crackdown ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'China', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Jacobs, Andrew', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Xinjiang (China)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Uighurs (Chinese Ethnic Group)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Muslims and Islam', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Search and Seizure', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Minorities', 'rank': 7, 'major': 'N'}], 'pub_date': '2016-01-02T22:29:13+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Andrew Jacobs', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Jacobs', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}]