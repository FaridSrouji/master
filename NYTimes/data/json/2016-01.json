jor': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'USSR (Former Soviet Union)', 'rank': 4, 'major': 'N'}], 'pub_date': '2016-01-21T16:16:04+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'byline': {'original': 'By International Herald Tribune', 'person': [{'firstname': 'International', 'middlename': 'Herald', 'lastname': 'Tribune', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/15248351-398e-5191-9919-ff172abaa4a3', 'word_count': 97, 'uri': 'nyt://article/15248351-398e-5191-9919-ff172abaa4a3'}, {'abstract': 'A look at the production design for life on Mars in “The Martian.”', 'web_url': 'https://www.nytimes.com/2016/01/22/movies/below-the-line-designing-the-martian.html', 'snippet': 'A look at the production design for life on Mars in “The Martian.”', 'lead_paragraph': 'The secret to building a believable-looking Mars on screen? Rocks, plenty of rocks.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/20/movies/martian-design2/martian-design2-articleLarge.jpg', 'height': 316, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/01/20/movies/martian-design2/martian-design2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 316}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/20/movies/martian-design2/martian-design2-jumbo.jpg', 'height': 540, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/20/movies/martian-design2/martian-design2-superJumbo.jpg', 'height': 1080, 'width': 2048, 'subType': 'superJumbo', 'crop_nam