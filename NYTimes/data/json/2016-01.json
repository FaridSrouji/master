'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Appeals-Court-on-Insider-Trading', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Insider Trading', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Appeals Courts (US)', 'rank': 2, 'major': 'N'}], 'pub_date': '2016-01-19T15:34:49+0000', 'document_type': 'multimedia', 'news_desk': 'Business Day', 'section_name': 'Business Day', 'subsection_name': 'DealBook', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/886f8d30-8dff-5a7e-b56a-a3da3b13e7a0', 'word_count': 0, 'uri': 'nyt://interactive/886f8d30-8dff-5a7e-b56a-a3da3b13e7a0'}, {'abstract': 'Also, a mac-and-cheese muffin, a floating thermometer, an elegant moonshine, the flavors of Africa, and dragon bowls.', 'web_url': 'https://www.nytimes.com/2016/01/20/dining/chocolate-book-camille-becerra-dragon-bowl.html', 'snippet': 'Also, a mac-and-cheese muffin, a floating thermometer, an elegant moonshine, the flavors of Africa, and dragon bowls.', 'lead_paragraph': 'Georg Bernardini, a German chocolate expert, has evaluated chocolates from more than 500 companies worldwide and shares the results, A to Z, in a comprehensive tome that has been translated from German into English and is now available in the United States. He is forthright, referring to the chocolate from one company as having an “annoying” taste, and admits to disliking chocolate that contains vanilla. Among the more compelling features is a rundown of what should be listed on the labels of good dark, milk and white chocolate. He also describes the levels of processing, from serious bean to bar (he is not particularly a fan of Mast Brothers) to simple repackaging, and tells you what each company does: “Chocolate – The Reference Standard” by Georg Bernardini (Georg Bernardini, $60), thechocolatetester.com.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/20/dining/20BURNER4/20BURNER4-articleLarge.jpg', 'height': 454, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/01/20/dining/20BURNER4/20BURNER4-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 454}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/20/dining/20BURNER4/20BURNER4-jumbo.jpg', 'height': 774, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/20/dining/20BURNER4/20BURNER4-superJumbo.jpg', 'height': 1549, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/20/dining/20BURNER4/20BURNER4-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/01/20/dining/20BURNER4/20BURNER4-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/20/dining/20BURNER4/20BURNER4-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Chocolate by the Book', 'kicker': 'Front Burner', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ALCOHOLIC BEVERAGES', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Food', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Restaurants', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Tulley Road Foods', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Becerra, Camille', 'rank': 7, 'major': 'N'}, {'name': 'creative_works', 'value': 'Chocolate -- The Reference Standard (Book)', 'rank': 8, 'major': 'N'}], 'pub_date': '2016-01-19T15:47:13+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/da6ddaab-bcc1-574d-8f21-2951e2f12bac', 'word_count': 603, 'uri': 'nyt://article/da6ddaab-bcc1-574d-8f21-2951e2f12bac'}, {'abstract': 'Lending start-ups that rely on data-driven algorithms could widen the availability of credit and reduce costs for borrowers. But the new math raises questions of effectiveness and fairness.', 'web_url': 'https://bits.blogs.nytimes.com/2016/01/19/at-new-digital-lenders-math-rules/', 'snippet': 'Lending start-ups that rely on data-driven algorithms could widen the availability of credit and reduce costs for borrowers. But the new math raises questions of effectiveness and fairness.', 'lead_paragraph': 'Miguel Jimenez, a 20-year-old amateur musician in Appleton, Wis., had his eye on a classic Rickenbacker bass guitar last year. He searched the Internet and found Reverb, an online marketplace for musical instruments, which had the bass guitar he wanted. But the price tag was $1,600.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/08/technology/08bits-levchin/08bits-levchin-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/01/08/technology/08bits-levchin/08bits-levc