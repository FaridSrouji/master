': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/01/24/sports/24valencia/24valencia-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 828}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/24/sports/24valencia/24valencia-jumbo.jpg', 'height': 1024, 'width': 743, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/24/sports/24valencia/24valencia-superJumbo.jpg', 'height': 1600, 'width': 1160, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/24/sports/24valencia/24valencia-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/01/24/sports/24valencia/24valencia-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/24/sports/24valencia/24valencia-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Hairy Face of a Most Unlikely Winning Streak ', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Hairy Face of a Most Unlikely Winning Streak ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Basketball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Borden, Sam', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Beards and Mustaches', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Shurna, John', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Valencia (Basketball Team)', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-01-23T18:01:57+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Basketball', 'byline': {'original': 'By Sam Borden', 'person': [{'firstname': 'Sam', 'middlename': None, 'lastname': 'Borden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0e67c5c7-5a0d-54d7-92ad-7b8f73d67b00', 'word_count': 1368, 'uri': 'nyt://article/0e67c5c7-5a0d-54d7-92ad-7b8f73d67b00'}, {'abstract': 'Bloomberg is on it.', 'web_url': 'https://krugman.blogs.nytimes.com/2016/01/23/how-to-make-donald-trump-president/', 'snippet': 'Bloomberg is on it.', 'lead_paragraph': 'Step 1: Democrats nominate Bernie Sanders. I don’t think Sanders is unelectable, but when you look at polling, remember that Hillary Clinton’s numbers reflect her standing after more than two decades of constant character assassination, whereas Republicans haven’t even begun to go after him.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'How To Make Donald Trump President', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2016-01-23T18:03:46+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3bdffac4-4829-599d-b658-0bf73987c013', 'word_count': 134, 'uri': 'nyt://article/3bdffac4-4829-599d-b658-0bf73987c013'}, {'abstract': 'More disappointment from economists.', 'web_url': 'https://krugman.blogs.nytimes.com/2016/01/23/levels-rates-and-sweden/', 'snippet': 'More disappointment from economists.', 'lead_paragraph': 'I’ve been unhappily surprised by a lot of what has gone on within the economics profession since the 2008 crisis. But one of the most depressing things, in a way, has been the extent to which well-known economists seem confused about the difference between levels and rates of change. Unfortunately, you see this all the time — for example, in the constant assertions that because some country posted a year of pretty good growth after several years of austerity, this proves that austerity doesn’t actually depress the economy.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Levels, Rates, and Sweden', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2016-01-23T18:04:29+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7f4cdbd2-5034-5d3b-bbc2-0158cca31bc4', 'word_count': 178, 'uri': 'nyt://article/7f4cdbd2-5034-5d3b-bbc2-0158cca31bc4'}, {'abstract': 'Yoenis Cespedes is an above-average left fielder with a powerful right-handed bat who does not take enough walks, strikes out a great deal and goes through extreme slumps.', 'web_url': 'https://www.nytimes.com/2016/01/24/sports/baseball/hype-aside-numbers-suggest-a-sensible-yoenis-cespedes-deal-for-the-mets.html', 'snippet': 'Yoenis Cespedes is an above-average left fielder with a powerful right-handed bat who does not take enough walks, strikes out a great deal and goes through extreme slumps.', 'lead_paragraph': 'At the height of the mania that surrounded outfielder Yoenis Cespedes after his trade to the Mets last season, some people talked of a $200 million contract in his future and debated whether he should be considered for the National League’s Most Valuable Player Award despite havin