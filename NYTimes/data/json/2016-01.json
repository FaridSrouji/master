}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/08/sports/football/08giantsweb/08giantsweb-superJumbo.jpg', 'height': 1432, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/08/sports/football/08giantsweb/08giantsweb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/01/08/sports/football/08giantsweb/08giantsweb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/08/sports/football/08giantsweb/08giantsweb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Giants Interview Steve Spagnuolo and\xa0Teryl Austin for Coaching Position', 'kicker': None, 'content_kicker': None, 'print_headline': 'Giants Interview Steve Spagnuolo and Lions&#8217; Defensive Coordinator for Coaching Position', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'New York Giants', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Spagnuolo, Steve', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Detroit Lions', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Chicago Bears', 'rank': 4, 'major': 'N'}], 'pub_date': '2016-01-07T23:18:58+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Bill Pennington', 'person': [{'firstname': 'Bill', 'middlename': None, 'lastname': 'Pennington', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/115fe3f5-7cf8-52ae-98f5-186240d855d4', 'word_count': 275, 'uri': 'nyt://article/115fe3f5-7cf8-52ae-98f5-186240d855d4'}, {'abstract': 'James Crump’s film looks at artists who, in the early 1960s, headed into the open spaces of North America to mold the land.', 'web_url': 'https://www.nytimes.com/2016/01/08/movies/review-troublemakers-the-story-of-land-art-a-documentary.html', 'snippet': 'James Crump’s film looks at artists who, in the early 1960s, headed into the open spaces of North America to mold the land.', 'lead_paragraph': '“Earthworks are an older tradition than oil painting, going back 3,000 years,” the artist Carl Andre observes late in “Troublemakers: The Story of Land Art,” a cogent, brisk, sometimes thrilling documentary written and directed by James Crump. More than a couple of shots of Stonehenge turn up as supporting evidence for that claim. Mr. Crump’s film, though, is mostly concerned with a group of American artists who, in the early 1960s, began not just working with natural materials for their pieces but also went out into the open, sometimes arid, spaces in North America to mold or scar, or both, the land itself.', 'print_section': 'C', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/08/arts/08TROUBLEMAKERS/08TROUBLEMAKERS-articleLarge.jpg', 'height': 598, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/01/08/arts/08TROUBLEMAKERS/08TROUBLEMAKERS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 598}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/08/arts/08TROUBLEMAKERS/08TROUBLEMAKERS-jumbo.jpg', 'height': 1021, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/08/arts/08TROUBLEMAKERS/08TROUBLEMAKERS-superJumbo.jpg', 'height': 2041, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/08/arts/08TROUBLEMAKERS/08TROUBLEMAKERS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/01/08/arts/08TROUBLEMAKERS/08TROUBLEMAKERS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/08/arts/08TROUBLEMAKERS/08TROUBLEMAKERS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: ‘Troublemakers: The Story of Land Art,’ a Documentary', 'kicker': None, 'content_kicker': None, 'print_headline': 'Review: ‘Troublemakers: The Story of Land Art,’ a Documentary', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Crump, James', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'Troublemakers (Movie)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Documentary Films and Programs', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-01-07T23:19:12+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Glenn Kenny', 'person': [{'firstname': 'Glenn', 'middlename': None, 'lastname': 'Kenny', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/4a76b48d-d4b9-59d7-9586-9485bcfbab7b', 'word_count': 298, 'uri': 'nyt://article/4a76b48d-d4b9-59d7-9586-9485bcfbab7b'}, {'abstract': 'In January 1996, the Jane Austen industry was recharged with the American broadcast of a new “Pride and Prejudice,” starring Colin Firth and Jennifer Ehle.', 'web_url': 'https://www.nytimes.com/2016/01/08/arts/television/20-years-ago-pride-and-prejudice-was-reborn-on-tv.html', 'snippet': 'In January 1996, the Jane Austen industry was recharged with the American broadcast of a new “Pride and Prejudice,” starring Colin Firth and Jennifer Ehle.', 'lead_paragraph': 'The biggest surprise in the opening episode of the final season of “Downton Abbey” wasn’t about “Downton” at all; it was — ohmygod, there’s Wickham! Wickham, you old scoundrel, is that really you? And has it really been 20 years?', 'print_section': 'C', 'print_page': '29', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/08/arts/08friday-file1/08MISER2-1452190346967-articleLarge.jpg', 'height': 159, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/01/08/arts/08friday-file1/08MISER2-1452190346967-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 159}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/08/arts/08friday-file1/08MISER2-1452190346967-jumbo.jpg', 'height': 223, 'width': 843, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/08/arts/08friday-file1/08MISER2-1452190346967-superJumbo.jpg', 'height': 223, 'width': 843, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/08/arts/08friday-file1/08MISER2-1452190346967-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/01/08/arts/08friday-file1/08MISER2-1452190346