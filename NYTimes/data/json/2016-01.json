/collins-circular/collins-circular-thumbStandard-v7.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/collins-circular/collins-circular-thumbLarge-v9.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Deconstructing Hillary and Bernie', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': 'CliffsNotes on Hillary and Bernie', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Collins, Gail', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Sanders, Bernard', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Clinton, Hillary Rodham', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Party', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-01-28T08:21:04+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Gail Collins', 'person': [{'firstname': 'Gail', 'middlename': None, 'lastname': 'Collins', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/77a878f2-45b7-533d-b756-9fb430ab050b', 'word_count': 808, 'uri': 'nyt://article/77a878f2-45b7-533d-b756-9fb430ab050b'}, {'abstract': 'Democrats are too quick to assume they have a monopoly on caring. Bravo to efforts by some Republicans to disprove them.', 'web_url': 'https://www.nytimes.com/2016/01/28/opinion/compassionate-conservatives-hello.html', 'snippet': 'Democrats are too quick to assume they have a monopoly on caring. Bravo to efforts by some Republicans to disprove them.', 'lead_paragraph': 'Back in 2000, George W. Bush did something fascinating: On the campaign trail he preached “compassionate conservatism,” telling wealthy Republicans about the travails of Mexican-American immigrants and declaring to women in pearls that “the hardest job in America” is that of a single mother.', 'print_section': 'A', 'print_page': '29', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/28/opinion/28kristof/28kristof-articleLarge.jpg', 'height': 362, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/01/28/opinion/28kristof/28kristof-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 362}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/28/opinion/28kristof/28kristof-jumbo.jpg', 'height': 618, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/28/opinion/28kristof/28kristof-superJumbo.jpg', 'height': 1237, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/28/opinion/28kristof/28kristof-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/01/28/opinion/28kristof/28kristof-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/28/opinion/28kristof/28kristof-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Compassionate Conservatives, Hello?', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': 'A New Heart for the G.O.P.?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Kristof, Nicholas D', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Conservatism (US Politics)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Poverty', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Party', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Ryan, Paul D Jr', 'rank': 8, 'major': 'N'}], 'pub_date': '2016-01-28T08:21:04+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Nicholas Kristof', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'Kristof', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/a36a0d13-0706-5b3c-b6c4-d8c90140f99a', 'word_count': 817, 'uri': 'nyt://article/a36a0d13-0706-5b3c-b6c4-d8c90140f99a'}, {'abstract': 'At the town hall, her back was against the wall, and she was brilliant. That seems to be when she gives her best performances.', 'web_url': 'https://www.nytimes.com/2016/01/28/opinion/campaign-stops/hillary-clintons-crucible.html', 'snippet': 'At the town hall, her back was against the wall, and she was brilliant. That seems to be when she gives her best performances.', 'lead_paragraph': 'Monday night’s presidential town hall provided the best format and platform yet for the Democratic candidates. Each was able to play to his or her strengths without the back-and-forth conflict-baiting that debate moderators seem to demand.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/blow-circular/blow-circular