 '_id': 'nyt://article/e958d0ab-4b7e-5f13-8b19-0d9528f47e29', 'word_count': 505, 'uri': 'nyt://article/e958d0ab-4b7e-5f13-8b19-0d9528f47e29'}, {'abstract': 'A misguided federal approach has stifled innovation and hurt efforts to cut auto pollution.', 'web_url': 'https://www.nytimes.com/2016/01/29/opinion/the-problem-with-the-ethanol-mandate-that-iowa-loves.html', 'snippet': 'A misguided federal approach has stifled innovation and hurt efforts to cut auto pollution.', 'lead_paragraph': 'IOWA is the nation’s top producer of corn, and nearly half of it ends up as ethanol, thanks to a government mandate that requires ethanol to be mixed into gasoline. The mandate is worth hundreds of millions of dollars to farmers there.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/29/opinion/29ogeWeb/29ogeWeb-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/01/29/opinion/29ogeWeb/29ogeWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/29/opinion/29ogeWeb/29ogeWeb-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/29/opinion/29ogeWeb/29ogeWeb-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/29/opinion/29ogeWeb/29ogeWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/01/29/opinion/29ogeWeb/29ogeWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {