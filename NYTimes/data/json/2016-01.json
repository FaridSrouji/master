rank': 5, 'major': 'N'}], 'pub_date': '2016-01-27T03:50:19+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Michael Wilson', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Wilson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b5968c30-4a51-535c-9422-b5265e255414', 'word_count': 775, 'uri': 'nyt://article/b5968c30-4a51-535c-9422-b5265e255414'}, {'abstract': 'Ann Freedman and the Knoedler & Company gallery are being sued by Domenico and Eleanore De Sole, who paid $8.3 million in 2004 for what they thought was a Rothko work, “Untitled, 1956.”', 'web_url': 'https://www.nytimes.com/2016/01/27/arts/knoedler-gallery-directors-lawyer-says-other-experts-were-duped-by-fake-rothko.html', 'snippet': 'Ann Freedman and the Knoedler & Company gallery are being sued by Domenico and Eleanore De Sole, who paid $8.3 million in 2004 for what they thought was a Rothko work, “Untitled, 1956.”', 'lead_paragraph': 'The director of the Knoedler & Company gallery in Manhattan, which sold dozens of fakes as the work of modern masters, was not duplicitous, but duped by paintings so expertly forged that they also escaped detection by several prominent art experts, a lawyer for the director, Ann Freedman, told jurors in court on Tuesday.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/25/arts/25KNOEDLERJP-SUB2/25KNOEDLERJP-SUB2-articleLarge.jpg', 'height': 590, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/01/25/arts/25KNOEDLERJP-SUB2/25KNOEDLERJP-SUB2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 590}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/25/arts/25KNOEDLERJP-SUB2/2