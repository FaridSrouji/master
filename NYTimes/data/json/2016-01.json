s spread out before, after or during breaks.', 'print_section': 'SP', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/10/sports/11SANDOMIR1-web/11SANDOMIR1-web-articleLarge-v2.jpg', 'height': 398, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/01/10/sports/11SANDOMIR1-web/11SANDOMIR1-web-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 398}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/10/sports/11SANDOMIR1-web/11SANDOMIR1-web-jumbo-v2.jpg', 'height': 680, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/10/sports/11SANDOMIR1-web/11SANDOMIR1-web-superJumbo-v2.jpg', 'height': 849, 'width': 1279, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/10/sports/11SANDOMIR1-web/10SANDOMIR1-web-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/01/10/sports/11SANDOMIR1-web/10SANDOMIR1-web-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/10/sports/11SANDOMIR1-web/10SANDOMIR1-web-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'For Broadcast of Super Bowl I, NFL Network Picks Excess Over Tact', 'kicker': None, 'content_kicker': None, 'print_headline': 'For Broadcast of Super Bowl I, Network Picks Excess Over Tact ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject'