[{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/06/opinion/06wed1/06wed1-articleLarge.jpg', 'height': 885, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/01/06/opinion/06wed1/06wed1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 885}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/06/opinion/06wed1/06wed1-jumbo.jpg', 'height': 1024, 'width': 695, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/06/opinion/06wed1/06wed1-superJumbo.jpg', 'height': 1447, 'width': 981, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/06/opinion/06wed1/06wed1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/01/06/opinion/06wed1/06wed1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/06/opinion/06wed1/06wed1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Hear-Nothing Gun Crowd ', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'The Hear-Nothing Gun Crowd   ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Editorials', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'National Rifle Assn', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Cruz, Ted', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Ryan, Paul D Jr', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'Gun Control', 'rank': 10, 'major': 'N'}], 'pub_date': '2016-01-06T00:33:24+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/198b5a5c-c21c-5e60-8f2e-e86278f58c30', 'word_count': 648, 'uri': 'nyt://article/198b5a5c-c21c-5e60-8f2e-e86278f58c30'}, {'abstract': 'Gov. Rick Snyder of Michigan declared a state of emergency for the Flint area as concerns grew about the health effects of lead-tainted water there.', 'web_url': 'https://www.nytimes.com/2016/01/06/us/michigan-emergency-declared-over-flints-water.html', 'snippet': 'Gov. Rick Snyder of Michigan declared a state of emergency for the Flint area as concerns grew about the health effects of lead-tainted water there.', 'lead_paragraph': 'Gov. Rick Snyder of Michigan declared a state of emergency for the Flint area on Tuesday as concerns grew about the health effects of lead-tainted water there. His order, which followed emergency declarations by the city and county governments, came on the day federal officials announced an investigation of the contamination. Mr. Snyder’s administration has been criticized as slow to respond to residents’ concerns about their water. Last week, he apologized and announced staffing changes at the state agency that oversees environmental quality. Flint, which had long received water from Lake Huron provided by Detroit’s water utility, began drawing its water from the Flint River in 2014 in an effort to save money while a new pipeline was built. Residents soon complained about rashes and strange odors from the river water, but city and state officials mostly insisted that it was safe to drink. Last year, elevated levels of lead were found in children’s blood, and in October, Flint switched back to Detroit’s water system. Mr. Snyder, a Republican, said Tuesday that the emergency declaration would allow for more state resources to be used in addressing the effects of the tainted water. ', 'print_section': 'A', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Michigan: Emergency Declared Over Flint’s Water ', 'kicker': 'National Briefing | Midwest', 'content_kicker': None, 'print_headline': 'Michigan: Emergency Declared Over Flint&#8217;s Water ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Water', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Flint (Mich)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Lead', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Michigan', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Snyder, Richard Dale', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Water Pollution', 'rank': 7, 'major': 'N'}], 'pub_date': '2016-01-06T00:45:32+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Mitch Smith', 'person': [{'firstname': 'Mitch', 'middlename': None, 'lastname': 'Smith', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/3c192752-16aa-5a0f-85d4-d05b182ae839', 'word_count': 192, 'uri': 'nyt://article/3c192752-16aa-5a0f-85d4-d05b182ae839'}, {'abstract': 'Camille Cosby will not have to sit for a deposition Wednesday in a lawsuit filed against her husband, Bill Cosby, a federal judge in Massachusetts ruled.', 'web_url': 'https://www.nytimes.com/2016/01/06/us/judge-rules-for-cosbys-wife.html', 'snippet': 'Camille Cosby will not have to sit for a deposition Wednesday in a lawsuit filed against her husband, Bill Cosby, a federal judge in Massachusetts ruled.', 'lead_paragraph': 'Camille Cosby will not have to sit for a deposition Wednesday in a lawsuit filed against her husband, the entertainer Bill Cosby, a federal judge in Massachusetts ruled Tuesday, as he granted Mrs. Cosby’s request to postpone any deposition until her lawyers have a chance to appeal. ', 'print_section': 'A', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Judge Rules for Cosby’s Wife', 'kicker': None, 'content_kicker': None, 'print_headline': 'Judge Rules for Cosby&#8217;s Wife', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Bowley, Graham', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Cosby, Camille O', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Cosby, Bill', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Sex Crimes', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Decisions and Verdicts', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Suits and Litigation (Civil)', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Hennessy, David H (1955- )', 'rank': 7, 'major': 'N'}], 'pub_date': '2016-01-06T00:57:37+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Graham Bowley', 'person': [{'firstname': 'Graham', 'middlename': None, 'lastname': 'Bowley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0c570d36-1cf1-5baa-9d62-1b21df44cef6', 'word_count': 297, 'uri': 'nyt://article/0c570d36-1cf1-5baa-9d62-1b21df44cef6'}, {'abstract': 'Gregory Scarpa Jr., a captain in the Colombo crime family serving a decades-long prison term, was granted a 10-year sentence reduction for information on Terry Nichols, a co-conspirator of the Oklahoma City bombing.', 'web_url': 'https://www.nytimes.com/2016/01/06/nyregion/a-mafia-captain-turned-informer-gets-a-reduced-prison-term.html', 'snippet': 'Gregory Scarpa Jr., a captain in the Colombo crime family serving a decades-long prison term, was granted a 10-year sentence reduction for information on Terry Nichols, a co-conspirator of the Oklahoma City bombing.', 'lead_paragraph': 'During their hour-and-a-half outdoor sessions at the super-maximum security prison in Florence, Colo., Gregory Scarpa Jr. struck up a friendship with an important prisoner: Terry L. Nichols, the co-conspirator of the Oklahoma City bombing.', 'print_section': 'A', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Mafia Captain Turned Informer Gets a Reduced Prison Term', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Mafia Captain Turned Informer Has 10 Years Cut From His Prison Term', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Clifford, Stephanie', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Scarpa, Gregory Jr', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Nichols, Terry Lynn', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Organized Crime', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Bombs and Explosives', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Oklahoma City (Okla)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Terrorism', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Amnesties, Commutations and Pardons', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'United States Attorneys', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'Federal Bureau of Investigation', 'rank': 10, 'major': 'N'}], 'pub_date': '2016-01-06T01:05:04+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New 