y', 'rank': 13, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 14, 'major': 'N'}, {'name': 'glocations', 'value': 'ARIZONA', 'rank': 15, 'major': 'N'}, {'name': 'glocations', 'value': 'South Carolina', 'rank': 16, 'major': 'N'}, {'name': 'glocations', 'value': 'Texas', 'rank': 17, 'major': 'N'}], 'pub_date': '2016-01-19T18:00:24+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Francis X. Clines', 'person': [{'firstname': 'Francis', 'middlename': 'X.', 'lastname': 'Clines', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dd74c19c-d147-5431-bcfb-4f93587933ce', 'word_count': 461, 'uri': 'nyt://article/dd74c19c-d147-5431-bcfb-4f93587933ce'}, {'abstract': 'A new report suggests that we’re on the cusp of important, necessary changes in the way colleges evaluate applicants.', 'web_url': 'https://www.nytimes.com/2016/01/20/opinion/rethinking-college-admissions.html', 'snippet': 'A new report suggests that we’re on the cusp of important, necessary changes in the way colleges evaluate applicants.', 'lead_paragraph': 'Over recent years there’s been a steady escalation of concern about the admissions process at the most revered, selective American colleges. And little by little, those colleges have made tweaks.', 'print_section': 'A', 'print_page': '25', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/20/opinion/20bruniWeb/20bruniWeb-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/01/20/opinion/20bruniWeb/20bruniWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/20/opinion/20bruniWeb/