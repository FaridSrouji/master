title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b688c667-b5be-5fdd-b12f-8dcc1c2b54b5', 'word_count': 276, 'uri': 'nyt://article/b688c667-b5be-5fdd-b12f-8dcc1c2b54b5'}, {'abstract': 'An employee at the Orange County Central Men’s Jail was taken into custody on Thursday for aiding the escape of three inmates from the maximum security facility last week.', 'web_url': 'https://www.nytimes.com/2016/01/29/us/california-another-arrest-in-jail-break.html', 'snippet': 'An employee at the Orange County Central Men’s Jail was taken into custody on Thursday for aiding the escape of three inmates from the maximum security facility last week.', 'lead_paragraph': 'An employee at the Orange County Central Men’s Jail was taken into custody on Thursday for aiding the escape of three inmates from the maximum security facility last week. The employee, Nooshafarin Ravaghi, had taught English as a second language at the jail since July. At least one of the escapees, Hossein Nayeri, attended her class, and the two developed “some kind of relationship,” said Lt. Jeff Hallock, a spokesman for the Orange County Sheriff’s Department. Ms. Ravaghi, 44, provided Google maps and other help for the escape, Mr. Hallock said, but she has denied providing tools used in the escape. The three men cut through metal bars before rappelling from the jail’s roof using a makeshift rope. Investigators believe the three men may be in a white GMC utility van, which was stolen in Los Angeles on Saturday. ', 'print_section': 'A', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'California: Another Arrest in Jail Break', 'kicker': 'National Briefing | West', 'content_kicker': None, 'print_headline': 'California: Another Arrest in Jail Break', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Prison Escapes', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Orange County (Calif)', 'rank': 3, 'major': 'N'}], 'pub_date': '2016-01-29T03:24:41+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Ian Lovett', 'person': [{'firstname': 'Ian', 'middlename': None, 'lastname': 'Lovett', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/28b5082a-7383-5bca-b7de-e217a2fbd239', 'word_count': 139, 'uri': 'nyt://article/28b5082a-7383-5bca-b7de-e217a2fbd239'}, {'abstract': 'The Republican candidates debated without the sulky orange-haired front-runner. Trump was probably wise to skip it.', 'web_url': 'https://kristof.blogs.nytimes.com/2016/01/28/my-take-on-the-republican-debate-minus-trump/', 'snippet': 'The Republican candidates debated without the sulky orange-haired front-runner. Trump was probably wise to skip it.', 'lead_paragraph': 'The Republican candidates for president — with one big sulky orange-haired exception — dueled in a Fox News televised debate tonight. And my sense was that Trump was probably wise to skip it: He didn’t pay much of a price for staying away, he avoided tough questions and attacks, and his rivals used the occasion to slash each other. Bush had a better night than usual, and Rubio wrapped himself in the Bible in ways that may be effective in Iowa. Instead of writing a column, I’ve collected some of my tweets about the debate in this blog post. These are raw reflections, on the fly.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/28/opinion/28kristofWeb/28kristofWeb-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/01/28/opinion/28kristofWeb/28kristofWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/28/opinion/28kristofWeb/28kristofWeb-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/28/opinion/28kristofWeb/28kristofWeb-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/28/opinion/28kristofWeb/28kristofWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/01/28/opinion/28kristofWeb/28kristofWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/28/opinion/28kristofWeb/28kristofWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'My Take on the Republican Debate, Minus Trump', 'kicker': 'Nicholas Kristof', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Debates (Political)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Fox News Channel', 'rank': 3, 'major': 'N'}], 'pub_date': '2016-01-29T03:30:16+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Nicholas Kristof', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'Kristof', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8933bb80-3e7b-5923-a457-4dfefcae53d1', 'word_count': 769, 'uri': 'nyt://article/8933bb80-3e7b-5923-a457-4dfefcae53d1'}, {'abstract': 'As the Council completed a package of bills on lawmakers’ raises, questions surfaced about possible links to a bill shrinking the horse-cab industry.', 'web_url': 'https://www.nytimes.com/2016/01/29/nyregion/new-york-council-may-vote-on-raise-and-horse-carriage-bill-on-same-day.html', 'snippet': 'As the Council completed a package of bills on lawmakers’ raises, questions surfaced about possible links to a bill shrinking the horse-cab industry.', 'lead_paragraph': 'The City Council completed a package of bills on Thursday to give its members a raise for the first time since 2006, adopting provisions on outside income and financial disclosures called for by good-government groups while lifting their own pay far above the level recommended by a city commission.', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'New York Council May Vote on Raise and Horse-Carriage Bill on Same Day', 'kicker': None, 'content_kicker': None, 'print_headline': '<span data-tag="tight__4">City Council May Vote on Its Raise and a Horse-Carriage Bill on the Same Day</span>', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'City Council (NYC)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Rojas, Rick', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Carriages', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Horses', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'de Blasio, Bill', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Wages and Salaries', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'City Councils', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Mark-Viverito, Melissa', 'rank': 10, 'major': 'N'}], 'pub_date': '2016-01-29T03:30:35