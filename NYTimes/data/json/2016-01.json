g Syria and its people.', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/12/opinion/12tue1/12tue1-articleLarge.jpg', 'height': 743, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/01/12/opinion/12tue1/12tue1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 743}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/12/opinion/12tue1/12tue1-jumbo.jpg', 'height': 1024, 'width': 827, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/12/opinion/12tue1/12tue1-superJumbo.jpg', 'height': 1714, 'width': 1384, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/12/opinion/12tue1/12tue1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/01/12/opinion/12tue1/12tue1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/12/opinion/12tue1/12tue1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Agony and Starvation in the Syrian War', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Agony and Starvation in Syria', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Syria', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Malnutrition', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Humanitarian Aid', 'rank': 3, 'major': 'N'}, {'name': 