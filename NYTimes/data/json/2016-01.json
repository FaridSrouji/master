, 'url': 'images/2016/01/03/travel/03DOMINICAN3/03DOMINICAN3-jumbo-v2.jpg', 'height': 604, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/03/travel/03DOMINICAN3/03DOMINICAN3-superJumbo-v2.jpg', 'height': 1208, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/03/travel/03DOMINICAN3/03DOMINICAN3-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/01/03/travel/03DOMINICAN3/03DOMINICAN3-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/01/03/travel/03DOMINICAN3/03DOMINICAN3-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Reader Response: A Natural Hair Salon in Santo Domingo', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Race and Ethnicity', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Hair', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Beauty Salons', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Dominican Republic', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Santo Domingo (Dominican Republic)', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-01-07T17:29:20+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/78bf9844-073d-59ad-8d30-b87777666ff5', 'word_count': 710, 'uri': 'nyt://article/78bf9844-073d-59ad-8d30-b87777666ff5'}, {'abstract': 'Plus: an unhappy colleague who doesn’t hesitate to share, a party for a departing friend and prolonging a debate.', 'web_url': 'https://www.nytimes.com/2016/01/10/fashion/mama-mea-culpa-a-tattered-family-relationship-needs-mending.html', 'snippet': 'Plus: an unhappy colleague who doesn’t hesitate to share, a party for a departing friend and prolonging a debate.', 'lead_paragraph': 'My mother-in-law plays favorites, openly doting on my husband’s brother and his family. I ignored it for years; it didn’t seem to bother my husband. I also ignored that I was treated worse. But things changed when I had children. After a visit when my mother-in-law spent little time with my children, praising her other grandchildren instead, I sent a letter telling her what I had noticed. It was badly received. We have settled into an icy standoff. My children have not noticed their nana’s absence, but I hate to think of them not knowing her. What should I do?', 'print_section': 'ST', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-articleLarge-v2.jpg', 'height': 599, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/28/fashion/social_inline/social_inline-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 599}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-jumbo-v2.jpg', 'height': 923, 'width': 925, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-superJumbo-v2.jpg', 'heigh