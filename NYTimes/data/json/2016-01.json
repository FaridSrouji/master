nt': 0, 'uri': 'nyt://slideshow/c8b09ddc-1c47-574e-9bb7-d146d5b1a3d3'}, {'abstract': 'Oscar the Grouch has a recycling bin and Big Bird has moved to a tree as the children’s classic debuts on HBO, aiming at a generation that doesn’t distinguish between TV and mobile screens.', 'web_url': 'https://www.nytimes.com/2016/01/13/business/media/sesame-street-on-hbo.html', 'snippet': 'Oscar the Grouch has a recycling bin and Big Bird has moved to a tree as the children’s classic debuts on HBO, aiming at a generation that doesn’t distinguish between TV and mobile screens.', 'lead_paragraph': 'Big Bird’s nest has moved to a tree. Elmo has moved from an apartment into a brownstone. His best friend, Abby Cadabby, loves her new community garden. And while Oscar the Grouch still makes a trash can his home, he now pops up through an underground tunnel of connecting recycling and compost bins.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '‘Sesame Street’ Gets New Upscale Look for HBO Premiere', 'kicker': None, 'content_kicker': None, 'print_headline': 'Uptown Side of &#8216;Sesame Street&#8217; ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Home Box Office', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Sesame Workshop', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Public Broadcasting Service', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Children and Childhood', 'rank': 6, 'major': 'N'}, {'name': 'creative_works', 'value': 'Sesame Street (TV Program)', 'rank': 7, 'major': 'N'}], 'pub_date': '2016-01-12T14:23:23+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Emily Steel', 'person': [{'firstname': 'Emily', 'middlename': None, 'lastname': 'Steel', 'qualifier': N