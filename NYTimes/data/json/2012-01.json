': 'N'}, {'name': 'subject', 'value': 'Super Bowl', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New England Patriots', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Giants', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-01-23T12:30:16+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Toni Monkovic', 'person': [{'firstname': 'Toni', 'middlename': None, 'lastname': 'Monkovic', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/323e6009-f9dc-503d-a336-5710ecb727bf', 'word_count': 422, 'uri': 'nyt://article/323e6009-f9dc-503d-a336-5710ecb727bf'}, {'abstract': 'Just 10 percent of Indians are Internet subscribers.', 'web_url': 'https://india.blogs.nytimes.com/2012/01/23/increasing-internet-can-boost-gdp-study-says/', 'snippet': 'Just 10 percent of Indians are Internet subscribers.', 'lead_paragraph': 'India’s economy can grow more than 1 percent with every 10 percent increase in Internet subscribers, according to a New Delhi economic policy think tank.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Increasing Internet Can Raise G.D.P., Study Says', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Computers and the Internet', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Wireless Communications', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-01-23T12:39:22+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Hari Kumar', 'person': [{'firstname': 'Hari', 'middlename': None, 'lastname': 'Kumar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_mate