document_type': 'article', 'news_desk': '', 'section_name': 'Crosswords & Games', 'byline': {'original': 'By Deb Amlen', 'person': [{'firstname': 'Deb', 'middlename': None, 'lastname': 'Amlen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/62999da5-6c16-5d11-9bb4-c8517e1b52e0', 'word_count': 342, 'uri': 'nyt://article/62999da5-6c16-5d11-9bb4-c8517e1b52e0'}, {'abstract': 'Cynthia Nixon stars in Manhattan Theater Club’s revival of “Wit,” Margaret Edson’s play about a terminally ill English professor.', 'web_url': 'https://www.nytimes.com/2012/01/27/theater/reviews/cynthia-nixon-in-wit-at-manhattan-theater-club.html', 'snippet': 'Cynthia Nixon stars in Manhattan Theater Club’s revival of “Wit,” Margaret Edson’s play about a terminally ill English professor.', 'lead_paragraph': 'Cynthia Nixon’s gaze has its own grammar. Playing a terminally ill English professor in the inescapably moving new revival of Margaret Edson’s “Wit,” the 1999 Pulitzer Prize winner for drama, Ms. Nixon seems to construct perfectly composed, illuminating and surprising thoughts with her sky-blue eyes — the kind of thoughts that if you saw them in print would make you stop and savor and reread.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/27/arts/27WIT/27WIT-jumbo.jpg', 'height': 918, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/27/arts/27WIT/27WIT-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/27/arts/27WIT/27WIT-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Artifice a