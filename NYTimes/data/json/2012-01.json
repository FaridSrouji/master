d_count': 155, 'uri': 'nyt://article/441b7dee-8cce-5ffb-8d97-320a89532937'}, {'abstract': 'The success of the British drama “Downton Abbey” prompted the organization to change its programming and marketing tactics, and aim at viewers more attuned to HBO and Showtime.', 'web_url': 'https://www.nytimes.com/2012/01/02/business/media/pbs-shifts-tactics-to-reach-wider-audience.html', 'snippet': 'The success of the British drama “Downton Abbey” prompted the organization to change its programming and marketing tactics, and aim at viewers more attuned to HBO and Showtime.', 'lead_paragraph': 'In an effort to freshen its image and lift revenue, the Public Broadcasting Service is trying to be more like HBO — without the monthly cable bill.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/02/business/PBS/PBS-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/02/business/PBS/PBS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/02/business/PBS/PBS-jumbo.jpg', 'height': 740, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/02/business/PBS/PBS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/02/business/PBS/PBS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'PBS Takes On the Premium Channels', 'kicker': None, 'content_kicker': None, 'print_headline': 'PBS Takes On the Premium Channels', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Ho