content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Cedar, Joseph', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Falardeau, Philippe', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Farhadi, Asghar', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Holland, Agnieszka', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Madsen, Ole Christian', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Wenders, Wim', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-01-18T18:14:36+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/d460db66-fc9b-5dc5-9ff9-72f7bbe50e53', 'word_count': 104, 'uri': 'nyt://article/d460db66-fc9b-5dc5-9ff9-72f7bbe50e53'}, {'abstract': 'Brooks and Collins wonder whether there is such a thing as too much sunshine.', 'web_url': 'https://opinionator.blogs.nytimes.com/2012/01/18/can-i-see-your-tax-return/', 'snippet': 'Brooks and Collins wonder whether there is such a thing as too much sunshine.', 'lead_paragraph': 'David Brooks: Gail, I’m sorry we missed each other in South Carolina, but I’ve moved on to the next primary state, Florida, in search of people who pay Mitt Romney’s 15 percent tax rate. I’m in Palm Beach now. I think I’ve found them.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Can I See Your Tax Return?', 'kicker': 'Opinionator', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Presidents and Presidency (US)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Primaries and Caucuses', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Brooks, David', 'rank'