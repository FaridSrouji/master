t://article/77f4d90e-bf5a-570a-9e0e-6f167a25b2ac'}, {'abstract': 'The European Court of Human Rights said that Abu Qatada cannot be deported from Britain to his native Jordan because his trial there would be tainted by evidence obtained by torture.', 'web_url': 'https://www.nytimes.com/2012/01/18/world/europe/european-court-overrules-britain-on-terror-detainee.html', 'snippet': 'The European Court of Human Rights said that Abu Qatada cannot be deported from Britain to his native Jordan because his trial there would be tainted by evidence obtained by torture.', 'lead_paragraph': 'LONDON — The European Court of Human Rights ruled Tuesday that Abu Qatada, a radical Islamic preacher regarded as one of Al Qaeda’s main inspirational leaders in Europe, cannot be deported from Britain to his native Jordan because his trial there would be tainted by evidence obtained by torture.', 'print_section': 'A', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/18/world/BRITAIN/BRITAIN-jumbo.jpg', 'height': 753, 'width': 822, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/18/world/BRITAIN/BRITAIN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/18/world/BRITAIN/BRITAIN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'European Court Rules Britain Cannot Deport Terrorism Suspect', 'kicker': None, 'content_kicker': None, 'print_headline': 'European Court Rules Britain Cannot Deport Terrorism Suspect', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Othman, Omar Mahmoud Mohammed', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Decisions and Verdicts', 'rank': 2, 'major': 'N'}, {