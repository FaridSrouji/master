J.', 'lastname': "O'Brien", 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d6776b1a-9c97-56a8-8040-e0cf5da7c33b', 'word_count': 876, 'uri': 'nyt://article/d6776b1a-9c97-56a8-8040-e0cf5da7c33b'}, {'abstract': 'Cadets at the Citadel have been split on which Republican candidate to back in the presidential race.', 'web_url': 'https://www.nytimes.com/2012/01/21/us/politics/normally-united-citadel-cadets-differ-on-republican-favorite.html', 'snippet': 'Cadets at the Citadel have been split on which Republican candidate to back in the presidential race.', 'lead_paragraph': 'CHARLESTON, S.C. — At the Citadel, cadets wear matching uniforms, march in lockstep and endure rigorous physical training together. But these days, the Republicans among them — and they are overwhelmingly Republican — are divided on a crucial issue: whom to support as the next commander in chief.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Normally United, Citadel Cadets Differ on Republican Favorite', 'kicker': None, 'content_kicker': None, 'print_headline': 'Normally United, Citadel Cadets Differ on Republican Favorite', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Citadel, The Military College of South Carolina', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Gingrich, Newt', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Paul, Ron', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Santorum, Rick', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'South Carolina', 'rank': 8, 'major': 'N'}], 'pub_date': '2012-01-20T20:43:40+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Robbie Brown and Ben Werschkul', 'person': [{'firstname': 'Robbie', 'middlename': None, 'lastname': 'Brown', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Ben', 'middlename': None, 'lastname': 'Werschkul', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c2cbd462-04e5-5fdb-9c1f-6674bcf74f9c', 'word_count': 622, 'uri': 'nyt://article/c2cbd462-04e5-5fdb-9c1f-6674bcf74f9c'}, {'abstract': 'At fundraisers, donors get a serious message. And on one stage, the president delivers even more.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2012/01/20/obama-says-2012-choice-is-stark/', 'snippet': 'At fundraisers, donors get a serious message. And on one stage, the president delivers even more.', 'lead_paragraph': 'It is a political truism: fear is a major motivator for voters. And President Obama wants supporters to know that whoever emerges from the blood bath of the Republican primaries, that presidential nominee will be much farther to the right than Mr. Obama’s 2008 opponent, Senator John McCain.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Obama Says 2012 Choice Is Stark', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-01-20T20:46:11+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Jackie Calmes', 'person': [{'firstname': 'Jackie', 'middlename': None, 'lastname': 'Calmes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'ty