CAMP/MELLENCAMP-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/04/arts/MELLENCAMP/MELLENCAMP-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'On This Rock ’n’ Roll Tour of the Heartland, a Sobering Survey of Old America', 'kicker': "Movie Review | 'John Mellencamp: It’s About You'", 'content_kicker': None, 'print_headline': 'On This Rock ’n’ Roll Tour of the Heartland, a Sobering Survey of Old America', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Mellencamp, John', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Documentary Films and Programs', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-01-03T23:26:48+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Movies', 'byline': {'original': 'By Stephen Holden', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Holden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/df174c7f-dbb7-58a6-9f56-937957e318c4', 'word_count': 650, 'uri': 'nyt://article/df174c7f-dbb7-58a6-9f56-937957e318c4'}, {'abstract': 'The tape has become the material of choice for creating fashions that showcase the wearer’s originality and ingenuity.', 'web_url': 'https://www.nytimes.com/2012/01/05/fashion/duct-tape-goes-from-fix-it-to-dress-up-noticed.html', 'snippet': 'The tape has become the material of choice for creating fashions that showcase the wearer’s originality and ingenuity.', 'lead_paragraph': 'THERE was a time when Lady Gaga’s improvised pasties made out of duct tape might have been viewed as a creative, if painful, use of the handyman’s favorite fix-it. But a couple of strips of st