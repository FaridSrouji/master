s part of a cover-up.', 'print_section': 'A', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/20/world/20hacking-image/20hacking-image-jumbo.jpg', 'height': 649, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/20/world/20hacking-image/20hacking-image-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/20/world/20hacking-image/20hacking-image-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Murdoch Settles Suits by Dozens of Victims of Hacking', 'kicker': None, 'content_kicker': None, 'print_headline': 'Murdoch Settles Suits By Victims Of Hacking', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'News of the World', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'News Corporation', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Murdoch, Rupert', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Suits and Litigation', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Wiretapping and Other Eavesdropping Devices and Methods', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'News Group Newspapers', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'News and News Media', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-01-19T12:24:32+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Sarah Lyall and Ravi Somaiya', 'person': [{'firstname': 'Sarah', 'middlename': None, 'lastname': 'Lyall', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Ravi', 'middlename': None, 'las