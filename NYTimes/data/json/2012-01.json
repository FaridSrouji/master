value': 'Paris (France)', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-01-19T17:35:53+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Kevin Tachman', 'person': [{'firstname': 'Kevin', 'middlename': None, 'lastname': 'Tachman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c5d49bcc-56d1-5069-8679-76c01bda2749', 'word_count': 32, 'uri': 'nyt://article/c5d49bcc-56d1-5069-8679-76c01bda2749'}, {'abstract': '“Gil” sets ordinary life against a backdrop of visitation and child support.', 'web_url': 'https://parenting.blogs.nytimes.com/2012/01/19/a-new-comic-brings-divorce-to-the-funny-pages/', 'snippet': '“Gil” sets ordinary life against a backdrop of visitation and child support.', 'lead_paragraph': 'I’ve always loved the “funny pages.” We called them the “funnies,” as in, “Pass the funnies.” But my life, as the only child of two working parents, wasn’t one I saw in the Sunday comics, where big families, sibling battles and giant sandwiches seemed to be the norm.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A New Comic Brings Divorce to the Funny Pages', 'kicker': 'Motherlode', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-01-19T17:40:29+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': "By Kj Dell'Antonia", 'person': [{'firstname': 'Kj', 'middlename': None, 'lastname': "Dell'Antonia", 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/169dc50c-cc24-50d6-9d4b-7d437287a133', 'word_count': 482, 'uri': 'nyt://article/169dc50c-cc24-50d6-9d4b-7d437287a133'}, {'abstract': 'In an interview, Ryan Seacrest wouldn’t speculate about joining the show as a host should Matt Lauer leave when his contract expires at the end of the year: “Matt will have that post as long as Matt wants to have that post.”', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2012/01/19/as-seacrest-makes-deals-a-potential-role-on-today-still-looms/', 'snippet': 'In an interview, Ryan Seacrest wouldn’t speculate about joining the show as a host should Matt Lauer leave when his contract expires at the end of the year: “Matt will have that post as long as Matt wants to have that post.”', 'lead_paragraph': 'When Ryan Seacrest called on Thursday to talk about his investment in HDNet, the cable channel that will, with his help, become AXS TV later this year, we had to ask about his possible presence on another channel.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'As Seacrest Makes Deals, a Potential Role on ‘Today’ Still Looms', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'Today (TV Program)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Lauer, Matt', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Seacrest, Ryan', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Comcast Corporation', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'E! Entertainment Television', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'NBC News', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-01-19T17:41:02+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Brian Stelter', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Stelter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/31a94633-bd71-58bd-a78f-c33b8fa1405b', 'word_count': 572, 'uri': 'nyt://article/31a94633-bd71-58bd-a78f-c33b8fa1405b'}, {'abstract': 'Images from select films appearing at the 2012 Sundance Film Festival.', 'web_url': 'https://carpetbagger.blogs.nytimes.com/2012/01/19/slide-show-playing-at-sundance/', 'snippet': 'Images from select films appearing at the 2012 Sundance Film Festival.', 'lead_paragraph': 'The 2012 Sundance Film Festival opens today and runs through Jan. 29. Above are images from some of the more than 100 films screening this year.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Slide Show: Playing at Sundance', 'kicker': 'Carpetbagger', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Sundance Film Festival (Park City, Utah)', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-01-19T17:45:24+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Mekado Murphy', 'person': [{'firstname': 'Mekado', 'middlename': None, 'lastname': 'Murphy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a4d8acd9-8f56-5c79-8242-56fdb1e1f7d9', 'word_count': 26, 'uri': 'nyt://article/a4d8acd9-8f56-5c79-8242-56fdb1e1f7d9'}, {'abstract': 'Why many audience members who haven’t seen other versions of “Porgy and Bess,” especially in the opera house, are perfectly pleased with the new Broadway musical rendition.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/01/19/theater-talkback-watching-without-expectations/', 'snippet': 'Why many audience members who haven’t seen other versions of “Porgy and Bess,” especially in the opera house, are perfectly pleased with the new Broadway musical rendition.', 'lead_paragraph': 'The new production of “Porgy and Bess” that opened recently on Broadway – now crassly, not to mention inaccurately, branded “The Gershwins’ Porgy and Bess” – has become perhaps the most controversial musical revival in recent memory. It has been interesting to note how people are reacting to the show in different ways according to their familiarity with the score, and more particularly their history (or not) of hearing it in the opera house, where it has most regularly been performed since its Broadway debut in 1935. Despite l’affair Sondheim, many people seem to enjoy it.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Theater Talkback: Watching Without Expectations', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Brantley, Ben', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Gershwin, George', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Gershwin, Ira', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Heyward, DuBose', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Lewis, Norm', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'McDonald, Audra', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Murray, Diedre L', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Parks, Suzan-Lori', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Paulus, Diane', 'rank': 11, 'major': 'N'}, {'name': 'persons', 'value': 'Tommasini, Anthony', 'rank': 12, 'major': 'N'}], 'pub_date': '2012-01-19T17:45:49+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Charles Isherwood', 'person': [{'firstname': 'Charles', 'middlename': None, 'lastname': 'Isherwood', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6ee1aa89-918e-5f49-9af0-408e75654dd3', 'word_count': 868, 'uri': 'nyt://article/6ee1aa89-918e-5f49-9af0-408e75654dd3'}, {'abstract': 'A court review in Denver focused on low-risk immigrants, allowing more than 1,000 to stay without legal status.', 'web_url': 'https://www.nytimes.com/2012/01/20/us/in-test-of-deportation-policy-1-in-6-offered-reprieve.html', 'snippet': 'A court review in Denver focused on low-risk immigrants, allowing more than 1,000 to stay without legal status.', 'lead_paragraph': 'DENVER — A review ordered by the Obama administration of virtually all 7,900 deportation cases before the immigration court here has identified about 1,300 foreigners — 16 percent — who pose no security risk and will be allowed to remain in the United States, although with no new legal status, immigration officials said Thursday. ', 'print_section': 'A', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/20/us/IMMIG/IMMIG-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/20/us/IMMIG/IMMIG-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/20/us/IMMIG/IMMIG-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/20/us/IMMIG/IMMIG-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/20/us/IMMIG/IMMIG-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'In Deportation Policy Test, 1 in 6 Offered Reprieve', 'kicker': None, 'content_kicker': None, 'print_headline': 'In Test of Deportation Policy, 1 in 6 Get a Fresh Look and a Reprieve', 'name': None, 'seo': None, 'sub': N