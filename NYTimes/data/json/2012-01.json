age': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/13/sports/Neville/Neville-articleLarge-v2.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/13/sports/Neville/Neville-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/13/sports/Neville/Neville-jumbo-v2.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/13/sports/Neville/Neville-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/13/sports/Neville/Neville-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Fire Survivor and a Possible Olympian: A Horse Named Neville', 'kicker': None, 'content_kicker': None, 'print_headline': 'Fire Survivor and a Possible Olympian: A Horse Named Neville', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Olympic Games (2012)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Fires and Firefighters', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Horses', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Olympic Games', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Horsemanship and Equestrian Events', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-01-13T03:25:20+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Mary Pilon', 'person': [{'firstname': 'Mary', 'middlename': None, 'lastname': 'Pilon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bb7a5ade-254e-5c6f-84f4-7491a7b482d7', 'word_count': 1055, 'uri': 'nyt://article/bb7a5ade-254e-5c6f-84f4-7491a7b482d7'}, {'abstract': 'A former coach in New Canaan, Conn., is seeking Title IX protection in a lawsuit against a children’s league.', 'web_url': 'https://www.nytimes.com/2012/01/13/nyregion/woman-accuses-youth-lacrosse-league-of-discrimination-in-suit.html', 'snippet': 'A former coach in New Canaan, Conn., is seeking Title IX protection in a lawsuit against a children’s league.', 'lead_paragraph': 'There was the assistant lacrosse coach pressuring one of the girls’ head coaches to play his daughter and her friends more often. When the coach refused, the girls desiring more time would stop passing the ball to some of their teammates. They would besmirch them, repeating spiteful cracks other girls were supposedly making about them. ', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/13/nyregion/LACROSSE/LACROSSE-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/13/nyregion/LACROSSE/LACROSSE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/13/nyregion/LACROSSE/LACROSSE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Grievances and Theatrics in a Lacrosse Lawsuit', 'kicker': None, 'content_kicker': None, 'print_headline': 'Grievances and Theatrics in a Lacrosse Lawsuit', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Lacrosse', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Suits and Litigation', 'rank': 2, 'major':