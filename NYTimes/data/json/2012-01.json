: 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/08/nyregion/08ARTSNJ3/08ARTSNJ3-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Celebrating Fluxus, a Movement That Didn’t Create by the Rules', 'kicker': 'Arts | New Jersey', 'content_kicker': None, 'print_headline': 'Celebrating a Movement That Didn’t Create by the Rules', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Zimmerli Art Museum', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Rutgers, The State University of New Jersey', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Fluxus', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'New Jersey', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-01-07T02:11:59+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Martha Schwendener', 'person': [{'firstname': 'Martha', 'middlename': None, 'lastname': 'Schwendener', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/c641005c-77b3-5da8-9f40-a336037e36a4', 'word_count': 1149, 'uri': 'nyt://article/c641005c-77b3-5da8-9f40-a336037e36a4'}, {'abstract': 'Congress should end the subsidies to Big Oil and redeploy the money saved to support truly new energy technologies, like wind and solar power.', 'web_url': 'https://www.nytimes.com/2012/01/07/opinion/one-bad-energy-subsidy-expires.html', 'snippet': 'Congress should end the subsidies to Big Oil and redeploy the money saved to support truly new energy technologies, like wind and solar power.', 'lead_paragraph': 'Now that the most polarized and paralyzed Congress in memory has managed to kill one of its most resilient boondoggles — the three-decade-old, multibillion-dollar subsidy for corn ethanol — we hope it has not exhausted its resolve and will take a hatchet to other harmful energy subsidies, chiefly those it gives to fossil fuels.', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'One Bad Energy Subsidy Expires', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'One Bad Energy Subsidy Expires', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Corn', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Ethanol', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Tax Credits, Deductions and Exemptions', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Crop Controls and Subsidies', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Alternative and Renewable Energy', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'Oil (Petroleum) and Gasoline', 'rank': 10, 'major': 'N'}], 'pub_date': '2012-01-07T02:13:26+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/fd8a37de-a0d5-5fd4-b35a-981bede1b280', 'word_count': 556, 'uri': 'nyt://article/fd8a37de-a0d5-5fd4-b35a-981bede1b280'}, {'abstract': 'The aircraft carrier John C. Stennis broke up a high-seas pirate attack on a cargo ship in the Gulf of Oman, freeing 13 Iranian hostages who had been held captive by pirates for more than a month.', 'web_url': 'https://www.nytimes.com/slideshow/2012/01/06/world/20120107_PIRATES_GOBIG.html', 'snippet': 'The aircraft carrier John C. Stennis broke u