qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/a273d65c-96d2-5898-acde-7f07630dbba6', 'word_count': 0, 'uri': 'nyt://video/a273d65c-96d2-5898-acde-7f07630dbba6'}, {'abstract': 'The National Archives unearths thousands of photographs commissioned by the fledgling Environmental Protection Agency in the 1970’s, when the country was shifting from the untrammeled exploitation of natural resources to a more aspirational attitude.', 'web_url': 'https://green.blogs.nytimes.com/2012/01/04/a-photographic-blast-from-the-past/', 'snippet': 'The National Archives unearths thousands of photographs commissioned by the fledgling Environmental Protection Agency in the 1970’s, when the country was shifting from the untrammeled exploitation of natural resources to a more aspirational attitu...', 'lead_paragraph': 'In January 1972, the Environmental Protection Agency asked nearly 100 freelance photographers to roam the country in the pursuit of a single goal: documenting “the environmental happenings and non-happenings” of the decade. By 1977, the photographers had submitted more than 80,000 images for the project, known as Documerica. About one-quarter of the photographs were shown in public exhibitions but then filed away and largely forgotten.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Photographic Blast From the Past', 'kicker': 'Green', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Archives and Records', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Higgins, Chester Jr', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Farm Security Administration', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'National Archives and Records Administration', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-01-04T19:10:32+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Science', 'subsection_name': 'Environment', 'byline': {'original': 'By Dylan Walsh', 'person': [{'firstname': 'Dylan', 'middlename': None, 'lastname': 'Walsh', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b1ad775f-51d7-5272-945a-80d5fda212e1', 'word_count': 480, 'uri': 'nyt://article/b1ad775f-51d7-5272-945a-80d5fda212e1'}, {'abstract': 'The nation’s largest cable provider will have access to Disney networks, including the Disney Channel and ESPN, in a deal that is worth hundreds of millions of dollars in revenue for the entertainment company.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2012/01/04/comcast-in-10-year-deal-for-disney-content/', 'snippet': 'The nation’s largest cable provider will have access to Disney networks, including the Disney Channel and ESPN, in a deal that is worth hundreds of millions of dollars in revenue for the entertainment company.', 'lead_paragraph': '1/5/12 | Updated In a deal that represents billions of dollars in revenue for the Walt Disney Company, the entertainment giant and Comcast said Wednesday that they had reached a decade-long distribution agreement covering all of Disney’s television content, including streaming for iPads and other devices.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Comcast’s 10-Year Deal With Disney Includes Out-of-Home Viewing', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-01-04T19:13:14+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Amy Chozick and Brooks Barnes', 'person': [{'firstname': 'Amy', 'middlename': None, 'lastname': 'Chozick', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Brooks', 'middlename': None, 'lastname': 'Barnes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/884f67bd-424a-5317-bca3-3a71a1f564d3', 'word_count': 795, 'uri': 'nyt://article/884f67bd-424a-5317-bca3-3a71a1f564d3'}, {'abstract': 'Rangers Coach John Tortorella said his comments about referees after the Winter Classic were meant to be “tongue-in-cheek.”', 'web_url': 'https://slapshot.blogs.nytimes.com/2012/01/04/tortorella-apologizes-for-winter-classic-comments/', 'snippet': 'Rangers Coach John Tortorella said his comments about referees after the Winter Classic were meant to be “tongue-in-cheek.”', 'lead_paragraph': '8:30 p.m. | Update Tortorella was fined $30,000 by the N.H.L., according to a league official.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Tortorella Fined for Winter Classic Comments', 'kicker': 'Slap Shot', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Tortorella, John', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'National Hockey League', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Rangers', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Philadelphia Flyers', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-01-04T19:14:03+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Hockey', 'byline': {'original': 'By Christopher Botta', 'person': [{'firstname': 'Christopher', 'middlename': None, 'lastname': 'Botta', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/64b3b385-5cdf-5437-81d7-24214894e052', 'word_count': 402, 'uri': 'nyt://article/64b3b385-5cdf-5437-81d7-24214894e052'}, {'abstract': 'Philipp M. Hildebrand bought and sold currency as he was directing monetary policy to control the rise of the Swiss franc, a magazine reported.', 'web_url': 'https://www.nytimes.com/2012/01/05/business/global/05iht-snb05.html', 'snippet': 'Philipp M. Hildebrand bought and sold currency as he was directing monetary policy to control the rise of the Swiss franc, a magazine reported.', 'lead_paragraph': 'FRANKFURT — Philipp M. Hildebrand, chairman of Switzerland’s central bank and a well-known architect of tougher global banking regulations, came under pressure Wednesday after a Swiss publication reported that he profited from currency trades made before and after he oversaw steps to prevent the Swiss franc from becoming too strong.', 'print_section': 'B', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/05/business/SNB/SNB-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/05/business/SNB/SNB-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/05/business/SNB/SNB-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Insider Trading Accusations Are Reported Against Swiss Bank’s Chairman', 'kicker': None, 'content_kicker': None, 'print_headline': 'Insider Trading Accusations Are Reported Against Swiss Bank’s Chairman', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Switzerland', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Basel Committee on Banking Supervision', 'rank': 2, 'major':