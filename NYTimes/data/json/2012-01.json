 'person': [{'firstname': 'Nick', 'middlename': None, 'lastname': 'Corasaniti', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d88088fd-747f-526c-b452-5d50361890a4', 'word_count': 208, 'uri': 'nyt://article/d88088fd-747f-526c-b452-5d50361890a4'}, {'abstract': 'Some supporters of the ruling protecting churches from some employment discrimination suits said religious organizations were still obligated to treat employees fairly.', 'web_url': 'https://www.nytimes.com/2012/01/12/us/hosanna-tabor-ruling-welcomed-by-religious-groups.html', 'snippet': 'Some supporters of the ruling protecting churches from some employment discrimination suits said religious organizations were still obligated to treat employees fairly.', 'lead_paragraph': 'Among the more or less predictable reactions from legal adversaries to the Supreme Court’s finding that ministers may not bring employment discrimination suits against their churches, there is a pious sentiment to be found here and there — an appeal to an even higher law.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Religious Groups Greet Ruling With Satisfaction', 'kicker': None, 'content_kicker': None, 'print_headline': 'Religious Groups Greet Ruling With Satisfaction', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Supreme Court', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Decisions and Verdicts', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Religion-State Relations', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Discrimination', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Freedom of Religion', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-01-11T21:26:00+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By John H. Cushman Jr', 'person': [{'firstname': 'J