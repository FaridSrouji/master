nk': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Party', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-01-24T22:16:12+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By John Harwood', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Harwood', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dea23826-eaa3-57d0-ab0c-7942e9dec948', 'word_count': 1096, 'uri': 'nyt://article/dea23826-eaa3-57d0-ab0c-7942e9dec948'}, {'abstract': 'Worlds collided in a lot of the clothing shown in Europe, with seemingly incongruous fabric and style combinations working surprisingly well.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2012/01/24/coming-soon-mash-ups/', 'snippet': 'Worlds collided in a lot of the clothing shown in Europe, with seemingly incongruous fabric and style combinations working surprisingly well.', 'lead_paragraph': 'var data;function jsonSlideshowCallback(response){data = response;}NYTD.options = {source: data,cropType: \'blog480\',appendTo: \'fullScreenSlideShow\',showHeadLine: \'false\', renderstyle: "embeddedSlideShowTmag"}', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Coming Soon | Mash-Ups', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-01-24T22:19:55+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Bruce Pask', 'person': [{'firstname': 'Bruce', 'middlename': None, 'lastname': 'Pask', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c0312a11-1fdd-569b-b95c-8f04f691f76b', 'word_count': 306, 'uri': 'nyt://article/c0312a11-1fdd-569b-b95c-8f04f691f76b'}, {'abstract': 'Called the Tasti-Lee, a hefty crimson beefsteak from Florida is meaty, juicy and flavorful.', 'web_url': 'https://www.nytimes.com/2012/01/25/dining/a-winter-tomato-worth-buying.html', 'snippet': 'Called the Tasti-Lee, a hefty crimson beefsteak from Florida is meaty, juicy and flavorful.', 'lead_paragraph': 'Lucky Lee has been selling vine-ripened Florida tomatoes for decades, mainly to restaurants in winter. Now she has a new one, a hefty crimson beefsteak. It’s meaty, juicy, flavorful and, yes, a winter tomato that’s actually worth buying. Called the Tasti-Lee, it is a hybrid developed by Jay Scott, a tomato breeder at the University of Florida. The Lee part of the name, though, has nothing to do with Ms. Lee, the distributor who has just introduced them in the New York area; Mr. Scott named the tomato in honor of his late mother-in law, Leocadia Czarnomski. ', 'print_section': 'D', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/25/dining/25STUFF_TOMATOESPAN/25STUFF_TOMATOESPAN-articleLarge-v2.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/25/dining/25STUFF_TOMATOESPAN/25STUFF_TOMATOESPAN-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/25/dining/25STUFF_TOMATOESPAN/25STUFF1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/25/dining/25STUFF_TOMATOESPAN/25STUFF_PIESSPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/25/dining/25STUFF_TOMATOESPAN/25STUFF_PIESSPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Winter Tomato Worth Buying', 'kicker': 'Food Stuff', 'content_kicker': None, 'print_headline': 'A Winter Tomato Worth Buying', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Tomatoes', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-01-24T22:20:27+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8a9a443c-3086-56a1-b911-e7673754f631', 'word_count': 151, 'uri': 'nyt://article/8a9a443c-3086-56a1-b911-e7673754f631'}, {'abstract': 'In “History of the World,” Judith Malina’s new play at the Living Theater, the audience is taken on a dizzying flight through the course of Western civilization.', 'web_url': 'https://www.nytimes.com/2012/01/25/theater/reviews/history-of-the-world-at-the-living-theater.html', 'snippet': 'In “History of the World,” Judith Malina’s new play at the Living Theater, the audience is taken on a dizzying flight through the course of Western civilization.', 'lead_paragraph': 'Judith Malina — a founder and unsinkable bulwark of the Living Theater, a beacon of experimental performance in New York since 1947 — instigates another rebellion with “History of the World,” now at the troupe’s Lower East Side home. Though Ms. Malina, at 85, shows no loss of fight, there is something almost elegiac about her latest piece, no less than an exuberant, dizzying and exhausting flight through the course of Western civilization, peppered with political observations. Certainly Ms. Malina has earned the right to conduct such an ambitious survey.', 'print_section': 'C', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/25/arts/sub-history-1/sub-history-1-articleLarge.jpg', 'height': 345, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/25/arts/sub-history-1/sub-history-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 345}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/25/arts/sub-history-1/sub-history-1-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/25/arts/sub-history-1/sub-history-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/25/arts/sub-history-1/sub-history-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'From the Crucifixion to the Internet, You Are There', 'kicker': 'Theater Review ', 'content_kicker': None, 'print_headline': 'From the Crucifixion to the Internet, You Are There', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Living Theater', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Malina, Judith', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-24T22:22:06+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Theater', 'subsection_name': 'Theater Reviews', 'byline': {'original': 'By Andy Webster', 'person': [{'firstname': 'Andy', 'middlename': None, 'lastname': 'Webster', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 