middlename': None, 'lastname': 'Gottipati', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a8433e5f-ef89-568b-ae0e-74c5a31932dd', 'word_count': 249, 'uri': 'nyt://article/a8433e5f-ef89-568b-ae0e-74c5a31932dd'}, {'abstract': 'Pressure is building on Lisbon, and nations like Greece and Spain continue to reel.', 'web_url': 'https://www.nytimes.com/2012/01/31/business/global/spanish-economy-shrinks.html', 'snippet': 'Pressure is building on Lisbon, and nations like Greece and Spain continue to reel.', 'lead_paragraph': 'Investors fled out of bonds of weaker European countries on Monday, sending yields on Portuguese government bonds to a record high over concerns that the euro zone debt troubles were spreading beyond Greece.', 'print_section': 'B', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Portugal Suffers as Loss of Confidence in Bonds Sends Yields Higher', 'kicker': 'Stocks and Bonds', 'content_kicker': None, 'print_headline': 'Portugal Suffers as Loss of Confidence in Bonds Sends Yields Higher', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Stocks and Bonds', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'European Sovereign Debt Crisis (2010- )', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Economic Conditions and Trends', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Spain', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Portugal', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'European Union', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-01-30T13:15:51+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Global Business', 'byline': {'original': 'By Christine Hauser and David Jolly', 'person': [{'firstname': 'Christine', 'middlename': None, 'lastname': 'Hauser', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'David', 'middlename': None, 'lastname': 'Jolly', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cadb46c0-f89d-5c21-a0b6-8718ef689c53', 'word_count': 810, 'uri': 'nyt://article/cadb46c0-f89d-5c21-a0b6-8718ef689c53'}, {'abstract': 'Despite what appears to have been a disaster averted, the incident highlighted China’s continuing struggle against contamination of its waterways.', 'web_url': 'https://www.nytimes.com/2012/01/31/world/asia/china-says-it-curbed-spill-of-toxic-metal-in-river.html', 'snippet': 'Despite what appears to have been a disaster averted, the incident highlighted China’s continuing struggle against contamination of its waterways.', 'lead_paragraph': 'BEIJING — Officials in southern China appear to have averted environmental calamity by halting the spread of a toxic metal that had threatened to foul drinking water for tens of millions of people, the state media reported Monday. ', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/31/world/31china1_span/31china1_span-articleLarge.jpg', 'height': 370, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/31/world/31china1_span/31china1_span-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 370}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/31/world/31china1_span/31china1_span-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/31/world/31china1_span/31china1_span-thumbStandard.j