: None}, 'type_of_material': 'News', '_id': 'nyt://article/d2fea48d-202c-57d7-8a98-a6a5007a2929', 'word_count': 222, 'uri': 'nyt://article/d2fea48d-202c-57d7-8a98-a6a5007a2929'}, {'abstract': 'Ron Paul is taking a day out of presidential campaigning on Wednesday to return to Washington to vote against an increase in the nation’s debt ceiling.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2012/01/17/paul-to-return-to-congress-for-debt-ceiling-vote/', 'snippet': 'Ron Paul is taking a day out of presidential campaigning on Wednesday to return to Washington to vote against an increase in the nation’s debt ceiling.', 'lead_paragraph': 'COLUMBIA, S.C. — Representative Ron Paul of Texas is taking a day off from campaigning on Wednesday to return to Washington to vote against an increase in the nation’s debt ceiling, forgoing a day on the hard-fought trail just three days before South Carolina’s presidential primary.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Paul to Break From Trail for Debt Ceiling Vote', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'National Debt (US)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Paul, Ron', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'South Carolina', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-01-17T22:25:28+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Richard A. Oppel Jr', 'person': [{'firstname': 'Richard', 'middlename': 'A.', 'lastname': 'Oppel', 'qualifier': 'Jr', 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/741aa6df-4bc3-5cc8-a8e1-190522ace368', 'word_count': 213, 'uri': 'nyt://article/741aa6df-4bc3-5cc8-a8e1-190522ace368'}, {'abstract': 'Diane Paulus, the director of “The Gershwins’ Porgy and Bess,” will oversee a new Cirque du Soleil production called “Amaluna” that opens in Canada in April.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/01/17/porgy-and-bess-director-will-take-on-cirque-du-soleil-next/', 'snippet': 'Diane Paulus, the director of “The Gershwins’ Porgy and Bess,” will oversee a new Cirque du Soleil production called “Amaluna” that opens in Canada in April.', 'lead_paragraph': ' Diane Paulus is moving from Catfish Row to a mysterious island. The producers of Cirque du Soleil announced this week that Ms. Paulus, the director of “The Gershwins’ Porgy and Bess,” which just opened on Broadway, is set to direct “Amaluna,” the company’s latest touring spectacle, which will open in Montreal on April 19 before moving to Quebec City and Toronto. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '‘Porgy and Bess’ Director Will Take on Cirque du Soleil Next', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-01-17T22:31:55+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Felicia R. Lee', 'person': [{'firstname': 'Felicia', 'middlename': 'R.', 'lastname': 'Lee', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/36e50f3f-5e5c-53cc-a9fc-8beffdbe76d4', 'word_count': 270, 'uri': 'nyt://article/36e50f3f-5e5c-53cc-a9fc-8beffdbe76d4'}, {'abstract': 'How to bring the avant-garde recipes of “Modernist Cuisine,” the multivolume cookbook co-authored by Nathan Myrhvold, to a home kitchen.', 'web_url': 'https://www.nytimes.com/2012/01/18/dining/modernist-cuisine-adapted-to-home-entertaining.html', 'snippet': 'How to bring the avant-garde recipes of “Modernist Cuisine,” the multivolume cookbook co-authored by Nathan Myrhvold, to a home kitchen.', 'lead_paragraph': 'MY friends were perplexed when I invited them over for a dinner party based entirely on recipes from “Modernist Cuisine: The Art and Science of Cooking,” the multivolume examination of avant-garde cooking and culinary technology.', 'print_section': 'D', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/18/dining/18APPE1_SPAN/18APPE1_SPAN-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/18/dining/18APPE1_SPAN/18APPE1_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/18/dining/18APPE1_SPAN/18JPAPPE1-jumbo.jpg', 'height': 620, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/18/dining/18APPE1_SPAN/18APPE1_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/18/dining/18APPE1_SPAN/18APPE1_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Sorcerer’s Apprentice Hosts a Dinner', 'kicker': 'A Good Appetite', 'content_kicker': None, 'print_headline': 'Sorcerer’s Apprentice Hosts A Dinner', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'valu