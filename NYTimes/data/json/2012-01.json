': 'Straight Sets', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-01-28T14:26:44+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By JOHN MARTIN', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'MARTIN', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9ee74c6b-98dc-514e-b74e-696892e67a82', 'word_count': 780, 'uri': 'nyt://article/9ee74c6b-98dc-514e-b74e-696892e67a82'}, {'abstract': 'The candidates’ teams can reach voters, gather data and respond to charges immediately, but the brief posts also carry danger.', 'web_url': 'https://www.nytimes.com/2012/01/29/us/politics/twitter-is-a-critical-tool-in-republican-campaigns.html', 'snippet': 'The candidates’ teams can reach voters, gather data and respond to charges immediately, but the brief posts also carry danger.', 'lead_paragraph': 'When Newt Gingrich said in a recent debate that he was a man of “grandiose” ideas, Mitt Romney’s campaign pounced. It sent mocking Twitter messages with a hashtag, “#grandiosenewt”, encouraging voters to add their own examples of occasions when they felt Mr. Gingrich had been “grandiose.”', 'print_section': 'A', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/29/us/politics/29twitter1_span/29twitter1_span-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/29/us/politics/29twitter1_span/29twitter1_span-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/29/us/politics/29twitter1_span/29twitt