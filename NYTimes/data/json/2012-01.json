ocument_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By Brian X. Chen', 'person': [{'firstname': 'Brian', 'middlename': 'X.', 'lastname': 'Chen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/886fe834-0813-526e-beb3-201f93199f0c', 'word_count': 288, 'uri': 'nyt://article/886fe834-0813-526e-beb3-201f93199f0c'}, {'abstract': 'Intel Science Talent Search semifinalist Samantha Garvey got a grand tour of Washington this week.', 'web_url': 'https://www.nytimes.com/2012/01/31/science/homeless-science-whiz-goes-to-washington.html', 'snippet': 'Intel Science Talent Search semifinalist Samantha Garvey got a grand tour of Washington this week.', 'lead_paragraph': 'Samantha Garvey, the Long Island teenager who made headlines because her family was living in a homeless shelter when she was named a semifinalist in the Intel Science Search, was still homeless last Tuesday, when she went to Washington. Invited by her congressman, Steve Israel, she met with John P. Holdren, the president’s science adviser; John Boehner, the speaker of the House; and Nancy Pelosi, the minority leader. And she had dinner with Jane Lubchenco, administrator of the National Oceanic and Atmospheric Administration.', 'print_section': 'D', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Homeless Science Whiz Goes to Washington', 'kicker': 'Update', 'content_kicker': None, 'print_headline': 'To the Capitol, And a New Home', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Intel Corporation', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Washington (DC)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Israel, Steve J', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Awards, Decorations and Honors', 'rank': 4, 'major': 'N'}, {'name': 'persons'