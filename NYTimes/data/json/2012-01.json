: None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f0c8d8bd-5fd6-55a3-b7da-99726eac7e81', 'word_count': 260, 'uri': 'nyt://article/f0c8d8bd-5fd6-55a3-b7da-99726eac7e81'}, {'abstract': 'Eric Korsh and his wife, Ginevra Iverson, had run Restaurant Eloise in Sebastopol, Calif., and will be working together for the first time since then.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2012/01/23/waverly-inn-chef-plans-to-open-calliope/', 'snippet': 'Eric Korsh and his wife, Ginevra Iverson, had run Restaurant Eloise in Sebastopol, Calif., and will be working together for the first time since then.', 'lead_paragraph': 'Eric Korsh, the executive chef at the Waverly Inn, will be leaving in a couple of months and plans to open Calliope in the East Village, with his wife, Ginevra Iverson, a former cook at Prune. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Waverly Inn Chef Plans to Open Calliope', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-01-23T20:43:50+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a208c3d9-e8a8-517b-9fc7-8164255870bb', 'word_count': 234, 'uri': 'nyt://article/a208c3d9-e8a8-517b-9fc7-8164255870bb'}, {'abstract': 'Josh Radnor takes his new film, “Liberal Arts,” to Sundance and figures out how to work “the Bagger” into a comment.', 'web_url': 'https://carpetbagger.blogs.nytimes.com/2012/01/23/hey-the-bagger-josh-radnor-has-a-few-questions/', 'snippet': 'Josh Radnor takes his new film, “Liberal Arts,” to Sundance and figures out how to work “the Bagger” into a comment.', 'lead_paragraph': 'PARK CITY, Utah — “Are you what they call the Carpetbagger, or the Bagger?” the actor and filmmaker Josh Radnor asked us at a party the other night. “Can I refer to you as ‘the Bagger,’ but to your face?” he continued. “I can say, ‘listen, the Bagger –‘”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Hey the Bagger, Josh Radnor Has a Few Questions', 'kicker': 'Carpetbagger', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Sundance Film Festival (Park City, Utah)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Radnor, Josh', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-01-23T20:45:27+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Melena Ryzik', 'person': [{'firstname': 'Melena', 'middlename': None, 'lastname': 'Ryzik', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dbc5984a-f2a1-5c39-95d2-8cbb21095f6a', 'word_count': 358, 'uri': 'nyt://article/dbc5984a-f2a1-5c39-95d2-8cbb21095f6a'}, {'abstract': 'If anyone still had any doubt that Newt Gingrich had dispensed with professional consultants, it should have been put to rest when he unveiled his new campaign slogan.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2012/01/23/what-campaign-slogans-tell-us-about-the-candidates/', 'snippet': 'If anyone still had any doubt that Newt Gingrich had dispensed with professional consultants, it should have been put to rest when he unveiled his new campaign slogan.', 'lead_paragraph': 'If anyone still had any doubt that Newt Gingrich had dispensed with professional consultants and was now acting as his own chief strategist, it should have been put to rest Saturday night in South Carolina, when he proudly unveiled for the world his new campaign slogan: “Unleash the American people, rebuild the America we love.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What Campaign Slogans Tell Us About the Candidates', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-01-23T20:47:48+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Matt Bai', 'person': [{'firstname': 'Matt', 'middlename': None, 'lastname': 'Bai', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a8403aef-25d7-59f0-bba5-d633864849fa', 'word_count': 614, 'uri': 'nyt://article/a8403aef-25d7-59f0-bba5-d633864849fa'}, {'abstract': 'At the La Brea Tar Pits, fossils preserved in tar provide a time capsule of the creatures that roamed Southern California 10,000 to 40,000 years ago.', 'web_url': 'https://www.nytimes.com/2012/01/24/science/at-la-brea-tar-pits-relics-from-long-before-freeways.html', 'snippet': 'At the La Brea Tar Pits, fossils preserved in tar provide a time capsule of the creatures that roamed Southern California 10,000 to 40,000 years ago.', 'lead_paragraph': 'LOS ANGELES — No one expects to stumble across a cache of Picasso’s works in the middle of a desert. So who would think that just off bustling Wilshire Boulevard, tucked between the Los Angeles County Museum of Art and the national headquarters of the Screen Actors Guild, lie buried some of the most exquisitely preserved fossils in the world?', 'print_section': 'D', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/24/science/24CREA1_SPAN/24CREA1_SPAN-articleLarge.jpg', 'heig