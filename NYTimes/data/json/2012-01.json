, 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6b0ec3ab-0a35-515d-930e-c8200ab80cc2', 'word_count': 1233, 'uri': 'nyt://article/6b0ec3ab-0a35-515d-930e-c8200ab80cc2'}, {'abstract': 'The Washington Post announced that it and other media organizations would be answering questions in place of Wikipedia — submissions would come via Twitter with the hashtag #altwiki.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2012/01/17/the-great-wikipedia-blackout-of-2012-media-try-to-fill-the-void/', 'snippet': 'The Washington Post announced that it and other media organizations would be answering questions in place of Wikipedia — submissions would come via Twitter with the hashtag #altwiki.', 'lead_paragraph': '6:10 p.m. | Updated Our friends at The Washington Post announced an ambitious plan to fill the void during the Great Wikipedia Blackout of 2012: a Twitter campaign to answer Internet users’ questions, à la Wikipedia.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Great Wikipedia Blackout of 2012: The Media Try to Fill the Void', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Twitter', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Wikipedia', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-01-17T23:05:53+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Noam Cohen', 'person': [{'firstname': 'Noam', 'middlename': None, 'lastname': 'Cohen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/da695f82-2345-5176-abfa-5cb0e765b804', 'word_count': 209, 'uri': 'nyt://article/da695f82-2345-5176-abfa-5cb0e765b804'}, {'abstract': 'Real Madrid and Barcelona will play two times in the next week in the quarterfinals of Spain’s Copa del Rey tournament.', 'web_url': 'https://goal.blogs.nytimes.com/2012/01/17/clasico-overload-is-that-possible/', 'snippet': 'Real Madrid and Barcelona will play two times in the next week in the quarterfinals of Spain’s Copa del Rey tournament.', 'lead_paragraph': 'Could a Real Madrid-Barcelona clásico ever be considered to be passéico (with apologies to the city of Passaic, N.J., a place where I worked many, many years ago)?', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Clásico Overload? Is That Possible?', 'kicker': 'Goal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Soccer', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Barcelona (Soccer Team)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'La Liga', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Real Madrid (Basketball Team)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Madrid (Spain)', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-01-17T23:06:57+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Soccer', 'byline': {'original': 'By Jack Bell', 'person': [{'firstname': 'Jack', 'middlename': None, 'lastname': 'Bell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/63da6163-e200-58a9-a25c-cf0164c83cf7', 'word_count': 543, 'uri': 'nyt://article/63da6163-e200-58a9-a25c-cf0164c83cf7'}, {'abstract': '“Miranda,” an opera by Kamala Sankaram at Here Arts Center, answers the question: Who killed Miranda Wright, a diet-pill heiress?', 'web_url': 'https://www.nytimes.com/2012/01/18/arts/music/miranda-an-opera-by-kamala-sankaram-review.html', 'snippet': '“Miranda,” an opera by Kamala Sankaram at Here Arts Center, answers the question: Who killed Miranda Wright, a diet-pill heiress?', 'lead_paragraph': 'The residency program at the Here Arts Center in the South Village encourages composers, choreographers, playwrights, video artists and even puppeteers to get into one another’s business and to create freewheeling hybrids. It is an ideal home for a musician like Kamala Sankaram. ', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/18/arts/MIRANDA/MIRANDA-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/18/arts/MIRANDA/MIRANDA-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/18/arts/MIRANDA/MIRANDA-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/18/arts/MIRANDA/MIRANDA-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/18/arts/MIRANDA/MIRANDA-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'The Hiss of Steampunk, the Roar of the Digital Judge', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'The Hiss of Steampunk, the Roar of the Digital Judge', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'HERE Arts Center', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Opera', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-17T23:09:27+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music