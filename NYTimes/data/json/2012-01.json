nk': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/22/travel/22SPAIN1_SPAN/22SPAIN1_SPAN-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/22/travel/22SPAIN1_SPAN/22SPAIN1_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/22/travel/22SPAIN1_SPAN/22SPAIN1_SPAN-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/22/travel/22SPAIN1_SPAN/22SPAIN1_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/22/travel/22SPAIN1_SPAN/22SPAIN1_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Skiing the Spanish Pyrenees', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Snow In Spain', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Pyrenees Mountains', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Skiing', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'ALPINE SKIING', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Spain', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-01-20T15:47:33+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Christopher Solomon', 'person': [{'firstname': 'Christopher', 'middlename': None, 'lastname': 'Solomon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6256443e-e690-59c1-9a63-fa9fea41204f', 'word_count': 2594, 'uri': 'nyt://article/6256443e-e690-59c1-9a63-fa9fea41204f'}, {'abstract': 'Readers respond to a Practical Traveler column.', 'web_url': 'https://www.nytimes.com/2012/01/22/travel/enough-snow.html', 'snippet': 'Readers respond to a Practical Traveler column.', 'lead_paragraph': 'To the Editor: Re “Oh, for Just a Little Snow” (Practical Traveler, Jan. 15), I teach skiing at Park City Mountain Resort. Maybe the snow totals look weak, but with top-gun snowmaking and state-of the-art grooming, the main runs are as good as it gets. The days are sunny and warm. No one is unhappy. I’ve been up there since opening day in mid-November and have not hit a rock yet.\xa0', 'print_section': 'TR', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Enough Snow?', 'kicker': 'Letters', 'content_kicker': None, 'print_headline': 'Enough Snow?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-01-20T15:54:12+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/7d139e1a-5aa4-5ead-abfe-2e942ed1ea23', 'word_count': 115, 'uri': 'nyt://article/7d139e1a-5aa4-5ead-abfe-2e942ed1ea23'}, {'abstract': 'The action was similar to one issued in September by Hyundai, the parent of Kia, that affected 205,000 Veracruz and Santa Fe crossovers.', 'web_url': 'https://wheels.blogs.nytimes.com/2012/01/20/kia-recalls-146000-optimas-and-rondos-for-drivers-air-bag-flaw/', 'snippet': 'The action was similar to one issued in September by Hyundai, the parent of Kia, that affected 205,000 Veracruz and Santa Fe crossovers.', 'lead_paragraph': 'Kia is recalling about 146,000 vehicles because the driver’s air bag may not deploy in a crash, the automaker told the National Highway Traffic Safety Administration.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Kia Recalls 146,000 Optimas and Rondos for Driver’s Air Bag Flaw', 'kicker': 'Wheels', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Automobile Safety Features and Defects', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Automobiles', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Hyundai Motor Co', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Kia Motors Corp', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'National Highway Traffic Safety Administration', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-01-20T15:56:43+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Automobiles', 'byline': {'original': 'By Christopher Jensen', 'person': [{'firstname': 'Christopher', 'middlename': None, 'lastname': 'Jensen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2aa2ac0e-32a2-5e48-8b45-b1c75a945f76', 'word_count': 231, 'uri': 'nyt://article/2aa2ac0e-32a2-5e48-8b45-b1c75a945f76'}, {'abstract': 'Seeing the world with a child in tow.', 'web_url': 'https://www.nytimes.com/2012/01/22/travel/qa-with-yolanda-edwards-editor-and-blogger.html', 'snippet': 'Seeing the world with a child in tow.', 'lead_paragraph': 'WHEN Yolanda Edwards gave birth to her daughter, Clara, friends said her traveling days were done. Refusing to accept this, she booked a trip to England from New York when Clara was five weeks old, and from then on, they often joined her husband, a photographer, on assignments. “There I was on maternity leave,” she said. “So I thought, why shouldn’t we all be together as much as possible?”', 'print_section': 'TR', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/22/travel/22QNA/22QNA-jumbo.jpg', 'height': 679, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/22/travel/22QNA/22QNA-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/22/travel/22QNA/22QNA-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Q&A With Yolanda Edwards, Editor and Blogger', 'kicker': 'Q&A', 'content_kicker': None, 'print_headline': 'Children Add To the Spirit Of Adventure', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Children and Childhood', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-01-20T15:57:11+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Rachel Lee Harris', 'person': [{'firstname': 'Rachel', 'middlename': 'Lee', 'lastname': 'Harris', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Question', '_id': 'nyt://article/82f17962-5f44-5865-96e1-c6cde97593b9', 'word_count': 636, 'uri': 'nyt://article/82f17962-5f44-5865-96e1-c6cde97593b9'}, {'abstract': 'Newt Gingrich’s unfortunate revival.', 'web_url': 'https://douthat.blogs.nytimes.com/2012/01/20/the-momentum-of-ideas/', 'snippet': 'Newt Gingrich’s unfortunate revival.', 'lead_paragraph': 'During last night’s Republican debate, the candidates were asked to name something from the campaign that they would have done differently. Here was Newt Gingrich’s answer:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Momentum of Ideas', 'kicker': 'Ross Douthat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-01-20T15:59:38+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Ross Douthat', 'person': [{'firstname': 'Ross', 'middlename': None, 'lastname': 'Douthat', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6be6818a-bd72-5cdd-b788-a2937f0fcf66', 'word_count': 632, 'uri': 'nyt://article/6be6818a-bd72-5cdd-b788-a2937f0fcf66'}, {'abstract': 'In Hilma Wolitzer’s novel, a widower struggles with grief and dating.', 'web_url': 'https://www.nytimes.com/2012/01/22/books/review/an-available-man-by-hilma-wolitzer-book-review.html', 'snippet': 'In Hilma Wolitzer’s novel, a widower struggles with grief and dating.', 'lead_paragraph': 'In the opening lines of Hilma Wolitzer’s wonderful new novel, the recently widowed Edward Schuyler stands in his living room, ironing, when the telephone rings. He picks it up to hear the clamorous, intrusive voice of a female suitor, attempting to break in on his grief. But he’d rather iron the blouses of his deceased wife, Bee, “as a way of reconnecting with her when she was so irrevocably gone” than date any of the women now scurrying in his direction. Bee, on her deathbed, had predicted this fate: “Look at you. They’ll be crawling out of the woodwork.”', 'print_section': 'BR', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/22/books/review/Kline/Kline-jumbo.jpg', 'height': 1024, 'width': 828, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/22/books/review/Kline/Kline-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/22/books/review/Kline/Kline-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Widower Hits the Dating Scene', 'kicker': None, 'content_kicker': None, 'print_headline': 'Science Guy, Balding but Handsome', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Wolitzer, Hilma', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-01-20T15:59:42+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Nancy Kline', 'person': [{'firstname': 'Nancy', 'middlename': None, 'lastname': 'Kline', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/97961fbe-113a-5321-850c-f075e44e62c6', 'word_count': 569, 'uri': 'nyt://article/97961fbe-113a-5321-850c-f075e44e62c6'}, {'abstract': 'The rural North Carolina town is drawing visitors with food, art and performance.', 'web_url': 'https://www.nytimes.com/2012/01/22/travel/saxapahaw-nc-middle-of-somewhere-becomes-a-draw.html', 'snippet': 'The rural North Carolina town is drawing visitors with food, art and performance.', 'lead_paragraph': 'I WAS polishing off a steaming bowl of coconut curry soup when a server appeared bearing a plate of plump pan-seared diver scallops atop creamy applewood-bacon succotash and braised asparagus. The food was befitting a candlelit restaurant, but I had a view of gas pumps outside and, a few steps from my table, fluorescent-lighted aisles packed with workaday necessities — toilet paper, motor oil, sauerkraut juice (aids digestion, according to the label).', 'print_section': 'TR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/22/travel/22HEADSUP_SPAN/22HEADSUP_SPAN-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/22/travel/22HEADSUP_SPAN/22HEADSUP_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/22/travel/22HEADSUP_SPAN/22HEADSUP_SPAN-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/22/travel/22HEADSUP_SPAN/22HEADSUP_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/22/travel/22HEADSUP_SPAN/22HEADSUP_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Saxapahaw, N.C., Middle of Somewhere, Becomes a Draw', 'kicker': 'Heads Up', 'content_kicker': None, 'print_headline': 'Middle of Somewhere, N.C.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'North Carolina', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Saxapahaw (NC)', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-20T15:59:59+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Ingrid K. Williams', 'person': [{'firstname': 'Ingrid', 'middlename': 'K.', 'lastname': 'Williams', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4505bfd9-cb30-5ec1-a4bc-2dade26588c4', 'word_count': 596, 'uri': 'nyt://article/4505bfd9-cb30-5ec1-a4bc-2dade26588c4'}, {'abstract': 'Doree Shafrir is being hired to do for the site’s culture coverage what Ben Smith from Politico has done for political coverage.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2012/01/20/buzzfeed-makes-another-splashy-hire-this-one-from-rolling-stone/', 'snippet': 'Doree Shafrir is being hired to do for the site’s culture coverage what Ben Smith from Politico has done for political coverage.', 'lead_paragraph': 'BuzzFeed, the social Web site that made a splash last month by hiring the blogger Ben Smith away from Politico, will signal its expansion plans on Friday by announcing that it has hired Doree Shafrir of Rolling Stone to oversee culture coverage.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'BuzzFeed Makes Another Splashy Hire, This One From Rolling Stone', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Hiring and Promotion', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Social Networking (Internet)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Smith, Ben', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Politico, The', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Rolling Stone', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-01-20T16:00:15+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Brian Stelter', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Stelter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/67a770b0-8403-5470-8969-b24abcc0819f', 'word_count': 274, 'uri': 'nyt://article/67a770b0-8403-5470-8969-b24abcc0819f'}, {'abstract': 'With guidance from Charlotte Brontë, the heroine of Margot Livesey’s novel goes in search of herself.', 'web_url': 'https://www.nytimes.com/2012/01/22/books/review/the-flight-of-gemma-hardy-by-margot-livesey-book-review.html', 'snippet': 'With guidance from Charlotte Brontë, the heroine of Margot Livesey’s novel goes in search of herself.', 'lead_paragraph': 'When Margot Livesey was 9 years old, growing up motherless and lonely in Scotland, a book on her father’s shelf caught her eye: “Jane Eyre.” Livesey’s discovery of Charlotte Brontë’s masterpiece was transformative. The promised friend between the covers, a character whose indomitable spirit has consoled and inspired readers for over a century and a half, allowed \xadLivesey to understand that “life is change.” “Like Jane’s, my life had changed for the worse,” Livesey wrote in an essay a few years ago, “and like hers, it could also change for the better. Time would, irrevocably, carry me to a new place.”', 'print_section': 'BR', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In Jane Eyre’s Footsteps', 'kicker': None, 'content_kicker': None, 'print_headline': 'In Jane Eyre’s Footsteps', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Livesey, Margot', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Bronte, Charlotte', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-20T16:01:16+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Sarah Towers', 'person': [{'firstname': 'Sarah', 'middlename': None, 'lastname': 'Towers', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/6b3e7396-7595-53ac-b6df-d6be43e33359', 'word_count': 697, 'uri': 'nyt://article/6b3e7396-7595-53ac-b6df-d6be43e33359'}, {'abstract': 'This eco-friendly hotel offers a lot for a place in a fair location but has little charm.', 'web_url': 'https://www.nytimes.com/2012/01/22/travel/hotel-review-element-times-square-west-ny.html', 'snippet': 'This eco-friendly hotel offers a lot for a place in a fair location but has little charm.', 'lead_paragraph': 'THE UPSHOT', 'print_section': 'TR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/22/travel/22CHECKIN_SPAN/22CHECKIN_SPAN-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/22/travel/22CHECKIN_SPAN/22CHECKIN_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/22/travel/22CHECKIN_SPAN/22CHECKIN_SPAN-jumbo.jpg', 'height': 759, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/22/travel/22CHECKIN_SPAN/22CHECKIN_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/22/travel/22CHECKIN_SPAN/22CHECKIN_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Hotel Review: Element Times Square West, N.Y.', 'kicker': 'Check In, Check Out', 'content_kicker': None, 'print_headline': 'New York: Element by Westin Times Square West', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Element New York Times Square West', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'HOTELS AND MOTELS', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-01-20T16:03:16+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Fred A. Bernstein', 'person': [{'firstname': 'Fred', 'middlename': 'A.', 'lastname': 'Bernstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/5dddba78-4639-59c6-b925-132dfae66e9e', 'word_count': 566, 'uri': 'nyt://article/5dddba78-4639-59c6-b925-132dfae66e9e'}, {'abstract': 'Hollywood factions have a unifying cause — the threat of copyright infringement — but have not been a major presence in the debate over legislation to combat piracy.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2012/01/20/hollywood-needs-unified-effort-dodd-asserts/', 'snippet': 'Hollywood factions have a unifying cause — the threat of copyright infringement — but have not been a major presence in the debate over legislation to combat piracy.', 'lead_paragraph': 'WASHINGTON — As Hollywood and its indie film counterparts head to Park City, Utah, for the Sundance festival, there’s a question they might kick around in the après ski lounges: Should everyone in a movie business that is clearly grappling with serious issues be doing more to advance their interests in Washington?', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Hollywood Needs Unified Effort, Dodd Asserts', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Dodd, Christopher J', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Motion Picture Assn of America', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-01-20T16:04:19+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Michael Cieply', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Cieply', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/545902cc-bde0-5ed9-bcfb-a33ae14af876', 'word_count': 405, 'uri': 'nyt://article/545902cc-bde0-5ed9-bcfb-a33ae14af876'}, {'abstract': 'Singapore hawker stalls are now accessible in food courts, enabling one-stop eating for popular street food', 'web_url': 'https://www.nytimes.com/2012/01/22/travel/hawker-food-courts-in-singapore.html', 'snippet': 'Singapore hawker stalls are now accessible in food courts, enabling one-stop eating for popular street food', 'lead_paragraph': '“JUST look around,” said Malcolm Lee, a 27-year-old Singaporean chef, as he gestured toward the dozen or so street food stands surrounding our table. “I doubt that one of these hawkers is under the age of 40. When this generation is gone, their recipes will probably go with them. Their children want to be bankers or lawyers. Who wants to slog it out six days a week, morning through night, in a hot, dirty environment?” ', 'print_section': 'TR', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/22/travel/22JOURNEYS1_SPAN/22JOURNEYS1-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/22/travel/22JOURNEYS1_SPAN/22JOURNEYS1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/22/travel/22JOURNEYS1_SPAN/22JOURNEYS1-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 