mbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/22/nyregion/20120122WALLDOGSss-slide-BHKH/20120122WALLDOGSss-slide-BHKH-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/22/nyregion/20120122WALLDOGSss-slide-BHKH/20120122WALLDOGSss-slide-BHKH-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': '‘Wall Dogs’ With Paint', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Paint', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Outdoor Advertising', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-01-21T04:01:54+0000', 'document_type': 'multimedia', 'news_desk': 'New York', 'section_name': 'New York', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/562a16c7-2317-534e-8126-d4d9c9455271', 'word_count': 0, 'uri': 'nyt://slideshow/562a16c7-2317-534e-8126-d4d9c9455271'}, {'abstract': 'Two non-native New Yorkers who work as writers with financial firms enjoyed a night out at a wine bar in a Manhattan neighborhood.', 'web_url': 'https://www.nytimes.com/2012/01/22/nyregion/at-terroir-murray-hill-cozy-plates-in-familiar-company.html', 'snippet': 'Two non-native New Yorkers who work as writers with financial firms enjoyed a night out at a wine bar in a Manhattan neighborhood.', 'lead_paragraph': 'The burgeoning Terroir empire of site-specific wine bars concocted by Paul Grieco and the executive chef Marco Canora has touched down in Murray Hill. The two have become known as providers of cozy, comfy small plates that allow imbibers to go all experimental on beverage selections. The narrow room has de rigueur exposed-brick walls, Parson-style tables and rustic wood shelving meant to suggest a Revolutionary War-era farmhouse atmosphere: to wit, the neighborhood is named for the 29-acre farm belonging to the Murray family that once occupied this section of Manhattan. As a tribute to the late Murray Hill Hotel, Mr. Canora plucked, and tweaked, four “historic” dishes from a menu in the New York Public Library archives: smoked beef tongue pastrami, fried scallops, the ever-hardy French dip and an oyster sandwich.', 'print_section': 'MB', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/22/nyregion/22TABLE_SPAN/22TABLE_SPAN-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/22/nyregion/22TABLE_SPAN/22TABLE_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/22/nyregion/22TABLE_SPAN/22TABLE-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/22/nyregion/22TABLE_SPAN/22TABLE_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/22/nyregion/22TABLE_SPAN/22TABLE_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'On a Cold Night, Good Wine and Cozy Plates', 'kicker': 'At the Table | Terroir Murray Hill', 'content_kicker': None, 'print_headline': 'On a Cold Night, Good Wine and Cozy Plates', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'MURRAY HILL (NYC)', 'rank': 1, 'major': 'N'}, {'name': 'subject'