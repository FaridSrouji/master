e/7fe03708-1427-5a65-9c75-965eab47c0eb'}, {'abstract': 'Ms. Brown, a sharp-witted computer-animated character who will represent the brown M&M’s, will join five other candies in the cast.', 'web_url': 'https://www.nytimes.com/2012/01/17/business/media/mms-to-unveil-a-new-speaking-role-at-super-bowl.html', 'snippet': 'Ms. Brown, a sharp-witted computer-animated character who will represent the brown M&M’s, will join five other candies in the cast.', 'lead_paragraph': 'A POPULAR candy will offer elocution lessons of a sort on Super Bowl Sunday, answering the question “How now, brown?”', 'print_section': 'B', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/17/business/ADCO2/ADCO2-jumbo.jpg', 'height': 963, 'width': 963, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/17/business/ADCO2/ADCO2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/17/business/ADCO2/ADCO2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'M&M’s to Unveil New Speaking Role at Super Bowl', 'kicker': 'Advertising', 'content_kicker': None, 'print_headline': 'M&M’s to Unveil New Speaking Role at Super Bowl', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Mars Inc', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-01-16T21:39:31+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Stuart El