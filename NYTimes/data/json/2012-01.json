nail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/09/business/CES/CES-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/09/business/CES/CES-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Tech Show Loses Clout as Industry Shifts', 'kicker': None, 'content_kicker': None, 'print_headline': 'Tech Show Loses Clout As the Place For Big News', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Electronics', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Conventions, Fairs and Trade Shows', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'International Consumer Electronics Show', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Microsoft Corporation', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-01-08T20:31:09+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'byline': {'original': 'By Nick Wingfield', 'person': [{'firstname': 'Nick', 'middlename': None, 'lastname': 'Wingfield', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/787e9b57-1060-5621-9e07-3c805d7b1f0e', 'word_count': 1166, 'uri': 'nyt://article/787e9b57-1060-5621-9e07-3c805d7b1f0e'}, {'abstract': 'A new rule would require a movie review from The New York Times or The Los Angeles Times to qualify a documentary feature for the Academy Awards, according to a draft of the rule.', 'web_url': 'https://www.nytimes.com/2012/01/09/movies/documentarians-concerned-about-proposed-oscar-rule.html', 'snippet': 'A new rule would require a movie review from The New York Times or The Los Angeles Times to qualify a documentary feature for the Academy Awards, according to a draft of the rule.', 'lead_paragraph': 'LOS ANGELES — In a move to trim the number of documentaries submitted annually for Oscar consideration, the Academy of Motion Picture Arts and Sciences is poised to require a movie review from The New York Times or The Los Angeles Times to qualify a documentary feature for the Academy Awards.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/09/arts/doc-2/doc-2-jumbo.jpg', 'height': 1024, 'width': 838, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/09/arts/doc-2/doc-2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/09/arts/doc-2/doc-2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Oscar Rule Will Cull Nonfiction Contenders', 'kicker': None, 'content_kicker': None, 'print_headline': 'Oscar Rule Will Cull Nonfiction Contenders', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'New York Times', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Academy Awards (Oscars)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Documentary Films and Programs', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Los Angeles Times', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'ACADEMY OF MOTION PICTURE ARTS AND SCIENCES', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-01-08T20:31:34+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Movies', 'byline': {'original': 'By Michael Cieply', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Cieply', 'qualifier': None,