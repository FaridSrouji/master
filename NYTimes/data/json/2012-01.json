6/nyregion/EASTHAVEN/EASTHAVEN-articleLarge.jpg', 'height': 293, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/26/nyregion/EASTHAVEN/EASTHAVEN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 293}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/26/nyregion/EASTHAVEN/EASTHAVEN-jumbo.jpg', 'height': 500, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'After Charges of Latino Abuse, Anger Shifts to a Mayor for His ‘Taco’ Remark', 'kicker': None, 'content_kicker': None, 'print_headline': 'After Charges of Latino Abuse, Anger Shifts to a Mayor for His ‘Taco’ Remark', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Gallo, Leonard', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Hispanic-Americans', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Police Brutality and Misconduct', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Maturo, Joseph A Jr', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Racial Profiling', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'East Haven (Conn)', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-01-26T02:11:16+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Peter Applebome', 'person': [{'firstname': 'Peter', 'middlename': None, 'lastname': 'Applebome', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f63a47dd-e611-5e06-b973-571bd11b87d8', 'word_count': 900, 'uri': 'nyt://article/f63a47dd-e611-5e06-b973-571bd11b87d8'}, {'abstract': 'Despite a rash of recent injuries to some of their top rivals, the freestyle snowmobiling competitors gathered in Aspen, Colo., still plan to try their riskiest stunts.', 'web_url': 'https://www.nytimes.com/2012/01/26/sports/x-games-snowmobilers-shrug-off-injury-risks.html', 'snippet': 'Despite a rash of recent injuries to some of their top rivals, the freestyle snowmobiling competitors gathered in Aspen, Colo., still plan to try their riskiest stunts.', 'lead_paragraph': 'ASPEN, Colo. — A bruised hip, a broken femur and a double dislocation of the shoulders — count these injuries among the recent setbacks of freestyle snowmobile riders competing in the Winter X Games, starting here Thursday. Absent from the lineup are two former gold-medal-winning riders who crashed more recently this month. One sustained multiple vertebrae fractures of the neck two days after another’s shin bone crumpled in the same practice pit in Minnesota.', 'print_section': 'B', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/26/sports/snowmobile/snowmobile-jumbo.jpg', 'height': 828, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/26/sports/snowmobile/snowmobile-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/26/sports/snowmobile/snowmobile-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'X Games Snowmobilers Shrug Off Injury Concerns', 'kicker': None, 'content_kicker': None, 'print_headline': 'X Games Snowmobilers Shrug Off Injury Concerns', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Sports Injuries', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'X Games', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Snowmobiles', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-26T02:11:30+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name':