d4-580a74b77ba6', 'word_count': 569, 'uri': 'nyt://article/603cc7c3-2010-5f52-b4d4-580a74b77ba6'}, {'abstract': 'An unfamiliar name with a very familiar voice heard on corporate greetings like the tinkling “AT&T.”', 'web_url': 'https://www.nytimes.com/2012/01/08/opinion/sunday/catching-up-with-patricia-fleet.html', 'snippet': 'An unfamiliar name with a very familiar voice heard on corporate greetings like the tinkling “AT&T.”', 'lead_paragraph': 'Patricia Fleet’s voice is familiar to almost everyone, even if her name doesn’t ring a bell. Countless corporations, including several telecommunications companies, use her for their recorded messages, greetings and voicemail prompts. She is probably best known as the registered trademark voice intoning “AT&T” before callers receive an announcement or are connected to customer support.', 'print_section': 'SR', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/08/sunday-review/08DOWNLOAD/08DOWNLOAD-jumbo.jpg', 'height': 812, 'width': 379, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/08/sunday-review/08DOWNLOAD/08DOWNLOAD-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/08/sunday-review/08DOWNLOAD/08DOWNLOAD-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Patricia Fleet', 'kicker': 'Download', 'content_kicker': None, 'print_headline': 'Patricia Fleet', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Telephones and Telecommunications', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'AT&T Inc', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-01-07T22:14:46+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Kate Murphy', 'person': [{'firstname': 'Kate', 'middlename': None, 'lastname': 'Murphy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/45a0b284-ecc8-5f9f-8a46-3dfb3f0c76ff', 'word_count': 428, 'uri': 'nyt://article/45a0b284-ecc8-5f9f-8a46-3dfb3f0c76ff'}, {'abstract': 'An important new study based on capital cases in Connecticut provides powerful evidence that death sentences are haphazardly meted out.', 'web_url': 'https://www.nytimes.com/2012/01/08/opinion/sunday/the-random-horror-of-the-death-penalty.html', 'snippet': 'An important new study based on capital cases in Connecticut provides powerful evidence that death sentences are haphazardly meted out.', 'lead_paragraph': 'The Supreme Court has not banned capital punishment, as it should, but it has long held that the death penalty is unconstitutional if randomly imposed on a handful of people. An important new study based on capital cases in Connecticut provides powerful evidence that death sentences are haphazardly meted out, with virtually no connection to the heinousness of the crime.', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Random Horror of the Death Penalty', 'kicker': 'Editorial | In Evidence', 'content_kicker': None, 'print_headline': 'The Random Horror Of the Death Penalty', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Editorials', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Connecticut', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Donohue, John', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Supreme Court', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Capital Punishment', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Sentenc