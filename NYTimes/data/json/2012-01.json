 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Papademos, Lucas', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'European Sovereign Debt Crisis (2010- )', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'European Union', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Greece', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'International Monetary Fund', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'European Commission', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-01-29T18:46:21+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Global Business', 'byline': {'original': 'By Niki Kitsantonis', 'person': [{'firstname': 'Niki', 'middlename': None, 'lastname': 'Kitsantonis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1b158a69-8a9d-51d2-b14f-4bf73baba5f6', 'word_count': 528, 'uri': 'nyt://article/1b158a69-8a9d-51d2-b14f-4bf73baba5f6'}, {'abstract': 'An “Occu-Party” at an unoccupied residential building in Williamsburg, Brooklyn, ended with four arrests on Saturday night.', 'web_url': 'https://cityroom.blogs.nytimes.com/2012/01/29/an-occu-party-in-brooklyn-leads-to-4-arrests/', 'snippet': 'An “Occu-Party” at an unoccupied residential building in Williamsburg, Brooklyn, ended with four arrests on Saturday night.', 'lead_paragraph': 'Six officers were injured in Williamsburg, Brooklyn, when the police broke up a party in a vacant residential building thrown by members of the Occupy movement on Saturday night, the police said. Four protesters were arrested, including a 21-year-old woman who was charged with assaulting a police officer.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'An ‘Occu-Party’ in Brooklyn Leads to 4 Arrests', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-01-29T19:00:00+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Sarah Maslin Nir', 'person': [{'firstname': 'Sarah', 'middlename': 'Maslin', 'lastname': 'Nir', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/55463994-48e1-5ee3-92b4-7cb9a19ae11a', 'word_count': 315, 'uri': 'nyt://article/55463994-48e1-5ee3-92b4-7cb9a19ae11a'}, {'abstract': 'Mr. Romney says Mr. Gingrich has only himself to blame if he does not win Florida.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2012/01/29/romney-says-gingrich-is-making-excuses-for-his-florida-woes/', 'snippet': 'Mr. Romney says Mr. Gingrich has only himself to blame if he does not win Florida.', 'lead_paragraph': 'NAPLES, Fla. — As Mitt Romney‘s surrogates tried to draw subtle contrasts between their candidate and Newt Gingrich at an outdoor rally here on Sunday morning, Mr. Romney took the argument straight to Mr. Gingrich. He used the first several minutes of his stump speech to criticize the former speaker of the House, to whom he would like to deliver a major blow in the state’s primary on Tuesday.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Romney Says Gingrich Is Making ‘Excuses’ for His Florida Woes', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Gingrich, Newt', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Florida', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-01-29T19:17:37+