— would topple upon their heads.', 'print_section': 'D', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/02/sports/giants1/giants1-articleLarge.jpg', 'height': 403, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/02/sports/giants1/giants1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 403}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/02/sports/giants1/giants1-jumbo.jpg', 'height': 743, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/02/sports/giants1/giants1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/02/sports/giants1/giants1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Giants Rout the Cowboys and Win the N.F.C. East', 'kicker': 'Giants 31, Cowboys 14', 'content_kicker': None, 'print_headline': 'Stumbling, Rumbling: Giants Rout the Cowboys And Win the N.F.C. East', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Manning, Eli', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Dallas Cowboys', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Coughlin, Tom', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Giants', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Pierre-Paul, Jason', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Cruz, Victor', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Romo, Tony', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Playoff Games', 'rank': 9, 'maj