umbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/11/blogs/bitpix-servers4/bitpix-servers4-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/11/blogs/bitpix-servers4/bitpix-servers4-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'The Bright Spot in Tech I.P.O.’s: Enterprise', 'kicker': 'Bits', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cloud Computing', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Enterprise Computing', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Initial Public Offerings', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Box.net', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Jive Software', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'RESPONSYS INC', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-01-10T16:01:00+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By Quentin Hardy', 'person': [{'firstname': 'Quentin', 'middlename': None, 'lastname': 'Hardy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/041406c2-17c9-56d8-926a-926ffba7c383', 'word_count': 701, 'uri': 'nyt://article/041406c2-17c9-56d8-926a-926ffba7c383'}, {'abstract': 'The mood at the birthday party for John C. Liu, the city comptroller, which also served as a fund-raiser, was cheery despite the shadow of a widening federal investigation into Mr. Liu’s campaign finance operation.', 'web_url': 'https://cityroom.blogs.nytimes.com/2012/01/10/amid-inquiry-liu-marks-his-birthday-with-a-fund-raiser/', 'snippet': 'The mood at the birthday party for John C. Liu, the city comptroller, which also served as a fund-raiser, was cheery despite the shadow of a widening federal investigation into Mr. Liu’s campaign finance operation.', 'lead_paragraph': 'As birthday parties go, turning 45 usually doesn’t mean a lot. But it sure did for John C. Liu, the city comptroller.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Amid Inquiry, Liu Marks His Birthday With a Fund-Raiser', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Campaign Finance', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Liu, John C', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Office of the Comptroller (NYC)', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-10T16:02:02+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Daniel E. Slotnik and David W. Chen', 'person': [{'firstname': 'Daniel', 'middlename': 'E.', 'lastname': 'Slotnik', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'David', 'middlename': 'W.', 'lastname': 'Chen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c81a5b85-5b2c-51f6-b804-e65b1d1cd74f', 'word_count': 439, 'uri': 'nyt://article/c81a5b85-5b2c-51f6-b804-e65b1d1cd74f'}, {'abstract': 'An interview with Rachel Chavkin about “Mission Drift,” the latest work from the New York-based theater company the TEAM.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/01/10/coil-festival-5-questions-about-mission-drift/', 'snippet': 'An interview with Rachel Chavkin about “Mission Drift,” the latest work from the New York-based theater company the TEAM.', 'lead_paragraph': 'Rock music, Dutch teenagers, global financial turmoil, the best and worst of Las Vegas: all of it takes the stage in “Mission Drift,” by the New York-based theater company the TEAM (Theater of the Emerging American Moment). The piece comes to New York as part of this year’s Coil Festival after winning several awards at last year’s Edinburgh Festival Fringe. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Coil Festival: 5 Questions About ‘Mission Drift’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Coil Festival', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Theater of the Emerging American Moment', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-01-10T16:10:25+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Erik Piepenburg', 'person': [{'firstname': 'Erik', 'middlename': None, 'lastname': 'Piepenburg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/896e1756-3e43-5f5c-8860-0feccd3a2be5', 'word_count': 767, 'uri': 'nyt://article/896e1756-3e43-5f5c-8860-0feccd3a2be5'}, {'abstract': 'The “King of Bain” attack ad will hurt Romney, and help the left.', 'web_url': 'https://takingnote.blogs.nytimes.com/2012/01/10/this-is-citizens-united/', 'snippet': 'The “King of Bain” attack ad will hurt Romney, and help the left.', 'lead_paragraph': 'MANCHESTER, N.H. — From December 1 until the Iowa caucuses on January 3, 45 percent of all ads airing in Iowa were directed against Newt Gingrich, who promptly lost his frontrunner status and came in fourth. Financing for these ads came from Ron Paul, Rick Perry and Restore Our Future, a Super PAC that backs Mitt Romney.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'This Is Citizens United', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Political Advertising', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Adelson, Sheldon G', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Gingrich, Newt', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Citizens United', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Restore Our Future', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-01-10T16:12:55+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Andrew Rosenthal', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Rosenthal', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/74935dbe-eb95-5188-8579-1111d041fb66', 'word_count': 308, 'uri': 'nyt://article/74935dbe-eb95-5188-8579-1111d041fb66'}, {'abstract': 'Soft round shapes and dusty colors star in Clare Waight Keller’s second collection for Chloé.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2012/01/10/just-one-look-chloe/', 'snippet': 'Soft round shapes and dusty colors star in Clare Waight Keller’s second collection for Chloé.', 'lead_paragraph': 'Soft round shapes, softer tie-neck blouses and clean, pleated dresses in even softer dusty colors star in Clare Waight Keller’s second collection for Chloé. Paired with all of these pretty, work-ready clothes are accessories that look just as beautiful and uncomplicated, like glossy slip-in ankle boots and slipper-front pumps — and there’s a new bag, Lucy, a slim three-pocket with zipper closures that comes in multiple colorways and fabrics, with leather handles or a chain strap. The check version of the bag is shown here with cropped pants, a brushed wool plaid coat and this editor’s favorite new flat: an emerald green loafer embellished with metal-tipped fringe.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Just One Look | Chloé', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Chloe', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-01-10T16:15:14+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Jane Herman', 'person': [{'firstname': 'Jane', 'middlename': None, 'lastname': 'Herman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1f4ebe06-06d6-50f0-b9df-aa540c66955c', 'word_count': 107, 'uri': 'nyt://article/1f4ebe06-06d6-50f0-b9df-aa540c66955c'}, {'abstract': 'The midsize plug-in sedan concept is intended to create emotional connections between consumers and a brand primarily known for reliability and practicality.', 'web_url': 'https://wheels.blogs.nytimes.com/2012/01/10/toyota-grasps-for-heartstrings-with-ns4-concept/', 'snippet': 'The midsize plug-in sedan concept is intended to create emotional connections between consumers and a brand primarily known for reliability and practicality.', 'lead_paragraph': 'Introduced on Tuesday, Jan. 10: Toyota NS4 concept.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Toyota Grasps for Heartstrings With NS4 Concept', 'kicker': 'Wheels', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Automobiles', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Electric and Hybrid Vehicles', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'North American International Auto Show', 'rank':