ank': 5, 'major': 'N'}], 'pub_date': '2012-01-02T19:26:47+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Andrew C. Revkin', 'person': [{'firstname': 'Andrew', 'middlename': 'C.', 'lastname': 'Revkin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/97296a4f-4333-59af-b531-9319845b318f', 'word_count': 742, 'uri': 'nyt://article/97296a4f-4333-59af-b531-9319845b318f'}, {'abstract': 'A University of Washington professor delves into the fate of a Near Eastern vegetable seller named Babylas.', 'web_url': 'https://www.nytimes.com/2012/01/03/science/reaching-back-2000-years-to-unravel-a-curse.html', 'snippet': 'A University of Washington professor delves into the fate of a Near Eastern vegetable seller named Babylas.', 'lead_paragraph': 'A vegetable seller named Babylas was the target of an alarming curse nearly 2,000 years ago. Written on a lead tablet found in Antioch, one of the largest cities in the Roman Empire, the curse calls on the gods to tie up the hapless greengrocer, then “drown and chill” his soul. ', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/03/science/03OBCURSE1/03OBCURSE1-jumbo.jpg', 'height': 1024, 'width': 571, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/03/science/03OBCURSE1/03OBCURSE1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/03/science/03OBCURSE1/03OBCURSE1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Reaching Back 2,000 Years to Unravel a Curse', 'kicker': 'Observatory', 'con