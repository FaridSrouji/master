 'lead_paragraph': 'THE lives of Li Hangbin and Li Ying were intertwined nearly from the start.', 'print_section': 'MB', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/15/nyregion/15BABY_SPAN/15BABY1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/15/nyregion/15BABY_SPAN/15BABY1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/15/nyregion/15BABY_SPAN/15BABY1-jumbo.jpg', 'height': 696, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/15/nyregion/15BABY_SPAN/15BABY1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/15/nyregion/15BABY_SPAN/15BABY1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'What Happened to Baby Annie?', 'kicker': None, 'content_kicker': None, 'print_headline': 'What Happened to Baby Annie?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Rikers Island Prison Complex', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Crime and Criminals', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Li Hangbin', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Flushing (NYC)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Li, Annie', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Child Abuse and Neglect', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 8, 'major'