it': None, 'type': 'image', 'url': 'images/2012/01/18/opinion/video-opdoc-weiwei/video-opdoc-weiwei-jumbo-v2.jpg', 'height': 503, 'width': 765, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/18/opinion/video-opdoc-weiwei/video-opdoc-weiwei-superJumbo-v2.jpg', 'height': 503, 'width': 765, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/18/opinion/video-opdoc-weiwei/video-opdoc-weiwei-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/18/opinion/video-opdoc-weiwei/video-opdoc-weiwei-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/18/opinion/video-opdoc-weiwei/video-opdoc-weiwei-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Ai Weiwei: Evolution of a Dissident', 'kicker': 'OPINION', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Ai Weiwei', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-23T02:16:39+0000', 'document_type': 'multimedia', 'news_desk': 'Opinion', 'section_name': 'Opinion', 'byline': {'original': 'Alison Klayman', 'person': [{'firstname': 'Alison', 'middlename': None, 'lastname': 'Klayman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/32e7f21f-d874-5d00-9011-3cd1f0470efb', 'word_count': 0, 'uri': 'nyt://video/32e7f21f-d874-5d00-9011-3cd1f0470efb'}, {'abstract': 'The filmmaker Alison Klayman presents an exclusive look at the Chinese dissident artist Ai Weiwei and his struggle for freedom of expression.', 'web_url': 'https://www.nytimes.com/2012/01/23/opinion/ai-weiwei-the-evolution-of-a-dissident.html', 'snippet': 'The filmmaker Alison Klayman presents an exclusive look at the Chinese dissident artist Ai Weiwei and his struggle for freedom of expression.', 'lead_paragraph': 'I have always believed that the story of the dissident artist Ai Weiwei is not about how censorship stifles creativity, but rather how one artist is able to work around such obstacles.\xa0 It’s not about the system crushing individual expression, but about the power of an individual in the face of forces greater than himself. One thing is clear — Ai Weiwei’s story could not be possible without the Internet. We cannot imagine an Ai Weiwei without the megaphone of blogs and Twitter, without the ability to communicate instantaneously and connect to like-minded netizens around China and the globe.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/18/opinion/video-opdoc-weiwei/video-opdoc-weiwei-articleLarge-v4.jpg', 'height': 395, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/18/opinion/video-opdoc-weiwei/video-opdoc-weiwei-articleLarge-v4.jpg', 'xlargewidth': 600, 'xlargeheight': 395}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/18/opinion/video-opdoc-weiwei/video-opdoc-weiwei-jumbo-v2.jpg', 'height': 503, 'width': 765, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/18/opinion/video-opdoc-weiwei/video-opdoc-weiwei-superJumbo-v2.jpg', 'height': 503, 'width': 765, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/18/opinion/video-opdoc-weiwei/video-opdoc-weiwei-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/18/opinion/video-opdoc-weiwei/video-opdoc-weiwei-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/18/opinion/video-opdoc-weiwei/video-opdoc-weiwei-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Ai Weiwei: The Evolution of a Dissident', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'China', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Ai Weiwei', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Documentary Films and Programs', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-01-23T02:21:20+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Alison Klayman', 'person': [{'firstname': 'Alison', 'middlename': None, 'lastname': 'Klayman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/351632b5-c84b-5793-a286-112beed3b598', 'word_count': 293, 'uri': 'nyt://article/351632b5-c84b-5793-a286-112beed3b598'}, {'abstract': 'Jim Balsillie and Mike Lazaridis are stepping down at a time when investors wonder whether RIM has the ability to compete in the rapidly changing markets for smartphones.', 'web_url': 'https://www.nytimes.com/2012/01/23/technology/rims-jim-balsillie-and-mike-lazaridis-step-aside.html', 'snippet': 'Jim Balsillie and Mike Lazaridis are stepping down at a time when investors wonder whether RIM has the ability to compete in the rapidly changing markets for smartphones.', 'lead_paragraph': 'OTTAWA — Jim Balsillie and Mike Lazaridis, who made the BlackBerry a leading business tool but then presided over its precipitous decline, said they would step down on Monday as co-chairmen and co-chief executives of Research in Motion.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/23/business/RIMM/RIMM-jumbo.jpg', 'height': 686, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/23/business/RIMM/RIMM-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/23/business/RIMM/RIMM-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Bowing to Critics and Market Forces, RIM’s Co-Chiefs Step Aside', 'kicker': None, 'content_kicker': None, 'print_headline': 'Bowing to Critics and Market Forces, RIM’s Co-Chiefs Step Aside', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'E-Mail', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Appointments and Executive Changes', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'BlackBerry (Handheld Device)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'iPhone', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Android (Operating System)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Tablet Computers', 'rank': 6, 'major': 'N'}