cker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Milan Fashion Week', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Calvin Klein Inc', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Milan (Italy)', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-01-16T22:18:01+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Sonny Vandevelde', 'person': [{'firstname': 'Sonny', 'middlename': None, 'lastname': 'Vandevelde', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/da231c2e-1d0f-58b3-8b35-8a9a0cfd6fc7', 'word_count': 34, 'uri': 'nyt://article/da231c2e-1d0f-58b3-8b35-8a9a0cfd6fc7'}, {'abstract': 'The Golden Globes tops the Super Bowl for most Tweets per second, but the VMA’s outrank them both.', 'web_url': 'https://carpetbagger.blogs.nytimes.com/2012/01/16/going-by-twitter-globes-were-a-big-hit/', 'snippet': 'The Golden Globes tops the Super Bowl for most Tweets per second, but the VMA’s outrank them both.', 'lead_paragraph': 'The ratings for the Globes may have dipped slightly, but it was a robust presence on Twitter, where the Tweets-per-second (TPS) count reached 6,162 at its highest point, more than last year’s Super Bowl (4,064 TPS) or the royal wedding (3,966), though still less than the MTV Video Music Awards (8,868 TPS, which had the advantage of the Beyonce bump).', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Going by Twitter,  Globes Were a Big Hit', 'kicker': 'Carpetbagger', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Berri, Claude', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bird, Brad', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Clooney, George', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'DeGeneres, Ellen', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Deschanel, Zooey', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Fey, Tina', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Freeman, Morgan', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Hilton, Perez', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Jolie, Angelina', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Novak, Kim', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': "O'Brien, Conan", 'rank': 11, 'major': 'N'}, {'name': 'persons', 'value': 'Oswalt, Patton', 'rank': 12, 'major': 'N'}, {'name': 'persons', 'value': 'Pitt, Brad', 'rank': 13, 'major': 'N'}, {'name': 'persons', 'value': 'Poehler, Amy', 'rank': 14, 'major': 'N'}, {'name': 'persons', 'value': 'Scorsese, Martin', 'rank': 15, 'major': 'N'}, {'name': 'persons', 'value': 'Vergara, Sofia', 'rank': 16, 'major': 'N'}, {'name': 'persons', 'value': 'WILLIAMS, MICHELLE', 'rank': 17, 'major': 'N'}, {'name': 'persons', 'value': 'Witherspoon, Reese', 'rank': 18, 'major': 'N'}], 'pub_date': '2012-01-16T22:23:30+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Melena Ryzik', 'person': [{'firstname': 'Melena', 'middlename': None, 'lastname': 'Ryzik', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/885aed22-8a5e-52fc-b7ee-acc90ff45631', 'word_count': 364, 'uri': 'nyt://article/885aed22-8a5e-52fc-b7ee-acc90ff45631'}, {'abstract': 'The Spanish ensemble Cuarteto Quiroga performed at the Frick Collection with works by Arriaga, Webern and Beethoven.', 'web_url': 'https://www.nytimes.com/2012/01/17/arts/music/cuarteto-quiroga-at-the-frick-collection-review.html', 'snippet': 'The Spanish ensemble Cuarteto Quiroga performed at the Frick Collection with works by Arriaga, Webern and Beethoven.', 'lead_paragraph': 'The early-20th-century Spanish violinist Manuel Quiroga is not as well known internationally as his compatriots Sarasate and Casals, but he is an esteemed figure in Spain. The Cuarteto Quiroga, a youthful ensemble founded in Madrid in 2004, is keeping his name alive and creating curiosity about him among listeners outside Spain, and is doing him proud. Its program, in the intimate concert room at the Frick Collection on Sunday afternoon, was exquisite: precise, perfectly balanced, interpretively fresh performances, couched in consistently warm hues. ', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/17/arts/frick/frick-articleLarge.jpg', 'height': 258, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/17/arts/frick/frick-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 258}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/17/arts/frick/frick-jumbo.jpg', 'height': 440, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Lush and Sweet Sounds, by Way of a Youthful Ensemble', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Lush and Sweet Sounds, by Way of a Youthful Ensemble', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Frick Collection', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Webern, Anton', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-01-16T22:28:30+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Allan Kozinn', 'person': [{'firstname': 'Allan', 'middlename': None, 'lastname': 'Kozinn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/4f3b06c4-e3ce-535e-8f78-52e7768c95d9', 'word_count': 426, 'uri': 'nyt://article/4f3b06c4-e3ce-535e-8f78-52e7768c95d9'}, {'abstract': 'Jay Scheib’s “World of Wires,” at the Kitchen, is part of a performance trilogy about the mind-scrambling overlap of natural and technology-generated worlds.', 'web_url': 'https://www.nytimes.com/2012/01/17/theater/reviews/world-of-wires-at-the-kitchen-review.html', 'snippet': 'Jay Scheib’s “World of Wires,” at the Kitchen, is part of a performance trilogy about the mind-scrambling overlap of natural and technology-generated worlds.', 'lead_paragraph': 'All sorts of walls come tumbling down in “World of Wires,” Jay Scheib’s slap-happy, mixed-media murder mystery at the Kitchen. Divisions between reality (that old chimera) and perception — not to mention the borders that separate screen from stage and human from machine — are stomped upon with the glee of a precocious, permanently stoned, science-fiction-reading 14-year-old who has just discovered, like, philosophy, dude.', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/17/arts/wires/wires-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/17/arts/wires/wires-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/17/arts/wires/wires-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Worlds Within Worlds Within Worlds. And a Duane Reade.', 'kicker': "Theater Review | ‘World of Wires'", 'content_kicker': None, 'print_headline': 'Worlds Within Worlds Within Worlds. And a Duane Reade.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Scheib, Jay', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-01-16T22:46:38+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Theater', 'subsection_name': 'Theater Reviews', 'byline': {'original': 'By Ben Brantley', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Brantley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/70630d08-7160-5dd1-b449-37eacc2606ea', 'word_count': 954, 'uri': 'nyt://article/70630d08-7160-5dd1-b449-37eacc2606ea'}, {'abstract': 'New albums from Kathleen Edwards, Ladysmith Black Mambazo and Cate Le Bon.', 'web_url': 'https://www.nytimes.com/2012/01/17/arts/music/kathleen-edwards-ladysmith-black-mambazo-cate-le-bon-cds.html', 'snippet': 'New albums from Kathleen Edwards, Ladysmith Black Mambazo and Cate Le Bon.', 'lead_paragraph': 'KATHLEEN EDWARDS', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/17/arts/new-music-4/new-music-4-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/17/arts/new-music-4/new-music-4-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/17/arts/new-music-4/new-music-4-jumbo.jpg', 'height': 628, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thum