major': 'N'}, {'name': 'persons', 'value': 'Krueger, Alan B', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-12T21:49:28+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By John H. Cushman Jr', 'person': [{'firstname': 'John', 'middlename': 'H.', 'lastname': 'Cushman', 'qualifier': 'Jr', 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a16b63bb-6ba1-54e9-aa47-6dc00fea74f1', 'word_count': 553, 'uri': 'nyt://article/a16b63bb-6ba1-54e9-aa47-6dc00fea74f1'}, {'abstract': 'Robert F. Doares Jr. and Barbara Myers Wood find surprises on their quest for Haviland ceramics; buildings by Robert R. Taylor, the first professionally educated African-American architect, are given an in-depth look.', 'web_url': 'https://www.nytimes.com/2012/01/13/arts/design/works-by-haviland-ceramics-and-robert-r-taylor.html', 'snippet': 'Robert F. Doares Jr. and Barbara Myers Wood find surprises on their quest for Haviland ceramics; buildings by Robert R. Taylor, the first professionally educated African-American architect, are given an in-depth look.', 'lead_paragraph': 'WILLIAMSBURG, Va. — Robert F. Doares Jr. and Barbara Myers Wood have no doctorates or institutional backing, just time on their hands for freelance ceramics scholarship. A married couple, they have shown up unannounced at the offices of venerable manufacturers, asking to rifle archives, and have then made major discoveries.', 'print_section': 'C', 'print_page': '31', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/13/arts/13ANTIQUES-1/13ANTIQUES-1-jumbo.jpg', 'height': 933, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/0