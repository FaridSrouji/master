ld/18korea1_span/18korea1_span-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/18/world/18korea1_span/18korea1_span-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/18/world/18korea1_span/18korea1_span-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/18/world/18korea1_span/18korea1_span-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/18/world/18korea1_span/18korea1_span-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'U.S. Presses South Korea to Reduce Oil Imports from Iran', 'kicker': None, 'content_kicker': None, 'print_headline': 'U.S. Presses South Korea to Reduce Oil Imports from Iran', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States International Relations', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Oil (Petroleum) and Gasoline', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Nuclear Weapons', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'State Department', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Iran', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'South Korea', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-01-17T08:41:37+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Choe Sang-Hun', 'person': [{'firstname': 'Choe', 'middlename': None, 'lastname': 'Sang-Hun', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5836da20-79bc-549f-be72-09bed1205549', 'word_count': 470, 'uri': 'nyt://article/5836da20-79bc-549f-be72-09bed1205549'}, {'abstract': 'Rescuers pulled five more bodies from the Costa Concordia as the Italian news media published transcripts of a tense screaming match between the coast guard and the captain.', 'web_url': 'https://www.nytimes.com/2012/01/18/world/europe/rescuers-search-for-survivors-in-italian-cruise-ship-accident.html', 'snippet': 'Rescuers pulled five more bodies from the Costa Concordia as the Italian news media published transcripts of a tense screaming match between the coast guard and the captain.', 'lead_paragraph': 'GIGLIO, Italy — Rescuers pulled five bodies clad in sodden life vests from the partly sunken cruise liner Costa Concordia on Tuesday, bringing the death toll in the disaster to at least 11, as the Italian news media published transcripts of a tense screaming match between the coast guard and the captain, who fled to a lifeboat after he smashed the ship on a reef.', 'print_section': 'A', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/18/world/ITALY/ITALY-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/18/world/ITALY/ITALY-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/18/world/ITALY/ITALY-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/18/world/ITALY/ITALY-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thu