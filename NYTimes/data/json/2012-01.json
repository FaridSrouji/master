olitics/video-caucus-010412-iowawrap/video-caucus-010412-iowawrap-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/04/us/politics/video-caucus-010412-iowawrap/video-caucus-010412-iowawrap-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'The Caucus | On to New Hampshire', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Iowa', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-01-04T09:53:42+0000', 'document_type': 'multimedia', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'Ben Werschkul', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Werschkul', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/1ec8d4c9-36a6-5227-be51-b8c9e8612e49', 'word_count': 0, 'uri': 'nyt://video/1ec8d4c9-36a6-5227-be51-b8c9e8612e49'}, {'abstract': 'The artist Pavel Maria Smejkal has reimagined a number of iconic photographs, encouraging a reconsideration of the role of the photographer.', 'web_url': 'https://lens.blogs.nytimes.com/2012/01/04/iconic-scenes-revisited-and-reimagined/', 'snippet': 'The artist Pavel Maria Smejkal has reimagined a number of iconic photographs, encouraging a reconsideration of the role of the photographer.', 'lead_paragraph': 'An empty road during the Vietnam War. A hilltop landscape in Spain. A nondescript motel balcony in Memphis.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Iconic Scenes, Revisited and Reimagined', 'kicker': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-01-04T10:00:08+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By James Estrin', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': 'Estrin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d4eb7cee-3f12-5ac4-b623-a4db477e05a8', 'word_count': 564, 'uri': 'nyt://article/d4eb7cee-3f12-5ac4-b623-a4db477e05a8'}, {'abstract': 'Forget austerity, sovereign debt and the euro. Europe has a much deeper problem, and it has been going on for decades.', 'web_url': 'https://www.nytimes.com/2012/01/08/magazine/the-other-reason-europe-is-going-broke.html', 'snippet': 'Forget austerity, sovereign debt and the euro. Europe has a much deeper problem, and it has been going on for decades.', 'lead_paragraph': 'One great way to start a bar fight during an American Economic Association conference is to claim that the U.S. economy is preferable to Europe’s. Someone will undoubtedly start quarreling about how G.D.P. per capita doesn’t measure a person’s happiness. Someone else may point out that if you look at income inequality and entitlements, the average European is doing much better.', 'print_section': 'MM', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/08/magazine/08economy_span/08economy_span-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/08/magazine/08economy_span/08economy_span-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/08/magazine/08economy_span/08economy_span-jumbo.jpg', 'height': 699, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/08/magazine/08economy_span/08economy_span-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/08/magazine/08economy_span/08economy_span-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'The Other Reason Europe Is Going Broke', 'kicker': 'It’s the Economy', 'content_kicker': None, 'print_headline': 'The Crisis You Don’t Know', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Gross Domestic Product', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'International Trade and World Market', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Economic Conditions and Trends', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Unemployment', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'European Sovereign Debt Crisis (2010- )', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Europe', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-01-04T10:00:09+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Adam Davidson', 'person': [{'firstname': 'Adam', 'middlename': None, 'lastname': 'Davidson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9c5b122e-c164-54ef-a62b-0197cac67e29', 'word_count': 1102, 'uri': 'nyt://article/9c5b122e-c164-54ef-a62b-0197cac67e29'}, {'abstract': 'Who is imitating whom?', 'web_url': 'https://www.nytimes.com/2012/01/08/magazine/electoral-politics-and-reality-tv.html', 'snippet': 'Who is imitating whom?', 'lead_paragraph': 'Every election season, it starts earlier: a chorus of complaints about the election season having started earlier. The twist in the current version of the quadrennial exercise is the persistent meme that the Republican nomination process is mimicking the tropes of reality television. A notable guest on “The Tonight Show” alluded to this not long ago when asked about the primary drama: “I’m going to wait until everybody is voted off the island,” President Barack Obama demurred. “Once they narrow it down to one or two, I’ll start paying attention.”', 'print_section': 'MM', 'print_page': '42', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/08/magazine/08riff2/08riff2-jumbo-v2.jpg', 'height': 684, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/08/magazine/08riff2/08riff2-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/08/magazine/08riff2/08riff2-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Electoral Politics and Reality TV', 'kicker': 'Riff', 'content_kicker': None, 'print_headline': '‘The Best Thing Happening in Pop Culture Right Now’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Reality Television', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-01-04T10:00:22+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Rob Walker', 'person': [{'firstname': 'Rob', 'middlename': None, 'lastname': 'Walker', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8ebfc927-f228-59e0-b291-091c83f431c9', 'word_count': 1902, 'uri': 'nyt://article/8ebfc927-f228-59e0-b291-091c83f431c9'}, {'abstract': 'Staff of 80, cast of one.', 'web_url': 'https://www.nytimes.com/slideshow/2012/01/08/magazine/20120108-colbert.html', 'snippet': 'Staff of 80, cast of one.', 'lead_paragraph': 'Staff of 80, cast of one.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/08/magazine/20120108-slide-1PTP/20120108-slide-1PTP-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/08/magazine/20120108-slide-1PTP/20120108-slide-1PTP-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/08/magazine/20120108-slide-1PTP/20120108-slide-1PTP-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Day With Stephen Colbert', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Colbert, Stephen', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'Colbert Report, The (TV Program)', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-04T10:00:37+0000', 'document_type': 'multimedia', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/3c8a5bb6-3af2-5ccc-9f3e-6033f2f49e9a', 'word_count': 0, 'uri': 'nyt://slideshow/3c8a5bb6-3af2-5ccc-9f3e-6033f2f49e9a'}, {'abstract': 'A suburban dad. A fictional television blowhard. And now a political money launderer. How one funny guy became three.', 'web_url': 'https://www.nytimes.com/2012/01/08/magazine/stephen-colbert.html', 'snippet': 'A suburban dad. A fictional television blowhard. And now a political money launderer. How one funny guy became three.', 'lead_paragraph': 'There used to be just two Stephen Colberts, and they were hard enough to distinguish. The main difference was that one thought the other was an idiot. The idiot Colbert was the one who made a nice paycheck by appearing four times a week on “The Colbert Report” (pronounced in the French fashion, with both t’s silent), the extremely popular fake news show on Comedy Central. The other Colbert, the non-idiot, was the 47-year-old South Carolinian, a practicing Catholic, who lives with his wife and three children in suburban Montclair, N.J., where, according to one of his neighbors, he is “extremely normal.” One of the pleasures of attending a live taping of “The Colbert Report” is watching this Colbert transform himself into a Republican superhero.', 'print_section': 'MM', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/08/magazine/08colbert_span/08colbert_span-articleLarge.jpg', 'height': 366, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/08/magazine/08colbert_span/08colbert_span-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 366}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/08/magazine/08colbert_span/08colbert_span-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/08/magazine/08colbert_span/mag-08Colbert-t_CA0-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/08/magazine/08colbert_span/mag-08Colbert-t_CA0-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'How Many Stephen Colberts Are There?', 'kicker': None, 'content_kicker': None, 'print_headline': 'How Many Stephen Colberts Are There?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Colbert, Stephen', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Comedy and Humor', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Political Action Committees', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-01-04T10:00:47+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Charles McGrath', 'person': [{'firstname': 'Charles', 'middlename': None, 'lastname': 'McGrath', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6097d54c-e730-54e9-8df7-cb27cb30aa02', 'word_count': 5618, 'uri': 'nyt://article/6097d54c-e730-54e9-8df7-cb27cb30aa02'}, {'abstract': 'What does your favorite fashion item or accessory say about you?', 'web_url': 'https://learning.blogs.nytimes.com/2012/01/04/do-you-have-a-signature-clothing-item/', 'snippet': 'What does your favorite fashion item or accessory say about you?', 'lead_paragraph': 'While campaigning in Iowa, Republican presidential candidate Rick Santorum started making a fashion statement by wearing V-neck sweater vests. Do you have a favorite fashion item or accessory that you wear or carry often? What do you think it says about you?', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Do You Have a Signature Clothing Item?', 'kicker': 'The Learning Network', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-01-04T10:17:51+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By Holly Epstein Ojalvo', 'person': [{'firstname': 'Holly', 'middlename': 'Epstein', 'lastname': 'Ojalvo', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4b8affff-9d4b-50df-aa97-4835a79ebd3b', 'word_count': 454, 'uri': 'nyt://article/4b8affff-9d4b-50df-aa97-4835a79ebd3b'}, {'abstract': 'An analysis of the last 10 seasons shows that field-goal percentage defense and assist-to-turnover ratio are most correlated with teams winning the Colonial Athletic Association tournament.', 'web_url': 'https://thequad.blogs.nytimes.com/2012/01/04/the-statistics-that-drive-success-in-the-colonial/', 'snippet': 'An analysis of the last 10 seasons shows that field-goal percentage defense and assist-to-turnover ratio are most correlated with teams winning the Colonial Athletic Association tournament.', 'lead_paragraph': 'Field-goal percentage defense, assist-to-turnover ratio and rebounding margin:\xa0 a recent analysis on The Quad found that success in those three statistical categories to be most correlated with men’s college basketball teams reaching the Final Four. But are they also the best predictors for other levels of basketball success?', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Statistics That Drive Success in the Colonial', 'kicker': 'The Quad', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Basketball', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'College Athletics', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Colonial Athletic Assn', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-04T11:00:04+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Pro Basketball', 'byline': {'original': 'By Jack Styczynski', 'person': [{'firstname': 'Jack', 'middlename': None, 'lastname': 'Styczynski', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fd261edc-669a-5e77-bacf-e93a8eb840d5', 'word_count': 905, 'uri': 'nyt://article/fd261edc-669a-5e77-bacf-e93a8eb840d5'}, {'abstract': 'The government has settled on 99 weeks as the appropriate duration for unemployment insurance, but there’s plenty of room for political compromise between maintaining this duration and terminating benefits entirely, an economist writes.', 'web_url': 'https://economix.blogs.nytimes.com/2012/01/04/with-unemployment-insurance-is-99-weeks-the-magic-number/', 'snippet': 'The government has settled on 99 weeks as the appropriate duration for unemployment insurance, but there’s plenty of room for political compromise between maintaining this duration and terminating benefits entirely, an economist writes.', 'lead_paragraph': 'Casey B. Mulligan is an economics professor at the University of Chicago.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'With Unemployment Insurance, Is 99 Weeks the Magic Number?', 'kicker': 'Economix', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Unemployment Insurance', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-01-04T11:00:33+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Casey B. Mulligan', 'person': [{'firstname': 'Casey', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d6f0bb35-3307-5db0-bac5-1bc04e997e62', 'word_count': 533, 'uri': 'nyt://article/d6f0bb35-3307-5db0-bac5-1bc04e997e62'}, {'abstract': 'The five classically trained but comic members of the Spaghetti Western Orchestra, an act that devotes their humor-filled shows to Ennio Morricone, is playing in London this week.', 'web_url': 'https://intransit.blogs.nytimes.com/2012/01/04/ennio-morricones-music-gets-comic-treatment-in-london/', 'snippet': 'The five classically trained but comic members of the Spaghetti Western Orchestra, an act that devotes their humor-filled shows to Ennio Morricone, is playing in London this week.', 'lead_paragraph': 'The wide appeal of the music of the Oscar-winning composer Ennio Morricone, who wrote for spaghetti western films such as “Fistful of Dollars,” Brian de Palma’s “The Untouchables” and hundreds of other films, is evidenced by the wide array of artists who pay homage to him. They range from the producer Danger Mouse, who with Daniele Luppi last year released an album influenced by Morricone, to Metallica, who contributed to a 2007 tribute album.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Ennio Morricone’s Music Gets Comic Treatment in London', 'kicker': 'In Transit', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Morricone, Ennio', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'London (England)', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-01-04T11:00:56+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Travel', 'byline': {'original': 'By Gary Moskowitz', 'person': [{'firstname': 'Gary', 'middlename': None, 'lastname': 'Moskowitz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c9c07afe-c71c-57a8-8170-c78ea3788590', 'word_count': 278, 'uri': 'nyt://article/c9c07afe-c71c-57a8-8170-c78ea3788590'}, {'abstract': 'Four East Asian nations have all submitted war films for the foreign-language Oscar. That’s not where the similarities end.', 'web_url': 'https://carpetbagger.blogs.nytimes.com/2012/01/04/fighting-on-many-fronts-in-asian-foreign-language-entries/', 'snippet': 'Four East Asian nations have all submitted war films for the foreign-language Oscar. That’s not where the similarities end.', 'lead_paragraph': '1:18 p.m. | Updated  One of the intriguing mysteries of the competition for the Academy Award for best foreign-language film is trying to figure out why certain groups of countries submit films that are so similar in subject matter. For example, this year, as in 2011, several European countries have chosen films about interactions between Europeans and immigrants from poor, ravaged nations seeking sanctuary in the West.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Fighting on Many Fronts in Asian Foreign-Language Entries', 'kicker': 'Carpetbagger', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-01-04T11:01:13+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Larry Rohter', 'person': [{'firstname': 'Larry', 'middlename': None, 'lastname': 'Rohter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fe186136-083e-56f9-8247-d07d4af28af7', 'word_count': 1073, 'uri': 'nyt://article/fe186136-083e-56f9-8247-d07d4af28af7'}, {'abstract': 'Nelson Mandela has become an exaggerated template for South Africans’ hopes and fears.', 'web_url': 'https://latitude.blogs.nytimes.com/2012/01/04/when-mandela-goes/', 'snippet': 'Nelson Mandela has become an exaggerated template for South Africans’ hopes and fears.', 'lead_paragraph': 'JOHANNESBURG — Last Friday, the holiday cheer of New Year celebrations was disrupted by news that Nelson Mandela had just been rushed to the hospital. A popular local D.J., Kaya FM’s Bob Mabena, saw a report on a local television news channel and tweeted about it, setting off a virtual panic. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'When Mandela Goes', 'kicker': 'Latitude', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Mandela, Nelson', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'AFRICA', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'South Africa', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-04T11:22:59+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Eusebius McKaiser', 'person': [{'firstname': 'Eusebius', 'middlename': None, 'lastname': 'McKaiser', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4e7e0634-dce0-53f6-9fdf-58a8cdaaebc9', 'word_count': 456, 'uri': 'nyt://article/4e7e0634-dce0-53f6-9fdf-58a8cdaaebc9'}, {'abstract': 'The first play of the Jets’ season was a sign that the offensive line would not be able to protect Mark Sanchez. For some, it was not a surprise.', 'web_url': 'https://fifthdown.blogs.nytimes.com/2012/01/04/jets-season-foretold/', 'snippet': 'The first play of the Jets’ season was a sign that the offensive line would not be able to protect Mark Sanchez. For some, it was not a surprise.', 'lead_paragraph': 'It was Jets versus Dallas on a Sunday night at MetLife Stadium.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Jets Season, Foretold', 'kicker': 'The Fifth Down', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Jets', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-01-04T11:29:26+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Toni Monkovic', 'person': [{'firstname': 'Toni', 'middlename': None, 'lastname': 'Monkovic', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9486ca4b-83d5-5477-ae75-df16c7fc7ed7', 'word_count': 479, 'uri': 'nyt://article/9486ca4b-83d5-5477-ae75-df16c7fc7ed7'}, {'abstract': 'Government schools pay three times as much to educate students, but the quality of education seems much worse.', 'web_url': 'https://india.blogs.nytimes.com/2012/01/04/in-a-village-private-schools-do-more-with-less/', 'snippet': 'Government schools pay three times as much to educate students, but the quality of education seems much worse.', 'lead_paragraph': 'The phenomena of Indian parents sending their children to private school, no matter whether they are rich or poor, isn’t just happening in big cities. It has spread to towns and villages, as well.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In A Village, Private Schools Do More With Less', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Education (K-12)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Village School', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-01-04T11:58:28+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Hari Kumar', 'person': [{'firstname': 'Hari', 'middlename': None, 'lastname': 'Kumar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3a4f8a90-ff0b-53d7-83a2-b12e1152a71b', 'word_count': 669, 'uri': 'nyt://article/3a4f8a90-ff0b-53d7-83a2-b12e1152a71b'}, {'abstract': 'In 2011, our hiring was extremely successful. What changed? I stopped leading the process.', 'web_url': 'https://boss.blogs.nytimes.com/2012/01/04/reviewing-what-worked-and-what-didnt-in-2011/', 'snippet': 'In 2011, our hiring was extremely successful. What changed? I stopped leading the process.', 'lead_paragraph': 'The beginning of the year is a great time for reflection, revelation, resolution and even a little celebration. We did do some things right last year, and the results are starting to show. I also did some things wrong, which I intend to rectify in the near future. Move out of the way, 2011.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Reviewing What Worked and What Didn’t in 2011', 'kicker': 'You&#039;re the Boss', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Customer Relations', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Entrepreneurship', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Hiring and Promotion', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Small Business', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Salesforce.com Inc', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-01-04T12:00:29+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Entrepreneurship', 'byline': {'original': 'By Jay Goltz', 'person': [{'firstname': 'Jay', 'middlename': None, 'lastname': 'Goltz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/47d15adc-5a8c-5851-a8de-aa5994c3bb0b', 'word_count': 754, 'uri': 'nyt://article/47d15adc-5a8c-5851-a8de-aa5994c3bb0b'}, {'abstract': 'Fathoms below the freezing waters off Antarctica, unique communities clustered around hydrothermal vents teem with life.', 'web_url': 'https://green.blogs.nytimes.com/2012/01/04/amid-dark-vents-in-the-depths-something-stirs/', 'snippet': 'Fathoms below the freezing waters off Antarctica, unique communities clustered around hydrothermal vents teem with life.', 'lead_paragraph': 'Around 7,800 feet under the frigid Southern Ocean, the flash of a remotely operated underwater vehicle captured scenes from a distant undersea ecosystem. Slender chimneys belched plumes of boiling black smoke. A closer look at clusters of white pebbles revealed a writhing mass of countless yeti crabs — a new species. A pale, lone octopus skulked on the ocean floor. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Amid Dark Vents in the Depths, Something Stirs', 'kicker': 'Green', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fish and Other Marine Life', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Metals and Minerals', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Microbiology', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Oceans and Seas', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Offshore Drilling and Exploration', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Research', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Temperature', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Oxford University', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'ANTARCTIC REGIONS', 'rank': 10, 'major': 'N'}], 'pub_date': '2012-01-04T12:30:17+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Science', 'subsection_name': 'Environment', 'byline': {'original': 'By Rachel Nuwer', 'person': [{'firstname': 'Rachel', 'middlename': None, 'lastname': 'Nuwer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/780c52f7-9e65-5ccf-8a95-ab1d192c6d29', 'word_count': 787, 'uri': 'nyt://article/780c52f7-9e65-5ccf-8a95-ab1d192c6d29'}, {'abstract': 'The two white men were found guilty of the racially motivated murder of a black youth named Stephen Lawrence on a south London street in April 1993.', 'web_url': 'https://www.nytimes.com/2012/01/05/world/europe/two-sentenced-in-1993-racial-murder-case-that-changed-justice-in-britain.html', 'snippet': 'The two white men were found guilty of the racially motivated murder of a black youth named Stephen Lawrence on a south London street in April 1993.', 'lead_paragraph': 'LONDON — More than 18 years late by the reckoning of the victim’s family and many others across Britain, a jury at the Old Bailey found two white men guilty of the racially motivated stabbing and murder of a black youth named Stephen Lawrence on a south London street in April 1993. ', 'print_section': 'A', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/05/world/05murder/05murder-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/05/world/05murder/05murder-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/05/world/05murder/05murder-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/05/world/05murder/05murder-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/05/world/05murder/05murder-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': '2 Sentenced to Prison in Racial Killing That Scarred Britain', 'kicker': None, 'content_kicker': None, 'print_headline': '2 Sentenced to Prison in Racial Killing That Scarred Britain', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Decisions and Verdicts', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Norris, David', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Dobson, Gary', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Race and Ethnicity', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Sentences (Criminal)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Lawrence, Stephen', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'London (England)', 'rank': 8, 'major': 'N'}], 'pub_date': '2012-01-04T12:40:24+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By John F. Burns', 'person': [{'firstname': 'John', 'middlename': 'F.', 'lastname': 'Burns', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5722a851-ae6f-5604-9a22-8d7dbdd90175', 'word_count': 1045, 'uri': 'nyt://article/5722a851-ae6f-5604-9a22-8d7dbdd90175'}, {'abstract': 'Mitt Romney’s narrow victory in Iowa looks ugly on the stat sheet, but it accomplished quite a bit when you consider the broader context.', 'web_url': 'https://fivethirtyeight.blogs.nytimes.com/2012/01/04/winning-ugly-but-winning/', 'snippet': 'Mitt Romney’s narrow victory in Iowa looks ugly on the stat sheet, but it accomplished quite a bit when you consider the broader context.', 'lead_paragraph': 'I don’t care if you call it a win or a tie. In Iowa on Tuesday, Mitt Romney had a performance that looks ugly on the stat sheet, but which accomplished quite a bit when you consider it in its broader context.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Romney’s Ugly Win May Be a Charm', 'kicker': 'FiveThirtyEight', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Primaries and Caucuses', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Perry, Rick', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Santorum, Rick', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Iowa', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-01-04T12:47:53+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Nate Silver', 'person': [{'firstname': 'Nate', 'middlename': None, 'lastname': 'Silver', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f8a59a98-fa45-5781-b8ed-41db8c163183', 'word_count': 1016, 'uri': 'nyt://article/f8a59a98-fa45-5781-b8ed-41db8c163183'}, {'abstract': 'The educational primary continues.', 'web_url': 'https://krugman.blogs.nytimes.com/2012/01/04/sex-and-santorum/', 'snippet': 'The educational primary continues.', 'lead_paragraph': 'The race for the Republican presidential nomination has been an edifying spectacle. No, really: we are learning a lot of things that we might not have if it had been a simple Romney coronation. Until he rose in the polls, Ron Paul was seen by many liberals as an almost cuddly figure, a nice antiwar guy with some quirky ideas about gold; we’ve learned a bit since.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Sex and Santorum', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-01-04T12:50:45+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4f09b49d-5a71-506d-a25b-674c400facea', 'word_count': 182, 'uri': 'nyt://article/4f09b49d-5a71-506d-a25b-674c400facea'}, {'abstract': 'Occupy the Gilded Age.', 'web_url': 'https://krugman.blogs.nytimes.com/2012/01/04/beautifying-america/', 'snippet': 'Occupy the Gilded Age.', 'lead_paragraph': 'Andy Rosenthal, our editorial page editor, notes that Mitt Romney likes to quote from “America the Beautiful”, and tells us something I for one didn’t know:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Beautifying America', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-01-04T12:54:23+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5e3ef279-9c2f-5bba-845a-af7d2e2881f8', 'word_count': 96, 'uri': 'nyt://article/5e3ef279-9c2f-5bba-845a-af7d2e2881f8'}, {'abstract': 'Burning the Chinese flag in New Delhi.', 'web_url': 'https://india.blogs.nytimes.com/2012/01/04/image-of-the-day-january-4/', 'snippet': 'Burning the Chinese flag in New Delhi.', 'lead_paragraph': '', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Image of the Day: January 4', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Diplomatic Service, Embassies and Consulates', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Shiv Sena', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New Delhi (India)', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-04T12:57:04+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/162794db-7bbb-53ac-aa70-d5ac877ff472', 'word_count': 1, 'uri': 'nyt://article/162794db-7bbb-53ac-aa70-d5ac877ff472'}, {'abstract': 'Judy Battista, the N.F.L. reporter for The Times, will answer questions from readers.', 'web_url': 'https://fifthdown.blogs.nytimes.com/2012/01/04/have-n-f-l-questions-judy-battista-has-answers-7/', 'snippet': 'Judy Battista, the N.F.L. reporter for The Times, will answer questions from readers.', 'lead_paragraph': 'How far can the Broncos and Bengals go in the playoffs? Just what is going on with the Colts and Bears? Can the jets be put back together again? Judy Battista, the N.F.L. reporter for The Times, will answer questions from readers. Use the comment field below for your questions. Answers will appear Friday on The Fifth Down.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Have N.F.L. Questions? Judy Battista Has Answers', 'kicker': 'The Fifth Down', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Battista, Judy', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'National Football League', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-04T13:00:44+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/ab59b2c9-1fb1-5d33-a8bc-0cead25d2cd9', 'word_count': 58, 'uri': 'nyt://article/ab59b2c9-1fb1-5d33-a8bc-0cead25d2cd9'}, {'abstract': 'Rick Santorum used his speech on Tuesday night, a modified version of the one he has been giving to voters in all 99 counties across Iowa over the last several months, to cast the race as a struggle to allow good to prevail.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2012/01/04/santorum-celebrates-strong-finish-in-iowa/', 'snippet': 'Rick Santorum used his speech on Tuesday night, a modified version of the one he has been giving to voters in all 99 counties across Iowa over the last several months, to cast the race as a struggle to allow good to prevail.', 'lead_paragraph': 'JOHNSTON, Iowa — Rick Santorum often speaks in biblical terms, weaving references to God and Christian faith into his speeches on the campaign trail. Before a national audience on Tuesday night, he offered a glimpse of how large a theme religion will be in his quest for the Republican presidential nomination.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Santorum Celebrates Strong Finish in Iowa', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-01-04T13:05:24+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Jeremy W. Peters', 'person': [{'firstname': 'Jeremy', 'middlename': 'W.', 'lastname': 'Peters', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/901237be-af4b-5077-bd4a-22e1d773a76c', 'word_count': 356, 'uri': 'nyt://article/901237be-af4b-5077-bd4a-22e1d773a76c'}, {'abstract': 'UniCredit, which is trying to raise about 7.5 billion euros in fresh capital to comply with new requirements, offered existing shareholders a significant discount on new stock on Wednesday, sending its shares tumbling.', 'web_url': 'https://dealbook.nytimes.com/2012/01/04/unicredit-offer-weighs-on-shares/', 'snippet': 'UniCredit, which is trying to raise about 7.5 billion euros in fresh capital to comply with new requirements, offered existing shareholders a significant discount on new stock on Wednesday, sending its shares tumbling.', 'lead_paragraph': 'The Italian bank UniCredit, which is seeking to raise capital to comply with new requirements, offered existing shareholders a significant discount on new stock on Wednesday, sending its shares tumbling.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'UniCredit Offering Weighs on Its Shares', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Deutsche Bank AG', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Grupo Santander', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Unicredito Italiano SpA', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-04T13:08:00+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Dealbook', 'person': [{'firstname': 'Dealbook', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/70458ebf-b495-5ae5-bd0c-d38bb6b1850b', 'word_count': 264, 'uri': 'nyt://article/70458ebf-b495-5ae5-bd0c-d38bb6b1850b'}, {'abstract': 'The Iowa caucus, despite its position at the center of the political universe every four years, does not legally determine who gets the state’s 25 delegates to the Republican nominating convention.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2012/01/04/no-need-for-recount-in-iowa-caucus/', 'snippet': 'The Iowa caucus, despite its position at the center of the political universe every four years, does not legally determine who gets the state’s 25 delegates to the Republican nominating convention.', 'lead_paragraph': 'DES MOINES — It was, perhaps, the closest finish ever between two candidates in a presidential caucus.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Despite Close Finish, No Recount in Iowa', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Primaries and Caucuses', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Santorum, Rick', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Iowa', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-01-04T13:16:28+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Michael D. Shear', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/224bbafe-8f07-5a3d-87a1-4d68eb54804f', 'word_count': 389, 'uri': 'nyt://article/224bbafe-8f07-5a3d-87a1-4d68eb54804f'}, {'abstract': 'Television news lionized Mr. Hazare before realizing what he stood for, the author argues.', 'web_url': 'https://india.blogs.nytimes.com/2012/01/04/was-anna-hazare-a-media-created-farce/', 'snippet': 'Television news lionized Mr. Hazare before realizing what he stood for, the author argues.', 'lead_paragraph': '“Last week in Mumbai, an old man accepted defeat,” Manu Joseph writes in the International Herald Tribune. What sounds like it might at first be an indictment of the Anna Hazare movement, though, is actually a dissection of the news media that transformed him into a movement. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Was Anna Hazare a Media-Created Farce?', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Hazare, Anna', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'International Herald Tribune', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Mumbai (India)', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-04T13:26:03+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/d4cb4879-49c1-56d2-95c0-0a342f822320', 'word_count': 262, 'uri': 'nyt://article/d4cb4879-49c1-56d2-95c0-0a342f822320'}, {'abstract': 'When Governor Cuomo lays out his priorities on Wednesday in his state of the state address, listen to the details of his proposals for a new state education commission, financial incentives to schools, more state aid, mandate relief and his intentions when it comes to teacher evaluations.', 'web_url': 'https://www.nytimes.com/schoolbook/2012/01/04/five-things-to-listen-for-in-cuomo-speech/', 'snippet': 'When Governor Cuomo lays out his priorities on Wednesday in his state of the state address, listen to the details of his proposals for a new state education commission, financial incentives to schools, more state aid, mandate relief and his