 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0af48e40-21d1-5513-8f89-b29f397ca62e', 'word_count': 454, 'uri': 'nyt://article/0af48e40-21d1-5513-8f89-b29f397ca62e'}, {'abstract': 'The S.E.C. needs more than suspicious trading patterns to prove an insider trading case and must provide evidence that a trader acted on material nonpublic information.', 'web_url': 'https://dealbook.nytimes.com/2012/01/03/the-outer-limits-of-insider-trading/', 'snippet': 'The S.E.C. needs more than suspicious trading patterns to prove an insider trading case and must provide evidence that a trader acted on material nonpublic information.', 'lead_paragraph': 'Most insider trading cases start out with suspicions about well-timed transactions that prove to be lucrative once information becomes public about a company. Bringing a successful enforcement action requires more than just suspicious trading, however, because the government must have evidence that a trader acted on material nonpublic information and not just that the person made a particularly prescient investment.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Outer Limits of Insider Trading', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Insider Trading', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Banco Santander S A', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'BHP Billiton PLC', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Potash Corporation of Saskatchewan Inc', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Securities and Exchange Commission', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-01-03T19:33:22+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Peter J. Henning', 'person': [{'firstname': 'Peter', 'middlename': 'J.', 'lastname'