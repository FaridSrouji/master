mbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': '‘Götterdämmerung’', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Opera', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Lepage, Robert', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Metropolitan Opera', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'Gotterdammerung (Opera)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Voigt, Deborah', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-01-29T17:45:26+0000', 'document_type': 'multimedia', 'news_desk': 'Arts', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/c524df6e-422e-5e08-8e61-ff743964d5ee', 'word_count': 0, 'uri': 'nyt://slideshow/c524df6e-422e-5e08-8e61-ff743964d5ee'}, {'abstract': 'In the first in a series of curated lists of must-reads by experts in the primary states, the editor of the Sayfie Review offers a guide landmarks in Florida politics that shape the landscape today.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2012/01/29/a-pros-tip-sheet-the-guide-to-florida-politics-from-justin-sayfie/', 'snippet': 'In the first in a series of curated lists of must-reads by experts in the primary states, the editor of the Sayfie Review offers a guide landmarks in Florida politics that shape the landscape today.', 'lead_paragraph': 'Ah, Florida. The state looms large in Republican politics, not just because its primary on Tuesday will involve the largest, most diverse electorate yet. Republicans in Florida played kingmaker to Senator John McCain when he won its primary in 2008, but Barack Obama ultimately won the general election. The state is home to two of the Republicans’ biggest heroes: Jeb Bush, a former governor, and Senator Marco Rubio — who, like Gov. Rick Scott, rode into office with Tea Party backing — and one the party’s villains: former Gov. Charlie Crist, a moderate Republican who ran for the Senate against Mr. Rubio as an independent.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Pro’s Tip Sheet: Justin Sayfie’s Guide to Florida Politics', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Bush, Jeb', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Crist, Charlie', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'McCain, John', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Rubio, Marco', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Scott, Richard L', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Florida', 'rank': 10, 'major': 'N'}], 'pub_date': '2012-01-29T17:50:02+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Sarah Wheaton', 'person': [{'firstname': 'Sarah', 'middlename': None, 'lastname': 'Wheaton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8bd25856-5ab2-54a3-9167-c173c6188069', 'word_count': 677, 'uri': 'nyt://article/8bd25856-5ab2-54a3-9167-c173c6188069'}, {'abstract': 'New polls suggest the tough road ahead for Mr. Gingrich in Florida.', 'web_url': 'https://fivethirtyeight.blogs.nytimes.com/2012/01/29/gingrich-upset-chances-dwindle-in-new-florida-polls/', 'snippet': 'New polls suggest the tough road ahead for Mr. Gingrich in Florida.', 'lead_paragraph': '', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Gingrich Upset Chances Dwindle in New Florida Polls', 'kicker': 'FiveThirtyEight', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Polls and Public Opinion', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Primaries and Caucuses', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Cain, Herman', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Gingrich, Newt', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'NBC News', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Rasmussen Reports', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Florida', 'rank': 8, 'major': 'N'}], 'pub_date': '2012-01-29T17:54:58+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Nate Silver', 'person': [{'firstname': 'Nate', 'middlename': None, 'lastname': 'Silver', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/23e06462-27c5-527f-8019-9a9ea0e72beb', 'word_count': 217, 'uri': 'nyt://article/23e06462-27c5-527f-8019-9a9ea0e72beb'}, {'abstract': 'The show features music from the composer Frank Wildhorn, who has struggled with a string of flops, including two short-lived 2011 productions, “Bonnie & Clyde” and “Wonderland.”', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/01/29/plans-for-a-return-of-jekyll-hyde-to-broadway/', 'snippet': 'The show features music from the composer Frank Wildhorn, who has struggled with a string of flops, including two short-lived 2011 productions, “Bonnie & Clyde” and “Wonderland.”', 'lead_paragraph': 'Nederlander Presentations announced on Sunday that it would stage a new production of the four-time Tony Award-nominated musical “Jekyll & Hyde.” The show features music from the composer Frank Wildhorn, who has struggled with a string of flops, including two short-lived 2011 productions, “Bonnie & Clyde” and “Wonderland.” Although “Jekyll & Hyde” is arguably the most well-known of Mr. Wildhorn’s works, with an original run on Broadway lasting more than three and a half years, the show failed to turn a profit before it closed in 2001. Constantine Maroulis (“Rock of Ages”) will play both central characters; the book and lyrics are by Leslie Bricusse. The producers are aiming for a spring 2013 arrival on Broadway after a 25-week national tour scheduled to begin on Oct. 2 in San Diego.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Plans for a Return of ‘Jekyll & Hyde’ to Broadway', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Wildhorn, Frank', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Nederlander Organization', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-01-29T18:06:40+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Adam W. Kepler', 'person': [{'firstname': 'Adam', 'middlename': 'W.', 'lastname': 'Kepler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/185f7169-c5d0-5fbd-b0b9-81f8cb39d3c7', 'word_count': 130, 'uri': 'nyt://article/185f7169-c5d0-5fbd-b0b9-81f8cb39d3c7'}, {'abstract': 'In the first sign that Iraq’s leaders may yet halt a sectarian political crisis that has raised fears of civil war, Iraq’s Sunni leaders said Sunday that they would end their boycott of Parliament.', 'web_url': 'https://www.nytimes.com/2012/01/30/world/middleeast/sunnis-end-boycott-of-iraqi-parliament.html', 'snippet': 'In the first sign that Iraq’s leaders may yet halt a sectarian political crisis that has raised fears of civil war, Iraq’s Sunni leaders said Sunday that they would end their boycott of Parliament.', 'lead_paragraph': 'BAGHDAD — In the first sign that Iraq’s leaders may yet halt a sectarian political crisis that has raised fears of civil war, Iraq’s Sunni leaders said Sunday that they would end their boycott of Parliament. ', 'print_section': 'A', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/30/world/30iraq/30iraq-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/30/world/30iraq/30iraq-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/30/world/30iraq/30iraq-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/30/world/30iraq/30iraq-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/30/world/30iraq/30iraq-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Sunnis End Boycott of Iraqi Parliament, but Crisis Remains', 'kicker': None, 'content_kicker': None, 'print_headline': 'Sunnis End Boycott of Iraqi Parliament, but Crisis Remains', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Iraqiya', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Iraq', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Legislatures and Parliaments', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Civil War and Guerrilla Warfare', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Sunni Muslims', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Iraq War (2003-11)', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-01-29T18:27:35+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Tim Arango', 'person': [{'firstname': 'Tim', 'middlename': None, 'lastname': 'Arango', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b9a01c71-d327-509d-b4d4-966e571ca0e3', 'word_count': 691, 'uri': 'nyt://article/b9a01c71-d327-509d-b4d4-966e571ca0e3'}, {'abstract': 'The Issue Project Room opened its new quarters in Brooklyn with the Gaudeamus Muziekweek festival, featuring the Wet Ink Ensemble.', 'web_url': 'https://www.nytimes.com/2012/01/30/arts/music/wet-ink-in-gaudeamus-muziekweek-at-new-issue-project-room.html', 'snippet': 'The Issue Project Room opened its new quarters in Brooklyn with the Gaudeamus Muziekweek festival, featuring the Wet Ink Ensemble.', 'lead_paragraph': 'It has been a long time coming — about four years of raising money and renovating — but on Wednesday evening the Issue Project Room settled into its new digs in the former Board of Education building at 110 Livingston Street in downtown Brooklyn. For anyone who spent time in Issue Project’s former home, a tiny space at the Old American Can Factory, also in Brooklyn, this is a new world: the room is spacious (5,000 square feet) and rich in retro grandeur, with marble floors, columns and arches, and a high, ornate ceiling. ', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/30/arts/week/week-articleLarge.jpg', 'height'