ajor': 'N'}, {'name': 'persons', 'value': 'Tebow, Tim', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'New England Patriots', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Playoff Games', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-01-09T01:57:07+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Judy Battista', 'person': [{'firstname': 'Judy', 'middlename': None, 'lastname': 'Battista', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e9eeab02-4611-59a2-810c-70dcf9249cc4', 'word_count': 987, 'uri': 'nyt://article/e9eeab02-4611-59a2-810c-70dcf9249cc4'}, {'abstract': 'The demand by President Hamid Karzai of Afghanistan that the Americans cede control of an Afghan prison exposes a deep vein of mistrust.', 'web_url': 'https://www.nytimes.com/2012/01/09/world/asia/karzais-ultimatum-on-afghan-prison-complicates-us-exit-strategy.html', 'snippet': 'The demand by President Hamid Karzai of Afghanistan that the Americans cede control of an Afghan prison exposes a deep vein of mistrust.', 'lead_paragraph': 'KABUL, Afghanistan — President Hamid Karzai’s denunciation last week of abuses at the main American prison in Afghanistan — and his abrupt demand that Americans cede control of the site within a month — surprised many here. The prison, at Bagram Air Base, is one of the few in the country where Afghan and Western rights advocates say that conditions are relatively humane.', 'print_section': 'A', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/09/world/BAGRAM-2/BAGRAM-2-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit'