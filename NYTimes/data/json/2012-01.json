': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-01-31T20:59:56+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Anna Sussman', 'person': [{'firstname': 'Anna', 'middlename': None, 'lastname': 'Sussman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/16914068-708e-5ad5-a3aa-bf4aff8421df', 'word_count': 801, 'uri': 'nyt://article/16914068-708e-5ad5-a3aa-bf4aff8421df'}, {'abstract': 'Masak, an East Village restaurant, makes Singaporean dishes a point of departure, with local ingredients freely employed.', 'web_url': 'https://www.nytimes.com/2012/02/01/dining/masak-nyc-restaurant-review.html', 'snippet': 'Masak, an East Village restaurant, makes Singaporean dishes a point of departure, with local ingredients freely employed.', 'lead_paragraph': 'CHILI crab may be the world’s messiest national dish. Dismantling a massive crustacean slathered in spicy sauce at one of Singapore’s street-food stalls can require more napkins than you have fingers. It’s thrilling, as is much of the dining in Singapore, where dozens of vendors share a clamorous stage at one of the country’s government-run hawker centers.', 'print_section': 'D', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/02/01/dining/01UNDER_SPAN/01UNDER_SPAN-articleLarge.jpg', 'height': 310, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/02/01/dining/01UNDER_SPAN/01UNDER_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 310}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/02/01/dining/01UNDER_SPAN/01UNDER_SPAN-jumbo.jpg', 'height': 683, 'width': 1024, '