ne': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'McCollum, Kevin', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Seller, Jeffrey', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-06T17:00:03+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Patrick Healy', 'person': [{'firstname': 'Patrick', 'middlename': None, 'lastname': 'Healy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0f5508c3-2e1e-53e0-a18e-e7ee19738ef3', 'word_count': 360, 'uri': 'nyt://article/0f5508c3-2e1e-53e0-a18e-e7ee19738ef3'}, {'abstract': 'Leonard Shure and Henri Temianka’s 1946 recordings of the 10 Beethoven sonatas for violin and piano have been released by Doremi, a label specializing in historic live concerts.', 'web_url': 'https://www.nytimes.com/2012/01/08/arts/music/leonard-shure-and-henri-temiankas-beethoven-sonatas.html', 'snippet': 'Leonard Shure and Henri Temianka’s 1946 recordings of the 10 Beethoven sonatas for violin and piano have been released by Doremi, a label specializing in historic live concerts.', 'lead_paragraph': 'SOMETIMES, for whatever reason, artists who are enormously respected by their peers do not develop the extensive careers and public following that their talents and accomplishments merit. This could be said of the violinist Henri Temianka and the pianist Leonard Shure. Though they did not appear regularly as a duo, Temianka, who died at 85 in 1992, and Shure, who died at 84 three years later, performed Beethoven’s 10 sonatas for violin and piano at the Library of Congress in Washington in three programs over five days in 1946. ', 'print_section': 'AR', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None,