ew York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/20/movies/20RDP_PRUITT_SPAN/20RDP_PRUITT_SPAN-articleLarge-v2.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/20/movies/20RDP_PRUITT_SPAN/20RDP_PRUITT_SPAN-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/20/movies/20RDP_PRUITT_SPAN/20RDP_PRUITT_SPAN-jumbo-v2.jpg', 'height': 669, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/20/movies/20RDP_PRUITT_SPAN/20RDP_PRUITT_SPAN-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/20/movies/20RDP_PRUITT_SPAN/20RDP_PRUITT_SPAN-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Renewal of Urban History', 'kicker': "Movie Review | 'The Pruitt-Igoe Myth'", 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Pruitt-Igoe Myth, The (Movie)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Demolition', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Documentary Films and Programs', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Public and Subsidized Housing', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-01-20T01:11:54+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Rachel Saltz', 'person': [{'firstname': 'Rachel', 'middlename': None, 'lastname': 'Saltz', 'qualifier': None, 'title': None, 'role': 'reported', 