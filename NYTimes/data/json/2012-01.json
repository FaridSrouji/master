eadline': {'main': 'Prosecco Growers Act to Guard Its Pedigree', 'kicker': None, 'content_kicker': None, 'print_headline': 'Prosecco Growers Act to Guard Its Pedigree', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Prosecco (Wine)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Wines', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Italy', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-10T22:26:51+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Alan Tardi', 'person': [{'firstname': 'Alan', 'middlename': None, 'lastname': 'Tardi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fe313841-e1fc-50ea-8308-bd273ba23be6', 'word_count': 987, 'uri': 'nyt://article/fe313841-e1fc-50ea-8308-bd273ba23be6'}, {'abstract': 'Only children, with a sprinkling of adult supervision, will be permitted to attend the Jan. 19 Dutch Cup replay between Ajax and AZ.', 'web_url': 'https://goal.blogs.nytimes.com/2012/01/10/in-the-netherlands-a-childs-game-for-children-only/', 'snippet': 'Only children, with a sprinkling of adult supervision, will be permitted to attend the Jan. 19 Dutch Cup replay between Ajax and AZ.', 'lead_paragraph': 'The replay of the Dutch Cup match between Ajax and AZ, which was abandoned on Dec. 21 and is scheduled to be played on Jan. 19, will be for children only.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In the Netherlands, a Child’s Game for Children Only', 'kicker': 'Goal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Soccer', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Netherlands', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-01-10T22:28:31+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Soccer', 'byline': {'original': 'By Jack Bell', 'person': [{'firstname': 'Jack', 'middlename': None, 'lastname': 'Bell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/635f3528-54a8-5123-85ac-067c99a1d615', 'word_count': 262, 'uri': 'nyt://article/635f3528-54a8-5123-85ac-067c99a1d615'}, {'abstract': '“The Culinarian: A Kitchen Desk Reference” is crammed with an unusual amount of information, organized alphabetically from “absinthe” to “zwieback.”', 'web_url': 'https://www.nytimes.com/2012/01/11/dining/the-culinarian-a-kitchen-desk-reference.html', 'snippet': '“The Culinarian: A Kitchen Desk Reference” is crammed with an unusual amount of information, organized alphabetically from “absinthe” to “zwieback.”', 'lead_paragraph': 'Every so often publishers issue kitchen guides with definitions, measurements, conversion tables and the like. The Culinarian: A Kitchen Desk Reference is crammed with an unusual amount of information, organized alphabetically from “absinthe” to “zwieback.” The author, Barbara Ann Kipfer, is a seasoned lexicographer, and it shows. Search for “chicken,” and you’ll find two pages of tips and a list of 50 chicken breeds. The shrimp entry decodes size grading, and for meringue, four varieties are defined. The book is a voyage of discovery, with useful information and fascinating trivia on every page. The first few pages list smoke points for various oils, and measurements, yields and equivalents for many foods. In one puzzling choice, though, the book provides weights and measures for medium-size eggs, not the large ones that most recipes require. ', 'print_section': 'D', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/11/dining/11STUFF4_GUIDE/11STUFF_GUIDE-jumbo.jpg', 'height': 1024, 'width': 730, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/11/dining/11STUFF4_GUIDE/11STUFF_GUIDE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/11/dining/11STUFF4_GUIDE/11STUFF_GUIDE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'From A to Z, a Book Deciphers Cooking', 'kicker': 'Food Stuff', 'content_kicker': None, 'print_headline': 'From A to Z, a Book Deciphers Cooking', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-01-10T22:30:45+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/71f14f3c-21c4-5060-b27a-64e6339d77cc', 'word_count': 147, 'uri': 'nyt://article/71f14f3c-21c4-5060-b27a-64e6339d77cc'}, {'abstract': 'Halfpops, a crunchy new snack from the Seattle area, is made from air-popped corn.', 'web_url': 'https://www.nytimes.com/2012/01/11/dining/halfpops-deliver-crunch.html', 'snippet': 'Halfpops, a crunchy new snack from the Seattle area, is made from air-popped corn.', 'lead_paragraph': 'You could view them, unkindly, as duds: pieces of popcorn that have not been popped to their fluffy white extreme. But these crisp little nuggets are less like the hard kernels at the bottom of your popcorn bowl and more like corn nuts. Halfpops, a new snack from the Seattle area, deliver a similar crunch, but are made from air-popped corn — unlike corn nuts, whole corn kernels that are soaked, then roasted or fried. Halfpops come in two flavors: butter and sea salt, and white Cheddar cheese. And beyond mere snacking, they are excellent sprinkled on a salad or vegetables, or served (as corn nuts are in South America) as a nibble alongside ceviche.', 'print_section': 'D', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/11/dining/11STUFF2_POPCORNSPAN/11STUFF_POPCORNSPAN-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/11/dining/11STUFF2_POPCORNSPAN/11STUFF_POPCORNSPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/11/dining/11STUFF2_POPCORNSPAN/11STUFF2-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/11/dining/11STUFF2_POPCORNSPAN/11STUFF_POPCORNSPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/11/dining/11STUFF2_POPCORNSPAN/11STUFF_POPCORNSPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Snap, Crackle and (Some) Pop', 'kicker': 'Food Stuff', 'content_kicker': None, 'print_headline': 'Snap, Crackle And (Some) Pop', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Popcorn', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-01-10T22:33:28+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabr