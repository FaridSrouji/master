: 'N'}, {'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Men and Boys', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-16T16:20:07+0000', 'document_type': 'multimedia', 'news_desk': 'Fashion & Style', 'section_name': 'Fashion & Style', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/7f56186f-1836-53dd-9413-1a68d48e8f59', 'word_count': 0, 'uri': 'nyt://slideshow/7f56186f-1836-53dd-9413-1a68d48e8f59'}, {'abstract': 'Harvey Weinstein was given a lot of nicknames during the Golden Globes festivities, so we asked him his favorite.', 'web_url': 'https://carpetbagger.blogs.nytimes.com/2012/01/16/the-harvey-weinstein-nickname-you-havent-heard/', 'snippet': 'Harvey Weinstein was given a lot of nicknames during the Golden Globes festivities, so we asked him his favorite.', 'lead_paragraph': 'If the applause meter is one way to measure Hollywood popularity, then party attendance is another. According to the Globes calculus, the winners have the best parties, so the Bagger immediately made her way to the Weinstein Company afterparty. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Harvey Weinstein Nickname You Haven’t Heard', 'kicker': 'Carpetbagger', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-01-16T16:22:13+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Melena Ryzik', 'person': [{'firstname': 'Melena', 'middlename': None, 'lastname': 'Ryzik', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0fa75cd2-e47d-5466-ab16-5d54d8f72a50', 'word_count': 133, 'uri': 'nyt://article/0fa75cd2-e47d-5466-ab16-5d54d8f72a50'}, {'abstract': 'This is a house built on a coat — the trench — and Christopher Bailey always sticks smartly to the program.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2012/01/16/milan-top-5-burberry/', 'snippet': 'This is a house built on a coat — the trench — and Christopher Bailey always sticks smartly to the program.', 'lead_paragraph': 'The obsessively descriptive list of coat styles in the notes for Christopher Bailey’s fantastic Burberry Prorsum show read like a comprehensive history of English outerwear: “heritage trench coats, luggage lock duffle coats, sartorial tailored Chesterfields, college stripe down-filled car coats, cropped bomber jackets” and on and on and on. This is a house built on a coat — the trench — and Bailey always sticks smartly to the program. The torso-hugging, slim-legged suits at the show’s opening were my favorites, with models in tweed flat caps toting umbrellas with carved animal head handles, their coats over their shoulders or buttoned up tight against the cold.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Milan Top 5 | Burberry', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-01-16T16:30:48+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Bruce Pask', 'person': [{'firstname': 'Bruce', 'middlename': None, 'lastname': 'Pask', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/781aed99-8f33-5fad-accd-0d9b7b38b565', 'word_count': 126, 'uri': 'nyt://article/781aed99-8f33-5fad-accd-0d9b7b38b565'}, {'abstract': 'It was a strong collection, notable for varied proportions — dropped-crotch trousers tight at the calf, upholstery-scale overcoats, snug jackets with bum-cooler skirting, modified equestrian field boots — and masterfully combined textures.', 'web_url': 'https://runway.blogs.nytimes.com/2012/01/16/getting-the-reference/', 'snippet': 'It was a strong collection, notable for varied proportions — dropped-crotch trousers tight at the calf, upholstery-scale overcoats, snug jackets with bum-cooler skirting, modified equestrian field boots — and masterfully combined textures.', 'lead_paragraph': 'The reference machine is always working overtime in Milan. Leonardo DiCaprio as Arthur Rimbaud in love/hate with Paul Verlaine as interpreted by Leonardo DiCaprio in Agnieszka Holland’s 1995 film “Total Eclipse.” That’s what the designer Frida Giannini was thinking about when she began putting together her latest collection, she said backstage at Gucci on Monday. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Getting the Reference', 'kicker': 'On the Runway', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Design', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Milan (Italy)', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-16T16:34:14+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Guy Trebay', 'person': [{'firstname': 'Guy', 'middlename': None, 'lastname': 'Trebay', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fde0225f-6a02-5487-9bba-010d809e7a13', 'word_count': 191, 'uri': 'nyt://article/fde0225f-6a02-5487-9bba-010d809e7a13'}, {'abstract': 'Aides to Jon M. Huntsman Jr.said he believed it would be better for the party if he pulled out now.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2012/01/16/huntsman-leaving-race-after-chat-with-romney/', 'snippet': 'Aides to Jon M. Huntsman Jr.said he believed it would be better for the party if he pulled out now.', 'lead_paragraph': '11:36 a.m. | Updated MYRTLE BEACH, S.C. – Former Gov. Jon M. Huntsman Jr. of Utah formally ended his once-promising Republican presidential run with a call for party unity, asking the five candidates he leaves on the field to end their negative ads and chastising President Obama for engaging in “class warfare.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Huntsman Leaves Race With Plea for Party Unity', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Endorsements', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Primaries and Caucuses', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Speeches and Statements', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Gingrich, Newt', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Huntsman, Jon M Jr', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Fox News Channel', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'South Carolina', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'Utah', 'rank': 11, 'major': 'N'}], 'pub_date': '2012-01-16T16:36:38+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Jim Rutenberg and Jeff Zeleny', 'person': [{'firstname': 'Jim', 'middlename': None, 'lastname': 'Rutenberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Jeff', 'middlename': None, 'lastname': 'Zeleny', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bbec689f-d070-5802-951d-6e83d399499d', 'word_co