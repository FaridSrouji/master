eo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'New York Philharmonic', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'VanBesien, Matthew', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Appointments and Executive Changes', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-01-04T15:57:25+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Daniel J. Wakin', 'person': [{'firstname': 'Daniel', 'middlename': 'J.', 'lastname': 'Wakin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fc86d567-ba3d-5af9-975c-c26832c45ef6', 'word_count': 1110, 'uri': 'nyt://article/fc86d567-ba3d-5af9-975c-c26832c45ef6'}, {'abstract': 'In “Sora and the Cloud,” a young boy is given a bird’s-eye view of the world.', 'web_url': 'https://www.nytimes.com/2012/01/04/books/sora-and-the-cloud-by-felicia-hoshino-review.html', 'snippet': 'In “Sora and the Cloud,” a young boy is given a bird’s-eye view of the world.', 'lead_paragraph': 'The classic Japanese children’s song “Tako no uta” (or “Song of Kites”) is a cheerful ode to flying. It is also one of many Japanese cultural references embedded in “Sora and the Cloud,” Felicia Hoshino’s rich, clever and appealing book. Offering both English and Japanese text, it is itself a lovely tribute to the joys of soaring high.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/04/books/04sora-img1/04sora-img1-articleLarge.jpg', 'height': 243, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/04/books/04sora-img1/04sora-img1-articleLarge.jpg'