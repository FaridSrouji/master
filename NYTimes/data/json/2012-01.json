role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d7f86a99-02d2-59d6-a384-96d5f89a4956', 'word_count': 0, 'uri': 'nyt://article/d7f86a99-02d2-59d6-a384-96d5f89a4956'}, {'abstract': 'Whether the American economy, which grew last quarter at its fastest pace in a year and a half, can sustain that momentum is critical to millions of people out of work.', 'web_url': 'https://www.nytimes.com/2012/01/28/business/economy/us-economy-grows-at-modest-2-8-percent-rate.html', 'snippet': 'Whether the American economy, which grew last quarter at its fastest pace in a year and a half, can sustain that momentum is critical to millions of people out of work.', 'lead_paragraph': 'The American economy picked up a little steam last quarter, growing at its fastest pace in a year and a half. Whether it can sustain that momentum is critical to millions of Americans out of work — and perhaps President Obama’s re-election chances. ', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/28/business/Econ/Econ-articleLarge.jpg', 'height': 370, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/28/business/Econ/Econ-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 370}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/28/business/Econ/Econ-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/28/business/Econ/Econ-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/28/business/Econ/Econ-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Growth Accelerates, but U.S. Has Lots of Ground to Make Up', 'kicker': None, 'content_kicker': None, 'print_headline': 'Economy Grew At Quicker Pace In 4th Quarter', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Economy', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Gross Domestic Product', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Commerce Department', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Recession and Depression', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-01-27T13:42:02+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Catherine Rampell', 'person': [{'firstname': 'Catherine', 'middlename': None, 'lastname': 'Rampell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8024e422-c8c9-580c-8988-22ba881a4b7c', 'word_count': 958, 'uri': 'nyt://article/8024e422-c8c9-580c-8988-22ba881a4b7c'}, {'abstract': 'Highlights from the DealBook newsletter.', 'web_url': 'https://dealbook.nytimes.com/2012/01/27/morning-take-out-410/', 'snippet': 'Highlights from the DealBook newsletter.', 'lead_paragraph': 'In Punishing Year for Hedge Funds, Biggest One Thrived \xa0|\xa0 The world’s biggest hedge fund is also one of the best performers.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Morning Take-Out', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-01-27T13:46:22+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By William Alden', 'person': [{'firstname': 'William', 'middlename': None, 'lastname': 'Alden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9ca9f9df-58f0-5034-8d00-fce42d19ca2e', 'word_count': 2322, 'uri': 'nyt://article/9ca9f9df-58f0-5034-8d00-fce42d19ca2e'}, {'abstract': 'Buying customer reviews on Amazon, a censorship tool on Twitter, Super Bowl ads and President Obama gives a boost to Al Green.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2012/01/27/the-breakfast-meeting-questions-for-drudge-report-and-when-bowie-said-no/', 'snippet': 'Buying customer reviews on Amazon, a censorship tool on Twitter, Super Bowl ads and President Obama gives a boost to Al Green.', 'lead_paragraph': 'The 19th Republican presidential debate represented a role reversal, as Newt Gingrich tried to dial down the conflict on stage and a well-prepared Mitt Romney went at Mr. Gingrich, at one point saying, “Wouldn’t it be nice if people didn’t make accusations somewhere else that they weren’t willing to defend here?” Jim Rutenberg and Jeff Zeleny noted that while Mr. Gingrich has usually won over debate audiences “with an assortment of one-liners aimed at the establishment and, frequently, the news media,” those techniques didn’t seem to have the same effect.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Breakfast Meeting: Questions for Drudge Report, and When Bowie Said No', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'E-Commerce', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Freedom of the Press', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Primaries and Caucuses', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Bowie, David', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Gingrich, Newt', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Green, Al', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Lessing, Doris', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 11, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 12, 'major': 'N'}, {'name': 'organizations', 'value': 'AMAZON.COM INC', 'rank': 13, 'major': 'N'}, {'name': 'organizations', 'value': 'Drudge Report', 'rank': 14, 'major': 'N'}, {'name': 'organizations', 'value': 'Hollywood Reporter', 'rank': 15, 'major': 'N'}, {'name': 'organizations', 'value': 'Nielsen SoundScan', 'rank': 16, 'major': 'N'}, {'name': 'organizations', 'value': 'Twitter', 'rank': 17, 'major': 'N'}], 'pub_date': '2012-01-27T13:54:17+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Noam Cohen', 'person': [{'firstname': 'Noam', 'middlename': None, 'lastname': 'Cohen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/414577e1-828c-5f69-b614-faa55e6bc6b3', 'word_count': 589, 'uri': 'nyt://article/414577e1-828c-5f69-b614-faa55e6bc6b3'}, {'abstract': '“The Great American Cereal Book” instantly evokes feelings of childhood.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2012/01/27/bookshelf-snap-crackle-pop/', 'snippet': '“The Great American Cereal Book” instantly evokes feelings of childhood.', 'lead_paragraph': 'var data;function jsonSlideshowCallback(response){data = response;}NYTD.options = {source: data,cropType: \'blog480\',appendTo: \'fullScreenSlideShow\',showHeadLine: \'false\', renderstyle: "embeddedSlideShowTmag"}', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Bookshelf | Snap! Crackle! Pop!', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cereals', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-01-27T14:00:09+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By George Gene Gustines', 'person': [{'firstname': 'George', 'middlename': 'Gene', 'lastname': 'Gustines', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3a631d95-a4c2-52fc-b77b-e66dff13171a', 'word_count': 131, 'uri': 'nyt://article/3a631d95-a4c2-52fc-b77b-e66dff13171a'}, {'abstract': 'Making the Volt charge smarter and cleaner, an online retailer gets five-star reviews for $2 a star, using symptom checklists to sell drugs and other consumer-focused news from The New York Times.', 'web_url': 'https://bucks.blogs.nytimes.com/2012/01/27/friday-reading-teaching-the-volt-to-charge-smarter-and-cleaner/', 'snippet': 'Making the Volt charge smarter and cleaner, an online retailer gets five-star reviews for $2 a star, using symptom checklists to sell drugs and other consumer-focused news from The New York Times.', 'lead_paragraph': 'A variety of consumer-focused articles appears daily in The New York Times and on our blogs. Each weekday morning, we gather them together here so you can quickly scan the news that could hit you in your wallet.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Friday Reading: Teaching the Volt to Charge Smarter and Cleaner', 'kicker': 'Bucks', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-01-27T14:12:01+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Your Money', 'byline': {'original': 'By Ann Carrns', 'person': [{'firstname': 'Ann', 'middlename': None, 'lastname': 'Carrns', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/63e41677-d239-57a7-8f49-226d4b9a13d1', 'word_count': 105, 'uri': 'nyt://article/63e41677-d239-57a7-8f49-226d4b9a13d1'}, {'abstract': 'Jonathan “Jack” Idema was pure trouble, and his death brings us closer to the end of a weird era when sociopathic frauds could be taken seriously just because they looked the military part.', 'web_url': 'https://latitude.blogs.nytimes.com/2012/01/27/jonathan-jack-idema-dies-in-obscurity/', 'snippet': 'Jonathan “Jack” Idema was pure trouble, and his death brings us closer to the end of a weird era when sociopathic frauds could be taken seriously just because they looked the military part.', 'lead_paragraph': 'FAYETTEVILLE, North Carolina — The War on Terror hasn’t produced many clear signs of progress in the last decade. But here’s an unequivocal one: with each year, we’ve heard a little less about Jonathan “Jack” Idema, the self-styled mercenary who surfaced in Afghanistan in late 2001, fed credulous journalists lies about his work with the Northern Alliance, and later was convicted by an Afghan court of running his own private torture chamber in a Kabul cellar. (He claimed he was working for the U.S. government to hunt terrorists, but in fact he seems to have been kidnapping his “suspects” almost randomly off the street, and choosing them partly by beard length.) Hamid Karzai pardoned him in 2007 as part of a general amnesty.After his time in Afghanistan, he sank deeper and deeper into obscurity. Last weekend he died from AIDS complications in Mexico at the age of 55.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Death of a Poser', 'kicker': 'Latitude', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Afghanistan War (2001- )', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Decisions and Verdicts', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Frauds and Swindling', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Kidnapping', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Terrorism', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Karzai, Hamid', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Northern Alliance', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'United States Army', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'AFGHANISTAN', 'rank': 11, 'major': 'N'}, {'name': 'glocations', 'value': 'Kabul (Afghanistan)', 'rank': 12, 'major': 'N'}, {'name': 'glocations', 'value': 'North Carolina', 'rank': 13, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 14, 'major': 'N'}], 'pub_date': '2012-01-27T14:14:17+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Graeme Wood', 'person': [{'firstname': 'Graeme', 'middlename': None, 'lastname': 'Wood', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ee26095c-23c1-58f6-8cab-067fff0770fd', 'word_count': 576, 'uri': 'nyt://article/ee26095c-23c1-58f6-8cab-067fff0770fd'}, {'abstract': 'Many Pakistani public figures find their morality impugned by a supercharged media culture, yet their credibility somehow remains largely intact.', 'web_url': 'https://latitude.blogs.nytimes.com/2012/01/27/dishonorable-acts-of-pakistani-public-figures/', 'snippet': 'Many Pakistani public figures find their morality impugned by a supercharged media culture, yet their credibility somehow remains largely intact.', 'lead_paragraph': 'KARACHI, Pakistan — In recent years, Pakistanis have been increasingly consumed by the concept of ghairat, or honor. An urge to defend the nation’s ghairat — a blend of intense patriotism and heightened religiosity — underpins the country’s soaring anti-Americanism and growing calls for the Islamization of society. It also drives the sanctimonious diatribes of politicians and talk show hosts who dominate Pakistan’s public sphere.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Question of Honor', 'kicker': 'Latitude', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Assassinations and Attempted Assassinations', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Ethics (Personal)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Video Recordings and Downloads', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Bhutto, Benazir', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Haqqani, Husain', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Ijaz, Mansoor', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Sharif, Nawaz', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Taseer, Salman', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Europe', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'Karachi (Pakistan)', 'rank': 11, 'major': 'N'}, {'name': 'glocations', 'value': 'Pakistan', 'rank': 12, 'major': 'N'}, {'name': 'glocations', 'value': 'Punjab (Pakistan)', 'rank': 13, 'major': 'N'}, {'name': 'glocations', 'value': 'Washington (DC)', 'rank': 14, 'major': 'N'}], 'pub_date': '2012-01-27T14:16:52+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Huma Yusuf', 'person': [{'firstname': 'Huma', 'middlename': None, 'lastname': 'Yusuf', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2594c924-70df-5839-aa6