rance-pic/03france-pic-articleLarge.jpg', 'height': 370, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/03/business/03france-pic/03france-pic-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 370}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/03/business/03france-pic/03france-pic-jumbo.jpg', 'height': 878, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/03/business/03france-pic/03france-pic-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/03/business/03france-pic/03france-pic-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'In Euro Zone’s Crisis, Technocrat in Paris Works Behind the Scenes', 'kicker': None, 'content_kicker': None, 'print_headline': 'In Euro Zone’s Crisis, Technocrat in Paris Works Behind the Scenes', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Sarkozy, Nicolas', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'European Sovereign Debt Crisis (2010- )', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'France', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Merkel, Angela', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-01-02T19:55:18+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Global Business', 'byline': {'original': 'By Liz Alderman', 'person': [{'firstname': 'Liz', 'middlename': None, 'lastname': 'Alderman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a6559821-3502-57c7-b549-b41fc5c5c1b5', 'word_count': 1476, 'uri': 'nyt://article/a6559821-3502-57c7-b549-b41fc5c5c1b5'}, {'abstract': 'The chef, Rick Bayless, will serve a Mexican-influenced dinner with wine pairings as he tries to cook his way into the heart of an unhappy woman in “Cascabel.”', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/01/02/a-celebrity-chef-will-take-to-the-chicago-stage/', 'snippet': 'The chef, Rick Bayless, will serve a Mexican-influenced dinner with wine pairings as he tries to cook his way into the heart of an unhappy woman in “Cascabel.”', 'lead_paragraph': 'The celebrity chef Rick Bayless will take to the Chicago stage this March. Collaborating with the Lookingglass Theater Company, Mr. Bayless will serve the audience a Mexican-influenced dinner with wine pairings as he tries to cook his way into the heart of an unhappy woman in “Cascabel.” Mr. Bayless created the show with Tony Hernandez and Heidi Stillman, who are directing it together. Promoted as “a theatrical feast,” the show will run from March 21 through April 22 at the Water Tower Pumping Station. Tickets — for $200 to $225 — include dinner.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Celebrity Chef Will Take to the Chicago Stage', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bayless, Rick', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Lookingglass Theater Co', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Chicago (Ill)', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-01-02T20:01:51+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Robin Pogrebin', 'person': [{'firstname': 'Robin', 'middlename': None, 'lastname': 'Pogrebin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cff1255f-1edb-5996-a049-f5c7d224df51', 'word_count': 93, 'uri': 'nyt://article/cff1255f-1edb-5996-a049-f5c7d224df51'}, {'abstract': '“Confessions of a Surgeon,” by Dr. Paul A. Ruggieri, and “The Patient’s Checklist,” by Elizabeth Bailey, are guidebooks to clarify customs and keep you out of trouble when you receive care in a hospital.', 'web_url': 'https://www.nytimes.com/2012/01/03/health/views/two-choices-for-the-best-read-for-a-hospital-stay.html', 'snippet': '“Confessions of a Surgeon,” by Dr. Paul A. Ruggieri, and “The Patient’s Checklist,” by Elizabeth Bailey, are guidebooks to clarify customs and keep you out of trouble when you receive care in a hospital.', 'lead_paragraph': 'What is the best reading material for a stay in the hospital: the book that will lift you far away from that miserable place, or the one that will plunge you deeper in, a kind of guidebook to clarify local customs and keep you out of trouble?', 'print_section': 'D', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/03/science/03ZUGE1/03ZUGE1-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Two Choices for Best Bedside Read in the Hospital', 'kicker': 'Books', 'content_kicker': None, 'print_headline': 'Two Choices for Best Bedside Read in the Hospital', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Surgery and Surgeons', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Malpractice', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Poetry and Poets', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Medicine and Health', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Hospitals', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Doctors', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-01-02T20:05:22+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Health', 'subsection_name': 'Views', 'byline': {'original': 'By Abigail Zuger, M.D', 'person': [{'firstname': 'Abigail', 'middlename': None, 'lastname': 'Zuger', 'qualifier': 'M.D', 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/e34641d2-c203-56f3-b253-ef35eb80ddae', 'word_count': 913, 'uri': 'nyt://article/e34641d2-c203-56f3-b253-ef35eb80ddae'}, {'abstract': 'Tintin has been around for decades as a cartoon character, but only through the new Steven Spielberg movie has he been widely introduced to Americans.', 'web_url': 'https://www.nytimes.com/2012/01/03/movies/tintin-is-a-new-breed-of-comic-book-hero-for-most-americans.html', 'snippet': 'Tintin has been around for decades as a cartoon character, but only through the new Steven Spielberg movie has he been widely introduced to Americans.', 'lead_paragraph': 'Steven Spielberg’s new film “The Adventures of Tintin” took in roughly $12 million during the past holiday weekend. This is not tremendous box office (“Mission: Impossible — Ghost Protocol,” by contrast, exceeded $30 million), but it’s more than some skeptics had predicted for a movie about a cartoon character who, though beloved in most parts of the world, is practically unknown in the United States. Charles de Gaulle once declared that in terms of international fame, Tintin was his only rival. We, on the other hand, don’t even know how to say his name right. In the original cartoons Tintin, the creation of the Belgian artist Hergé, spoke French, and thus his name should be pronounced “Tanh-tanh,” and not, as the movie has it, to rhyme with “win win.”', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': '