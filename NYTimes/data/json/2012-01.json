alifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b5362d82-fcac-592e-baa5-f50ee8a5e4a3', 'word_count': 901, 'uri': 'nyt://article/b5362d82-fcac-592e-baa5-f50ee8a5e4a3'}, {'abstract': 'An enigmatic player for San Francisco for six seasons, Vernon Davis lived up to his star potential against the New Orleans Saints.', 'web_url': 'https://www.nytimes.com/2012/01/16/sports/football/vernon-davis-channeled-emotion-into-win-for-49ers.html', 'snippet': 'An enigmatic player for San Francisco for six seasons, Vernon Davis lived up to his star potential against the New Orleans Saints.', 'lead_paragraph': 'SAN FRANCISCO — There was Mike Singletary in October 2008, after his first game as the San Francisco 49ers’ coach, after he banished the enigmatic tight end Vernon Davis to the locker room long before defeat became official.', 'print_section': 'D', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Once-Banished 49ers Tight End Grabs Moment', 'kicker': None, 'content_kicker': None, 'print_headline': 'Once-Banished 49ers Tight End Grabs Moment', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Playoff Games', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New Orleans Saints', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Davis, Vernon', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'San Francisco 49ers', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-01-16T01:35:32+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Greg Bishop', 'person': [{'firstname': 'Greg', 'middlename': None, 'lastname': 'Bishop', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization':