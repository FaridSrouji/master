zine', 'section_name': 'Magazine', 'byline': {'original': 'By H. Lee Kagan', 'person': [{'firstname': 'H.', 'middlename': 'Lee', 'lastname': 'Kagan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1d26a1c0-3b36-5af3-a044-753954b472dc', 'word_count': 758, 'uri': 'nyt://article/1d26a1c0-3b36-5af3-a044-753954b472dc'}, {'abstract': 'Like a 3-D take on Jackson Pollock, the latest work by the artist Martin Klimas begins with splatters of paint over the diaphragm of a speaker.', 'web_url': 'https://www.nytimes.com/interactive/2012/01/15/magazine/painting-with-sound.html', 'snippet': 'Like a 3-D take on Jackson Pollock, the latest work by the artist Martin Klimas begins with splatters of paint over the diaphragm of a speaker.', 'lead_paragraph': 'Like a 3-D take on Jackson Pollock, the latest work by the artist Martin Klimas begins with splatters of paint over the diaphragm of a speaker.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Painting With Sound', 'kicker': 'Look', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Paint', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-13T15:16:57+0000', 'document_type': 'multimedia', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/0e35d25d-9d0c-5671-9c59-2ed9d6cf8f4a', 'word_count': 0, 'uri': 'nyt://interactive/0e35d25d-9d0c-5671-9c59-2ed9d6cf8f4a'}, {'abstract': 'A sampling of National Football League face masks.', 'web_url': 'https://www.nytimes.com/2012/01/15/magazine/sampling-of-national-football-league-face-masks.html', 'snippet': 'A sampling of National Football League face masks.', 'lead_paragraph': 'Schutt OPO