.jpg', 'xlargewidth': 600, 'xlargeheight': 349}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/06/world/06iraq2/06iraq2-jumbo.jpg', 'height': 713, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/06/world/06iraq2/06iraq2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/06/world/06iraq2/06iraq2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Explosions Across Iraq Kill Dozens Amid Political Crisis', 'kicker': None, 'content_kicker': None, 'print_headline': 'Attacks on Shiites in Iraq Kill More Than 50', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Iraq', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Baghdad (Iraq)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Terrorism', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Bombs and Explosives', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Sadr City (Iraq)', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-01-05T07:42:49+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Michael S. Schmidt', 'person': [{'firstname': 'Michael', 'middlename': 'S.', 'lastname': 'Schmidt', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4bc3dcd5-fd39-5ba9-aa9b-eca28437ee14', 'word_count': 659, 'uri': 'nyt://article/4bc3dcd5-fd39-5ba9-aa9b-eca28437ee14'}, {'abstract': 'See what you know about the news of the day.', 'web_url': 'https://learning.blogs.nytimes.com/2012/01/05/news-quiz-jan-5-2012/', 'snippet': 'See what you know about the news of the day.', 'lead_paragraph': 'See what you know about the news below. To prepare, you might scan the articles or summaries on today’s paper.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'News Quiz | Jan. 5, 2012', 'kicker': 'The Learning Network', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-01-05T08:07:00+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By Tiffany Frasier', 'person': [{'firstname': 'Tiffany', 'middlename': None, 'lastname': 'Frasier', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7ed69b49-cc07-59e9-8f45-109230cc8c9e', 'word_count': 20, 'uri': 'nyt://article/7ed69b49-cc07-59e9-8f45-109230cc8c9e'}, {'abstract': 'Taliban insurgents claimed on Thursday to have executed 15 paramilitary troops who were kidnapped from northwestern Pakistan last month.', 'web_url': 'https://www.nytimes.com/2012/01/06/world/asia/insurgents-say-they-executed-15-kidnapped-pakistani-soldiers.html', 'snippet': 'Taliban insurgents claimed on Thursday to have executed 15 paramilitary troops who were kidnapped from northwestern Pakistan last month.', 'lead_paragraph': 'ISLAMABAD, Pakistan — Taliban insurgents executed 15 security soldiers who had been recently kidnapped and dumped their bodies on a hilltop in northwestern Pakistan on Thursday, in retaliation for the killing of a militant commander by government forces, government and military officials said.', 'print_section': 'A', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/06/world/pakistan/pakistan-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/