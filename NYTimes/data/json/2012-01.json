ce': 'The New York Times', 'multimedia': [], 'headline': {'main': "Teachers' Union Uninvited City From Joint Training Sessions", 'kicker': 'SchoolBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-01-20T13:10:04+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By ANNA M. PHILLIPS', 'person': [{'firstname': 'Anna', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/40664722-c659-5438-bbe4-45a0f2944deb', 'word_count': 0, 'uri': 'nyt://article/40664722-c659-5438-bbe4-45a0f2944deb'}, {'abstract': 'The Academy of Motion Picture Arts and Sciences often seems to get it wrong when it comes to nominating documentaries, favoring the feel good over the hard hitting.', 'web_url': 'https://www.nytimes.com/2012/01/22/movies/awardsseason/why-the-academy-seems-to-get-documentaries-wrong.html', 'snippet': 'The Academy of Motion Picture Arts and Sciences often seems to get it wrong when it comes to nominating documentaries, favoring the feel good over the hard hitting.', 'lead_paragraph': 'AROUND the parties and panels of Amsterdam’s international documentary festival in November there seemed to be less focus on the hundreds of films in the festival than on 15 that weren’t: namely those on the Oscar semifinalist shortlist, which is released each fall by the Academy of Motion Picture Arts and Sciences. Once again it stirred up trouble.', 'print_section': 'AR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/22/arts/22DOCS1_SPAN/22DOCS1-articleLarge.jpg', 'height': 340, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/22/arts/22DOCS1_SPAN/