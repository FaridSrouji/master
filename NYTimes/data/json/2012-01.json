e': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mountains', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Dickey, R A', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Mets', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-01-05T22:30:36+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By R.A. Dickey', 'person': [{'firstname': 'R.', 'middlename': 'A.', 'lastname': 'Dickey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/16cc0ab6-c3a9-529e-a3ec-9c1b96d66da3', 'word_count': 655, 'uri': 'nyt://article/16cc0ab6-c3a9-529e-a3ec-9c1b96d66da3'}, {'abstract': '“The Love Life of the Spumifers,” at Ubu Gallery, is an exhibition of erotic yet comical works from Georges Hugnet, a minor but busy player in the interwar Parisian art scene.', 'web_url': 'https://www.nytimes.com/2012/01/06/arts/design/georges-hugnets-spumifers-at-ubu-gallery-review.html', 'snippet': '“The Love Life of the Spumifers,” at Ubu Gallery, is an exhibition of erotic yet comical works from Georges Hugnet, a minor but busy player in the interwar Parisian art scene.', 'lead_paragraph': 'Stop by Ubu Gallery this month and you may find yourself asking, “How did I not know about this guy?” Unless you are exceptionally well informed about the history of French Surrealism, the name Georges Hugnet (1906-1974) may have slipped your notice. It did mine, and the gallery’s exhibition of his collages and altered postcards comes as a delightful revelation. ', 'print_section': 'C', 'print_page': '29', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/06/arts/06HUGNET/HUGNET-jumbo.jpg', 'height': 1024, '