': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Thailand', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Computer Chips', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Yingluck Shinawatra', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-01-20T12:25:57+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Global Business', 'byline': {'original': 'By Thomas Fuller', 'person': [{'firstname': 'Thomas', 'middlename': None, 'lastname': 'Fuller', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b03014b2-877a-5538-b440-518f96cd1e79', 'word_count': 976, 'uri': 'nyt://article/b03014b2-877a-5538-b440-518f96cd1e79'}, {'abstract': 'The digital age has changed more than how we learn. It’s changed what we need to learn.', 'web_url': 'https://www.nytimes.com/2012/01/22/education/edlife/the-21st-century-education.html', 'snippet': 'The digital age has changed more than how we learn. It’s changed what we need to learn.', 'lead_paragraph': 'A PARADOX of American higher education is this: The expectations of leading universities do much to define what secondary schools teach, and much to establish a template for what it means to be an educated man or woman. College campuses are seen as the source for the newest thinking and for the generation of new ideas, as society’s cutting edge.', 'print_section': 'ED', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/22/education/edl-22digital-t_CA0/edl-22digital-t_CA0-jumbo.jpg', 'height': 1024, 'width': 982, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'ur