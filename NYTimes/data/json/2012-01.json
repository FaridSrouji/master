c9-2485-52b7-9086-24090f19bd7b', 'word_count': 2582, 'uri': 'nyt://article/9abf54c9-2485-52b7-9086-24090f19bd7b'}, {'abstract': 'A respected polling agency connected to the Russian government announced Friday that the popularity of Prime Minister Vladimir V. Putin had reversed its slow decline.', 'web_url': 'https://www.nytimes.com/2012/01/21/world/europe/russia-putins-popularity-inches-upward.html', 'snippet': 'A respected polling agency connected to the Russian government announced Friday that the popularity of Prime Minister Vladimir V. Putin had reversed its slow decline.', 'lead_paragraph': ' A respected polling agency connected to the Russian government announced Friday that the popularity of Prime Minister Vladimir V. Putin had reversed its slow decline, rising above 50 percent for the first time in weeks. The news comes just over a month before presidential elections that Mr. Putin is widely expected to win. The polling agency, VTsIOM, put Mr. Putin’s rating at 52 percent as of Jan. 14. He remains Russia’s most popular politician, but his decision to seek the presidency again after four years as prime minister set off huge anti-Kremlin protests in December. In another survey released this month by the Levada Center, a prominent independent polling agency, 36 percent of Russians said they would vote for Mr. Putin, more than would support any of his opponents, but not enough for him to win the election in the first round. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Russia: Putin’s Popularity Inches Upward', 'kicker': 'World Briefing | Europe', 'content_kicker': None, 'print_headline': 'Russia: Putin’s Popularity Inches Upward', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Politics and Government', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Polls and Public Opinion', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Putin, Vladimir V', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Russia', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-01-21T05:54:21+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Michael Schwirtz', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Schwirtz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/f412f3ce-2f6f-5d03-9c63-fcd842d6637e', 'word_count': 144, 'uri': 'nyt://article/f412f3ce-2f6f-5d03-9c63-fcd842d6637e'}, {'abstract': 'A guide to cultural and recreational events in Connecticut.', 'web_url': 'https://www.nytimes.com/2012/01/22/nyregion/events-in-connecticut.html', 'snippet': 'A guide to cultural and recreational events in Connecticut.', 'lead_paragraph': 'A guide to cultural and recreational events in Connecticut. Items for the calendar should be sent at least three weeks in advance to ctcal@nytimes.com.', 'print_section': 'CT', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Events in Connecticut', 'kicker': 'Calendar', 'content_kicker': None, 'print_headline': 'Connecticut', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Culture (Arts)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Connecticut', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-21T06:01:54+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/9ab42e35-0a65-5b7f-8386-3de54bde26a4', 'word_count': 4550, 'uri': 'nyt://article/9ab42e35-0a65-5b7f-8386-3de54bde26a4'}, {'abstract': 'A guide to cultural and recreational events on Long Island.', 'web_url': 'https://www.nytimes.com/2012/01/22/nyregion/events-on-lon