-b682-3b2c07a072bb', 'word_count': 891, 'uri': 'nyt://article/6565ab9e-4cfb-5680-b682-3b2c07a072bb'}, {'abstract': 'An employee at a Sprint store in Flatbush was killed while working after a dispute with a man who might have been a former employee, the police said.', 'web_url': 'https://www.nytimes.com/2012/01/15/nyregion/employee-stabbed-to-death-at-sprint-store-in-brooklyn.html', 'snippet': 'An employee at a Sprint store in Flatbush was killed while working after a dispute with a man who might have been a former employee, the police said.', 'lead_paragraph': 'An employee at a Sprint cellphone store in Flatbush, Brooklyn, was stabbed to death while working on Saturday afternoon after a dispute with a man who might have been a former Sprint employee, the police said. ', 'print_section': 'A', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Employee Is Stabbed to Death at a Cellphone Store in Brooklyn', 'kicker': None, 'content_kicker': None, 'print_headline': 'Man Killed In Stabbing At a Store In Brooklyn', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Flatbush (NYC)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Sprint Nextel Corporation', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-01-15T04:08:07+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Nate Schweber and Sarah Maslin Nir', 'person': [{'firstname': 'Nate', 'middlename': None, 'lastname': 'Schweber', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Sarah', 'middlename': 'Maslin', 'lastname': 'Nir', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/91cb5c9a-c2d1-5523-98a7-6551961dd30f', 'word_count': 436, 'uri': 'nyt://article/91cb5c9a-c2d1-5523-98a7-6551961dd30f'}, {'abstract': 'Tom Brady’s performance in New England’s playoff victory served as a reminder that he possesses the accuracy and acumen of which championships are made.', 'web_url': 'https://www.nytimes.com/2012/01/15/sports/football/tom-brady-leads-patriots-to-win-over-tim-tebow-and-broncos.html', 'snippet': 'Tom Brady’s performance in New England’s playoff victory served as a reminder that he possesses the accuracy and acumen of which championships are made.', 'lead_paragraph': 'FOXBOROUGH, Mass. — This season, and most especially in the days leading up to the New England Patriots’ playoff game against the Denver Broncos, Tim Tebow — the off-speed passer, the media phenomenon, the cultural touchstone — was at the center of an extraordinary, endless-loop conversation, about the nature of offensive football and, to the consternation of many, the convergence of sports and religion.', 'print_section': 'SP', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/15/sports/patriots3/patriots3-articleLarge.jpg', 'height': 370, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/15/sports/patriots3/patriots3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 370}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/15/sports/patriots3/patriots3-jumbo.jpg', 'height': 1024, 'width': 936, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/15/sports/patriots3/patriots3-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/15/sports/patriots3/patriots3-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'With Spotlight on Tebow, Brady Stars', 'kicker': 'New England 45, Denver 10', 'content_kicker': None, 'print_headline': 'With Spotlight on Tebow, Brady Stars', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'New England Patriots', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Brady, Tom', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Tebow, Tim', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Denver Broncos', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Playoff Games', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-01-15T04:39:21+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Judy Battista', 'person': [{'firstname': 'Judy', 'middlename': None, 'lastname': 'Battista', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4e89900e-4dcc-56f1-acbd-ce795d0b0c18', 'word_count': 1106, 'uri': 'nyt://article/4e89900e-4dcc-56f1-acbd-ce795d0b0c18'}, {'abstract': 'Doug Wheeler, a founder of the so-called Light and Space movement, constructs his first Manhattan “infinity environment” at the David Zwirner gallery in Chelsea.', 'web_url': 'https://www.nytimes.com/2012/01/15/arts/design/doug-wheeler-builds-infinity-environment-at-david-zwirner.html', 'snippet': 'Doug Wheeler, a founder of the so-called Light and Space movement, constructs his first Manhattan “infinity environment” at the David Zwirner gallery in Chelsea.', 'lead_paragraph': 'THE artist Doug Wheeler tells two stories, both having to do with light, that go a long way toward explaining why he is so revered by many fellow artists — as a visionary and a relentlessly stubborn perfectionist — and also why his work has been seen by so few American artgoers over the last few decades, particularly those in New York.', 'print_section': 'AR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/15/arts/15WHEELER1_SPAN/15JPWHEELER1-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/15/arts/15WHEELER1_SPAN/15JPWHEELER1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/15/arts/15WHEELER1_SPAN/15JPWHEELER1-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/15/arts/15WHEELER1_SPAN/15JPWHEELER1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/15/arts/15WHEELER1_SPAN/15JPWHEELER1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Into the Heart of Lightness', 'kicker': None, 'content_kicker': None, 'print_headline': 'Into the Heart Of Lightness', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-01-15T05:10:21+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Randy Kennedy', 'person': [{'firstname': 'Randy', 'middlename': None, 'lastname': 'Kennedy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e275caa4-f0d9-5d8a-876d-b39e2a0908e9', '