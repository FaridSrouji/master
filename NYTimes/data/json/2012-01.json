/31primary2_cnd/31primary2_cnd-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/31/us/31primary2_cnd/31primary2_cnd-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/31/us/31primary2_cnd/31primary2_cnd-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/31/us/31primary2_cnd/31primary2_cnd-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/31/us/31primary2_cnd/31primary2_cnd-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Gingrich Stays Defiant in Face of Polls as Florida Votes', 'kicker': None, 'content_kicker': None, 'print_headline': 'Florida Polls Open as Gingrich Tries to Galvanize Conservatives', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Gingrich, Newt', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-31T14:00:26+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Trip Gabriel', 'person': [{'firstname': 'Trip', 'middlename': None, 'lastname': 'Gabriel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/676db240-127a-5da6-b6fc-09cfd011b3fc', 'word_count': 749, 'uri': 'nyt://article/676db240-127a-5da6-b6fc-09cfd011b3fc'}, {'abstract': 'Single-family home prices in the United States fell in November, a closely watched survey showed, putting the average price down to a level last seen in 2003.', 'web_url': 'https://www.nytimes.com/2012/02/01/business/economy/home-prices-decline-again.html', 'snippet': 'Single-family home prices in the United States fell in November, a closely watched survey showed, putting the average price down to a level last seen in 2003.', 'lead_paragraph': 'The American market for single-family homes continued to wobble, with prices declining again in November, nearly six years after they began to fall, a private report showed on Tuesday.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/02/01/business/01econ-span/01econ-span-jumbo.jpg', 'height': 634, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/02/01/business/01econ-span/01econ-span-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/02/01/business/01econ-span/01econ-span-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Home Prices Decline Again', 'kicker': None, 'content_kicker': None, 'print_headline': 'Home Prices Decline Again', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': "Standard & Poor's Case-Shiller Home Price Index", 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-31T14:11:49+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Motoko Rich', 'person': [{'firstname': 'Motoko', 'middlename': None, 'lastname': 'Rich', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8b8c27b9-2655-5c7d-9869-16bba4b814db', 'word_count': 363, 'uri': 'nyt://article/8b8c27b9-2655-5c7d-9869-16bba4b814db'}, {'abstract': 'A warehouse on President Street in the Gowanus section will start accepting unwanted electronics today.', 'web_url': 'https://green.blogs.nytimes.com/2012/01/31/an-e-waste-depot-for-brooklyn/', 'snippet': 'A warehouse on President Street in the Gowanus section will start accepting unwanted electronics today.', 'lead_paragraph': 'The Lower East Side Ecology Center in Manhattan, a longtime promoter of recycling and composting, is expanding operations by opening a new, permanent drop-off site for electronic waste in Brooklyn.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'An E-Waste Depot for Brooklyn', 'kicker': 'Green', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Electronics', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Recycling of Waste Materials', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Waste Materials and Disposal', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Lower East Side Ecology Center', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Brooklyn (NYC)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Manhattan (NYC)', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-01-31T14:17:08+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Science', 'subsection_name': 'Environment', 'byline': {'original': 'By Mireya Navarro', 'person': [{'firstname': 'Mireya', 'middlename': None, 'lastname': 'Navarro', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e62ec15d-d412-5f4f-8b6a-3a71b8bad9e8', 'word_count': 195, 'uri': 'nyt://article/e62ec15d-d412-5f4f-8b6a-3a71b8bad9e8'}, {'abstract': 'The Day: The city’s justification for manipulating a photo for a poster to raise awareness about diabetes raises its own set of questions.', 'web_url': 'https://cityroom.blogs.nytimes.com/2012/01/31/removing-a-truth-or-leg-for-the-greater-good/', 'snippet': 'The Day: The city’s justification for manipulating a photo for a poster to raise awareness about diabetes raises its own set of questions.', 'lead_paragraph': 'Many years ago, a New York journalist wrote scathingly about City Hall, but found himself criticized for having committed serious factual errors. We’ll leave his name out of this because he is no longer with us. De mortuis, and all that. The point is that when the lapses became known, he shrugged them off, saying they did not undermine “the larger truth” he had conveyed.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Removing a Truth, or Leg, for the Greater Good', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Diabetes', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Diet and Nutrition', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Berry, Cleo', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Health and Mental Hygiene Department (NYC)', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-01-31T14:18:58+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Clyde Haberman', 'person': [{'firstname': 'Clyde', 'middlename': None, 'lastname': 'Haberman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/95464c6f-aac0-50b6-a960-82f703b69c40', 'word_count': 741, 'uri': 'nyt://article/95464c6f-aac0-50b6-a960-82f703b69c40'}, {'abstract': 'A ranking of running backs for the Giants’ 1934, 1938, 1956, 1986, 1990, and 2007 N.F.L. Championship teams.', 'web_url': 'https://fifthdown.blogs.nytimes.com/2012/01/31/the-giants-history-countdown-running-back-tandems/', 'snippet': 'A ranking of running backs for the Giants’ 1934, 1938, 1956, 1986, 1990, and 2007 N.F.L. Championship teams.', 'lead_paragraph': 'Throughout the week, we will be ranking the Giants’ 1934, 1938, 1956, 1986, 1990 and 2007 N.F.L. championship teams in various categories. The 1920s teams are not included because of severe differences in the game and the league. In this installment, we rank the running back tandems, whether they are rotations, committees, or old-fashioned three-back attacks. For the teams of yesteryear, “tailbacks” who acted as de facto quarterbacks are counted in the mix.6. 1934 Giants: Harry Newman had a short, modestly distinguished career as a 179-pound A-formation tailback (by today’s standards, a Tebow). He led the league in nearly every passing category in 1933, but in 1934 he threw just one touchdown and 12 interceptions, statistics that were almost as bad then as they are today. Ken Strong was an All-Pro fullback/defensive back for both the Giants and the Staten Island Stapletons, then an N.F.L. team, and Strong rushed for 431 yards and 6 touchdowns. His best years were behind him by 1934, though he stayed with the Giants as a placekicker until after World War II. The third member of the backfield was Wee Willie Smith, who played just one season in the N.F.L. (He is not to be confused with the legendary basketball player of the same name.) You do not have to be an expert in 1930s football to realize that a backfield with one player who played just one season and another who played just three seasons belongs low on any all-time list.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Giants History Countdown: Running Back Tandems', 'kicker': 'The Fifth Down', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Barber, Tiki', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Bradshaw, Ahmad', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Danowski, Ed', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Droughns, Reuben', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Gifford, Frank', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Hampton, Rodney', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Hedgecock, Madison', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Jacobs, Brandon', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Meggett, Dave', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Morris, Joe', 'rank': 11, 'major': 'N'}, {'name': 'persons', 'value': 'Newman, Harry', 'rank': 12, 'major': 'N'}, {'name': 'persons', 'value': 'Parcells, Bill', 'rank': 13, 'major': 'N'}, {'name': 'persons', 'value': 'Smith, Willie', 'rank': 14, 'major': 'N'}, {'name': 'persons', 'value': 'Snee, Chris', 'rank': 15, 'major': 'N'}, {'name': 'persons', 'value': 'Strong, Ken', 'rank': 16, 'major': 'N'}, {'name': 'persons', 'value': 'Ward, Derrick', 'rank': 17, 'major': 'N'}, {'name': 'organizations', 'value': 'National Football League', 'rank': 18, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Giants', 'rank': 19, 'major': 'N'}], 'pub_date': '2012-01-31T14:19:30+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Mike Tanier', 'person': [{'firstname': 'Mike', 'middlename': None, 'lastname': 'Tanier', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f021ef25-5c6a-5080-a496-964d1dbd8e98', 'word_count': 953, 'uri': 'nyt://article/f021ef25-5c6a-5080-a496-964d1dbd8e98'}, {'abstract': 'Also, Ryan Seacrest strikes an investment deal with Clear Channel partners, and a shake-up at “The X Factor.”', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2012/01/31/the-breakfast-meeting-colbert-raises-1-million-and-obama-makes-news-on-google/', 'snippet': 'Also, Ryan Seacrest strikes an investment deal with Clear Channel partners, and a shake-up at “The X Factor.”', 'lead_paragraph': 'As Republicans in Florida vote for a presidential nominee, there were many signs of how the political system has changed – will continue changing – just as journalism and entertainment have. Some news on that front today:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Breakfast Meeting: Colbert Raises $1 Million, and Obama on Google Plus', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2008', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Colbert, Stephen', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Cowell, Simon', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Newsom, Gavin', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Scherzinger, Nicole', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Seacrest, Ryan', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Whitford, Bradley', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'Bain Capital', 'rank': 10, 'major': 'N'}, {'name': 'organizations', 'value': 'Google+', 'rank': 11, 'major': 'N'}, {'name': 'organizations', 'value': 'Square Inc', 'rank': 12, 'major': '