iew/08RIFKIND/08RIFKIND-jumbo.jpg', 'height': 1024, 'width': 723, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/08/books/review/08RIFKIND/08RIFKIND-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/08/books/review/08RIFKIND/08RIFKIND-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'The Morning After Mourning', 'kicker': None, 'content_kicker': None, 'print_headline': 'Turning Toward the Shore', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Rosenblatt, Roger', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Grief (Emotion)', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-06T17:06:03+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Donna Rifkind', 'person': [{'firstname': 'Donna', 'middlename': None, 'lastname': 'Rifkind', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/a160390c-27f5-5687-888c-631caca35278', 'word_count': 917, 'uri': 'nyt://article/a160390c-27f5-5687-888c-631caca35278'}, {'abstract': 'A posthumous memoir by the publishing giant who introduced the avant-garde to America.', 'web_url': 'https://www.nytimes.com/2012/01/08/books/review/the-tender-hour-of-twilight-by-richard-seaver-book-review.html', 'snippet': 'A posthumous memoir by the publishing giant who introduced the avant-garde to America.', 'lead_paragraph': 'In the winter of 1954 my wife, Barbara, and I spent a few weeks in a grand, gloomy Paris apartment amid scratched and faded 18th-century furniture and silken walls at 35 Rue de la Faisanderie, off Avenue Foch, a chic address. The apartment belonged to Doubleday & Company, my employer, and was used by the occasional sojourner from the New York office, though there was no Doubleday business in Paris to justify such luxury. At the age of 25 I was such a sojourner, rewarded for having created a successful new paperback format that would become the industry standard. In Paris I visited the offices of the great French publishing houses Gallimard, Plon and Hachette, and in the evening Barbara and I were treated to Krug and La Tâche at Le Grand Véfour and Chez Allard, where we chatted with our hosts about the Sartre-Camus quarrel, the emerging cold war and the calamity of Senator Joseph McCarthy. If Paris was the scene of a postwar literary revival, no one we met had heard of it. The writers I saw were displaced European intellectuals, former leftists now working secretly for the C.I.A.', 'print_section': 'BR', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/08/books/review/08EPSTEIN/08EPSTEIN-articleLarge.jpg', 'height': 379, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/08/books/review/08EPSTEIN/08EPSTEIN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 379}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/08/books/review/08EPSTEIN/08EPSTEIN-jumbo.jpg', 'height': 712, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/08/books/review/08EPSTEIN/08EPSTEIN-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/08/books/review/08EPSTEIN/08EPSTEIN-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'How to Be an Avant-Garde Publisher', 'kicker': None, 'content_kicker': None, 'print_headline': 'Within a Budding Grove', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Beckett, Samuel', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Grove Press', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Rosset, Barney', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Book Trade and Publishing', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-01-06T17:06:44+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Jason Epstein', 'person': [{'firstname': 'Jason', 'middlename': None, 'lastname': 'Epstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/dc2da61e-f286-551d-ba90-4d3b0c7ec66b', 'word_count': 1396, 'uri': 'nyt://article/dc2da61e-f286-551d-ba90-4d3b0c7ec66b'}, {'abstract': 'None of Hitler’s lieutenants did more to realize the Final Solution than Heinrich Himmler and Reinhard Heydrich.', 'web_url': 'https://www.nytimes.com/2012/01/08/books/review/books-about-heinrich-himmler-and-reinhard-heydrich-review.html', 'snippet': 'None of Hitler’s lieutenants did more to realize the Final Solution than Heinrich Himmler and Reinhard Heydrich.', 'lead_paragraph': 'In June 1942, Thomas Mann, who was living in exile in California, delivered a commentary on a German-language BBC radio program that decried the sanguinary actions of the Third Reich in avenging the assassination of the leading SS official Reinhard Heydrich in Prague. After Heydrich’s elaborate funeral ceremony at the new Reich Chancellery in Berlin, Hitler screamed at the Czech president, Emil Hacha, “Nothing can prevent me from deporting millions of Czechs if they do not wish for peaceful coexistence.” It wasn’t an idle threat. “Since the violent death of Heydrich,” Mann lamented, “terror is raging everywhere, in a more sickly, unrestrained fashion than ever before. . . . An entire town, that supposedly sheltered the perpetrators, is massacred and razed.” Indeed, to honor Heydrich and help create what Hitler referred to as “Germany’s Garden of Eden” in the East, the Nazis chose the code name “Aktion Reinhard” for the extermination of two million people, most of whom were Jewish, in the General Government of Poland by the end of 1943.', 'print_section': 'BR', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/08/books/review/08HEILBRUN/08HEILBRUN-jumbo.jpg', 'height': 1024, 'width': 917, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/08/books/review/08HEILBRUN/08HEILBRUN-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/08/books/review/08HEILBRUN/08HEILBRUN-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Himmler and Heydrich: Hitler’s Lieutenants', 'kicker': None, 'content_kicker': None, 'print_headline': 'Pathological Ambitions', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Germany', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Himmler, Heinrich', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'War Crimes, Genocide and Crimes Against Humanity', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Holocaust and the Nazi Era', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Hitler, Adolf', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-01-06T17:07:33+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Jacob Heilbrunn', 'person': [{'firstname': 'Jacob', 'middlename': None, 'lastname': 'Heilbrunn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/c9439bcd-9365-551f-95f8-31e3338ec4c3', 'word_count': 1698, 'uri': 'nyt://article/c9439bcd-9365-551f-95f8-31e3338ec4c3'}, {'abstract': 'Two writers question the rise of self-styled experts among evangelicals.', 'web_url': 'https://www.nytimes.com/2012/01/08/books/review/the-anointed-evangelical-truth-in-a-secular-age-by-randall-j-stephens-and-karl-w-giberson-book-review.html', 'snippet': 'Two writers question the rise of self-styled experts among evangelicals.', 'lead_paragraph': 'The central question of the culture wars that have raged since the 1970s is not whether abortion is murder or gay marriage a civil right, but whether the Enlightenment was a good thing. Many evangelical Americans think the answer is no, according to “The Anointed,” a field guide to the evangelical experts you haven’t heard of — but should. ', 'print_section': 'BR', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/08/books/review/08SUBWORTHEN/08SUBWORTHEN-articleLarge.jpg', 'height': 312, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/08/books/review/08SUBWORTHEN/08SUBWORTHEN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 312}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/08/books/review/08SUBWORTHEN/08SUBWORTHEN-jumbo.jpg', 'height': 532, 'width': 1024, 'subTy