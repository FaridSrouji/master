dline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Children and Childhood', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Parenting', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Sex Crimes', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-26T20:31:05+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': "By Kj Dell'Antonia", 'person': [{'firstname': 'Kj', 'middlename': None, 'lastname': "Dell'Antonia", 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b62e5f65-25fb-5d3d-a9f3-d6acb149782c', 'word_count': 778, 'uri': 'nyt://article/b62e5f65-25fb-5d3d-a9f3-d6acb149782c'}, {'abstract': 'At their annual retreat, House Democrats appeared to be buoyed by President Obama’s turn toward a populist confrontational approach to Republicans in Congress.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2012/01/26/house-democrats-embrace-obamas-newfound-combativeness/', 'snippet': 'At their annual retreat, House Democrats appeared to be buoyed by President Obama’s turn toward a populist confrontational approach to Republicans in Congress.', 'lead_paragraph': 'CAMBRIDGE, Md. – The on-again-off-again relationship between Barack Obama and House Democrats appears to be on again with the president’s turn toward a more populist, confrontational tone on the Republican Party. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'House Democrats Embrace Obama’s Newfound Combativeness', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-01-26T20:32:17+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Jonathan Weisman', 'person': [{'firstname': 'Jonathan', 'middlename': None, '