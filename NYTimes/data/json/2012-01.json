 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Restaurants', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-01-24T17:58:33+0000', 'document_type': 'multimedia', 'news_desk': 'Food', 'section_name': 'Food', 'subsection_name': 'Dining & Wine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/8446d3c0-59c7-5533-a9e3-623455cab454', 'word_count': 0, 'uri': 'nyt://slideshow/8446d3c0-59c7-5533-a9e3-623455cab454'}, {'abstract': 'Bi-Rite Market redesigned its Web site successfully, but could it be even better?', 'web_url': 'https://boss.blogs.nytimes.com/2012/01/24/the-difference-between-a-good-web-site-and-a-great-web-site/', 'snippet': 'Bi-Rite Market redesigned its Web site successfully, but could it be even better?', 'lead_paragraph': 'In last week’s post, we featured the Web site of Bi-Rite Market, an extremely popular San Francisco grocery. One year ago, Sam Mogannam, the market’s owner, redesigned the site and upgraded its social media efforts as part of an overall branding program. Mr. Mogannam reported that he believed the redesign of the site — which promotes the store but does not sell products online — resulted in a steep increase in visitors to the site and a 20 percent increase in the store’s sales.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Difference Between a Good Web Site and a Great Web Site', 'kicker': 'You&#039;re the Boss', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Food', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Shopping and Retail', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Small Busine