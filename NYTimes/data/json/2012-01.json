', 'print_section': 'D', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/09/sports/YJPALABAMA/YJPALABAMA-articleLarge.jpg', 'height': 371, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/09/sports/YJPALABAMA/YJPALABAMA-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 371}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/09/sports/YJPALABAMA/YJPALABAMA-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'With Family as Foundation, Alabama’s Richardson Perseveres', 'kicker': 'B.C.S. Championship ', 'content_kicker': None, 'print_headline': 'With Family as Foundation, Alabama’s Richardson Perseveres', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football (College)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Bowl Championship Series', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'College Athletics', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Richardson, Trent', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Smith, Emmitt', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Louisiana State University', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Alabama', 'rank': 8, 'major': 'N'}], 'pub_date': '2012-01-09T01:36:50+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'College Football', 'byline': {'original': 'By Greg Bishop', 'person': [{'firstname': 'Greg', 'middlename': None, 'lastname': 'Bishop', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_mate