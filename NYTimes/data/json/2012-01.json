imedia': [], 'headline': {'main': 'A Giants Postseason Specialty: Using Their Heads', 'kicker': 'The Fifth Down', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Giants', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'San Francisco 49ers', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-22T11:44:53+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Greg Hanlon', 'person': [{'firstname': 'Greg', 'middlename': None, 'lastname': 'Hanlon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/49e61e7d-5444-542f-a551-6e955cba1bad', 'word_count': 466, 'uri': 'nyt://article/49e61e7d-5444-542f-a551-6e955cba1bad'}, {'abstract': 'Competing paradigms have arisen in the Republican contest for how to interpret the evidence from polls, voting results and other indicators. And they come to profoundly different conclusions.', 'web_url': 'https://fivethirtyeight.blogs.nytimes.com/2012/01/22/did-gingrichs-win-break-the-rules/', 'snippet': 'Competing paradigms have arisen in the Republican contest for how to interpret the evidence from polls, voting results and other indicators. And they come to profoundly different conclusions.', 'lead_paragraph': 'During the Republican nominating contest, competing paradigms have arisen for how to interpret the evidence from polls, voting results and other tangible indicators of success or failure. The paradigms present profoundly different conclusions about the most likely outcome.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Did Gingrich’s Win Break the Paradigm?', 'kicker': 'FiveThirtyEight', 'content_kicker': None, 'print_headline': '', 'name': None,