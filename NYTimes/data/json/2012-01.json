s/2012/01/22/automobiles/22WHEEL1/22WHEEL1-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/22/automobiles/22WHEEL1/22WHEEL1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/22/automobiles/22WHEEL1/22WHEEL1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/22/automobiles/22WHEEL1/22WHEEL1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/22/automobiles/22WHEEL1/22WHEEL1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'To Be Cute as a Bug Isn’t Enough Anymore', 'kicker': 'Behind the Wheel | 2012 Volkswagen Beetle', 'content_kicker': None, 'print_headline': 'To Be Cute as a Bug Isn’t Enough Anymore', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Volkswagen A.G', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Automobiles', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-01-20T21:26:28+0000', 'document_type': 'article', 'news_desk': 'Automobiles', 'section_name': 'Automobiles', 'subsection_name': 'New Cars', 'byline': {'original': 'By Phil Patton', 'person': [{'firstname': 'Phil', 'middlename': None, 'lastname': 'Patton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/d8222612-db39-5cf1-91f8-96bcdb4069d9', 'word_count': 1475, 'uri': 'nyt://article/d8222612-db39-5cf1-91f8-96bcdb4069d9'}, {'abstract': 'Charles Isherwood talks about a new biography of Ben Jonson, the famous British playwright who was eventually eclipsed by Shakespeare.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/01/20/book-review-podcast-ben-jonson-in-and-out-of-shakespeares-shadow/', 'snippet': 'Charles Isherwood talks about a new biography of Ben Jonson, the famous British playwright who was eventually eclipsed by Shakespeare.', 'lead_paragraph': 'In the New York Times Book Review, Charles Isherwood reviews Ian Donaldson’s “Ben Jonson: A Life.” Jonson, a playwright and “Britain’s first literary celebrity,” was a contemporary of Shakespeare. In his book, Mr. Donaldson makes the case that Jonson was as central as Shakespeare to the development of the British theater. Though he was posthumously eclipsed by his fellow writer, Jonson was the more noticeable of the two while they lived. Mr. Isherwood writes:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Book Review Podcast: Ben Jonson, In and Out of Shakespeare’s Shadow', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Podcasts', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Isherwood, Charles', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Jonson, Ben', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Shakespeare, William', 'rank': 8, 'major': 'N'}], 'pub_date': '2012-01-20T21:29:25+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By John Williams', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Williams', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f8e51f74-92a0-5459-9e57-303530e864bc', 'word_count': 188, 'uri': 'nyt://article/f8e51f74-92a0-5459-9e57-303530e864bc'}, {'abstract': 'Jimmy Wales, the founder of Wikipedia, talks about his reaction to the protests against piracy bills, students complaining they couldn’t do their homework during the blackout and whether the site has a future as a political force.', 'web_url': 'https://bits.blogs.nytimes.com/2012/01/20/one-on-one-jimmy-wales-of-wikipedia/', 'snippet': 'Jimmy Wales, the founder of Wikipedia, talks about his reaction to the protests against piracy bills, students complaining they couldn’t do their homework during the blackout and whether the site has a future as a political force.', 'lead_paragraph': ' Wikipedia has been a household name for years. But when the site announced that it would black out its English-language site earlier this week in support of a Webwide protest against two antipiracy bills, it became a hot topic of conversation.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/20/technology/20bits-wales/20bits-wales-jumbo.jpg', 'height': 715, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'One on One: Jimmy Wales of Wikipedia', 'kicker': 'Bits', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Computers and the Internet', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Wales, Jimmy', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Wikipedia', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-20T21:31:10+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By Jenna Wortham', 'person': [{'firstname': 'Jenna', 'middlename': None, 'lastname': 'Wortham', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e885adb3-3ccb-5c6a-b80e-9205e2ef30c4', 'word_count': 642, 'uri': 'nyt://article/e885adb3-3ccb-5c6a-b80e-9205e2ef30c4'}, {'abstract': 'At the Detroit auto show this month, Volkswagen introduced the E-Bugster, a design study for an all-electric version.', 'web_url': 'https://www.nytimes.com/2012/01/22/automobiles/vw-e-bugster-a-beguiling-electric-diversion.html', 'snippet': 'At the Detroit auto show this month, Volkswagen introduced the E-Bugster, a design study for an all-electric version.', 'lead_paragraph': 'History suggests that the latest edition of the Beetle, like its predecessors, will spawn myriad variations. At the Detroit auto show this month, VW introduced the E-Bugster, a design study for an all-electric version.', 'print_section': 'AU', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/22/automobiles/22BUGSTER/22BUGSTER-jumbo.jpg', 'height': 714, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/22/automobiles/22BUGSTER/22BUGSTER-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/22/automobiles/22BUGSTER/22BUGSTER-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Beguiling Electric Diversion', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Beguiling Electric Diversion', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Automobiles', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Volkswagen A.G', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Electric and Hybrid Vehicles', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'North American International Auto Show', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-01-20T21:32:12+0000', 'document_type': 'article', 'news_desk': 'Automobiles', 'section_name': 'Automobiles', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a5d6d243-32bd-5056-93b3-402bf3cfce83', 'word_count': 57, 'uri': 'nyt://article/a5d6d243-32bd-5056-93b3-402bf3cfce83'}, {'abstract': 'JPMorgan Chase has hired Marc Granetz, a senior banker at Credit Suisse, to spearhead an internal push to improve the firm’s own financial strength and strategy.', 'web_url': 'https://dealbook.nytimes.com/2012/01/20/jpmorgan-hires-credit-suisses-granetz-to-lead-finance-initiative/', 'snippet': 'JPMorgan Chase has hired Marc Granetz, a senior banker at Credit Suisse, to spearhead an internal push to improve the firm’s own financial strength and strategy.', 'lead_paragraph': 'JPMorgan Chase has hired Marc Granetz, until last month a senior banking executive at Credit Suisse, to spearhead an internal push to improve the firm’s own financial strength and strategy, the bank announced in an internal memorandum on Friday.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'JPMorgan Hires Credit Suisse’s Granetz to Lead Finance Initiative', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Credit Suisse Group A.G', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'JPMorgan Chase & Company', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-01-20T21:33:24+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Michael J. de la Merced', 'person': [{'firstname': 'Michael', 'middlename': 'J.', 'lastname': 'de la Merced', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f1522de0-837a-58cf-8b13-946ba0fd03c3', 'word_count': 401, 'uri': 'nyt://article/f1522de0-837a-58cf-8b13-946ba0fd03c3'}, {'abstract': 'Bucks readers tell of their own experiences with a type of insurance — called force-placed — that mortgage lenders are sometimes forcing homeowners to buy.', 'web_url': 'https://bucks.blogs.nytimes.com/2012/01/20/an-often-painful-lesson-in-insurance/', 'snippet': 'Bucks readers tell of their own experiences with a type of insurance — called force-placed — that mortgage lenders are sometimes forcing homeowners to buy.', 'lead_paragraph': 'Paul Sullivan writes this week in his Wealth Matters column about force-placed insurance — something that most homeowners don’t know about until their mortgage lender sends them a letter telling them they need it. If the homeowners don’t act quickly, the lender will buy the insurance for them, almost always at a price that’s a lot higher than the market rate.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'An Often-Painful Lesson in Insurance', 'kicker': 'Bucks', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Insurance', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mortgages', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-01-20T21:35:26+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Your Money', 'byline': {'original': 'By Bucks Editors', 'person': [{'firstname': 'Bucks', 'middlename': None, 'lastname': 'Editors', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8cb381e8-751d-59d1-ab5c-064c81c1ed51', 'word_count': 138, 'uri': 'nyt://article/8cb381e8-751d-59d1-ab5c-064c81c1ed51'}, {'abstract': 'The Pistons, off to a bad start, need Austin Daye to shoot more from the perimeter.', 'web_url': 'https://offthedribble.blogs.nytimes.com/2012/01/20/pistons-to-daye-please-dont-take-the-ball-to-the-basket/', 'snippet': 'The Pistons, off to a bad start, need Austin Daye to shoot more from the perimeter.', 'lead_paragraph': 'The Detroit Pistons have one of the worst offenses in the N.B.A. The ball never seems to get to the players it should, the shots seem to go up before a quality opening is actually created and the team as a whole stumbles into an alarming number of miscues. It’s no trick of scheduling that lost Detroit 12 of its first 15 games, as the inability to score in any kind of efficient or consistent manner has been a big problem – and sadly, a big problem among many – for the Pistons thus far.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Pistons to Daye: Please Don’t Take the Ball to the Basket', 'kicker': 'Off the Dribble', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-01-20T21:36:43+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Pro Basketball', 'byline': {'original': 'By ROB MAHONEY', 'person': [{'firstname': 'Rob', 'middlename': None, 'lastname': 'MAHONEY', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dde3fc98-0659-5bc7-a4a6-4fa75a0a5f64', 'word_count': 783, 'uri': 'nyt://article/dde3fc98-0659-5bc7-a4a6-4fa75a0a5f64'}, {'abstract': 'Roasting a whole fish is not much harder than cooking filets, but the flavor is much more satisfying.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2012/01/20/fish-without-the-fear/', 'snippet': 'Roasting a whole fish is not much harder than cooking filets, but the flavor is much more satisfying.', 'lead_paragraph': 'In this week’s column, I roast a whole fish. If it sounds familiar it’s because we posted a video of the process last winter. Here it is again, and it may help flesh out the recipe if you have any questions about the techniques.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Fish Without the Fear', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'prin