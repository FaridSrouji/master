s/FALL/FALL-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 368}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/20/arts/FALL/FALL-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/20/arts/FALL/FALL-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/20/arts/FALL/FALL-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Sniffing and Pinching Help Her Deal With Her Grief', 'kicker': "Theater Review | 'The Fall to Earth'", 'content_kicker': None, 'print_headline': 'Sniffing and Pinching Help Her Deal With Her Grief', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Brancato, Joe', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-01-19T22:39:14+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Theater', 'subsection_name': 'Theater Reviews', 'byline': {'original': 'By Eric Grode', 'person': [{'firstname': 'Eric', 'middlename': None, 'lastname': 'Grode', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/4c8fe5b6-f0f1-5af5-9408-e090397edd14', 'word_count': 335, 'uri': 'nyt://article/4c8fe5b6-f0f1-5af5-9408-e090397edd14'}, {'abstract': 'Performing with the New York Philharmonic, Lang Lang played Bartok’s technically demanding Piano Concerto No. 2 with uncanny ease and exuberance.', 'web_url': 'https://www.nytimes.com/2012/01/20/arts/music/lang-langs-bartok-with-the-new-york-philharmonic-review.html', 'snippet': 'Performing with the New York Philharmonic, Lang Lang played Bartok’s technically demanding Piano Concerto No. 2 with uncanny ease and exuberance.', 'lead_paragraph': 'The superstar pianist Lang Lang may shamelessly cultivate a flamboyant persona. And he has been criticized widely for exaggerated expressivity. Still, no fair-minded person can deny that Mr. Lang has stupendous technique and keen musical instincts.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/20/arts/20LANG2_SPAN/JPLANG1-articleLarge.jpg', 'height': 377, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/20/arts/20LANG2_SPAN/JPLANG1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 377}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/20/arts/20LANG2_SPAN/JPLANG1-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/20/arts/20LANG2_SPAN/JPLANG1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/20/arts/20LANG2_SPAN/JPLANG1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Meeting Complex Bartok With Ease and Imagination', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Meeting Complex Bartok With Ease and Imagination', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Lang Lang', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Philharmonic', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-01-19T22:41:13+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Anthony Tommasini', 'person': [{'firstname': 'Anthony', 'middlename': None, 'lastname': 'Tommasini', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/f2bdf97d-b800-51bb-bbb7-8b88709c4cd0', 'word_count': 620, 'uri': 'nyt://article/f2bdf97d-b800-51bb-bbb7-8b88709c4cd0'}, {'abstract': '“Rembrandt’s World” at the Morgan Library & Museum has very few Rembrandts, but the show makes up for what it lacks in star power.', 'web_url': 'https://www.nytimes.com/2012/01/20/arts/design/rembrandts-world-at-the-morgan-library-museum-review.html', 'snippet': '“Rembrandt’s World” at the Morgan Library & Museum has very few Rembrandts, but the show makes up for what it lacks in star power.', 'lead_paragraph': 'You won’t see much of Rembrandt in “Rembrandt’s World: Dutch Drawings From the Clement C. Moore Collection,” at the Morgan Library & Museum. This exhibition of about 90 works on paper, all promised gifts to the Morgan, includes just four drawings attributed to that master.', 'print_section': 'C', 'print_page': '33', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/20/arts/20MOORE1/20MOORE1-articleLarge.jpg', 'height': 91, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/20/arts/20MOORE1/20MOORE1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 91}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/20/arts/20MOORE1/MOORE1-jumbo.jpg', 'height': 156, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/20/arts/20MOORE1/20MOORE1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/20/arts/20MOORE1/20MOORE1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Master and His Peers in the Glow of a Golden Age', 'kicker': 'Art Review', 'content_kicker': None, 'print_headline': 'A Master and His Peers in the Glow of a Golden Age', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Morgan Library & Museum', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Rembrandt Harmenszoon van Rijn', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-19T22:44:01+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Karen Rosenberg', 'person': [{'firstname': 'Karen', 'middlename': None, 'lastname': 'Rosenberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/0923f7d3-0b27-5bbd-99fa-7b1da2cd11cf', 'word_count': 821, 'uri': 'nyt://article/0923f7d3-0b27-5bbd-99fa-7b1da2cd11cf'}, {'abstract': 'Variety abounds at the Winter Antiques Show, where 74 dealers from around the world offer all sorts of objects.', 'web_url': 'https://www.nytimes.com/2012/01/20/arts/design/winter-antiques-show-at-park-avenue-armory-review.html', 'snippet': 'Variety abounds at the Winter Antiques Show, where 74 dealers from around the world offer all sorts of objects.', 'lead_paragraph': 'This year’s Winter Antiques Show at the Park Avenue Armory offers the usual embarrassment of riches. Shining suits of knightly armor, mysteriously sensuous classical Indian stone sculptures, ceramics and red lacquer boxes from the Far East, sumptuous rugs, rare books and autographic documents, paintings and furniture from several centuries, jewelry, fancy early-American rifles and countless hard-to-classify oddities are displayed by 73 dealers from around the world.', 'print_section': 'C', 'print_page': '30', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/20/arts/20WINTER3_SPAN/WINTER3-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/20/arts/20WINTER3_SPAN/WINTER3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/20/arts/20WINTER3_SPAN/WINTER3-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/20/arts/20WINTER3_SPAN/WINTER3-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/20/arts/20WINTER3_SPAN/WINTER3-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'At a Winter Perennial, Old Objects That Are Never Passé', 'kicker': 'Art Review', 'content_kicker': None, 'print_headline': 'At a Winter Perennial, Old Objects That Are Never Passé', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Winter Antiques Show', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'ANTIQUES', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-19T22:47:14+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Ken Johnson', 'person': [{'firstname': 'Ken', 'middlename': None, 'lastname': 'Johnson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/19101a96-036e-58f5-90ff-130739523c0b', 'word_count': 916, 'uri': 'nyt://article/19101a96-036e-58f5-90ff-130739523c0b'}, {'abstract': 'Gerardo Naranjo’s “Miss Bala,” an art-house thriller, is based on the real story of a Mexican beauty queen who became entangled with a drug cartel.', 'web_url': 'https://www.nytimes.com/2012/01/20/movies/gerardo-naranjos-miss-bala-depicts-drug-war-review.html', 'snippet': 'Gerardo Naranjo’s “Miss Bala,” an art-house thriller, is based on the real story of a Mexican beauty queen who became entangled with a drug cartel.', 'lead_paragraph': 'A first-rate art-house thriller, “Miss Bala” tells the strange, seemingly impossible story of a Mexican beauty queen who becomes the accidental pawn of a drug cartel. It’s an adventure story that could be called a contemporary picaresque if it weren’t so deadly serious, and might be called fantastical if it weren’t loosely based on a true story of a former Miss Hispanic America. One day a beautiful young woman, Laura (a sympathetic Stephanie Sigman), is trying to enter a Miss Baja contest; a few hours later she’s cowering in a nightclub, dodging gunfire and gangsters who bequeath her another title, Miss Bala — Miss Bullet. ', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/20/arts/20MISS_SPAN/20MISS_SPAN-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/20/arts/20MISS_SPAN/20MISS_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/20/arts/20MISS_SPAN/20MISS_SPAN-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/20/arts/20MISS_SPAN/20MISS_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/20/arts/20MISS_SPAN/20MISS_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Beauty Queen With No Place to Hide', 'kicker': "Movie Review | 'Miss Bala'", 'content_kicker': None, 'print_headline': 'Beauty Queen With No Place to Hide', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Naranjo, Gerardo', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-01-19T22:48:23+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Manohla Dargis', 'person': [{'firstname': 'Manohla', 'middlename': None, 'lastname': 'Dargis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/d0bec6ab-a32f-5b81-b445-55cbffe66980', 'word_count': 901, 'uri': 'nyt://article/d0bec6ab-a32f-5b81-b445-55cbffe66980'}, {'abstract': 'Over the last five years, home prices fell around 12 percent in Nassau County and nearly 20 percent in Suffolk.', 'web_url': 'https://www.nytimes.com/2012/01/22/realestate/long-island-in-the-region-brokers-say-good-riddance-to-2011.html', 'snippet': 'Over the last five years, home prices fell around 12 percent in Nassau County and nearly 20 percent in Suffolk.', 'lead_paragraph': 'Melville', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/22/realestate/22LIZOA/22LIZOA-articleLarge.jpg', 'height': 265, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/22/realestate/22LIZOA/22LIZOA-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 265}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/22/realestate/22LIZOA/22LIZOA-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/22/realestate/22LIZOA/22LIZOA-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/22/realestate/22LIZOA/22LIZOA-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Brokers Say Good Riddance to 2011', 'kicker': 'In the Region | Long Island', 'content_kicker': None, 'print_headline': 'Rip It Up and Start Again', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Long Island (NY)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-01-19T22:48:55+0000', 'document_type': 'article', 'news_desk': 'RealEstate', 'section_name': 'Real Estate', 'byline': {'original': 'By Marcelle S. Fischler', 'person': [{'firstname': 'Marcelle', 'middlename': 'S.', 'lastname': 'Fischler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6039889a-0320-5c27-9424-0319177a87e8', 'word_count': 704, 'uri': 'nyt://article/6039889a-0320-5c27-9424-0319177a87e8'}, {'abstract': 'Hutter and Capo take what the major auction houses leave behind when a collector or celebrity dies; a exhibition highlights Gilded Age actresses who parlayed their fame into endorsement income.', 'web_url': 'https://www.nytimes.com/2012/01/20/arts/design/new-auctioneers-take-over-for-tepper-long-ago-spokesmodels.html', 'snippet': 'Hutter and Capo take what the major auction houses leave behind when a collector or celebrity dies; a exhibition highlights Gilded Age actresses who parlayed their fame into endorsement income.', 'lead_paragraph': 'As soon as a rich New Yorker dies, the major auction houses typically send condolence letters. Then their experts go to the apartment or town house, offering to handle antiques and artworks worth more than a few thousand dollars each. Once the estate has been settled and the best stuff taken away, the secondary auction houses help clean out anything else old.', 'print_section': 'C', 'print_page': '30', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/20/arts/20ANTIQUES1/20ANTIQUES1-jumbo.jpg', 'height': 896, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/20/arts/20ANTIQUES1/20ANTIQUES1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/20/arts/20ANTIQUES1/20ANTIQUES1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'What Other Auctioneers Decide to Leave Behind', 'kicker': 'Antiques', 'content_kicker': None, 'print_headline': 'What Other Auctioneers Decide to Leave Behind', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'ACTORS AND ACTRESSES', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'ANTIQUES', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-01-19T22:49:50+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Eve M. Kahn', 'person': [{'firstname': 'Eve', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cd6a7ae7-b0bf-5da1-9c60-37f45edcacad', 'word_count': 1074, 'uri': 'nyt://article/cd6a7ae7-b0bf-5da1-9c60-37f45edcacad'}, {'abstract': 'Some high-end homes have club or pub rooms with elaborate bars.', 'web_url': 'https://www.nytimes.com/2012/01/22/realestate/new-jersey-in-the-region-bringing-back-the-home-bar.html', 'snippet': 'Some high-end homes have club or pub rooms with elaborate bars.', 'lead_paragraph': 'THERE was a classic ’50s wet bar in the basement of a Bloomfield Cape sold by Roberta Plutzik Baldwin a few years ago. It had knotty pine paneling, a plaid carpet, sea netting and harbor lights — and it looked, Ms. Baldwin recalled, as if Troy Donahue might show up any minute. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/22/realestate/22NJZOA_SPAN/22NJZOA-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/22/realestate/22NJZOA_SPAN/22NJZOA-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/22/realestate/22NJZOA_SPAN/22NJZOA-jumbo.jpg', 'height': 701, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/22/realestate/22NJZOA_SPAN/22NJZOA-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/22/realestate/22NJZOA_SPAN/22NJZOA-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Belly Up to the Basement Bar', 'kicker': 'In the Region | New Jersey', 'content_kicker': None, 'print_headline': 'Belly Up to the Basement', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'New Jersey', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-01-19T22:51:16+0000', 'document_type': 'article', 'news_desk': 'RealEstate', 'section_name': 'Real Estate', 'byline': {'original': 'By Antoinette Martin', 'person': [{'firstname': 'Antoinette', 'middlename': None, 'lastname': 'Martin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/426b7e1c-3308-577d-ab66-cf8d59cfaee9', 'word_count': 974, 'uri': 'nyt://article/426b7e1c-3308-577d-ab66-cf8d59cfaee9'}, {'abstract': 'When Mitt Romney said that his federal tax rate was about 15 percent, many wrongly assumed that their own rate was higher.', 'web_url': 'https://www.nytimes.com/2012/01/20/us/politics/why-americans-think-the-tax-rate-is-high-and-why-theyre-wrong.html', 'snippet': 'When Mitt Romney said that his federal tax rate was about 15 percent, many wrongly assumed that their own rate was higher.', 'lead_paragraph': 'WASHINGTON — When people heard that Mitt Romney’s federal income tax rate was about 15 percent, the immediate reaction of many was to assume that their own rate was higher. The top marginal rate is 35 percent, after all, and the marginal rate on a couple with $70,000 in taxable income is 25 percent.', 'print_section': 'A', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Why Taxes Aren’t as High as They Seem', 'kicker': 'News Analysis', 'content_kicker': None, 'print_headline': 'Why Taxes Aren’t as High as They Seem', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Income Tax', 'rank': 1, 'major'