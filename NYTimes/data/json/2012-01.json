95-5206-52b2-87f4-5de821a21975', 'word_count': 0, 'uri': 'nyt://slideshow/0e862d95-5206-52b2-87f4-5de821a21975'}, {'abstract': 'Our band from Chatham, N.J., finds good food, good drink and good fans in Milwaukee a night before they travel to Lambeau Field for Giants-Packers.', 'web_url': 'https://fifthdown.blogs.nytimes.com/2012/01/15/eight-men-in-a-night-in-milwaukee/', 'snippet': 'Our band from Chatham, N.J., finds good food, good drink and good fans in Milwaukee a night before they travel to Lambeau Field for Giants-Packers.', 'lead_paragraph': 'Fifty years ago, if the Giants were headed to Green Bay to play the Packers in the postseason, fans in New York might have considered themselves lucky to catch the game on television. Today, with tickets available online and frequent-flier miles accruing with every credit-card purchase, fans can dare to dream a little more boldly. Six members of a Chatham, N.J., softball team — a mix of lawyers, Wall Streeters and computer software salesmen — are set to travel to Lambeau Field for Sunday’s showdown between the Giants and the Packers. It will be a trip of cheap hotel rooms and high hopes, cramped rental cars and unexpectedly good seats at the game. The men — they will be joined by two pals in Milwaukee — have agreed to create a Titletown travelogue. Their hopes are to stay friends, keep their jobs and, well, see the Giants win.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Eight Men In: A Night in Milwaukee', 'kicker': 'The Fifth Down', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Restaurants', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Green Bay Packers', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Lambeau Field', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Giants', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Milwaukee (Wis)', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-01-15T20:40:03+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By STEPHEN COSTELLO', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'COSTELLO', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2f81a44d-8e1e-5eac-88c8-fe6db5c21a55', 'word_count': 799, 'uri': 'nyt://article/2f81a44d-8e1e-5eac-88c8-fe6db5c21a55'}, {'abstract': 'The composer J. D. Souther, whose music has been identified with the Eagles and Linda Ronstadt, had his night at Lincoln Center’s American Songbook series.', 'web_url': 'https://www.nytimes.com/2012/01/16/arts/music/j-d-souther-in-lincoln-center-american-songbook-review.html', 'snippet': 'The composer J. D. Souther, whose music has been identified with the Eagles and Linda Ronstadt, had his night at Lincoln Center’s American Songbook series.', 'lead_paragraph': '“Too many stories, too many heartbreak songs/ Where nobody’s right, nobody’s wrong,” go the words to “Faithless Love,” the aching country-rock ballad popularized by Linda Ronstadt 38 years ago in a memorable duet with its composer, J. D. Souther. On Friday evening Mr. Souther sang a solo rendition of “Faithless Love” at the Allen Room as part of Lincoln Center’s American Songbook series. With its plaintive winding melody and lyrics that picture an endless river of romantic sorrow, the song conjures the darker side of Southern California hedonism during the long-gone heyday of the Laurel Canyon troubadours. ', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/16/arts/souther/souther-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/16/arts/souther/souther-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/16/arts/souther/souther-jumbo.jpg', 'height': 680, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'The Reflected Lights and Shadows of California’s 1970s Troubadours', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'The Reflected Lights and Shadows of California’s 1970s Troubadours', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'American Songbook (Music Series)', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-01-15T20:42:46+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Stephen Holden', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Holden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/518aa622-3e5d-5eda-a08c-52c18c29a3ac', 'word_count': 342, 'uri': 'nyt://article/518aa622-3e5d-5eda-a08c-52c18c29a3ac'}, {'abstract': 'Milan.', 'web_url': 'https://www.nytimes.com/slideshow/2012/01/15/fashion/westwood_milanfall2012.html', 'snippet': 'Milan.', 'lead_paragraph': 'Milan.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/15/fashion/westwood_milanfall2012-slide-2C7S/westwood_milanfall2012-slide-2C7S-jumbo.jpg', 'height': 1024, 'width': 687, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/1