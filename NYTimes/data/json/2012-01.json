ker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-01-17T20:20:37+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By Sarah Kavanagh and Holly Epstein Ojalvo', 'person': [{'firstname': 'Sarah', 'middlename': None, 'lastname': 'Kavanagh', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Holly', 'middlename': 'Epstein', 'lastname': 'Ojalvo', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b3f5e97c-cfac-5431-8e1d-f6bade4167bb', 'word_count': 1036, 'uri': 'nyt://article/b3f5e97c-cfac-5431-8e1d-f6bade4167bb'}, {'abstract': 'Whether you use wild mushrooms or the more economical cremini or button mushrooms, this omelet is earthy and satisfying.', 'web_url': 'https://www.nytimes.com/2012/01/17/health/nutrition/mushroom-and-herb-omelet-recipes-for-health.html', 'snippet': 'Whether you use wild mushrooms or the more economical cremini or button mushrooms, this omelet is earthy and satisfying.', 'lead_paragraph': 'Mushroom omelets are my favorite type of omelet. You can get fancy with them and use wild mushrooms, but it’s much more economical and equally satisfying to make them with cultivated creminis or white button mushrooms.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/18/science/17recipehealth/17recipehealth-articleLarge-v2.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/18/science/17recipehealth/17recipehealth-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/18/science/17recipehealth/17recipehealth-