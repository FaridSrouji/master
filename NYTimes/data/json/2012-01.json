 art of the song recital. ', 'print_section': 'C', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/21/arts/MARILYN/MARILYN-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/21/arts/MARILYN/MARILYN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/21/arts/MARILYN/MARILYN-jumbo.jpg', 'height': 665, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/21/arts/MARILYN/MARILYN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/21/arts/MARILYN/MARILYN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Program for Singers Shows Them the Way to Carnegie Hall', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'A Program for Singers Shows Them the Way to Carnegie Hall', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Opera', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Horne, Marilyn', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Weill Music Institute at Carnegie Hall', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Bolcom, William', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'DiDonato, Joyce', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Jones, Warren', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Horne, Marilyn, Foundation', 'rank': 9