multimedia': [], 'headline': {'main': 'By Request | Social Spa-ing', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-01-31T16:00:58+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Rebecca Willa Davis', 'person': [{'firstname': 'Rebecca', 'middlename': 'Willa', 'lastname': 'Davis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9f7abc02-19ca-574a-ba66-7ba62bf7a268', 'word_count': 336, 'uri': 'nyt://article/9f7abc02-19ca-574a-ba66-7ba62bf7a268'}, {'abstract': 'A new study suggests that the choice of major may be influenced by the way some people’s brains are wired.', 'web_url': 'https://economix.blogs.nytimes.com/2012/01/31/college-major-and-family-mental-illness/', 'snippet': 'A new study suggests that the choice of major may be influenced by the way some people’s brains are wired.', 'lead_paragraph': 'It’s puzzling that so few American students graduate with engineering and science degrees, even though these majors would grant them much higher salaries. Maybe the reason is that these majors require so much homework.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'College Major and Family Mental Illness', 'kicker': 'Economix', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Colleges and Universities', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mental Health and Disorders', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Princeton University', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-31T16:09:33+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Catherine Rampell', 'person': [{'firstname': 'Catherine', 'middlename': None, 'lastname': 'Rampell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/eed0126b-9ae9-517f-b1ec-800fc60ae848', 'word_count': 548, 'uri': 'nyt://article/eed0126b-9ae9-517f-b1ec-800fc60ae848'}, {'abstract': 'Reviews of three productions at very small theaters in London, notably the two-character drama “Constellations,” starring Sally Hawkins and Rafe Spall.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/01/31/london-theater-journal-big-ideas-in-small-spaces/', 'snippet': 'Reviews of three productions at very small theaters in London, notably the two-character drama “Constellations,” starring Sally Hawkins and Rafe Spall.', 'lead_paragraph': 'LONDON — Some plays are worth defying claustrophobia for. As a capacity audience crowded onto the benches that surrounded the rectangular stage of the tiny black-box space of the Royal Court Jerwood Theater Upstairs, I could feel my chest tightening and my breath growing shorter. It didn’t help that layers of white balloons covered (and lowered) the ceiling in molecular formations. I had to admonish myself, as I do in such circumstances, “Theater critics do not faint on the job – except, on rare occasion, metaphorically.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'London Theater Journal: Big Ideas in Small Spaces', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Hawkins, Sally', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Old Vic Theater', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Royal Court Theater', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'London (England)', 'rank': 8, 'major': 'N'}], 'pub_date': '2012-01-31T16:09:34+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Ben Brantley', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Brantley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/188dbd85-cbc9-5a03-b17f-ade737b7cadd', 'word_count': 1182, 'uri': 'nyt://article/188dbd85-cbc9-5a03-b17f-ade737b7cadd'}, {'abstract': 'The Tribune Company, publisher of The Chicago Tribune, The Los Angeles Times and others, is in the fourth year of its bankruptcy. While the papers have cut back on reporting, the legal fees have kept rising.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2012/01/31/lawyers-in-tribune-bankruptcy-case-take-in-231-million-and-counting/', 'snippet': 'The Tribune Company, publisher of The Chicago Tribune, The Los Angeles Times and others, is in the fourth year of its bankruptcy. While the papers have cut back on reporting, the legal fees have kept rising.', 'lead_paragraph': 'In a memo earlier in January, Gerould Kern, senior vice president and editor of The Chicago Tribune, said that economic pressures required further layoffs at the beleaguered flagship of the Tribune Company, a newspaper and television company that fell into bankruptcy in 2008 after it was bought by Sam Zell, a Chicago real estate developer, in a highly leveraged deal.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Lawyers in Tribune Bankruptcy Case Take In $231 Million, and Counting', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Bankruptcies', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Media', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Newspapers', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Baltimore Sun', 'rank': 4, 'major': 'N