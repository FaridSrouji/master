idential)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Urban Areas', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-01-13T17:54:59+0000', 'document_type': 'multimedia', 'news_desk': 'Real Estate', 'section_name': 'Real Estate', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/497a393f-2997-5999-ac2f-6817076ebfcd', 'word_count': 0, 'uri': 'nyt://slideshow/497a393f-2997-5999-ac2f-6817076ebfcd'}, {'abstract': 'Children’s books about George Washington, Abraham Lincoln and other American leaders.', 'web_url': 'https://www.nytimes.com/2012/01/15/books/review/bookshelf-presidents.html', 'snippet': 'Children’s books about George Washington, Abraham Lincoln and other American leaders.', 'lead_paragraph': 'GEORGE WASHINGTON’S BIRTHDAY  A Mostly True Tale.  By Margaret McNamara. Illustrated by Barry Blitt.  40 pp. Schwartz & Wade. $17.99. (Picture book; ages 4 to 8)', 'print_section': 'BR', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/13/books/review/15bookshelf-presidents-slide-VYQ1/15bookshelf-presidents-slide-VYQ1-articleLarge.jpg', 'height': 355, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/13/books/review/15bookshelf-presidents-slide-VYQ1/15bookshelf-presidents-slide-VYQ1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 355}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/13/books/review/15bookshelf-presidents-slide-VYQ1/15bookshelf-presidents-slide-VYQ1-jumbo.jpg', 'height': 626, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/13/books/review/15bookshelf-presidents-slide-VYQ1/15bookshelf-presidents-slide-VYQ1-thumb