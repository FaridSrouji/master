rstyle: "embeddedSlideShowTmag"}', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Visiting Artists | Daniel Arsham', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-01-13T16:01:51+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Johnny Misheff', 'person': [{'firstname': 'Johnny', 'middlename': None, 'lastname': 'Misheff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/498d7501-da1d-5d77-84fe-0379ee79d624', 'word_count': 513, 'uri': 'nyt://article/498d7501-da1d-5d77-84fe-0379ee79d624'}, {'abstract': 'Food-related events around New York.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2012/01/13/weekend-fare-76/', 'snippet': 'Food-related events around New York.', 'lead_paragraph': 'A traditional Swiss winter feast called Metzgete, celebrating nose-to-tail dining, will be take place at Trestle on Tenth, 242 10th Avenue (24th Street) in Chelsea, on Friday through Jan. 21. The menu — which includes pork belly, sausages and other cuts served with mashed potatoes, sauerkraut and trimmings — is $26 per person, not including beverages, tax or tip. Call (212) 645-5659 or go online to make reservations.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Weekend Fare', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-01-13T16:05:48+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Bao Ong', 'person': [{'firstname': 'Bao', 'middlename': None, 'lastname': 'Ong', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/582f5a02-cc93-501b-bcf7-55986becab7f', 'word_count': 373, 'uri': 'nyt://article/582f5a02-cc93-501b-bcf7-55986becab7f'}, {'abstract': '“Soto: Paris and Beyond, 1950-1970” at New York University’s Grey Art Gallery, shows Jésus Soto’s fascination with how viewpoints develop.', 'web_url': 'https://www.nytimes.com/2012/01/13/arts/design/soto-paris-and-beyond-1950-1970-at-nyu-review.html', 'snippet': '“Soto: Paris and Beyond, 1950-1970” at New York University’s Grey Art Gallery, shows Jésus Soto’s fascination with how viewpoints develop.', 'lead_paragraph': 'Once a figure of international renown, Jesús Soto is now mostly remembered as a minor Modernist who worked in the overlap among hard-edge abstraction, kinetic art and Op Art. “Soto: Paris and Beyond, 1950-1970” at New York University’s Grey Art Gallery will not precipitate a run to revive his reputation, but it does open an interesting window on the mid-20th-century philosophical landscape of modern art. ', 'print_section': 'C', 'print_page': '28', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Mechanics Behind Perspective', 'kicker': 'Art Review', 'content_kicker': None, 'print_headline': 'The Mechanics Behind Perspective', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Grey Art Gallery', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-01-13T16:11:40+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Ken Johnson', 'person': [{'firstname': 'Ken', 'middlename': None, 'lastname': 'Johnson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/2fe55291-1574-5a28-ba31-c459f81266bf', 'word_count': 858, 'uri': 'nyt://article/2fe55291-1574-5a28-ba31-c459f81266bf'}, {'abstract': 'Ch