e.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/16/business/16online-1/16online-1-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/16/business/16online-1/16online-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/16/business/16online-1/16online-1-jumbo.jpg', 'height': 696, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/16/business/16online-1/16online-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/16/business/16online-1/16online-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Online Shoppers Are Rooting for the Little Guy', 'kicker': None, 'content_kicker': None, 'print_headline': 'Rooting for the Little Guy', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'AMAZON.COM INC', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Customer Relations', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Small Business', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'E-Commerce', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Consumer Behavior', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-01-15T20:30:42+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Stephanie Clifford and Claire Cain Miller', 'person': [{'firstname': 'Stephanie', 'middlename': None, 'lastname': 'Clifford', 'qualifier': None, 'title': None, 'role': 'rep