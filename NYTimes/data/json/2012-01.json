he Fifth Down', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Federal Communications Commission', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'National Football League', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-13T02:09:02+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Richard Sandomir', 'person': [{'firstname': 'Richard', 'middlename': None, 'lastname': 'Sandomir', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/08b4f859-507a-56f2-bc88-27d6c485fe41', 'word_count': 545, 'uri': 'nyt://article/08b4f859-507a-56f2-bc88-27d6c485fe41'}, {'abstract': 'Stephen Colbert, the host of “The Colbert Report,” announced that he would form an “exploratory committee for president of the United States of South Carolina.”', 'web_url': 'https://www.nytimes.com/2012/01/13/us/politics/stephen-colbert-to-explore-or-pretend-to-run-for-president.html', 'snippet': 'Stephen Colbert, the host of “The Colbert Report,” announced that he would form an “exploratory committee for president of the United States of South Carolina.”', 'lead_paragraph': 'If anyone can make a mockery of the newest campaign finance innovation, the “super PAC,” it’s Stephen Colbert.', 'print_section': 'A', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/13/us/13colbert2_337/13colbert2_337-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/13/us/13colbert2_337/13colbert2_337-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'ra