any Lions discovered a refuge of sorts in the TicketCity Bowl.', 'print_section': 'D', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/02/sports/YBOWL/YBOWL-jumbo.jpg', 'height': 898, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/02/sports/YBOWL/YBOWL-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/02/sports/YBOWL/YBOWL-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Penn State and Houston Savor a Second Chance', 'kicker': None, 'content_kicker': None, 'print_headline': 'Penn State and Houston Savor a Second Chance', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football (College)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Sandusky, Jerry', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'College Athletics', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Bowl Games', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Houston', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Paterno, Joe', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Pennsylvania State University', 'rank': 8, 'major': 'N'}], 'pub_date': '2012-01-02T01:09:56+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'College Football', 'byline': {'original': 'By Tom Spousta', 'person': [{'firstname': 'Tom', 'middlename': None, 'lastname': 'Spousta', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id'