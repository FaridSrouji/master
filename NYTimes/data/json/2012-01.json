ations', 'value': 'Foreign Policy (Magazine)', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'International Crisis Group', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'International Institute for Strategic Studies', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Egypt', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'Middle East', 'rank': 11, 'major': 'N'}, {'name': 'glocations', 'value': 'Syria', 'rank': 12, 'major': 'N'}], 'pub_date': '2012-01-27T06:00:11+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'byline': {'original': 'By Harvey Morris', 'person': [{'firstname': 'Harvey', 'middlename': None, 'lastname': 'Morris', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4a1d8d0f-9afc-5621-87a9-9518b15775da', 'word_count': 720, 'uri': 'nyt://article/4a1d8d0f-9afc-5621-87a9-9518b15775da'}, {'abstract': 'SF Sketchfest, a comedy festival, mixes big-name stars with new talent emerging from podcasts, YouTube and Twitter.', 'web_url': 'https://www.nytimes.com/2012/01/27/us/seeking-out-the-funny-sketchfest-mines-the-web.html', 'snippet': 'SF Sketchfest, a comedy festival, mixes big-name stars with new talent emerging from podcasts, YouTube and Twitter.', 'lead_paragraph': 'The threat of online piracy to the entertainment industry has been all over the news thanks to a set of Congressional bills, but Cole Stratton, co-founder of the 11-year-old San Francisco comedy festival SF Sketchfest, could not be more pleased about the current intersection of comedy and technology.', 'print_section': 'A', 'print_page': '19B', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/27/us/27BCCULTURE/27BCCULTURE-jumbo.jpg', 'height': 713, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy