'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Put Down the Pitchforks on SOPA', 'kicker': 'Pogue&#039;s Posts', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Computers and the Internet', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Copyrights and Copyright Violations', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-01-19T17:50:45+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By David Pogue', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Pogue', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3928fca9-069c-51ab-961d-9eb4304cb66f', 'word_count': 1115, 'uri': 'nyt://article/3928fca9-069c-51ab-961d-9eb4304cb66f'}, {'abstract': 'Katryna A. Swartout Ryan, associate dean of admissions at Colgate University, answers questions about applying for financial aid from abroad.', 'web_url': 'https://thechoice.blogs.nytimes.com/2012/01/19/choice-on-india-ink-colgate/', 'snippet': 'Katryna A. Swartout Ryan, associate dean of admissions at Colgate University, answers questions about applying for financial aid from abroad.', 'lead_paragraph': 'Our colleagues in India have recently posted the third installment in a series we’re calling “The Choice on India Ink,” which is intended to offer guidance to students and families in India who are applying to American colleges.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'How Colgate University Approaches Financial Aid for International Students', 'kicker': 'The Choice', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-01-19T17:51:00+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'byline': {'original': 'By Dani