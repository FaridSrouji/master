aterial': 'News', '_id': 'nyt://article/ada58052-3df0-5987-ba3d-94e0ea9fc585', 'word_count': 32, 'uri': 'nyt://article/ada58052-3df0-5987-ba3d-94e0ea9fc585'}, {'abstract': 'Indiana Republicans want to prohibit mandatory dues for private-sector workers, and to spur other states’ efforts.', 'web_url': 'https://www.nytimes.com/2012/01/03/business/gathering-storm-over-right-to-work-in-indiana.html', 'snippet': 'Indiana Republicans want to prohibit mandatory dues for private-sector workers, and to spur other states’ efforts.', 'lead_paragraph': 'INDIANAPOLIS — Nearly a year after legislatures in Wisconsin and several other Republican-dominated states curbed the power of public sector unions, lawmakers are now turning their sights toward private sector unions, setting up what is sure to be another political storm.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/03/business/03work-pic/03work-pic-articleLarge.jpg', 'height': 370, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/03/business/03work-pic/03work-pic-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 370}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/03/business/03work-pic/03work-pic-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'A Gathering Storm Over ‘Right to Work’ in Indiana', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Gathering Storm', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'State Legislatures', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Workplace Environment', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Indiana', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Organized Labor',