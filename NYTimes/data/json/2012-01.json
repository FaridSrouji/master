, {'abstract': 'The rookie Josh Harrellson had 14 points and 12 rebounds in his first start, and Tyson Chandler, a defensive specialist, had 22 points and 7 rebounds.', 'web_url': 'https://www.nytimes.com/2012/01/01/sports/basketball/stoudemire-sits-but-knicks-beat-kings.html', 'snippet': 'The rookie Josh Harrellson had 14 points and 12 rebounds in his first start, and Tyson Chandler, a defensive specialist, had 22 points and 7 rebounds.', 'lead_paragraph': 'SACRAMENTO — The Knicks were in midair somewhere over California’s central valley when physics and physiology conspired against them.', 'print_section': 'SP', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/01/sports/Knicks1/Knicks1-jumbo.jpg', 'height': 927, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/01/sports/Knicks1/Knicks1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/01/sports/Knicks1/Knicks1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Stoudemire Sits, but a Rookie and a Veteran Stand Tall', 'kicker': 'Knicks 114, Kings 92', 'content_kicker': None, 'print_headline': 'Stoudemire Sits, but a Rookie and a Veteran Stand Tall for the Knicks', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Basketball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Chandler, Tyson', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Stoudemire, Amare', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': "D'Antoni, Mike", 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Sacramento Kings', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Knicks', 'r