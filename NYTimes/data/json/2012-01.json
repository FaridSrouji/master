w York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/24/arts/mariinsky/mariinsky-jumbo.jpg', 'height': 1024, 'width': 730, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'The Pure Romanticism That Fokine Took West Returns After a Detour', 'kicker': 'Dance Review', 'content_kicker': None, 'print_headline': 'The Pure Romanticism That Fokine Took West Returns After a Detour', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Mariinsky Ballet', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Kennedy, John F, Center for the Performing Arts', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Fokine, Michel', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Dancing', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-01-23T22:57:05+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Alastair Macaulay', 'person': [{'firstname': 'Alastair', 'middlename': None, 'lastname': 'Macaulay', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/295815c3-8eeb-50ef-bc9a-3b6aaa8e8f86', 'word_count': 1004, 'uri': 'nyt://article/295815c3-8eeb-50ef-bc9a-3b6aaa8e8f86'}, {'abstract': 'Bathonea, a harbor town dating from the second century B.C., was discovered by archaeologists on a peninsula jutting into Lake Kucukcekmece.', 'web_url': 'https://www.nytimes.com/2012/01/24/science/istanbul-yields-a-treasure-trove-in-ancient-bathonea.html', 'snippet': 'Bathonea, a harbor town dating from the second century B.C., was discovered by archaeologists on a peninsula jutting into Lake Kucukcekmece.', 'lead_paragraph': 'ISTANBUL — For 1,600 years, this city — Turkey’s largest — has been built and destroyed, erected and erased, as layer upon