subject', 'value': 'Nursing Homes', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Prisons and Prisoners', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Disabilities', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'San Mateo (Calif)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Santa Clara County (Calif)', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-01-20T04:05:28+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Katharine Mieszkowski', 'person': [{'firstname': 'Katharine', 'middlename': None, 'lastname': 'Mieszkowski', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cfdcde9d-3b73-5068-9348-b7753220c455', 'word_count': 1209, 'uri': 'nyt://article/cfdcde9d-3b73-5068-9348-b7753220c455'}, {'abstract': 'David Beckham said Thursday that family concerns and his comfort level in Los Angeles were pivotal in his decision to re-sign with the Galaxy of Major League Soccer.', 'web_url': 'https://www.nytimes.com/2012/01/20/sports/soccer/beckhams-decision-to-stay-in-mls-was-all-in-the-family.html', 'snippet': 'David Beckham said Thursday that family concerns and his comfort level in Los Angeles were pivotal in his decision to re-sign with the Galaxy of Major League Soccer.', 'lead_paragraph': 'LOS ANGELES — While the soccer world speculated where or whether David Beckham would resume his career, he quietly made his decision on New Year’s Eve in London, he said Thursday. As a result, Beckham will stay with the Los Angeles Galaxy after signing a two-year contract. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/20/sports/20beckham-1/20beckham-1-jumbo.jpg', 'height': 733, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtyp