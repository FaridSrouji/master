_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/15/nyregion/15YELLIN_SPAN/15YELLIN_SPAN-articleLarge-v2.jpg', 'height': 380, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/15/nyregion/15YELLIN_SPAN/15YELLIN_SPAN-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 380}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/15/nyregion/15YELLIN_SPAN/15YELLIN-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/15/nyregion/15YELLIN_SPAN/15YELLIN_SPAN-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/15/nyregion/15YELLIN_SPAN/15YELLIN_SPAN-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'An Artist’s Big, Big Plans for Red Hook', 'kicker': None, 'content_kicker': None, 'print_headline': 'An Artist’s Big, Big Plans for Red Hook', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Red Hook (NYC)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-01-13T23:36:34+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Jed Lipinski', 'person': [{'firstname': 'Jed', 'middlename': None, 'lastname': 'Lipinski', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/760b2ca2-4e90-54e6-b4ac-f83728c3a6d1', 'word_count': 1357, 'uri': 'nyt://article/760b2ca2-4e90-54e6-b4ac-f83728c3a6d1'}, {'abstract': 'Readers respond to 