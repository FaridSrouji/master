'type_of_material': 'News', '_id': 'nyt://article/1db1f3cd-3748-5250-be0a-0de1d73758d6', 'word_count': 305, 'uri': 'nyt://article/1db1f3cd-3748-5250-be0a-0de1d73758d6'}, {'abstract': 'Cruise lines are protected by international law and by a carefully worded contract that passengers accept when they buy tickets.', 'web_url': 'https://www.nytimes.com/2012/01/19/world/europe/cruise-lines-use-law-and-contracts-to-limit-liability.html', 'snippet': 'Cruise lines are protected by international law and by a carefully worded contract that passengers accept when they buy tickets.', 'lead_paragraph': 'The wreck of the Costa Concordia has attracted those habitual companions of disaster: lawyers. ', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/19/world/admiralty/admiralty-jumbo.jpg', 'height': 1024, 'width': 682, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Cruise Lines Use Law and Contracts to Limit Liability', 'kicker': None, 'content_kicker': None, 'print_headline': 'Cruise Lines Use Law and Contracts To Limit Liability', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Carnival Cruise Lines', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cruises', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Costa Crociere SpA', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Italy', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Suits and Litigation', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Maritime Accidents and Safety', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Tuscany (Italy)', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-01-19T00:28:34+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By John Schwartz',