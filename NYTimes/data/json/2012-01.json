thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/29/us/SPRING/SPRING-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'In Tucson, Finding a Game to Replace the One That Took Its Ball and Left', 'kicker': None, 'content_kicker': None, 'print_headline': 'In Tucson, Finding a Game to Replace the One That Took Its Ball and Left', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Soccer', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Economic Conditions and Trends', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Major League Soccer', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Athletics and Sports', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Tucson (Ariz)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Baseball', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Major League Baseball', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-01-28T22:18:03+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Ken Belson', 'person': [{'firstname': 'Ken', 'middlename': None, 'lastname': 'Belson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0b690f2b-7e96-55e8-96da-2fc673effbd3', 'word_count': 1010, 'uri': 'nyt://article/0b690f2b-7e96-55e8-96da-2fc673effbd3'}, {'abstract': 'The Online Protection and Enforcement of Digital Trade Act offers a straightforward and transparent approach to the problem of piracy.', 'web_url': 'https://www.nytimes.com/2012/01/29/opinion/sunday/beyond-sopa.html', 'snippet': 'The Online Protection and Enforcement of Digital Trade Act offers a straightforward and transparent approach to the problem of piracy.', 'lead_paragraph': 'We welcomed the collapse this month of two flawed bills to prevent online piracy, bills that could have stifled speech and undermined Internet safety. But piracy by Web sites in countries like Russia and China, which offer high-quality bootleg copies of movies and music, is a real problem for the nation’s creative industries. And there is legislation that could curb the operation of rogue Web sites without threatening legitimate expression. ', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Beyond SOPA', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Beyond SOPA', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Issa, Darrell E', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Wyden, Ron', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Copyrights and Copyright Violations', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'International Trade and World Market', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'United States International Trade Commission', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 9, 'major': 'N'}], 'pub_date': '2012-01-28T22:18:20+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/b5930520-d971-577a-93fe-c1e98e980b4c', 'word_count': 463, 'uri': 'nyt://article/b5930520-d971-577a-93fe-c1e98e980b4c'}, {'abstract': 'Unless Washington lives up to its moral obligation and authorizes special immigration visas to Iraqis who worked with Americans, many will suffer or be killed.', 'web_url': 'https://www.nytimes.com/2012/01/29/opinion/sunday/unfinished-business-in-iraq.html', 'snippet': 'Unless Washington lives up to its moral obligation and authorizes special immigration visas to Iraqis who worked with Americans, many will suffer or be killed.', 'lead_paragraph': 'When the last American troops came home from Iraq in December, thousands of Iraqis who had worked with the Americans were left behind. Many have already been targeted by militants, and some had taken refuge on American military bases. But once the bases were closed — or handed over to the Iraqi government — those Iraqis were forced into hiding. Unless Washington lives up to its moral obligation, many more will suffer or be killed. ', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Unfinished Business in Iraq', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Unfinished Business in Iraq', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Iraq War (2003-11)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Visas', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Refugees and Displaced Persons', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Iraq', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'Asylum, Right of', 'rank': 10, 'major': 'N'}], 'pub_date': '2012-01-28T22:19:09+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/6c0fa2db-938b-5091-8ca9-bb8be21975c0', 'word_count': 441, 'uri': 'nyt://article/6c0fa2db-938b-5091-8ca9-bb8be21975c0'}, {'abstract': 'Players who appear on the show courts are welcome to take the Grand Slam commemorative towels. The outer courts, meanwhile, are stocked with the plain white variety.', 'web_url': 'https://straightsets.blogs.nytimes.com/2012/01/28/towels-become-treasured-souvenirs/', 'snippet': 'Players who appear on the show courts are welcome to take the Grand Slam commemorative towels. The outer courts, meanwhile, are stocked with the plain white variety.', 'lead_paragraph': 'MELBOURNE, Australia — More often than not, tennis players want to leave tournaments with more than just the trophy.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Towels Become Treasured Souvenirs', 'kicker': 'Straight Sets', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Tennis', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Townsend, Taylor', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Australia', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-28T22:21:53+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By Ben Rothenberg', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Rothenberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7546fcac-5dd4-5a88-b873-2b6dfdcc2f2a', 'word_count': 367, 'uri': 'nyt://article/7546fcac-5dd4-5a88-b873-2b6dfdcc2f2a'}, {'abstract': 'A federal advisory group’s statement will help explain why the details of some bird flu research are too dangerous to publish.', 'web_url': 'https://www.nytimes.com/2012/01/29/opinion/sunday/the-missing-bird-flu-report.html', 'snippet': 'A federal advisory group’s statement will help explain why the details of some bird flu research are too dangerous to publish.', 'lead_paragraph': 'In November, a federal advisory board recommended that two scientific papers describing research that created strains of bird flu potentially transmissible in humans should be published only if key details are omitted. The fear is that terrorists or hostile nations could learn how to cause a pandemic. This week we will finally find out how the National Science Advisory Board for Biosecurity reached its conclusion.', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Missing Bird Flu Report', 'kicker': 'Editorial | Week Ahead', 'content_kicker': None, 'print_headline': 'The Missing Bird Flu Report', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Editorials', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'National Institutes of Health', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Avian Influenza', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Science (Journal)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Terrorism', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Censorship', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'National Science Advisory Board for Biosecurity', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Research', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Academic and Scientific Journals', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'Nature (Journal)', 'rank': 10, 'major': 'N'}], 'pub_date': '2012-01-28T22:22:20+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Philip M. Boffey', 'person': [{'firstname': 'Philip', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/80d5ffd8-785e-5ded-9c47-31782dd9a062', 'word_count': 335, 'uri': 'nyt://article/80d5ffd8-785e-5ded-9c47-31782dd9a062'}, {'abstract': 'Why do we think we can read the mind of a small, furry critter?', 'web_url': 'https://www.nytimes.com/2012/01/29/opinion/sunday/questions-about-the-groundhog.html', 'snippet': 'Why do we think we can read the mind of a small, furry critter?', 'lead_paragraph': 'Groundhog Day — celebrated this Thursday — is a holiday specifically for discussing the weather, as if people were otherwise silent on the subject. (It is also a wonderful movie about infinite chances — and the perfectibility, at least, of Bill Murray — that is well worth watching, in case you haven’t seen it in a while.)', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/29/sunday-review/editorial/editorial-jumbo.jpg', 'height': 845, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/29/sunday-review/editorial/editorial-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/29/sunday-review/editorial/editorial-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Questions About the Groundhog', 'kicker': 'Editorial | Week Ahead', 'content_kicker': None, 'print_headline': 'Questions About the Groundhog', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Weather', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Groundhogs', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-28T22:22:22+0000', 'document_type': 'ar