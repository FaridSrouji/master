name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'State of the Union Message (US)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Mortgages', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Attorneys General', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Justice Department', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Holder, Eric H Jr', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Breuer, Lanny A', 'rank': 10, 'major': 'N'}, {'name': 'subject', 'value': 'Frauds and Swindling', 'rank': 11, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 12, 'major': 'N'}], 'pub_date': '2012-01-26T02:46:40+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/241f570e-179c-5de4-95fc-ebef60ce8d81', 'word_count': 546, 'uri': 'nyt://article/241f570e-179c-5de4-95fc-ebef60ce8d81'}, {'abstract': 'The prospects of a so-called Buffett tax on high-earning households remain uncertain, if not remote, for the immediate future.', 'web_url': 'https://www.nytimes.com/2012/01/26/us/politics/talk-of-taxing-rich-more-faces-political-hurdles.html', 'snippet': 'The prospects of a so-called Buffett tax on high-earning households remain uncertain, if not remote, for the immediate future.', 'lead_paragraph': 'WASHINGTON — President Obama’s call for “tax fairness” and Mitt Romney’s tax returns have catapulted the debate over tax increases on the rich to the top of the political agenda. But with even some top Democrats hesitant, the prospects of a so-called Buffett tax on high-earning households remain uncertain, if not remote, for the immediate future. What is left may be only politics, at least until after the November elections.', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multim