stname': 'Alison', 'middlename': 'S.', 'lastname': 'Cohn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f3519122-0f89-5266-a715-a2ef6ed66e77', 'word_count': 465, 'uri': 'nyt://article/f3519122-0f89-5266-a715-a2ef6ed66e77'}, {'abstract': 'Mitt Romney also says that April’s tax season may be the appropriate month to disclose his tax returns.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2012/01/17/romney-says-his-effective-tax-rate-is-about-15-percent/', 'snippet': 'Mitt Romney also says that April’s tax season may be the appropriate month to disclose his tax returns.', 'lead_paragraph': '2:23 p.m. | Updated FLORENCE, S.C. — After speaking to a smaller-than-usual crowd on Tuesday morning in Florence, S.C., Mitt Romney took questions from the press and said that his effective tax rate was about 15 percent.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Romney Says His Effective Tax Rate Is About 15 Percent', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Income Tax', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'South Carolina', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-01-17T16:20:50+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Ashley Parker', 'person': [{'firstname': 'Ashley', 'middlename': None, 'lastname': 'Parker', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1a0468c1-9235-513e-a04b-b4a2221f3ecc', 'word_count': 448, 'uri': 'nyt://article/1a0468c1-9235-513e-a04b-b4a2221f3ecc'}, {'abstract': 'Raising revenue remains the draw for most, but some wonder whether profits from Internet play would make any significant differences to deficits.', 'web_url': 'https://www.nytimes.com/2012/01/18/us/more-states-look-to-legalize-online-gambling.html', 'snippet': 'Raising revenue remains the draw for most, but some wonder whether profits from Internet play would make any significant differences to deficits.', 'lead_paragraph': 'It has been more than four decades since states began putting numbers runners out of business by starting their own legal lotteries, which now yield them close to $18 billion a year. Now several states are thinking about trying to plug budget gaps by profiting again from their residents’ optimism — by legalizing, licensing and taxing Internet gambling.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/18/us/18gambling-cnd/18gambling-cnd-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/18/us/18gambling-cnd/18gambling-cnd-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/18/us/18gambling-cnd/18gambling-cnd-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/18/us/18gambling-cnd/18gambling-cnd-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/18/us/18gambling-cnd/18gambling-cnd-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'As States Weigh Online Gambling, Profit May Be Small', 'kicker': None, 'content_kicker': None, 'print_headline': 'Mired in Debt, States Pursue Web Gambling', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'States (US)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Budgets and Budgeting', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Gambling', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'E-Commerce', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-01-17T16:20:54+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Michael Cooper', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Cooper', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/de33236e-dbf2-5ed5-bf22-c0f13d66c985', 'word_count': 1067, 'uri': 'nyt://article/de33236e-dbf2-5ed5-bf22-c0f13d66c985'}, {'abstract': 'Alison Riske had defeated Urzula Radwanska twice before. It’s a different story at the Australian Open.', 'web_url': 'https://straightsets.blogs.nytimes.com/2012/01/17/breaking-riskes-serve-radwanska-prevails/', 'snippet': 'Alison Riske had defeated Urzula Radwanska twice before. It’s a different story at the Australian Open.', 'lead_paragraph': 'MELBOURNE, Australia – In the final match of a long day on a distant outside court, Alison Riske of the United States battled for nearly two-and-a-half hours before falling to Urzula Radwanska of Poland.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Breaking Riske’s Serve, Radwanska Prevails', 'kicker': 'Straight Sets', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-01-17T16:22:19+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By JOHN MARTIN', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'MARTIN', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0afc0440-451a-5e90-b1a2-05f7fb70ce89', 'word_count': 173, 'uri': 'nyt://article/0afc0440-451a-5e90-b1a2-05f7fb70ce89'}, {'abstract': 'Under renewed pressure to release his personal income tax returns, Mitt Romney said that he paid a tax rate approaching 15 percent.', 'web_url': 'https://www.nytimes.com/2012/01/18/us/politics/facing-pointed-attacks-romney-urges-focus-on-obama.html', 'snippet': 'Under renewed pressure to release his personal income tax returns, Mitt Romney said that he paid a tax rate approaching 15 percent.', 'lead_paragraph': 'Under growing pressure from rival Republicans to release his tax returns, Mitt Romney said on Tuesday that he paid a tax rate approaching 15 percent on his millions of dollars in annual income but said he would not make public his full return until April.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/17/us/17romney2_cnd/17romney2_cnd-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/17/us/17romney2_cnd/17romney2_cnd-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/17/us/17romney2_cnd/17romney2_cnd-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/17/us/17romney2_cnd/17romney2_cnd-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnai