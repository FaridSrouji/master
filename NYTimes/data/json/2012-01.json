-08T22:17:44+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Jeff Zeleny', 'person': [{'firstname': 'Jeff', 'middlename': None, 'lastname': 'Zeleny', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fe6c2c59-2810-5910-92f4-1d92886f3c81', 'word_count': 442, 'uri': 'nyt://article/fe6c2c59-2810-5910-92f4-1d92886f3c81'}, {'abstract': 'The pop-star power couple Beyoncé, 30, and Jay-Z, 42, welcomed a daughter, Blue Ivy Carter, into the world on Saturday night.', 'web_url': 'https://www.nytimes.com/2012/01/09/arts/music/footnote.html', 'snippet': 'The pop-star power couple Beyoncé, 30, and Jay-Z, 42, welcomed a daughter, Blue Ivy Carter, into the world on Saturday night.', 'lead_paragraph': 'The pop-star power coupleBeyoncé, 30, and Jay-Z, 42, welcomed a daughter, Blue IvyCarter, into the world on Saturdaynight. Jay-Z rented an entirefloor of Lenox Hill Hospital onthe Upper East Side of Manhattanat a cost of $1.3 million, accordingto an online report fromABC’s “Good Morning America.”An official birth announcementfrom representatives of the couplehad not yet been released. ', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Footnote', 'kicker': 'Arts, Briefly', 'content_kicker': None, 'print_headline': 'Footnote', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Jay-Z', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Knowles, Beyonce', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-01-08T22:22:22+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'Compiled by Adam W. Kepler', 'person': [{'firstname': 'Adam', 'middlename': 'W.', 'lastname': 'Kepler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/f367ed59-220d-526b-bae7-a8f226e89422', 'word_count': 57, 'uri': 'nyt://article/f367ed59-220d-526b-bae7-a8f226e89422'}, {'abstract': 'The Pacifica Quartet played Beethoven works at the Metropolitan Museum of Art on Saturday.', 'web_url': 'https://www.nytimes.com/2012/01/09/arts/music/the-pacifica-quartet-at-metropolitan-museum-review.html', 'snippet': 'The Pacifica Quartet played Beethoven works at the Metropolitan Museum of Art on Saturday.', 'lead_paragraph': 'During intermissions at the Metropolitan Museum of Art’s lovably mid-20th-century-modern Grace Rainey Rogers Auditorium it’s possible to wander through the adjacent galleries of Egyptian art. Attending a concert there, you are aware of history. It makes sense that the Met, with its vast holdings dating back millenniums, should emphasize stability and long relationships in its distinguished concert series.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/09/arts/pacifica/pacifica-articleLarge.jpg', 'height': 277, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/09/arts/pacifica/pacifica-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 277}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/09/arts/pacifica/pacifica-jumbo.jpg', 'height': 473, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'So Much Tension, Pulling at These Strings', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'So Much Tension, Pulling at These Strings', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Pacifica Quartet', 'rank': 1, 'major': 'N'}, {'name': 'organizatio