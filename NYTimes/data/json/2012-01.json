r': 'N'}, {'name': 'subject', 'value': 'Police', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-01-28T02:22:22+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Joseph Goldstein', 'person': [{'firstname': 'Joseph', 'middlename': None, 'lastname': 'Goldstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/180d4f4f-4194-533e-b70a-81195efcc03b', 'word_count': 320, 'uri': 'nyt://article/180d4f4f-4194-533e-b70a-81195efcc03b'}, {'abstract': 'Cloud Nothings performed in support of their strong new release, “Attack on Memory,” an album heavily influenced by Steve Albini.', 'web_url': 'https://www.nytimes.com/2012/01/28/arts/music/cloud-nothings-at-the-studio-at-webster-hall.html', 'snippet': 'Cloud Nothings performed in support of their strong new release, “Attack on Memory,” an album heavily influenced by Steve Albini.', 'lead_paragraph': 'Here’s what working with Steve Albini can do for your band, as evinced by “Attack on Memory” (Carpark), the strong new album by the Cleveland outfit Cloud Nothings. Like a preset mode in ProTools or other recording programs, there is an Albini sound: the drums hit with a certain crispness, and there’s a mild claustrophobia to the proceedings. Mr Albini, who engineered the new album, can only give the Albini.', 'print_section': 'C', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/30/arts/cloud/cloud-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/30/arts/cloud/cloud-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type'