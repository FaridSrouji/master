rce': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Carrefour Said to Seek Chief Executive', 'kicker': None, 'content_kicker': None, 'print_headline': 'Carrefour Is Said to Seek Chief Executive', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Shopping and Retail', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Suspensions, Dismissals and Resignations', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'France', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-26T21:55:37+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Global Business', 'byline': {'original': 'By David Jolly', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Jolly', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7affabb8-ee8f-547d-a542-cd4e14cd46cc', 'word_count': 172, 'uri': 'nyt://article/7affabb8-ee8f-547d-a542-cd4e14cd46cc'}, {'abstract': 'Liam Neeson leads a group of men stranded in Alaska after a plane crash in Joe Carnahan’s film “The Grey,” a lean, stripped-down tale of survival in brutal circumstances.', 'web_url': 'https://www.nytimes.com/2012/01/27/movies/liam-neeson-in-joe-carnahans-thriller-the-grey.html', 'snippet': 'Liam Neeson leads a group of men stranded in Alaska after a plane crash in Joe Carnahan’s film “The Grey,” a lean, stripped-down tale of survival in brutal circumstances.', 'lead_paragraph': '“The Grey” continues what has become a welcome seasonal movie tradition. For the past three winters, just when the Oscar nominees you’ve missed are trying to dazzle and guilt-trip you with visions of Importance, a lean and angry Liam Neeson shows up at the multiplex, out for righteous payback or at least the paycheck that no one would dare begrudge him. Buy a ticket, punk! Having paid his quality biopic dues as Oskar Schindler, Michael Collins and Alfred Kinsey, Mr. Neeson has, at least for now, turned to the rougher and perhaps more lucrative work of action heroism. It takes nothing away from his earlier achievements to note that he’s really good at it. He conveys a ferocious and absolute seriousness even when the going gets silly, and he finds the soul in each new angry-everyman cipher he is asked to play.', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/27/arts/27GREY_SPAN/27GREY_SPAN-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/27/arts/27GREY_SPAN/27GREY_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/27/arts/27GREY_SPAN/27GREY_SPAN-jumbo-v2.jpg', 'height': 578, 'width': 1017, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/27/arts/27GREY_SPAN/27GREY_SPAN-superJumbo.jpg', 'height': 578, 'width': 1017, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/27/arts/27GREY_SPAN/27GREY_SPAN-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/27/arts/27GREY_SPAN/27GREY_SPAN-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'In Man vs. Wolf Pack, Survival of the Flintiest', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'In Man vs. Wolf Pack, Survival of the Flintiest', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Neeson, Liam', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Carnahan, Joe', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Mulroney, Dermot', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-01-26T21:57:16+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By A.O. Scott', 'person': [{'firstname': 'A.', 'middlename': 'O.', 'lastname': 'Scott', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/328ac1c4-234f-5c54-84dc-d68dd92a252e', 'word_count': 964, 'uri': 'nyt://article/328ac1c4-234f-5c54-84dc-d68dd92a252e'}, {'abstract': '“Spartacus” returns to the Starz channel for a second season, with a new star and a focus on war rather than gladiatorial combat.', 'web_url': 'https://www.nytimes.com/2012/01/27/arts/television/spartacus-vengeance-returns-to-starz-channel.html', 'snippet': '“Spartacus” returns to the Starz channel for a second season, with a new star and a focus on war rather than gladiatorial combat.', 'lead_paragraph': '“Spartacus,” the Starz channel’s costume-optional drama set in the waning years of the Roman Republic, returns for a second season on Friday night with the four B’s of its appeal intact: beefcake, blood, breasts and the Bard. (The fourth B refers to the show’s solemn, mock Elizabethan dialogue, light on definite articles — “When ritual is ended, see blood cleansed” — but studded with profanity.)', 'print_section': 'C', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/27/arts/27SPARTACUS/SPARTACUS-jumbo.jpg', 'height': 1024, 'width': 682, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'ima