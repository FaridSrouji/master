bnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Byron Donzis, Inventor of Football Flak Jacket, Dies at 79', 'kicker': None, 'content_kicker': None, 'print_headline': 'Byron Donzis, 79; Inventor Softened Football’s Blows', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Inventions and Patents', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-19T05:52:04+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Dennis Hevesi', 'person': [{'firstname': 'Dennis', 'middlename': None, 'lastname': 'Hevesi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/a42f5b37-b09f-5451-ba06-1d9286c95fdf', 'word_count': 679, 'uri': 'nyt://article/a42f5b37-b09f-5451-ba06-1d9286c95fdf'}, {'abstract': 'David Axelrod, a strategist who guided Barack Obama onto the national political stage, will run the new Institute of Politics at the University of Chicago after 2012.', 'web_url': 'https://www.nytimes.com/2012/01/19/us/axelrod-going-to-academia-after-2012-election.html', 'snippet': 'David Axelrod, a strategist who guided Barack Obama onto the national political stage, will run the new Institute of Politics at the University of Chicago after 2012.', 'lead_paragraph': 'CHICAGO — David Axelrod, the longtime political strategist for Barack Obama, is already making plans for after the 2012 election, and they do not involve another candidate or another trip to Iowa. Mr. Axelrod says he plans to lead a new, nonpartisan Institute of Politics at the University of Chicago aimed at helping students seeking careers in public and social service.', 'print_section': 'A', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/19/us/AXELROD/AXELROD-jumbo.jpg', 'height': 1024, 'width': 708, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/19/us/AXELROD/AXELROD-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/19/us/AXELROD/AXELROD-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Obama Strategist Plans Post-Vote Academic Role', 'kicker': None, 'content_kicker': None, 'print_headline': 'Obama Strategist Plans Post-Vote Academic Role', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Axelrod, David', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Chicago', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Colleges and Universities', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Chicago (Ill)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-01-19T06:01:45+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Monica Davey', 'person': [{'firstname': 'Monica', 'middlename': None, 'lastname': 'Davey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e6c43eda-d5bf-5c63-8c8f-e5c357993727', 'word_count': 525, 'uri': 'nyt://article/e6c43eda-d5bf-5c63-8c8f-e5c357993727'}, {'abstract': 'Wikipedia returned to normal at midnight Thursday after a daylong protest against two online piracy bills. According to Wikipedia, more than 162 million visitors to the site on Wednesday saw the protest. More than 12,000 commented on a blog post announcing the blackout, with a “breathtaking majority” supporting it, the site said.', 'web_url': 'https://bits.blogs.nytimes.com/2012/01/19/after-protest-wikipedia-says-were-not-done-yet/', 'snippet': 'Wikipedia returned to normal at midnight Thursday after a daylong protest against two online piracy bills. According to Wikipedia, more than 162 million visitors to the site on Wednesday saw the protest. More than 12,000 commented on a blog post a...', 'lead_paragraph': 'The (day)long national nightmare is over.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'After Protest, Wikipedia Says ‘We’re Not Done Yet’', 'kicker': 'Bits', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Copyrights and Copyright Violations', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Wikipedia', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-01-19T06:02:08+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By Matt Flegenheimer', 'person': [{'firstname': 'Matt', 'middlename': None, 'lastname': 'Flegenheimer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f35b7b4c-aa4d-5081-b23a-6e4ca7575744', 'word_count': 260, 'uri': 'nyt://article/f35b7b4c-aa4d-5081-b23a-6e4ca7575744'}, {'abstract': 'The Suns’ point guard, who can be a free agent after the season, led Phoenix to a 91-88 victory over the struggling Knicks.', 'web_url': 'https://www.nytimes.com/2012/01/19/sports/basketball/steve-nash-shows-knicks-what-theyre-missing.html', 'snippet': 'The Suns’ point guard, who can be a free agent after the season, led Phoenix to a 91-88 victory over the struggling Knicks.', 'lead_paragraph': 'Steve Nash raised his arms triumphantly near halfcourt. It was not his corner 3-pointer that bounced off the rim and kissed the top of the backboard before falling through the net to give the Phoenix Suns a 5-point lead with 35 seconds to play. It was Shannon Brown’s. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Nash Shows Knicks What They’re Missing', 'kicker': None, 'content_kicker': None, 'print_headline': 'Nash Shows Knicks What They’re Missing', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Basketball', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Times', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Phoenix Suns', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Nash, Steve', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-01-19T06:05:40+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Basketball', 'byline': {'original': 'By Jake Appleman', 'person': [{'firstname': 'Jake', 'middlename': None, 'lastname': 'Appleman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/299d4950-620c-58ef-a1fd-b9cdf689b8ff', 'word_count': 656, 'uri': 'nyt://article/299d4950-620c-58ef-a1fd-b9cdf689b8ff'}, {'abstract': 'Eastman Kodak, the 131-year-old film pioneer that has been struggling for years to adapt to an increasingly digital world, ran short of cash before a turnaround effort could succeed.', 'web_url': 'https://dealbook.nytimes.com/2012/01/19/eastman-kodak-files-for-bankruptcy/', 'snippet': 'Eastman Kodak, the 131-year-old film pioneer that has been struggling for years to adapt to an increasingly digital world, ran short of cash before a turnaround effort could succeed.', 'lead_paragraph': 'Eastman Kodak, the 131-year-old film pioneer that has been struggling for years to adapt to an increasingly digital world, filed for bankruptcy protection early on Thursday.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Eastman Kodak Files for Bankruptcy', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Bankruptcies', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cameras', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Inventions and Patents', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Eastman Kodak Company', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-01-19T06:12:59+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Michael J. de la Merced', 'person': [{'firstname': 'Michael', 'middlename': 'J.', 'lastname': 'de la Merced', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/19bd6b98-7e25-56d2-8e8f-99efc4bb360d', 'word_count': 859, 'uri': 'nyt://article/19bd6b98-7e25-56d2-8e8f-99efc4bb360d'}, {'abstract': 'Americans Raquel Kops-Jones and Abigail Spears lost Thursday as women’s doubles play began at the Australian Open.', 'web_url': 'https://straightsets.blogs.nytimes.com/2012/01/19/kops-jones-and-spears-fall-to-unseeded-pair/', 'snippet': 'Americans Raquel Kops-Jones and Abigail Spears lost Thursday as women’s doubles play began at the Australian Open.', 'lead_paragraph': 'MELBOURNE, Australia – The Americans Raquel Kops-Jones and Abigail Spears, seeded 15th, lost on Thursday to an unseeded pair, Julia Görges of Germany and Kaia Kanepi of Estonia, in the first round of women’s doubles play at the Australian Open.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Kops-Jones and Spears Fall to Unseeded Pair', 'kicker': 'Straight Sets', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-01-19T07:49:00+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By JOHN MARTIN', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'MARTIN', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3c7ae8e2-172b-5997-bcf0-f1a085c1eb30', 'word_count': 232, 'uri': 'nyt://article/3c7ae8e2-172b-5997-bcf0-f1a085c1eb30'}, {'abstract': 'Prime Minister Yousaf Raza Gilani received a brief respite as he appeared before Pakistan’s Supreme Court to defend himself from contempt charges.', 'web_url': 'https://www.nytimes.com/2012/01/20/world/asia/pakistan-prime-minister-gilani-appears-before-court.html', 'snippet': 'Prime Minister Yousaf Raza Gilani received a brief respite as he appeared before Pakistan’s Supreme Court to defend himself from contempt charges.', 'lead_paragraph': 'ISLAMABAD, Pakistan — A bitter legal clash between Pakistan’s top court and its civilian government inched toward resolution on Thursday as the prime minister made a dramatic court appearance to ward off possible imprisonment while his legal team agreed to engage the court over the key issue of presidential immunity. ', 'print_section': 'A', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/20/world/asia/20pakistan-a/20pakistan-a-jumbo.jpg', 'height': 1024, 'width': 778, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/20/world/asia/20pakistan-a/20pakistan-a-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/20/world/asia/20pakistan-a/20pakistan-a-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Pakistan’s Prime Minister Makes Plea to Avoid Jail Time', 'kicker': None, 'content_kicker': None, 'print_headline': 'Pakistan’s Prime Minister Makes Plea to Avoid Jail', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Gilani, Yousaf Raza', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Zardari, Asif Ali', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Courts and the Judiciary', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Pakistan', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Corruption (Institutional)', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-01-19T07:56:54+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Declan Walsh', 'person': [{'firstname': 'Declan', 'middlename': None, 'lastname': 'Walsh', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ba691b79-3aae-5f8c-99b4-5e1bea0e9898', 'word_count': 752, 'uri': 'nyt://article/ba691b79-3aae-5f8c-99b4-5e1bea0e9898'}, {'abstract': 'Michael Bradley has settled in with his new team, Chievo Verona in Italy’s Serie A.', 'web_url': 'https://goal.blogs.nytimes.com/2012/01/19/michael-bradley-in-italy-hes-bravissimo/', 'snippet': 'Michael Bradley has settled in with his new team, Chievo Verona in Italy’s Serie A.', 'lead_paragraph': 'VERONA, Italy — “He’s a painting with lots of different colors,” said Tommaso Franco, the press officer of the Italian Serie A team Chievo Verona, about the United States international Michael Bradley. “There’s red, there’s blue, there’s yellow. He’s bravissimo.”', 'source': 'The New