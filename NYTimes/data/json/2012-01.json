/25GAGA_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/25/dining/25GAGA_SPAN/25GAGA-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/25/dining/25GAGA_SPAN/25GAGA_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/25/dining/25GAGA_SPAN/25GAGA_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Low-Key Spot With a High-Wattage Connection', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Low-Key Spot With a High-Wattage Connection', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Upper West Side (NYC)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Restaurants', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Lady Gaga', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-24T21:17:26+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Matt Flegenheimer', 'person': [{'firstname': 'Matt', 'middlename': None, 'lastname': 'Flegenheimer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bb678832-d68d-5061-befa-87916e61d2f9', 'word_count': 625, 'uri': 'nyt://article/bb678832-d68d-5061-befa-87916e61d2f9'}, {'abstract': 'In a grueling match vs. Tomas Berdych at the Australian Open, Rafael Nadal uses his fitness to prevail.', 'web_url': 'https://straightsets.blogs.nytimes.com/2012/01/24/in-nadal-vs-berdych-conditioning-makes-a-difference/', 'snippet': 'In a grueling match vs. Tomas Berdych at the Australian Open, Rafael Nadal uses his fitness to prevail.', 'lead_paragraph': 'Rafael Nadal withstood a barrage of huge serving and heavy, punishing groundstrokes from Tomas Berdych, prevailing in four grueling sets to advance to the semifinals. The level of play throughout the four hour and sixteen minute match was high, as both players hit more winners than unforced errors. Berdych hit 66 winners while making 56 unforced errors; Nadal had 57 winners and made only 30 unforced errors. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In Nadal Vs. Berdych, Conditioning Makes a Difference', 'kicker': 'Straight Sets', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-01-24T21:20:29+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By GEOFF MACDONALD', 'person': [{'firstname': 'Geoff', 'middlename': None, 'lastname': 'MACDONALD', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/60b94cd1-3888-5928-97fd-9c3d465f4428', 'word_count': 536, 'uri': 'nyt://article/60b94cd1-3888-5928-97fd-9c3d465f4428'}, {'abstract': 'The Tigers have agreed to terms with Prince Fielder on a nine-year, $214 million contract.', 'web_url': 'https://bats.blogs.nytimes.com/2012/01/24/tigers-make-free-agency-splash-sign-fielder/', 'snippet': 'The Tigers have agreed to terms with Prince Fielder on a nine-year, $214 million contract.', 'lead_paragraph': 'The Detroit Tigers are on the verge of pulling off one of the biggest free-agent deals of the off-season, having come to terms with slugger Prince Fielder on a nine-year, $214 million deal, according to multiple team sources. The signing was quickly reported by FoxSports and others.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Tigers Make Free-Agency Splash, Sign Fielder', 'kicker': 'Bats', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Fielder, Prince', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Detroit Tigers', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-01-24T21:22:23+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Joanne C. Gerstner', 'person': [{'firstname': 'Joanne', 'middlename': 'C.', 'lastname': 'Gerstner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/30fe8351-b116-55b0-a3d9-a698d7afd84b', 'word_count': 403, 'uri': 'nyt://article/30fe8351-b116-55b0-a3d9-a698d7afd84b'}, {'abstract': 'Despite the weak economy, consumers are still splurging on the little things, a new survey finds.', 'web_url': 'https://economix.blogs.nytimes.com/2012/01/24/adding-up-those-coffees-at-work/', 'snippet': 'Despite the weak economy, consumers are still splurging on the little things, a new survey finds.', 'lead_paragraph': 'While a weak economy may have driven consumers to cut back, we know that they are still indulging on the little things.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Adding Up Those Coffees at Work', 'kicker': 'Economix', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Coffee', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Personal Finances', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Workplace Environment', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-01-24T21:27:25+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Motoko Rich', 'person': [{'firstname': 'Motoko', 'middlename': None, 'lastname': 'Rich', 'qualifie