nk': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'New York State', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Cuomo, Andrew M', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-01-05T03:02:40+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Danny Hakim', 'person': [{'firstname': 'Danny', 'middlename': None, 'lastname': 'Hakim', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News Analysis', '_id': 'nyt://article/45020a2c-5dfb-502b-9eb6-953206cd4c73', 'word_count': 888, 'uri': 'nyt://article/45020a2c-5dfb-502b-9eb6-953206cd4c73'}, {'abstract': 'One factor has condemned the Brooklyn-Queens Expressway to a place of longstanding infamy in the New York metropolitan area, if not all of urban America: construction that never seems to end.', 'web_url': 'https://www.nytimes.com/2012/01/05/nyregion/on-the-bqe-road-work-ahead-forever.html', 'snippet': 'One factor has condemned the Brooklyn-Queens Expressway to a place of longstanding infamy in the New York metropolitan area, if not all of urban America: construction that never seems to end.', 'lead_paragraph': 'Wilfredo Torres spotted the pothole ahead of him. He knew that if he swerved, he would veer into the next lane and cause an accident. If he slowed, he would probably be rammed from behind by a tractor-trailer. ', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/05/nyregion/BQE1/BQE1-articleLarge-v2.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/05/nyregion/BQE1/BQE1-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'ca