it': None, 'type': 'image', 'url': 'images/2016/08/14/travel/14SESSAYJP/14SESSAYJP-superJumbo.jpg', 'height': 1313, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/14/travel/14SESSAYJP/14SESSAYJP-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/08/14/travel/14SESSAYJP/14SESSAYJP-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/14/travel/14SESSAYJP/14SESSAYJP-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'I Lost My Job and My Husband. Then I Found Newfoundland.', 'kicker': 'Summertime', 'content_kicker': None, 'print_headline': 'An Escape From the Past Proves a Balm for Wounds', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Newfoundland (Canada)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Canada', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Series', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-08-11T10:00:06+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Sara Novic', 'person': [{'firstname': 'Sara', 'middlename': None, 'lastname': 'Novic', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6407b270-cc8c-52b2-b602-98b31d6496bb', 'word_count': 2026, 'uri': 'nyt://article/6407b270-cc8c-52b2-b602-98b31d6496bb'}, {'abstract': 'Historically, the appearance of cancer was (wrongly) attributed to the repressed anger of patients. In fact, contagious rage is not the cause but may be an effect.', 'web_url': 'https://well.blogs.nytimes.com/2016/08/11/the-anger-of-cancer/', 'snippet': 'Historically, the appearance of cancer was (wrongly) attributed to the repressed anger of patients. In fact, contagious rage is not the cause but may be an effect.', 'lead_paragraph': 'While dealing with lung cancer, my friend Nancy K. Miller seethed in her blog at pharmaceutical advertisements and hospital commercials that bombard us daily with pictures of joyous cancer patients supported by doting intimates. These jubilant characters have nothing to do with the frustrated people we know who periodically erupt in righteous indignation. I often must remind myself that anger needs to be understood as the flip side of the roiling fear that cancer instills in patients and also in caregivers.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/04/well/well_gubar/well_gubar-articleLarge.jpg', 'height': 799, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/08/04/well/well_gubar/well_gubar-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 799}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/04/well/well_gubar/well_gubar-jumbo.jpg', 'height': 1024, 'width': 770, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/04/well/well_gubar/well_gubar-superJumbo.jpg', 'height': 1998, 'width': 1501, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/04/well/well_gubar/well_gubar-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/08/04/well/well_gubar/well_gubar-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/04/well/well_gubar/well_gubar-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Anger of Cancer', 'kicker': 'Well', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ANGER (EMOTION)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cancer', 'rank': 2, 'major': 'N'}], 'pub_date': '2016-08-11T10:00:22+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Health', 'byline': {'original': 'By Susan Gubar', 'person': [{'firstname': 'Susan', 'middlename': None, 'lastname': 'Gubar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/316daa0d-38aa-5b49-a624-44e56e12ed12', 'word_count': 800, 'uri': 'nyt://article/316daa0d-38aa-5b49-a624-44e56e12ed12'}, {'abstract': 'Thursday: The Perseids meteor shower, a climb up Trump Tower, and a shark-tagging expedition.', 'web_url': 'https://www.nytimes.com/2016/08/11/nyregion/new-york-today-a-marvelous-meteor-shower-perseids.html', 'snippet': 'Thursday: The Perseids meteor shower, a climb up Trump Tower, and a shark-tagging expedition.', 'lead_paragraph': 'Updated, 8:20 a.m.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/11/nyregion/11NYTODAY1/11NYTODAY1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/08/11/nyreg