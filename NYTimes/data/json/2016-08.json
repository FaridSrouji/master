ds': [{'name': 'organizations', 'value': 'Boucheron', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Jewels and Jewelry', 'rank': 2, 'major': 'N'}], 'pub_date': '2016-08-10T16:27:06+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'subsection_name': 'Fashion & Beauty', 'byline': {'original': 'By Nancy Hass', 'person': [{'firstname': 'Nancy', 'middlename': None, 'lastname': 'Hass', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/522b8cb7-c3d7-5e33-8d43-5b836a4e1a57', 'word_count': 77, 'uri': 'nyt://article/522b8cb7-c3d7-5e33-8d43-5b836a4e1a57'}, {'abstract': 'How a stager turned my home into something I didn’t recognize — and couldn’t imagine living in.', 'web_url': 'https://www.nytimes.com/2016/08/11/fashion/real-estate-home-staging-buyers-clutter.html', 'snippet': 'How a stager turned my home into something I didn’t recognize — and couldn’t imagine living in.', 'lead_paragraph': 'SANTA BARBARA, Calif. — On a recent Friday evening I pulled into the driveway of the weekend home in Santa Barbara that my partner and I have shared for the last couple of years — and registered the first in a series of “Twilight Zone”-ish shocks. The car headlights swept the glass sliders of our modern house, illuminating a reconfiguration of the living room furniture so curious, I half-suspected slippage on the Ventura Fault.', 'print_section': 'D', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/11/fashion/11STAGING/11STAGING-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/08/11/fashion/11STAGING/11STAGING-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption