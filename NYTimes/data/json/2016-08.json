or': 'N'}], 'pub_date': '2016-08-11T15:12:55+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Matt Flegenheimer and Amy Chozick', 'person': [{'firstname': 'Matt', 'middlename': None, 'lastname': 'Flegenheimer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Amy', 'middlename': None, 'lastname': 'Chozick', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/73435bbe-12ca-5f51-9b63-ed9fa6ce0648', 'word_count': 1218, 'uri': 'nyt://article/73435bbe-12ca-5f51-9b63-ed9fa6ce0648'}, {'abstract': 'The twin brothers have a runaway hit in their Netflix series, which wears the influences of an era on its small-screen sleeve.', 'web_url': 'https://www.nytimes.com/2016/08/14/arts/television/stranger-things-netflix-duffer-brothers-interview.html', 'snippet': 'The twin brothers have a runaway hit in their Netflix series, which wears the influences of an era on its small-screen sleeve.', 'lead_paragraph': 'On paper, the plot of the series “Stranger Things,” a runaway summer hit from Netflix, reads like a Dungeons & Dragons campaign. And an early scene takes place in a suburban Indiana basement in 1983, with four adolescent boys debating the best way to defeat a mythical Demogorgon. When a version of that creature enters their world, the show unfolds into an interdimensional tribute to classic ’80s fantasy, sci-fi and horror, with nods to “Alien”; “E.T.: The Extraterrestrial”; “A Nightmare on Elm Street”; and Stephen King’s 1986 novel, “It.” Since its release in July, the series has attracted a wave of internet attention, with detailed examinations of its cinematic and cultural references — including a deep dive into the characters’ corduroy wardrobes.', 'print_section': 'AR', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/14/arts/14DUFFER1/14DUFFER1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/08/14/arts/14DUFFER1/14DUFFER1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/14/arts/14DUFFER1/14DUFFER1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/14/arts/14DUFFER1/14DUFFER1-articleLarge.jpg', 'height': 346, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/08/14/arts/14DUFFER1/14DUFFER1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 346}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/14/arts/14DUFFER1/14DUFFER1-jumbo.jpg', 'height': 590, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/14/arts/14DUFFER1/14DUFFER1-superJumbo.jpg', 'height': 1181, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Matt and Ross Duffer Discuss ‘Stranger Things,’ a Nightmare on ’80s Street', 'kicker': 'Ask a Showrunner', 'content_kicker': None, 'print_headline': 'A Nightmare on ’80s Street', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Cohen, Finn', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Web-Original Programming', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Duffer, Matt', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Duffer, Ross', 'rank': 5, 'major': 'N'}, {'name': 'creative_works', 'value': 'Stranger Things (TV Program)', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-08-11T15:17:01+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Finn Cohen', 'person': [{'firstname': 'Finn', 'middlename': None, 'lastname': 'Cohen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b7d75397-6d9d-5b30-8bb3-da199ca0ba0f', 'word_count': 1668, 'uri': 'nyt://article/b7d75397-6d9d-5b30-8bb3-da199ca0ba0f'}, {'abstract': '“I’m thinking, if I expire in the pool, what the hell, I’m old. How much longer have I got, anyway?”', 'web_url': 'https://www.nytimes.com/2016/08/14/nyregion/learning-to-swim-at-75.html', 'snippet': '“I’m thinking, if I expire in the pool, what the hell, I’m old. How much longer have I got, anyway?”', 'lead_paragraph': 'If you like stories about courageous people with terrible handicaps who surmount insurmountable odds to attain a glorious triumph and then run around high-fiving everyone and shrieking “whoo” while stirring music plays in the background, this isn’t the one for you. But I did learn to swim at age 75. That’s worth something, no? Maybe a seal clapping ironically?', 'print_section': 'MB', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/14/nyregion/14FITCITY1/14FITCITY1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/08/14/nyregion/14FITCITY1/14FITCITY1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'ty