le': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5259aca1-7548-54b0-be35-aad52a369ff9', 'word_count': 820, 'uri': 'nyt://article/5259aca1-7548-54b0-be35-aad52a369ff9'}, {'abstract': 'Verb Cafe, now in Greenpoint, serves new customers along with those who still remember its Williamsburg past.', 'web_url': 'https://www.nytimes.com/2016/08/14/nyregion/verb-cafe-greenpoint-brooklyn-priced-out.html', 'snippet': 'Verb Cafe, now in Greenpoint, serves new customers along with those who still remember its Williamsburg past.', 'lead_paragraph': 'Verb Cafe was a shabby, cash-only space in Williamsburg that had no Wi-Fi but served good coffee for 15 years. Naturally, it got priced out of its Bedford Avenue storefront. The store that replaced the Verb in the summer of 2014, Soap Cherie, sells soaps in the shape of cupcakes. Locals bemoaned it as the latest loss in a gentrifying city. The artist Molly Crabapple wrote on Twitter,  “New York is change, I know, but still, can’t believe CBGB’s is dead and the Chelsea Hotel is gutted and Verb is now a soap shop.”', 'print_section': 'MB', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/14/nyregion/14JOINT1web/14JOINT1web-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/08/14/nyregion/14JOINT1web/14JOINT1web-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/14/nyregion/14JOINT1web/14JOINT1web-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/14/nyregion/14JOINT1web/14JOINT1web-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/08/14/nyregion/14JOINT1web/14JOINT1web-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/14/nyregion/14JOINT1web/14JOINT1web-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/14/nyregion/14JOINT1web/14JOINT1web-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Once Priced Out, a Cafe Returns in Greenpoint', 'kicker': None, 'content_kicker': None, 'print_headline': 'Conjugated Again, a Mile Away', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Verb Cafe (Brooklyn, NY, Restaurant)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Restaurants', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Coffee', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Greenpoint (Brooklyn, NY)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Williamsburg (Brooklyn, NY)', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-08-12T18:17:53+0000', 'document_type': 'article', 'news_desk': 'Metropolitan', 'section_name': 'New York', 'byline': {'original': 'By Jackie Snow', 'person': [{'firstname': 'Jackie', 'middlename': None, 'lastname': 'Snow', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2456a2eb-32e4-5563-876c-d30f989934d4', 'word_count': 643, 'uri': 'nyt://article/2456a2eb-32e4-5563-876c-d30f989934d4'}, {'abstract': 'Conversation on the board or platform by a pair at the Rio Olympics varies from “Ready?” and “Yes” to the ritual citation of a short biblical passage.', 'web_url': 'https://www.nytimes.com/2016/08/13/sports/olympics/synchronized-diving-talk-rio-games.html', 'snippet': 'Conversation on the board or platform by a pair at the Rio Olympics varies from “Ready?” and “Yes” to the ritual citation of a short biblical passage.', 'lead_paragraph': 'RIO DE JANEIRO — Poised far above a swimming pool, about to somersault four and a half times into the water — that is no moment for a philosophical discussion, even if there is a person standing right next to you. But practitioners of the curiously mesmerizing sport of synchronized diving, who aim for dives that are not only perfect but also perfectly in sync, tend to have their own last-minute communication rituals.', 'print_section': 'B', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/13/sports/13SYNCHROweb/13SYNCHROweb-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/08/13/sports/13SYNCHROweb/13SYNCHROweb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/13/sports/13SYNCHROweb/13SYNCHROweb-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/13/sports/13SYNCHROweb/13SYNCHROweb-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/13/sports/13SYNCHROweb/13SYNCHROweb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': 