 in New York reversed a ruling that had held the Palestinian Authority and the Palestine Liberation Organization liable for supporting attacks in Israel that killed Americans.', 'lead_paragraph': 'A federal appeals court in New York has thrown out a $655.5 million verdict rendered last year that had held the Palestinian Authority and the Palestine Liberation Organization liable for their roles in supporting terrorist attacks in Israel that claimed American lives.', 'print_section': 'A', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Court Throws Out $655.5 Million Terrorism Verdict Against Palestinian Groups', 'kicker': None, 'content_kicker': None, 'print_headline': 'Court Throws Out $655.5 Million Verdict in Terror Case Against Palestinian Groups', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Terrorism', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Suits and Litigation (Civil)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Palestinian Authority', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Palestine Liberation Organization', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Israel', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Koeltl, John G', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Leval, Pierre N', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Droney, Christopher F', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'Palestinians', 'rank': 10, 'major': 'N'}], 'pub_date': '2016-08-31T18:25:30+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Benjamin Weiser', 'person': [{'firstname': 'Benjamin', 'middlename': None, 'lastname': 'Weiser', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0ddfdd8d-fc67-5caa-945a-5b33057