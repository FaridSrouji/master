'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 4, 'major': 'N'}], 'pub_date': '2016-08-28T15:58:13+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Albert R. Hunt | Bloomberg View', 'person': [{'firstname': 'Albert', 'middlename': 'R.', 'lastname': 'Hunt', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/587bf5a8-80bc-5834-88d3-56baca0c0261', 'word_count': 632, 'uri': 'nyt://article/587bf5a8-80bc-5834-88d3-56baca0c0261'}, {'abstract': 'To help highlight the availability of Wi-Fi service in underground stations, Penguin Random House is offering downloadable short stories and book excerpts.', 'web_url': 'https://www.nytimes.com/2016/08/29/nyregion/new-york-subway-free-e-books.html', 'snippet': 'To help highlight the availability of Wi-Fi service in underground stations, Penguin Random House is offering downloadable short stories and book excerpts.', 'lead_paragraph': 'Rainier Velardo watched the basketball-player-tall man in the blue shirt who sat down next to him — the man had gotten on at the last subway stop, West Fourth Street in Manhattan, and this was an F train going to Brooklyn. Mr. Velardo watched the man tap the screen of an iPad. He heard the man chuckle and say: “You’d think I would know this. I wrote it.” And then, with even more of a chuckle, “Didn’t see that twist coming.”', 'print_section': 'A', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/20/nyregion/22GRACE2/22GRACE2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/08/20/nyregion/22GRACE2/22GRACE2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailh