arge', 'legacy': {}}], 'headline': {'main': 'Finding Refuge With the Skin I’m In', 'kicker': 'Disability', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Skin', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Medicine and Health', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Genetics and Heredity', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Disabilities', 'rank': 4, 'major': 'N'}], 'pub_date': '2016-08-24T17:54:10+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Anne Kaier', 'person': [{'firstname': 'Anne', 'middlename': None, 'lastname': 'Kaier', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/b9881f4f-0ed3-508a-9654-cb068a24178a', 'word_count': 1319, 'uri': 'nyt://article/b9881f4f-0ed3-508a-9654-cb068a24178a'}, {'abstract': 'The gallerist and flower and scent designer Eric Buterbaugh has created a site-specific installation with the designer Chuck Moffit.', 'web_url': 'https://www.nytimes.com/2016/08/24/t-magazine/design/eric-buterbaugh-chuck-moffit-promise-of-nectar.html', 'snippet': 'The gallerist and flower and scent designer Eric Buterbaugh has created a site-specific installation with the designer Chuck Moffit.', 'lead_paragraph': 'In the midst of Los Angeles’s enduring drought, a meadow — albeit one forged from bronze and blackened steel — grows in West Hollywood. At his eponymous gallery on Thursday, Eric Buterbaugh opens “Chuck Moffit: With the Promise of Nectar,” a collaborative installation that, in true L.A. fashion, is a crossover of genres. In an unlikely pairing, the gallerist-cum-flower-and-scent designer is creating a site-specific installation of purple dahlias and custom scents in response to a new collection of Moffit’s sculptural furniture, which he made by hand in his lone studio on the high-altitude slopes of Mount Baldy.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/24/t-magazine/24tmag-moffitt01/24tmag-moffitt01-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/08/24/t-magazine/24tmag-moffitt01/24tmag-moffitt01-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/24/t-magazine/24tmag-moffitt01/24tmag-moffitt01-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/24/t-magazine/24tmag-moffitt01/24tmag-moffitt01-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/24/t-magazine/24tmag-moffitt01/24tmag-moffitt01-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/08/24/t-magazine/24tmag-moffitt01/24tmag-moffitt01-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/24/t-magazine/24tmag-moffitt01/24tmag-moffitt01-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In One L.A. Gallery, Flowers and Furniture Combine', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'val