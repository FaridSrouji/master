'credit': None, 'type': 'image', 'url': 'images/2016/08/16/blogs/16-lens-jazz-slide-PDAP/16-lens-jazz-slide-PDAP-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/16/blogs/16-lens-jazz-slide-PDAP/16-lens-jazz-slide-PDAP-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Hearing Music in Photos of Jazz Giants', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2016-08-16T08:06:05+0000', 'document_type': 'multimedia', 'news_desk': 'Blogs', 'section_name': 'Blogs', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/4e5370b0-4edc-55f4-b198-a374f8a53113', 'word_count': 0, 'uri': 'nyt://slideshow/4e5370b0-4edc-55f4-b198-a374f8a53113'}, {'abstract': 'A new book features Ted Williams’s photos of the jazz world, a record of a life spent listening through his camera.', 'web_url': 'https://lens.blogs.nytimes.com/2016/08/16/hearing-music-in-photos-of-jazz-giants/', 'snippet': 'A new book features Ted Williams’s photos of the jazz world, a record of a life spent listening through his camera.', 'lead_paragraph': 'A good jazz photograph tells its story musically as much as visually. More than images of rock, classical or hip-hop musicians, jazz images, like those of Ted Williams, who studied saxophone and clarinet before picking up the camera after World War II, seem to capture the intangible essence of a thought being transformed into sound. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Hearing Music in Photos of Jazz Giants', 'kicker': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Jazz', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Williams, Ted (1925-2009)', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-08-16T09:00:01+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By John Leland', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Leland', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9e75110a-a0c2-552a-b358-e5c0cad289a0', 'word_count': 393, 'uri': 'nyt://article/9e75110a-a0c2-552a-b358-e5c0cad289a0'}, {'abstract': 'Is David Duke racist? Obama? Trump? Beyoncé? Ever since we decided racism was a character flaw, not an institutional one, it became easier to toss the charge around — and harder to make it stick.', 'web_url': 'https://www.nytimes.com/2016/08/21/magazine/the-easiest-way-to-get-rid-of-racism-just-redefine-it.html', 'snippet': 'Is David Duke racist? Obama? Trump? Beyoncé? Ever since we decided racism was a character flaw, not an institutional one, it became easier to toss the charge around — and harder to make it stick.', 'lead_paragraph': 'On its face, inviting a former grand wizard of the Ku Klux Klan onto your radio show is a risky proposition with very little upside. The situation gets even more precarious when you’re inviting this ex-wizard to dole out opinions on race. But these are wild times we’re living in, which is why David Duke — who has emerged as a top cheerleader for the Republican presidential nominee, Donald J. Trump — appeared on N.P.R.’s “Morning Edition” two weeks ago and defended the candidate from charges of racism.', 'print_section': 'MM', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/21/magazine/21firstwords-copy/21mag-21firstwords-t_CA0-articleLarge.jpg', 'height': 592, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/08/21/magazine/21firstwords-copy/21mag-21firstwords-t_CA0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 592}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/21/magazine/21firstwords-copy/21mag-21firstwords-t_CA0-jumbo.jpg', 'height': 1010, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/21/magazine/21firstwords-copy/21mag-21firstwords-t_CA0-superJumbo.jpg', 'height': 1433, 'width': 1453, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/21/magazine/21firstwords-copy/21mag-21firstwords-t_CA0-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/08/21/magazine/21firstwords-copy/21mag-21firstwords-t_CA0-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/21/magazine/21firstwords-copy/21mag-21firstwords-t_CA0-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Easiest Way to Get Rid of Racism? Just Redefine It.', 'kicker': 'First Words', 'content_kicker': None, 'print_headline': 'Bias Charge', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Discrimination', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Howard, Greg', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Blacks', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Minorities', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'English Language', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Civil Rights and Liberties', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Duke, David E', 'rank': 9, 'major': 'N'}], 'pub_date': '2016-08-16T09:00:05+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Greg Howard', 'person': [{'firstname': 'Greg', 'middlename': None, 'lastname': 'Howard', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/28c63746-9b5a-5bc6-986c-c4b07877df00', 'word_count': 1570, 'uri': 'nyt://article/28c63746-9b5a-5bc6-986c-c4b07877df00'}, {'abstract': 'On long-haul flights, Delta is introducing all-suite business class (complete with sliding doors).', 'web_url': 'https://www.nytimes.com/2016/08/21/travel/on-delta-all-suite-business-class-flights.html', 'snippet': 'On long-haul flights, Delta is introducing all-suite business class (complete with sliding doors).', 'lead_paragraph': 'Suites in the skies — airline seats with doors that slide shut to give passengers total privacy — have become de rigueur in international first class: Emirates and Singapore Airlines are two of the carriers that offer them on long-haul flights. But an all-suite business class? It has yet to be heard of, according to Delta Air Lines, and the carrier wants to be the first in the industry to change that with the fall 2017 debut of the Delta One suite in its Delta One business-class category.', 'print_section': 'TR', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/21/travel/21DELTA1/21DELTA1-thum