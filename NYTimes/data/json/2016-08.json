: 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/0d711bd9-3a17-5d4c-b441-7659891df030', 'word_count': 9, 'uri': 'nyt://article/0d711bd9-3a17-5d4c-b441-7659891df030'}, {'abstract': 'Releasing secret files could help former detainees return to society.', 'web_url': 'https://www.nytimes.com/2016/08/14/opinion/sunday/how-to-end-the-stigma-of-guantanamo.html', 'snippet': 'Releasing secret files could help former detainees return to society.', 'lead_paragraph': 'WASHINGTON — The Guantánamo Bay prison may soon reach a milestone. The Obama administration appears close to resettling the remaining detainees recommended for transfer, some of whom have been stranded on that list for years. That prospect raises a question: What more, if anything, should the United States do to help them, and hundreds of other people who were previously released after being detained without charges for years, most of whom are not suspected of engaging in new militant activities?', 'print_section': 'SR', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/14/opinion/sunday/14savage/14savage-articleLarge.jpg', 'height': 754, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/08/14/opinion/sunday/14savage/14savage-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 754}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/14/opinion/sunday/14savage/14savage-jumbo.jpg', 'height': 1024, 'width': 815, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/14/opinion/sunday/14savage/14savage-superJumbo.jpg', 'height': 2048, 'width': 1630, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/14/opinion/sunday/14savage/14savage-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/08/14/opinion/sunday/14savage/14savage-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/14/opinion/sunday/14savage/14savage-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How to End the Stigma of Guantánamo', 'kicker': 'News Analysis', 'content_kicker': None, 'print_headline': 'How to End the Stigma of Guantánamo', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Savage, Charlie', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Detainees', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Guantanamo Bay Naval Base (Cuba)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Terrorism', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'State Department', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Taliban', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'AL QAEDA', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'WikiLeaks', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'Supreme Court (US)', 'rank': 10, 'major': 'N'}], 'pub_date': '2016-08-13T18:30:04+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Charlie Savage', 'person': [{'firstname': 'Charlie', 'middlename': None, 'lastname': 'Savage', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/3bc38d6d-b61e-5728-a691-4c5da48ee246', 'word_count': 1212, 'uri': 'nyt://article/3bc38d6d-b61e-5728-a691-4c5da48ee246'}, {'abstract': 'The news is always the same: death. But life is where the story is.', 'web_url': 'https://www.nytimes.com/2016/08/14/sunday-review/obit-for-the-obits.html', 'snippet': 'The news is always the same: death. But life is where the story is.', 'lead_paragraph': 'No sense in burying the lede. This week, after more than eight years of lively habitation in one of journalism’s more obscure corners, I’m making a final egress, passing on. Starting after Friday’s deadline (ha!) I am an ex-obit writer.', 'print_section': 'SR', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Obit for the Obits', 'kicker': 'News Analysis', 'content_kicker': None, 'print_headline': 'Obit for the Obits', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Weber, Bruce (Journalist)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Times', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Careers and Professions', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'News and News Media', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-08-13T18:30:04+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Sunday Review', 'byline': {'original': 'By Bruce Weber', 'person': [{'firstname': 'Bruce', 'middlename': None, 'lastname': 'Weber', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News Analysis', '_id': 'nyt://article/db5047ed-fe52-5242-a538-b925dfa70345', 'word_count': 913, 'uri': 'nyt://article/db5047ed-fe52-5242-a538-b925dfa70345'}, {'abstract': 'Even a dislocated thumb can have a deeper meaning.', 'web_url': 'https://www.nytimes.com/2016/08/14/opinion/sunday/how-to-write-about-trauma.html', 'snippet': 'Even a dislocated thumb can have a deeper meaning.', 'lead_paragraph': 'One summer afternoon, when I was 4 or 5 years old, I was raped by a next-door neighbor. If the act itself was gruesome, the aftermath was surprisingly uneventful, beginning with the fact that my mother, despite knowing what had transpired, did nothing. As for me, I did what everyone tries to do under similar circumstances: move on and be normal. With the exception of the occasional nightmare that visited me in the years that followed, I was convinced that there had been no lasting damage. How miraculous it was that I had emerged unscathed.', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/14/opinion/sunday/14sayrafiezadeh/14sayrafiezadeh-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/08/14/opinion/sunday/14sayrafiezadeh/14sayrafiezadeh-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/14/opinion/sunday/14sayrafiezadeh/14sayrafiezadeh-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/14/opinion/sunday/14sayrafiezadeh/14sayrafiezadeh-articleLarge.jpg', 'height': 796, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/08/14/opinion/sunday/14sayrafiezadeh/14sayrafiezadeh-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 796}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/14/opinion/sunday/14sayrafiezadeh/14sayrafiezade