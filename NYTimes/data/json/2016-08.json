': 1250, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/07/nyregion/07ARTST1/07ARTST1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/08/07/nyregion/07ARTST1/07ARTST1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/07/nyregion/07ARTST1/07ARTST1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: ‘Midsummer,’ an Urban Fairy Tale, Comes to Hartford', 'kicker': 'Arts | Connecticut', 'content_kicker': None, 'print_headline': 'A Ribald Urban Fairy Tale', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Hartford TheaterWorks', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Hartford (Conn)', 'rank': 4, 'major': 'N'}], 'pub_date': '2016-08-05T15:16:40+0000', 'document_type': 'article', 'news_desk': 'Metropolitan', 'section_name': 'New York', 'byline': {'original': 'By David DeWitt', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'DeWitt', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/70fe700f-c8aa-5179-aaec-f4a4ee55531a', 'word_count': 743, 'uri': 'nyt://article/70fe700f-c8aa-5179-aaec-f4a4ee55531a'}, {'abstract': 'J. D. Vance, whose memoir “Hillbilly Elegy” is No.9 on the hardcover nonfiction list, says, “It’s amazing how much just knowing other people changes the way you think and talk about them.”', 'web_url': 'https://www.nytimes.com/2016/08/14/books/review/inside-the-list-j-d-vance-hillbilly-elegy.html', 'snippet': 'J. D. Vance, whose memoir “Hillbilly Elegy” is No.9 on the hardcover nonfiction list, says, “It’s amazing how much just knowing other people changes the way you think and talk about them.”', 'lead_paragraph': 'Moving On Up: Any way you look at it, J. D. Vance is a member of the elite — a Yale Law graduate and former biotech executive who is now, in his early 30s, a principal at a San Francisco investment firm. But it wasn’t always thus. In the memoir “Hillbilly Elegy,” new at No.\u202f9 on the hardcover nonfiction list, Vance details his childhood in a poor Ohio town among a chaotic extended family with a mother who turned to drugs and a string of unstable relationships. Along the way, he takes a cleareyed look at some vexing and intractable problems facing the white underclass, which in my reading makes his book a kind of Appalachian version of Ta-\xadNehisi Coates’s \xad“Between the World and Me” (at No.\u202f6 after 55 weeks on the list) and a more intimate companion volume to Nancy Isenberg’s cultural study “White Trash” (at No.\u202f10 after six weeks).', 'print_section': 'BR', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/14/books/review/14vance/14vance-jumbo.jpg', 'height': 450, 'width': 460, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/14/books/review/14vance/14vance-superJumbo.jpg', 'height': 450, 'width': 460, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/14/books/review/14vance/14vance-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/08/14/books/review/14vance/14vance-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/14/books/review/14vance/14vance-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Inside the List', 'kicker': None, 'content_kicker': None, 'print_headline': 'Inside the List', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Vance, J D', 'rank': 2, 'major': 'N'}], 'pub_date': '2016-08-05T15:16:58+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Gregory Cowles', 'person': [{'firstname': 'Gregory', 'middlename': None, 'lastname': 'Cowles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'List', '_id': 'nyt://article/5a142508-dce1-5d10-8c39-9b91b2e7aeb2', 'word_count': 553, 'uri': 'nyt://article/5a142508-dce1-5d10-8c39-9b91b2e7aeb2'}, {'abstract': 'The iTunes Store is not the only place to get movies for an iPod Nano or Classic, but you can use the iTunes program itself to transfer the files.', 'web_url': 'https://www.nytimes.com/2016/08/06/technology/personaltech/adding-old-movies-to-an-old-fashioned-ipod.html', 'snippet': 'The iTunes Store is not the only place to get movies for an iPod Nano or Classic, but you can use the iTunes program itself to transfer the files.', 'lead_paragraph': 'Q. I found some free old movies in the Internet Archive to download, but how can I copy the files to my iPod Nano, which does not have internet access?', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/06/technology/