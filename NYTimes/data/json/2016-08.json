/13glanvilleweb/13glanvilleweb-articleLarge.jpg', 'height': 412, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/08/13/opinion/13glanvilleweb/13glanvilleweb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 412}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/13/opinion/13glanvilleweb/13glanvilleweb-jumbo.jpg', 'height': 703, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/13/opinion/13glanvilleweb/13glanvilleweb-superJumbo.jpg', 'height': 1407, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/13/opinion/13glanvilleweb/13glanvilleweb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/08/13/opinion/13glanvilleweb/13glanvilleweb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/13/opinion/13glanvilleweb/13glanvilleweb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Upside to A-Rod', 'kicker': 'Contributing Op-Ed Writer', 'content_kicker': None, 'print_headline': 'The Upside to A-Rod', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Glanville, Doug', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Rodriguez, Alex', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Yankees', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Doping (Sports)', 'rank': 5,