man-attempted-terrorism.html', 'snippet': 'The authorities said the 25-year-old mechanic’s arrest was the first known case of a Czech citizen trying to join the Islamic State.', 'lead_paragraph': 'A 25-year-old mechanic and loner from a small Czech town, who tried to travel to Syria in January, was charged on Tuesday with attempted terrorism, in what the authorities said was the first known case of a Czech citizen trying to join the Islamic State.', 'print_section': 'A', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Czech Man Is Charged With Attempted Terrorism', 'kicker': None, 'content_kicker': None, 'print_headline': 'Czech Is Charged With Attempted Terrorism', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Terrorism', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Islamic State in Iraq and Syria (ISIS)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Czech Republic', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Turkey', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Syria', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Eastern Europe', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Central Europe', 'rank': 8, 'major': 'N'}], 'pub_date': '2016-08-02T16:06:10+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Dan Bilefsky and Jan Richter', 'person': [{'firstname': 'Dan', 'middlename': None, 'lastname': 'Bilefsky', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Jan', 'middlename': None, 'lastname': 'Richter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/02e751e2-8b5c-536b-9d0c-887cce69084e', 'word_count': 805, 'uri': 'nyt://article/02e751e2-8b5c-536b-9d0c