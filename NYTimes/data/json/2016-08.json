ame': 'persons', 'value': 'Harrison, Christian', 'rank': 4, 'major': 'N'}], 'pub_date': '2016-08-31T01:04:56+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By Harvey Araton', 'person': [{'firstname': 'Harvey', 'middlename': None, 'lastname': 'Araton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b49adefa-eb3a-5741-8fde-c5378ed7d3cf', 'word_count': 1011, 'uri': 'nyt://article/b49adefa-eb3a-5741-8fde-c5378ed7d3cf'}, {'abstract': 'The proposals include prohibiting antidoping employees from having an overlapping leadership role in international sports and increased funding for the World Anti-Doping Agency.', 'web_url': 'https://www.nytimes.com/2016/08/31/sports/antidoping-authorities-from-17-nations-push-for-a-series-of-reforms.html', 'snippet': 'The proposals include prohibiting antidoping employees from having an overlapping leadership role in international sports and increased funding for the World Anti-Doping Agency.', 'lead_paragraph': 'With the Rio Olympics having barely concluded, antidoping authorities from 17 countries met in Copenhagen this week and pushed ahead with a series of proposals, including one that would prohibit any antidoping employee from having an overlapping leadership role in international sports.', 'print_section': 'B', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Antidoping Authorities From 17 Nations Push for a Series of Reforms', 'kicker': None, 'content_kicker': None, 'print_headline': 'Antidoping Authorities From 17 Nations Push for a Series of Reforms', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Doping (Sports)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Athletics and Sports', 'rank': 3, 'major': 'N'}], 'pub_date': '2016-08-31T01:08:48+