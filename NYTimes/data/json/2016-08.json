cess.', 'print_section': 'MM', 'print_page': '28', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/28/magazine/28drink1-copy/28mag-28drink-t_CA0-articleLarge.jpg', 'height': 800, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/08/28/magazine/28drink1-copy/28mag-28drink-t_CA0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 800}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/28/magazine/28drink1-copy/28mag-28drink-t_CA0-jumbo.jpg', 'height': 1024, 'width': 769, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/28/magazine/28drink1-copy/28mag-28drink-t_CA0-superJumbo.jpg', 'height': 2048, 'width': 1537, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/28/magazine/28drink1-copy/28mag-28drink-t_CA0-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/08/28/magazine/28drink1-copy/28mag-28drink-t_CA0-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/28/magazine/28drink1-copy/28mag-28drink-t_CA0-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Tiki’s Comeback', 'kicker': 'Drink', 'content_kicker': None, 'print_headline': 'Tiki’s Comeback', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cocktails and Mixed Drinks', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Schaap, Rosie', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Rum', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': "Smuggler's Cove (San Francisco, Calif, Bar)", 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Recipes', 'rank': 5, 'major': 'N'}, {'name': 'creative_works', 'value': "Smuggler's Cove: Exotic Cocktails, Rum, and the Cult of Tiki (Book)", 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'ALCOHOLIC BEVERAGES', 'rank': 7, 'major': 'N'}], 'pub_date': '2016-08-26T10:58:24+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Rosie Schaap', 'person': [{'firstname': 'Rosie', 'middlename': None, 'lastname': 'Schaap', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7ecab69e-a6d0-5d54-9d8c-b58d902a60c5', 'word_count': 405, 'uri': 'nyt://article/7ecab69e-a6d0-5d54-9d8c-b58d902a60c5'}, {'abstract': 'Finding solace in Patna, India, after a personal loss.', 'web_url': 'https://www.nytimes.com/2016/08/28/magazine/familiar-dish-familiar-friend.html', 'snippet': 'Finding solace in Patna, India, after a personal loss.', 'lead_paragraph': 'Gulshan showed up in our lives by chance. She was old, searching for work; Mom wasn’t looking to hire anyone. And even if she had been, Gulshan was Muslim and my family Hindu. When I was growing up, most families in India hired help within their own religion unless they could afford English-speaking, Catholic nannies. But there was something about Gulshan. True to her name, which means “garden” in Hindi, she created a kind of refuge around her. Before we knew it, she was in our kitchen making Mom’s favorite dessert, phirni — a bit like rice pudding.', 'print_section': 'MM', 'print_page': '32', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/