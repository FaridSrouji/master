/25ALBUMOFTHEWEEK/25ALBUMOFTHEWEEK-articleLarge.jpg', 'height': 391, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/08/25/arts/25ALBUMOFTHEWEEK/25ALBUMOFTHEWEEK-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 391}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/25/arts/25ALBUMOFTHEWEEK/25ALBUMOFTHEWEEK-jumbo.jpg', 'height': 667, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/25/arts/25ALBUMOFTHEWEEK/25ALBUMOFTHEWEEK-superJumbo.jpg', 'height': 1217, 'width': 1867, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/25/arts/25ALBUMOFTHEWEEK/25ALBUMOFTHEWEEK-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/08/25/arts/25ALBUMOFTHEWEEK/25ALBUMOFTHEWEEK-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/25/arts/25ALBUMOFTHEWEEK/25ALBUMOFTHEWEEK-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In ‘Glory,’ Britney Spears Promises Pleasure, but Offers Nothing Personal', 'kicker': 'Album Review', 'content_kicker': None, 'print_headline': 'Promises of Pleasure, but Nothing Personal', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Pop and Rock Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Spears, Britney', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'Glory (Album)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'ra