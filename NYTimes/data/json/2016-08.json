g', 'height': 430, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/08/18/arts/18RUSSELL/18RUSSELL-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 430}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/18/arts/18RUSSELL/18RUSSELL-jumbo.jpg', 'height': 734, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/18/arts/18RUSSELL/18RUSSELL-superJumbo.jpg', 'height': 1469, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Keri Russell on Her First Emmy Nomination, for ‘The Americans’', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Couple Onscreen and Off, Both New to Emmy Attention', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Shattuck, Kathryn', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Russell, Keri', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Emmy Awards', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'ACTORS AND ACTRESSES', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Americans (TV Program)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Rhys, Matthew', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 7, 'major': 'N'}], 'pub_date': '2016-08-17T20:55:50+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Interview', '_id': 'nyt://article/458d870a-d7b7-546f-be7c-9f4bcbab644e', 'word_count': 894, 'uri': 'nyt://article/458d870a-d7b7-546f-be7c-9f4bcbab644e'}, {'abstract': 'Stephen Rogata appeared in Criminal Court for his arraignment via a video connection to Bellevue Hospital Center, where he is being held for psychiatric evaluation.', 'web_url': 'https://www.nytimes.com/2016/08/18/nyregion/man-who-scaled-trump-tower-is-arraigned-in-a-manhattan-court.html', 'snippet': 'Stephen Rogata appeared in Criminal Court for his arraignment via a video connection to Bellevue Hospital Center, where he is being held for psychiatric evaluation.', 'lead_paragraph': 'The man who scaled Trump Tower last week told investigators he did so for “the publicity,” which he hoped would earn him a meeting with Donald J. Trump, Manhattan prosecutors said in court on Wednesday.', 'print_section': 'A', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/18/nyregion/18CLIMBER1/18CLIMBER1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/08/18/nyregion/18CLIMBER1/18CLIMBER1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/18/nyregion/18CLIMBER1/18CLIMBER1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/18/nyregion/18CLIMBER1/18CLIMBER1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/08/18/nyregion/18CLIMBER1/18CLIMBER1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/18/nyregion/18CLIMBER1/18CLIMBER1-jumbo.jp