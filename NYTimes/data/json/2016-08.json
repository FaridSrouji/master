_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/28/travel/28INTRANSIT-TIPS/28INTRANSIT-TIPS-articleLarge.jpg', 'height': 673, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/08/28/travel/28INTRANSIT-TIPS/28INTRANSIT-TIPS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 673}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/28/travel/28INTRANSIT-TIPS/28INTRANSIT-TIPS-jumbo.jpg', 'height': 919, 'width': 819, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/28/travel/28INTRANSIT-TIPS/28INTRANSIT-TIPS-superJumbo.jpg', 'height': 919, 'width': 819, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/28/travel/28INTRANSIT-TIPS/28INTRANSIT-TIPS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/08/28/travel/28INTRANSIT-TIPS/28INTRANSIT-TIPS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/28/travel/28INTRANSIT-TIPS/28INTRANSIT-TIPS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How to Eat Like a Local on the Road', 'kicker': 'Travel Tips', 'content_kicker': None, 'print_headline': 'How to Eat Like a Local', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Restaurants', 'rank': 3, 'major': 'N'}, {'nam