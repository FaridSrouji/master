F', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/29/sports/29tennisplays-illo/29tennisplays-illo-articleLarge.jpg', 'height': 691, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/08/29/sports/29tennisplays-illo/29tennisplays-illo-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 691}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/29/sports/29tennisplays-illo/29tennisplays-illo-jumbo.jpg', 'height': 1024, 'width': 890, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/29/sports/29tennisplays-illo/29tennisplays-illo-superJumbo.jpg', 'height': 2048, 'width': 1779, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/29/sports/29tennisplays-illo/29tennisplays-illo-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/08/29/sports/29tennisplays-illo/29tennisplays-illo-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/29/sports/29tennisplays-illo/29tennisplays-illo-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In Tennis, Playwrights Find a Ready Device for Onstage Drama', 'kicker': None, 'content_kicker': None, 'print_headline': 'In Tennis, a Ready Device for Drama', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Miller, Stuart', 'rank': 1, 'major': 'N'}, {'name': 'su