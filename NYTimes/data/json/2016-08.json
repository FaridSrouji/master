ame': 'Williams', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8a52159b-c3cb-55ad-89b5-bc02421f090b', 'word_count': 483, 'uri': 'nyt://article/8a52159b-c3cb-55ad-89b5-bc02421f090b'}, {'abstract': 'Sham Aldaher will probably be able to leave the hospital by early next week, although more procedures will be required for her to receive a prosthetic, officials said.', 'web_url': 'https://www.nytimes.com/2016/08/06/world/europe/syrian-girl-eye-surgery-barcelona.html', 'snippet': 'Sham Aldaher will probably be able to leave the hospital by early next week, although more procedures will be required for her to receive a prosthetic, officials said.', 'lead_paragraph': 'MADRID — A refugee infant from Syria who was born without an eye and with a seriously disfigured face successfully underwent eye surgery at a Barcelona hospital on Friday, after being granted a special visa from Spain to receive free treatment.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Syrian Girl Born Without an Eye Undergoes Surgery in Barcelona', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Aldaher, Sham (2015- )', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Barcelona (Spain)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Surgery and Surgeons', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Refugees and Displaced Persons', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Middle East and Africa Migrant Crisis', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-08-05T15:05:51+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Raphael Minder', 'person': [{'firstname': 'Raphael', 'middlename': None, 'lastname': 'Minder', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/70a9f554-6293-5c04-8ce2-c6e9d8c27d80', 'word_count': 306, 'uri': 'nyt://article/70a9f554-6293-5c04-8ce2-c6e9d8c27d80'}, {'abstract': 'Dan Zak’s “Almighty” is a perfectly measured blend of biography, suspense and history.', 'web_url': 'https://www.nytimes.com/2016/08/07/books/review/almighty-dan-zak.html', 'snippet': 'Dan Zak’s “Almighty” is a perfectly measured blend of biography, suspense and history.', 'lead_paragraph': 'ALMIGHTYCourage, Resistance, and Existential Peril in the Nuclear AgeBy Dan ZakIllustrated. 402 pp. Blue Rider Press. $27.', 'print_section': 'BR', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'How to Keep an Atomic Bomb From Being Smuggled Into New York City? Open Every Suitcase With a Screwdriver.', 'kicker': 'Nonfiction', 'content_kicker': None, 'print_headline': 'Bound to Happen', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Zak, Daniel J (1975- )', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Nuclear Weapons', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'Almighty: Courage, Resistance, and Existential Peril in the Nuclear Age (Book)', 'rank': 4, 'major': 'N'}], 'pub_date': '2016-08-05T15:05:59+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Kai Bird', 'person': [{'firstname': 'Kai', 'middlename': None, 'lastname': 'Bird', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/c99cd1e7-153e-5f0f-9d5b-9781bc989a4e', 'word_count': 782, 'uri': 'nyt://article/c99cd1e7-153e-5f0f-9d5b-9781bc989a4e'}, {'abstract': 'Lisa McInerney’s “The Glorious Heresies” and more.', 'web_url': 'https://www.nytimes.com/2016/08/07/books/review/lisa-mcinerney-glorious-heresies-and-more-crime-fiction.html', 'snippet': 'Lisa McInerney’s “The Glorious Heresies” and more.', 'lead_paragraph': 'Irish sons are brought up to honor their mothers. To Jimmy Phelan, the most feared gangster in the city of Cork, that means cleaning up his mother’s kitchen after she bashes an intruder to a bloody pulp with a gaudy religious artifact she calls her “holy stone.” This tragicomic scene captures the wonderfully offbeat voice of Lisa McInerney, whose irreverent first novel, THE GLORIOUS HERESIES (Tim Duggan, $27), descends into the city’s seedy underworld and finds a community of alcoholics, prostitutes, drug dealers and their customers, who live like rats but speak like street poets. Ireland is gripped in a recession, and a lot of people have no jobs — but not down here, where everyone’s working in the shadow economy, selling drugs or sex or someone else’s stuff.', 'print_section': 'BR', 'print_page': '29', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/07/books/review/0807-BKS-Crime/0807-BKS-Crime-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/08/07/books/review/0807-BKS-Crime/0807-BKS-Crime-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/07/books/review/0807-BKS-Crime/0807-BKS-Crime-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/07/books/review/0807-BKS-Crime/0807-BKS-Crime-articleLarge.jpg', 'height': 758, 'width': 600, 'subType