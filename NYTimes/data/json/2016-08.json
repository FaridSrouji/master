'middlename': None, 'lastname': 'Witz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d8549758-ccf3-5f76-8143-dfa51c73deb5', 'word_count': 915, 'uri': 'nyt://article/d8549758-ccf3-5f76-8143-dfa51c73deb5'}, {'abstract': 'Denizens and landscapes of a less-glamorized version of Los Angeles pique the interest of a photographer who is not distracted by the shine the city can so often project.', 'web_url': 'https://lens.blogs.nytimes.com/2016/08/23/an-unvarnished-look-at-los-angeles/', 'snippet': 'Denizens and landscapes of a less-glamorized version of Los Angeles pique the interest of a photographer who is not distracted by the shine the city can so often project.', 'lead_paragraph': 'Twenty-first century culture, with its social media mores, trains artists to seek out “likes” and “favorites.” Acclaim becomes the immediate goal, rather than a byproduct of good work, honed over years of dedication to craft.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'An Unvarnished Look at Los Angeles', 'kicker': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Photography', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Hernandez, Anthony (1947- )', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'San Francisco Museum of Modern Art', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Los Angeles (Calif)', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-08-23T07:00:53+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By Jonathan Blaustein', 'person': [{'firstname': 'Jonathan', 'middlename': None, 'lastname': 'Blaustein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://a