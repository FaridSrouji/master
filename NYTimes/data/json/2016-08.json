'lastname': 'Longman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Joe', 'middlename': None, 'lastname': 'Ward', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fa1a8b56-d3b1-5381-9e50-2c4396c5a4ee', 'word_count': 1465, 'uri': 'nyt://article/fa1a8b56-d3b1-5381-9e50-2c4396c5a4ee'}, {'abstract': 'A racist system. A brother in jail. One teenage girl turned to animation to make sense of it all.', 'web_url': 'https://www.nytimes.com/2016/08/02/opinion/i-destini-race-policing-prisons.html', 'snippet': 'A racist system. A brother in jail. One teenage girl turned to animation to make sense of it all.', 'lead_paragraph': 'When we conceived this film two years ago, we were simply trying to break through the static narratives of police violence that we saw on our televisions. We were in Durham, N.C., which in terms of racial tension felt similar to many American cities before Ferguson became a household name, and Black Lives Matter became a national movement. The city was full of organizers, families and working people who spent their evenings huddled in the backs of restaurants, barber shops and community centers, trying to shed light on issues of inequality that we felt the media consistently missed.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Destini’s Brother', 'kicker': 'Op-Docs', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Durham (NC)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Blacks', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Documentary Films and Programs', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'ANIMATED FILMS', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Crim