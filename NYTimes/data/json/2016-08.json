means.', 'lead_paragraph': 'The Justice Department announced on Thursday that it had concluded a two-year investigation into the complex world of music licensing and decided against making changes to the regulatory agreements that govern Ascap and BMI, two large clearinghouses for performing rights that process about $2 billion in royalty payments each year.', 'print_section': 'B', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/04/business/media/05MUSIC/05MUSIC-articleLarge.jpg', 'height': 422, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/08/04/business/media/05MUSIC/05MUSIC-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 422}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/04/business/media/05MUSIC/05MUSIC-jumbo.jpg', 'height': 721, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/04/business/media/05MUSIC/05MUSIC-superJumbo.jpg', 'height': 1441, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/04/business/media/05MUSIC/05MUSIC-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/08/04/business/media/05MUSIC/05MUSIC-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/04/business/media/05MUSIC/05MUSIC-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How a Justice De