ption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/21/magazine/21thread1/21thread1-articleLarge.jpg', 'height': 750, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/08/21/magazine/21thread1/21thread1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 750}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/21/magazine/21thread1/21thread1-jumbo.jpg', 'height': 1024, 'width': 820, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/21/magazine/21thread1/21thread1-superJumbo.jpg', 'height': 1413, 'width': 1131, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'The 8.7.16 Issue', 'kicker': 'The Thread', 'content_kicker': None, 'print_headline': 'The 8.7.16 Issue', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2016-08-19T10:58:03+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/af8f19ec-2345-5e11-8329-accfe96750a8', 'word_count': 687, 'uri': 'nyt://article/af8f19ec-2345-5e11-8329-accfe96750a8'}, {'abstract': 'Reveal everything. Keep your romantic interests American.', 'web_url': 'https://www.nytimes.com/2016/08/21/magazine/how-to-pass-a-cia-background-check.html', 'snippet': 'Reveal everything. Keep your romantic interests American.', 'lead_paragraph': '“Withholding information from us will not work in your favor,” says Ronald S. Patrick, deputy director of talent development at the Central Intelligence Agency, which receives up to 150,000 résumés a year. Applicants who are offered a job go through a monthslong security clearance, including an intense background check. To pass, you can’t have been convicted of a felony (“That’s a showstopper for us”); also, no recent illegal drug use. You will be asked about drugs in the application. Tell the truth. “We don’t expect you to be shockingly, squeaky clean,” Patrick says. “We expect you to have lived a life, to have exercised bad judgment, to have gone through adolescence and made mistakes.”', 'print_section': 'MM', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/21/magazine/21tip/21mag-21tip-t_CA0-articleLarge.jpg', 'height': 736, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/08/21/magazine/21tip/21mag-21tip-t_CA0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 736}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/21/magazine/21tip/21mag-21tip-t_CA0-jumbo.jpg', 'height': 1024, 'width': 836, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/21/magazine/21tip/21mag-21tip-t_CA0-superJumbo.jpg', 'height': 1334, 'width': 1088, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/21/magazine/21tip/21tip-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/08/21/magazine/21tip/21tip-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/21/magazine/21tip/21tip-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How to Pass a C.I.A. Background Check', 'kicker': 'Tip', 'content_kicker'