/26STEWART/26STEWART-superJumbo.jpg', 'height': 1309, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/26/business/26STEWART/26STEWART-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/08/26/business/26STEWART/26STEWART-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/26/business/26STEWART/26STEWART-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How Philippe Dauman Lost the Battle for Viacom', 'kicker': 'Common Sense', 'content_kicker': None, 'print_headline': 'How Dauman Lost the Battle for Viacom', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Viacom Inc', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Dauman, Philippe P', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Redstone, Sumner M', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Redstone, Shari', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Boards of Directors', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Appointments and Executive Changes', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Suits and Litigation (Civil)', 'rank': 8, 'major': 'N'}], 'pub_date': '2016-08-25T16:38:05+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By James B. Stewart', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/592eb1c3-4207-5c1d-b8b7-17f31edc76ee', 'word_count': 1575, 'uri': 'nyt://article/592eb1c3-4207-5c1d-b8b7-17f31edc76ee'}, {'abstract': 'Working for Planned Parenthood elicits unwelcome talks with strangers. Also, worming your way into a tight-knit circle of friends — or not.', 'web_url': 'https://www.nytimes.com/2016/08/28/fashion/social-qs-planned-parenthood-wedding-gifts-work-friends.html', 'snippet': 'Working for Planned Parenthood elicits unwelcome talks with strangers. Also, worming your way into a tight-knit circle of friends — or not.', 'lead_paragraph': 'I work for Planned Parenthood. I love my job and I’m proud of what I do. In social settings, when asked what I do for a living, I answer truthfully and in full. But this nearly always leads to a big rehash of the politics surrounding my employer, together with the same old talking points and statistics. I don’t like taking my work home (or out) with me. Is there a way to head off these lengthy discussions without withholding the name Planned Parenthood? Saying “I work in health care” feels like hiding to me.', 'print_section': 'ST', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-articleLarge-v2.jpg', 'height': 599, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/28/fashion/social_inline/social_inline-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 599}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-jumbo-v2.jpg', 'height': 923, 'width': 925, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-superJumbo-v2.jpg', 'height': 923, 'width': 925, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/28/fashion/social_inline/social_inline-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In a Social Setting, Is It OK to Avoid Saying Where You Work?', 'kicker': 'Social Q’s', 'content_kicker': None, 'print_headline': 'Speaking to Strangers', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Customs, Etiquette and Manners', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Parenting', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Planned Parenthood Federation of America', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Dating and Relationships', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-08-25T16:38:37+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'byline': {'original': 'By Philip Galanes', 'person': [{'firstname': 'Philip', 'middlename': None, 'lastname': 'Galanes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d1ca34e9-054c-5d34-9425-2dcf2a7e3f69', 'word_count': 846, 'uri': 'nyt://article/d1ca34e9-054c-5d34-9425-2dcf2a7e3f69'}, {'abstract': 'Snake Day will be the highlight of an entire garden weekend starring these animals at Wave Hill in the Bronx.', 'web_url': 'https://www.nytimes.com/2016/08/26/arts/design/wav