': 'N'}, {'name': 'glocations', 'value': 'Seattle (Wash)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'ALLEN, PAUL G', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Science and Technology', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-08-07T21:41:02+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Kirk Johnson', 'person': [{'firstname': 'Kirk', 'middlename': None, 'lastname': 'Johnson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/6bb572d9-e269-51e6-9769-f3b7508ad999', 'word_count': 1198, 'uri': 'nyt://article/6bb572d9-e269-51e6-9769-f3b7508ad999'}, {'abstract': 'The following tax-exempt fixed-income issues are scheduled for pricing this week.', 'web_url': 'https://www.nytimes.com/2016/08/08/business/treasury-auctions-set-for-the-week-of-aug-8.html', 'snippet': 'The following tax-exempt fixed-income issues are scheduled for pricing this week.', 'lead_paragraph': 'The Treasury’s schedule of financing this week includes Monday’s regular weekly auction of new three- and six-month bills and an auction of four-week bills on Tuesday.', 'print_section': 'B', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Treasury Auctions Set for the Week of Aug. 8', 'kicker': None, 'content_kicker': None, 'print_headline': 'Treasury Auctions Set for This Week', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Municipal Bonds', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Government Bonds', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Auctions', 'rank': 3, 'major': 'N'}], 'pub_date': '2016-08-07T21:43:07+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': '', 'person': [], 'organization': None}, 't