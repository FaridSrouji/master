'Presidential Election of 2016', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Floods', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Baton Rouge (La)', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-08-19T21:16:28+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Campbell Robertson', 'person': [{'firstname': 'Campbell', 'middlename': None, 'lastname': 'Robertson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7ed341fb-775a-52d7-8d1a-fa41c874d11d', 'word_count': 793, 'uri': 'nyt://article/7ed341fb-775a-52d7-8d1a-fa41c874d11d'}, {'abstract': 'This online music site known for its equitable treatment of artists is one of the greatest underground-culture bazaars of our time.', 'web_url': 'https://www.nytimes.com/2016/08/20/arts/music/bandcamp-shopping-for-music.html', 'snippet': 'This online music site known for its equitable treatment of artists is one of the greatest underground-culture bazaars of our time.', 'lead_paragraph': 'A lesser-known artist you love makes a new recording — say, the hip-hop group Clipping or the Chicago punk band Mace or the electronic composer Kaitlyn Aurelia Smith. You feel you have to graft it onto your life. How does that go for you these days? Does streaming from Spotify, Apple Music or Tidal answer your needs in terms of audio quality and how well the artist is paid? Do you have a good record store nearby, and does it sell cassettes and vinyl, too? Do you only buy new records directly from artists, with a cash transaction and a handshake? Do you love spending time on iTunes?', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/20/arts/20BANDCAMPJP/20BANDCAMPJP-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/08/20/arts/20BANDCAMPJP/20BANDCAMPJP-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/20/arts/20BANDCAMPJP/20BANDCAMPJP-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/20/arts/20BANDCAMPJP/20BANDCAMPJP-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/08/20/arts/20BANDCAMPJP/20BANDCAMPJP-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/20/arts/20BANDCAMPJP/20BANDCAMPJP-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/20/arts/20BANDCAMPJP/20BANDCAMPJP-superJumbo.jpg', 'height': 1367, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Is Bandcamp the Holy Grail of Online Record Stores?', 'kicker': 'Critic’s Notebook', 'content_kicker': None, 'print_headline': 'An Online Record Shop for the Faster, Punker Set', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Bandcamp Inc', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Pop and Rock Music', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Audio Recordings, Downloads and Streaming', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 5, 'major': 'N