-TORTUGAS1/28DRY-TORTUGAS1-articleLarge.jpg', 'height': 378, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/08/28/travel/28DRY-TORTUGAS1/28DRY-TORTUGAS1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 378}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/28/travel/28DRY-TORTUGAS1/28DRY-TORTUGAS1-jumbo.jpg', 'height': 645, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/28/travel/28DRY-TORTUGAS1/28DRY-TORTUGAS1-superJumbo.jpg', 'height': 1291, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/28/travel/28DRY-TORTUGAS1/28DRY-TORTUGAS1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/08/28/travel/28DRY-TORTUGAS1/28DRY-TORTUGAS1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/28/travel/28DRY-TORTUGAS1/28DRY-TORTUGAS1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'West of Key West, an Under-the-Radar National Park', 'kicker': 'Explorer', 'content_kicker': None, 'print_headline': 'Finding the Past, and Future, in the Sea', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Zach, Elizabeth', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'National Parks, Monuments and Seashores', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Fish and Other Marine Life', 'rank':