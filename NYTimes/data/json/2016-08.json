'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/16/blogs/16oldiht-1916-stmarysday/16oldiht-1916-stmarysday-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/08/16/blogs/16oldiht-1916-stmarysday/16oldiht-1916-stmarysday-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/16/blogs/16oldiht-1916-stmarysday/16oldiht-1916-stmarysday-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/16/blogs/16oldiht-1916-stmarysday/16oldiht-1916-stmarysday-articleLarge.jpg', 'height': 611, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/08/16/blogs/16oldiht-1916-stmarysday/16oldiht-1916-stmarysday-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 611}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/16/blogs/16oldiht-1916-stmarysday/16oldiht-1916-stmarysday-jumbo.jpg', 'height': 875, 'width': 859, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/16/blogs/16oldiht-1916-stmarysday/16oldiht-1916-stmarysday-superJumbo.jpg', 'height': 875, 'width': 859, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': '1916: ‘St. Mary’s Day’ Loses Splendor', 'kicker': 'IHT Retrospective', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Flowers and Plants', 'rank': 1, 'major': 'N'}, 