acy': {}}], 'headline': {'main': 'Can You Sign Here? Alabama Law Aims to Keep Cursive in Schools', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Education', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Handwriting', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Reading and Writing Skills (Education)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'ALABAMA', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Bentley, Robert J', 'rank': 7, 'major': 'N'}], 'pub_date': '2016-08-01T18:18:14+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Daniel Victor', 'person': [{'firstname': 'Daniel', 'middlename': None, 'lastname': 'Victor', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/af9f9632-e84a-5c1d-90c3-2e731bc4cac5', 'word_count': 465, 'uri': 'nyt://article/af9f9632-e84a-5c1d-90c3-2e731bc4cac5'}, {'abstract': 'When Eugene Richards heard the emotional remarks of Khizr Khan, whose son died in action in Iraq, he realized their paths had crossed during a moment of grief at Arlington National Cemetery.', 'web_url': 'https://lens.blogs.nytimes.com/2016/08/01/a-muslim-father-a-soldiers-ultimate-sacrifice/', 'snippet': 'When Eugene Richards heard the emotional remarks of Khizr Khan, whose son died in action in Iraq, he realized their paths had crossed during a moment of grief at Arlington National Cemetery.', 'lead_paragraph': 'Like millions of people watching the Democratic National Convention last week, Janine Altongy was reduced to tears by the emotional — and forceful – remarks of Khizr Khan, a Muslim immigrant from Pakistan whose son, a United States Army captain, died in Iraq in 2004. Moved by his testimony, she urged her husband, Eugene Richards, to watch the speech.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Muslim Father, a Soldier’s Ultimate Sacrifice', 'kicker': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Democratic National Convention', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Iraq War (2003-11)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Khan, Khizr (1950- )', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Richards, Eugene', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Arlington National Cemetery', 'rank': 9, 'major': 'N'}], 'pub_date': '2016-08-01T18:20:11+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By James Estrin', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': 'Estrin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f7ff36da-f2cd-5e20-80a5-f5ac9626da1c', 'word_count': 490, 'uri': 'nyt://article/f7ff36da-f2cd-5e20-80a5-f5ac9626da1c'}, {'abstract': 'The $2.6 billion purchase of SolarCity, a solar-panel installer, comes at a crucial time for a company with lofty goals and a habit of missing them.', 'web_url': 'https://www.nytimes.com/2016/08/02/business/dealbook/tesla-solarcity-deal-could-distract-the-carmaker.html', 'snippet': 'The $2.6 billion purchase of SolarCity, a solar-panel installer, comes at a crucial time for a company with lofty goals and a habit of missing them.', 'lead_paragraph': 'Tesla Motors’ deal to buy SolarCity, officially unveiled on Monday, is still perplexing. But at least Tesla’s boss, the electric-car pioneer Elon Musk, is making the best of the terms and process. At $2.6 billion, the price for the solar-panel installer where he is chairman is lower than expected, and the two boards have done the right things. But it still risks distracting Tesla, valued at $35 billion, at a critical time.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/02/business/02DB-BREAKINGVIEWS/02DB-BREAKINGVIEWS-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/08/02/business/02DB-BREAKINGVIEWS/02DB-BREAKINGVIEWS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/02/business/02DB-BREAKINGVIEWS/02DB-BREAKINGVIEWS-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/02/business/02DB-BREAKINGVIEWS/02DB-BREAKINGVIEWS-superJumbo.jpg', 'height': 1362, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/02/business/02DB-BREAKINGVIEWS/02DB-BREAKINGVIEWS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/08/02/business/02DB-BREAKINGVIEWS/02DB-BREAKINGVIEWS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/02/business/02DB-BREAKINGVIEWS/02DB-BREAKINGVIEWS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thum