ns', 'value': 'American Contemporary Music Ensemble', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Bang on a Can', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-08-10T13:59:08+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Zachary Woolfe', 'person': [{'firstname': 'Zachary', 'middlename': None, 'lastname': 'Woolfe', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e0deda78-d150-5aeb-a9fc-af7ebec2bb77', 'word_count': 86, 'uri': 'nyt://article/e0deda78-d150-5aeb-a9fc-af7ebec2bb77'}, {'abstract': 'This five-disc collection from Kino Lorber examines a host of early filmmakers, with a special focus on Oscar Micheaux and Spencer Williams.', 'web_url': 'https://www.nytimes.com/2016/08/14/movies/pioneers-of-african-american-cinema-black-filmmaking-aborning.html', 'snippet': 'This five-disc collection from Kino Lorber examines a host of early filmmakers, with a special focus on Oscar Micheaux and Spencer Williams.', 'lead_paragraph': 'From the perspective of cinema history — and American history, for that matter — there has never been a more significant video release than “Pioneers of African-American Cinema,” a five-disc collection funded with a Kickstarter campaign and released by Kino Lorber on Blu-ray and DVD.', 'print_section': 'AR', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/14/arts/14HOBERMAN1/14HOBERMAN1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/08/14/arts/14HOBERMAN1/14HOBERMAN1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'i