ubType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/08/16/opinion/16hersh/16hersh-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/16/opinion/16hersh/16hersh-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/16/opinion/16hersh/16hersh-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/16/opinion/16hersh/16hersh-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/08/16/opinion/16hersh/16hersh-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/16/opinion/16hersh/16hersh-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Capital Punishment Is Not Israel’s Answer to Terrorism', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'Israel Should Not Revive the Death Penalty', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Israel', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Capital Punishment', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Azaria, Elor', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Palestinians', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Terrorism', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Human Rights and Human Rights Violations', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Lieberman, Avigdor', 'rank': 8, 'major': 'N'}], 'pub_date': '2016-08-16T12:46:20+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Nathan Hersh', 'person': [{'firstname': 'Nathan', 'middlename': None, 'lastname': 'Hersh', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/fe16e39b-5ab9-5916-8c23-4d3227171d1b', 'word_count': 989, 'uri': 'nyt://article/fe16e39b-5ab9-5916-8c23-4d3227171d1b'}, {'abstract': 'Byron Lima Oliva’s death was a fitting end for a man who built an empire from behind bars by leveraging alliances on both sides of the law.', 'web_url': 'https://www.nytimes.com/2016/08/17/opinion/the-demise-of-a-guatemalan-prison-lord.html', 'snippet': 'Byron Lima Oliva’s death was a fitting end for a man who built an empire from behind bars by leveraging alliances on both sides of the law.', 'lead_paragraph': 'On July 18, Guatemala’s most infamous — and powerful — prisoner, Byron Lima Oliva, was shot to death in the Pavón prison outside Guatemala City. While it was a fellow prisoner who, the authorities said, put two bullets in Mr. Lima’s head, in all likelihood the intellectual authors of the killing hail from the highest echelons of the state and the moneyed elite. In Guatemala, it is often impossible to tell where the state ends and the underworld begins.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/16/opinion/17edfontes/17edfontes-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/08/16/opinion/17edfontes/17edfontes-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo',