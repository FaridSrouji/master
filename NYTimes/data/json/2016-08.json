': 'subject', 'value': 'Suits and Litigation (Civil)', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Basell Holdings', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Lyondell Chemical Company', 'rank': 7, 'major': 'N'}], 'pub_date': '2016-08-23T23:40:01+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'DealBook', 'byline': {'original': 'By Steven Davidoff Solomon', 'person': [{'firstname': 'Steven', 'middlename': 'Davidoff', 'lastname': 'Solomon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0fc142fb-cc6d-5cdf-8487-7d2109b56e3b', 'word_count': 1220, 'uri': 'nyt://article/0fc142fb-cc6d-5cdf-8487-7d2109b56e3b'}, {'abstract': 'If more extreme weather events lie in our future, national, state and local policy makers need to improve the nation’s defenses.', 'web_url': 'https://www.nytimes.com/2016/08/24/opinion/after-louisiana-preparing-for-the-next-storm.html', 'snippet': 'If more extreme weather events lie in our future, national, state and local policy makers need to improve the nation’s defenses.', 'lead_paragraph': 'Natural disasters that were once anomalous are becoming almost commonplace, and the country is clearly not prepared for them. Historic floods in Louisiana displaced thousands and led to the deaths of 17 people this month. Record-setting rain devastated parts of West Virginia in June and South Carolina in October.', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/08/24/opinion/24wed2/24wed2-articleLarge.jpg', 'height': 544, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/08/24/opinion/24wed2/24wed2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 544}}, {