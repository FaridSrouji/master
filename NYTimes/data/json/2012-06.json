url': 'https://www.nytimes.com/2012/06/04/arts/video-games/14th-annual-international-classic-video-game-tournament.html', 'snippet': 'Competitors at the 14th Annual International Classic Video Game Tournament at the American Classic Arcade Museum revisited the first generation of computer games.', 'lead_paragraph': 'LACONIA, N.H. — You insert a token. With a joystick and a button you blast away at robots, spaceships and meteors advancing from all sides. Eventually your last man dies. Game over.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/04/arts/jpvideogame/jpvideogame-jumbo.jpg', 'height': 688, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/04/arts/jpvideogame/jpvideogame-superJumbo.jpg', 'height': 1377, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/04/arts/jpvideogame/jpvideogame-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/04/arts/jpvideogame/jpvideogame-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/04/arts/jpvideogame/jpvideogame-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'When Defending Earth Cost 25 Cents', 'kicker': None, 'content_kicker': None, 'print_headline': 'When Defending Earth Cost 25 Cents', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ARCADES', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'American Classic Arcade Museum', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Computer and Video Games', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Laconia (NH)', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-06-03T22:07:44+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Video Games', 'byline': {'original': 'By Ethan Gilsdorf', 'person': [{'firstname': 'Ethan', 'middlename': None, 'lastname': 'Gilsdorf', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a36999ae-132f-50bd-927c-0c117f1aae97', 'word_count': 1137, 'uri': 'nyt://article/a36999ae-132f-50bd-927c-0c117f1aae97'}, {'abstract': 'In “Mission to Paris” by Alan Furst, the city becomes a crossroads for film stars and espionage.', 'web_url': 'https://www.nytimes.com/2012/06/04/books/mission-to-paris-by-alan-furst.html', 'snippet': 'In “Mission to Paris” by Alan Furst, the city becomes a crossroads for film stars and espionage.', 'lead_paragraph': 'Paris on the brink. World War II looming. A place of culinary, erotic, conversational, sartorial and so many other pleasures. A place of elegance and discretion. The aromas of “a thousand years of rain dripping on stone,” of “rough black tobacco and garlic and drains.” And now, the smell of fear too.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/04/arts/jpbook/jpbook-jumbo.jpg', 'height': 1024, 'width': 709, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/04/arts/jpbook/jpbook-superJumbo.jpg', 'height': 1804, 'width': 1249, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, 