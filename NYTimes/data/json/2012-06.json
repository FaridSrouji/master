ion_name': 'Music', 'byline': {'original': 'By Robin Pogrebin', 'person': [{'firstname': 'Robin', 'middlename': None, 'lastname': 'Pogrebin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/54246162-3c2a-5910-ae0f-28307f8037a4', 'word_count': 847, 'uri': 'nyt://article/54246162-3c2a-5910-ae0f-28307f8037a4'}, {'abstract': 'Producers say the revival, which featured African-American actors in several lead roles, may be staged in London this fall.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/06/13/streetcar-will-close-on-july-22/', 'snippet': 'Producers say the revival, which featured African-American actors in several lead roles, may be staged in London this fall.', 'lead_paragraph': 'A multiracial production of “A Streetcar Named Desire,” which opened to lukewarm reviews and middling box office on Broadway this spring, will close on July 22 after 23 previews and 104 performances.', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '‘Streetcar’ Will Close on July 22', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '‘Streetcar’ to Close', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Byrd, Stephen C', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Parker, Nicole Ari', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Rubin-Vega, Daphne', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Underwood, Blair', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Williams, Tennessee', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-06-13T22:22:28+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Scott Heller', 'person': [{'firstname': 'Scott', 'middlename': None, 'lastname': 'Heller', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3d62083b-a984-5fb0-a934-b96abe4f90a7', 'word_count': 150, 'uri': 'nyt://article/3d62083b-a984-5fb0-a934-b96abe4f90a7'}, {'abstract': 'Two women start a company, Humble Design, that furnishes the new homes of those most in need.', 'web_url': 'https://www.nytimes.com/2012/06/14/garden/in-detroit-help-for-the-formerly-homeless-q-and-a.html', 'snippet': 'Two women start a company, Humble Design, that furnishes the new homes of those most in need.', 'lead_paragraph': 'Anyone who lives in Detroit knows how much the city’s homeless population has been suffering, particularly in the last few years. And those lucky enough to get into transitional housing after leaving the overpopulated shelters are starting from scratch — a situation that inspired Treger Strasberg and Ana Smith to start a nonprofit firm called Humble Design.', 'print_section': 'D', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/14/garden/14QNA1_SPAN/14QNA1_SPAN-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/06/14/garden/14QNA1_SPAN/14QNA1_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/14/garden/14QNA1_SPAN/14QNA1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/14/garden/14QNA1_SPAN/14QNA1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/14/garden/14QNA1_SPAN/14QNA1_SPAN-thumbSt