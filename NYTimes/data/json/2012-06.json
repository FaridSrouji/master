role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e0d56be5-67bf-5ac4-8258-985106a666d3', 'word_count': 1188, 'uri': 'nyt://article/e0d56be5-67bf-5ac4-8258-985106a666d3'}, {'abstract': 'If food is supposed to provide nourishment, then sugar-sweetened beverages must be something else.', 'web_url': 'https://opinionator.blogs.nytimes.com/2012/06/05/what-is-food/', 'snippet': 'If food is supposed to provide nourishment, then sugar-sweetened beverages must be something else.', 'lead_paragraph': 'If you believe government has no role in helping people — including encouraging us to act in our own best interests by doing things like not smoking, wearing seat belts and getting exercise — you’re probably no fan of New York’s mayor, Michael R. Bloomberg. The mayor, who has already banned smoking in bars and transfats from restaurant food, \xa0has created more bike lanes in his administration than all other administrations combined and forced the posting of calorie counts in fast food restaurants, added to his sins by proposing to ban the sale of sugar-sweetened beverages (SSBs) over one pint (16 ounces) in a variety of venues.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What Is Food?', 'kicker': 'Mark Bittman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-06-06T01:00:31+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Mark Bittman', 'person': [{'firstname': 'Mark', 'middlename': None, 'lastname': 'Bittman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6955b64d-cac7-52ba-a0a0-daf033f2471b', 'word_count': 962, 'uri': 'nyt://article/6955b64d-cac7-52ba-a0a0-daf033f2471b'}, {'abstract': 'Airtime, a live video chat service designed by Sean Parker and Shawn Fanning, the founders of Napster, hopes to recreate the spontaneity of the 1990s AOL chat rooms.', 'web_url': 'https://www.nytimes.com/2012/06/06/technology/airtimes-video-chat-site-is-like-facebook-with-faces.html', 'snippet': 'Airtime, a live video chat service designed by Sean Parker and Shawn Fanning, the founders of Napster, hopes to recreate the spontaneity of the 1990s AOL chat rooms.', 'lead_paragraph': 'When Americans first started exploring the online world en masse in the early 1990s, many of them headed for AOL’s chat rooms to connect with other curious strangers.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/06/business/Airtimejp/Airtimejp-articleLarge.jpg', 'height': 370, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/06/06/business/Airtimejp/Airtimejp-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 370}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/06/business/Airtimejp/Airtimejp-jumbo.jpg', 'height': 749, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/06/business/Airtimejp/Airtimejp-superJumbo.jpg', 'height': 1499, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/06/business/Airtimejp/Airtimejp-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/06/business/Airtimejp/Airtimejp-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': No