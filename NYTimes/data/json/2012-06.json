e': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Initial Public Offerings', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Suits and Litigation', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Facebook Inc', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'NASDAQ OMX Group Inc', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-06-18T14:07:26+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Peter J. Henning and Steven Davidoff Solomon', 'person': [{'firstname': 'Peter', 'middlename': 'J.', 'lastname': 'Henning', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Steven', 'middlename': 'Davidoff', 'lastname': 'Solomon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/14b601d8-5df5-5c56-a0df-3f66cb0a505e', 'word_count': 899, 'uri': 'nyt://article/14b601d8-5df5-5c56-a0df-3f66cb0a505e'}, {'abstract': 'India’s chief economic adviser said on Monday that increased foreign investment in the retail sector and reduced fuel subsidies would soon be enacted.', 'web_url': 'https://india.blogs.nytimes.com/2012/06/18/basu-says-crucial-reforms-coming-soon/', 'snippet': 'India’s chief economic adviser said on Monday that increased foreign investment in the retail sector and reduced fuel subsidies would soon be enacted.', 'lead_paragraph': 'Acknowledging recent missteps by the government, India’s chief economic adviser said Monday that he was confident that economic reforms like increased foreign investment in the retail sector and reduced fuel subsidies would soon be enacted.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Basu Says Crucial Reforms Coming Soon', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': N