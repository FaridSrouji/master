: None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/67d1284b-ffa2-5abc-b0f7-b76a1b12ab0b', 'word_count': 817, 'uri': 'nyt://article/67d1284b-ffa2-5abc-b0f7-b76a1b12ab0b'}, {'abstract': 'The United States Open champion can’t seem to handle being the favorite.', 'web_url': 'https://straightsets.blogs.nytimes.com/2012/06/27/whats-up-with-samantha-stosur/', 'snippet': 'The United States Open champion can’t seem to handle being the favorite.', 'lead_paragraph': 'One of the anomalies of the tennis scoring system is that a player can win more points over all but still lose the match. Such was the case in Samantha Stosur’s three-set loss to Arantxa Rus on Wednesday at Wimbledon. Stosur won 86 points to Rus’s 77, and each player won 12 games. But Rus won the match, breaking Stosur right back after Stosur rallied to tie the score late in the third set.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s Up With Samantha Stosur?', 'kicker': 'Straight Sets', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Tennis', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Open (Tennis)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Wimbledon Tennis Tournament', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Rus, Arantxa', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Stosur, Samantha', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-06-28T00:00:08+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By Geoff Macdonald', 'person': [{'firstname': 'Geoff', 'middlename': None, 'lastname': 'Macdonald', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/82b5