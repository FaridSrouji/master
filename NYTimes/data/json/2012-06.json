nailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/04/sports/04yankees-pic/04yankees-pic-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Yankees Solve Verlander, Ending Trip on High Note', 'kicker': 'Yankees 5, Tigers 1', 'content_kicker': None, 'print_headline': 'Inept With Runners On, Yankees Find Other Ways to Prevail', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Long, Kevin (1966- )', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Verlander, Justin', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Detroit Tigers', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Rodriguez, Alex', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Yankees', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Baseball', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Jeter, Derek', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-06-03T20:48:56+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Pat Borzi', 'person': [{'firstname': 'Pat', 'middlename': None, 'lastname': 'Borzi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3445977c-84ef-5963-8e16-0ce449b166db', 'word_count': 893, 'uri': 'nyt://article/3445977c-84ef-5963-8e16-0ce449b166db'}, {'abstract': 'Mayank Keshaviah’s new play, “Rangoon,” looks at an Indian immigrant father and his American-born children in the modern-day South.', 'web_url': 'https://www.nytimes.com/2012/06/04/theater/reviews/rangoon-by-mayank-keshaviah-at-clurman-theater.html', 'snippet': 'Mayank Keshaviah’s new play, “Rangoon,” looks at an Indian immigrant father and his American-born children in the modern-day South.', 'lead_paragraph': 'Dhiraj, the Indian immigrant father in Mayank Keshaviah’s unsatisfying play “Rangoon,” a Pan Asian Repertory production, is like a Tiger Dad mixed with a Jewish mother. He loves to guilt-trip his children and has such high expectations for them that when his son brings home an excellent report card, he still gets scolded: “An A minus is not an A.”', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Loneliness of 7-Eleven for Indian Immigrant', 'kicker': 'Theater Review', 'content_kicker': None, 'print_headline': 'Loneliness Of 7-Eleven For Indian Immigrant', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Pan Asian Repertory', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Indian-Americans', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Keshaviah, Mayank', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-06-03T20:51:23+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Theater', 'subsection_name': 'Theater Reviews', 'byline': {'original': 'By Rachel Saltz', 'person': [{'firstname': 'Rachel', 'middlename': None, 'lastname': 'Saltz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/9caa5638-8810-502d-b03c-60bdf569ad5f', 'word_count': 326, 'uri': 'nyt://article/9caa5638-8810-502d-b03c-60bdf569ad5f'}, {'abstract': 'Mr. Hanley, an acclaimed playwright, went on to win two Emmys for his television scripts.', 'web_url': 'https://www.nytimes.com/2012/06/04/theater/william-hanley-playwright-and-tv-writer-dies-at-80.html', 'snippet': 'Mr. Hanley, an acclaimed playwright, went on to win two Emmys for his television scripts.', 'lead_paragraph': 'William Hanley, who received critical acclaim as a Broadway and Off Broadway playwright in the 1960s and who later won Emmys for television scripts, died on May 25 at his home in Ridgefield, Conn. He was 80. ', 'print_section': 'A', 'print_page': '25', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/04/theater/04hanley-web/04hanley-web-jumbo.jpg', 'height': 1024, 'width': 722, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/04/theater/04hanley-web/04hanley-web-superJumbo.jpg', 'height': 2048, 'width': 1443, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/04/theater/04hanley-web/04hanley-web-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/04/theater/04hanley-web/04hanley-web-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/04/theater/04hanley-web/04hanley-web-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'William Hanley, Playwright and TV Writer, Dies at 80', 'kicker': None, 'content_kicker': None, 'print_headline': 'William Hanley, 80, Playwright and TV Writer', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Writing and Writers', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Hanley, William (1931-2012)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-06-03T20:59:59+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Theater', 'byline': {'original': 'By Dennis Hevesi', 'person': [{'firstname': 'Dennis', 'middlename': None, 'lastname': 'Hevesi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/029da134-11fd-59bf-a8b2-5207b619bffe', 'word_count': 631, 'uri': 'nyt://article/029da134-11fd-59bf-a8b2-5207b619bffe'}, {'abstract': 'Not even ancient Greece can claim to be the true home of philosophy. So why do we persist in our Eurocentric delusion?', 'web_url': 'https://opinionator.blogs.nytimes.com/2012/06/03/philosophys-western-bias/', 'snippet': 'Not even ancient Greece can claim to be the true home of philosophy. So why do we persist in our Eurocentric delusion?', 'lead_paragraph': 'There is much talk in academic philosophy about the need to open up the discipline to so-called non-Western traditions and perspectives, both through changes to the curriculum and also within the demographics of philosophy departments themselves. These two aspects are seen as connected: it is thought that greater representation of non-Western philosophy will help to bring about greater diversity among the women and men who make up the philosophical community.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Philosophy’s Western Bias', 'kicker': 'The Stone', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Philosophy', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Europe', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Far East, South and Southeast Asia and Pacific Areas', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-06-03T21:00:51+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Justin E.h. Smith', 'person': [{'firstname': 'Justin', 'middlename': 'E.', 'lastname': 'h', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6937e078-9df7-5f3d-b1c2-15e2030fca09', 'word_count': 1630, 'uri': 'nyt://article/6937e078-9df7-5f3d-b1c2-15e2030fca09'}, {'abstract': 'The feeling now is that the Kings will win the Stanley Cup, and that only the details (number of games, parade route) need to be worked out. Whether or not that bears out, the team’s second consecutive 2-1 overtime victory against the Devils lifted a weight off of the organization that had been lingering for 19 years.', 'web_url': 'https://slapshot.blogs.nytimes.com/2012/06/03/stick-episodes-aside-kings-feeling-comfortable-with-2-0-series-lead/', 'snippet': 'The feeling now is that the Kings will win the Stanley Cup, and that only the details (number of games, parade route) need to be worked out. Whether or not that bears out, the team’s second consecutive 2-1 overtime victory against the Devils lifte...', 'lead_paragraph': 'The feeling now is that the Kings will win the Stanley Cup, and that only the details (number of games, parade route) need to be worked out. Whether or not that bears out, the team’s second consecutive 2-1 overtime victory against the Devils — after a circular tour of the Devils’ zone by Jeff Carter that was as mesmerizing as Anze Kopitar’s breakaway in Game 1 — lifted a weight off of the organization that had been lingering for 19 years.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Stick Episodes Aside, Kings Feeling Comfortable With 2-0 Series Lead', 'kicker': 'Slap Shot', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Hockey, Ice', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Stanley Cup', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'McSorley, Marty