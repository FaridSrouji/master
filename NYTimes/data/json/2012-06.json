s', 'value': 'Republican Party', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Europe', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Germany', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 11, 'major': 'N'}], 'pub_date': '2012-06-10T02:19:01+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Jackie Calmes', 'person': [{'firstname': 'Jackie', 'middlename': None, 'lastname': 'Calmes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f8f0efbe-d11f-50a4-9a1b-08d8172d4ab8', 'word_count': 610, 'uri': 'nyt://article/f8f0efbe-d11f-50a4-9a1b-08d8172d4ab8'}, {'abstract': 'Corrections appearing in print on June 10, 2012.', 'web_url': 'https://www.nytimes.com/2012/06/10/pageoneplus/corrections-june-10.html', 'snippet': 'Corrections appearing in print on June 10, 2012.', 'lead_paragraph': 'INTERNATIONAL', 'print_section': 'A', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Corrections: June 10', 'kicker': None, 'content_kicker': None, 'print_headline': 'Corrections', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-06-10T02:44:34+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Correction', '_id': 'nyt://article/d0b416d7-5352-5b4e-8b54-7be0ab17e4f8', 'word_count': 1012, 'uri': 'nyt://article/d0b416d7-5352-5b4e-8b54-7be0ab17e4f8'}, {'abstract': 'A two-run shot by Mark Teixeira and a solo shot by Curtis Granderson overcame a pair of solo home runs from the visiting Mets.', 'web_url': 'https://www.nytimes.com/2012/06/10/sports/baseball/yankees-home-runs-help-beat-the-mets.html', 'snippet': 'A two-run shot by Mark Teixeira and a solo shot by Curtis Granderson overcame a pair of solo home runs from the visiting Mets.', 'lead_paragraph': 'The Yankees have thrived on home runs this season, winning 72 percent of their games when they hit at least one, and losing all 12 of their games when they hit none. So when Mark Teixeira hit a 2-2 pitch over the wall in right in the sixth inning Saturday, the Yankees received a clear signal that a victory was in the offing.', 'print_section': 'SP', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/10/sports/YANKS1/YANKS1-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/06/10/sports/YANKS1/YANKS1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/10/sports/YANKS1/YANKS1-jumbo.jpg', 'height': 541, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/10/sports/YANKS1/YANKS1-superJumbo.jpg', 'height': 1082, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/10/sports/YANKS1/YANKS1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/10/sports/YANKS1/YANKS1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/10/sports/YANKS1/YANKS1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Yankees’ Home Runs Help Beat the Mets', 'kicker': 'Yankees 4, Mets 2', 'content_kicker': None, 'print_headline': 'An Imbalance of Power', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Granderson, Curtis', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Teixeira, Mark', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Mets', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Hughes, Phil', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Yankees', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Baseball', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-06-10T03:24:34+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By David Waldstein', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Waldstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3ebf2c4c-27ea-5848-aba3-4d62ddf9c818', 'word_count': 964, 'uri': 'nyt://article/3ebf2c4c-27ea-5848-aba3-4d62ddf9c818'}, {'abstract': 'The Devils handed the Kings their first loss on the road in 11 games, winning their second straight game and cutting their series deficit to 3-2.', 'web_url': 'https://www.nytimes.com/2012/06/10/sports/hockey/stanley-cup-playoffs-devils-snap-kings-road-streak-to-force-game-six.html', 'snippet': 'The Devils handed the Kings their first loss on the road in 11 games, winning their second straight game and cutting their series deficit to 3-2.', 'lead_paragraph': 'NEWARK — The spell is broken. The Kings’ aura of invincibility is shattered. The Stanley Cup finals are going back to Los Angeles for Game 6. ', 'print_section': 'SP', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/10/spo