age', 'url': 'images/2012/06/04/arts/dawson-obit/dawson-obit-superJumbo.jpg', 'height': 1639, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/04/arts/dawson-obit/dawson-obit-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/04/arts/dawson-obit/dawson-obit-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/04/arts/dawson-obit/dawson-obit-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Richard Dawson, Host Who Kissed on ‘Family Feud’, Dies at 79', 'kicker': None, 'content_kicker': None, 'print_headline': 'Richard Dawson, 79, Host Who Kissed on ‘Family Feud’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Dawson, Richard', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': "Hogan's Heroes (TV Program)", 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'Family Feud (TV Program)', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-06-03T21:25:40+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Michael Schwirtz', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Schwirtz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/56aa20e6-76af-56c1-865d-43cc29b5ae32', 'word_count': 618, 'uri': 'nyt://article/56aa20e6-76af-56c1-865d-43cc29b5ae32'}, {'abstract': 'For Bob Bradley, coaching Egypt is about more than wins and losses; it’s about helping a nation recover.', 'web_url': 'https://goal.blogs.nytimes.com/2012/06/03/winning-start-for-bradleys-egypt-but-challenges-are-many/', 'snippet': 'For Bob Bradley, coaching Egypt is about more than wins and losses; it’s about helping a nation recover.', 'lead_paragraph': 'Bob Bradley on Friday coached his first World Cup qualifier since being hired as Egypt’s manager last year, but he did so in an empty stadium — a consequence of the violence that plagued the country in general and soccer games in particular in the wake of the overthrow of the former president Hosni Mubarak. James Montague was in Alexandria for the game, reporting on the hardships, the sadness, the challenges and the pride Bradley feels as he tries to lead the Pharoahs back to their customary place atop African soccer.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Winning Start for Bradley’s Egypt, but Challenges Are Many', 'kicker': 'Goal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Soccer', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bradley, Bob', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Egypt', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-06-03T21:40:08+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Soccer', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/f2a0770d-9948-5fcb-9bbe-56a27c603047', 'word_count': 140, 'uri': 'nyt://article/f2a0770d-9948-5fcb-9bbe-56a27c603047'}, {'abstract': 'The Scion Rock Fest, which took place on Saturday in Tampa, Fla., offered 26 bands playing metal and beyond, with no particular allegiance to locality or subgenre.', 'web_url': 'https://www.nytimes.com/2012/06/04/arts/music/26-metal-bands-at-scion-rock-fest-in-tampa-fla.html', 'snippet': 'The Scion Rock Fest, which took place on Saturday in Tampa, Fla., offered 26 bands playing metal and beyond, with no particular allegiance to locality or subgenre.', 'lead_paragraph': 'TAMPA, Fla. — At the end of a loud, slow and steadying set on Saturday night by the doom-metal band Saint Vitus, its singer Scott Weinrich, known as Wino, methodically distributed Pabst Blue Ribbon tall boys to members of the audience and sang an old song, “Born Too Late,” over big riffs, a restful tempo and a minor key. It was music with little anxiety.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/04/arts/scion/scion-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/06/04/arts/scion/scion-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/04/arts/scion/scion-jumbo.jpg', 'height': 629, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/04/arts/scion/scion-superJumbo.jpg', 'height': 1259, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Metalheads of All Alloys, Swirling Into the Night', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Metalheads of All Alloys, Swirling Into the Night', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Rock Music', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Tampa (Fla)', 'rank': 3, 'major': 