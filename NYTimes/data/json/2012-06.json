12/06/03/travel/03BARNS-slide-33N0/03BARNS-slide-33N0-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/03/travel/03BARNS-slide-33N0/03BARNS-slide-33N0-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/03/travel/03BARNS-slide-33N0/03BARNS-slide-33N0-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Barns of Iowa', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Barns', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Iowa', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-06-01T18:21:18+0000', 'document_type': 'multimedia', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/a494dd99-ae76-58fd-8ad2-bfee97bd4d70', 'word_count': 0, 'uri': 'nyt://slideshow/a494dd99-ae76-58fd-8ad2-bfee97bd4d70'}, {'abstract': 'As barns in Iowa quickly disappear, the fight is on to preserve this part of the state’s rural heritage.', 'web_url': 'https://www.nytimes.com/2012/06/03/travel/in-iowa-working-to-save-historic-barns.html', 'snippet': 'As barns in Iowa quickly disappear, the fight is on to preserve this part of the state’s rural heritage.', 'lead_paragraph': 'THE mud-crusted Ford Ranger kicked up dusty plumes as we tore up the gravel roads near Decorah, in northeastern Iowa. “See that one?” our guide, Marlene Fenstermann, called out, pointing to a towering roof barely visible over a windbreak of pines. “That’s a rare English bridge barn.” Before I could get a good look, we crested a ridge over a rural landscape that could have been plucked from a Grant Wood painting. Chunky limestone outcroppings, smoothly planted knolls, stands of timber and everywhere, it seemed, barns.', 'print_section': 'TR', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/03/travel/03IOWA_395/03IOWA_395-jumbo.jpg', 'height': 400, 'width': 395, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/03/travel/03IOWA_395/03IOWA_395-superJumbo.jpg', 'height': 400, 'width': 395, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/03/travel/03IOWA_395/03IOWA_395-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/03/travel/03IOWA_395/03IOWA_395-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/03/travel/03IOWA_395/03IOWA_395-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'If These Barns Could Talk', 'kicker': 'Journeys', 'content_kicker': None, 'print_headline': 'If These Barns Could Talk', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Barns', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Iowa Barn Foundation', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Iowa', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Midwestern States (US)', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-06-01T18:21:30+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Ceil Miller Bouchet', 'person': [{'firstname': 'Ceil', 'middlename': 'Miller', 'lastname': 'Bouchet', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1e1c0cbf-1905-5d8e-b724-8036aa362f32', 'word_count': 1244, 'uri': 'nyt://article/1e1c0cbf-1905-5d8e-b724-8036aa362f32'}, {'abstract': 'Can you raise children with “faith” in a household with two very separate religious traditions?', 'web_url': 'https://parenting.blogs.nytimes.com/2012/06/01/raising-interfaith-kids-when-hindu-meets-catholic/', 'snippet': 'Can you raise children with “faith” in a household with two very separate religious traditions?', 'lead_paragraph': 'P. is Hindu and her husband was raised Catholic. Both, though, went their own way with religion as young adults — which is scarcely surprising, since they married each another. P. and her husband planned to share both religions with their children. “They would celebrate Diwali, Janmashtami, Easter and Christmas. They would grow up knowing all that we knew, and decide as they grew what path suited them best,” P. said.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Raising Interfaith Kids When Hindu Meets Catholic', 'kicker': 'Motherlode', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Children and Childhood', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Families and Family Life', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Hinduism', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Parenting', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Religion and Belief', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'ROMAN CATHOLIC CHURCH', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-06-01T18:23:17+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': "By Kj Dell'Antonia", 'person': [{'firstname': 'Kj', 'middlename': None, 'lastname': "Dell'Antonia", 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/33055eaa-db76-50a4-9d6d-a33bf8e9b79b', 'word_count': 569, 'uri': 'nyt://article/33055eaa-db76-50a4-9d6d-a33bf8e9b79b'}, {'abstract': 'Marian Gaborik, the Rangers’ top scorer during the regular season who struggled in the playoffs, said he sustained a torn labrum late in the season.', 'web_url': 'https://slapshot.blogs.nytimes.com/2012/06/01/gaborik-will-have-shoulder-surgery-is-expected-to-miss-at-least-five-months/', 'snippet': 'Marian Gaborik, the Rangers’ top scorer during the regular season who struggled in the playoffs, said he sustained a torn labrum late in the season.', 'lead_paragraph': '5:58 p.m. | Updated  Winger Marian Gaborik, the Rangers’ top scorer during the regular season, will have surgery to repair a torn labrum in his right shoulder and will miss five to six months, he said Friday at a news conference in his hometown, Trencin, Slovakia.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Gaborik Will Have Shoulder Surgery and Is Expected to Miss at Least Five Months', 'kicker': 'Slap Shot', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Gaborik, Marian', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Rangers', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-06-01T18:24:30+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Hockey', 'byline': {'original': 'By Jeff Z. Klein', 'person': [{'firstname': 'Jeff', 'middlename': 'Z.', 'lastname': 'Klein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material'