e', 'url': 'images/2012/06/29/fashion/runway/junyawatanabe_mws13app-slide-KQ6K/junyawatanabe_mws13app-slide-KQ6K-articleLarge.jpg', 'height': 900, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/06/29/fashion/runway/junyawatanabe_mws13app-slide-KQ6K/junyawatanabe_mws13app-slide-KQ6K-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 900}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/29/fashion/runway/junyawatanabe_mws13app-slide-KQ6K/junyawatanabe_mws13app-slide-KQ6K-jumbo.jpg', 'height': 1536, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/29/fashion/runway/junyawatanabe_mws13app-slide-KQ6K/junyawatanabe_mws13app-slide-KQ6K-superJumbo.jpg', 'height': 2048, 'width': 1365, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/29/fashion/runway/junyawatanabe_mws13app-slide-KQ6K/junyawatanabe_mws13app-slide-KQ6K-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Junya Watanabe Men’s', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-06-29T14:03:25+0000', 'document_type': 'multimedia', 'news_desk': 'Fashion & Style', 'section_name': 'Fashion & Style', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/b35363b5-06b0-52d5-98e0-ba63fefaebf7', 'word_count': 0, 'uri': 'nyt://slideshow/b35363b5-06b0-52d5-98e0-ba63fefaebf7'}, {'abstract': 'Poets are staging events around the 2012 Olympics, but they once competed in the Games.', 'web_url': 'https://www.nytimes.com/2012/07/01/books/review/poetrys-relationship-with-the-olympics.html', 'snippet': 'Poets are staging events around the 2012 Olympics, but they once competed in the Games.', 'lead_paragraph': 'Sports fans are not necessarily renowned for their literary tastes — their passions oft running less to soulful ruminations than to beer-fueled stadium chants — so Olympics observers may be flummoxed by the sudden proliferation of poetry related to the 2012 Games. This weekend, international poets have converged on London to orate in 50 languages at a festival called Poetry Parnassus, with 100,000 copies of their collected work to be dropped by helicopter on the venue by the Thames. Another poetic project, “The Written World,” will feature a poem from each of the 204 competing Olympic countries read live and broadcast daily by the BBC. And verse has been engraved on plaques of stone, metal and wood emblazoned at strategic points throughout the Olympic Park, for the edification of athlete and spectator alike.', 'print_section': 'BR', 'print_page': '31', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/07/01/books/review/Perrottet/Perrottet-jumbo.jpg', 'height': 1024, 'width': 865, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/07/01/books/review/Perrottet/Perrottet-superJumbo.jpg', 'height': 2048, 'width': 1730, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/07/01/books/review/Perrottet/Perrottet-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/07/01/books/review/Perrottet/Perrottet-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/07/01/books/review/Perrottet/Perrottet-thumbLarge.jpg', 'height': 177, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Champions of Verse', 'kicker': 'Essay', 'content_kicker': None, 'print_headline': 'Champions of Verse', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Olympic Games (2012)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Poetry and Poets', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Olympic Games', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-06-29T14:11:02+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Tony Perrottet', 'person': [{'firstname': 'Tony', 'middlename': None, 'lastname': 'Perrottet', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fb4b8363-5a23-5e4b-970c-30393294b1a7', 'word_count': 1270, 'uri': 'nyt://article/fb4b8363-5a23-5e4b-970c-30393294b1a7'}, {'abstract': 'Before he turned to books, Jonathan Evison was the lead singer of a 1980s Seattle punk band called March of Crimes.', 'web_url': 'https://www.nytimes.com/2012/07/01/books/review/up-front.html', 'snippet': 'Before he turned to books, Jonathan Evison was the lead singer of a 1980s Seattle punk band called March of Crimes.', 'lead_paragraph': 'With two novels published and a third arriving next month, Jonathan Evison — who reviews Anna Keesey’s “Little Century” this week — has already made big noise as a writer. Before he turned to books, though, he made a different sort of big noise: as the lead singer of a 1980s Seattle punk band called March of Crimes. “My life as a rock ’n’ roller was dead sexy,” he said in a recent e-mail: “Four sweaty teenage dudes in a run-down van. A lot of sleeping on questionable sofas. A lot of doing other stuff on questionable sofas. Getting paid in pot. All in all, a lot like my first book tour.”', 'print_section': 'BR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/07/01/books/review/Upfront/Upfront-jumbo.jpg', 'height': 1024, 'width': 619, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/07/01/books/review/Upfront/Upfront-superJumbo.jpg', 'height': 1956, 'width': 1183, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Up Front', 'kicker': None, 'content_kicker': None, 'print_headline': 'Up Front', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-06-29T14:12:10+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By The Editors', 'person': [], 'organization': 'The Editors'}, 'type_of_material': 'News', '_id': 'nyt://article/60132c49-8039-52b3-bc0e-ddc3bd478f8c', 'word_count': 283, 'uri': 'nyt://article/60132c49-8039-52b3-bc0e-ddc3bd478f8c'}, {'abstract': 'Recently reviewed books of particular interest.', 'web_url': 'https://www.nytimes.com/2012/07/01/books/review/editors-choice.html', 'snippet': 'Recently reviewed books of particular interest.', 'lead_paragraph': 'VICTORY: The Triumphant Gay Revolution,  by Linda Hirshman. (Harper/HarperCollins, $27.99.) Written with knowing finesse, this expansive history of gay rights from the early 20th century to the present draws on archival records and interviews.', 'print_section': 'BR', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Editors’ Choice', 'kicker': None, 'content_kicker': None, 'print_headline': "Editors' Choice | Recent Books Of Particular Interest", 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-06-29T14:14:40+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'List', '_id': 'nyt://article/faa1e8e6-87a7-59a3-ba8b-fc8865b08a3a', 'word_count': 275, 'uri': 'nyt://article/faa1e8e6-87a7-59a3-ba8b-fc8865b08a3a'}, {'abstract': 'A collection of links from the reporters and editors of the Dining section.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2012/06/29/what-were-reading-468/', 'snippet': 'A collection of links from the reporters and editors of the Dining section.', 'lead_paragraph': 'The New York Times: Oh, so that’s why tomatoes are often so shiny and flavorless! — Jeff Gordinier', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What We’re Reading', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-06-29T14:15:23+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/92884ead-53c8-54bc-b973-994e9c4af751', 'word_count': 548, 'uri': 'nyt://article/92884ead-53c8-54bc-b973-994e9c4af751'}, {'abstract': 'Paperback books of particular interest.', 'web_url': 'https://www.nytimes.com/2012/07/01/books/review/paperback-row.html', 'snippet': 'Paperback books of particular interest.', 'lead_paragraph': 'ONCE UPON A RIVER,  by Bonnie Jo Campbell. (Norton, $15.95.) Campbell’s first novel, “Q Road” (2002), told the story of Rachel Crane, an isolated and determined young woman in Kalamazoo County, Mich. This follow-up is the story of her mother, Margo, herself a difficult and willful young woman, in rural Michigan in the late 1970s. Raped by an uncle at 15, Margo develops a taste for hunting that turns her small world upside down and leaves her adrift as she evades both her relatives and the authorities.', 'print_section': 'BR', 'print_page': '28', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Paperback Row', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-06-29T14:15:38+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Ihsan Taylor', 'person': [{'firstname': 'Ihsan', 'middlename': None, 'lastname': 'Taylor', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'List', '_id': 'nyt://article/2a25a114-004d-5fae-a12f-99bbb157c26a', 'word_count': 528, 'uri': 'nyt://article/2a25a114-004d-5fae-a12f-99bbb157c26a'}, {'abstract': 'Justin Wolff’s look at the life of the painter Thomas Hart Benton doesn’t shy away from ambiguity.', 'web_url': 'https://www.nytimes.com/2012/07/01/books/review/thomas-hart-benton-by-justin-wolff.html', 'snippet': 'Justin Wolff’s look at the life of the painter Thomas Hart Benton doesn’t shy away from ambiguity.', 'lead_paragraph': 'In 1934, Thomas Hart Benton, purveyor of muscular scenes of American life, was the country’s most famous painter and one of the very few ever to have his picture on the cover of Time. In 1949, Jackson Pollock, painter of abstract drips and swirls, appeared in a four-page spread in Life teasingly headlined “Is He the Greatest Living Painter in the United States?” Yes or no didn’t really matter: he was the nation’s new art star.', 'print_section': 'BR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/07/01/books/review/01JPCOTTER/01JPCOTTER-jumbo.jpg', 'height': 1024, 'width': 978, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/07/01/books/review/01JPCOTTER/01JPCOTTER-superJumbo.jpg', 'height': 2048, 'width': 1957, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/07/01/books/review/01JPCOTTER/01JPCOTTER-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/07/01/books/review/01JPCOTTER/01JPCOTTER-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/07/01/books/review/01JPCOTTER/01JPCOTTER-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'America’s Portraitist', 'kicker': None, 'content_kicker': None, 'print_headline': 'America’s Portraitist', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'BENTON, THOMAS HART', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Wolff, Justin', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-06-29T14:21:28+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By