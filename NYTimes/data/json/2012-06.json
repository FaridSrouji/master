, 'major': 'N'}, {'name': 'persons', 'value': 'Reagan, Ronald Wilson', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-06-27T18:09:15+0000', 'document_type': 'multimedia', 'news_desk': 'ContinuousNews', 'section_name': 'Technology', 'byline': {'original': 'Emily B. Hager, Joshua Brustein, Jeremy Beiler, Mac William Bishop, Channon Hodge, Nadia Sussman and Pedro Rosado', 'person': [{'firstname': 'Emily', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/2e36a5b1-ef8a-5aa8-9501-08c4e4e8c0e5', 'word_count': 0, 'uri': 'nyt://video/2e36a5b1-ef8a-5aa8-9501-08c4e4e8c0e5'}, {'abstract': 'One day a week without driving means no soccer, gymnastics, play rehearsals, piano lessons or meetings to distract us from actually talking to each other.', 'web_url': 'https://parenting.blogs.nytimes.com/2012/06/27/self-reliance-and-shabbat-in-a-walkable-neighborhood/', 'snippet': 'One day a week without driving means no soccer, gymnastics, play rehearsals, piano lessons or meetings to distract us from actually talking to each other.', 'lead_paragraph': 'Wherever I move, I always know which neighborhood I want to live in. I don’t aim for proximity to organic freshly roasted coffee, a Whole Foods or Trader Joe’s, or even a park and green space, but to a synagogue. One day a week my family forgoes modern methods of transit and reverts to the primal ways of our ancestors by walking wherever it is we want to go, which makes it necessary for us to live in walking distance to our place of worship.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Finding Childhood Independence in the Sabbath', 'kicker': 'Motherlode', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Children and Childhood', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Families and Family Life', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Jews and Judaism', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Parenting', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Walking', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-06-27T18:23:16+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Beth Kissileff', 'person': [{'firstname': 'Beth', 'middlename': None, 'lastname': 'Kissileff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b261d07a-34e4-5030-92ad-546564a5f103', 'word_count': 763, 'uri': 'nyt://article/b261d07a-34e4-5030-92ad-546564a5f103'}, {'abstract': 'Brendan Shanahan is one of the best left wings in N.H.L. history, second on the career scoring list. But despite three Stanley Cup wins and an Olympic gold medal, he was passed over by the Hockey Hall of Fame.', 'web_url': 'https://slapshot.blogs.nytimes.com/2012/06/27/after-a-hall-of-fame-snub-for-shanahan-plenty-of-questions/', 'snippet': 'Brendan Shanahan is one of the best left wings in N.H.L. history, second on the career scoring list. But despite three Stanley Cup wins and an Olympic gold medal, he was passed over by the Hockey Hall of Fame.', 'lead_paragraph': 'Some hockey fans are scratching their heads, wondering how Brendan Shanahan, the\xa0 former Blues, Rangers, Devils and Red Wings left wing,\xa0was not voted into the Hockey Hall of Fame this year. The Hall released its list of 2012 honorees on Tuesday, with Joe Sakic, Adam Oates, Pavel Bure and Mats Sundin to be enshrined on Nov. 12.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'After a Hall of Fame Snub for Shanahan, Plenty of Questions', 'kicker': 'Slap Shot', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Hockey, Ice', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Sakic, Joe', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Shanahan, Brendan', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Sundin, Mats', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Detroit Red Wings', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Hockey Hall of Fame', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'National Hockey League', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Rangers', 'rank': 8, 'major': 'N'}], 'pub_date': '2012-06-27T18:32:17+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Hockey', 'byline': {'original': 'By Joanne C. Gerstner', 'person': [{'firstname': 'Joanne', 'middlename': 'C.', 'lastname': 'Gerstner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/053337d3-4cca-508b-82ca-8bf01fff2c7f', 'word_count': 718, 'uri': 'nyt://article/053337d3-4cca-508b-82ca-8bf01fff2c7f'}, {'abstract': 'Merle Hazard, that great musicalizer of economic dysfunction, has released a new song.', 'web_url': 'https://economix.blogs.nytimes.com/2012/06/27/boogeying-off-the-fiscal-cliff/', 'snippet': 'Merle Hazard, that great musicalizer of economic dysfunction, has released a new song.', 'lead_paragraph': 'Merle Hazard, that great musicalizer of economic dysfunction, has released a new song. This one is a surf-style number about driving off the fiscal cliff. Enjoy:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Boogeying Off the Fiscal Cliff', 'kicker': 'Economix', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-06-27T18:36:01+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Catherine Rampell', 'person': [{'firstname': 'Catherine', 'middlename': None, 'lastname': 'Rampell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/af6eab9f-6f0f-56d3-bc1a-000a8fa08e13', 'word_count': 26, 'uri': 'nyt://article/af6eab9f-6f0f-56d3-bc1a-000a8fa08e13'}, {'abstract': 'An earlier, longer draft of Peter de Jonge’s magazine story on Andy Murray and Ivan Lendl included a more extensive portrait of Murray in distress mode. Here, an excerpt.', 'web_url': 'https://6thfloor.blogs.nytimes.com/2012/06/27/andy-murrays-osmolarity-is-looking-good-so-far/', 'snippet': 'An earlier, longer draft of Peter de Jonge’s magazine story on Andy Murray and Ivan Lendl included a more extensive portrait of Murray in distress mode. Here, an excerpt.', 'lead_paragraph': 'Andy Murray’s demeanor has been dogging him lately. Yesterday, before Nikolay Davydenko took the court for his first-round match at Wimbledon against Murray, the British press was full of Davydenko’s comments about Murray’s on-court affect and his tendency to put his hurt on display. “We just laugh sometimes,” The Sun (among others) quoted Davydenko as saying. “Sometimes he walks on court, he looks tired, like he doesn’t want to run anymore, and then he runs like an animal. He has done that all his career. He just walks and he’s like, ‘Ah, I don’t want to play any more.’ Then he starts returning and running, and you see his condition is very good. Maybe it is a special Scottish thing.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Andy Murray’s Osmolarity Is Looking Good So Far', 'kicker': 'The 6th Floor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Tennis', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Wimbledon Tennis Tournament', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'v