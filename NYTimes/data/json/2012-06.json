PUIS-obit/CHAPPUIS-obit-superJumbo.jpg', 'height': 1626, 'width': 1525, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/18/sports/CHAPPUIS-obit/CHAPPUIS-obit-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/18/sports/CHAPPUIS-obit/CHAPPUIS-obit-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/18/sports/CHAPPUIS-obit/CHAPPUIS-obit-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Bob Chappuis, Halfback Rescued in World War II, Dies at 89', 'kicker': None, 'content_kicker': None, 'print_headline': 'Bob Chappuis, 89, Halfback Rescued in War', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football (College)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'World War II (1939-45)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Michigan', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-06-18T02:41:00+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'College Football', 'byline': {'original': 'By Richard Goldstein', 'person': [{'firstname': 'Richard', 'middlename': None, 'lastname': 'Goldstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/7ac653de-a04d-5dd6-8c00-3d241b34b5de', 'word_count': 703, 'uri': 'nyt://article/7ac653de-a04d-5dd6-8c00-3d241b34b5de'}, {'abstract': 'The volatility of white working class voters explains quite a bit about our political life.', 'web_url': 'https://campaignstops.blogs.nytimes.com/2012/06/17/canaries-in-the-coal-mine/', 'snippet': 'The volatility of white working class voters explains quite a bit about our political life.', 'lead_paragraph': 'Over the past few decades, working class whites – loosely defined as those without college degrees – have been a strikingly reliable indicator of the strength of the two main political parties. These voters are highly volatile and their shifting loyalties are a powerful factor in determining control of Congress and of the White House, according to recently re-analyzed exit poll data provided to the Times by Alan Abramowitz, a political scientist at Emory, and Sam Best, a political scientist at the University of Connecticut.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Canaries in the Coal Mine', 'kicker': 'Campaign Stops', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidents and Presidency (US)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Teixeira, Ruy', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Party', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-06-18T02:47:12+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Thomas B. Edsall', 'person': [{'firstname': 'Thomas', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cf26573e-d6a1-5cda-b604-e14187a30b04', 'word_count': 1227, 'uri': 'nyt://article/cf26573e-d6a1-5cda-b604-e14187a30b04'}, {'abstract': 'A lush ecosystem has grown around High Island 389-A, a dormant oil platform in the Gulf of Mexico that is facing demolition under Interior Department rules.', 'web_url': 'https://www.nytimes.com/2012/06/18/us/a-fight-to-convert-high-island-a-platform-into-a-reef.html', 'snippet': 'A lush ecosystem has grown around High Island 389-A, a dormant oil platform in the Gulf of Mexico that is facing demolition under Interior Department rules.', 'lead_paragraph': 'AUSTIN, Tex. — The dormant oil platform known as High Island 389-A rises out of the Gulf of Mexico about 100 miles southeast of Galveston. Below the surface, corals, sea fans and sponges cover its maze of pipes. Schools of jack and snapper, solitary grouper and barracuda circle in its shadows. Dive boats periodically stop at the enormous structure, where dolphins, sea turtles and sharks are often spotted.', 'print_section': 'A', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/18/us/PLATFORM-1/PLATFORM-1-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/06/18/us/PLATFORM-1/PLATFORM-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/18/us/PLATFORM-1/PLATFORM-1-jumbo.jpg', 'height': 684, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/18/us/PLATFORM-1/PLATFORM-1-superJumbo.jpg', 'height': 1368, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/18/us/PLATFORM-1/PLATFORM-1-thumbStandard.jpg', 'height': 