age', 'url': 'images/2012/06/12/world/MEXICO-1/MEXICO-1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/12/world/MEXICO-1/MEXICO-1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'In Mexico, a Candidate Stands Out Despite Attacks', 'kicker': None, 'content_kicker': None, 'print_headline': 'In Mexico, a Candidate Stands Out Despite Attacks', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'National Action Party (Mexico)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Political Advertising', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Mexico', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Institutional Revolutionary Party', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Party of the Democratic Revolution (Mexico)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Pena Nieto, Enrique', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Vazquez Mota, Josefina', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Lopez Obrador, Andres Manuel', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Guerrero (Mexico)', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 10, 'major': 'N'}, {'name': 'subject', 'value': 'Elections', 'rank': 11, 'major': 'N'}], 'pub_date': '2012-06-11T06:00:49+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Americas', 'byline': {'original': 'By Randal C. Archibold', 'person': [{'firstname': 'Randal', 'middlename': 'C.', 'lastname': 'Archibold', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id'