': 'organizations', 'value': 'Hilton Worldwide', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-06-18T20:31:30+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By John Greenleaf', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Greenleaf', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0955e895-7497-5b30-89c1-ce22ce9290ed', 'word_count': 615, 'uri': 'nyt://article/0955e895-7497-5b30-89c1-ce22ce9290ed'}, {'abstract': 'Lawyers and judges ponder paths for using the law to foster sustainable human advancement.', 'web_url': 'https://dotearth.blogs.nytimes.com/2012/06/18/dispatches-from-rio-the-legal-environment/', 'snippet': 'Lawyers and judges ponder paths for using the law to foster sustainable human advancement.', 'lead_paragraph': 'Through most of this month and the next few days, Rio de Janeiro, Brazil, is hosting an enormous gathering of environmentalists, diplomats, scientists, indigenous leaders and others trying to break new ground in international efforts to fit human activities and aspirations within the constraints that come with life on a finite planet. This is “Rio Plus 20” — the United Nations Conference on Sustainable Development, which marks the 20th anniversary of the 1992 meeting known as the Earth Summit.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Dispatches from Rio – The Legal Environment', 'kicker': 'Dot Earth', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Biodiversity', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Environment', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Sustainable Living', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Treaties', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'United