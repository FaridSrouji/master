': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By Christopher Clarey', 'person': [{'firstname': 'Christopher', 'middlename': None, 'lastname': 'Clarey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Special Report', '_id': 'nyt://article/7900a5f8-76b3-5776-987d-e40998fb72d7', 'word_count': 2421, 'uri': 'nyt://article/7900a5f8-76b3-5776-987d-e40998fb72d7'}, {'abstract': 'Cambodia’s Foreign Ministry said Friday it had no plans to extradite Patrick Devillers, a French architect with links to the disgraced Chinese politician Bo Xilai and his wife.', 'web_url': 'https://www.nytimes.com/2012/06/23/world/asia/cambodia-says-it-will-not-extradite-french-architect-to-china.html', 'snippet': 'Cambodia’s Foreign Ministry said Friday it had no plans to extradite Patrick Devillers, a French architect with links to the disgraced Chinese politician Bo Xilai and his wife.', 'lead_paragraph': 'HONG KONG — Cambodia’s Foreign Ministry said Friday that the country had no plans to extradite to China or France a detained French architect with links to a disgraced Chinese politician and his wife, but that the architect was not yet being set free, either.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Cambodia Ambiguous on Plans for French Architect', 'kicker': None, 'content_kicker': None, 'print_headline': 'Cambodia Ambiguous on Plans for French Architect', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Cambodia', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Devillers, Patrick Henri', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Heywood, Neil', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Bo Xilai', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Gu Kailai', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank':