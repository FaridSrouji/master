_page': '25A', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/03/us/03ttprofessor/03ttprofessor-jumbo.jpg', 'height': 776, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/03/us/03ttprofessor/03ttprofessor-superJumbo.jpg', 'height': 1553, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Crosses Are Gone, but Campus Clash Lives On', 'kicker': 'The Texas Tribune', 'content_kicker': None, 'print_headline': 'Crosses Are Gone, but Campus Clash Lives On', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Colleges and Universities', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Religion and Belief', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Religion-State Relations', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Freedom of Speech and Expression', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Texas A&M University', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-06-02T21:41:47+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Reeve Hamilton', 'person': [{'firstname': 'Reeve', 'middlename': None, 'lastname': 'Hamilton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/da0d7cdb-db1a-574a-8c1c-241762cff951', 'word_count': 1202, 'uri': 'nyt://article/da0d7cdb-db1a-574a-8c1c-241762cff951'}, {'abstract': 'Mr. Shorris created the Clemente Course in the Humanities, a free class in philosophy, the arts and history for the poor and forgotten.', 'web_url': 'https://www.nytimes.com/2012/06/03/us/earl-shorris-who-fought-poverty-with-knowledge-dies-at-75.html', 'snippet': 'Mr. Shorris created the Clemente Course in the Humanities, a free class in philosophy, the arts and history for the poor and forgotten.', 'lead_paragraph': 'Earl Shorris, a social critic and author whose interviews with prison inmates for a book inspired him to start a now nationally recognized educational program that introduces the poor and the unschooled to Plato, Kant and Tolstoy, died on May 27 in New York. He was 75.', 'print_section': 'A', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/03/us/dog-SHORRIS--obit/dog-SHORRIS--obit-jumbo.jpg', 'height': 1024, 'width': 709, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/03/us/dog-SHORRIS--obit/dog-SHORRIS--obit-superJumbo.jpg', 'height': 1750, 'width': 1211, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/03/us/dog-SHORRIS--obit/dog-SHORRIS--obit-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/03/us/dog-SHORRIS--obit/dog-SHORRIS--obit-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/03/us/dog-SHORRIS--obit/dog-SHORRIS--obit-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Earl Shorris, 75, Dies; Fought Poverty With Knowledge', 'kicker': None, 'content_kicker': None, 'print_headline': 'Earl Shorris, 75, Dies; Fought Poverty With Knowledge', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Writing and Writers', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Shorris, Earl', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Humanities', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Economic Conditions and Trends', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Prisons and Prisoners', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Poverty', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-06-02T21:47:53+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Paul Vitello', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Vitello', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/5029b9d7-148b-516a-b420-5c5fb0b9828a', 'word_count': 974, 'uri': 'nyt://article/5029b9d7-148b-516a-b420-5c5fb0b9828a'}, {'abstract': 'Narcotic painkillers, which can mask rather than treat pain, can increase disability payouts and expenses by delaying an employee’s return to work.', 'web_url': 'https://www.nytimes.com/2012/06/03/health/painkillers-add-costs-and-delays-to-workplace-injuries.html', 'snippet': 'Narcotic painkillers, which can mask rather than treat pain, can increase disability payouts and expenses by delaying an employee’s return to work.', 'lead_paragraph': 'Workplace insurers are accustomed to making billions of dollars in payments each year, with the biggest sums going to employees hurt in major accidents, like those mangled by machines or crushed in building collapses. ', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/03/us/PAIN-1/PAIN-1-articleLarge.jpg', 'height': 370, 'width': 600, 'subType': 'xlarge', 'crop_na