immerman-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/04/us/04zimmerman/04zimmerman-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Obeying Judge’s Order, Zimmerman Turns Himself In and Is Back in a Florida Jail', 'kicker': None, 'content_kicker': None, 'print_headline': 'Obeying Judge’s Order, Zimmerman Turns Himself In and Is Back in a Florida Jail', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Lester, Kenneth R Jr', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Sanford (Fla)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Martin, Trayvon', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Zimmerman, George', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-06-03T17:46:38+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Lizette Alvarez', 'person': [{'firstname': 'Lizette', 'middlename': None, 'lastname': 'Alvarez', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1f56fc39-a7ec-563b-b2fb-fdfc2f7583b4', 'word_count': 578, 'uri': 'nyt://article/1f56fc39-a7ec-563b-b2fb-fdfc2f7583b4'}, {'abstract': '“Push Girls,” on Sundance Channel, follows attractive young women in wheelchairs as they push boundaries.', 'web_url': 'https://www.nytimes.com/2012/06/04/arts/television/push-girls-on-sundance-features-women-in-wheelchairs.html', 'snippet': '“Push Girls,” on Sundance Channel, follows attractive young women in wheelchairs as they push boundaries.', 'lead_paragraph': '“Push Girls,” a reality show about five attractive women in wheelchairs, is likely to engender a number of reactions in viewers, not all of them helpful to the cause of illuminating the lives of people with disabilities. From the premiere, showing Monday night on the Sundance Channel, it’s not entirely clear which of those reactions the series’s creators are going for. But the intent seems to be good, and if they can find the elusive line between voyeuristic and didactic, the show could become something of a milestone for a lot of people who have felt invisible for a long time.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/04/arts/04push-web/04push-web-jumbo.jpg', 'height': 500, 'width': 342, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/04/arts/04push-web/04push-web-superJumbo.jpg', 'height': 500, 'width': 342, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/04/arts/04push-web/04push-web-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/04/arts/04push-web/04push-web-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/04/arts/04push-web/04push-web-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In the Disability, Stress the Ability', 'kicker': 'Television Review', 'content_kicker': None, 'print_headline': 'Stressing Ability In the Disability', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Disabilities', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Reality Television', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Sundance Channel', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 5, 'major': 'N'}, {'name': 'creative_works', 'value': 'Push Girls (TV Program)', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-06-03T17:51:02+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Neil Genzlinger', 'person': [{'firstname': 'Neil', 'middlename': None, 'lastname': 'Genzlinger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/96e2970a-25e1-5c43-980c-baa33f912a04', 'word_count': 636, 'uri': 'nyt://article/96e2970a-25e1-5c43-980c-baa33f912a04'}, {'abstract': 'The movie led the way at North American theaters with about $56.3 million in ticket sales for Universal Pictures.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/06/03/a-fairy-tale-weekend-for-snow-white-and-the-huntsman/', 'snippet': 'The movie led the way at North American theaters with about $56.3 million in ticket sales for Universal Pictures.', 'lead_paragraph': 'Kristen Stewart, some gnarly dwarfs and a bloody fairy tale prevailed, as “Snow White and the Huntsman” led the weekend box-office results at North American theaters with about $56.3 million in ticket sales for Universal Pictures. It was an impressive feat, because the film opened without a 3-D version and the accompanying higher-priced tickets, though it took some technology to squeeze the likes of Bob Hoskins and Ray Winstone into their diminutive roles.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Fairy-Tale Weekend for ‘Snow White and the Huntsman’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Paramount Pictures', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-06-03T18:31:53+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Michael Cieply', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Cieply', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c47021bb-393f-5216-ad83-0d79d2b81d83', 'word_count': 339, 'uri': 'nyt://article/c47021bb-393f-5216-ad83-0d79d2b81d83'}, {'abstract': 'Health groups are pushing a ballot initiative to impose a $1-a-pack tax, provoking a storm of advertisements to defeat the biggest threat the industry has faced in the state in a decade.', 'web_url': 'https://www.nytimes.com/2012/06/04/us/in-california-a-battle-over-a-plan-for-1-a-pack-cigarette-tax.html', 'snippet': 'Health groups are pushing a ballot initiative to impose a $1-a-pack tax, provoking a storm of advertisements to defeat the biggest threat the industry has faced in the state in a decade.', 'lead_paragraph': 'LOS ANGELES — California has some of the toughest antismoking laws in the country — it is illegal, in some places, to smoke in your own apartment — and boasts the second-lowest per capita smoking rate in the 50 states. But for all the disdain toward smoking, it has been 14 years since California raised its cigarette tax, a tribute to the power of the tobacco industry here and the waning of this state’s antitobacco dominance.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A $1 Cigarette Tax Starts a $47 Million Brawl in California', 'kicker': None, 'content_kicker': None, 'print_headline': 'Vote on $1 Cigarette Tax Starts A $47 Million California Brawl', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Referendums', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Smoking and Tobacco', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Taxation', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Philip Morris Companies Inc', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Reynolds, R J, Tobacco Co', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'California', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-06-03T18:46:28+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Adam Nagourney', 'person': [{'firstname': 'Adam', 'middlename': None, 'lastname': 'Nagourney', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dadd880a-3773-5cbf-8e34-5b318326f66e', 'word_count': 1073, 'uri': 'nyt://article/dadd880a-3773-5cbf-8e34-5b318326f66e'}, {'abstract': 'John Velazquez made the journey from New York to Fair Hill in Elkton, Md., on Sunday morning to ride Union Rags for the first time. Union Rags was scheduled to put in his final work, ahead of Saturday’s Belmont Stakes.', 'web_url': 'https://therail.blogs.nytimes.com/2012/06/03/velazquez-teams-with-union-rags-for-impressive-work/', 'snippet': 'John Velazquez made the journey from New York to Fair Hill in Elkton, Md., on Sunday morning to ride Union Rags for the first time. Union Rags was scheduled to put in his final work, ahead of Saturday’s Belmont Stakes.', 'lead_paragraph': 'ELKTON, Md. — John Velazquez made the journey from New York to Fair Hill Training Center in Maryland on Sunday morning to ride Union Rags for the first time. Union Rags was scheduled to put in his final work, ahead of Saturday’s Belmont Stakes. Things could not have gone more perfectly.', 'source': 'The New York Times', 'multimedia': [], 'headline'