ank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ff7318b4-5452-5dfa-9dff-31d253bf17ea', 'word_count': 336, 'uri': 'nyt://article/ff7318b4-5452-5dfa-9dff-31d253bf17ea'}, {'abstract': 'Rafael Diaz faced charges after storming onto Citi Field to celebrate after the Mets pitcher Johan Santana threw the first no-hitter in the team’s 51-season history.', 'web_url': 'https://www.nytimes.com/2012/06/04/nyregion/rafael-diaz-die-hard-mets-fan-is-charged-after-celebrating-no-hitter-on-field.html', 'snippet': 'Rafael Diaz faced charges after storming onto Citi Field to celebrate after the Mets pitcher Johan Santana threw the first no-hitter in the team’s 51-season history.', 'lead_paragraph': 'When Hank Aaron broke Babe Ruth’s home run record in 1974, two fans took to the field to celebrate and run alongside the new record-holder. Two years later, Chris Chambliss had to fight off the hordes of fans that overran Yankee Stadium after he hit the game-winning home run, earning the Yankees the American League pennant. ', 'print_section': 'A', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'For Mets Fan, First a Field Trip, Then the Charges', 'kicker': None, 'content_kicker': None, 'print_headline': 'For Mets Fan, First a Field Trip, Then the Charges', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Queens (NYC)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Mets', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Records and Achievements', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Santana, Johan', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Citi Field (NYC)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Diaz, Rafael', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Baseball', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-06-04T01:37:44+0000', 'document_type': 'article', 'news_desk': 'Me