EN/YRHODEN-superJumbo.jpg', 'height': 1342, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/18/sports/YRHODEN/YRHODEN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/18/sports/YRHODEN/YRHODEN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/18/sports/YRHODEN/YRHODEN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Extending the Drama of Track and Field Year Round', 'kicker': 'Sports of The Times', 'content_kicker': None, 'print_headline': 'Extending the Drama of Track and Field Year Round', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Track and Field', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Siegel, Max', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Olympic Games', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-06-18T02:02:53+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Olympics', 'byline': {'original': 'By William C. Rhoden', 'person': [{'firstname': 'William', 'middlename': 'C.', 'lastname': 'Rhoden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4c57e409-047e-56ff-abed-10869f158111', 'word_count': 1273, 'uri': 'nyt://article/4c57e409-047e-56ff-abed-10869f158111'}, {'abstract': 'Decades of decisions that led to Greece’s troubles colored hopes for the future in Touthoa, a town where generations returned to vote.', 'web_url': 'https://www.nytimes.com/2012/06/18/world/europe/to-greek-village-family-no-getting-around-past.html', 'snippet': 'Decades of decisions that led to Greece’s troubles colored hopes for the future in Touthoa, a town where generations returned to vote.', 'lead_paragraph': 'TOUTHOA, Greece — Kostas Kouris stood in the scorching heat in this isolated village on a mountain astride the verdant Peloponnesian Peninsula, lines of worry etched across his brow. Like many people in this angst-ridden country on Sunday, he had waited until the last moment to cast his vote in Greece’s most pivotal election in recent memory.', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/18/world/VILLAGE-1/VILLAGE-1-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/06/18/world/VILLAGE-1/VILLAGE-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/18/world/VILLAGE-1/VILLAGE-1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/18/world/VILLAGE-1/VILLAGE-1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/18/world/VILLAGE-1/VILLAGE-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/18/world/VILLAGE-1/VILLAGE-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/18/world/VILLAGE-1/VILLAGE