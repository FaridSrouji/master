ok', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-06-15T20:00:04+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By KYLE SPENCER', 'person': [{'firstname': 'Kyle', 'middlename': None, 'lastname': 'SPENCER', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ab3d472d-24a9-5c22-9b39-606dc7665ade', 'word_count': 0, 'uri': 'nyt://article/ab3d472d-24a9-5c22-9b39-606dc7665ade'}, {'abstract': 'Kasia Bobula’s London Fashion Week photo diary.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2012/06/15/photos-of-the-moment-topman-designs/', 'snippet': 'Kasia Bobula’s London Fashion Week photo diary.', 'lead_paragraph': 'var data;function jsonSlideshowCallback(response){data = response;}NYTD.options = {source: data,cropType: \'blog480\',appendTo: \'fullScreenSlideShow\',showHeadLine: \'false\', renderstyle: "embeddedSlideShowTmag"}', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Photos of The Moment | Topman Designs', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-06-15T20:00:06+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Kasia Bobula', 'person': [{'firstname': 'Kasia', 'middlename': None, 'lastname': 'Bobula', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/29d75ff2-9d2a-5240-b896-0d7e16b6b949', 'word_count': 27, 'uri': 'nyt://article/29d75ff2-9d2a-5240-b896-0d7e16b6b949'}, {'abstract': 'Senator Mitch McConnell of Kentucky on Friday accused President Obama, his campaign and his administration of engaging in tactics similar to those of the Nixon White House.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2012/06/15/mcconnell-accuses-obama-and-aides-of-schemes-to-curtail-free-speech/', 'snippet': 'Senator Mitch McConnell of Kentucky on Friday accused President Obama, his campaign and his administration of engaging in tactics similar to those of the Nixon White House.', 'lead_paragraph': 'Senator Mitch McConnell of Kentucky on Friday accused President Obama, his campaign and his administration of engaging in Nixonian dirty tricks, including keeping an enemies list, inciting “mob” attacks on its critics and leaking confidential tax information, in a concerted effort to curtail the free speech of his opponents.', 'print_section': 'A', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'McConnell Accuses Obama and Aides of Schemes to Curtail Free Speech', 'kicker': None, 'content_kicker': None, 'print_headline': 'McConnell Accuses Obama Administration Of Schemes to Muzzle Opponents’ Speech', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Campaign Finance', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Freedom of Speech and Expression', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'McConnell, Mitch', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Citizens United', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-06-15T20:10:55+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Jonathan Weisman', 'person': [{'firstname': 'Jonathan', 'middlename': None, 'lastname': 'Weisman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dc4f4dcf-4adb-5af0-868f-e0115184a855', 'word_count': 836, 'uri': 'nyt://article/dc4f4dcf-4adb-5af0-868f-e0115184a855'}, {'abstract': 'Mitch McConnell announced this week that the G.O.P. will block the president’s nominations to circuit courts until the election.', 'web_url': 'https://takingnote.blogs.nytimes.com/2012/06/15/the-thurmond-rule/', 'snippet': 'Mitch McConnell announced this week that the G.O.P. will block the president’s nominations to circuit courts until the election.', 'lead_paragraph': 'Senate Minority Leader Mitch McConnell announced this week that he is imposing a blockade on President Obama’s nominations to the circuit courts. The G.O.P. will likely hold off on blocking district court judges until early September.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Thurmond Rule', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Appointments and Executive Changes', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'McConnell, Mitch', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'ALLIANCE FOR JUSTICE', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-06-15T20:13:20+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Andrew Rosenthal', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Rosenthal', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5d20a2b6-da39-55ba-9e11-3efc4db65e1e', 'word_count': 376, 'uri': 'nyt://article/5d20a2b6-da39-55ba-9e11-3efc4db65e1e'}, {'abstract': 'Two conceptual toy cars, intended to make children fall in love with driving and customization, would be for use on go-kart tracks.', 'web_url': 'https://wheels.blogs.nytimes.com/2012/06/15/in-tokyo-grown-up-utility-from-toyota-toys/', 'snippet': 'Two conceptual toy cars, intended to make children fall in love with driving and customization, would be for use on go-kart tracks.', 'lead_paragraph': 'Toyota is showing off two diminutive concept cars at the Tokyo Toy Fair, running through June 17. The vehicles together are called Camatte, an adaptation of a Japanese word intended to signify “caring for others,” Toyota said, and are aimed at “bringing delight to parents and children alike.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In Tokyo, Grown-Up Utility From Toyota Toys', 'kicker': 'Wheels', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Automobiles', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Toyota Motor Corporation', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Tokyo (Japan)', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-06-15T20:15:56+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Automobiles', 'byline': {'original': 'By Phil Patton', 'person': [{'firstname': 'Phil', 'middlename': None, 'lastname': 'Patton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a8df66de-5341-5db0-9fbe-6b0518e31c50', 'word_count': 248, 'uri': 'nyt://article/a8df66de-5341-5db0-9fbe-6b0518e31c50'}, {'abstract': 'Jonathan Darsky couldn’t find a suitable site to open a pizza restaurant, so he installed an oven in a truck and hit the road.', 'web_url': 'https://www.nytimes.com/slideshow/2012/06/17/automobiles/17pizza-slides.html', 'snippet': 'Jonathan Darsky couldn’t find a suitable site to open a pizza restaurant, so he installed an oven in a truck and hit the road.', 'lead_paragraph': 'Jonathan Darsky couldn’t find a suitable site to open a pizza restaurant, so he installed an oven in a truck and hit the road.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/17/automobiles/