2, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'MF Global', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-06-07T22:01:53+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Floyd Norris', 'person': [{'firstname': 'Floyd', 'middlename': None, 'lastname': 'Norris', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/444b95fd-b5f8-5843-b009-6577a061942b', 'word_count': 1430, 'uri': 'nyt://article/444b95fd-b5f8-5843-b009-6577a061942b'}, {'abstract': 'Fashion news we’re reading today, from a Louis Vuitton collaboration this summer to Alexander Skarsgard’s side gig.', 'web_url': 'https://runway.blogs.nytimes.com/2012/06/07/fashion-news-were-reading-now-6/', 'snippet': 'Fashion news we’re reading today, from a Louis Vuitton collaboration this summer to Alexander Skarsgard’s side gig.', 'lead_paragraph': 'Stop motion videos are always cool, especially when they’re about shopping. Refinery 29 offers 44 seconds of eye candy (above).', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Fashion News We’re Reading Now', 'kicker': 'On the Runway', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Lagerfeld, Karl', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Phillips, Richard', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Teller, Juergen', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Wang, Alexander', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Barneys New York', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Brooks Brothers', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Calvin Klein Inc', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Viktor & Rolf', 'rank': 9, 'major': 'N'}], 'pub_date': '2012-06-07T22:05:37+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/f89477ec-3a9e-579b-9ab3-ce3cf2881227', 'word_count': 194, 'uri': 'nyt://article/f89477ec-3a9e-579b-9ab3-ce3cf2881227'}, {'abstract': 'The Baltimore band Beach House says that Volkswagen, after the group refused to have their song in an ad, used a sound-alike.', 'web_url': 'https://www.nytimes.com/2012/06/09/arts/music/a-british-volkswagen-ad-sounds-like-beach-house.html', 'snippet': 'The Baltimore band Beach House says that Volkswagen, after the group refused to have their song in an ad, used a sound-alike.', 'lead_paragraph': 'Fans of the band Beach House became excited last month when a new advertisement for Volkswagen was broadcast in Britain. The spot tells the story of a father raising his daughter and featured what sounded like a new song by the Baltimore duo.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/07/arts/beach/beach-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/06/07/arts/beach/beach-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/07/arts/beach/beach-jumbo.jpg', 'height': 459, 'width': 713, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/07/arts/beach/beach-superJumbo.jpg', 'height': 459, 'width': 713, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/07/arts/beach/beach-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/07/arts/beach/beach-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/07/arts/beach/beach-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'To Singers, Ad Sounds Too Familiar', 'kicker': None, 'content_kicker': None, 'print_headline': 'To Singers, Ad Sounds Too Familiar', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Beach House', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Copyrights and Copyright Violations', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Volkswagen AG', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-06-07T22:07:25+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By James C. McKinley Jr', 'person': [{'firstname': 'James', 'middlename': 'C.', 'lastname': 'McKinley', 'qualifier': 'Jr', 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ea9f3b33-f090-5a31-891f-afb65c6c2f7a', 'word_count': 1205, 'uri': 'nyt://article/ea9f3b33-f090-5a31-891f-afb65c6c2f7a'}, {'abstract': 'Five celebrated artists — Ellen Altfest, Phyllida Barlow, Tacita Dean, Nathalie Djurberg and Klara Liden — have separate shows at the New Museum. Oh, you noticed that they’re all women?', 'web_url': 'https://www.nytimes.com/2012/06/08/arts/design/altfest-barlow-dean-djurberg-and-liden-at-new-museum.html', 'snippet': 'Five celebrated artists — Ellen Altfest, Phyllida Barlow, Tacita Dean, Nathalie Djurberg and Klara Liden — have separate shows at the New Museum. Oh, you noticed that they’re all women?', 'lead_paragraph': 'Would it seem odd not to mention that all five major exhibitions at the New Museum now are solos by female artists? The museum’s promotional material does not make a point of it, nor are the shows related by some umbrella theme, feminist or otherwise. Unless you are a gender-ratio scorekeeper, it would seem to be irrelevant that the artists in question — Ellen Altfest, Phyllida Barlow, Tacita Dean, Nathalie Djurberg and Klara Liden — are women. They are all variously celebrated artists first. And yet, in ways that are not necessarily obvious, and if only because of the all-female lineup, questions of gender come to the fore. ', 'print_section': 'C', 'print_page': '30', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/08/arts/NEWMUSEUM1/NEWMUSEUM1-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/06/08/arts/NEWMUSEUM1/NEWMUSEUM1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/08/arts/NEWMUSEUM1/NEWMUSEUM1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/08/arts/NEWMUSEUM1/NEWMUSEUM1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'cap