article/9225e622-0535-5445-9afe-94f6cc72f4ff', 'word_count': 1571, 'uri': 'nyt://article/9225e622-0535-5445-9afe-94f6cc72f4ff'}, {'abstract': 'Missy Franklin, 17, leads all qualifiers in the 100 meter backstroke.', 'web_url': 'https://london2012.blogs.nytimes.com/2012/06/26/franklin-breaks-one-minute-barrier/', 'snippet': 'Missy Franklin, 17, leads all qualifiers in the 100 meter backstroke.', 'lead_paragraph': 'OMAHA – At 17, Missy Franklin is one of the younger participants in the United States Olympic trials, but she can be forgiven for feeling as if the wait to swim her first race here took forever. For the past several months Franklin has been portrayed as the fresh face of the 2012 U.S. Olympic team despite not having yet made the squad.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Franklin Breaks One-Minute Barrier', 'kicker': '2012 London Olympics', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Olympic Games', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Swimming', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Coughlin, Natalie', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Franklin, Missy', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Omaha (Neb)', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-06-26T19:03:49+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Olympics', 'byline': {'original': 'By Karen Crouse', 'person': [{'firstname': 'Karen', 'middlename': None, 'lastname': 'Crouse', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2738ef96-27c0-5312-b58a-e6762747cfbf', 'word_count': 274, 'uri': 'nyt://article/2738ef96-27c0-5312-b58a-e6762747cfbf'}, {'abstract': 'The International Tennis Federation named its selections for wild cards for the Olympics in London.', 'web_url': 'https://london2012.blogs.nytimes.com/2012/06/26/wild-card-tennis-entries-are-announced/', 'snippet': 'The International Tennis Federation named its selections for wild cards for the Olympics in London.', 'lead_paragraph': 'The International Tennis Federation announced the acceptance list for the 2012 Olympic Games on Tuesday afternoon, finally ending months of speculation and calculations.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Wild Card Tennis Entries Are Announced', 'kicker': '2012 London Olympics', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Olympic Games', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Tennis', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Bondarenko, Kateryna', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Gulbis, Ernests', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Tatishvili, Anna', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'International Tennis Federation', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-06-26T19:16:41+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Olympics', 'byline': {'original': 'By Ben Rothenberg', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Rothenberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d8f090db-c7d4-5f83-9550-36b01bab9aa5', 'word_count': 573, 'uri': 'nyt://article/d8f090db-c7d4-5f83-9550-36b01bab9aa5'}, {'abstract': 'An appeals court upheld the environmental agency’s finding that heat-trapping gases endanger public health.', 'web_url': 'https://www.nytimes.com/2012/06/27/science/earth/epa-emissions-rules-backed-by-court.html', 'snippet': 'An appeals court upheld the environmental agency’s finding that heat-trapping gases endanger public health.', 'lead_paragraph': 'WASHINGTON — A federal appeals court on Tuesday upheld a finding by the Environmental Protection Agency that heat-trapping gases from industry and vehicles endanger public health, dealing a decisive blow to companies and states that had sued to block agency rules. ', 'print_section': 'A', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Court Backs E.P.A. Over Emissions Limits Intended to Reduce Global Warming', 'kicker': None, 'content_kicker': None, 'print_headline': 'Court Backs E.P.A. Over Emissions Limits Intended to Reduce Global Warming', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Environmental Protection Agency', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Clean Air Act', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Appeals Courts (US)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Greenhouse Gas Emissions', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-06-26T19:20:07+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'Science', 'subsection_name': 'Environment', 'byline': {'original': 'By Matthew L. Wald', 'person': [{'firstname': 'Matthew', 'middlename': 'L.', 'lastname': 'Wald', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5694221f-ef11-5ce0-a594-d860f06542fe', 'word_count': 771, 'uri': 'nyt://article/5694221f-ef11-5ce0-a594-d860f06542fe'}, {'abstract': 'Midsize sedans are a good choice for teenage drivers, says Edmunds.com.', 'web_url': 'https://bucks.blogs.nytimes.com/2012/06/26/the-best-cars-for-a-teenage-driver/', 'snippet': 'Midsize sedans are a good choice for teenage drivers, says Edmunds.com.', 'lead_paragraph': 'Just what every newly licensed, teenage driver wants: a safe, reliable midsize sedan.', 'source': 'The New York Times', 'multimedia':