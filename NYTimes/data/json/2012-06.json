 84', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Khan, Imran', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Singh, Manmohan', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Twitter', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'India', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Pakistan', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-06-13T11:24:18+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Pamposh Raina', 'person': [{'firstname': 'Pamposh', 'middlename': None, 'lastname': 'Raina', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4f6e4da4-74b7-50fa-9e72-d970d7d26f1b', 'word_count': 174, 'uri': 'nyt://article/4f6e4da4-74b7-50fa-9e72-d970d7d26f1b'}, {'abstract': 'Gov. Andrew M. Cuomo is preparing a proposal that would allow hydraulic fracturing for gas only in areas where deposits are at least 2,000 feet deep.', 'web_url': 'https://www.nytimes.com/interactive/2012/06/13/nyregion/a-plan-to-regulate-fracking.html', 'snippet': 'Gov. Andrew M. Cuomo is preparing a proposal that would allow hydraulic fracturing for gas only in areas where deposits are at least 2,000 feet deep.', 'lead_paragraph': 'Gov. Andrew M. Cuomo is preparing a proposal that would allow hydraulic fracturing for gas only in areas where deposits are at least 2,000 feet deep.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Plan to Regulate Gas Drilling', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Hydraulic Fracturing', 'rank': 1, 'major': 'N'}, {'n