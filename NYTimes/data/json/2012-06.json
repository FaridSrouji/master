. ', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/04/arts/LYRICS/LYRICS-jumbo.jpg', 'height': 635, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/04/arts/LYRICS/LYRICS-superJumbo.jpg', 'height': 1269, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/04/arts/LYRICS/LYRICS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/04/arts/LYRICS/LYRICS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/04/arts/LYRICS/LYRICS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Tunes From ‘Screwy Bally-Hooey’ Warner Brothers', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Tunes From ‘Screwy Bally-Hooey’ Warner Brothers', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Warner Brothers', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Ninety-Second Street Y', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-06-03T19:49:02+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Stephen Holden', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Holden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/384ef4f5-1ac3-53d9-8c33-bc8216ea081e', 'word_count': 516, 'uri': 'nyt://article/384ef4f5-1ac3-53d9-8c33-bc8216ea081e'}, {'abstract': 'In Rebecca Patek’s “Real Eyes” she merged stand-up comedy and contemporary dance at the Chocolate Factory in Long Island City, Queens.', 'web_url': 'https://www.nytimes.com/2012/06/04/arts/dance/rebecca-pateks-real-eyes-at-chocolate-factory.html', 'snippet': 'In Rebecca Patek’s “Real Eyes” she merged stand-up comedy and contemporary dance at the Chocolate Factory in Long Island City, Queens.', 'lead_paragraph': 'When you’re sitting before Rebecca Patek, you must be patient. “Um,” she said at the start of her performance, “Real Eyes,” at the Chocolate Factory on Thursday night. “Hi. Um. I’m Rebecca. Um.” ', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/04/arts/patek/patek-jumbo.jpg', 'height': 698, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/04/arts/patek/patek-superJumbo.jpg', 'height': 1396, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/04/arts/patek/patek-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/04/arts/patek/patek-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/04/arts/patek/patek-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLa