': 'nyt://article/044bbc86-6b4f-5cce-a591-b246b9ec4045'}, {'abstract': 'The Authors Guild is encouraging its 8,500 members to submit comments against the proposed settlement between the Department of Justice and three large publishers. The settlement, the guild argues, will only benefit Amazon.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2012/06/04/attacking-amazon-authors-group-urges-opposition-to-e-book-settlement/', 'snippet': 'The Authors Guild is encouraging its 8,500 members to submit comments against the proposed settlement between the Department of Justice and three large publishers. The settlement, the guild argues, will only benefit Amazon.', 'lead_paragraph': 'The Authors Guild on Monday\xa0urged its 8,500 members to protest the Department of Justice’s proposed settlement with three publishers, a proposal that clears the way for Amazon to lower prices on e-books.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Attacking Amazon, Authors Group Urges Opposition to E-Book Settlement', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'E-Books and Readers', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Aiken, Paul', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'AMAZON.COM INC', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Authors Guild', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Justice Department', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-06-04T21:01:41+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Julie Bosman', 'person': [{'firstname': 'Julie', 'middlename': None, 'lastname': 'Bosman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization