ubject', 'value': 'Fashion and Apparel', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Shopping and Retail', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'T-Shirts (Apparel)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Morin, Dave', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Path.com', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'SoHo (NYC)', 'rank': 8, 'major': 'N'}], 'pub_date': '2012-06-27T19:00:03+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Lydia Dishman', 'person': [{'firstname': 'Lydia', 'middlename': None, 'lastname': 'Dishman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/03c6fb85-673c-58d9-8e0a-6ccaa24b6df5', 'word_count': 692, 'uri': 'nyt://article/03c6fb85-673c-58d9-8e0a-6ccaa24b6df5'}, {'abstract': 'All seats at Studio and Stage II will cost $30.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/06/27/manhattan-theater-club-unveils-new-play-initiative/', 'snippet': 'All seats at Studio and Stage II will cost $30.', 'lead_paragraph': 'The Manhattan Theater Club on Wednesday announced a new initiative at City Center to support the creation of new plays. The Studio at Stage II, as the initiative is called, will host two new productions in its first season beginning this fall, with all seats $30. The theater also announced a new partnership between and Ars Nova, called The Writer’s Room, that will commission work to be shown at the studio.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Manhattan Theater Club Unveils New Play Initiative', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'ARS NOVA', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Manhattan Theater Club', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-06-27T19:00:04+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Felicia R. Lee', 'person': [{'firstname': 'Felicia', 'middlename': 'R.', 'lastname': 'Lee', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b51a4b27-a563-5d3b-aea2-7a803c5471ab', 'word_count': 409, 'uri': 'nyt://article/b51a4b27-a563-5d3b-aea2-7a803c5471ab'}, {'abstract': 'Spain and Cyprus may be the current locus of European anxiety, but many other banks are in a weakened state, cut off from money markets because investors do not trust them.', 'web_url': 'https://www.nytimes.com/2012/06/28/business/global/euro-zone-riddled-with-shaky-banks.html', 'snippet': 'Spain and Cyprus may be the current locus of European anxiety, but many other banks are in a weakened state, cut off from money markets because investors do not trust them.', 'lead_paragraph': 'FRANKFURT — Five years after the financial crisis began, many banks throughout the euro zone are still in a weakened state, cut off from money markets because investors do not trust them, and effectively on life support from the European Central Bank.', 'print_section': 'B', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/28/business/BANKS/BANKS-jumbo.jpg', 'height': 628, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/28/business/BANKS/BANKS-superJumbo.jpg', 'height': 1256, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Europe’s Mightiest Banks Still Grapple With Crisis', 'kicker': None, 'content_kicker': None, 'print_headline': 'Beyond S