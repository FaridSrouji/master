edia': [], 'headline': {'main': 'City and Union Collaborate on New Community Hubs', 'kicker': 'SchoolBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-06-27T22:00:04+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By BETH FERTIG', 'person': [{'firstname': 'Beth', 'middlename': None, 'lastname': 'FERTIG', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/831c7a1d-92d0-5293-9b6e-2298505d4366', 'word_count': 0, 'uri': 'nyt://article/831c7a1d-92d0-5293-9b6e-2298505d4366'}, {'abstract': 'Janet Groth has gone from answering phones at The New Yorker to writing a book about her experiences there.', 'web_url': 'https://www.nytimes.com/2012/06/28/fashion/janet-groth-describes-her-life-at-the-new-yorker.html', 'snippet': 'Janet Groth has gone from answering phones at The New Yorker to writing a book about her experiences there.', 'lead_paragraph': 'ONE night a few weeks ago, a large crowd packed into the National Arts Club in Manhattan to witness a literary debut 55 years in the making. The author, a witty, 75-year-old college professor named Janet Groth, told stories of working at The New Yorker during the magazine’s heyday in the 1950s and ’60s: her weekly lunches with the revered reporter Joseph Mitchell; her affair with a cartoonist she nicknamed “the great deceiver”; her fleeting interactions with the longtime editor William Shawn, who, despite his shyness, was “gallant enough to present me with a rose when I left the magazine.”', 'print_section': 'E', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/28/fashion/28GROTH_SPAN/28GROTH_SPAN-articleLarge.jpg', 'height': 380, 'width': 600, 'subType': 'xlarge', 'crop_