'multimedia': [], 'headline': {'main': 'You Can’t Win if You Don’t Pay', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'You Can&#8217;t Win if You Don&#8217;t Pay', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Campaign Finance', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-06-28T01:45:40+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/92c01b9a-4daa-5317-8581-78e85f4b74ac', 'word_count': 539, 'uri': 'nyt://article/92c01b9a-4daa-5317-8581-78e85f4b74ac'}, {'abstract': 'The Obama administration’s strategy of controlling greenhouse gases through regulation received a decisive victory, and polluters got a devastating blow.', 'web_url': 'https://www.nytimes.com/2012/06/28/opinion/a-court-rules-for-the-planet.html', 'snippet': 'The Obama administration’s strategy of controlling greenhouse gases through regulation received a decisive victory, and polluters got a devastating blow.', 'lead_paragraph': 'A federal court decision on Tuesday upholding the Environmental Protection Agency’s landmark rulings to control greenhouse gases was a decisive victory for the Obama administration and a devastating blow to polluters. It vindicated the administration’s strategy of controlling emissions through regulation and showed good sense at a time when both the agency and the science of global warming are under relentless Congressional attack. ', 'print_section': 'A', 'print_page': '26', '