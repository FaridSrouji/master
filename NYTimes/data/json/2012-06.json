e': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Romney and Energy', 'kicker': 'Letter', 'content_kicker': None, 'print_headline': 'Romney and Energy', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Romney, Mitt', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Global Warming', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-06-25T23:31:50+0000', 'document_type': 'article', 'news_desk': 'Letters', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/a1e34f2a-21bf-582a-a530-bd90ffd20a60', 'word_count': 180, 'uri': 'nyt://article/a1e34f2a-21bf-582a-a530-bd90ffd20a60'}, {'abstract': 'Human beings are lousy forecasters — and not just when it comes to politics. But some are considerably better than others.', 'web_url': 'https://fivethirtyeight.blogs.nytimes.com/2012/06/25/the-problems-with-forecasting-and-how-to-improve/', 'snippet': 'Human beings are lousy forecasters — and not just when it comes to politics. But some are considerably better than others.', 'lead_paragraph': 'Are political scientists any good at making predictions? Jacqueline Stevens, a professor of political science at Northwestern University, argued in an Op-Ed last Sunday that political scientists make for lousy forecasters. Ms. Stevens suggested that National Science Foundation grants to political scientists should be awarded by lottery instead of toward “research aimed at political prediction,” which she said is “doomed to fail.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Problems With Forecasting and How to Get Better at It', 'kicker': 'FiveThirtyEight', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-06-25T23:42:31+0000', 'document_type': 'article', 'news_des