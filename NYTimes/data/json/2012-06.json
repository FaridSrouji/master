 far for staples or rely on shops like drugstores.', 'lead_paragraph': 'The retail success story in Manhattan is well known: a steadily growing influx of tourists has pushed per capita retail sales in the borough far higher than in the rest of the country.', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/28/nyregion/RETAIL/RETAIL-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/06/28/nyregion/RETAIL/RETAIL-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/28/nyregion/RETAIL/RETAIL-jumbo.jpg', 'height': 699, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/28/nyregion/RETAIL/RETAIL-superJumbo.jpg', 'height': 1398, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'As Retail Hub, Manhattan Tops National Average and Outstrips Other Boroughs', 'kicker': None, 'content_kicker': None, 'print_headline': 'In Retail, Manhattan Outstrips Rest of City', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Queens (NYC)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Drugstores', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Brooklyn (NYC)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Shopping and Retail', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Supermarkets and Grocery Stores', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Staten Island (NYC)', 'rank': 7, 'major': 'N'}, {'name': 'glo