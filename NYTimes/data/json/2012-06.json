jor': 'N'}], 'pub_date': '2012-06-20T18:24:28+0000', 'document_type': 'multimedia', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/4c03cfc7-a80e-52f2-92b4-98a238590a25', 'word_count': 0, 'uri': 'nyt://slideshow/4c03cfc7-a80e-52f2-92b4-98a238590a25'}, {'abstract': 'Just recently, Justin Vivian Bond starred in “Jukebox Jackie,” sang at an AIDS charity ball and is performing to promote a second album.', 'web_url': 'https://www.nytimes.com/2012/06/21/fashion/justin-vivian-bond-turns-androgyny-into-high-art.html', 'snippet': 'Just recently, Justin Vivian Bond starred in “Jukebox Jackie,” sang at an AIDS charity ball and is performing to promote a second album.', 'lead_paragraph': '“I WAS having lunch with Rufus Wainwright,” said Justin Vivian Bond, arriving home a few minutes behind schedule. “I’m going to be officiating at his wedding. I was just confirmed. I’m now officially a reverend!”', 'print_section': 'E', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/21/fashion/21UPCLOSE_SPAN/21UPCLOSE_SPAN-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/06/21/fashion/21UPCLOSE_SPAN/21UPCLOSE_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/21/fashion/21UPCLOSE_SPAN/21zUPCLOSE-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/21/fashion/21UPCLOSE_SPAN/21zUPCLOSE-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {