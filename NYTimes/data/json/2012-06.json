fessors, a star miler on the high school track team.', 'print_section': 'A', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/30/us/RELIGION/RELIGION-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/06/30/us/RELIGION/RELIGION-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/30/us/RELIGION/RELIGION-jumbo.jpg', 'height': 703, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/30/us/RELIGION/RELIGION-superJumbo.jpg', 'height': 1405, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/30/us/RELIGION/RELIGION-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/30/us/RELIGION/RELIGION-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/30/us/RELIGION/RELIGION-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Rape Survivor Now Ministers Body and Soul', 'kicker': 'On Religion', 'content_kicker': None, 'print_headline': 'A Rape Survivor Now Ministers Body and Soul', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Religion and Belief', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Ministers (Protestant)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 