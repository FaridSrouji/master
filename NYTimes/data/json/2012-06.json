ub': None}, 'keywords': [{'name': 'glocations', 'value': 'Mount McKinley (Alaska)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'National Parks, Monuments and Seashores', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Avalanches', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Mountain Climbing', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Fatalities)', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-06-16T23:06:51+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Matt Flegenheimer', 'person': [{'firstname': 'Matt', 'middlename': None, 'lastname': 'Flegenheimer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9c719dba-c744-5792-8073-26525ec333da', 'word_count': 399, 'uri': 'nyt://article/9c719dba-c744-5792-8073-26525ec333da'}, {'abstract': 'Mitt Romney and representatives from President Obama’s re-election campaign light up the Sunday shows for a debate on who wins the week in politics.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2012/06/16/sunday-breakfast-menu-june-17-2/', 'snippet': 'Mitt Romney and representatives from President Obama’s re-election campaign light up the Sunday shows for a debate on who wins the week in politics.', 'lead_paragraph': 'As the presidential race heats up, Mitt Romney will appear on his first Sunday show — other than Fox News — to discuss the things both he and President Obama said last week on the campaign trail. David Plouffe, Mr. Obama’s senior adviser, will make the network rounds as well, defending the president’s words on the economy and promoting his new policy shift to cease deportations for some young illegal immigrants.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Sunday Breakfast Menu, June 17', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-06-16T23:13:35+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Jada F. Smith', 'person': [{'firstname': 'Jada', 'middlename': 'F.', 'lastname': 'Smith', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dd96a93b-4ac9-5793-83d8-7d12f4f4ba60', 'word_count': 362, 'uri': 'nyt://article/dd96a93b-4ac9-5793-83d8-7d12f4f4ba60'}, {'abstract': 'Phil Mickelson, on his 42nd birthday and a day before Father’s Day, shot his second straight 71 at the Olympic Club for a three-day total of eight-over 218.', 'web_url': 'https://onpar.blogs.nytimes.com/2012/06/16/mickelson-with-plenty-to-celebrate-is-hoping-for-one-more-reason/', 'snippet': 'Phil Mickelson, on his 42nd birthday and a day before Father’s Day, shot his second straight 71 at the Olympic Club for a three-day total of eight-over 218.', 'lead_paragraph': 'SAN FRANCISCO — The United States Open falls on Father’s Day weekend, a quirk in the calendar that’s seen as serendipitous since fathers and sons often treat golf as a bonding exercise. A dozen times in Phil Mickelson’s playing career the tournament has fallen on his birthday, a scheduling oddity that is beginning to feel more like a barb than a bonus for Mickelson, whose struggles continued on Saturday at the event he most wants to win.', 'print_section': 'SP', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Mickelson, With Plenty to Celebrate, Is Hoping for One More Reason', 'kicker': 'On Par', 'content_kicker': None, 'print_headline': 'Mickelson Is Not Getting What He Really Wants for His Birthday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Golf', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Open (Golf)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Mickelson, Phil', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-06-16T23:42:18+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Golf', 'byline': {'original': 'By Karen Crouse', 'person': [{'firstname': 'Karen', 'middlename': None, 'lastname': 'Crouse', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fbc32f0f-7b28-5e7f-8727-5a82c6c607ed', 'word_count': 354, 'uri': 'nyt://article/fbc32f0f-7b28-5e7f-8727-5a82c6c607ed'}, {'abstract': 'The 2011 Masters champion has been playing this weekend’s United States Open with an abdominal tear.', 'web_url': 'https://onpar.blogs.nytimes.com/2012/06/16/schwartzel-pushes-through-pain/', 'snippet': 'The 2011 Masters champion has been playing this weekend’s United States Open with an abdominal tear.', 'lead_paragraph': 'The South African Charl Schwartzel grimaced after almost every swing on the practice range on Saturday at the United States Open. A few times, he clutched his stomach. Somehow, he kept going. Schwartzel, the 2011 Masters champion, was three over par in the first 36 holes of the United State Open despite playing with an abdominal tear.', 'print_section': 'SP', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Schwartzel Pushes Through Pain', 'kicker': 'On Par', 'content_kicker': None, 'print_headline': 'Pushing Through Pain', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Golf', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Open (Golf)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Schwartzel, Charl', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-06-16T23:50:08+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Golf', 'byline': {'original': 'By Karen Crouse', 