umbo.jpg', 'height': 667, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/25/arts/TITUS2/TITUS2-superJumbo.jpg', 'height': 1335, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/25/arts/TITUS2/TITUS2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/25/arts/TITUS2/TITUS2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/25/arts/TITUS2/TITUS2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Technology Identifies Lost Color at Roman Forum', 'kicker': None, 'content_kicker': None, 'print_headline': 'Technology Identifies Lost Color at Roman Forum', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Jews and Judaism', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ARCHAEOLOGY', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Roman Civilization', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Rome (Italy)', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-06-24T21:37:10+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Elisabetta Povoledo', 'person': [{'firstname': 'Elisabetta', 'middlename': None, 'lastname': 'Povoledo', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/464a5fa4-0046-5f45-89f0-36625fced41b', 'word_count': 691, 'uri': 'nyt://article/464a5fa4-0046-5f45-89f0-36625fced41b'}, {'abstract': 'Dave Koz, the saxophonist, was joined by the R&B and gospel singer BeBe Winans at the Bergen Performing Arts Center Saturday in June 24.', 'web_url': 'https://www.nytimes.com/2012/06/25/arts/music/dave-koz-and-bebe-winans-at-bergen-performing-arts-center.html', 'snippet': 'Dave Koz, the saxophonist, was joined by the R&B and gospel singer BeBe Winans at the Bergen Performing Arts Center Saturday in June 24.', 'lead_paragraph': 'ENGLEWOOD, N.J. — At the precise midpoint of his concert at the Bergen Performing Arts Center here on Saturday night the saxophonist Dave Koz paused for an important announcement. It pertained to Dave Koz & Friends at Sea, the luxury cruise he has headlined every year for the last seven, and he framed it as an enticing question: Who wanted to win a cabin for the 2013 edition, which would tool around the Mediterranean next fall? ', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/25/arts/KOZ/KOZ-jumbo.jpg', 'height': 663, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/25/arts/KOZ/KOZ-superJumbo.jpg', 'height': 1327, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'A Smooth-Jazz Standard-Bearer Offers Soft Exclamations', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'A Smooth-Jazz Standard-Bearer Offers Soft Exclamations', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Winans, BeBe', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Gospel Music', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 3, 'major': '