e': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Lindgren, Hugo', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-06-04T18:58:57+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Magazine', 'byline': {'original': 'By Samantha Henig', 'person': [{'firstname': 'Samantha', 'middlename': None, 'lastname': 'Henig', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e15c2c96-b537-5548-b997-485a00dbf081', 'word_count': 193, 'uri': 'nyt://article/e15c2c96-b537-5548-b997-485a00dbf081'}, {'abstract': 'Older and lower-income Americans who buy their own health insurance would save under health reform, a study finds.', 'web_url': 'https://bucks.blogs.nytimes.com/2012/06/04/people-buying-individual-health-plans-would-save-under-reform-study-finds/', 'snippet': 'Older and lower-income Americans who buy their own health insurance would save under health reform, a study finds.', 'lead_paragraph': '6:18 p.m. Updated / To make clear that the anticipated savings are for out-of-pocket medical costs.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'People With Individual Health Plans Would Save Out-of-Pocket Under Reform, Study Finds', 'kicker': 'Bucks', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Health Insurance and Managed Care', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Patient Protection and Affordable Care Act (2010)', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-06-04T19:00:59+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Your Money', 'byline': {'original': 'By Ann Carrns', 'person': [{'firstname': 'Ann', 'middlename': None, 'lastname': 'Carrns', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3541dd5f-384c-5e14-af2e-de9a41c2d61c', 'word_count': 421, 'uri': 'nyt://article/3541dd5f-384c-5e14-af2e-de9a41c2d61c'}, {'abstract': 'England and Germany have taken different, divergent paths to this year’s European Championship.', 'web_url': 'https://goal.blogs.nytimes.com/2012/06/04/euro-2012-germany-has-changed-england-take-note/', 'snippet': 'England and Germany have taken different, divergent paths to this year’s European Championship.', 'lead_paragraph': 'On June 9, Germany will begin play in this year’s European Championships with an opening match against Portugal. The competition will be the 14th continental championship and the 11th consecutive time Germany has qualified. Yet most German fans will approach the tournament with one foot firmly in the past as they bitterly remember a similar situation 12 years ago, and how far the team has come. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Euro 2012: Germany Has Changed. England Take Note.', 'kicker': 'Goal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Soccer', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'UEFA European Football Championship', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Hodgson, Roy', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Klose, Miroslav', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Podolski, Lukas', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Terry, John', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'English Premier League', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'German Bundesliga', 'rank': 8, 'major': 'N'}], 'pub_date': '2012-06-04T19:08:44+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Soccer', 'byline': {'original': 'By Stefan Bienkowski', 'person': [{'firstname': 'Stefan', 'middlename': None, 'lastname': 'Bienkowski', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9379ca30-d50e-5f7f-a72a-f4dd2874c5ed', 'word_count': 1149, 'uri': 'nyt://article/9379ca30-d50e-5f7f-a72a-f4dd2874c5ed'}, {'abstract': 'Burberry’s prespring collection features some stand-out paper-bag pants, bomber jackets and trench coats.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2012/06/04/just-one-look-burberry-3/', 'snippet': 'Burberry’s prespring collection features some stand-out paper-bag pants, bomber jackets and trench coats.', 'lead_paragraph': 'The standouts at today’s Burberry prespring collection presentation were the paper-bag pants for her (high and cinched at the waist with a rolled leg) and the outerwear for him (bombers and trenches in luscious, new fabrications with handsome proportions and fit). What the men and woman shared were prints, tiny foulards on everything from shirts to shorts and silk scarves, that gave each look a bit of a pajama feel. And the seersucker; quite relaxed for the tightly tailored Britons at Burberry. Here, the star pant as part of a striped cotton seersucker suit relaxes with a graphic tee and a wedge heel. On him, a printed tie and the season’s signature neck scarf is styled with a waterproofed-silk trench coat.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Just One Look | Burberry Prorsum', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-06-04T19:09:27+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Jane Herman', 'person': [{'firstname': 'Jane', 'middlename': None, 'lastname': 'Herman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2dc670ba-dbd6-54ca-ac9d-5fefb1790c55', 'word_count': 124, 'uri': 'nyt://article/2dc670ba-dbd6-54ca-ac9d-5fefb1790c55'}, {'abstract': 'Experts worry that Thailand, the world’s leading rice exporter, may have trouble finding people to work in rice paddies, as young people stay longer in school and prefer to work in Bangkok.', 'web_url': 'https://www.nytimes.com/2012/06/05/world/asia/thai-youth-seek-a-fortune-off-the-farm.html', 'snippet': 'Experts worry that Thailand, the world’s leading rice exporter, may have trouble finding people to work in rice paddies, as young people stay longer in school and prefer to work in Bangkok.', 'lead_paragraph': 'BAAN KHLONG KHOO, Thailand — During 18 years living across the road from rice paddies, Malinee Khammon has never planted a single seedling. The daughter of farmers who is in her last year of high school, she has become adept at deflecting increasingly desperate pleas from her parents for help on the farm.', 'print_section': 'A', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/05/world/JP-RICE/JP-RICE-articleLarge.jpg', 'height': 370, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/06/05/world/JP-RICE/JP-RICE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 370}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/05/world/JP-RICE/JP-RICE-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/05/world/JP-RICE/JP-RICE-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/05/wor