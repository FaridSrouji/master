e': 'persons', 'value': 'Kerber, Angelique', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'McHale, Christina', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-06-29T19:33:06+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By John Martin', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Martin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/674ef41b-7011-5d95-ace5-5d233229abb8', 'word_count': 178, 'uri': 'nyt://article/674ef41b-7011-5d95-ace5-5d233229abb8'}, {'abstract': 'A three-bedroom apartment on the 70th floor with panoramic views and a baronial entrance gallery was the most expensive sale to close this week.', 'web_url': 'https://cityroom.blogs.nytimes.com/2012/06/29/big-ticket-sold-for-17-million/', 'snippet': 'A three-bedroom apartment on the 70th floor with panoramic views and a baronial entrance gallery was the most expensive sale to close this week.', 'lead_paragraph': 'A three-bedroom condominium that sold for $17 million, boasting stratospheric views from the 70th floor of the Residences at Mandarin Oriental at the Time Warner Center, was the biggest sale of the week, according to city records. The unit, No. 70B, has views of Central Park, the Hudson River and virtually the entire Manhattan skyline.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Big Ticket | Sold for $17 Million', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Manhattan (NYC)', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-06-29T19:36:55+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Robin Finn', 'person': [{'firstname': 'Robin', 'middlename': None, 'lastname': 'Finn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c258ca00-176c-5ba3-9127-4ab3c64aa534', 'word_count': 276, 'uri': 'nyt://article/c258ca00-176c-5ba3-9127-4ab3c64aa534'}, {'abstract': 'Watching the Italy-Germany Euro 2012 game in a friendly precinct in Queens.', 'web_url': 'https://goal.blogs.nytimes.com/2012/06/29/the-way-mama-would-have-wanted-it/', 'snippet': 'Watching the Italy-Germany Euro 2012 game in a friendly precinct in Queens.', 'lead_paragraph': 'George Vecsey was not at the Italy-Germany game, a Euro 2012 semifinal match, on Thursday. But he watched it somewhere almost as good: “It was compelling viewing at the center-of-the-Italian universe, Mama’s of Corona, Queens, surrounded by antipasto and cannolis and friends.” Read his full report here.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Way Mama Would Have Wanted It', 'kicker': 'Goal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Soccer', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Corona (NYC)', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-06-29T19:39:57+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Soccer', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/57654a8e-2cd7-5e2d-b66c-fa09c601a018', 'word_count': 47, 'uri': 'nyt://article/57654a8e-2cd7-5e2d-b66c-fa09c601a018'}, {'abstract': 'Two cultural institutions — one French, one American — have begun a program to explore how the two countries portray each other on film and television.', 'web_url': 'https://www.nytimes.com/2012/07/01/movies/france-and-the-library-of-congress-start-a-media-project.html', 'snippet': 'Two cultural institutions — one French, one American — have begun a program to explore how the two countries portray each other on film and television.', 'lead_paragraph': 'THE history of French-American relations is a tale of an old alliance that bends with shifting cultural and political winds but never breaks, and whose mutual fascination, shared interests and ideological divides have created a host of competing narratives about how one side views the other.', 'print_section': 'AR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/07/01/arts/01FRANCE1_SPAN/01FRANCE1_SPAN-articleLarge.jpg', 'height': 300, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/07/01/arts/01FRANCE1_SPAN/01FRANCE1_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 300}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/07/01/arts/01FRANCE1_SPAN/01FRANCE1-jumbo.jpg', 'height': 656, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/07/01/arts/01FRANCE1_SPAN/01FRANCE1-superJumbo.jpg', 'height': 1312, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/07/01/arts/01FRANCE1_SPAN/01FRANCE1_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/07/01/arts/01FRANCE1_SPAN/01FRANCE1_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/07/01/arts/01FRANCE1_SPAN/01