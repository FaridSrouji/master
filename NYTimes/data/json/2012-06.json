S', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Bombs and Explosives', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Taliban', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'AFGHANISTAN', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Afghanistan War (2001- )', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-06-11T18:17:18+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Sangar Rahimi and Alissa J. Rubin', 'person': [{'firstname': 'Sangar', 'middlename': None, 'lastname': 'Rahimi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Alissa', 'middlename': 'J.', 'lastname': 'Rubin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9c0c9b13-32af-53c7-8025-17ca5ab637da', 'word_count': 420, 'uri': 'nyt://article/9c0c9b13-32af-53c7-8025-17ca5ab637da'}, {'abstract': 'Teresa Sullivan, the outgoing president of the University of Virginia, attributed her departure to a “philosophical difference of opinion” with board members.', 'web_url': 'https://thechoice.blogs.nytimes.com/2012/06/11/virginia-president-to-leave-after-two-years/', 'snippet': 'Teresa Sullivan, the outgoing president of the University of Virginia, attributed her departure to a “philosophical difference of opinion” with board members.', 'lead_paragraph': 'Students entering the University of Virginia this fall won’t be the only new faces on campus; the university plans to have a new president, too.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Virginia President to Leave After Two Years', 'kicker': 'The Choice', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Appointments and Executive Changes', 'rank': 1,