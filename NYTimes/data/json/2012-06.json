.', 'print_section': 'B', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/22/sports/y-wilhelm-1/y-wilhelm-1-jumbo.jpg', 'height': 837, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/22/sports/y-wilhelm-1/y-wilhelm-1-superJumbo.jpg', 'height': 1673, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/22/sports/y-wilhelm-1/y-wilhelm-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/22/sports/y-wilhelm-1/y-wilhelm-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/22/sports/y-wilhelm-1/y-wilhelm-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Wilhelm, Grandfather of Dickey’s Knuckleball, Once No-Hit Yankees', 'kicker': None, 'content_kicker': None, 'print_headline': 'Wilhelm, Grandfather of Dickey’s Knuckleball, Once No-Hit Yankees', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Wilhelm, Hoyt', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Baltimore Orioles', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Mets', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Dickey, R A', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Yankees', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Baseball', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-06-22T02:42:30+0000', 'docu