me': 'Ben', 'middlename': None, 'lastname': 'Brantley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/04280a3a-7f2c-528e-ae40-7954c0e0aba7', 'word_count': 1729, 'uri': 'nyt://article/04280a3a-7f2c-528e-ae40-7954c0e0aba7'}, {'abstract': 'Allyson Felix helped lure Jeneba Tarmoh to her training group, and they wound up in a dead heat for the United States’ final Olympic spot in the 100 meters.', 'web_url': 'https://www.nytimes.com/2012/06/28/sports/olympics/jeneba-tarmoh-asked-to-train-with-allyson-felix-now-may-beat-her.html', 'snippet': 'Allyson Felix helped lure Jeneba Tarmoh to her training group, and they wound up in a dead heat for the United States’ final Olympic spot in the 100 meters.', 'lead_paragraph': 'EUGENE, Ore. — About a year ago, as Jeneba Tarmoh was wrapping up her running career at Texas A&M, she conferred with her coaches and family about where she should continue her training. Then her phone rang. ', 'print_section': 'B', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/29/sports/y-sprint/y-sprint-jumbo.jpg', 'height': 1024, 'width': 834, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/29/sports/y-sprint/y-sprint-superJumbo.jpg', 'height': 1998, 'width': 1627, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/29/sports/y-sprint/y-sprint-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/29/sports/y-sprint/y-sprint-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/29/sports/y-sprint/y-sprint-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Catching Running Partner, With a Chance to Pass', 'kicker': '2012 London', 'content_kicker': None, 'print_headline': 'Catching a Running Partner at the Trials,With a Chance to Pass', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Track and Field', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Olympic Games (2012)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Tarmoh, Jeneba', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Olympic Games', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Felix, Allyson', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'London (England)', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-06-28T16:26:30+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Olympics', 'byline': {'original': 'By Mary Pilon', 'person': [{'firstname': 'Mary', 'middlename': None, 'lastname': 'Pilon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9a504eff-d1e4-5991-90a7-a1590976b026', 'word_count': 1404, 'uri': 'nyt://article/9a504eff-d1e4-5991-90a7-a1590976b026'}, {'abstract': 'At first I was nervous about trying to run a marathon while eating a vegan diet, but the more I trained, the better I felt, writes Christine Frietchen.', 'web_url': 'https://well.blogs.nytimes.com/2012/06/28/my-vegan-marathon/', 'snippet': 'At first I was nervous about trying to run a marathon while eating a vegan diet, but the more I trained, the better I felt, writes Christine Frietchen.', 'lead_paragraph': 'Nine years ago, when I trained for my first marathon, I did everything by the book. I built my mileage over the course of 18 weeks; I stretched, I rested on the days I was supposed to rest, and I ate everything the running books told me to eat: yogurt smoothies in the mornings, lunches of fruit, cheese and crackers; dinners of whole grains and vegetables, along with turkey, skinless chicken and fish. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'My Vegan Marathon', 'kicker': 'Well', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Diet and Nutrition', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Marathon Running', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Veganism', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-06-28T16:28:10+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Health', 'byline': {'original': 'By Christine Frietchen', 'person': [{'firstname': 'Christine', 'middlename': None, 'lastname': 'Frietchen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3ed809d5-247f-51ec-a16a-ebd751beee64', 'word_count': 841, 'uri': 'nyt://article/3ed809d5-247f-51ec-a16a-ebd751beee64'}, {'abstract': 'A clairvoyant medium addressed the editorial staff, and the upheaval of the publishing industry was only one of his predictions.', 'web_url': 'https://opinionator.blogs.nytimes.com/2012/06/28/the-future-in-a-past-life/', 'snippet': 'A clairvoyant medium addressed the editorial staff, and the upheaval of the publishing industry was only one of his predictions.', 'lead_paragraph': 'Back in 1989, the publishing company then known as E.P. Dutton was an old-fashioned kind of place. Wide-sashed windows opened to the weather; an orange carpet was duct-taped together where it had frayed; the telex machine buzzed and spit out missives from abroad. I was a young editor, newly enough promoted to still be dazzled by lunches with agents who drank me under the table and left me with the check. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Future, in a Past Life', 'kicker': 'Townies', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Book Trade and Publishing', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Psychics and Psychic Phenomena', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-06-28T16:30:31+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Carole DeSanti', 'person': [{'firstname': 'Carole', 'middlename': None, 'lastname': 'DeSanti', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7bc8aaa2-16a1-5795-8c32-9674182d7663', 'word_count': 1179, 'uri': 'nyt://article/7bc8aaa2-16a1-5795-8c32-9674182d7663'}, {'abstract': 'A Civil War medical steward fights for his life at the Battle of Gaines’ Mill.', 'web_url': 'https://opinionator.blogs.nytimes.com/2012/06/28/left-for-dead-in-virginia/', 'snippet': 'A Civil War medical steward fights for his life at the Battle of Gaines’ Mill.', 'lead_paragraph': 'George T. Perkins and his Union comrades breathed a collective sigh of relief on the afternoon of June 27, 1862. Positioned behind breastworks along a stretch of pinewoods on the battlefield of Gaines’s Mill, they listened as the pounding of artillery and rattling of musketry on their left rose and faded. Then another din on their right, followed by three Yankee huzzahs.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Left for Dead in Virginia', 'kicker': 'Disunion', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Civil War (US) (1861-65)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Doctors', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Prisoners of War', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Army of the Potomac', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Virginia', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-06-28T16:30:48+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Ronald S. Coddington', 'person': [{'firstname': 'Ronald', 'middlename': 'S.', 'lastname': 'Coddington', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9bd8658d-1b2d-5d25-a571-42f67fa84e39', 'word_count': 1559, 'uri': 'nyt://article/9bd8658d-1b2d-5d25-a571-42f67fa84e39'}, {'abstract': 'Brian Baker has endured a number of injuries (and had a six-year hiatus from tennis), but he has now advanced to the third round at Wimbledon. He hopes a top 100 ranking will get him into the U.S Open.', 'web_url': 'https://straightsets.blogs.nytimes.com/2012/06/28/the-remarkable-comeback-of-brian-baker/', 'snippet': 'Brian Baker has endured a number of injuries (and had a six-year hiatus from tennis), but he has now advanced to the third round at Wimbledon. He hopes a top 100 ranking will get him into the U.S Open.', 'lead_paragraph': 'WIMBLEDON, England – Jarkko Nieminen called it “a great story” and “one of the most impressive comebacks, for sure.” And then he was forced to witness the Brian Baker phenomenon from up close – or rather unfortunately for him, from the other side of the net. Nieminen lingered on Court 9 for all of 80 minutes Thursday, becoming the latest victim vanquished by Baker on his improbable ascent.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Remarkable Comeback of Brian Baker', 'kicker': 'Straight Sets', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Wimbledon Tennis Tournament', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Baker, Brian', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Berdych, Tomas', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Murray, Andy', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Nieminen, Jarkko', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Simon, Gilles', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-06-28T16:33:24+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By Ben Shpigel', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Shpigel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d311fcb4-e7f6-51dc-a562-5aef644e3a48', 'word_count': 451, 'uri': 'nyt://article/d311fcb4-e7f6-51dc-a562-5aef644e3a48'}, {'abstract': 'A survey by professional services firm Rothstein Kass found that 77 percent of 293 private equity firms polled believe there will be more attractive investment opportunities this year than last.', 'web_url': 'https://dealbook.nytimes.com/2012/06/28/private-equity-firms-see-a-brighter-2012/', 'snippet': 'A survey by professional services firm Rothstein Kass found that 77 percent of 293 private equity firms polled believe there will be more attractive investment opportunities this year than last.', 'lead_paragraph': 'Private equity firms are more bullish about investment opportunities in 2012 than they were in 2011, but they don’t expect a surge in capital raising this year. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Private Equity Firms See a Brighter 2012', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Capital Gains Tax', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mergers, Acquisitions and Divestitures', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Private Equity', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-06-28T16:36:59+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Janet Morrissey', 'person': [{'firstname': 'Janet', 'middlename': None, 'lastname': 'Morrissey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9339d061-0834-5249-94b6-5b4bfaaea75e', 'word_count': 459, 'uri': 'nyt://article/9339d061-0834-5249-94b6-5b4bfaaea75e'}, {'abstract': 'During a night dive under intense blue lights, the Solomon Islands reef becomes a blazing neon light show.', 'web_url': 'https://scientistatwork.blogs.nytimes.com/2012/06/28/biofluorescence-under-blue-lights/', 'snippet': 'During a night dive under intense blue lights, the Solomon Islands reef becomes a blazing neon light show.', 'lead_paragraph': 'Vincent Pieribone is a neuroscientist at the John B. Pierce Laboratory/Yale School of Medicine studying biofluorescent molecules in the Solomon Islands. In his laboratory, he uses these molecules in biomedical research.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Biofluorescence Under Blue Lights', 'kicker': 'Scientist at Work', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Diving and Divers', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Lighting', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Science and Technology', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Solomon Islands', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-06-28T16:41:16+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Science', 'byline': {'original': 'By Vincent Pieribone', 'person': [{'firstname': 'Vincent', 'middlename': None, 'lastname': 'Pieribone', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/21d1702c-7aa9-5e2c-8766-2206c6c9f87c', 'word_count': 535, 'uri': 'nyt://article/21d1702c-7aa9-5e2c-8766-2206c6c9f87c'}, {'abstract': 'Chief Justice Roberts’s decision put political considerations ahead of a straightforward reading of the health care bill.', 'web_url': 'https://douthat.blogs.nytimes.com/2012/06/28/john-roberts-political-decision/', 'snippet': 'Chief Justice Roberts’s decision put political considerations ahead of a straightforward reading of the health care bill.', 'lead_paragraph': 'During the run-up to this morning’s Supreme Court health care ruling, liberals insisted over and over again that a decision overturning Obamacare would represently a nakedly “political” move by the court’s conservatives, rather than a decision motivated by an honest, principled interpretation of the Constitution and the law. Which makes it ironic that — upon first reading, at least — Obamacare seems to have been saved by Chief Justice Roberts’s decision to put political considerations ahead of a straightforward reading of the health care bill.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'John Roberts’s Political Decision', 'kicker': 'Ross Douthat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Health Insurance and Managed Care', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Patient Protection and Affordable Care Act (2010)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Roberts, John G Jr', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Supreme Court', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-06-28T16:42:17+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Ross Douthat', 'person': [{'firstname': 'Ross', 'middlename': None, 'lastname': 'Douthat', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2938350e-cf71-5eb8-8eff-3df795880247', 'word_count': 396, 'uri': 'nyt://article/2938350e-cf71-5eb8-8eff-3df795880247'}, {'abstract': 'The shares of major insurers suffered a modest dip on Thursday, while pharmaceutical and device companies fell slightly, and hospital stocks rose.', 'web_url': 'https://www.nytimes.com/2012/06/29/business/insurance-stocks-flag-hospital-shares-gain.html', 'snippet': 'The shares of major insurers suffered a modest dip on Thursday, while pharmaceutical and device companies fell slightly, and hospital stocks rose.', 'lead_paragraph': 'Hospitals will gain millions of paying customers. Insurers, by contrast, could face crimped profits from restrictive rules. Medical device and pharmaceutical companies will bear new taxes and other higher payouts, but they were already expecting such costs. ', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/29/business/29health-sf/29health-sf-jumbo.jpg', 'height': 751, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/29/business/29health-sf/29health-sf-superJumbo.jpg', 'height': 1501, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'In Health Care Ruling, Investors See a Mixed Blessing', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Wall Street Reaction', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Patient Protection and Affordable Care Act (2010)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Drugs (Pharmaceuticals)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Stocks and Bonds', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Supreme Court', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Decisions and Verdicts', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Hospitals', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Health Insurance and Managed Care', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-06-28T16:45:04+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Andrew Pollack and Katie Thomas', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Pollack', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Katie', 'middlename': None, 'lastname': 'Thomas', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f3eab58e-0d8a-5aea-b268-6f67bbb4b7ea', 'word_count': 923, 'uri': 'nyt://article/f3eab58e-0d8a-5aea-b268-6f67bbb4b7ea'}, {'abstract': 'President Obama offered a brief but intense defense of the embattled law, selling its major provisions as important reforms and the mandate as “essential.”', 'web_url': 'https://thecaucus.blogs.nytimes.com/2012/06/28/obama-praises-courts-decision-on-health-care/', 'snippet': 'President Obama offered a brief but intense defense of the embattled law, selling its major provisions as important reforms and the mandate as “essential.”', 'lead_paragraph': 'President Obama hailed the Supreme Court’s decision on the Affordable Care Act, saying the politically divisive measure will improve health care for millions of Americans who have insurance and expand coverage to millions who do not.', 'source': 'The New York Times', 'multimedia': [], 