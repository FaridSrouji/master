ddlename': None, 'lastname': 'Zinser', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b7a495a1-d41f-54f9-89ca-1229efa19dc9', 'word_count': 655, 'uri': 'nyt://article/b7a495a1-d41f-54f9-89ca-1229efa19dc9'}, {'abstract': 'After confusion at the trials, Bryan Clay won’t compete in the decathlon in London, but he will attend the Games to cheer on his former competitors, Ashton Eaton and Trey Hardee.', 'web_url': 'https://london2012.blogs.nytimes.com/2012/06/26/clay-wont-compete-but-hell-be-in-london/', 'snippet': 'After confusion at the trials, Bryan Clay won’t compete in the decathlon in London, but he will attend the Games to cheer on his former competitors, Ashton Eaton and Trey Hardee.', 'lead_paragraph': 'Bryan Clay has been a fixture in the Olympic track and field community since 2004, so it was not surprising that almost as soon as Clay stumbled out of this year’s trials, a public movement began calling for United States Track and Field to find a way to get Clay to London anyway.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Clay Won’t Compete, but He’ll Be in London', 'kicker': '2012 London Olympics', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Olympic Games (2012)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Track and Field', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Clay, Bryan', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'International Olympic Committee', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-06-26T14:09:17+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Olympics', 'byline': {'original': 'By Sam Borden', 'person': [{'firstname': 'Sam', 'middlename': None, 'lastname': 'Borden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/62f23015-243d-5777-ac62-f78babfecaed', 'word_count': 568, 'uri': 'nyt://article/62f23015-243d-5777-ac62-f78babfecaed'}, {'abstract': 'Women in Nairobi are having more casual sex, a sign of female empowerment. Too bad Kenya’s policies about sexual health aren’t keeping pace with mores.', 'web_url': 'https://latitude.blogs.nytimes.com/2012/06/26/sexual-health-policies-in-kenya/', 'snippet': 'Women in Nairobi are having more casual sex, a sign of female empowerment. Too bad Kenya’s policies about sexual health aren’t keeping pace with mores.', 'lead_paragraph': 'NAIROBI — Kenya’s cosmopolitan capital barely sleeps. Not only are most workers up before the sun, for many young men and women, the predawn hour is when the real fun starts.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Sex in This City', 'kicker': 'Latitude', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Birth Control and Family Planning', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Medicine and Health', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Sex', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Kenya', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Nairobi (Kenya)', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-06-26T14:23:59+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Dayo Olopade', 'person': [{'firstname': 'Dayo', 'middlename': None, 'lastname': 'Olopade', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f806afb2-ac63-56db-b922-0dbbc22d2e2e', 'word_count': 614, 'uri': 'nyt://article/f806afb2-ac63-56db-b922