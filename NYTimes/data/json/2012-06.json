ws', '_id': 'nyt://article/bbf0cf88-5b28-5901-9aa2-496b41c98ba2', 'word_count': 0, 'uri': 'nyt://article/bbf0cf88-5b28-5901-9aa2-496b41c98ba2'}, {'abstract': 'A look at some of the architectural sightings and V.I.P. happenings all over town.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2012/06/15/arch-basel/', 'snippet': 'A look at some of the architectural sightings and V.I.P. happenings all over town.', 'lead_paragraph': 'var data;function jsonSlideshowCallback(response){data = response;}NYTD.options = {source: data,cropType: \'blog480\',appendTo: \'fullScreenSlideShow\',showHeadLine: \'false\', renderstyle: "embeddedSlideShowTmag"}', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Arch Basel', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-06-15T17:50:14+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Felix Burrichter', 'person': [{'firstname': 'Felix', 'middlename': None, 'lastname': 'Burrichter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6c3541d4-a4fe-5fd5-8130-f3b4c880eec0', 'word_count': 438, 'uri': 'nyt://article/6c3541d4-a4fe-5fd5-8130-f3b4c880eec0'}, {'abstract': 'Some Manhattanites live on short, quirky streets where, often, their off-the-beaten-path neighborhoods are quiet and villagelike.', 'web_url': 'https://www.nytimes.com/2012/06/17/realestate/beyond-the-grid-manhattan.html', 'snippet': 'Some Manhattanites live on short, quirky streets where, often, their off-the-beaten-path neighborhoods are quiet and villagelike.', 'lead_paragraph': 'THE vast majority of Manhattan residents live on streets that seem to run forever. Twenty-third Street clocks in at about two miles, Second Avenue at nearly seven. Thanks to Manhattan’s grid plan, which is celebrating its bicentennial with an exhibition at the Museum of the City of New York, the bulk of the island is laid out in rigid checkerboard fashion.', 'print_section': 'RE', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/17/realestate/17COVER_SPAN/17COVER_SPAN-articleLarge.jpg', 'height': 380, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/06/17/realestate/17COVER_SPAN/17COVER_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 380}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/17/realestate/17COVER_SPAN/cover-1-jumbo.jpg', 'height': 714, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/17/realestate/17COVER_SPAN/cover-1-superJumbo.jpg', 'height': 1429, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/17/realestate/17COVER_SPAN/17COVER_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/17/realestate/17COVER_SPAN/17COVER_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/17/realestate/17COVER_SPAN/17COVER_SPAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Beyond-the-Grid Manhattan', 'kicker': None, 'content_kicker': None, 'print_headline': 'Beyond-the-Grid Manhattan', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Manhattan (NYC)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-06-15T17:52:35+0000', 'document_type': 'article', 'news_desk': 'RealEstate', 'section_name': 'Real Estate', 'byline': {'original': 'By Constance Rosenblum', 'person': [{'firstname': 'Constance', 'middlename': None, 'lastname': 'Rosenblum', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d7473850-8dbb-5a32-817a-95d6636e004c', 'word_count': 432, 'uri': 'nyt://article/d7473850-8dbb-5a32-817a-95d6636e004c'}, {'abstract': 'Merida, the protagonist of Pixar’s “Brave,” is the studio’s first leading heroine, a Scottish princess who had several incarnations on her way to the screen.', 'web_url': 'https://www.nytimes.com/2012/06/17/movies/pixars-brave-how-the-character-merida-was-developed.html', 'snippet': 'Merida, the protagonist of Pixar’s “Brave,” is the studio’s first leading heroine, a Scottish princess who had several incarnations on her way to the screen.', 'lead_paragraph': 'IN some form or other — toys, monsters, cars, rats and even little boys — male characters have been at the center of Pixar Animation Studio’s feature films. But now for the first time in its 17-year history, Pixar has a female lead. The studio spent more than five years bringing Merida, the empowered girl at the center of “Brave” (opening Friday), to life. It took a number of designs and two directors to do it.', 'print_section': 'AR', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/17/arts/17BRAVE1_SPAN/17BRAVE1-articleLarge.jpg', 'height': 324, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'imag