': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fbb6c8fa-bcd2-51ff-b2c8-56e8c1f8cd8f', 'word_count': 502, 'uri': 'nyt://article/fbb6c8fa-bcd2-51ff-b2c8-56e8c1f8cd8f'}, {'abstract': 'The drug Perjeta is meant to be used with the company’s drug called Herceptin to treat the disease its advanced stages.', 'web_url': 'https://www.nytimes.com/2012/06/09/business/genentech-wins-approval-for-new-breast-cancer-drug.html', 'snippet': 'The drug Perjeta is meant to be used with the company’s drug called Herceptin to treat the disease its advanced stages.', 'lead_paragraph': 'Genentech won federal approval Friday for a new drug to treat advanced breast cancer. But the company said it was experiencing manufacturing problems that could lead to a shortage of the drug. ', 'print_section': 'B', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Genentech Wins Approval for New Breast Cancer Drug', 'kicker': None, 'content_kicker': None, 'print_headline': 'Genentech Breast Cancer Drug Wins Approval', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Genentech Inc', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Herceptin (Drug)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Drugs (Pharmaceuticals)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Food and Drug Administration', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Breast Cancer', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-06-09T02:09:28+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Andrew Pollack', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Pollack', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/97f858b9-41d5-5c68-92cb-83e8089489ff', 'word_count': 633, 'uri': 'nyt://article/97f858b9-41d5-5c68-92cb-83e8089489ff'}, {'abstract': 'Port Authority officials, citing rising costs, called for an agency to oversee the World Trade Center site and its memorial foundation, led by Mayor Michael R. Bloomberg.', 'web_url': 'https://www.nytimes.com/2012/06/09/nyregion/port-authority-asks-oversight-of-world-trade-center-memorial-site.html', 'snippet': 'Port Authority officials, citing rising costs, called for an agency to oversee the World Trade Center site and its memorial foundation, led by Mayor Michael R. Bloomberg.', 'lead_paragraph': 'The financial dispute that has hobbled construction of the museum at ground zero for eight months entered a new stage this week with a struggle over who will control the overall memorial and the eight-acre site. The Sept. 11 memorial foundation, which is led by Mayor Michael R. Bloomberg, has been responsible for the planning, development and programming of the memorial at the trade center site, as well as the visitor center and the National Sept. 11 Memorial and Museum, under a 2006 agreement.', 'print_section': 'A', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/09/nyregion/Y-MEMORIAL/Y-MEMORIAL-articleLarge-v2.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/06/09/nyregion/Y-MEMORIAL/Y-MEMORIAL-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/09/nyregion/Y-MEMORIAL/Y-MEMORIAL-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/09/nyregion/Y-MEMORIAL/Y-MEMORIAL-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop