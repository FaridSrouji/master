aption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/23/sports/lin/lin-superJumbo.jpg', 'height': 1257, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/23/sports/lin/lin-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/23/sports/lin/lin-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/23/sports/lin/lin-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Lin Granted Early-Bird Rights', 'kicker': None, 'content_kicker': None, 'print_headline': 'Ruling Keeps Alive Knicks’ Hopes of Signing Lin and Novak', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Novak, Steve', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Lin, Jeremy', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Knicks', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Basketball', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-06-22T18:25:54+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Basketball', 'byline': {'original': 'By Howard Beck', 'person': [{'firstname': 'Howard', 'middlename': None, 'lastname': 'Beck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ad7fa4d3-6a6b-5d47-8716-114bf6a5f309', 'word_count': 543, 'uri': 'nyt://article/ad7fa4d3-6a6b-5d47-8716-114bf6a5f309'}, {'abstract': 'Mr. Rubio criticized the narrowness of focus on both sides: liberals who wanted a path to amnesty for 11 to 12 million illegal immigrants, as well as conservatives who only talk of controlling the border.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2012/06/22/rubio-denounces-partisanship-on-immigration/', 'snippet': 'Mr. Rubio criticized the narrowness of focus on both sides: liberals who wanted a path to amnesty for 11 to 12 million illegal immigrants, as well as conservatives who only talk of controlling the border.', 'lead_paragraph': 'An hour before President Obama was to speak to Latino officials on Friday, Senator Marco Rubio of Florida lamented how the immigration issue has become hostage to politics — on both the left and right.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Rubio Denounces Partisanship on Immigration', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dream Act (Development, Relief and Education for Minors Act)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Rubio, Marco', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Florida', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-06-22T18:26:12+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Trip Gabriel', 'person': [{'firstname': 'Trip', 'middlename': None, 'lastname': 'Gabriel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6135c05e-3004-5931-bb74-180380e98766', 'word_count': 590, 'uri': 'nyt://article/6135c05e-3004-5931-bb74-180380e98766'}, {'abstract': 'The 1950 Cadillac Series 61 streamlined racecar was driven at the French circuit by Briggs Cunningham, before he began building his own racecars.', 'web_url': 'https://wheels.blogs.nytimes.com/2012/06/22/after-62-year-absence-le-monstre-will-stalk-le-mans-again/', 'snippet': 'The 1950 Cadillac Series 61 streamlined racecar was driven at the French circuit by Briggs Cunningham, before he began building his own racecars.', 'lead_paragraph': 'Briggs Swift Cunningham, a wealthy sportsman who raced yachts as well as cars, never achieved his dream of winning the 24 Hours of Le Mans in France. But he came fairly close, placing as high as third over all and first in class in both 1953 and 1954, with C4R and C5R cars of his own company’s design.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'After 62-Year Absence, Le Monstre Will Stalk Le Mans Again', 'kicker': 'Wheels', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Automobiles', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Le Mans Auto Race', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Cunningham, Briggs Swift', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Cadillac Division of General Motors Corp', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'France', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-06-22T18:32:02+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Automobiles', 'byline': {'original': 'By Jim Motavalli', 'person': [{'firstname': 'Jim', 'middlename': None, 'lastname': 'Motavalli', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ae11d43c-8673-56cc-a36a-b31db368a807', 'word_count': 616, 'uri': 'nyt://article/ae11d43c-8673-56cc-a36a-b31db368a807'}, {'abstract': 'The Senate voted to stop funding political conventions with tax-payer dollars.', 'web_url': 'https://takingnote.blogs.nytimes.com/2012/06/22/conventions-or-hallelujah-parties/', 'snippet': 'The Senate voted to stop funding political conventions with tax-payer dollars.', 'lead_paragraph': 'The quadrennial Republican and Democratic nominating conventions stopped being actual parts of the nominating process in the 1970s.\xa0 But they retained aspects of their original purpose – the ritual vote and the speeches by each party’s big shots and nominees. A convention can set the tone for the fall campaign – for good (Barack Obama’s wildly successful convention in Denver in 2008) or ill (John Kerry’s cringe-inducing convention in Boston in 2004.)', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Conventions, or Hallelujah Parties?', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Campaign Finance', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Democratic National Convention', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Republican National Convention', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Coburn, Tom', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Landrieu, Mary L', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'McCain, John', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-06-22T18:34:38+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Andrew Rosenthal', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Rosenthal', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/acd65def-8292-5021-9d0b-8256f5602623', 'word_count': 371, 'uri': 'nyt://article/acd65def-8292-5021-9d0b-8256f5602623'}, {'abstract': 'Msgr. William J. Lynn became the first senior Roman Catholic official in the United States to be convicted for covering up child sexual abuses by priests in his charge.', 'web_url': 'https://www.nytimes.com/2012/06/23/us/philadelphias-msgr-william-j-lynn-is-convicted-of-allowing-abuse.html', 'snippet': 'Msgr. William J. Lynn became the first senior Roman Catholic official in the United States to be convicted for covering up child sexual abuses by priests in his charge.', 'lead_paragraph': 'PHILADELPHIA — Msgr. William J. Lynn, a former cardinal’s aide, was found guilty Friday of endangering children, becoming the first senior official of the Roman Catholic Church in the United States convicted of covering up sexual abuses by priests under his supervision. ', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/23/us/23priest-cnd/23priest-cnd-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/23/us/23priest-cnd/23priest-cnd-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/23/us/23priest-cnd/23priest-cnd-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/23/us/23priest-cnd/23priest-cnd-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/23/us/23priest-cnd/23priest-cnd-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Cardinal’s Aide Is Found Guilty in Abuse Case', 'kicker': None, 'content_kicker': None, 'print_headline': 'Cardinal’s Aide Is Found Guilty In Abuse Case', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Roman Catholic Church', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Sex Crimes', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Avery, Edward V', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Philadelphia (Pa)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Priests', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Brennan, James J', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Child Abuse and Neglect', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Bevilacqua, Anthony J', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Lynn, William J', 'rank': 9, 'major': 'N'}], 'pub_date': '2012-06-22T18:34:38+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Jon Hurdle and Erik Eckholm', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Hurdle', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Erik', 'middlename': None, 'lastname': 'Eckholm', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ed189311-c1d3-5cbd-8ad7-405984d74027', 'word_count': 1143, 'uri': 'nyt://article/ed189311-c1d3-5cbd-8ad7-405984d74027'}, {'abstract': 'With soldiers embracing smartphones like the rest of us, the Defense Department is exploring ways to keep them safe from hackers and enemy fighters.', 'web_url': 'https://bits.blogs.nytimes.com/2012/06/22/u-s-military-hunts-for-safe-smartphones-for-soldiers/', 'snippet': 'With soldiers embracing smartphones like the rest of us, the Defense Department is exploring ways to keep them safe from hackers and enemy fighters.', 'lead_paragraph': ' The military has long needed computers that are tough enough on the outside to withstand the rough and tumble of the battlefield. Now, with the proliferation of smartphones and tablets in the hands of soldiers, those devices also have to be strong on the inside. They are loaded with contacts, location information and all kinds of military-grade applications, so it can be deadly for a soldier to lose a mobile device or have its data leak out unwittingly. ', 'print_section': 'B', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/22/technology/22bits-soldiers2/22bits-soldiers2-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/22/technology/22bits-soldiers2/22bits-soldiers2-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'U.S. Military Hunts for Safe Smartphones for Soldiers', 'kicker': 'Bits', 'content_kicker': None, 'print_headline': 'Phone Security For the Military', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Smartphones', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Defense Advanced Research Projects Agency', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Defense Department', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-06-22T18:39:29+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By Somini Sengupta', 'person': [{'firstname': 'Somini', 'middlename': None, 'lastname': 'Sengupta', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e0747265-c6e4-551d-b983-8e5bd81c6fd6', 'word_count': 602, 'uri': 'nyt://article/e0747265-c6e4-551d-b983-8e5bd81c6fd6'}, {'abstract': 'Census Bureau field representatives knock on thousands of doors each month — and sometimes even fly to remote villages — to encourage people to participate in the government’s monthly survey on job growth. But like many studies, it’s not as precise as people think.', 'web_url': 'https://6thfloor.blogs.nytimes.com/2012/06/22/how-is-the-monthly-jobs-report-actually-calculated/', 'snippet': 'Census Bureau field representatives knock on thousands of doors each month — and sometimes even fly to remote villages — to encourage people to participate in the government’s monthly survey on job growth. But like many studies, it’s not as precis...', 'lead_paragraph': 'In this week’s magazine, Adam Davidson writes about the jobs report, the government’s monthly estimate of the employment situation in the United States. The Bureau of Labor Statistics releases the report on the first Friday of every month, at exactly 8:30 in the morning. In an instant, reporters and analysts decide whether it spells doom or salvation for the economy. But how are the numbers calculated in the first place?', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'How Is the Monthly Jobs Report Actually Calculated?', 'kicker': 'The 6th Floor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Labor and Jobs', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Davidson, Adam', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Bureau of Labor Statistics', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Census Bureau', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-06-22T18:41:55+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Magazine', 'byline': {'original': 'By Dan Kedmey', 'person': [{'firstname': 'Dan', 'middlename': None, 'lastname': 'Kedmey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8935e44f-a338-51ed-9894-d125179180ab', 'word_count': 357, 'uri': 'nyt://article/8935e44f-a338-51ed-9894-d125179180ab'}, {'abstract': 'A week with Sean MacPherson, the hotel proprietor of the Bowery and Jane hotels and an owner of the Waverly Inn restaurant, in June in New York City and Montauk, N.Y.', 'web_url': 'https://www.nytimes.com/2012/06/24/fashion/sean-macpherson-hotel-proprietor-on-what-i-wore.html', 'snippet': 'A week with Sean MacPherson, the hotel proprietor of the Bowery and Jane hotels and an owner of the Waverly Inn restaurant, in June in New York City and Montauk, N.Y.', 'lead_paragraph': 'Sean MacPherson, 47, proprietor of the Bowery, Jane and Maritime hotels and an owner of the Waverly Inn restaurant, is revamping the Crow’s Nest Inn in Montauk, N.Y. His wife is Rachelle Hruska, a founder of the night-life blog GuestofaGuest.com. BEE-SHYUAN CHANG', 'print_section': 'ST', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/24/fashion/24WIW/24WIW-jumbo.jpg', 'height': 1722, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/24/fashion/24WIW/24WIW-superJumbo.jpg', 'height': 2048, 'width': 1218, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/24/fashion/24WIW/24WIW-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/24/fashion/24WIW/24WIW-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/24/fashion/24WIW/24WIW-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Practiced Nonchalance', 'kicker': 'What I Wore | Sean MacPherson', 'content_kicker': None, 'print_headline': 'A Practiced Nonchalance', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'MacPherson, Sean', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Montauk (NY)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-06-22T18:49:05+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'byline': {'original': 'By Bee-Shyuan Chang', 'person': [{'firstname': 'Bee-shyuan', 'middlename': None, 'lastname': 'Chang', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c4b41f2b-38c8-57a8-9198-22038001f1c2', 'word_count': 725, 'uri': 'nyt://article/c4b41f2b-38c8-57a8-9198-22038001f1c2'}, {'abstract': 'Researchers say Oregon’s lottery system for granting health insurance has made it the best place to study the costs and benefits of the federal health care law.', 'web_url': 'https://www.nytimes.com/2012/06/23/health/oregon-study-reveals-benefits-and-costs-of-insuring-the-uninsured.html', 'snippet': 'Researchers say Oregon’s lottery system for granting health insurance has made it the best place to study the costs and benefits of the federal health care law.', 'lead_paragraph': 'PORTLAND, Ore. — When Wendy Parris shattered her ankle, the emergency room put it in an air cast and sent her on her way. Because she had no insurance, doctors did not operate to fix it. A mother of six, Ms. Parris hobbled around for four years, pained by the foot, becoming less mobile and gaining weight.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype':