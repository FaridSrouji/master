ndard', 'legacy': {'thumbnail': 'images/2012/06/14/technology/personaltech/14bits-apps/14bits-apps-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/14/technology/personaltech/14bits-apps/14bits-apps-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Apps I Want to Go Away', 'kicker': 'Bits', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'iPhone', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mobile Applications', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Apple Incorporated', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-06-14T21:45:58+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By Sam Grobart', 'person': [{'firstname': 'Sam', 'middlename': None, 'lastname': 'Grobart', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/456942d6-f423-58d7-b0cd-21de6054b42f', 'word_count': 630, 'uri': 'nyt://article/456942d6-f423-58d7-b0cd-21de6054b42f'}, {'abstract': 'Keigwin + Company presented two premieres, “Contact Sport” and “12 Chairs,” at the Joyce Theater.', 'web_url': 'https://www.nytimes.com/2012/06/15/arts/dance/keigwin-company-in-two-premieres-at-the-joyce-theater.html', 'snippet': 'Keigwin + Company presented two premieres, “Contact Sport” and “12 Chairs,” at the Joyce Theater.', 'lead_paragraph': 'In Larry Keigwin’s new “Contact Sport” four men dressed as schoolboys stand in front of a sparkly blue curtain. The gloriously pseudo-European voice of Eartha Kitt sings “Come on-a My House” in Japanese, and the dancers shove one another around with a combination of speed, design and play that signals choreographic wit. A good time, it seems, is in store. ', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/15/arts/15KEIGWIN_SPAN/15KEIGWIN_SPAN-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/06/15/arts/15KEIGWIN_SPAN/15KEIGWIN_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/15/arts/15KEIGWIN_SPAN/KEIGWIN-jumbo.jpg', 'height': 689, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/15/arts/15KEIGWIN_SPAN/KEIGWIN-superJumbo.jpg', 'height': 1377, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/15/arts/15KEIGWIN_SPAN/15KEIGWIN_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/15/arts/15KEIGWIN_SPAN/15KEIGWIN_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/15/arts/15KEIGWIN_SPAN/15KEIGWIN_SPAN-thumbLarge.jpg', 'height': 101, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Boys Bonding and Roughhousing', 'kicker': 'Dance Review', 'content_kicker': None, 'print_headline': 'Boys Bonding and Roughhousing', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Keigwin + Company', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Keigwin, Larry', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Dancing', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Joyce Theater', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-06-14T21:46:00+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Brian Seibert', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Seibert', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/5547ddd6-36a9-5ec4-b518-0d4cf4d45252', 'word_count': 515, 'uri': 'nyt://article/5547ddd6-36a9-5ec4-b518-0d4cf4d45252'}, {'abstract': 'With two Gershwin-connected shows winning Tony Awards this week, the estates of George and Ira Gershwin are hopeful about their next project intended for Broadway: a stage musical of “An American in Paris.”', 'web_url': 'https://www.nytimes.com/2012/06/15/theater/gershwin-trustees-hopeful-for-a-broadway-american-in-paris.html', 'snippet': 'With two Gershwin-connected shows winning Tony Awards this week, the estates of George and Ira Gershwin are hopeful about their next project intended for Broadway: a stage musical of “An American in Paris.”', 'lead_paragraph': 'Winning the Tony Award for best musical revival is great, and ’s wonderful to have two popular shows on Broadway that have potentially lucrative national tours starting next year. But for the trustees of George and Ira Gershwin’s estates the sweetest feeling this week is the satisfaction — they were loath to call it vindication — that their stewardship of the Gershwin brothers’ legacy is reaping laurels and dividends after some high-powered criticism.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Gershwin Shows’ Tonys Fuel Plans for a Musical', 'kicker': None, 'content_kicker': None, 'print_headline': 'Gershwin Shows’ Tonys Fuel Plans for a Musical', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Lucas, Craig', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Gershwin, Ira', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Gershwin, George', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Tony Awards (Theater Awards)', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-06-14T21:49:29+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Theater', 'byline': {'original': 'By Patrick Healy', 'person': [{'firstname': 'Patrick', 'middlename': None, 'lastname': 'Healy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b3e6052f-8e17-515c-8b6a-32c7263379b0', 'word_count': 679, 'uri': 'nyt://article/b3e6052f-8e17-515c-8b6a-32c7263379b0'}, {'abstract': '“The Invisible War,” about the epidemic of rape within the United States military, is one of the most shocking documentaries in the 2012 Human Rights Watch Film Festival.', 'web_url': 'https://www.nytimes.com/2012/06/15/movies/human-rights-watch-film-festival-at-lincoln-center.html', 'snippet': '“The Invisible War,” about the epidemic of rape within the United States military, is one of the most shocking documentaries in the 2012 Human Rights Watch Film Festival.', 'lead_paragraph': 'It hardly needs to be said that any armed force has the potential for internal as well as external violence. But “The Invisible War,” Kirby Dick’s incendiary documentary about the epidemic of rape within the United States military, is a shocking and infuriating indictment of widespread sexual attacks on women. Such behavior, the film argues, is tacitly condoned and routinely covered up; the victims are often blamed and their reputations destroyed.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/15/arts/15HUMAN_SPAN/15HUMAN_SPAN-articleLarge.jpg', 'height': 380, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/06/15/arts/15HUMAN_SPAN/15HUMAN_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 380}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/15/arts/15HUMAN_SPAN/15HUMAN-jumbo.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/15/arts/15HUMAN_SPAN/15HUMAN-superJumbo.jpg', 'height': 1152, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/15/arts/15HUMAN_SPAN/15HUMAN_SPAN-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/15/arts/15HUMAN_SPAN/15HUMAN_SPAN-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/15/arts/15HUMAN_SPAN/15HUMAN_SPAN-thumbLarge-v2.jpg', 'height': 84, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Heroes, Villains and the Invisible', 'kicker': 'Critic’s Notebook', 'content_kicker': None, 'print_headline': 'Heroes, Villains And the Invisible', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Human Rights and Human Rights Violations', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Sex Crimes', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Dick, Kirby', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Kato, David', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Homosexuality', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Ai Weiwei', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Human Rights Watch International Film Festival', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 9, 'major': 'N'}], 'pub_date': '2012-06-14T21:51:27+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Stephen Holden', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Holden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c9eeebfb-a240-58fb-9084-4cd5af4658f4', 'word_count': 819, 'uri': 'nyt://article/c9eeebfb-a240-58fb-9084-4cd5af4658f4'}, {'abstract': '“Slow Fade to Black,” a multimedia show for the Celebrate Brooklyn! festival, is an unusual collaboration for two African-American artists who tend to inhabit separate spheres of culture.', 'web_url': 'https://www.nytimes.com/2012/06/15/arts/design/slow-fade-to-black-at-celebrate-brooklyn-in-prospect-park.html', 'snippet': '“Slow Fade to Black,” a multimedia show for the Celebrate Brooklyn! festival, is an unusual collaboration for two African-American artists who tend to inhabit separate spheres of culture.', 'lead_paragraph': 'POINTING her camera, the artist Carrie Mae Weems lobbed directions. “A little more smoke!” and “Women, raise your mirrors!” she instructed the performers gathered recently in a black-box theater on the Lower East Side. Geri Allen, the jazz pianist and composer, sat nearby, scribbling notes.', 'print_section': 'C', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit