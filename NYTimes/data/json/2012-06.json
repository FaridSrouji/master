ank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Baseball', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Washington Nationals', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-06-07T20:15:21+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Andrew Keh', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Keh', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/74d636b3-7661-5b0e-802c-8350b434e574', 'word_count': 821, 'uri': 'nyt://article/74d636b3-7661-5b0e-802c-8350b434e574'}, {'abstract': '“Ellsworth Kelly Plant Drawings,” at the Metropolitan Museum shows how figurative works have shaped the art of an abstract painter and sculptor.', 'web_url': 'https://www.nytimes.com/2012/06/08/arts/design/ellsworth-kellys-plant-drawings-at-the-met.html', 'snippet': '“Ellsworth Kelly Plant Drawings,” at the Metropolitan Museum shows how figurative works have shaped the art of an abstract painter and sculptor.', 'lead_paragraph': 'In 1970 the Metropolitan Museum curator Henry Geldzahler mounted a big survey of three decades of New York art. It included two rooms of work by Ellsworth Kelly: one of abstract painting and sculpture, and another given over entirely to drawings of plants. It was the first time Mr. Kelly had shown any of these drawings, which he had been making since his first big artistic breakthrough in late-1940s Paris.', 'print_section': 'C', 'print_page': '34', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/08/arts/08KELLY1/JPKELLY1-jumbo.jpg', 'height': 811, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/