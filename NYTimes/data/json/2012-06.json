, {'abstract': 'Three gadgets represent small steps by technology into the kitchen: a rice cooker, a kitchen thermometer and an espresso coffee maker.', 'web_url': 'https://www.nytimes.com/video/technology/personaltech/100000001618070/three-small-steps-for-kitchen-technology.html', 'snippet': 'Three gadgets represent small steps by technology into the kitchen: a rice cooker, a kitchen thermometer and an espresso coffee maker.', 'lead_paragraph': 'Three gadgets represent small steps by technology into the kitchen: a rice cooker, a kitchen thermometer and an espresso coffee maker.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/20/technology/video-tech-120620-kitchen/video-tech-120620-kitchen-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/06/20/technology/video-tech-120620-kitchen/video-tech-120620-kitchen-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/20/technology/video-tech-120620-kitchen/video-tech-120620-kitchen-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/20/technology/video-tech-120620-kitchen/video-tech-120620-kitchen-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Three Small Steps for Kitchen Technology', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Science and Technology', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Kitchens', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-06-20T20:19:27+0000', 'document_type': 'multimedia', 'news_desk': 'Circuits', 'section_name': 'Technology', 'subsection_name': 'Personal Tech', 'byline': {'original': 'Jeremy Beiler', 'person': [{'firstname': 'Jeremy', 'middlename': None, 'lastname': 'Beiler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/f98c1414-1107-5a30-8af2-0948a84aedff', 'word_count': 0, 'uri': 'nyt://video/f98c1414-1107-5a30-8af2-0948a84aedff'}, {'abstract': 'Three gadgets represent small steps by technology into the kitchen: a rice cooker, a kitchen thermometer and an espresso coffee maker.', 'web_url': 'https://www.nytimes.com/2012/06/21/technology/personaltech/kitchen-technology-for-rice-coffee-and-cooking-thermometers-tool-kit.html', 'snippet': 'Three gadgets represent small steps by technology into the kitchen: a rice cooker, a kitchen thermometer and an espresso coffee maker.', 'lead_paragraph': 'We expect technology in certain places. We even welcome it. Technology in the workplace? A given. At home in the living room? Awesome — more movies to watch, more music to listen to, more games to play. When we’re traveling? Also a boon. We gain a wealth of information, and therefore power, as we compare fares, rebook canceled flights and find taxis in strange cities at odd hours.', 'print_section': 'B', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/21/business/21-TOOLKIT1/21-TOOLKIT1-articleLarge-v2.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/06/21/business/21-TOOLKIT1/21-TOOLKIT1-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/21/business/21-TOOLKIT1/21-TOOLKIT1-jumbo-v2.jpg', 'height': 579, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJum