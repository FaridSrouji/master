ct', 'value': 'Health Insurance and Managed Care', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Medicaid', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Patient Protection and Affordable Care Act (2010)', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-06-27T15:51:23+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Eduardo Porter', 'person': [{'firstname': 'Eduardo', 'middlename': None, 'lastname': 'Porter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f5e43b1f-eac3-539e-a064-960bafd650fd', 'word_count': 614, 'uri': 'nyt://article/f5e43b1f-eac3-539e-a064-960bafd650fd'}, {'abstract': 'A 230-foot section of a road built by the Romans nearly 2,000 years ago has been discovered by archaeologists in Thessaloniki, Greece’s second-largest city, during excavations for a new subway system, the Associated Press reported', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/06/27/ancient-marble-paved-road-discovered-in-greece/', 'snippet': 'A 230-foot section of a road built by the Romans nearly 2,000 years ago has been discovered by archaeologists in Thessaloniki, Greece’s second-largest city, during excavations for a new subway system, the Associated Press reported', 'lead_paragraph': 'A 230-foot section of a road built by the Romans nearly 2,000 years ago has been discovered by archaeologists in Thessaloniki, Greece’s second-largest city, during excavations for a new subway system, the Associated Press reported.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Ancient Marble-Paved Road Discovered in Greece', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'An Ancient Stretch of a Roman Road Is Uncovered in a Greek City', 'name': None, 'seo': None, 'sub': None}, 'keywords':