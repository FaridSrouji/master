a': [], 'headline': {'main': 'Judi Radin at Trial for World Mind Sports Games', 'kicker': 'Bridge', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Bridge (Card Game)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cards and Card Games', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-06-10T22:24:15+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Crosswords & Games', 'subsection_name': 'Bridge', 'byline': {'original': 'By Phillip Alder', 'person': [{'firstname': 'Phillip', 'middlename': None, 'lastname': 'Alder', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8aa3c450-d49f-56ec-b7b2-8e20be256aee', 'word_count': 342, 'uri': 'nyt://article/8aa3c450-d49f-56ec-b7b2-8e20be256aee'}, {'abstract': '“In Bed With Ulysses” celebrates James Joyce’s “Ulysses” with biographical information, staged readings, period footage and insightful commentators, as well as humor and enthusiasm.', 'web_url': 'https://www.nytimes.com/2012/06/11/movies/review-in-bed-with-ulysses.html', 'snippet': '“In Bed With Ulysses” celebrates James Joyce’s “Ulysses” with biographical information, staged readings, period footage and insightful commentators, as well as humor and enthusiasm.', 'lead_paragraph': 'Bloomsday — June 16, the day of the events in James Joyce’s masterpiece “Ulysses” — approaches and with it the release of Alan Adelson and Kate Taverna’s documentary “In Bed With Ulysses,” a film that strips away the academic clutter surrounding that kaleidoscopic novel to reveal the vital human pulse between its lines. It does so with staged readings of the livelier passages (not, I emphasize, re-creations of them), period footage and insightful commentators (including the Irish novelists Colum McCann and Edna O’Brien), not to mention humor and a palpable enthusiasm.', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Getting to the Heart of a Joycean Masterpiece', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'In Bed With Ulysses', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Joyce, James', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Documentary Films and Programs', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-06-10T22:30:28+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Movies', 'byline': {'original': 'By Andy Webster', 'person': [{'firstname': 'Andy', 'middlename': None, 'lastname': 'Webster', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/76711a04-f84f-553e-802a-6e320aac2bcd', 'word_count': 281, 'uri': 'nyt://article/76711a04-f84f-553e-802a-6e320aac2bcd'}, {'abstract': '“Tahrir: Liberation Square” plunges into the crowds of demonstrators in Cairo in January 2011 during the days leading up to the fall of Hosni Mubarak.', 'web_url': 'https://www.nytimes.com/2012/06/11/movies/tahrir-liberation-square-chronicles-2011-cairo-protests.html', 'snippet': '“Tahrir: Liberation Square” plunges into the crowds of demonstrators in Cairo in January 2011 during the days leading up to the fall of Hosni Mubarak.', 'lead_paragraph': 'Begun in January 2011 amid mass demonstrations in downtown Cairo, “Tahrir: Liberation Square” had its official premiere scarcely six months later at the Locarno Film Festival in Switzerland. That makes it a hot document as far as movies go, recording events with ramifications yet unknown to Egyptians or the rest of the world.', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'typ