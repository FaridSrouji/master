XR/jwanderson_mws13app-slide-9IXR-superJumbo.jpg', 'height': 2048, 'width': 1365, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'J.W. Anderson Men’s', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-06-17T13:46:52+0000', 'document_type': 'multimedia', 'news_desk': 'Fashion & Style', 'section_name': 'Fashion & Style', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/ce669928-5cda-5702-9d10-0057a3a7e664', 'word_count': 0, 'uri': 'nyt://slideshow/ce669928-5cda-5702-9d10-0057a3a7e664'}, {'abstract': 'The upscale Arizona spa is holding weight-loss programs for teenagers and their parents.', 'web_url': 'https://intransit.blogs.nytimes.com/2012/06/17/canyon-ranch-opens-its-doors-to-teenagers/', 'snippet': 'The upscale Arizona spa is holding weight-loss programs for teenagers and their parents.', 'lead_paragraph': 'Canyon Ranch, the upscale spa that usually caters to adults, is dedicating two weeks this summer to a weight-loss program for parents and teenagers 14 to 17 years old. The seven-night program, held at the Tucson spa on July 8 and again starting Aug. 12, offers participants group and individual sessions with a nutritionist who instructs them on how to prepare healthy meals together, and with an exercise physiologist who gives guidance on incorporating fitness into their lives. The program also offers exercise classes and a meeting with a life coach. Every participant goes home with a customized plan and receives nine 50-minute follow-up sessions with his or her choice of specialist.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Canyon Ranch Opens Its Doors to Teenagers', 'kicker': 'In Transit', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Spas', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Canyon Ranch', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'ARIZONA', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-06-17T14:00:58+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Travel', 'byline': {'original': 'By Shivani Vora', 'person': [{'firstname': 'Shivani', 'middlename': None, 'lastname': 'Vora', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ee154107-6179-5d29-9096-be39f55446e6', 'word_count': 151, 'uri': 'nyt://article/ee154107-6179-5d29-9096-be39f55446e6'}, {'abstract': 'Glasses and watches with online capability will certainly complicate the flight attendant’s policing of electronics on takeoff and landing. What then?', 'web_url': 'https://bits.blogs.nytimes.com/2012/06/17/disruptions-wearable-gadgets-upset-f-a-a-curbs-on-devices/', 'snippet': 'Glasses and watches with online capability will certainly complicate the flight attendant’s policing of electronics on takeoff and landing. What then?', 'lead_paragraph': 'Pity the poor flight attendant. They didn’t sign up for this: millions of petulant airline passengers surreptitiously reading digital books and magazines on their iPads or Kindles during takeoff and landing.', 'print_section': 'B', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/17/technology/bits-disruptplane/bits-disruptplane-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/17/technology/bits-disruptplane/bits-disruptplane-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Disruptions: Wearable Gadgets Upset  F.A.A. Curbs on Devices', 'kicker': 'Bits', 'content_kicker': None, 'print_headline': 'Disruptions: Wearable Gadgets to Test F.A.A. Curbs on Devices', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'AIRLINES AND AIRPLANES', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Flight Attendants', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'iPad', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Smartphones', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Wrists', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Federal Aviation Administration', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Jawbone', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Transport Workers Union', 'rank': 9, 'major': 'N'}], 'pub_date': '2012-06-17T15:00:45+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By Nick Bilton', 'person': [{'firstname': 'Nick', 'middlename': None, 'lastname': 'Bilton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3bb30a87-0a34-5fc7-b248-d40095797c27', 'word_count': 585, 'uri': 'nyt://article/3bb30a87-0a34-5fc7-b248-d40095797c27'}, {'abstract': 'Mr. Jenkins, an Abstract Expressionist, was a friend of Mark Rothko and adopted techniques similar to those of Jackson Pollock.', 'web_url': 'https://www.nytimes.com/2012/06/18/arts/design/paul-jenkins-abstract-expressionist-painter-dies-at-88.html', 'snippet': 'Mr. Jenkins, an Abstract Expressionist, was a friend of Mark Rothko and adopted techniques similar to those of Jackson Pollock.', 'lead_paragraph': 'Paul Jenkins, a colorful Abstract Expressionist who came of age during the heyday of the New York School and for several decades carried on its highly physical tradition of manipulating paint and canvas, died on June 9 in Manhattan, where he lived and had continued to paint until recently. He was 88.', 'print_section': 'A', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/18/sports/Jenkins1/Jenkins1-articleLarge.jpg', 'height': 378, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/06/18/sports/Jenkins1/Jenkins1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 378}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/18/sports/Jenkins1/Jenkins1-jumbo.jpg', 'height': 694, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/18/sports/Jenkins1/Jenkins1-superJumbo.jpg', 'height': 1388, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/18/sports/Jenkins1/Jenkins1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/18/sports/Jenkins1/Jenkins1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/18/sports/Jenkins1/Jenkins1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Paul Jenkins, Painter of Abstract Artwork, Dies at 88', 'kicker': None, 'content_kicker': None, 'print_headline': 'Paul Jenkins, Abstract Painter, Dies at 88', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Jenkins, Paul', 'rank': 1, 'major': 'N