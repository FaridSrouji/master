d': 'nyt://article/b5486304-7a3f-5e71-aa80-6546713f249c', 'word_count': 89, 'uri': 'nyt://article/b5486304-7a3f-5e71-aa80-6546713f249c'}, {'abstract': 'Another Memorial Day has come and gone. We had our barbeques and enjoyed the day off, and some of us paid respects to the fallen. But what difference did it make?', 'web_url': 'https://atwar.blogs.nytimes.com/2012/06/18/with-each-passing-memorial-day-what-changes/', 'snippet': 'Another Memorial Day has come and gone. We had our barbeques and enjoyed the day off, and some of us paid respects to the fallen. But what difference did it make?', 'lead_paragraph': 'Another Memorial Day has come and gone. We had our barbeques and enjoyed the day off, and some of us paid respects to the fallen. Now we’re back to the routine of doing what it is that Americans do. As for the war? Out of sight, out of mind.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'With Each Passing Memorial Day, What Changes?', 'kicker': 'At War', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-06-18T16:40:34+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'byline': {'original': 'By JEFF HENSLEY', 'person': [{'firstname': 'Jeff', 'middlename': None, 'lastname': 'HENSLEY', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0461f9d8-9b95-5b7a-a800-132e5feea7de', 'word_count': 945, 'uri': 'nyt://article/0461f9d8-9b95-5b7a-a800-132e5feea7de'}, {'abstract': 'A shirt switch on a Subaru ad, and a nostalgic song about Cape Cod.', 'web_url': 'https://www.nytimes.com/2012/06/18/business/media/q-and-a-with-stuart-elliott.html', 'snippet': 'A shirt switch on a Subaru ad, and a nostalgic song about Cape Cod.', 'lead_paragraph': 'Stuart Elliott, the advertising columnist, answers questions from readers each week. Questions can be sent to stuarte@nytimes.com.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Q. and A. With Stuart Elliott', 'kicker': None, 'content_kicker': None, 'print_headline': 'Q and A With Stuart Elliott', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-06-18T16:46:12+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Question', '_id': 'nyt://article/fbb0cbf2-8965-5466-9402-6f65fb000abf', 'word_count': 525, 'uri': 'nyt://article/fbb0cbf2-8965-5466-9402-6f65fb000abf'}, {'abstract': 'Mary Cadwallader joined the Washington office of TPM Media, the publisher of Talking Points Memo, as vice president for advertising sales.', 'web_url': 'https://www.nytimes.com/2012/06/18/business/media/accounts-and-people-of-note-in-the-advertising-industry.html', 'snippet': 'Mary Cadwallader joined the Washington office of TPM Media, the publisher of Talking Points Memo, as vice president for advertising sales.', 'lead_paragraph': 'Mary Cadwallader joined the Washington office of TPM Media, the publisher of Talking Points Memo, as vice president for advertising sales. She succeeds Waldo Tibbets, who left, the company said, to pursue other professional interests. Ms. Cadwallader had most recently been national sales manager at The Hill, Washington, part of News Communications.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Accounts and People of Note in the Advertising Industry', 'kicker': None, 'content_kicker': None, 'print_headline': 'Webdenda', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-06-18T16:48:24+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name':