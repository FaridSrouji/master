': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Beauty', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Height (Stature)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'AMERICAN ECONOMIC ASSN', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-06-04T22:11:00+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Motoko Rich', 'person': [{'firstname': 'Motoko', 'middlename': None, 'lastname': 'Rich', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ed3224ba-0630-5527-9256-62b96f727559', 'word_count': 368, 'uri': 'nyt://article/ed3224ba-0630-5527-9256-62b96f727559'}, {'abstract': 'A look at a geometrically complex arcade canopy by Preston Scott Cohen, an effective use of public space in Lower Manhattan that connects the Goldman Sachs headquarters to a shopping arcade and hotel.', 'web_url': 'https://www.nytimes.com/2012/06/05/arts/design/architectural-canopy-shines-in-battery-park-city.html', 'snippet': 'A look at a geometrically complex arcade canopy by Preston Scott Cohen, an effective use of public space in Lower Manhattan that connects the Goldman Sachs headquarters to a shopping arcade and hotel.', 'lead_paragraph': 'One of the best new works of architecture in New York isn’t a flashy skyscraper or museum but a fairly modest structure, an angular glass canopy over an obscure but busy pedestrian street called North End Way, in the shadow of One World Trade Center no less. ', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/05/arts/canopy/canopy-jumbo.jpg', 'height': 1024, 'width': 659, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', '