ge', 'url': 'images/2012/06/11/us/politics/11bush/11bush-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Jeb Bush Questions G.O.P.’s Shift to the Right', 'kicker': None, 'content_kicker': None, 'print_headline': 'Jeb Bush Offers Critical Views of Modern Republican Party and Its ‘Orthodoxy’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Bush, Jeb', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Reagan, Ronald Wilson', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-06-11T16:30:30+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Jim Rutenberg', 'person': [{'firstname': 'Jim', 'middlename': None, 'lastname': 'Rutenberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/04883733-fb1a-5d7d-9995-90550e3aa760', 'word_count': 995, 'uri': 'nyt://article/04883733-fb1a-5d7d-9995-90550e3aa760'}, {'abstract': 'David R. Locke, a.k.a. Petroleum Vesuvius Nasby, was the most acerbic, most famous comedian of the 1860s.', 'web_url': 'https://opinionator.blogs.nytimes.com/2012/06/11/the-stephen-colbert-of-the-civil-war-2/', 'snippet': 'David R. Locke, a.k.a. Petroleum Vesuvius Nasby, was the most acerbic, most famous comedian of the 1860s.', 'lead_paragraph': '“A nickel-plated son of a bitch.” That was how David R. Locke, an Ohio newspaperman and the most daring comedian of the Civil War, described his alter-ego: Petroleum Vesuvius Nasby. Locke’s persona made him the most influential humorist of the era. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Stephen Colbert of the Civil War', 'kicker': 'Disunion', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Civil War (US) (1861-65)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Comedy and Humor', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Lincoln, Abraham', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Twain, Mark', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-06-11T16:32:10+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Jon Grinspan', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Grinspan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a77b5aad-5e10-5725-b1dc-b992424b58bf', 'word_count': 1273, 'uri': 'nyt://article/a77b5aad-5e10-5725-b1dc-b992424b58bf'}, {'abstract': 'The technology needed to arrest global warming is there, but the world is not harnessing it, the International Energy Agency says.', 'web_url': 'https://green.blogs.nytimes.com/2012/06/11/on-not-reaching-carbon-goals/', 'snippet': 'The technology needed to arrest global warming is there, but the world is not harnessing it, the International Energy Agency says.', 'lead_paragraph': 'Reducing carbon dioxide emissions by enough to prevent global temperatures from rising more than 2 degrees Celsius (3.6 degrees Fahrenheit) is “still within reach,’’ the International Energy Agency reported on Monday, but at the moment, trends in energy use are running in the wrong direction.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'On Not Reaching Carbon Goals', 'kicker': 'Green', 'content_kicker': None, 'print_headline': '', 'name'