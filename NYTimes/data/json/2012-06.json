', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/07/01/arts/01VERA2_SPAN/01VERA2_SPAN-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/07/01/arts/01VERA2_SPAN/01VERA2_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/07/01/arts/01VERA2_SPAN/01VERA2-jumbo.jpg', 'height': 766, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/07/01/arts/01VERA2_SPAN/01VERA2-superJumbo.jpg', 'height': 1532, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/07/01/arts/01VERA2_SPAN/01VERA2_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/07/01/arts/01VERA2_SPAN/01VERA2_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/07/01/arts/01VERA2_SPAN/01VERA2_SPAN-thumbLarge.jpg', 'height': 112, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'An Audience for Free Spirits in a Closed Society', 'kicker': None, 'content_kicker': None, 'print_headline': 'An Audience For Free Spirits In a Closed Society', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'Daisies (Movie)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Brooklyn Academy of Music', 'rank': 2, 'major': 'N'}, {'name': 'subject', '