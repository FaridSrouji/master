': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/27/world/africa/27safrica/27safrica-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/06/27/world/africa/27safrica/27safrica-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/27/world/africa/27safrica/27safrica-jumbo.jpg', 'height': 636, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/27/world/africa/27safrica/27safrica-superJumbo.jpg', 'height': 1273, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/27/world/africa/27safrica/27safrica-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/27/world/africa/27safrica/27safrica-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/27/world/africa/27safrica/27safrica-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A.N.C., Admitting Failures, Weighs How to Lift South Africans', 'kicker': None, 'content_kicker': None, 'print_headline': 'A.N.C., Admitting Failures, Weighs How to Lift South Africans', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'South Africa', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'AFRICAN NATIONAL CONGRESS', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 3, 'major': 'N'}, {'name'