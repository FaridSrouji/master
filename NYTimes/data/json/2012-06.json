section_name': 'New York', 'byline': {'original': 'By Michael Powell', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Powell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bd443ac3-8e19-51ba-9902-0d076a023fc1', 'word_count': 1155, 'uri': 'nyt://article/bd443ac3-8e19-51ba-9902-0d076a023fc1'}, {'abstract': 'The total number of viewers dropped and the broadcast had its lowest rating ever in the 18-to-49-year-old group coveted by advertisers.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/06/11/if-tony-broadcast-were-a-broadway-show-it-might-close/', 'snippet': 'The total number of viewers dropped and the broadcast had its lowest rating ever in the 18-to-49-year-old group coveted by advertisers.', 'lead_paragraph': 'The combined lack of blockbuster buzz and star power hurt CBS’s broadcast of the 66th-annual Tony Awards on Sunday night, as it fell to record-low television ratings. According to preliminary Nielsen estimates the telecast finished with its lowest rating ever in the 18-to-49-year-old group, the category most important to advertisers, a 17 percent drop-off from last year. It was also down in total viewers, to around 6 million from almost 7 million last year.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'If Tony Broadcast Were a Broadway Show, It Might Close', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Tony Awards (Theater Awards)', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'AMERICAN THEATER WING', 'rank': 5, 'major': 'N'}, {'name': 'organizations', '