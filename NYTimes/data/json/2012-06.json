o', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/24/business/24-INSIDE/24-INSIDE-superJumbo.jpg', 'height': 1928, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/24/business/24-INSIDE/24-INSIDE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/24/business/24-INSIDE/24-INSIDE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/24/business/24-INSIDE/24-INSIDE-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'E-Tailer Customization: Convenient or Creepy?', 'kicker': 'Slipstream', 'content_kicker': None, 'print_headline': 'E-Tailer Customization: Convenient or Creepy?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Godiva Chocolatier Inc', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Customer Relations', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Monetate Inc', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'E-Commerce', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Patagonia Inc', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-06-23T21:41:01+0000', 'document_type': 'article', 'news_desk': 'SundayBusiness', 'section_name': 'Technology', 'byline': {'original': 'By Natasha Singer', 'person': [{'firstname': 'Natasha', 'middlename': None, 'lastname': 'Singer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3895fe92-fc63-521b-b770-1c657c858e57', 'word_count': 1131, 'uri': 'nyt://article/3895fe92-fc63-521b-b770-1c657c858e57'}, {'abstract': 'Stefan Matteau was drafted by the Devils, the team his father, a former Ranger, beat with an overtime goal in 1994. But Stephane Matteau said he has embraced the move.', 'web_url': 'https://slapshot.blogs.nytimes.com/2012/06/23/a-happy-ending-for-the-matteaus-at-the-n-h-l-draft/', 'snippet': 'Stefan Matteau was drafted by the Devils, the team his father, a former Ranger, beat with an overtime goal in 1994. But Stephane Matteau said he has embraced the move.', 'lead_paragraph': 'PITTSBURGH — The biggest eyebrow-raiser of the N.H.L. entry draft here this weekend was the Devils choosing Stefan Matteau with the 29th pick Friday night after the Rangers had passed on him at No. 28. Matteau was amusing in his comments to reporters, wryly asserting that “I’m in shock myself” about going to the Devils, the team his father beat with a Game 7 overtime goal at Madison Square Garden in 1994. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Happy Ending for the Matteaus', 'kicker': 'Slap Shot', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Hockey, Ice', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Matteau, Stefan', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New Jersey Devils', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-06-23T21:43:11+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Hockey', 'byline': {'original': 'By Jeff Z. Klein', 'person': [{'firstname': 'Jeff', 'middlename': 'Z.', 'lastname': 'Klein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/069325c0-ac7f-57fd-91df-0063e73d1a2f', 'word_count': 224, 'uri': 'nyt://article/069325c0-ac7f-57fd-91df-0063e73d1a2f'}, {'abstract': 'Newly discovered Kodachrome color photographs from a Japanese American Internment Camp in Wyoming, 1943-44.', 'web_url': 'https://www.nytimes.com/slideshow/2012/06/24/sunday-review/24CAMP.html', 'snippet': 'Newly discovered Kodachrome color photographs from a Japanese American Internment Camp in Wyoming, 1943-44.', 'lead_paragraph': 'Newly discovered Kodachrome color photographs from a Japanese American Internment Camp in Wyoming, 1943-44.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/24/sunday-review/24CAMP-slide-4HY8/24CAMP-slide-4HY8-jumbo.jpg', 'height': 636, 'width': 924, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/24/sunday-review/24CAMP-slide-4HY8/24CAMP-slide-4HY8-superJumbo.jpg', 'height': 636, 'width': 924, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/24/sunday-review/24CAMP-slide-4HY8/24CAMP-slide-4HY8-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/24/sunday-review/24CAMP-slide-4HY8/24CAMP-slide-4HY8-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/24/sunday-review/24CAMP-slide-4HY8/24CAMP-slide-4HY8-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Colors of Confinement', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Japanese-Americans', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Pearl Harbor (Hawaii)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Wyoming', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-06-23T21:47:29+0000', 'document_type': 'multimedia', 'news_desk': 'Sunday Review', 'section_name': 'Sunday Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/62ac5513-00ec-5498-a8c8-e73cf3dca184', 'word_count': 0, 'uri': 'nyt://slideshow/62ac5513-00ec-5498-a8c8-e73cf3dca184'}, {'abstract': 'Using Kodachrome film, Bill Manbo captured images from Heart Mountain in Wyoming, a detention camp for people of Japanese ancestry.', 'web_url': 'https://www.nytimes.com/2012/06/24/opinion/sunday/bill-manbos-images-of-japanese-americans-in-detention.html', 'snippet': 'Using Kodachrome film, Bill Manbo captured images from Heart Mountain in Wyoming, a detention camp for people of Japanese ancestry.', 'lead_paragraph': 'On Feb. 19, 1942, two months after Japan’s attack on Pearl Harbor, President Franklin D. Roosevelt signed an executive order that the United States military used to remove every person of Japanese ancestry from the West Coast. Among the 120,000 people rounded up — two-thirds of them citizens — was Bill Manbo, an auto mechanic from Riverside, Calif., who dabbled in photography and model airplanes. He and his wife, Mary; their baby son, Billy; and her mother and younger siblings were detained at a racetrack near Los Angeles. (Mary’s father, who had been interned as an “enemy alien,” soon joined them after he was determined not to be a threat.) ', 'print_section': 'SR', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/24/sunday-review/24CAMP-slide-4HY8/24CAMP-slide-4HY8-jumbo.jpg', 'height': 636, 'width': 924, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image'