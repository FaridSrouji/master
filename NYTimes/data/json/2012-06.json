ame': None, 'lastname': 'Goode', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9fc2abdf-2504-5b37-ba58-b0c306e4a715', 'word_count': 1166, 'uri': 'nyt://article/9fc2abdf-2504-5b37-ba58-b0c306e4a715'}, {'abstract': 'The Olympic Club’s Lake Course can be tight and treacherous to navigate, which, Bubba Watson said, will make par at this week’s United States Open a good score.', 'web_url': 'https://onpar.blogs.nytimes.com/2012/06/12/after-eyeing-course-watson-ready-for-a-challenging-open/', 'snippet': 'The Olympic Club’s Lake Course can be tight and treacherous to navigate, which, Bubba Watson said, will make par at this week’s United States Open a good score.', 'lead_paragraph': 'SAN FRANCISCO — The fairways of the Olympic Club’s Lake Course are like Lombard Street, another of this city’s landmarks: tight and treacherous to navigate. If Bubba Watson, the reigning Masters champion, is going to add the second leg of the Grand Slam at the week’s United States Open, he is going to have to drive the ball straight. Is Watson, who is 99th on the tour in driving accuracy, up to the task?', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'After Eyeing Course, Watson Ready for a Challenging Open', 'kicker': 'On Par', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Open (Golf)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Watson, Bubba', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Olympic Club (San Francisco, Calif)', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-06-13T01:21:15+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Golf', 'byline': {'original': 'By Karen Crouse', 'person': [{'firstname': 'Karen', 'middlename': None, 'lastname': 'Crouse', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c735caf5-12da-5b93-badc-fd9d2f6b4c66', 'word_count': 474, 'uri': 'nyt://article/c735caf5-12da-5b93-badc-fd9d2f6b4c66'}, {'abstract': 'Organizers and the city quietly prepare for what may be a massive showing during a Father’s Day celebration against the Police Department’s stop-and-frisk practice.', 'web_url': 'https://www.nytimes.com/2012/06/13/nyregion/silently-a-fathers-day-parade-may-turn-into-a-protest.html', 'snippet': 'Organizers and the city quietly prepare for what may be a massive showing during a Father’s Day celebration against the Police Department’s stop-and-frisk practice.', 'lead_paragraph': 'A fleet of portable toilets has been booked, and they will be docked along 110th Street, at the north end of Central Park, where people will be mustering on Sunday afternoon. So far, at least 35 buses are expected. The subways will most likely carry the bulk of the crowd. A group of religious leaders from all five boroughs plan to meet on Wednesday to discuss the logistics of bringing their congregations. Training will be provided Thursday night for marshals who could not make a session that was held on Tuesday.', 'print_section': 'A', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Protesting Police Tactic, in Silence', 'kicker': 'About New York', 'content_kicker': None, 'print_headline': 'Protesting Police Tactic, In Silence', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Bloomberg, Michael R', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Search and Seizure', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Demonstrations, Protests, and Riots', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Parades', 'rank': 5, 'major': 'N'}, {'name': 'organizations