idth': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/05/arts/jpnewmusic3/jpnewmusic3-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/05/arts/jpnewmusic3/jpnewmusic3-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Another Solstice in an Endless Summer', 'kicker': 'New Music', 'content_kicker': None, 'print_headline': 'Another Solstice in an Endless Summer', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Jackson, Alan', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Ulver (Music Group)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Byrds, The', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Beach Boys', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-06-04T22:18:45+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Jon Pareles, Nate Chinen and Ben Ratliff', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Pareles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Nate', 'middlename': None, 'lastname': 'Chinen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}, {'firstname': 'Ben', 'middlename': None, 'lastname': 'Ratliff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 3}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/57096ad3-fa59-5251-a42e-5a749bd360c9', 'word_count': 1461, 'uri': 'nyt://article/57096ad3-fa59-5251-a42e-5a749bd360c9'}, {'abstract': 'A short Baroque work written as a cautionary tale to uppity women becomes a showcase for female independence in Musica Nuova’s production of Monteverdi’s “Ballo Delle Ingrate.”', 'web_url': 'https://www.nytimes.com/2012/06/05/arts/music/monteverdis-ballo-delle-ingrate-with-a-different-spin.html', 'snippet': 'A short Baroque work written as a cautionary tale to uppity women becomes a showcase for female independence in Musica Nuova’s production of Monteverdi’s “Ballo Delle Ingrate.”', 'lead_paragraph': 'Monteverdi’s “Ballo Delle Ingrate” (“Dance of the Ungrateful Women”) offers an objectionable prefeminist moral: women should submit to male desire or face eternal damnation. The pasticcio version by Musica Nuova ends with a satirical twist. After being threatened with exile to a convent, the female protagonist voluntarily becomes a nun to escape her suitor.', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Teaching the Men a Lesson', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Teaching the Men a Lesson', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Opera', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Monteverdi, Claudio', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Musica Nuova (Music Group)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-06-04T22:21:28+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Vivien Schweitzer', 'person': [{'firstname': 'Vivien', 'middlename': None, 'lastname': 'Schweitzer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/417375f8-80c0-5be3-bedc-514f281d584d', 'word_count': 397, 'uri': 'nyt://article/417375f8-80c0