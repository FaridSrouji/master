bject', 'value': 'Barbecue', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New Jersey', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-06-29T23:05:13+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Tammy La Gorce', 'person': [{'firstname': 'Tammy', 'middlename': None, 'lastname': 'La Gorce', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e7f98688-f602-5ae3-a5b8-5a3718848b32', 'word_count': 1278, 'uri': 'nyt://article/e7f98688-f602-5ae3-a5b8-5a3718848b32'}, {'abstract': 'The four boys admitted wrongdoing and agreed to one-year suspensions from their middle school for bullying their school bus monitor, Karen Klein.', 'web_url': 'https://thelede.blogs.nytimes.com/2012/06/29/students-suspended-for-verbally-abusing-school-bus-monitor/', 'snippet': 'The four boys admitted wrongdoing and agreed to one-year suspensions from their middle school for bullying their school bus monitor, Karen Klein.', 'lead_paragraph': 'The four boys who taunted a 68-year-old school bus monitor from Rochester, N.Y., prompting outcry over bullying when a video of their insults went viral, have been suspended from their middle school for one year, school officials said on Friday.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Students Are Suspended for Verbally Abusing School Bus Monitor', 'kicker': 'The Lede', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Bullies', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'School Discipline (Students)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Klein, Karen H', 'rank': 4, 'major':