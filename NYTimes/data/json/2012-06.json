ON/LIMON-articleLarge.jpg', 'height': 395, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/06/21/arts/LIMON/LIMON-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 395}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/21/arts/LIMON/LIMON-jumbo.jpg', 'height': 689, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/21/arts/LIMON/LIMON-superJumbo.jpg', 'height': 1378, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/21/arts/LIMON/LIMON-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/21/arts/LIMON/LIMON-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/21/arts/LIMON/LIMON-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Pleasure of Performers Transcending Their Material', 'kicker': 'Dance Review', 'content_kicker': None, 'print_headline': 'The Pleasure of Performers Transcending Their Material', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Limon Dance Co', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Limon, Jose', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Pederneiras, Rodrigo', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Dancing', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Joyce Theater', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-06-20T21:39:31+0000', 'document_type': 'article', 'new