t_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/22/business/NBC-1/NBC-1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/22/business/NBC-1/NBC-1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/22/business/NBC-1/NBC-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/22/business/NBC-1/NBC-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/22/business/NBC-1/NBC-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'NBC News Faces Shift in Television Dominance', 'kicker': None, 'content_kicker': None, 'print_headline': 'NBC News Faces Shift In Television Dominance', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'NBC Nightly News (TV Program)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'NBC News', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'ABC INC', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Ratings (Audience Measurement)', 'rank': 6, 'major': 'N'}, {'name': 'creative_works', 'value': 'Meet the Press (TV Program)', 'rank': 7, 'major': 'N'}, {'name': 'creative_works', 'value': 'Today (TV Program)', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'News and News Media', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'CBS Corporation', 'rank': 10, 'major': 'N'}], 'pub_date': '2012-06-22T01:28:49+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Bill Carter and Brian Stelter', 'person': [{'firstname': 'Bill', 'middlename': None, 'lastname': 'Carter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Brian', 'middlename': None, 'lastname': 'Stelter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4e91cc9c-49fb-596c-a6d4-aeb2ec5cec04', 'word_count': 938, 'uri': 'nyt://article/4e91cc9c-49fb-596c-a6d4-aeb2ec5cec04'}, {'abstract': 'In ruling that the F.C.C. was wrong to conclude that Fox and ABC had violated indecency standards, the Supreme Court gives notice that the commission should rewrite its policy.', 'web_url': 'https://www.nytimes.com/2012/06/22/opinion/void-for-vagueness.html', 'snippet': 'In ruling that the F.C.C. was wrong to conclude that Fox and ABC had violated indecency standards, the Supreme Court gives notice that the commission should rewrite its policy.', 'lead_paragraph': 'It is not so common these days to see a near-unanimous Supreme Court ruling on an issue like regulation of the airwaves, but the justices issued such an opinion on Thursday that sensibly said federal authorities were wrong to conclude that Fox Television and ABC had violated indecency standards for a couple of fleeting expletives and seven seconds of partial nudity.', 'print_section': 'A', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Void for Vagueness', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Void for Vagueness', 'name