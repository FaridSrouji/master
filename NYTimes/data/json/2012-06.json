thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/13/dining/13KITCH1_SPAN/13KITCH1_SPAN-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'As Summer Nears, Cold Noodles to Chill With', 'kicker': 'City Kitchen', 'content_kicker': None, 'print_headline': 'As Summer Nears, Cold Noodles to Chill With', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Noodles', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Chickens', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-06-08T20:36:08+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By David Tanis', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Tanis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/67f6e708-ab4e-5248-9bd9-e45019ac3f9f', 'word_count': 375, 'uri': 'nyt://article/67f6e708-ab4e-5248-9bd9-e45019ac3f9f'}, {'abstract': 'The JX35 misses most of its marks. Its bland performance makes the Acura MDX and Lexus RX feel like sport sedans by comparison. And its undisciplined design is a riot of swoops and lines that go everywhere and nowhere.', 'web_url': 'https://www.nytimes.com/2012/06/10/automobiles/autoreviews/even-with-all-those-seats-the-driver-is-left-out.html', 'snippet': 'The JX35 misses most of its marks. Its bland performance makes the Acura MDX and Lexus RX feel like sport sedans by comparison. And its undisciplined design is a riot of swoops and lines that go everywhere and nowhere.', 'lead_paragraph': 'INFINITI’S advertising tagline is “Inspired Performance.” And the mission statement of the Nissan luxury brand has long been clear: performance means taking whacks at BMW, and inspiration typically means undercutting BMW’s prices, especially with the estimable G sedan and coupe. ', 'print_section': 'AU', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/10/automobiles/10WHEE/10WHEE-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/06/10/automobiles/10WHEE/10WHEE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/10/automobiles/10WHEE/10WHEE-jumbo.jpg', 'height': 546, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/10/automobiles/10WHEE/10WHEE-superJumbo.jpg', 'height': 1092, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/10/automobiles/10WHEE/10WHEE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/10/automobiles/10WHEE/10WHEE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/10/automobiles/10WHEE/10WHEE-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Even With All Those Seats, the Driver Is Left Out', 'kicker': 'Behind the Wheel | 2013 Infiniti JX35', 'content_kicker': None, 'print_headline': 'Even With All Those Seats, the Driver Is Left Out', 'name': None, 'seo': None, 'sub': None}, 'key