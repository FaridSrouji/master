ne': {'main': 'Leading Off: Momentum Change or Blip?', 'kicker': 'Off the Dribble', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Basketball', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Oklahoma City Thunder', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'San Antonio Spurs', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-06-01T13:44:38+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Pro Basketball', 'byline': {'original': 'By Lynn Zinser', 'person': [{'firstname': 'Lynn', 'middlename': None, 'lastname': 'Zinser', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/64a80049-6160-5dae-aaba-192ad5d536a9', 'word_count': 769, 'uri': 'nyt://article/64a80049-6160-5dae-aaba-192ad5d536a9'}, {'abstract': 'A collection of links from the reporters and editors of the Dining section.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2012/06/01/what-were-reading-448/', 'snippet': 'A collection of links from the reporters and editors of the Dining section.', 'lead_paragraph': 'Julia Child 100: August 15, 2012, would have been Julia Child’s 100th birthday and her publisher is whipping up a nationwide foodie frenzy to mark the occasion. — Julia Moskin', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What We’re Reading', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-06-01T13:55:36+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/87a42cff-816e-5f57-b801-21ffd229cfe0', 'word_count': 347, 'uri': 'nyt://article/87a42cff-816e-5f57-b801-21ffd229cfe0'}, {'abstract': 'A fan (and director) of spaghetti westerns wistfully remembers a youthful summer full of them and reflects on why he loves the genre.', 'web_url': 'https://www.nytimes.com/2012/06/03/movies/a-spaghetti-western-roundup-at-film-forum.html', 'snippet': 'A fan (and director) of spaghetti westerns wistfully remembers a youthful summer full of them and reflects on why he loves the genre.', 'lead_paragraph': 'WHEN film critics and historians refer to the spaghetti western, they tend to mean four films directed by Sergio Leone: his “Dollars” trilogy with Clint Eastwood, and his epic, “Once Upon a Time in the West.” This focus on Leone’s work is understandable: he was a great filmmaker who made Mr. Eastwood a star. And it also acknowledges Akira Kurosawa, the form’s spiritual godfather, whose film “Yojimbo” inspired Leone and his colleagues to see westerns as cynical samurai films. But the spotlight on one director has tended to obscure the rest of the Italian western subgenre, which may include as many as 500 films. (A tiny fraction will be on display this month in a series at Film Forum in the South Village.)', 'print_section': 'AR', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/03/arts/03WESTERNS1_SPAN/03WESTERNS1_SPAN-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/06/03/arts/03WESTERNS1_SPAN/03WESTERNS1_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/03/arts/03WESTERNS1_SPAN/03WESTERNS1_SPAN-jumbo.jpg', 'height': 612, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/03/arts/03WESTERNS1_SPAN/03WESTERNS1_SPAN-superJumbo.jpg', 'height': 1224, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/03/arts/03WESTERNS1_SPAN/03WESTERNS1_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/03/arts/03WESTERNS1_SPAN/03WESTERNS1_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/03/arts/03WESTERNS1_SPAN/03WESTERNS1_SPAN-thumbLarge.jpg', 'height': 90, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Once Upon a Time in Italy', 'kicker': None, 'content_kicker': None, 'print_headline': 'Once Upon a Time in Italy', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Leone, Sergio', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Django (Movie)', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'Once Upon a Time in the West (Movie)', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'Navajo Joe (Movie)', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'For a Few Dollars More (Movie)', 'rank': 5, 'major': 'N'}, {'name': 'creative_works', 'value': 'Django Unchained (Movie)', 'rank': 6, 'major': 'N'}, {'name': 'creative_works', 'value': 'Straight to Hell (Movie)', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 8, 'major': 'N'}], 'pub_date': '2012-06-01T14:00:01+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Movies', 'byline': {'original': 'By Alex Cox', 'person': [{'firstname': 'Alex', 'middlename': None, 'lastname': 'Cox', 'qualifier': None, 'title': None, 'role': 'reported', 'organ