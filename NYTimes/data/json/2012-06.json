a4c-7ed5-5c5c-92a7-fa98b69ba195', 'word_count': 796, 'uri': 'nyt://article/bc576a4c-7ed5-5c5c-92a7-fa98b69ba195'}, {'abstract': 'The talk is about how Allyson Felix and Jeneba Tarmoh will break their third-place tie from the 100 meters at the track and field trials, but the victory was Carmelita Jeter’s.', 'web_url': 'https://london2012.blogs.nytimes.com/2012/06/25/no-drama-for-jeter-just-victory/', 'snippet': 'The talk is about how Allyson Felix and Jeneba Tarmoh will break their third-place tie from the 100 meters at the track and field trials, but the victory was Carmelita Jeter’s.', 'lead_paragraph': 'EUGENE, Ore. — All Carmelita Jeter has done is win, win, win — including in the 100-meter finals at the United States Olympic track and field trials on Saturday. Yet all anyone wants to talk about is how Allyson Felix and Jeneba Tarmoh will break their third-place tie in the event.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'No Drama for Jeter, Just Victory', 'kicker': '2012 London Olympics', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-06-26T00:29:24+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Olympics', 'byline': {'original': 'By Ken Belson', 'person': [{'firstname': 'Ken', 'middlename': None, 'lastname': 'Belson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bbbbcb78-587c-545a-aa11-14914decabe8', 'word_count': 359, 'uri': 'nyt://article/bbbbcb78-587c-545a-aa11-14914decabe8'}, {'abstract': 'A federal court moved the state’s Congressional primary to Tuesday, creating a campaign season that defied the usual rhythms.', 'web_url': 'https://www.nytimes.com/2012/06/26/nyregion/early-congressional-primaries-in-new-york-tuesday.html', 'snippet': 'A federal court moved the state’s Congressional primary to Tuesday, creating a campaign season that defied the usual rhythms.', 'lead_paragraph': 'Campaign volunteers fueled their cars to ferry voters to the polls. Labor unions deployed teachers, tradesmen and firefighters to make phone calls. Candidates buttonholed prospective voters at subway stops.', 'print_section': 'A', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/26/nyregion/NYPRIMARY/NYPRIMARY-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/06/26/nyregion/NYPRIMARY/NYPRIMARY-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/26/nyregion/NYPRIMARY/NYPRIMARY-jumbo.jpg', 'height': 659, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/26/nyregion/NYPRIMARY/NYPRIMARY-superJumbo.jpg', 'height': 1318, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/26/nyregion/NYPRIMARY/NYPRIMARY-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/26/nyregion/NYPRIMARY/NYPRIMARY-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/26/nyregion/NYPRIMARY/NYPRIMARY-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'For New York’s Early Congressional Primaries, a Desperate Push for Turnout', 'kicker': None