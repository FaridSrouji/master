 None}, 'type_of_material': 'News', '_id': 'nyt://article/9a6f2b0d-a19a-5429-9a8b-19e86e82d18e', 'word_count': 174, 'uri': 'nyt://article/9a6f2b0d-a19a-5429-9a8b-19e86e82d18e'}, {'abstract': 'The New York Times spotlights a decade of war photojournalism at Photoville, an immersive photo exhibition opening today in Brooklyn Bridge Park.', 'web_url': 'https://lens.blogs.nytimes.com/2012/06/22/exhibiting-a-decade-of-war/', 'snippet': 'The New York Times spotlights a decade of war photojournalism at Photoville, an immersive photo exhibition opening today in Brooklyn Bridge Park.', 'lead_paragraph': 'Tyler Hicks traveled with Northern Alliance troops as they captured Kabul, Afghanistan, from the Taliban, in November 2001. Joao Silva photographed the Mahdi Army in Najaf, in 2004, as they fought street by street against the United States military. Michael Kamber returned to Iraq in December 2011 as the United States began removing its last combat troops.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Bringing Photographs of War to the Brooklyn Waterfront', 'kicker': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Afghanistan War (2001- )', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Iraq War (2003-11)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'ADDARIO, LYNSEY', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Crowley, Stephen', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Hicks, Tyler', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Hill, James', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Kamber, Michael', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Lee, Chang W', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Saman, Moises', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Silva, Joao', 'rank':