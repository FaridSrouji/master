ank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'AIRLINES AND AIRPLANES', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'US Airways Group Inc', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Delta Air Lines, Inc', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-06-08T18:12:06+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Michelle Higgins', 'person': [{'firstname': 'Michelle', 'middlename': None, 'lastname': 'Higgins', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bc7bf3c0-590d-57fa-9e61-743b33999c50', 'word_count': 969, 'uri': 'nyt://article/bc7bf3c0-590d-57fa-9e61-743b33999c50'}, {'abstract': 'How much do you know about frequent flier programs? Test your knowledge.', 'web_url': 'https://www.nytimes.com/2012/06/10/travel/how-much-do-you-know-about-frequent-flier-programs.html', 'snippet': 'How much do you know about frequent flier programs? Test your knowledge.', 'lead_paragraph': 'Not an elite flier? You’re in the vast majority. Globally, only about 4.2 million out of some 320 million frequent fliers are elite, according to Randy Petersen, founder of frequent-flier Web sites like FlyerTalk.com and MilePoint.com; most of us are just hoarding miles in hopes of one day swapping them for a coach ticket. The multibillion-dollar airline-loyalty industry has been around for more than 30 years. How much do you know about it?', 'print_section': 'TR', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'No Extra Points for This Quiz', 'kicker': None, 'content_kicker': None, 'print_headline': 'No Extra Points For This Quiz', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'AIRLINES AND AIRPLANES', 'rank': 2, 'major': 'N