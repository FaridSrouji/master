umbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '2 Legislators on Tough Turf Try Delicate Run Down the Middle', 'kicker': None, 'content_kicker': None, 'print_headline': '2 Congressmen on Tough Turf Are Trying a Delicate Run Down the Middle', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Illinois', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Utah', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Dold, Robert', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Matheson, Jim', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Elections, House of Representatives', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-06-19T01:00:57+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Jennifer Steinhauer', 'person': [{'firstname': 'Jennifer', 'middlename': None, 'lastname': 'Steinhauer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1f774c60-cc12-56c3-ae5b-1a8f39148b24', 'word_count': 1076, 'uri': 'nyt://article/1f774c60-cc12-56c3-ae5b-1a8f39148b24'}, {'abstract': 'The former boxer Mike Tyson has added another first to his résumé: a one-man Broadway show, “Mike Tyson: Undisputed Truth,” directed by Spike Lee.', 'web_url': 'https://www.nytimes.com/2012/06/19/theater/mike-tyson-comes-to-broadway-from-the-boxing-ring.html', 'snippet': 'The former boxer Mike Tyson has added another first to his résumé: a one-man Broadway show, “Mike Tyson: Undisputed Truth,” directed by Spike Lee.', 'lead_paragraph': 'There are not an awful lot of firsts left for Mike Tyson. Fights, world records, championships, prison, prostitutes, drugs, Hollywood blockbusters, pigeons: all checked off. But a little before 3 p.m. on Monday, on a spotlighted West 48th Street stage, Mr. Tyson marked one more milestone, as he answered a question from a reporter from Playbill magazine. ', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/19/nyregion/TYSON/TYSON-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/19/nyregion/TYSON/TYSON-superJumbo.jpg', 'height': 1346, 'width': 2020, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/19/nyregion/TYSON/TYSON-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/19/nyregion/TYSON/TYSON-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/19/nyregion/TYSON/TYSON-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'For Tyson, a ‘Vulnerable’ Performance Outside the Ring', 'kicker': None, 'content_kicker': None, 'print_headline': 'For Tyson, a ‘Vulnerable’ Performance Outside the Ring', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Tyson, Mike', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Lee, Spike', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-06-19T