1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/82503a9f-9c6d-5218-b284-ce32bea2c452', 'word_count': 917, 'uri': 'nyt://article/82503a9f-9c6d-5218-b284-ce32bea2c452'}, {'abstract': 'Ariha Setalvad, a native of Mumbai studying at New York University, writes that her dreams of unlimited freedom were brought to earth by the realization that “real life isn’t set to music.”', 'web_url': 'https://thechoice.blogs.nytimes.com/2012/06/18/the-heady-rush-of-freedom-in-college-and-how-to-manage-it/', 'snippet': 'Ariha Setalvad, a native of Mumbai studying at New York University, writes that her dreams of unlimited freedom were brought to earth by the realization that “real life isn’t set to music.”', 'lead_paragraph': 'For many graduating seniors, going to college this fall means that “they will no longer need to devise ways to sneak out of the house at 2 a.m.,” writes Ariha Setalvad, a student at New York University.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The ‘Heady Rush’ of Freedom in College, and How to Manage It', 'kicker': 'The Choice', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ADMISSIONS STANDARDS', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Colleges and Universities', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Foreign Students (in US)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'India', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-06-18T17:03:25+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'byline': {'original': 'By Tanya Caldwell', 'person': [{'firstname': 'Tanya', 'middlename': None, 'lastname': 'Caldwell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2a698d08-733a-57e4-b541-fa230424a625', 'word_count': 384, 'uri': 'nyt://article/2a698d08-733a-57e4-b541-fa230424a625'}, {'abstract': 'Mr. King, who died on Sunday, became a symbol for the power of a homemade image to take over the media.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2012/06/18/rodney-kings-starring-role-in-citizen-journalism/', 'snippet': 'Mr. King, who died on Sunday, became a symbol for the power of a homemade image to take over the media.', 'lead_paragraph': 'Rodney King, who died on Sunday at age 47, came to represent many things during his life — the brutality of the Los Angeles Police Department, the explosion of the city’s long-simmering racial tensions and the simple wish that we could all, as he pleaded, get along.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Rodney King’s Starring Role in Citizen Journalism', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'News and News Media', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Police Brutality and Misconduct', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Social Networking (Internet)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Assange, Julian P', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'King, Rodney Glen', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Payne, Martha', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'CNN', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Los Angeles Police Department', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Occupy Wall Street', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'WikiLeaks', 'rank': 10, 'major': 'N'}], 'pub_date': '2012-06-18T17:07:15+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Noam Cohen', 'person': [{'firstname': 'Noam', 'middlename': None, 'lastname': 'Cohen', 'qualifier': N