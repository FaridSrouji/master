lename': None, 'lastname': 'Spousta', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0ccb30c0-0b97-50df-9015-379be2db0f40', 'word_count': 733, 'uri': 'nyt://article/0ccb30c0-0b97-50df-9015-379be2db0f40'}, {'abstract': 'The romantic Broadway musical “Once” was expected to receive four Drama Desk Awards at a ceremony on Sunday night honoring theater work on Broadway and Off Broadway.', 'web_url': 'https://www.nytimes.com/2012/06/04/theater/drama-desk-awards.html', 'snippet': 'The romantic Broadway musical “Once” was expected to receive four Drama Desk Awards at a ceremony on Sunday night honoring theater work on Broadway and Off Broadway.', 'lead_paragraph': 'The romantic Broadway musical “Once” was expected to receive four Drama Desk Awards at a ceremony on Sunday night honoring theater work on Broadway and Off Broadway. “Once,” already the recipient of numerous awards this season to go along with its 11 Tony nominations, was to take home trophies for outstanding musical, director, lyrics and orchestrations. The Broadway revival of Arthur Miller’s “Death of a Salesman” won three awards for outstanding play revival, director and lighting design. “Nice Work If You Can Get It” won for featured actor (Michael McGrath) and actress (Judy Kaye) in a musical, along with outstanding book. The Broadway comedy “One Man, Two Guvnors” won for outstanding music in a play, actor (James Corden) and featured actor (Tom Edden). “Tribes” was named outstanding play, and “Follies” outstanding musical revival. A full list of winners is at dramadeskawards.com.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Drama Desk Awards', 'kicker': 'Arts, Briefly', 'content_kicker': None, 'print_headline': 'Drama Desk Awards', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Drama Desk Awards', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-06-04T02:37:01+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Theater', 'byline': {'original': 'Compiled by Adam W. Kepler', 'person': [{'firstname': 'Adam', 'middlename': 'W.', 'lastname': 'Kepler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/4c1fe2c4-f8e1-529a-8160-5a367c91d49c', 'word_count': 153, 'uri': 'nyt://article/4c1fe2c4-f8e1-529a-8160-5a367c91d49c'}, {'abstract': 'Jordan Feilders just opened Cantine California, one of the first food trucks in Paris to offer upscale versions of American food.', 'web_url': 'https://www.nytimes.com/video/dining/100000001572386/a-food-truck-takes-paris-.html', 'snippet': 'Jordan Feilders just opened Cantine California, one of the first food trucks in Paris to offer upscale versions of American food.', 'lead_paragraph': 'Jordan Feilders just opened Cantine California, one of the first food trucks in Paris to offer upscale versions of American food.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/05/28/world/video-foodtrucparis/video-foodtrucparis-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/05/28/world/video-foodtrucparis/video-foodtrucparis-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/05/28/world/video-foodtrucparis/video-foodtrucparis-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/05/28/world/video-foodtrucparis/video-foodtrucparis-thumbStandard.jpg', 'thumbnailwidth': 7