': 'N'}, {'name': 'subject', 'value': 'Appointments and Executive Changes', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Washington (DC)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Appeals Courts (US)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Halligan, Caitlin Joan', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-06-12T02:55:13+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Charlie Savage', 'person': [{'firstname': 'Charlie', 'middlename': None, 'lastname': 'Savage', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/335281bb-7719-55c0-8bd5-d1996d892885', 'word_count': 683, 'uri': 'nyt://article/335281bb-7719-55c0-8bd5-d1996d892885'}, {'abstract': 'Ivan Nova pitched seven shutout inning to send the Yankees past the Braves in Atlanta and a season-high 10 games over .500, good enough for first place in the American League East.', 'web_url': 'https://www.nytimes.com/2012/06/12/sports/baseball/novas-strong-outing-helps-yankees-vault-into-first.html', 'snippet': 'Ivan Nova pitched seven shutout inning to send the Yankees past the Braves in Atlanta and a season-high 10 games over .500, good enough for first place in the American League East.', 'lead_paragraph': 'ATLANTA — After an odd few weeks in the wilderness, when no one could get a clutch hit or pitch a dominant game, the Yankees finally got back to a place they always expected to be. With a 3-0 victory over the Atlanta Braves on Monday night, the Yankees were back in first place in the American League East for the first time since April 24.', 'print_section': 'B', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': '