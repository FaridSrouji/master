Times', 'multimedia': [], 'headline': {'main': 'Can a Small Country Have a Big Heart?', 'kicker': 'Latitude', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Illegal Immigrants', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'AFRICA', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Israel', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-06-15T12:29:04+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Shmuel Rosner', 'person': [{'firstname': 'Shmuel', 'middlename': None, 'lastname': 'Rosner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e5b3f404-811e-5fb8-a42f-27548c4ac199', 'word_count': 743, 'uri': 'nyt://article/e5b3f404-811e-5fb8-a42f-27548c4ac199'}, {'abstract': 'A film by Chicago-born Prashant Bhargava weaves together the stories of six people around India’s largest annual kite flying festival.', 'web_url': 'https://india.blogs.nytimes.com/2012/06/15/gujarat-kite-festival-inspires-patang/', 'snippet': 'A film by Chicago-born Prashant Bhargava weaves together the stories of six people around India’s largest annual kite flying festival.', 'lead_paragraph': 'It’s fitting that the opening of a movie about a kite festival should be celebrated with a kite-flying party, but the incessant rain in New York City on Tuesday night kept the kites grounded at the event marking the U.S. release of “Patang.” ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Gujarat Kite Festival Inspires ‘Patang’', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Kites', 'rank': 1, 'major': 'N'}, {'name': 'subject'