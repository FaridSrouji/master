btype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/13/health/13well_suleika/13well_suleika-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Life, Interrupted: Feeling Guilty About Cancer', 'kicker': 'Well', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-06-14T15:39:33+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Health', 'byline': {'original': 'By Suleika Jaouad', 'person': [{'firstname': 'Suleika', 'middlename': None, 'lastname': 'Jaouad', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9903ae74-ee27-5087-a17f-e214eb91eac5', 'word_count': 684, 'uri': 'nyt://article/9903ae74-ee27-5087-a17f-e214eb91eac5'}, {'abstract': 'Stocks extended on reports that central banks might increase liquidity as financial markets brace for possible turmoil from Greek elections.', 'web_url': 'https://www.nytimes.com/2012/06/15/business/daily-stock-market-activity.html', 'snippet': 'Stocks extended on reports that central banks might increase liquidity as financial markets brace for possible turmoil from Greek elections.', 'lead_paragraph': 'Stocks advanced Thursday, erasing a weekly loss for the Standard & Poor’s 500-stock index, amid reports that policy makers might act to help economies battered by the European debt crisis.', 'print_section': 'B', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Hope for Policy Relief Drives a Market Upturn', 'kicker': 'Stocks & Bonds', 'content_kicker': None, 'print_headline': 'Hope for Policy Relief Drives a Market Upturn', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Stocks and Bonds', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-06-14T15:51:25+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Bloomberg News', 'person': [{'firstname': 'Bloomberg', 'middlename': None, 'lastname': 'News', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a82ca0da-34b2-5251-b81b-768854d17496', 'word_count': 516, 'uri': 'nyt://article/a82ca0da-34b2-5251-b81b-768854d17496'}, {'abstract': 'Berkshire Hathaway’s effort to buy ResCap assets illustrates the many pieces of the distressed debt puzzle.', 'web_url': 'https://dealbook.nytimes.com/2012/06/14/in-rescap-bid-a-savvy-move-by-berkshire/', 'snippet': 'Berkshire Hathaway’s effort to buy ResCap assets illustrates the many pieces of the distressed debt puzzle.', 'lead_paragraph': 'Breakup fees and bidding procedures in many Chapter 11 cases often have a certain amount of charade to them. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In ResCap Bid, a Savvy Move by Berkshire', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Bankruptcies', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mergers, Acquisitions and Divestitures', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Ally Financial Inc.', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Berkshire Hathaway Inc', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Residential Capital LLC', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-06-14T16:00:01+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Stephen J. Lubben', 'person': [{'firstname': 'Stephen', 'middlename': 'J.', 'lastname': 'Lubben', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/279055b9-7d33-5930-b8e2-462a26589803', 'word_count': 338, 'uri': 'nyt://article/279055b9-7d33-5930-b8e2-462a26589803'}, {'abstract': 'The moment when a son becomes a parent to his dad.', 'web_url': 'https://opinionator.blogs.nytimes.com/2012/06/14/the-russian-heart/', 'snippet': 'The moment when a son becomes a parent to his dad.', 'lead_paragraph': 'Perhaps because I’m still in my early 30s, I tend not to fully believe that the people closest to me are vulnerable to sickness and death. But in 2008, shortly after my parents moved from Russia to Brooklyn’s Brighton Beach — a Russian neighborhood on the edge of the Atlantic — I began to have doubts that I would be celebrating Father’s Day ever again.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Russian Heart', 'kicker': 'Townies', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ANGIOPLASTY', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': "Father's Day", 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Russian-Americans', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-06-14T16:00:34+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Dmitry Iyudin', 'person': [{'firstname': 'Dmitry', 'middlename': None, 'lastname': 'Iyudin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1b374d5c-1da7-5e83-afe2-dab094131e8b', 'word_count': 975, 'uri': 'nyt://article/1b374d5c-1da7-5e83-afe2-dab094131e8b'}, {'abstract': 'Ruiz de la Prada of Spain has created 30 surreal, one-of-a-kind, fascinators exclusively for Yoox.com.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2012/06/14/the-get-agatha-ruiz-de-la-pradas-headbands/', 'snippet': 'Ruiz de la Prada of Spain has created 30 surreal, one-of-a-kind, fascinators exclusively for Yoox.com.', 'lead_paragraph': 'A few years ago, the designer Agatha Ruiz de la Prada was honored with an exhibition at the La Caixa Foundation in Barcelona, Spain. With approbation comes obligation; in this case, a celebratory luncheon, where the ready-to-wear and accessories designer showed up wearing a headband that sent a large, upright spiral jetting into the air. “Everyone looked shocked,” Ruiz de la Prada says. “But soon enough, the looks transformed into smiles, and the stiff formality dissipated from the room.” She credits the event’s success solely to the headband. Now, for Ruiz de la Prada’s second exclusive collection for Yoox.com, she has created 30 one-of-a-kind fascinators (priced from $90 to $105). The surreal pieces are sure to have awe-inducing effects: eggs over easy that drip down one’s head; an ace-of-hearts playing card; and a hatlike cupcake. But that’s just the tip of the capsule. Because, as Ruiz de la Prada points out, “What better than a beautiful headband to brighten up one’s day?”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Get | Agatha Ruiz de la Prada’s Headbands', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Barcelona (Spain)', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-06-14T16:00:37+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Chelsea Zalopany', 'person': [{'firstname': 'Chelsea', 'middlename': None, 'lastname': 'Zalopany', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d3c4e366-43d0-5d1e-bf24-74c06aa11cde', 'word_count': 176, 'uri': 'nyt://article/d3c4e366-43d0-5d1e-bf24-74c06aa11cde'}, {'abstract': 'Shares of Credit Suisse tumble in Zurich trading after the Swiss central bank says it should consider suspending its dividend or raising capital by selling stock.', 'web_url': 'https://dealbook.nytimes.com/2012/06/14/swiss-central-bank-urges-credit-suisse-to-bolster-capital/', 'snippet': 'Shares of Credit Suisse tumble in Zurich trading after the Swiss central bank says it should consider suspending its dividend or raising capital by selling stock.', 'lead_paragraph': 'LONDON – Credit Suisse needs to increase its capital this year to prepare for a potential worsening of the European debt crisis, Switzerland’s central bank said on Thursday.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Swiss Central Bank Urges Credit Suisse to Bolster Capital', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'European Sovereign Debt Crisis (2010- )', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Credit Suisse Group A.G', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Swiss National Bank', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'UBS A.G', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-06-14T16:02:48+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Julia Werdigier', 'person': [{'firstname': 'Julia', 'middlename': None, 'lastname': 'Werdigier', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4a1141f0-a746-58f3-8bdd-76ec0302d13e', 'word_count': 390, 'uri': 'nyt://article/4a1141f0-a746-58f3-8bdd-76ec0302d13e'}, {'abstract': 'Army hotels go private, where to find the best street food in Asia and more in our daily capsule of travel news.', 'web_url': 'https://intransit.blogs.nytimes.com/2012/06/14/morning-walkabout-614-asian-street-food-and-the-armys-private-hotels/', 'snippet': 'Army hotels go private, where to find the best street food in Asia and more in our daily capsule of travel news.', 'lead_paragraph': 'Army’s Hotel Rooms Go Civilian The Army has allowed many of its 17,000 hotel rooms to go private in the last three years. About 4,400 of the rooms have already been remade. (The New York Times)', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Morning Walkabout — 6/14: Asian Street Food and the Army’s Private Hotels', 'kicker': 'In Transit', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-06-14T16:03:24+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Travel', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/1c2b7aa7-85cb-5d64-b8a1-35fa6f318916', 'word_count': 155, 'uri': 'nyt://article/1c2b7aa7-85cb-5d64-b8a1-35fa6f318916'}, {'abstract': 'A new book, “La Roja” by the author Jimmy Burns, takes a look at the history of soccer in Spain, from its beginnings up through the tumultous years of the rule of Francisco Franco to its conquering of Europe and the world.', 'web_url': 'https://goal.blogs.nytimes.com/2012/06/14/euro-2012-la-roja-the-team-meets-la-roja-the-book/', 'snippet': 'A new book, “La Roja” by the author Jimmy Burns, takes a look at the history of soccer in Spain, from its beginnings up through the tumultous years of the rule of Francisco Franco to its conquering of Europe and the world.', 'lead_paragraph': 'In every game played by Spain’s national team, La Roja carries a history riven with complex political, cultural and regional baggage onto the field.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Euro 2012: La Roja the Team Meets ‘La Roja,’ the Book', 'kicker': 'Goal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-06-14T16:03:32+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Soccer', 'byline': {'original': 'By Jack Bell', 'person': [{'firstname': 'Jack', 'middlename': None, 'lastname': 'Bell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dad69a0e-7c64-5b54-ba8a-365139018c6b', 'word_count': 1077, 'uri': 'nyt://article/dad69a0e-7c64-5b54-ba8a-365139018c6b'}, {'abstract': 'More accusers, and a Penn State police investigator, took the stand in Jerry Sandusky’s trial on sexual-abuse charges.', 'web_url': 'https://www.nytimes.com/2012/06/15/sports/ncaafootball/sandusky-witness-describes-1998-shower-encounter.html', 'snippet': 'More accusers, and a Penn State police investigator, took the stand in Jerry Sandusky’s trial on sexual-abuse charges.', 'lead_paragraph': 'BELLEFONTE, Pa. — A Penn State police officer once told Jerry Sandusky, the former assistant football coach who has been charged with sexually abusing 10 boys over 15 years, that he should not shower with young boys, according to testimony provided on the fourth day of Sandusky’s trial.', 'print_section': 'B', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Penn State Police Officer Testifies He Warned Sandusky About Contact With Boys', 'kicker': None, 'content_kicker': None, 'print_headline': 'More Sandusky Accusers Testify', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Gricar, Ray', 'rank': 1, 'major': 'N'}, {'name': 