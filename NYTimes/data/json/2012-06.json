ion.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Underwood’s Olympic Dream Was Delayed but Is Still Cherished', 'kicker': '2012 London Olympics', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Boxing', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Olympic Games', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Underwood, Quanitta', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'International Olympic Committee', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'USA Boxing', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-06-19T18:57:20+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Olympics', 'byline': {'original': 'By Lynn Zinser', 'person': [{'firstname': 'Lynn', 'middlename': None, 'lastname': 'Zinser', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d90851f3-c102-5db9-8a5d-be8ce7ee3d18', 'word_count': 472, 'uri': 'nyt://article/d90851f3-c102-5db9-8a5d-be8ce7ee3d18'}, {'abstract': 'The New York City Hospitality Alliance has formed to focus on city issues.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2012/06/19/restaurateurs-and-others-form-new-lobbying-group/', 'snippet': 'The New York City Hospitality Alliance has formed to focus on city issues.', 'lead_paragraph': 'A well-connected group of restaurateurs, bar and lounge owners, hotel executives and liquor distributors with deep pockets on Tuesday announced the creation of an upstart trade group, the New York City Hospitality Alliance, to lobby legislators and city regulatory agencies in the five boroughs. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Restaurateurs and Others Form New Lobbying Group', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'prin