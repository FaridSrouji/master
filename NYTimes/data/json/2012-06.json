rganizations', 'value': 'WikiLeaks', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-06-29T16:18:01+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By James C. McKinley Jr', 'person': [{'firstname': 'James', 'middlename': 'C.', 'lastname': 'McKinley', 'qualifier': 'Jr', 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/74c09301-e086-5640-ac5a-2c7c3f875516', 'word_count': 299, 'uri': 'nyt://article/74c09301-e086-5640-ac5a-2c7c3f875516'}, {'abstract': 'The ad is running in Ohio and features a video clip of Hillary Rodham Clinton during the 2008 Democratic primary contest.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2012/06/29/romney-ad-shows-hillary-clinton-attacking-obama/', 'snippet': 'The ad is running in Ohio and features a video clip of Hillary Rodham Clinton during the 2008 Democratic primary contest.', 'lead_paragraph': 'President Obama and his Democratic allies love to tweak Mitt Romney with unflattering quotations from his rivals in the primaries. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Romney Ad Shows Hillary Clinton Attacking Obama', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Political Advertising', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Clinton, Hillary Rodham', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Kantar Media', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Ohio', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-06-29T16:24:20+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.'