nding this film has been deafening.', 'print_section': 'AR', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/10/arts/10GALLO1_SPAN/10GALLO1-articleLarge.jpg', 'height': 324, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/06/10/arts/10GALLO1_SPAN/10GALLO1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 324}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/10/arts/10GALLO1_SPAN/10GALLO1-jumbo.jpg', 'height': 554, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/10/arts/10GALLO1_SPAN/10GALLO1-superJumbo.jpg', 'height': 1107, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/10/arts/10GALLO1_SPAN/10GALLO1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/10/arts/10GALLO1_SPAN/10GALLO1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/10/arts/10GALLO1_SPAN/10GALLO1-thumbLarge.jpg', 'height': 81, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'R.I.P. ‘Promises,’ It Was Nice Knowing You', 'kicker': None, 'content_kicker': None, 'print_headline': 'R.I.P. ‘Promises,’ It Was Nice Knowing You', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'Essential Killing (Movie)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Gallo, Vincent', 'rank': 2, 'major': 