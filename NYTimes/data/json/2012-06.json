'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/04/25/opinion/opinionator-pog-disunion/opinionator-pog-disunion-thumbStandard.gif', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/04/25/opinion/opinionator-pog-disunion/opinionator-pog-disunion-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Opening of the American Frontier', 'kicker': 'Disunion', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Civil War (US) (1861-65)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Scott, Dred', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-06-20T16:29:31+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Susan Schulten', 'person': [{'firstname': 'Susan', 'middlename': None, 'lastname': 'Schulten', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1a5e0ba7-5b93-5c3f-b5ac-841a55c52bc5', 'word_count': 901, 'uri': 'nyt://article/1a5e0ba7-5b93-5c3f-b5ac-841a55c52bc5'}, {'abstract': 'Iowa Republicans are trying to stop Medicaid-funded abortions in cases of rape or incest.', 'web_url': 'https://takingnote.blogs.nytimes.com/2012/06/20/anti-abortion-grandstanding/', 'snippet': 'Iowa Republicans are trying to stop Medicaid-funded abortions in cases of rape or incest.', 'lead_paragraph': 'Republican lawmakers are tireless in their protection of gun ownership. Their argument is that states and localities have no right to play around with Americans’ con