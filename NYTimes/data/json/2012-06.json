le': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/472b4154-9f71-5701-b9dd-2ded75538d04', 'word_count': 666, 'uri': 'nyt://article/472b4154-9f71-5701-b9dd-2ded75538d04'}, {'abstract': 'It’s the nation’s most dreaded disease, but letting “cancer phobia” dictate our medical care can often lead to more harm than good.', 'web_url': 'https://opinionator.blogs.nytimes.com/2012/06/02/cancer-on-the-brain/', 'snippet': 'It’s the nation’s most dreaded disease, but letting “cancer phobia” dictate our medical care can often lead to more harm than good.', 'lead_paragraph': 'I got a call from a friend last year. He had prostate cancer and wanted some help thinking through what to do. He had gone to his doctors for the details about his physical condition. He was calling me for help dealing with the other condition he knew he was facing — excessive fear of this dreaded disease that sometimes does more harm than good, what some have called “cancer phobia.” [1]', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Cancer on the Brain', 'kicker': 'Anxiety', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Anxiety and Stress', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cancer', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Emotions', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Phobias', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Prostate Cancer', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-06-02T21:00:43+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By David Ropeik', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Ropeik', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://articl