name': None, 'lastname': 'Paul', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/f272e950-00b2-53ac-983e-bf95a06a7fc0', 'word_count': 541, 'uri': 'nyt://article/f272e950-00b2-53ac-983e-bf95a06a7fc0'}, {'abstract': 'BASE jumping is the extreme younger cousin of sky diving, but rather than dropping from planes, BASE jumpers fall from objects attached to Earth.', 'web_url': 'https://www.nytimes.com/2012/06/16/sports/base-jumpers-double-the-dare.html', 'snippet': 'BASE jumping is the extreme younger cousin of sky diving, but rather than dropping from planes, BASE jumpers fall from objects attached to Earth.', 'lead_paragraph': 'MOAB, Utah — Castle Valley spread out about 1,500 feet below, and Mario Richard scooted his toes to the edge of the cliff. It can be an awkward shuffle when there is another person fastened to the front of him. ', 'print_section': 'D', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/16/sports/16basejump/16basejump-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/06/16/sports/16basejump/16basejump-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/16/sports/16basejump/16basejump-jumbo.jpg', 'height': 680, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/16/sports/16basejump/16basejump-superJumbo.jpg', 'height': 1360, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url':