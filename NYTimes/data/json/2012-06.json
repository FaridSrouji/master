ds': [{'name': 'subject', 'value': 'Golf', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'De La Hoya, Oscar', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Boxing', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Alcohol Abuse', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-06-24T19:01:28+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Golf', 'byline': {'original': 'By Michael Arkush', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Arkush', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/36731295-4153-526a-bf16-dac00fd694cd', 'word_count': 915, 'uri': 'nyt://article/36731295-4153-526a-bf16-dac00fd694cd'}, {'abstract': 'The maneuver was an important step in the development of China’s space program, which includes plans to build a space station by 2020.', 'web_url': 'https://www.nytimes.com/2012/06/25/science/space/chinese-astronauts-dock-spacecraft-with-orbiting-module.html', 'snippet': 'The maneuver was an important step in the development of China’s space program, which includes plans to build a space station by 2020.', 'lead_paragraph': 'BEIJING — A Chinese spacecraft with three astronauts on board docked manually with an orbiting module on Sunday, an important step toward China’s goal of building a space station by 2020.', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Chinese Astronauts Make Their First Manual Docking With Orbiting Module', 'kicker': None, 'content_kicker': None, 'print_headline': 'China Manually Docks Spacecraft in ‘Major Breakthrough’ for Program', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'China', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Space Stations', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value':