title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'recipe', '_id': 'nyt://article/9573e1df-417c-5738-be0a-68f67e3633d0', 'word_count': 650, 'uri': 'nyt://article/9573e1df-417c-5738-be0a-68f67e3633d0'}, {'abstract': 'Here’s one more reason to be skeptical when the government claims to be setting aside contracts for small businesses.', 'web_url': 'https://boss.blogs.nytimes.com/2012/06/18/russian-arms-dealer-was-classified-as-a-small-business-briefly/', 'snippet': 'Here’s one more reason to be skeptical when the government claims to be setting aside contracts for small businesses.', 'lead_paragraph': 'Here’s a new topic for You’re The Boss: Russian arms for Syria. Russian-made helicopters are en route to Syria, sold to the Assad regime by Rosoboronexport, the Russian state-owned arms exporter. Since 2007, Rosoboronexport, the sole Russian arms exporter, has supplied Syria with 78 percent of its arms imports, according to the Stockholm International Peace Research Institute. (The New York Times has reported that the copters heading to Syria were most likely already part of that country’s fleet, returning after routine maintenance in Russia.)', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Russian Arms Dealer Was Classified as a Small Business, Briefly', 'kicker': 'You&#039;re the Boss', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Defense Contracts', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Government Procurement', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Small Business', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Russia', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-06-18T15:00:40+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Entrepreneurship', 'byline': {'original': 'By Robb Mandelbaum', 'person': [{'firstname': 'Robb', 'middlename': None, 'lastname': 'Mandelbaum', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9375f708-810d-5523-833f-e3a5a4f49de0', 'word_count': 319, 'uri': 'nyt://article/9375f708-810d-5523-833f-e3a5a4f49de0'}, {'abstract': 'After a decade on the job, the parks commissioner, Adrian Benepe, is stepping down from his post to take a position with a national conservation group.', 'web_url': 'https://www.nytimes.com/2012/06/19/nyregion/adrian-benepe-nyc-parks-chief-quits-to-join-trust-for-public-land.html', 'snippet': 'After a decade on the job, the parks commissioner, Adrian Benepe, is stepping down from his post to take a position with a national conservation group.', 'lead_paragraph': 'He got his start as a teenager cleaning locker rooms at a city pool in the East Village and picking up litter in East River Park, and ended up overseeing the most ambitious program of building and refurbishing New York City’s parks since the era of Robert Moses. Now, after a decade on the job, the parks commissioner, Adrian Benepe, 55, is stepping down to take a position with a national conservation group. ', 'print_section': 'A', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/19/nyregion/PARKS1/PARKS1-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/06/19/nyregion/PARKS1/PARKS1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/19/nyregion/PARKS1/PARKS1-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'im