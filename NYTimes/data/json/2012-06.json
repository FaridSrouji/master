uts Await', 'kicker': '2012 London Olympics', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Olympic Games (2012)', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-06-21T15:15:14+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Olympics', 'byline': {'original': 'By Diana Lopez', 'person': [{'firstname': 'Diana', 'middlename': None, 'lastname': 'Lopez', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/003ff4fa-25ac-5bda-8fc4-c3c31425b901', 'word_count': 179, 'uri': 'nyt://article/003ff4fa-25ac-5bda-8fc4-c3c31425b901'}, {'abstract': 'John E. Bryson announced his resignation as President Obama’s commerce secretary after an incident in which he had a seizure and was involved in a sequence of automobile accidents.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2012/06/21/bryson-resigns-as-commerce-secretary/', 'snippet': 'John E. Bryson announced his resignation as President Obama’s commerce secretary after an incident in which he had a seizure and was involved in a sequence of automobile accidents.', 'lead_paragraph': '8:54 p.m. | Updated WASHINGTON — John E. Bryson announced his resignation as President Obama’s commerce secretary on Thursday, citing medical reasons after an episode in which he had a seizure and was involved in a sequence of car crashes.', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Commerce Secretary Resigns', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': 'Commerce Secretary Resigns, Citing Medical Reasons', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-06-21T15:29:03+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': '