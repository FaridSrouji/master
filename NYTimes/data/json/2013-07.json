: [{'firstname': 'Jeremy', 'middlename': 'W.', 'lastname': 'Peters', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7b1d7e0c-9cc8-55a4-ab7b-947775a734ba', 'word_count': 550, 'uri': 'nyt://article/7b1d7e0c-9cc8-55a4-ab7b-947775a734ba'}, {'abstract': 'Polar’s new Stride Sensor claims to be the first Bluetooth Smart device of its kind, meaning it doesn’t need an additional receiver to link to your phone.', 'web_url': 'https://gadgetwise.blogs.nytimes.com/2013/07/10/a-sensor-steps-up-to-improve-your-stride/', 'snippet': 'Polar’s new Stride Sensor claims to be the first Bluetooth Smart device of its kind, meaning it doesn’t need an additional receiver to link to your phone.', 'lead_paragraph': 'Polar’s new Stride Sensor allows runners to collect information about their stride and then link this information to a phone app that calculates speed and distance data through GPS. It connects to the phone through Bluetooth Smart, and is helpful for people trying to track calories or improve their running performance.', 'print_section': 'B', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Sensor Steps Up to Improve Your Stride', 'kicker': 'Gadgetwise', 'content_kicker': None, 'print_headline': 'A Sensor Offers Runners Help With Their Strides', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Running', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Wireless Communications', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Polar Electro', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-07-10T17:23:25+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'subsection_name': 'Personal Tech', 'byline': {'original': 'By Roy Furchgott', 'person': [{'firstname': 'Roy', 'middlename': None, 'lastname': 'Furchgott', 'qualifier': None, 'title': None, 'role'