rsons', 'value': 'Engelbart, Douglas C', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Markoff, John', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Inventions and Patents', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-07-03T18:59:55+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'byline': {'original': 'By John Markoff', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Markoff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/3ef7b44d-427c-5062-ba6b-8fa98f628137', 'word_count': 1537, 'uri': 'nyt://article/3ef7b44d-427c-5062-ba6b-8fa98f628137'}, {'abstract': 'The T.S.A. found 1,549 firearms on passengers attempting to go through airport security in 2012', 'web_url': 'https://takingnote.blogs.nytimes.com/2013/07/03/guns-on-a-plane/', 'snippet': 'The T.S.A. found 1,549 firearms on passengers attempting to go through airport security in 2012', 'lead_paragraph': 'Whatever you think about the Second Amendment or the increasing number of states that are allowing people to carry a concealed weapon, you surely agree that anyone who walks around with a gun should be, at the very least, responsible and aware.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Guns on a Plane', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Airport Security', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Gun Control', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Transportation Security Administration', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-07-03T19:04:51+0000', 'document_ty