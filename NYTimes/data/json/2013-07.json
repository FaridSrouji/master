uperJumbo.jpg', 'height': 490, 'width': 650, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/24/opinion/global/24iht-edchappatte24/24iht-edchappatte24-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/24/opinion/global/24iht-edchappatte24/24iht-edchappatte24-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Buckingham Palace Welcomes the Royal Baby', 'kicker': 'Patrick Chappatte', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Catherine, Duchess of Cambridge', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'William, Duke of Cambridge', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Babies and Infants', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Royal Family', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-07-23T11:20:38+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Global Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/a92312e6-6d5c-5f7d-ad13-2b7c41675631', 'word_count': 6, 'uri': 'nyt://article/a92312e6-6d5c-5f7d-ad13-2b7c41675631'}, {'abstract': 'Mr. O’Malley, who plays Evan, a reality TV fan, sings “The Twitter Song,” in which he sends Twitter messages to his followers during an episode of his favorite dating show, “Nobody Loves You.”', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/07/23/in-performance-rory-omalley-of-nobody-loves-you/', 'snippet': 'Mr. O’Malley, who plays Evan, a reality TV fan, sings “The Twitter Song,” in which he sends Twitter messages to his followers during an episode of his favorite dating show, “Nobody Loves You.”', 'lead_paragraph': '“Nobody Loves You,” a new Off Broadway musical from Itamar Moses (book and lyrics) and Gaby Alter (music and lyrics), is a comedy about the contestants on a reality TV dating show of the same name. In this scene, Rory O’Malley, who plays Evan, a reality TV fan, sings “The Twitter Song,” in which he sends Twitter messages to his followers during an episode of “Nobody Loves You.” (The keyboardist is Vadim Feichtner.) The musical continues through Aug. 11 at Second Stage Theater.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In Performance: Rory O’Malley of ‘Nobody Loves You’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': "O'Malley, Rory", 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Second Stage Theater', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-07-23T12:00:20+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Erik Piepenburg', 'person': [{'firstname': 'Erik', 'middlename': None, 'lastname': 'Piepenburg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d6aaa95f-80d0-553d-be28-bf7bbe9afe08', 'word_count': 152, 'uri': 'nyt://article/d6aaa95f-80d0-553d-be28-bf7bbe9afe08'}, {'abstract': 'Robert S. Khuzami, formerly of the S.E.C., has accepted a job at Kirkland & Ellis. | Telefónica agrees to buy Germany’s smallest mobile operator. | Federal regulators have begun an examination of commodities warehouse controlled by financial firms. | Why did Steven A. Cohen pay so much to settle a case that now appears far from settled?', 'web_url': 'https://dealbook.nytimes.com/2013/07/23/morning-agenda-khuzamis-new-job/', 'snippet': 'Robert S. Khuzami, formerly of the S.E.C., has accepted a job at Kirkland & Ellis. | Telefónica agrees to buy Germany’s smallest mobile operator. | Federal regulators have begun an examination of commodities warehouse controlled by financial firms...', 'lead_paragraph': 'KHUZAMI SWITCHES SIDES \xa0|\xa0 Six months after leaving his post as Wall Street’s top federal enforcer, Robert S. Khuzami has accepted a job that pays more than $5 million a year at Kirkland & Ellis, one of the nation’s biggest corporate law firms, DealBook’s Ben Protess and Peter Lattman report. “In doing so, he is following the quintessential Washington script: an influential government insider becoming a paid advocate for industries he once policed.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Khuzami’s New Job', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-07-23T12:32:15+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By William Alden', 'person': [{'firstname': 'William', 'middlename': None, 'lastname': 'Alden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/41b3f707-d923-57f3-ab04-52181cd92dc8', 'word_count': 1679, 'uri': 'nyt://article/41b3f707-d923-57f3-ab04-52181cd92dc8'}, {'abstract': 'Cisco Systems has agreed to buy Sourcefire, a provider of cybersecurity services, for about $2.7 billion in cash, amid a growing fervor for companies that can help guard against computer-based attacks.', 'web_url': 'https://dealbook.nytimes.com/2013/07/23/cisco-to-buy-sourcefire-a-cybersecurity-company-for-2-7-billion/', 'snippet': 'Cisco Systems has agreed to buy Sourcefire, a provider of cybersecurity services, for about $2.7 billion in cash, amid a growing fervor for companies that can help guard against computer-based attacks.', 'lead_paragraph': 'Cisco Systems agreed on Tuesday to buy Sourcefire, a provider of cybersecurity services, for about $2.7 billion in cash, in a reflection of the growing fervor for companies that can help guard against computer-based attacks.', 'print_section': 'B', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Cisco to Buy Sourcefire, a Cybersecurity Company, for $2.7 Billion', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': 'Cybersecurity Acquisition', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Computer Security', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mergers, Acquisitions and Divestitures', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Cisco Systems Inc', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Sourcefire Inc', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-07-23T12:55:18+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Michael J. de la Merced', 'person': [{'firstname': 'Michael', 'middlename': 'J.', 'lastname': 'de la Merced', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c1ec1163-909c-51c0-8225-4d68a4b3ecdf', 'word_count': 264, 'uri': 'nyt://article/c1ec1163-909c-51c0-8225-4d68a4b3ecdf'}, {'abstract': 'A humbling view of the home planet from 898 million miles away.', 'web_url': 'https://dotearth.blogs.nytimes.com/2013/07/23/a-humbling-view-of-the-home-planet-earth-seen-from-saturn/', 'snippet': 'A humbling view of the home planet from 898 million miles away.', 'lead_paragraph': 'Various NASA missions and spacecraft have taken extraordinary images of Earth from afar, including the Voyager 1 image from 1990 that inspired Carl Sagan to write about this “pale blue dot,” and of course the 1968 “Earthrise” image.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'c