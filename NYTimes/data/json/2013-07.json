ion': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6a644a2a-5e41-5e1b-9d5e-f9755d639464', 'word_count': 756, 'uri': 'nyt://article/6a644a2a-5e41-5e1b-9d5e-f9755d639464'}, {'abstract': 'Escapism and fun are the point of zombie-themed runs, not pushing to the point of muscle failure.', 'web_url': 'https://www.nytimes.com/2013/08/01/fashion/at-zombie-races-its-survival-of-the-undeadest.html', 'snippet': 'Escapism and fun are the point of zombie-themed runs, not pushing to the point of muscle failure.', 'lead_paragraph': 'Even with the looming prospect of fitting into a wedding gown, the only way Cindy Brandecker\xa0could imagine taking up running was if someone were chasing her.', 'print_section': 'E', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/fashion/01ZOMBIE1_SPAN/01ZOMBIE1_SPAN-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/01/fashion/01ZOMBIE1_SPAN/01ZOMBIE1_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/fashion/01ZOMBIE1_SPAN/01ZOMBIE1_SPAN-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/fashion/01ZOMBIE1_SPAN/01ZOMBIE1_SPAN-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/fashion/01ZOMBIE1_SPAN/01ZOMBIE1_SPAN-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/01/fashion/01ZOMBIE1_SPAN/01ZOMBIE1_SPAN-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/fashion/01ZOMBIE1_SPAN/01ZOMBIE1_SPAN-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'At Zombie Races, It’s Survival of the Undeadest', 'kicker': 'Fitness', 'content_kicker': None, 'print_headline': 'Survival of the Undeadest', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Running', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Rubin, Courtney', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Obstacle Courses (Sport)', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-07-31T21:53:49+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'byline': {'original': 'By Courtney Rubin', 'person': [{'firstname': 'Courtney', 'middlename': None, 'lastname': 'Rubin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/adcd5078-4df8-53ab-8af6-436a31b59cdd', 'word_count': 1234, 'uri': 'nyt://article/adcd5078-4df8-53ab-8af6-436a31b59cdd'}, {'abstract': 'In an uncharacteristically stern warning, the United Nations ordered individuals near the eastern city of Goma to turn in their weapons or be deemed “an imminent threat to civilians.”', 'web_url': 'https://www.nytimes.com/2013/08/01/world/africa/un-warns-it-will-disarm-congo-rebels.html', 'snippet': 'In an uncharacteristically stern warning, the United Nations ordered individuals near the eastern city of Goma to turn in their weapons or be deemed “an imminent threat to civilians.”', 'lead_paragraph': 'NAIROBI, Kenya — The United Nations has threatened to forcibly disarm rebels in the Democratic Republic of Congo, an early test of the robust new mandate for the multinational peacekeeping contingent that includes going on the offensive there.', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'U.N. Warns It Will Disarm Congo Rebels', 'kicker': None, 'content_kicker': None, 'print_headline': 'U.N. Warns It Will Disarm Congo Rebels', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Kulish, Nicholas', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Congo, Democratic Republic of (Congo-Kinshasa)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'United Nations', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'March 23 Movement', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Rwanda', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-07-31T21:58:12+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Africa', 'byline': {'original': 'By Nicholas Kulish', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'Kulish', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d806c8f4-9e49-508d-a21a-3e02dbb962c4', 'word_count': 438, 'uri': 'nyt://article/d806c8f4-9e49-508d-a21a-3e02dbb962c4'}, {'abstract': 'The Niger-born guitarist and songwriter Bombino, backed by his three-man band, had the audience dancing at Brooklyn Bowl on Tuesday night.', 'web_url': 'https://www.nytimes.com/2013/08/01/arts/music/bombino-brings-tuareg-rhythms-to-brooklyn-bowl.html', 'snippet': 'The Niger-born guitarist and songwriter Bombino, backed by his three-man band, had the audience dancing at Brooklyn Bowl on Tuesday night.', 'lead_paragraph': 'The most direct route for African music to reach American listeners is via the dance floor, which was full and overjoyed when Bombino, a Tuareg guitarist and songwriter born in Niger, brought his band to Brooklyn Bowl on Tuesday night. Bombino and his three band members wore desert robes and turbans; he sang in his native language, Tamashek, and thanked the audience between songs in French. But it looked like ethnomusicological curiosity mattered far less to the audience than Bombino’s pithy, incantatory electric guitar lines and the band’s perpetual grooves. By the end of the set, their robes were drenched in sweat. ', 'print_section': 'C', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/arts/01BOMBINO/01BOMBINO-articleLarge.jpg', 'height': 351, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/01/arts/01BOMBINO/01BOMBINO-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 351}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/arts/01BOMBINO/01BOMBINO-jumbo.jpg', 'height': 598, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/arts/01BOMBINO/01BOMBINO-superJumbo.jpg', 'height': 1196, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/arts/01BOMBINO/01BOMBINO-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/01/arts/01BOMBINO/01BOMBINO-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/arts/01BOMBINO/01BOMBINO-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Sharing Sahara Sentiments of Romance and Roots', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Sharing Sahara Sentiments of Romance and Roots', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Bombino', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Tuareg (Ethnic Group)', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-07-31T22:04:58+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Jon Pareles', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Pareles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/1a3c29eb-e5aa-52a0-a323-54393fb7766e', 'word_count': 502, 'uri': 'nyt://article/1a3c29eb-e5aa-52a0-a323-54393fb7766e'}, {'abstract': 'The five-part works were the focus of “Concertos à 5,” the first of four one-hour, free concerts featuring well-known composers and worthy rarities at St. Peter’s Lutheran Church.', 'web_url': 'https://www.nytimes.com/2013/08/01/arts/music/at-4x4-baroque-music-festival-five-part-works-are-the-stars.html', 'snippet': 'The five-part works were the focus of “Concertos à 5,” the first of four one-hour, free concerts featuring well-known composers and worthy rarities at St. Peter’s Lutheran Church.', 'lead_paragraph': 'Introducing “Concertos à 5,” the opening program of the 4x4 Baroque Music Festival on Tuesday, the harpsichordist Avi Stein said that each era has its ubiquitous format, like the string quartet in the 20th and 21st centuries and the Trio sonata in the Baroque era. The five-part ensemble, an invention of an earlier period, is the “dark sheep of the family,” he added. Its Renaissance flavor, with a rich polyphonic texture created by the instrumental combination, lingered in scores written in later centuries. ', 'print_section': 'C', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/arts/01FOUR/01FOUR-articleLarge.jpg', 'height': 394, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/01/arts/01FOUR/01FOUR-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 394}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/arts/01FOUR/01FOUR-jumbo.jpg', 'height': 672, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/arts/01FOUR/01FOUR-superJumbo.jpg', 'height': 1344, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/arts/01FOUR/01FOUR-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/01/arts/01FOUR/01FOUR-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/arts/01FOUR/01FOUR-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Dark Sheep of the Family’ Has a History to Uphold', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': '‘Dark Sheep of the Family’ Has a History to Uphold', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Schweitzer, Vivien', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': '4x4 Baroque Music Festival', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Stein, Avi', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-07-31T22:05:10+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Vivien Schweitzer', 'person': [{'firstname': 'Vivien', 'middlename': None, 'lastname': 'Schweitzer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/a0d9e97c-b68f-5a0d-ab2e-b80a46590a03', 'word_count': 367, 'uri': 'nyt://article/a0d9e97c-b68f-5a0d-ab2e-b80a46590a03'}, {'abstract': '“Iranian Living Room” presents photos of people at home in Iran. But when the publisher tried to sell it on its Web site using PayPal, the orders were initially blocked.', 'web_url': 'https://www.nytimes.com/2013/08/01/garden/a-blacklist-delays-book-on-iran.html', 'snippet': '“Iranian Living Room” presents photos of people at home in Iran. But when the publisher tried to sell it on its Web site using PayPal, the orders were initially blocked.', 'lead_paragraph': 'Last month, Fabrica, a think tank in Treviso, Italy, run by the fashion company Benetton, released a book that offered a rare view of the domestic lives of Iranians. Overseen by Enrico Bossan, Fabrica’s head of photography, “Iranian Living Room” (about $45) presents images by photojournalists in Tehran and other cities of people in residential settings occupied with chores, socializing, leisure and prayer. But when Fabrica tried to sell “Iranian Living Room” on its Web site, with transactions processed through PayPal, the orders were initially blocked.', 'print_section': 'D', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/gar