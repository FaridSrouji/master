imedia': [], 'headline': {'main': 'State Senator Makes a Fashion Statement', 'kicker': 'On the Runway', 'content_kicker': None, 'print_headline': 'Stepping Up', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Filibusters and Debate Curbs', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Shoes and Boots', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Sneakers', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'State Legislatures', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Davis, Wendy', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Texas', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-07-03T18:43:02+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Eric Wilson', 'person': [{'firstname': 'Eric', 'middlename': None, 'lastname': 'Wilson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/648e36d1-7783-50d4-a3b4-c49a1ebf8eb2', 'word_count': 371, 'uri': 'nyt://article/648e36d1-7783-50d4-a3b4-c49a1ebf8eb2'}, {'abstract': 'Gabriel Stulman, who owns the Greenwich Village restaurant, said it would reopen for dinner on Wednesday.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2013/07/03/health-inspectors-close-perla/', 'snippet': 'Gabriel Stulman, who owns the Greenwich Village restaurant, said it would reopen for dinner on Wednesday.', 'lead_paragraph': '5:14 p.m. | Updated New York City’s health department confirmed Wednesday afternoon that it had “closed Perla yesterday following an inspection.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Health Inspectors Close Perla', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Restaurants', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Stulman, Gabriel', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Perla (Manhattan, NY, Restaurant)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Greenwich Village (Manhattan, NY)', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-07-03T18:48:06+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Julia Moskin', 'person': [{'firstname': 'Julia', 'middlename': None, 'lastname': 'Moskin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6ab43af6-2166-5921-abf7-8f689600faa3', 'word_count': 267, 'uri': 'nyt://article/6ab43af6-2166-5921-abf7-8f689600faa3'}, {'abstract': 'Readers solve the case of a 37-year-old woman who had a persistent fever despite being treated with antibiotics.', 'web_url': 'https://well.blogs.nytimes.com/2013/07/03/think-like-a-doctor-a-mysterious-fever-solved/', 'snippet': 'Readers solve the case of a 37-year-old woman who had a persistent fever despite being treated with antibiotics.', 'lead_paragraph': 'On Tuesday we challenged Well readers to take on the case of a 37-year-old woman in Tennessee who had a persistent fever despite being treated with antibiotics. In addition, we asked that you identify the test used to confirm the diagnosis. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/02/29/health/29well_diagnosis/29well_diagnosis-jumbo.jpg', 'height': 280, 'width': 400, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/02/29/health/29well_diagnosis/29well_diagnosis-superJumbo.jpg', 'height': 280, 'width': 400, 'subType': 'superJumbo', 'crop_name': 'superJumbo',