ine', 'byline': {'original': 'By Virginia Sole-Smith', 'person': [{'firstname': 'Virginia', 'middlename': None, 'lastname': 'Sole-Smith', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/61afd015-bd97-55ec-b39a-ed62cb9fc803', 'word_count': 4472, 'uri': 'nyt://article/61afd015-bd97-55ec-b39a-ed62cb9fc803'}, {'abstract': 'The share of American adults with jobs rose slightly in June, to 58.7 percent. That matches the highest level since the end of the recession, but remains well below the prevailing level before the recession.', 'web_url': 'https://economix.blogs.nytimes.com/2013/07/05/for-the-employment-rate-an-uptick/', 'snippet': 'The share of American adults with jobs rose slightly in June, to 58.7 percent. That matches the highest level since the end of the recession, but remains well below the prevailing level before the recession.', 'lead_paragraph': 'The share of American adults with jobs rose slightly in June, to 58.7 percent. That matches the highest level since the end of the recession in 2009, but remains well below the prevailing level before the recession.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'For the Employment Rate, an Uptick', 'kicker': 'Economix', 'content_kicker': None, 'print_headline': 'An Employment Rate Uptick', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Labor and Jobs', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Unemployment', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-07-05T13:27:47+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Binyamin Appelbaum', 'person': [{'firstname': 'Binyamin', 'middlename': None, 'lastname': 'Appelbaum', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}