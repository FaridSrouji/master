tle': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/1313eb3e-8fb5-50e3-8909-90c3635b0494', 'word_count': 1119, 'uri': 'nyt://article/1313eb3e-8fb5-50e3-8909-90c3635b0494'}, {'abstract': 'Imagine if the Chinese, in a fit of pique, decided they would not sell this country another ham hock or breakfast link.', 'web_url': 'https://www.nytimes.com/2013/07/14/opinion/sunday/we-need-oil-they-need-pig.html', 'snippet': 'Imagine if the Chinese, in a fit of pique, decided they would not sell this country another ham hock or breakfast link.', 'lead_paragraph': 'China has battleships, missiles and awfully effective computer hackers. Soon it will have tasty American-made pork parts in its arsenal to threaten the United States. ', 'print_section': 'SR', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'We Need Oil. They Need Pig.', 'kicker': 'Loose Ends', 'content_kicker': None, 'print_headline': 'We Need Oil. They Need Pig.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Shuanghui International', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Darlin, Damon', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Smithfield Foods Inc', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Pork', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Food', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'International Trade and World Market', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-07-13T18:30:06+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Damon Darlin', 'person': [{'firstname': 'Damon', 'middlename': None, 'lastname': 'Darlin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/931c3fc8-c134-58ce-bed3-286abaec5b0d', 'word_count': 564, 'uri': 'nyt://article/931c3fc8-c134-58ce-bed3-286abaec5b0d'}, {'abstract': 'The departure of the head of homeland security gives President Obama a chance to correct years of bad policy on immigration enforcement.', 'web_url': 'https://www.nytimes.com/2013/07/14/opinion/sunday/secretary-napolitano-resigns.html', 'snippet': 'The departure of the head of homeland security gives President Obama a chance to correct years of bad policy on immigration enforcement.', 'lead_paragraph': 'There is a fuller appraisal to be done of Janet Napolitano’s performance as homeland security secretary. But in one part of her large portfolio, immigration enforcement, her record is disheartening. Her resignation gives President Obama a chance to name a successor to reverse years of bad policy and right some terrible injustices. ', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Secretary Napolitano Resigns', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Secretary Napolitano Resigns', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Napolitano, Janet', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Homeland Security Department', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Illegal Immigration', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Deportation', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Morton, John T', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-07-13T18:30:06+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sund