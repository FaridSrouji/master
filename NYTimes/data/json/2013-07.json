le': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/8c69b27d-6dcf-56d3-b0fb-1494149984e5', 'word_count': 270, 'uri': 'nyt://article/8c69b27d-6dcf-56d3-b0fb-1494149984e5'}, {'abstract': 'Britain’s Kyle Edmund defeated the American Stefan Kozlov, 4-6, 6-1, 6-3, in Thursday’s quarterfinals of the boys’ singles.', 'web_url': 'https://straightsets.blogs.nytimes.com/2013/07/04/prospects-from-britain-and-u-s-meet/', 'snippet': 'Britain’s Kyle Edmund defeated the American Stefan Kozlov, 4-6, 6-1, 6-3, in Thursday’s quarterfinals of the boys’ singles.', 'lead_paragraph': 'WIMBLEDON, England – The British have become used to only one men’s home hopeful, Andy Murray, getting past the first round at Wimbledon. The rest, almost always given wild cards because of their low rankings, make quick exits.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Prospects From Britain and U.S. Meet', 'kicker': 'Straight Sets', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Tennis', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Wimbledon Tennis Tournament', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-07-04T21:08:31+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By Ravi Ubha', 'person': [{'firstname': 'Ravi', 'middlename': None, 'lastname': 'Ubha', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a13df96e-4edf-5bc5-b8fd-125f1e5881fb', 'word_count': 739, 'uri': 'nyt://article/a13df96e-4edf-5bc5-b8fd-125f1e5881fb'}, {'abstract': 'A visit to Lake Attersee, where the painter Gustav Klimt created dozens of landscapes, frames the artist’s vision.', 'web_url': 'https://www.nytimes.com/2013/07/07/travel/seeing