': 'News', '_id': 'nyt://article/60d39423-4030-5716-a3a1-dd02c99d8daa', 'word_count': 943, 'uri': 'nyt://article/60d39423-4030-5716-a3a1-dd02c99d8daa'}, {'abstract': 'Quotation of the Day for Monday, July 29.', 'web_url': 'https://www.nytimes.com/2013/07/29/world/middleeast/quotation-of-the-day-for-monday-july-29.html', 'snippet': 'Quotation of the Day for Monday, July 29.', 'lead_paragraph': '“The military needs to be taught a lesson. At this point it’s a zero-sum game: it’s either the Brotherhood or the old regime.”', 'print_section': 'A', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Quotation of the Day for Monday, July 29', 'kicker': None, 'content_kicker': None, 'print_headline': 'Quotation of the Day', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-07-29T04:14:59+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Quote', '_id': 'nyt://article/7c99f3fc-f3cc-5efa-a1d5-90125a88858e', 'word_count': 38, 'uri': 'nyt://article/7c99f3fc-f3cc-5efa-a1d5-90125a88858e'}, {'abstract': 'Christine Guan and Indra Sen went international, yet local, for their wedding in Flushing, Queens.', 'web_url': 'https://www.nytimes.com/video/fashion/100000002361105/vows-christine-and-indra.html', 'snippet': 'Christine Guan and Indra Sen went international, yet local, for their wedding in Flushing, Queens.', 'lead_paragraph': 'Christine Guan and Indra Sen went international, yet local, for their wedding in Flushing, Queens.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/28/fashion/video-vows-guan-sen/video-vows-guan-sen-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/28/fashio