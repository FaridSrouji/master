': 'nyt://article/a74e56a8-d64c-5d40-aef6-dbdd123f3eda'}, {'abstract': 'A special committee of Dell Inc.’s board said on Wednesday that it would be willing to accept the latest takeover bid by its founder, worth $13.75 a share, if he dropped his demand for a change to the voting rules.', 'web_url': 'https://dealbook.nytimes.com/2013/07/31/dell-offers-to-move-vote-on-takeover-but-refuses-to-bend-on-voting-rules/', 'snippet': 'A special committee of Dell Inc.’s board said on Wednesday that it would be willing to accept the latest takeover bid by its founder, worth $13.75 a share, if he dropped his demand for a change to the voting rules.', 'lead_paragraph': 'Michael S. Dell’s effort of several months to buy the company that bears his name was thrown into jeopardy on Wednesday, as a special committee of the computer maker’s board refused his demand to change the voting rules on the huge buyout.', 'print_section': 'B', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Dell Buyout Bid in Peril as Voting Rule Remains', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': 'Dell Takeover Bid in Peril As a Voting Rule Remains', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Mergers, Acquisitions and Divestitures', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Dell, Michael S', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Icahn, Carl C', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Dell Inc', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Silver Lake Partners', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-07-31T13:05:30+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Michael J. de la Merced', 'person': [{'firstname': 'Michael', 'middlename': 'J.', 'lastname': 'de la Merced', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f52b4226-c7b9-5db9-bcc1-8008f6bdc589', 'word_count': 772, 'uri': 'nyt://article/f52b4226-c7b9-5db9-bcc1-8008f6bdc589'}, {'abstract': 'The former leading mobile phone maker in Japan had watched its share of the domestic market dwindle to 5.3 percent, down from 28 percent in 2001.', 'web_url': 'https://www.nytimes.com/2013/08/01/business/global/nec-to-exit-japanese-smartphone-market.html', 'snippet': 'The former leading mobile phone maker in Japan had watched its share of the domestic market dwindle to 5.3 percent, down from 28 percent in 2001.', 'lead_paragraph': 'TOKYO — NEC, once the leading cellphone maker in Japan, said on Wednesday that it would quit making smartphones, acknowledging that it had failed to keep pace with the likes of Apple and Samsung Electronics.', 'print_section': 'B', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/business/NEC/NEC-articleLarge.jpg', 'height': 800, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/01/business/NEC/NEC-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 800}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/business/NEC/NEC-jumbo.jpg', 'height': 1024, 'width': 768, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/business/NEC/NEC-superJumbo.jpg', 'height': 2048, 'width': 1536, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'NEC of Japan Is Exiting Market for Smartphones ', 'kicker': None, 'content_kicker': None, 'print_headline': 'NEC of Japan Is Exiting Market for Smartphones', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 