ajor': 'N'}, {'name': 'organizations', 'value': 'SeaWorld Adventure Parks', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-07-14T10:36:20+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Michael Cieply', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Cieply', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b48c9de1-c194-53c0-a903-4c0868262b5f', 'word_count': 246, 'uri': 'nyt://article/b48c9de1-c194-53c0-a903-4c0868262b5f'}, {'abstract': 'Mr. Monteith, who won global fame in Fox’s TV series and battled with substance abuse problems, was found dead in a hotel room in Canada on Saturday, the police said.', 'web_url': 'https://www.nytimes.com/2013/07/15/arts/television/cory-monteith-star-of-hit-show-glee-is-dead-at-31.html', 'snippet': 'Mr. Monteith, who won global fame in Fox’s TV series and battled with substance abuse problems, was found dead in a hotel room in Canada on Saturday, the police said.', 'lead_paragraph': 'Cory Monteith, who played an upbeat and outgoing young student and singing coach on the hit Fox musical comedy series “Glee,” was found dead on Saturday in a hotel room in Vancouver, British Columbia. He was 31 and had struggled with substance abuse.', 'print_section': 'A', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/14/arts/television/monteithweb1/monteithweb1-articleLarge.jpg', 'height': 417, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/14/arts/television/monteithweb1/monteithweb1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 417}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/14/arts/television/monteithweb1/monteithweb