e': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/11/11/blogs/scuttlebot/scuttlebot-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Today’s Scuttlebot: The Origin of Google Docs, and Spying on Your Own E-Mail', 'kicker': 'Bits', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-07-03T21:39:06+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/72702a7a-d003-5d7b-beda-26687340b221', 'word_count': 235, 'uri': 'nyt://article/72702a7a-d003-5d7b-beda-26687340b221'}, {'abstract': 'The delay will give businesses time to press their cases to Congress for changes in provisions of the health care overhaul.', 'web_url': 'https://boss.blogs.nytimes.com/2013/07/03/the-employer-mandate-has-been-delayed-will-it-be-rewritten/', 'snippet': 'The delay will give businesses time to press their cases to Congress for changes in provisions of the health care overhaul.', 'lead_paragraph': 'It seems that almost nobody was ready for the employer mandate in the Affordable Care Act to take effect — not government regulators, not the managers of health insurance exchanges, and not the employers — and that a year’s delay could buy time for the government to write regulations and for companies to figure out how to comply with them. But many businesses hope to get something else from the one-year delay: an opportunity to rewrite other aspects of the mandate that they find difficult.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Employer Mandate Has Been Delayed. Will It Be Rewritten?', 'kicker': 'You&#039;re the Boss', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Health Insurance and Managed Care', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Part-Time Employment', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Patient Protection and Affordable Care Act (2010)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Small Business', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Working Hours', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Aon Hewitt', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Liazon Corp', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'National Retail Federation', 'rank': 10, 'major': 'N'}], 'pub_date': '2013-07-03T21:51:15+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Entrepreneurship', 'byline': {'original': 'By Robb Mandelbaum', 'person': [{'firstname': 'Robb', 'middlename': None, 'lastname': 'Mandelbaum', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ca5b11b6-f27e-516a-bdb0-ab064d0cf7eb', 'word_count': 754, 'uri': 'nyt://article/ca5b11b6-f27e-516a-bdb0-ab064d0cf7eb'}, {'abstract': 'David Medine was sworn in as chairman of a privacy board exactly one week before the N.S.A. data-mining revelations.', 'web_url': 'https://takingnote.blogs.nytimes.com/2013/07/03/a-chance-for-oversight-on-civil-liberties/', 'snippet': 'David Medine was sworn in as chairman of a privacy board exactly one week before the N.S.A. data-mining revelations.', 'lead_paragraph': 'On May 29, after a year’s delay by Senate Republicans, David Medine was sworn in as chairman of the Privacy and Civil Liberties Oversight Board. Exactly one week later, the Guardian published a secret order from the Federal Intelligence Surveillance Court, showing that the government was collecting the phone records of most Americans.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Chance for Oversight on Civil Liberties', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Privacy', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Surveillance of Citizens by Government', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Medine, David', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-07-03T21:51:25+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By David Firestone', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Firestone', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/67e82ab8-0a5f-50eb-939b-f72da20f947e', 'word_count': 688, 'uri': 'nyt://article/67e82ab8-0a5f-50eb-939b-f72da20f947e'}, {'abstract': 'Photos from Egypt, Indonesia, Austria and South Africa.', 'web_url': 'https://lens.blogs.nytimes.com/2013/07/03/pictures-of-the-day-egypt-and-elsewhere-56/', 'snippet': 'Photos from Egypt, Indonesia, Austria and South Africa.', 'lead_paragraph': 'Photos from Egypt, Indonesia, Austria and South Africa.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Pictures of the Day: Egypt and Elsewhere', 'kicker': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Photography', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Austria', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Egypt', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Indonesia', 'rank': 4, 'major': 'N'}, {'name': 'glocations', '