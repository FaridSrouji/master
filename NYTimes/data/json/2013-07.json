: 1, 'major': 'N'}], 'pub_date': '2013-07-19T11:00:59+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Entrepreneurship', 'byline': {'original': 'By Ami Kassar', 'person': [{'firstname': 'Ami', 'middlename': None, 'lastname': 'Kassar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e4896b62-b8af-5ca7-8807-eaec7e1d7fba', 'word_count': 760, 'uri': 'nyt://article/e4896b62-b8af-5ca7-8807-eaec7e1d7fba'}, {'abstract': 'Egyptians’ relationship with the United States seems as personal as it is political, and I’ve watched it shift from infatuation to disappointment.', 'web_url': 'https://latitude.blogs.nytimes.com/2013/07/19/from-egypt-with-love/', 'snippet': 'Egyptians’ relationship with the United States seems as personal as it is political, and I’ve watched it shift from infatuation to disappointment.', 'lead_paragraph': 'CAIRO — Someone hung a large full-color banner in the center of the roundabout near my apartment during the demonstrations on June 30. It featured Anne W. Patterson, the U.S. ambassador to Egypt, with a red “X” across her face and the caption “Spinster, Go Home!” Patterson is married, coincidentally, but her purported bachelorette’s status was meant as a slur: Independent, single women are often viewed with pity or distrust in Egypt’s patriarchal culture. And however ludicrous an insult, “spinster” is more restrained than “pitch,” as the ambassador is frequently called in protest signage — Egyptians often confuse the English letters “p” and “b.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'From Egypt With Love', 'kicker': 'Latitude', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': "Coups D'Etat and Attempted Coups D'Etat", 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Demonstrations, Protests, and Riots', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Middle East and North Africa Unrest (2010- )', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States International Relations', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Patterson, Anne W', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Muslim Brotherhood (Egypt)', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Egypt', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-07-19T11:12:24+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Maria Golia', 'person': [{'firstname': 'Maria', 'middlename': None, 'lastname': 'Golia', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/16ed46b9-5e71-546c-bcb2-017fa6c56848', 'word_count': 784, 'uri': 'nyt://article/16ed46b9-5e71-546c-bcb2-017fa6c56848'}, {'abstract': 'The sixth week of our Summer Reading Contest will be judged by editors at Edutopia.', 'web_url': 'https://learning.blogs.nytimes.com/2013/07/19/summer-reading-contest-what-interested-you-most-in-the-times-this-week-5/', 'snippet': 'The sixth week of our Summer Reading Contest will be judged by editors at Edutopia.', 'lead_paragraph': 'In The Times this week: Many pieces about the heat and diversions from it, including a front-page story about the wait to see the temporary installation “Rain Room” at the Museum of Modern Art. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/18/arts/Rainroom-LN/Rainroom-articleLarge.jpg', 'height': 395, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/18/arts/Rainroom-LN/Rainroom-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 395}}, {'rank': 0, 'subtype': 'jumbo', 'caption'