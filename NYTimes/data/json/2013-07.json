usiness/CALDWELL-obit/CALDWELL-obit-superJumbo.jpg', 'height': 1437, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/12/business/CALDWELL-obit/CALDWELL-obit-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/12/business/CALDWELL-obit/CALDWELL-obit-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/12/business/CALDWELL-obit/CALDWELL-obit-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Philip Caldwell, First Nonfamily Member to Head Ford, Is Dead at 93', 'kicker': None, 'content_kicker': None, 'print_headline': 'Philip Caldwell, Who Headed Ford Though He Wasn’t One, Dies at 93', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Caldwell, Philip (1920-2013)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Ford Motor Co', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Automobiles', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-07-11T15:49:33+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Patrick J. Lyons', 'person': [{'firstname': 'Patrick', 'middlename': 'J.', 'lastname': 'Lyons', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/8aee76c5-40d3-5c3f-8835-3f2aa34390c8', 'word_count': 821, 'uri': 'nyt://article/8aee76c5-40d3-5c3f-8835-3f2aa34390c8'}, {'abstract': 'The director Andrew Bujalski and his cinematographer, Matthias Grunsky, discuss how old technology was employed to capture the 1980s ambience of “Computer Chess.”', 'web_url': 'https://www.nytimes.com/2013/07/14/movies/andrew-bujalski-talks-about-the-look-of-his-computer-chess.html', 'snippet': 'The director Andrew Bujalski and his cinematographer, Matthias Grunsky, discuss how old technology was employed to capture the 1980s ambience of “Computer Chess.”', 'lead_paragraph': 'Andrew Bujalski likes it vintage. He has been making small, talky 16-millimeter films for the past decade, even as the industry has become progressively more digital. Over the years, Mr. Bujalski was asked why he hadn’t joined much of the indie world in shooting his movies on digital video. This contrarian responded with his latest feature, “Computer Chess,” which is about as video as video gets, but not in the way his questioners may have had in mind.', 'print_section': 'AR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/14/movies/14computer-span/14computer-span-articleLarge.jpg', 'height': 337, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/14/movies/14computer-span/14computer-span-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 337}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/14/movies/14computer-span/14computer-span-jumbo.jpg', 'height': 575, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/14/movies/14computer-span/14computer-span-superJumbo.jpg', 'height': 1150, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/14/movies/14computer-span/14computer-span-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/14/movies/14computer-span/14computer-span-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/14/movies/14computer-span/14computer-span-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Video, Yes; High-Def, No', 'kicker': None, 'content_kicker': None, 'print_headline': 'Video, Yes; High-Def, No', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Murphy, Mekado', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Bujalski, Andrew', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Grunksy, Matthias', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-07-11T15:49:47+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Movies', 'byline': {'original': 'By Mekado Murphy', 'person': [{'firstname': 'Mekado', 'middlename': None, 'lastname': 'Murphy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/609ae755-52d0-570a-a94a-5f4a56107ddd', 'word_count': 630, 'uri': 'nyt://article/609ae755-52d0-570a-a94a-5f4a56107ddd'}, {'abstract': 'Mr. Robinson, one of the first black reporters at The New York Times in the 1950s and a local television news correspondent, inspired the next generation of black journalists.', 'web_url': 'https://www.nytimes.com/2013/07/12/business/media/layhmond-robinson-jr-88-dies-paved-the-way-for-black-journalists.html', 'snippet': 'Mr. Robinson, one of the first black reporters at The New York Times in the 1950s and a local television news correspondent, inspired the next generation of black journalists.', 'lead_paragraph': 'Layhmond Robinson Jr., one of the first black reporters at The New York Times, who later became a local television news correspondent, died on June 29 in Queens. He was 88.', 'print_section': 'A', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/11/business/ROBINSON-obit/ROBINSON-obit-articleLarge.jpg', 'height': 834, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/11/business/ROBINSON-obit/ROBINSON-obit-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 834}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/11/business/ROBINSON-obit/ROBINSON-obit-jumbo.jpg', 'height': 1024, 'width': 737, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/11/business/ROBINSON-obit/ROBINSON-obit-superJumbo.jpg', 'height': 2048, 'width': 1474, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/11/business/ROBINSON-obit/ROBINSON-obit-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/11/business/ROBINSON-obit/ROBINSON-obit-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/11/business/ROBINSON-obit/ROBINSON-obit-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Layhmond Robinson Jr., Who Paved Way for Black Journalists, Dies at 88', 'kicker': None, 'content_kicker': None, 'print_headline': 'Layhmond Robinson Jr., 88; a Newsroom Pioneer', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Robinson, Layhmond Jr (1925-2013)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'News and News Media', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Times', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'WABC-TV', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Blacks', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Newspapers', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 9, 'major': 'N'}], 'pub_date': '2013-07-11T15:52:07+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Daniel E. Slotnik', 'person': [{'firstname': 'Daniel', 'middlename': 'E.', 'lastname': 'Slotnik', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/e633f539-56e0-5d51-95d7-68b34d192f11', 'word_count': 347, 'uri': 'nyt://article/e633f539-56e0-5d51-95d7-68b34d192f11'}, {'abstract': 'The giant talent agency is close to acquiring a 49 percent stake in Droga5, an independent advertising agency whose clients include Coca-Cola and Motorola.', 'web_url': 'https://www.nytimes.com/2013/07/12/business/media/william-morris-to-invest-in-droga5-an-ad-agency.html', 'snippet': 'The giant talent agency is close to acquiring a 49 percent stake in Droga5, an independent advertising agency whose clients include Coca-Cola and Motorola.', 'lead_paragraph': 'William Morris Endeavor, the giant talent agency, is close to acquiring a significant minority stake in Droga5, an independent advertising agency based in New York. The deal, which is estimated at $225 million, is expected to be completed early next week.', 'print_section': 'B', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/12/business/Morris/Morris-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/12/business/Morris/Morris-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/12/business/Morris/Morris-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/12/business/Morris/Morris-superJumbo.jpg', 'height': 1264, 'width': 1896, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/12/business/Morris/Morris-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/12/business/Morris/Morris-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/12/business/Morris/Morris-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'William Morris to Invest in Droga5, an Ad Agency', 'kicker': None, 'content_kicker': None, 'print_headline': 'William Morris to Invest in Droga5, an Ad Agency', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Vega, Tanzina', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mergers, Acquisitions and Divestitures', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Droga5', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Emanuel, Ariel Z', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Droga, David', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Beverly Hills (Calif)', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Manhattan (NYC)', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Morris, William, Endeavor Entertainment', 'rank': 10, 'major': 'N'}], 'pub_date': '2013-07-11T15:52:56+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Tanzina Vega', 'person': [{'firstname': 'Tanzina', 'middlename': None, 'lastname': 'Vega', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/45c5d9bd-979c-5e77-a33c-1635b2501caa', 'word_count': 749, 'uri': 'nyt://article/45c5d9bd-979c-5e77-a33c-1635b2501caa'}, {'abstract': 'We are very pleased to offer a preview of our TimesMachine redesign. Before we completely replace the original TimesMachine, we’re hoping to get some feedback by releasing a prototype of the new experience.', 'web_url': 'https://open.blogs.nytimes.com/2013/07/11/introducing-the-new-timesmachine/', 'snippet': 'We are very pleased to offer a preview of our TimesMachine redesign. Before we completely replace the original TimesMachine, we’re hoping to get some feedback by releasing a prototype of the new experience.', 'lead_paragraph': 'We are very pleased to offer a preview of our TimesMachine redesign. Our subscribers can, for the first time, read complete issues of The New York Times in their original context. For each issue that is available in the new TimesMachine, every article, every letter and every advertisement is included in a legible, linkable and shareable fashion.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Introducing the New TimesMachine', 'kicker': 'Open', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-07-11T16:03:21+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Blogs', 'byline': {'original': 'By Evan Sandhaus', 'person': [{'firstname': 'Evan', 'middlename': None, 'lastname': 'Sandhaus', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/212710b8-ffd0-5654-979f-d4d788f5ea25', 'word_count': 607, 'uri': 'nyt://article/212710b8-ffd0-5654-979f-d4d788f5ea25'}, {'abstract': 'Joe Swanberg and Andrew Bujalski, fathers of the low-budget movement called mumblecore, have new films: Mr. Swanberg’s “Drinking Buddies” and Mr. Bujalski’s “Computer Chess.”', 'web_url': 'https://www.nytimes.com/2013/07/14/movies/the-directors-andrew-bujalski-and-joe-swanberg-grow-up.html', 'snippet': 'Joe Swanberg and Andrew Bujalski, fathers of the low-budget movement called mumblecore, have new films: Mr. Swanberg’s “Drinking Buddies” and Mr. Bujalski’s “Computer Chess.”', 'lead_paragraph': 'When Andrew Bujalski, 24 at the time, was directing his first feature, “Funny Ha Ha,” initiating a movement in American independent film was the last thing on his mind.', 'print_section': 'AR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/14/arts/14MUMBLE1_SPAN/14MUMBLE1-articleLarge.jpg', 'height': 256, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/14/arts/14MUMBLE1_SPAN/14MUMBLE1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 256}}, {'r