/22adnewsletter1/22adnewsletter1-superJumbo.jpg', 'height': 2048, 'width': 1517, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/22/business/media/22adnewsletter1/22adnewsletter1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/22/business/media/22adnewsletter1/22adnewsletter1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/22/business/media/22adnewsletter1/22adnewsletter1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Collective, a Marketing Agency, Showcases Itself', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Political Advertising', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Online Advertising', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Outdoor Advertising', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Apprendi, Joe', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Collective Media Inc', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-07-22T18:09:25+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Jane L. Levere', 'person': [{'firstname': 'Jane', 'middlename': 'L.', 'lastname': 'Levere', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/10bf83b0-89e1-5e00-b14c-c2dc5cd07dc5', 'word_count': 901, 'uri': 'nyt://article/10bf83b0-89e1-5e00-b14c-c2dc5cd07dc5'}, {'abstract': 'This British skincare product will rouse you from even the worst summer doldrums.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2013/07/22/feeling-for-a-face-serum-with-some-serious-kick/', 'snippet': 'This British skincare product will rouse you from even the worst summer doldrums.', 'lead_paragraph': 'I sometimes have a hard time getting going on summer mornings, an unfortunate byproduct of triple-digit heat indexes and rosé nightcaps. Enter the Revitalise & Glow Serum, an amazing product from the new British skin-care line Aurelia Probiotic Skincare, which opened its first store in England earlier this month. Just two drops of the lightweight hydrating fluid — which smells of creamy mandarin with hints of jasmine, plumeria and tuberose — is enough to wake me up and give my skin a sun-kissed feeling that lasts all day. With its moisturizing properties and big vitamin E-packed punch (to help counteract harmful UV damage), it keeps until it’s time, again, for after-work drinks alfresco.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Feeling For | A Face Serum With Some Serious Kick', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-07-22T18:16:52+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Alainna Lexie Beddie', 'person': [{'firstname': 'Alainna', 'middlename': 'Lexie', 'lastname': 'Beddie', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d091579f-0ffd-528a-b51f-395cf743bde2', 'word_count': 119, 'uri': 'nyt://article/d091579f-0ffd-528a-b51f-395cf743bde2'}, {'abstract': 'Beijing is taking incremental, but symbolic, steps toward financial reform, the author writes.', 'web_url': 'https://dealbook.nytimes.com/2013/07/22/signs-that-a-financial-overhaul-may-be-in-the-works/', 'snippet': 'Beijing is taking incremental, but symbolic, steps toward financial reform, the author writes.', 'lead_paragraph': 'Beijing announced an important if largely symbolic financial change on Friday. The People’s Bank of China removed the floor on bank lending rates, a move that has been under discussion on and off for decades. The immediate economic impact is likely to be small and possibly mildly stimulative, but it does appear to be a sign that a deeper financial overhaul is in the works.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Signs That a Financial Overhaul May Be in the Works', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Economic Conditions and Trends', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Interest Rates', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-07-22T18:22:44+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Bill Bishop', 'person': [{'firstname': 'Bill', 'middlename': None, 'lastname': 'Bishop', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/efa03a94-4681-53a1-956c-13c11e0f3281', 'word_count': 885, 'uri': 'nyt://article/efa03a94-4681-53a1-956c-13c11e0f3281'}, {'abstract': 'A NASA team is experimenting with photons to see if warp drive — traveling faster than light — might one day be possible.', 'web_url': 'https://www.nytimes.com/2013/07/23/science/faster-than-the-speed-of-light.html', 'snippet': 'A NASA team is experimenting with photons to see if warp drive — traveling faster than light — might one day be possible.', 'lead_paragraph': 'HOUSTON — Beyond the security gate at the Johnson Space Center’s 1960s-era campus here, inside a two-story glass and concrete building with winding corridors, there is a floating laboratory. ', 'print_section': 'D', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/23/science/23WARP_SPAN/23WARP-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/23/science/23WARP_SPAN/23WARP-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/23/science/23WARP_SPAN/23WARP-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/23/science/23WARP_SPAN/23WARP-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/23/science/23WARP_SPAN/23WARP-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/23/science/23WARP_SPAN/23WARP-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/23/science/23WARP_SPAN/23WARP-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Faster Than the Speed of Light?', 'kicker': None, 'content_kicker': None, 'print_headline': 'Exploring the Warp Factor', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Hakim, Danny', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Space and Astronomy', 'rank': 2, 'major': 'N'}, {'name': 'subjec