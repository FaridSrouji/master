'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/31/dining/31TAKEAWAY_SPAN/31TAKEAWAY_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/31/dining/31TAKEAWAY_SPAN/31TAKEAWAY_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/31/dining/31TAKEAWAY_SPAN/31TAKEAWAY_SPAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'That Photogenic Blueberry Pie', 'kicker': 'Restaurant Takeaway', 'content_kicker': None, 'print_headline': 'That Photogenic Blueberry Pie', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Clark, Melissa', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Pies', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Blueberries', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Recipes', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-07-29T20:54:59+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Melissa Clark', 'person': [{'firstname': 'Melissa', 'middlename': None, 'lastname': 'Clark', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a37568c0-4e6f-5a82-be54-07eaa4fa9946', 'word_count': 679, 'uri': 'nyt://article/a37568c0-4e6f-5a82-be54-07eaa4fa9946'}, {'abstract': 'Beware the female dollar.', 'web_url': 'https://krugman.blogs.nytimes.com/2013/07/29/the-she-devil-of-constitution-avenue/', 'snippet': 'Beware the female dollar.', 'lead_paragraph': 'I’ve spent five years and more watching the inflationphobes, who weren’t particularly sensible to begin with, descend into shrill unholy madness. They could have reacted to the failure of their predictions — the continued absence of the runaway inflation they insisted was just around the corner — by stepping back and reconsidering both their model and their recommendations. But no. At best, we see a proliferation of new reasons to raise interest rates in a depressed economy, with nary an acknowledgment that previous predictions were dead wrong. At worst, we see conspiracy theories — we actually have double-digit inflation, but the BLS is spiriting the evidence away in its black helicopters and burying it in Area 51.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The She-Devil of Constitution Avenue', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-07-29T20:57:21+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fb549148-6770-5e47-a632-ec11a0720e60', 'word_count': 387, 'uri': 'nyt://article/fb549148-6770-5e47-a632-ec11a0720e60'}, {'abstract': 'William C. Thompson Jr. and Bill de Blasio are trying to seize an opening in the mayoral race: to be the alternative to Christine C. Quinn, who is once again seen as the front-runner for the Democratic nomination.', 'web_url': 'https://www.nytimes.com/2013/07/30/nyregion/majority-of-democratic-voters-want-weiner-to-quit-race-poll-finds.html', 'snippet': 'William C. Thompson Jr. and Bill de Blasio are trying to seize an opening in the mayoral race: to be the alternative to Christine C. Quinn, who is once again seen as the front-runner for the Democratic nomination.'