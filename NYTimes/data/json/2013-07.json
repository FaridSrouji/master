world/indonesia/indonesia-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Indonesian Prison Riot Allows Inmates to Flee ', 'kicker': None, 'content_kicker': None, 'print_headline': 'Indonesian Prison Riot Allows Inmates to Flee', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Prisons and Prisoners', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Cochrane, Joe', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Indonesia', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Prison Escapes', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-07-12T05:44:58+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Joe Cochrane', 'person': [{'firstname': 'Joe', 'middlename': None, 'lastname': 'Cochrane', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bfe873ed-a217-50b4-9525-17180c63af60', 'word_count': 722, 'uri': 'nyt://article/bfe873ed-a217-50b4-9525-17180c63af60'}, {'abstract': 'Albin Mathew, 62, founded Santhi Bhavan Sarvodaya, a shelter for the mentally challenged after serving a jail term for murder.', 'web_url': 'https://india.blogs.nytimes.com/2013/07/12/in-kerala-a-reformed-murderer-nurtures-mentally-challenged/', 'snippet': 'Albin Mathew, 62, founded Santhi Bhavan Sarvodaya, a shelter for the mentally challenged after serving a jail term for murder.', 'lead_paragraph': 'Vasudeva Panicker, 61, is a mild-mannered watchman of a shelter for the mentally challenged at Punnapra, in Alappuzha district in southern Kerala. In his youth, Mr. Panicker was a soldier in the Indian Army. One day he returned home from his battalion to discover that his wife had run away with a lover. Enraged, Mr. Panicker stabbed his mother-in-law to death. He served 14 years in prison for the murder.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/12/world/asia/12-albin-mathew-IndiaInk/12-albin-mathew-IndiaInk-articleLarge-v6.jpg', 'height': 425, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/12/world/asia/12-albin-mathew-IndiaInk/12-albin-mathew-IndiaInk-articleLarge-v6.jpg', 'xlargewidth': 600, 'xlargeheight': 425}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/12/world/asia/12-albin-mathew-IndiaInk/12-albin-mathew-IndiaInk-jumbo-v6.jpg', 'height': 726, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/12/world/asia/12-albin-mathew-IndiaInk/12-albin-mathew-IndiaInk-superJumbo-v6.jpg', 'height': 1405, 'width': 1983, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/12/world/asia/12-albin-mathew-IndiaInk/12-albin-mathew-IndiaInk-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/12/world/asia/12-albin-mathew-IndiaInk/12-albin-mathew-IndiaInk-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/12/world/asia/12-albin-mathew-IndiaInk/12-albin-mathew-IndiaInk-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In Kerala, Rehabilitated Killer Nurtures Mentally Challenged', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': '', 'name': 