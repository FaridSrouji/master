business/CABLE2/CABLE2-jumbo.jpg', 'height': 1024, 'width': 614, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/26/business/CABLE2/CABLE2-superJumbo.jpg', 'height': 1035, 'width': 620, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/26/business/CABLE2/CABLE2-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/26/business/CABLE2/CABLE2-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/26/business/CABLE2/CABLE2-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Glenn Britt to Retire as Time Warner Cable Chief', 'kicker': None, 'content_kicker': None, 'print_headline': 'Change at the Top, and in Priorities, For a Cable and Internet Giant', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Stelter, Brian', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cable Television', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Time Warner Cable Inc', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Britt, Glenn A', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Marcus, Robert D', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-07-25T18:58:26+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Brian Stelter', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Stelter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0052185c-b00a-5aa3-8126-2d561fd763f1', 'word_count': 1113, 'uri': 'nyt://article/0052185c-b00a-5aa3-8126-2d561fd763f1'}, {'abstract': 'Why is the federal government making money off of poor and middle class students?', 'web_url': 'https://takingnote.blogs.nytimes.com/2013/07/25/reaping-profits-off-student-loans/', 'snippet': 'Why is the federal government making money off of poor and middle class students?', 'lead_paragraph': 'The Obama administration is championing the student loan overhaul passed by the Senate earlier this week as a wonderful thing. But there are two big problems with the new system. First, it lowers rates only temporarily, raising them in future years so that the government can continue to reap unseemly and unjustified profit from the student loan program. This means that future college students will be bled to pay for the financial break given to the students who preceded them. Senator Elizabeth Warren, Democrat of Massachusetts, likened this plan to the way subprime lenders made money in the run-up to the recession: They enticed borrowers with low “teaser” rates and then hammered them with the real costs later on.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Reaping Profits off Student Loans', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-07-25T19:03:03+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Brent Staples', 'person': [{'firstname': 'Brent', 'middlename': None, 'lastname': 'Staples', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/75417529-0897-5e73-8277-87b27f0a7823', 'word_count': 260, 'uri': 'nyt://article/75417529-0897-5e73-8277-87b27f0a7823'}, {'abstract': 'A look at