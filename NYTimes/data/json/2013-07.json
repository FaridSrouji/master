6, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-07-24T18:51:19+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Michael Kimmelman', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Kimmelman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cd491d9d-10cf-508d-bc8e-482a75fc4bdf', 'word_count': 1158, 'uri': 'nyt://article/cd491d9d-10cf-508d-bc8e-482a75fc4bdf'}, {'abstract': 'The president’s speech in Illinois lays out how he feels the economy has changed to the detriment of workers over three decades, but has few policy specifics to tackle stagnant wages and income inequality..', 'web_url': 'https://economix.blogs.nytimes.com/2013/07/24/obamas-view-of-the-economic-challenge/', 'snippet': 'The president’s speech in Illinois lays out how he feels the economy has changed to the detriment of workers over three decades, but has few policy specifics to tackle stagnant wages and income inequality..', 'lead_paragraph': 'President Obama’s speech in Galesburg, Ill., is more a description of how things are than a plan to get them to where they should be. It lays out Mr. Obama’s vision of how the economy has changed to the detriment of American workers, if not American businesses and executives, over the last 30 years or so, since long before the recession hit:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Obama’s View of the Economic Challenge', 'kicker': 'Economix', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Economic Conditions and Trends', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Federal Budget (US)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Speeches and Statements', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-07-24T18:51:20+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Annie Lowrey', 'person': [{'firstname': 'Annie', 'middlename': None, 'lastname': 'Lowrey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fb17da9a-e2fb-5947-98a0-3250c605bb57', 'word_count': 717, 'uri': 'nyt://article/fb17da9a-e2fb-5947-98a0-3250c605bb57'}, {'abstract': 'J. K. Rowling, of Harry Potter fame, shared a bit of the back story of her new book, written as Robert Galbraith.', 'web_url': 'https://www.nytimes.com/2013/07/25/business/media/rowling-solves-some-mysteries-about-her-mystery.html', 'snippet': 'J. K. Rowling, of Harry Potter fame, shared a bit of the back story of her new book, written as Robert Galbraith.', 'lead_paragraph': 'Nearly everything about the publication of “The Cuckoo’s Calling,” a detective novel released by Little, Brown & Company in April, has been a little mysterious.', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Revelations by Rowling', 'kicker': None, 'content_kicker': None, 'print_headline': 'Revelations by Rowling', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Writing and Writers', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'LITTLE BROWN & CO', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Rowling, J K', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-07-24T19:05:21+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Bus