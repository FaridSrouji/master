69-6e9678145600', 'word_count': 754, 'uri': 'nyt://article/0966ab7d-eba5-515e-8e69-6e9678145600'}, {'abstract': 'Two cheers for Lenovo. The Chinese personal computer maker has taken global leadership of PC sales from Hewlett-Packard. The market is saturated in many areas, analysts say, and personal computers last longer than before, so replacement cycles are slowing.', 'web_url': 'https://bits.blogs.nytimes.com/2013/07/10/lenovo-is-top-supplier-as-global-pc-sales-fall/', 'snippet': 'Two cheers for Lenovo. The Chinese personal computer maker has taken global leadership of PC sales from Hewlett-Packard. The market is saturated in many areas, analysts say, and personal computers last longer than before, so replacement cycles are...', 'lead_paragraph': 'Move over, Hewlett-Packard. You’ve just lost pride of place in an increasingly dubious tech category.', 'print_section': 'B', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Lenovo Is Top Supplier as Global PC Sales Fall', 'kicker': 'Bits', 'content_kicker': None, 'print_headline': 'Global PC Sales\r\nStill in Slide', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Computers and the Internet', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Gartner Inc', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'International Data Corp', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Lenovo Group', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-07-10T22:26:40+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By Quentin Hardy', 'person': [{'firstname': 'Quentin', 'middlename': None, 'lastname': 'Hardy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/910e76b4-babe-5ea2-9adb-5b53ea655bda', 'word_count': 382, 'uri': 'nyt://article/910e76b4-babe-5ea2-9adb-5b53ea655bda'}, {'abstract': 'A furniture collection by Jiun Ho upholstered in the alpaca textiles of Sandra Jordan.', 'web_url': 'https://www.nytimes.com/2013/07/11/garden/curves-ahead-alpaca-crossing.html', 'snippet': 'A furniture collection by Jiun Ho upholstered in the alpaca textiles of Sandra Jordan.', 'lead_paragraph': 'When the San Francisco-based interior designer Jiun Ho met Sandra Jordan at a design event in 2008, kindred spirits collided. The Malaysian-born Mr. Ho makes minimalist furniture inspired by his global travels. Ms. Jordan, the Peruvian-born daughter of a diplomat, heads a company that distributes luxury alpaca textiles. The result is the Jiun Ho IV Collection, 13 pieces inspired by the designer’s journeys in South America and upholstered in Ms. Jordan’s fabrics.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/11/garden/11FURNITURE_SPAN/11CURR5-articleLarge.jpg', 'height': 256, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/11/garden/11FURNITURE_SPAN/11CURR5-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 256}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/11/garden/11FURNITURE_SPAN/11CURR5-jumbo.jpg', 'height': 438, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/11/garden/11FURNITURE_SPAN/11CURR5-superJumbo.jpg', 'height': 875, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/11/garden/11FURNITURE_SPAN/11CURR5-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStanda