images/2013/07/06/nyregion/WEINER-2/WEINER-articleLarge.jpg', 'height': 342, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/06/nyregion/WEINER-2/WEINER-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 342}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/06/nyregion/WEINER-2/WEINER-jumbo.jpg', 'height': 584, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/06/nyregion/WEINER-2/WEINER-superJumbo.jpg', 'height': 1168, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/06/nyregion/WEINER-2/WEINER-2-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/06/nyregion/WEINER-2/WEINER-2-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/06/nyregion/WEINER-2/WEINER-2-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Weiner’s Surprising Rebound From Scandal', 'kicker': None, 'content_kicker': None, 'print_headline': 'Candidate’s Surprising Rebound From Scandal', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Hernandez, Javier C', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Weiner, Anthony D', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Elections, Mayors', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-07-06T00:24:11+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Javier C. Hernández', 'person': [{'firstname': 'Javier', 'middlename': 'C.', 'lastname': 'Hernández', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/04bef438-39c2-5c12-8811-c8ba7b919f40', 'word_count': 1219, 'uri': 'nyt://article/04bef438-39c2-5c12-8811-c8ba7b919f40'}, {'abstract': 'The N.S.A.’s data-mining has a historical precedent in the federal government’s monitoring of the telegraphs in 1862.', 'web_url': 'https://www.nytimes.com/2013/07/06/opinion/lincolns-surveillance-state.html', 'snippet': 'The N.S.A.’s data-mining has a historical precedent in the federal government’s monitoring of the telegraphs in 1862.', 'lead_paragraph': 'COLCHESTER, Vt. — BY leaking details of the National Security Agency’s data-mining program, Edward J. Snowden revealed that the government’s surveillance efforts were far more extensive than previously understood. Many commentators have deemed the government’s activities alarming and unprecedented. The N.S.A.’s program is indeed alarming — but not, from a historical perspective, unprecedented. And history suggests that we should worry less about the surveillance itself and more about when the war in whose name the surveillance is being conducted will end.', 'print_section': 'A', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Lincoln’s Surveillance State', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'Lincoln’s Surveillance State', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Surveillance of Citizens by Government', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'National Security Agency', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Snowden, Edward J', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Lincoln, Abraham', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Civil War (US) (1861-65)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Stanton, Edwin M (1814-69)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Civil Rights and Liberties', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-07-06T00:25:00+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By David T. Z. Mindich', 'person': [{'firstname': 'David', 'middlename': 'T.', 'lastname': 'Z', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/6fba0240-3f0a-5839-94b3-ae6ccd230f5f', 'word_count': 662, 'uri': 'nyt://article/6fba0240-3f0a-5839-94b3-ae6ccd230f5f'}, {'abstract': 'A 62,000-square-foot mesh banner designed by Paul Britten covers the facade of the hotel and is an architecturally correct rendering of its face.', 'web_url': 'https://www.nytimes.com/2013/07/06/nyregion/the-plaza-hotel-goes-into-hiding-for-a-face-lift.html', 'snippet': 'A 62,000-square-foot mesh banner designed by Paul Britten covers the facade of the hotel and is an architecturally correct rendering of its face.', 'lead_paragraph': 'Angeline Blom biked to the southern half of Grand Army Plaza, between West 58th Street and Central Park South in Manhattan, and pulled out her camera. She snapped the Apple store across Fifth Avenue but not the Plaza Hotel, even though it was right in front of her.', 'print_section': 'A', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/06/nyregion/plaza-1/plaza-1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/06/nyregion/plaza-1/plaza-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo