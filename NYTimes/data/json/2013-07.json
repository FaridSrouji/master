ub': None}, 'keywords': [{'name': 'subject', 'value': 'Consumer Protection', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mobile Applications', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'National Telecommunications and Information Administration', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-07-26T12:13:41+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/32d62429-06d7-5596-80ac-2728cb754244', 'word_count': 303, 'uri': 'nyt://article/32d62429-06d7-5596-80ac-2728cb754244'}, {'abstract': 'Steven Soderbergh, a self-proclaimed retiree from feature filmmaking, will direct the first season of “The Knick,” a Cinemax series set in a New York hospital in 1900 and starring Clive Owen.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/07/26/steven-soderbergh-will-direct-new-cinemax-series-the-knick/', 'snippet': 'Steven Soderbergh, a self-proclaimed retiree from feature filmmaking, will direct the first season of “The Knick,” a Cinemax series set in a New York hospital in 1900 and starring Clive Owen.', 'lead_paragraph': 'If self-proclaimed retiree Steven Soderbergh continues to work any harder he’s going to put himself in the hospital, which maybe was his plan all along. For his latest project since a series of declarations that he was at least stepping away from feature filmmaking, Mr. Soderbergh, the Academy Award-winning director of films like “Traffic” and “Side Effects” and a newly minted Emmy nominee for “Behind the Candelabra,” will direct the first 10-episode season of a new Cinemax series called “The Knick,” set in a New York hospital in the year 1900.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/26/arts/soderbergh/soderbergh-articleLarge.jpg', '