eadline': {'main': 'Quotation of the Day for Saturday, July 6, 2013', 'kicker': None, 'content_kicker': None, 'print_headline': 'Quotation of the Day', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-07-06T01:31:52+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Quote', '_id': 'nyt://article/840472dc-29dc-56aa-8139-67836ccb93e2', 'word_count': 27, 'uri': 'nyt://article/840472dc-29dc-56aa-8139-67836ccb93e2'}, {'abstract': 'Ahmed Kathrada, a longtime anti-apartheid activist and fellow inmate of Nelson Mandela, has shown Robben Island to world leaders and celebrities.', 'web_url': 'https://www.nytimes.com/2013/07/06/world/africa/where-mandela-kept-hope-guide-tells-their-shared-saga.html', 'snippet': 'Ahmed Kathrada, a longtime anti-apartheid activist and fellow inmate of Nelson Mandela, has shown Robben Island to world leaders and celebrities.', 'lead_paragraph': 'CAPE TOWN, South Africa — As Ahmed Kathrada led President Obama and his family recently through the prison on Robben Island where Mr. Kathrada had spent much of his life, he explained how the rules of apartheid had granted him, because of his Indian ancestry, long pants and socks. One of his fellow inmates, Nelson Mandela, as a black man, received short pants and no socks.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/06/world/GUIDE/GUIDE-articleLarge-v3.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/06/world/GUIDE/GUIDE-articleLarge-v3.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/06/world/GUIDE/GUIDE-jumbo-v3.jpg', 'height': 576,