: 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Recognizable Guys You Might Not Recognize', 'kicker': 'Theater Review', 'content_kicker': None, 'print_headline': 'Recognizable Guys You Might Not Recognize', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'The Old Woman (Play)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Dafoe, Willem', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Baryshnikov, Mikhail', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Kharms, Daniil', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Palace Theater', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Pinckney, Darryl', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Wilson, Robert (1941- )', 'rank': 9, 'major': 'N'}], 'pub_date': '2013-07-08T21:03:27+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Theater', 'subsection_name': 'Theater Reviews', 'byline': {'original': 'By Ben Brantley', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Brantley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/a7ffb847-9f79-51a6-9278-98f0556a8a23', 'word_count': 594, 'uri': 'nyt://article/a7ffb847-9f79-51a6-9278-98f0556a8a23'}, {'abstract': 'Antonella Rana is communications director for the international pasta brand Giovanni Rana.', 'web_url': 'https://www.nytimes.com/2013/07/09/business/prayer-and-ritual-in-the-sky.html', 'snippet': 'Antonella Rana is communications director for the international pasta brand Giovanni Rana.', 'lead_paragraph': 'I FLY all the time. Our business is pasta, and since we are an international brand, I have to travel to make sure that everything is going well. When I was younger I loved to travel, but now that I’m a wife and mother I like it a little less. I want to be with my children, so I’m happy when my business trips are done, but I do love seeing new things and meeting new people.', 'print_section': 'B', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/09/business/Flier/Flier-articleLarge.jpg', 'height': 368, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/09/business/Flier/Flier-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 368}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/09/business/Flier/Flier-jumbo.jpg', 'height': 629, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/09/business/Flier/Flier-superJumbo.jpg', 'height': 1257, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/09/business/Flier/Flier-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/09/business/Flier/Flier-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/09/business/Flier/Flier-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'She Has a Prayer, and a Ritual, for the Sky', 'kicker': None, 'content_kicker': None, 'print_headline': 'She Has a Prayer, and a Ritual, for the Sky', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Business Travel', 'rank': 1, 'major': 'N'}, {'nam