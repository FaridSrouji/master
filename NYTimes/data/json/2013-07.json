ess/global/19plane/19plane-jumbo.jpg', 'height': 557, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/19/business/global/19plane/19plane-superJumbo.jpg', 'height': 1115, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/19/business/global/19plane/19plane-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/19/business/global/19plane/19plane-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/19/business/global/19plane/19plane-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'British Inquiry Ties 787 Fire to Beacon', 'kicker': None, 'content_kicker': None, 'print_headline': 'British Inquiry Ties 787 Fire to Beacon', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Drew, Christopher', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Aviation Accidents and Safety', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Boeing Company', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Batteries', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Federal Aviation Administration', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Great Britain', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-07-18T15:02:12+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Christopher Drew', 'person': [{'firstname': 'Christopher', 'middlename': None, 'lastname': 'Drew', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0213d3b1-ef92-5283-91e8-3e884b441648', 'word_count': 1158, 'uri': 'nyt://article/0213d3b1-ef92-5283-91e8-3e884b441648'}, {'abstract': 'When doctors tolerate a culture of disrespect, we aren’t just being insensitive, or obtuse, or lazy, or enabling. We’re in fact violating the first commandment of medicine.', 'web_url': 'https://well.blogs.nytimes.com/2013/07/18/in-a-culture-of-disrespect-patients-lose-out/', 'snippet': 'When doctors tolerate a culture of disrespect, we aren’t just being insensitive, or obtuse, or lazy, or enabling. We’re in fact violating the first commandment of medicine.', 'lead_paragraph': 'I’ve always thought about respect as common decency, something we should do because it’s simply the right thing to do. In the medical world, we certainly need to strive for respectful behavior, especially given our historically rigid pecking order, our ingrained traditions of hierarchical bullying and, of course, a primary constituency — patients — who are often on uniquely vulnerable footing.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/08/health/08well_ofri/08well_ofri-jumbo-v2.jpg', 'height': 455, 'width': 446, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/08/health/08well_ofri/08well_ofri-superJumbo-v2.jpg', 'height': 455, 'width': 446, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/08/health/08well_ofri/08well_ofri-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/08/health/08well_ofri/08well_ofri-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/08/health/08well_ofri/08well_ofri-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In a Culture of Disrespect, Patients Lose Out', 'kicker': 'Well', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Doctors', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Medicine and Health', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-07-18T15:15:59+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Health', 'byline': {'original': 'By Danielle Ofri, M.D', 'person': [{'firstname': 'Danielle', 'middlename': None, 'lastname': 'Ofri', 'qualifier': 'M.D', 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/21431747-c9ba-5de5-ac55-00d1c3e03430', 'word_count': 798, 'uri': 'nyt://article/21431747-c9ba-5de5-ac55-00d1c3e03430'}, {'abstract': 'The Motor City design brand Shinola, which has become revered for its locally manufactured watches, bicycles, leather goods and notebooks, is opening an inviting new flagship store in Tribeca.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2013/07/18/in-store-made-in-detroit-design-now-for-sale-in-new-york-city/', 'snippet': 'The Motor City design brand Shinola, which has become revered for its locally manufactured watches, bicycles, leather goods and notebooks, is opening an inviting new flagship store in Tribeca.', 'lead_paragraph': 'The idea of importing cachet to New York from Detroit might seem counterintuitive. But it makes sense when that cachet is coming from one of the more interesting recent start-ups in the Motor City, which, despite its continuing fiscal woes, has become a magnet for creative enterprise. The design brand Shinola, which started last year and takes its name from an iconic American shoe polish, has quickly acquired cult status for the watches, bicycles, leather goods and notebooks it produces in its downtown Detroit factory. Now, a month after opening a shop in its hometown, the company will introduce its New York flagship store tomorrow at 177 Franklin Street in TriBeCa. Daniel Caudill, the company’s creative director, emphasized that while Shinola is a heritage name, the company itself is a modern one. The space, he said, will feel “as if it had been there a while, but still be modern and clean.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In Store | Made-in-Detroit Design, Now for Sale in New York City', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Shopping and Retail', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Greenpoint (Brooklyn, NY)', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-07-18T15:20:55+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Pilar Viladas', 'person': [{'firstname': 'Pilar', 'middlename': None, 'lastname': 'Viladas', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c506a306-c9ad-5bb9-aa81-0a4abea286dd', 'word_count': 397, 'uri': 'nyt://article/c506a306-c9ad-5bb9-aa81-0a4abea286dd'}, {'abstract': 'A creator of “Homeland” reacts to the show’s latest Emmy nominations and shares his “New Girl” envy.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/07/18/emmy-nominees-alex-gansa-of-homeland/', 'snippet': 'A creator of “Homeland” reacts to the show’s latest Emmy nominations and shares his “New Girl” envy.', 'lead_paragraph': 'Everybody loves an underdog, something that helped “Homeland” when it was an upstart thriller on a premium cable channel that wasn’t HBO. But after the Showtime hit won the Emmy for best drama last year for its debut season, “there was a bit of a target on our backs,” said Alex Gansa, one of the creators.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/18/arts/18artsbeat-gansa/18artsbeat-gansa-articleLarge.jpg', 'height': 837, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/18/arts/18artsbeat-gansa/18artsbeat-gansa-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 837}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/18/arts/18artsbeat-gansa/18artsbeat-gansa-jumbo.jpg', 'height': 1024, 'width': 735, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/18/arts/18artsbeat-gansa/18artsbeat-gansa-superJumbo.jpg', 'height': 2048, 'width': 1469, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/18/arts/18artsbeat-gansa/18artsbeat-gansa-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/18/arts/18artsbeat-gansa/18artsbeat-gansa-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/18/arts/18artsbeat-gansa/18artsbeat-gansa-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 