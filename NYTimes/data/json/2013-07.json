/2013/07/07/business/07-ESSAY/07-ESSAY-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/07/business/07-ESSAY/07-ESSAY-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/business/07-ESSAY/07-ESSAY-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Want Your Data Back? Pay Me', 'kicker': None, 'content_kicker': None, 'print_headline': 'Want Your Data Back? Pay Me', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Surveillance of Citizens by Government', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'National Security Agency', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Privacy', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-07-06T17:46:57+0000', 'document_type': 'article', 'news_desk': 'SundayBusiness', 'section_name': 'Business Day', 'subsection_name': 'Mutual Funds', 'byline': {'original': 'By John Schwartz', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Schwartz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f146cca1-f336-51a8-b962-71c76e312234', 'word_count': 1164, 'uri': 'nyt://article/f146cca1-f336-51a8-b962-71c76e312234'}, {'abstract': 'Out the window of that ’47 Mercury, my father’s dreams rolled by.', 'web_url': 'https://www.nytimes.com/2013/07/07/opinion/sunday/the-song-of-the-suburbs.html', 'snippet': 'Out the window of that ’47 Mercury, my father’s dreams rolled by.', 'lead_paragraph': 'WHEN I was a boy growing up in Mississippi, my father liked to “drive around looking at houses.” That was his expression. We lived in the very center of Jackson, a block from the Capitol building; it was the ’50s, I was 6 and on. I don’t know what my father felt about owning the small red-brick duplex in the older part of town — if he liked it much or didn’t. It is the inner city now, but it was our home then, a place he’d bought so I could be born in it. It was what he could afford. ', 'print_section': 'SR', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/opinion/07driving1/07driving1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/07/opinion/07driving1/07driving1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/opinion/07driving1/07driving1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/opinion/07driving1/07driving1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/opinion/07driving1/07driving1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/07/opinion/07driving1/07driving1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/opinion/07driving1/07driving1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline'