acy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/28/books/review/28seymour/28seymour-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/28/books/review/28seymour/28seymour-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/28/books/review/28seymour/28seymour-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Carrying On', 'kicker': None, 'content_kicker': None, 'print_headline': 'Carrying On', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Feigel, Lara', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Writing and Writers', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'World War II (1939-45)', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Green, Henry', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Bowen, Elizabeth', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Spiel, Hilde', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Greene, Graham', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Macaulay, Rose', 'rank': 11, 'major': 'N'}], 'pub_date': '2013-07-26T15:27:56+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Miranda Seymour', 'person': [{'firstname': 'Miranda', 'middlename': None, 'lastname': 'Seymour', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/5b2592ed-11c9-5a98-b3a9-69ba03650aa6', 'word_count': 1225, 'uri': 'nyt://article/5b2592ed-11c9-5a98-b3a9-69ba03650aa6'}, {'abstract': 'Vikram Seth, currently negotiating over a missed deadline, has good company in testing a publisher’s patience.', 'web_url': 'https://www.nytimes.com/2013/07/28/books/review/better-late-than-never-sometimes.html', 'snippet': 'Vikram Seth, currently negotiating over a missed deadline, has good company in testing a publisher’s patience.', 'lead_paragraph': 'The author Vikram Seth is in hot water for missing a deadline for a sequel to his 1993 novel “A Suitable Boy,” for which he received a $1.7 million advance. One clue for the delay might be found in the previous book’s length: some 1,350 pages. If the follow-up approaches that girth, the need for a bit more time sounds perfectly reasonable.', 'print_section': 'BR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/28/books/review/28openbook/28openbook-articleLarge.jpg', 'height': 213, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/28/books/review/28openbook/28openbook-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 213}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/28/books/review/28openbook/28openbook-jumbo.jpg', 'height': 364, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/28/books/review/28openbook/28openbook-superJumbo.jpg', 'height': 373, 'width': 1049, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/28/books/review/28openbook/28openbook-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/28/books/review/28openbook/28openbook-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/28/books/review/28openbook/28openbook-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Better Late Than Never. Sometimes.', 'kicker': 'Open Book', 'content_kicker': None, 'print_headline': 'Better Late Than Never. Sometimes.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-07-26T15:28:25+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By John Williams', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Williams', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8bb0cff1-aa13-586c-b120-097ace0dd8c3', 'word_count': 409, 'uri': 'nyt://article/8bb0cff1-aa13-586c-b120-097ace0dd8c3'}, {'abstract': 'Writing (and rewriting) his life story, Charles Lindbergh proved himself a skilled memoirist.', 'web_url': 'https://www.nytimes.com/2013/07/28/books/review/flight-logs.html', 'snippet': 'Writing (and rewriting) his life story, Charles Lindbergh proved himself a skilled memoirist.', 'lead_paragraph': 'Published 60 years ago this fall, Charles Lindbergh’s autobiography “The Spirit of St. Louis” was both a commercial and a literary success; it nabbed the 1954 Pulitzer Prize for biography. Indeed, the man known today primarily as the first pilot to fly solo across the Atlantic succeeded in redefining the memoir as we know it. “It has,” the novelist John P. Marquand observed, “a timeless quality and an authentic strength and beauty that should cause it to be read by this generation and by many following — as long, in fact, as anyone is left who cares for fine writing and high courage.” ', 'print_section': 'BR', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/28/books/review/28KENDALL/28KENDALL-jumbo.jpg', 'height': 715, 'width': 596, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/28/books/review/28KENDALL/28KENDALL-superJumbo.jpg', 'height': 715, 'width': 596, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/28/books/review/28KENDALL/28KENDALL-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/28/books/review/28KENDALL/28KENDALL-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/28/books/review/28KENDALL/28KENDALL-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Flight Logs', 'kicker': 'Essay', 'content_kicker': None, 'print_headline': 'Flight Logs', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Lindbergh, Charles A', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Writing and Writers', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-07-26T15:28:38+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Joshua Kendall', 