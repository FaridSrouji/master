son': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Rothenberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/adbd8c67-5491-50c5-88f2-a8e0c6340a74', 'word_count': 581, 'uri': 'nyt://article/adbd8c67-5491-50c5-88f2-a8e0c6340a74'}, {'abstract': 'The brightly colored Milagro Café in Stonington appeals to the eyes as well as the taste buds.', 'web_url': 'https://www.nytimes.com/2013/07/07/nyregion/a-review-of-milagro-cafe-in-stonington.html', 'snippet': 'The brightly colored Milagro Café in Stonington appeals to the eyes as well as the taste buds.', 'lead_paragraph': 'Milagro Café sits in the heart of Stonington Borough, its bold turquoise exterior standing out amid the stately white buildings of Water Street, promising a vibrant alternative to Yankee fare. Inside, half-timbered beams are set in rough-plastered walls painted Halloween orange; mirrors struggle to amplify a truly tiny space. At the bar, we drank margaritas made with homemade tequila infusions ranging from hibiscus to habanero to beet, poured from shakers fashioned out of Kahlua bottles.', 'print_section': 'CT', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/nyregion/07DINECT3/07DINECT3-articleLarge.jpg', 'height': 478, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/07/nyregion/07DINECT3/07DINECT3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 478}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/nyregion/07DINECT3/07DINECT3-jumbo.jpg', 'height': 816, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/nyreg