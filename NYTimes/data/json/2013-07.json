, 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/29/us/JP-DETROIT-1/JP-DETROIT-1-articleLarge.jpg', 'height': 397, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/29/us/JP-DETROIT-1/JP-DETROIT-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 397}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/29/us/JP-DETROIT-1/JP-DETROIT-1-jumbo.jpg', 'height': 677, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/29/us/JP-DETROIT-1/JP-DETROIT-1-superJumbo.jpg', 'height': 1354, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Detroit Looks to Health Law to Ease Costs', 'kicker': None, 'content_kicker': None, 'print_headline': 'Detroit Looks To Health Law To Ease Costs', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Health Insurance and Managed Care', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Patient Protection and Affordable Care Act (2010)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Bankruptcies', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Detroit (Mich)', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-07-29T00:56:35+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Monica Davey and Abby Goodnough', 'person': [{'firstname': 'Monica', 'middlename': None, 'lastname': 'Davey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Abby', 'middlename': None, 'lastname': 'Goodnough', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '