mages/2013/07/14/realestate/14LAGUNA_SPAN/laguna-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In Jersey City, First on the Block With a Rooftop Lounge', 'kicker': None, 'content_kicker': None, 'print_headline': 'First on the Block With a Rooftop Lounge', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Renting and Leasing (Real Estate)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Jersey City (NJ)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'LeFrak Organization', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-07-12T14:28:59+0000', 'document_type': 'article', 'news_desk': 'RealEstate', 'section_name': 'Real Estate', 'byline': {'original': 'By Ronda Kaysen', 'person': [{'firstname': 'Ronda', 'middlename': None, 'lastname': 'Kaysen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8d1dc6d4-3ab4-5b63-9133-23039b3b1de3', 'word_count': 742, 'uri': 'nyt://article/8d1dc6d4-3ab4-5b63-9133-23039b3b1de3'}, {'abstract': 'A writer’s pilgrimage to the Mahabodhi Temple in Bodh Gaya after the recent bomb blasts.', 'web_url': 'https://india.blogs.nytimes.com/2013/07/12/the-buddha-is-smiling-in-bodh-gaya-after-the-recent-bomb-blasts/', 'snippet': 'A writer’s pilgrimage to the Mahabodhi Temple in Bodh Gaya after the recent bomb blasts.', 'lead_paragraph': 'In Bodh Gaya in Bihar, the Buddha sits inside the Mahabodhi Temple with a brilliant crystal bowl in his lap. The Buddha’s gilded figure is placed on a plinth, inside a glass enclosure, rising more than seven feet above human height. His beautiful hooded eyes are downcast, his eyelids and irises lined with a shade that is the blue of water and bright skies. And his full lips are painted pink and fixed, for all eternity, in a quiet, imperturbable smile.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/12/world/americas/12-buddha-statue-IndiaInk/12-buddha-statue-IndiaInk-articleLarge-v4.jpg', 'height': 512, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/12/world/americas/12-buddha-statue-IndiaInk/12-buddha-statue-IndiaInk-articleLarge-v4.jpg', 'xlargewidth': 600, 'xlargeheight': 512}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/12/world/americas/12-buddha-statue-IndiaInk/12-buddha-statue-IndiaInk-jumbo-v4.jpg', 'height': 873, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/12/world/americas/12-buddha-statue-IndiaInk/12-buddha-statue-IndiaInk-superJumbo-v4.jpg', 'height': 996, 'width': 1168, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/12/world/americas/12-buddha-statue-IndiaInk/12-buddha-statue-IndiaInk-thumbStandard-v4.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/12/world/americas/12-buddha-statue-IndiaInk/12-buddha-statue-IndiaInk-thumbStandard-v4.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/12/world/americas/12-buddha-statue-IndiaInk/12-buddha-statue-IndiaInk-thumbLarge-v4.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Buddha Is Smiling in Bodh Gaya', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Buddhism', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Monasteries and Monks', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Police Department (NYC)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Bihar (India)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'India', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Myanmar', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-07-12T14:38:10+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Amitava Kumar', 'person': [{'firstname': 'Amitava', 'middlename': None, 'lastname': 'Kumar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e8497847-c874-57c5-a3e5-2147bf786687', 'word_count': 1505, 'uri': 'nyt://article/e8497847-c874-57c5-a3e5-2147bf786687'}, {'abstract': 'It’s a loveless transaction. Unless it isn’t.', 'web_url': 'https://www.nytimes.com/2013/07/14/magazine/an-illegal-marriage-that-benefits-society.html', 'snippet': 'It’s a loveless transaction. Unless it isn’t.', 'lead_paragraph': 'I know a woman, an undocumented immigrant, who wishes to get married in order to be able to return to Brazil to see her children (after an absence of nearly seven years). She works at a chain store and seems to be there 60 to 80 hours a week. She sends most of her money home to her children. She is always kind, decent and helpful to others. I’ve known her for three years and believe she would be an exemplary American citizen. She has saved money in order to pay someone to marry her; I believe this would be wrong. If I were to marry her, I’d expect nothing. I live alone, have no girlfriend and think this marriage thing would be the morally correct thing to do. What do you think? BOB, MASS.', 'print_section': 'MM', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/02/02/magazine/ethicist/ethicist-articleLarge.jpg', 'height': 1316, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/02/02/magazine/ethicist/ethicist-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 1316}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/02/02/magazine/ethicist/ethicist-jumbo.jpg', 'height': 1024, 'width': 467, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/02/02/magazine/ethicist/ethicist-superJumbo.jpg', 'height': 2048, 'width': 934, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/02/02/magazine/ethicist/ethicist-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/02/02/magazine/ethicist/ethicist-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/02/02/magazine/ethicist/ethicist-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'An Illegal Marriage That Benefits Society?', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Marriage Plot', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Marriages', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Klosterman, Chuck', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Frauds and Swindling', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Ethics (Personal)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Ethicist, The (Times Column)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Illegal Immigration', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-07-12T14:38:19+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Chuck Klosterman', 'person': [{'firstname': 'Chuck', 'middlename': None, 'lastname': 'Klosterman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Question', '_id': 'nyt://article/86082c06-2e90-5b4d-af37-e39357092f90', 'word_count': 540, 'uri': 'nyt://article/86082c06-2e90-5b4d-af37-e39357092f90'}, {'abstract': 'I was a writer. Why couldn’t I help her learn to write?', 'web_url': 'https://www.nytimes.com/2013/07/14/magazine/those-who-cant-teach.html', 'snippet': 'I was a writer. Why couldn’t I help her learn to write?', 'lead_paragraph': 'When mentioning her to friends, I called her my tutee, a pretentious word I’m pretty sure I’ve never heard anyone else use, though it was technically accurate: I was tutoring her. Specifically, I was trying to help her prepare for the English section of the G.E.D. test, which in the past she failed repeatedly.', 'print_section': 'MM', 'print_page': '58', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/14/magazine/14lives1/14lives1-jumbo.jpg', 'height': 413, 'width': 373, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/14/magazine/14lives1/14lives1-superJumbo.jpg', 'height': 413, 'width': 373, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/14/magazine/14lives1/14lives1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/14/magazine/14lives1/14lives1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/14/magazine/14lives1/14lives1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Those Who Can’t Teach', 'kicker': None, 'content_kicker': None, 'print_headline': 'Those Who Can’t Teach', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'General Educational Development Test (GED)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Sittenfeld, Curtis', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Tutors and Tutoring', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Reading and Writing Skills (Education)', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-07-12T14:38:24+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Curtis Sittenfeld', 'person': [{'firstname': 'Curtis', 'middlename': None, 'lastname': 'Sittenfeld', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8c881d6c-cd6d-56f4-84ef-9410f728447f', 'word_count': 772, 'uri': 'nyt://article/8c881d6c-cd6d-56f4-84ef-9410f728447f'}, {'abstract': 'The strange allure of the nonexistent masterpiece.', 'web_url': 'https://www.nytimes.com/2013/07/14/magazine/theres-no-genius-more-unknown-than-the-one-who-never-was.html', 'snippet': 'The strange allure of the nonexistent masterpiece.', 'lead_paragraph': 'You’ve probably never heard of the movie that I’m most excited to see this summer. It’s titled “Thumbscrew,” and was directed by a shadowy auteur named Stanislas Cordova, a secretive genius whose dark art films are intensely studied by rabid fans known as Cordovites. “Thumbscrew” is about a woman who suspects her college-professor husband might be murdering young boys, and by all available accounts, it’s one serious creepfest. According to one person who has seen it, “Thumbscrew” is “an ominous tale of suspicion, paranoia, marriage and the inscrutability of the human psyche.” Cordova’s extensive filmography is so unnerving that there’s even speculation about whether his movies capture actual crimes rather than staged acts of violence.', 'print_section': 'MM', 'print_page': '52', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/14/magazine/14riff/mag-14Riff-t_CA0-articleLarge.jpg', 'height': 99, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/14/magazine/14riff/mag-14Riff-t_CA0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 99}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/14/magazine/14riff/mag-14Riff-t_CA0-jumbo.jpg', 'height': 169, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/14/magazine/14riff/mag-14Riff-t_CA0-superJumbo.jpg', 'height': 337, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/14/magazine/14riff/mag-14Riff-t_CA0-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/14/magazine/14riff/mag-14Riff-t_CA0-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/14/magazine/14riff/mag-14Riff-t_CA0-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘There’s No Genius More Unknown Than the One Who Never Was’', 'kicker': None, 'content_kicker': None, 'print_headline': '‘Falling for Cultural Artifacts That Clever Authors Have Cooked Up’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Brunner, Rob', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Writing and Writers', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Culture (Arts)', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-07-12T14:38:24+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Rob Brunner', 'person': [{'firstname': 'Rob', 'middlename': None, 'lastname': 'Brunner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bf819830-193e-58ff-9e79-2b3b99fc0f2c', 'word_count': 1840, 'uri': 'nyt://article/bf819830-193e-58ff-9e79-2b3b99fc0f2c'}, {'abstract': 'If it comes to a battle of animal slide shows, he’s siding with his daughter.', 'web_url': 'https://www.nytimes.com/2013/07/14/magazine/buzzfeeds-chairman-ken-lerer-doesnt-mind-nepotism.html', 'snippet': 'If it comes to a battle of animal slide shows, he’s siding with his daughter.', 'lead_paragraph': 'Last month you announced your own media aggregator, Stop the N.R.A. Are you applying the BuzzFeed model to your campaign against the National Rifle Association?  I actually did the Web site 12 years ago. We just posted our first piece of original content. We looked at the 2012 U.S. Senate campaigns in which the N.R.A. ranked one candidate over the other; and in 26 races, 20 candidates with the lower N.R.A. rating won. All you have to do is put a crack in the wall, and the wall could come tumbling down.', 'print_section': 'MM', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/14/magazine/14talk/14talk-articleLarge-v2.jpg', 'height': 1769, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/14/magazine/14talk/14talk-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 1769}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/14/magazine/14talk/14talk-jumbo-v2.jpg', 'height': 1024, 'width': 348, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/14/magazine/14talk/14talk-superJumbo-v2.jpg', 'height': 2048, 'width': 695, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/14/magazine/14talk/14talk-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/14/magazine/14talk/14talk-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/14/magazine/14talk/14talk-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'BuzzFeed’s Chairman, Ken Lerer, Doesn’t Mind Nepotism', 'kicker': None, 'content_kicker': None, 'print_headline': "‘Don't Quit Your Day Job’", 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'News and News Media', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'BuzzFeed Inc', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Lerer, Kenneth', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Firearms', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'National Rifle Assn', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Gun Control', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-07-12T14:38:26+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'Interview by Amy Chozick', 'person': [{'firstname': 'Interview', 'middlename': 'Amy', 'lastname': 'Chozick', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Interview', '_id': 'nyt://article/7ae4405b-838e-558f-8c11-4143ac675cdb', 'word_count': 712, 'uri': 'nyt://article/7ae4405b-838e-558f-8c11-4143ac675cdb'}, {'abstract': 'The invention of the “auto-signaling arm.”', 'web_url': 'https://www.nytimes.com/2013/07/14/magazine/who-made-that-turn-signal.html', 'snippet': 'The invention of the “auto-signaling arm.”', 'lead_paragraph': '“A car to me is something that is almost human, something that responds to kindness and understanding and care, just as people do,” the actress Florence Lawrence told a reporter in 1920, when driving had become a symbol of women’s liberation. “The average woman does her own repairing. She is curious enough to investigate every little creak and squak of her car, and to remedy it.” Lawrence herself addressed more than squaks: in 1914, she developed an early version of the turn signal. “I have invented an ‘auto-signaling arm,’ which, when placed on the back of the fender, can be raised or lowered by electrical push buttons,” she told The Green Book Magazine. “The one indicating ‘stop’ works automatically whenever the foot brake is pressed.”', 'print_section': 'MM', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/14/magazine/14wmt-span/14wmt-span-articleLarge.jpg', 'height': 215, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/14/magazine/14wmt-span/14wmt-span-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 215}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/14/magazine/14wmt-span/14wmt-span-jumbo.jpg', 'height': 367, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/14/magazine/14wmt-span/14wmt-span-superJumbo.jpg', 'height': 430, 'width': 1200, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/14/magazine/14wmt-span/14wmt-span-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/14/magazine/14wmt-span/14wmt-span-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/14/magazine/14wmt-span/14wmt-span-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Who Made That Turn Signal?', 'kicker': None, 'content_kicker': None, 'print_headline': 'Who Made That? (Turn Signal)', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Automobile