line': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-07-19T23:30:58+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Mark Kozelek', 'person': [{'firstname': 'Mark', 'middlename': None, 'lastname': 'Kozelek', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fdc8c122-35c3-5f22-b311-07620505b118', 'word_count': 884, 'uri': 'nyt://article/fdc8c122-35c3-5f22-b311-07620505b118'}, {'abstract': 'The United Nations commissioner for human rights said she asked the government to explain the legal basis for detaining the ousted president Mohamed Morsi, who has been incommunicado for weeks.', 'web_url': 'https://www.nytimes.com/2013/07/20/world/middleeast/crowds-march-in-egypt-to-protest-morsi-detention.html', 'snippet': 'The United Nations commissioner for human rights said she asked the government to explain the legal basis for detaining the ousted president Mohamed Morsi, who has been incommunicado for weeks.', 'lead_paragraph': 'CAIRO — Thousands of people, demanding that ousted president Mohamed Morsi be returned to power, marched in several Egyptian cities on Friday, as the United Nations chief human rights official said she had pressed Egypt’s new leaders to provide details about why Mr. Morsi was being detained.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/20/world/cairo1/cairo1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/20/world/cairo1/cairo1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/20/world/cairo1/cairo1-jumbo.jpg', 'height': 682, 'width': 1024, 'sub