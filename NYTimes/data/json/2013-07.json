ba4938-8727-5a4c-a365-bf793f2e9c12', 'word_count': 322, 'uri': 'nyt://article/b9ba4938-8727-5a4c-a365-bf793f2e9c12'}, {'abstract': 'Quotation of the day for Thursday, July 11, 2013.', 'web_url': 'https://www.nytimes.com/2013/07/11/pageoneplus/quotation-of-the-day-for-thursday-july-11-2013.html', 'snippet': 'Quotation of the day for Thursday, July 11, 2013.', 'lead_paragraph': '“Today, having an abortion is safer than an injection of penicillin.”', 'print_section': 'A', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Quotation of the Day for Thursday, July 11, 2013', 'kicker': None, 'content_kicker': None, 'print_headline': 'Quotation of the Day', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-07-11T04:40:13+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Quote', '_id': 'nyt://article/2a85579a-ccaa-562e-8dd8-0c62c7aa7b2a', 'word_count': 44, 'uri': 'nyt://article/2a85579a-ccaa-562e-8dd8-0c62c7aa7b2a'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2013/07/11/arts/television/whats-on-thursday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '8 P.M. (USA) SUMMER CAMP In this new reality series 16 men and women head to a lakeside retreat in California to relive their childhoods through contests inspired by classic camp games. They split into two teams to compete (above), and the losers of the weekly challenge must banish two of their members to the other side. The opponents will then decide which of the two must leave the competition. At the end of the summer the remaining contestants will face off in an Olympic-style “campathalon,” with the winners receiving $250,000 to divide among the contenders. Matt Rogers hosts. In “Burn Notice,” at 9, Michael (Jeffrey Donovan) and a former Russian operative team up to escape Cuba. And in “Graceland,” at 10, Mike (Aaron Tveit) further infiltrates the organization of Bello (Gbenga Akinnagbe), while Briggs (Daniel Sunjata) and Charlie (Vanessa Ferlito) pose as lovers to investigate a drug supplier.', 'print_section': 'C', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s On Thursday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On Thursday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-07-11T05:00:06+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/d183f6c1-d095-5dfd-aedb-d7680a199ae6', 'word_count': 730, 'uri': 'nyt://article/d183f6c1-d095-5dfd-aedb-d7680a199ae6'}, {'abstract': 'Passengers who survived the crash of an Asiana Airlines Boeing 777 in San Francisco on Saturday called 911 to plead for emergency vehicles to tend to them on the airport tarmac, according to audio released late Wednesday night.', 'web_url': 'https://thelede.blogs.nytimes.com/2013/07/11/san-francisco-air-crash-emergency-calls-released/', 'snippet': 'Passengers who survived the crash of an Asiana Airlines Boeing 777 in San Francisco on Saturday called 911 to plead for emergency vehicles to tend to them on the airport tarmac, according to audio released late Wednesday night.', 'lead_paragraph': 'Updated | Thursday, 10: 10 a.m. Emergency calls from those who witnessed the crash of a Boeing 777 at San Francisco International Airport on Saturday, and those who were aboard the plane, emerged late Wednesday, released by the California Highway Patrol, according to reports. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main'