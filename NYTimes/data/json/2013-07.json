maureen-dowd/maureen-dowd-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/maureen-dowd/maureen-dowd-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Time to Hard-Delete Carlos Danger', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': 'Time to Hard-Delete Carlos Danger', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Abedin, Huma', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Dowd, Maureen', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Weiner, Anthony D', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Clinton, Bill', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Clinton, Hillary', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Elections, Mayors', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-07-27T18:30:07+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Maureen Dowd', 'person': [{'firstname': 'Maureen', 'middlename': None, 'lastname': 'Dowd', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/6afe6407-0067-55de-beb2-14677aff3fd3', 'word_count': 830, 'uri': 'nyt://article/6afe6407-0067-55de-beb2-14677aff3fd3'}, {'abstract': 'What do lawyers and wizards have in common? Power.', 'web_url': 'https://www.nytimes.com/2013/07/28/opinion/sunday/the-rules-of-magic.html', 'snippet': 'What do lawyers and wizards have in common? Power.', 'lead_paragraph': '“I WISH I was rich,” says the little boy, just as most of us have wished at least once in our lives. But this little boy has a magic talisman that grants wishes. Instantly, right in front of his distraught siblings, he is transformed into “an elderly gentleman, handsomely but rather dowdily dressed, who was looking down at them through spectacles and asking them the nearest way to the railroad station.” He can’t understand why he finds himself surrounded by unruly children and instead of enjoying his newfound wealth, he heads to his office in London, presumably to make himself still richer.', 'print_section': 'SR', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/28/sunday-review/28MAGIC/28MAGIC-articleLarge.jpg', 'height': 425, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/28/sunday-review/28MAGIC/28MAGIC-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 425}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/28/sunday-review/28MAGIC/28MAGIC-jumbo.jpg', 'height': 725, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/28/sunday-review/28MAGIC/28MAGIC-superJumbo.jpg', 'height': 1450, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/28/sunday-review/28MAGIC/28MAGIC-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/28/sunday-review/28MAGIC/28MAGIC-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/28/sunday-review/28MAGIC/28MAGIC-thumbLarge.jpg', 'height': 150, 'w