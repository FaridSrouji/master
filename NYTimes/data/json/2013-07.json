ine': {'original': 'By Brian Schaefer', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Schaefer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ad13a481-a327-5962-9bbd-88747112c21c', 'word_count': 1135, 'uri': 'nyt://article/ad13a481-a327-5962-9bbd-88747112c21c'}, {'abstract': 'Two members of the Russian activist collective Pussy Riot are not expected to be released until next year.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/07/26/no-parole-for-imprisoned-members-of-pussy-riot/', 'snippet': 'Two members of the Russian activist collective Pussy Riot are not expected to be released until next year.', 'lead_paragraph': 'Updated, July 27 | The two members of the Russian activist collective Pussy Riot who remain imprisoned were both denied parole this week. On Friday, Nadezhda Tolokonnikova was told by a court in Saransk that she had not sufficiently repented for her act of “hooliganism” in performing at a Moscow Orthodox cathedral last year.\xa0 Maria Alyokhina received similar news from a court in Perm on Wednesday. Both are being held in prisons near their courts, and are not expected to be released until next year.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'No Parole for Imprisoned Members of Pussy Riot', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'Members of Pussy Riot Are Denied Parole', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Alyokhina, Maria', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Tolokonnikova, Nadezhda', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Pussy Riot', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Russia', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-07-26T17:38:23+0000', 'document_type': 'article', 'news_desk': '', 'section_nam