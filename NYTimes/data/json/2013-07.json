word_count': 1329, 'uri': 'nyt://article/37a4d9d5-e6ce-57ad-a5c0-beadb2e9b1f4'}, {'abstract': 'Exactly a month after Greece closed the state broadcaster ERT in a cost-cutting move, a bare-bones version of the service is back on the air.', 'web_url': 'https://www.nytimes.com/2013/07/12/world/europe/greece-resumes-official-state-tv-programming.html', 'snippet': 'Exactly a month after Greece closed the state broadcaster ERT in a cost-cutting move, a bare-bones version of the service is back on the air.', 'lead_paragraph': 'ATHENS — Exactly a month after Prime Minister Antonis Samaras of Greece closed the state television network  ERT in a cost-cutting move that almost brought down his fragile coalition government, a bare-bones version of the service was back on the air on Thursday.', 'print_section': 'A', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Greece Resumes Official State TV Programming', 'kicker': None, 'content_kicker': None, 'print_headline': 'Greece: State TV Returns to Air', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Greece', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Kitsantonis, Niki', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'ERT (Hellenic Broadcasting Corp)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Layoffs and Job Reductions', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Labor and Jobs', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-07-11T16:08:53+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Niki Kitsantonis', 'person': [{'firstname': 'Niki', 'middlename': None, 'lastname': 'Kitsantonis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/