well-prevention/well-prevention-superJumbo.jpg', 'height': 215, 'width': 217, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/05/07/health/well-prevention/well-prevention-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/05/07/health/well-prevention/well-prevention-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/05/07/health/well-prevention/well-prevention-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Whooping Cough Vaccine Lags in Efficacy', 'kicker': 'Well', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Whooping Cough', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-07-24T15:39:50+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Health', 'byline': {'original': 'By Nicholas Bakalar', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'Bakalar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/27a191dd-859a-5c2a-b6b9-4675296fab93', 'word_count': 212, 'uri': 'nyt://article/27a191dd-859a-5c2a-b6b9-4675296fab93'}, {'abstract': 'The Senate Republican leader, Mitch McConnell, will not only defend but also highlight his record to appeal to female voters in 2014, his team says.', 'web_url': 'https://www.nytimes.com/2013/07/25/us/politics/mcconnell-campaign-facing-woman-as-challenger-says-it-wont-shy-from-issues.html', 'snippet': 'The Senate Republican leader, Mitch McConnell, will not only defend but also highlight his record to appeal to female voters in 2014, his team says.', 'lead_paragraph': 'WASHINGTON — As Senator Mitch McConnell of Kentucky, a 71-year-old Republican fixture in Washington, prepares to try to fend off a challenge by Alison Lundergan Grimes, a 34-year-old Democratic political newcomer, his team says he will address and even embrace the gender and generational differences between them.', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/25/us/25MCCONNELL-1/25MCCONNELL-1-articleLarge-v2.jpg', 'height': 320, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/25/us/25MCCONNELL-1/25MCCONNELL-1-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 320}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/25/us/25MCCONNELL-1/25MCCONNELL-1-jumbo-v2.jpg', 'height': 546, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/25/us/25MCCONNELL-1/25MCCONNELL-1-superJumbo-v2.jpg', 'height': 1093, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/25/us/25MCCONNELL-1/25MCCONNELL-1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/25/us/25MCCONNELL-1/25MCCONNELL-1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/25/us/25MCCONNELL-1/25MCCONNELL-1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Facing Woman in Race, McConnell Sharpens Pitch to Female Voters', 'kicker': None, 'content_kicker': None, 'print_headline': 'Facing Woman in Race, McConnell Sharpens Pitch to Female Voters', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'McConnell, Mitch', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Elections, Senate', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Grimes, Alison Lundergan', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Kentucky', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-07-24T15:45:16+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Ashley Parker', 'person': [{'firstname': 'Ashley', 'middlename': None, 'lastname': 'Parker', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cfc3e495-4de3-5558-95d4-b42282275a5c', 'word_count': 1230, 'uri': 'nyt://article/cfc3e495-4de3-5558-95d4-b42282275a5c'}, {'abstract': 'A day in the life of armed America.', 'web_url': 'https://nocera.blogs.nytimes.com/2013/07/24/the-gun-report-july-24-2013/', 'snippet': 'A day in the life of armed America.', 'lead_paragraph': 'On July 16, we highlighted the shooting of Darius Simmons, 13, who is black, by his next-door neighbor, John Henry Spooner, 76, who is white, because Spooner suspected Simmons of stealing his shotguns two days after his house had been robbed by unknown assailants. When Simmons denied stealing anything, Spooner shot him in the chest in front of his mother, then fired a second shot as the victim tried to run away. Coming so soon after the not-guilty verdict in the Trayvon Martin trial, the story received some well-deserved publicity. But unlike the Zimmerman verdict, some measure of justice was achieved.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Gun Report: July 24, 2013', 'kicker': 'Joe Nocera', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-07-24T15:48:02+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Jennifer Mascia', 'person': [{'firstname': 'Jennifer', 'middlename': None, 'lastname': 'Mascia', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1faa2804-d8c6-51e8-ab6f-84af252fcaa0', 'word_count': 1118, 'uri': 'nyt://article/1faa2804-d8c6-51e8-ab6f-84af252fcaa0'}, {'abstract': 'Alex Gibney’s film “The Armstrong Lie” includes interviews with the cyclist as well as former teammates and doctors, among others.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/07/24/alex-gibney-documentary-on-lance-armstrong-is-acquired-by-sony-pictures-classics/', 'snippet': 'Alex Gibney’s film “The Armstrong Lie” includes interviews with the cyclist as well as former teammates and doctors, among others.', 'lead_paragraph': 'Oprah Winfrey had her crack at Lance Armstrong, and now it’s Alex Gibney’s turn. On Wednesday, Sony Pictures Classics said it would release a new documentary by Mr. Gibney, the Academy Award-winning director of “Taxi to the Dark Side,” that will tell the story of the disgraced former cycling champion. Lest there be any ambiguity about this film’s disposition toward its subject, it is titled “The Armstrong Lie.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/24/arts/armstrong/armstrong-jumbo.jpg', 'height': 500, 'width': 360, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/24/arts/armstrong/armstrong-superJumbo.jpg', 'height': 500, 'width': 360, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/24/arts/armstrong/armstrong-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/24/arts/armstrong/armstrong-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/24/arts/armstrong/armstrong-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Alex Gibney Documentary on Lance Armstrong Is Acquired by Sony Pictures Classics', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Bicycles and Bicycling', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Documentary Films and Programs', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Doping (Sports)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Tour de France (Bicycle Race)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'ARMSTRONG, LANCE', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Gibney, Alex', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-07-24T15:53:24+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Dave Itzkoff', 'person': [{'firstname': 'Dave', 'middlename': None, 'lastname': 'Itzkoff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0059b2f8-9061-55d6-a859-071afee5254c', 'word_count': 176, 'uri': 'nyt://article/0059b2f8-9061-55d6-a859-071afee5254c'}, {'abstract': 'The chief dance critic of The New York Times recalls being mesmerized by Lynn Seymour and Anthony Dowell in Frederick Ashton’s ballet “A Month in the Country,” introduced in 1976.', 'web_url': 'https://www.nytimes.com/2013/07/25/arts/dance/a-month-in-the-country-as-experienced-at-age-20.html', 'snippet': 'The chief dance critic of The New York Times recalls being mesmerized by Lynn Seymour and Anthony Dowell in Frederick Ashton’s ballet “A Month in the Country,” introduced in 1976.', 'lead_paragraph': 'To calm down, to catch my breath, I had to step out of the Royal Opera House and walk around part of Covent Garden. It was intermission, after a matinee performance of Frederick Ashton’s one-act “A Month in the Country,” the centerpiece of a Royal Ballet program presented in July 1976 in London. The ballet, new earlier that year and entirely new to me, featured Lynn Seymour and Anthony Dowell. And it was hitting me, a young man from a farming family, like a body blow.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/25/arts/FIRSTCRUSH/FIRSTCRUSH-articleLarge.jpg', 'height': 374, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/25/arts/FIRSTCRUSH/FIRSTCRUSH-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 374}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/25/arts/FIRSTCRUSH/FIRSTCRUSH-jumbo.jpg', 'height': 638, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/25/arts/FIRSTCRUSH/FIRSTCRUSH-superJumbo.jpg', 'height': 1276, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/25/arts/FIRSTCRUS