 'keywords': [{'name': 'glocations', 'value': 'Japan', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'ABE, SHINZO', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'International Relations', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'North Korea', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-07-26T12:00:07+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Martin Fackler', 'person': [{'firstname': 'Martin', 'middlename': None, 'lastname': 'Fackler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/55aa3d55-d4d2-50f0-9cf3-8ac5361359d9', 'word_count': 1114, 'uri': 'nyt://article/55aa3d55-d4d2-50f0-9cf3-8ac5361359d9'}, {'abstract': '“Masters of Sex,” a Showtime drama that will have its premiere on Sept. 29, stars Michael Sheen and Lizzy Caplan as the sex researchers Masters and Johnson.', 'web_url': 'https://www.nytimes.com/2013/07/28/arts/television/masters-of-sex-recalls-the-work-of-masters-and-johnson.html', 'snippet': '“Masters of Sex,” a Showtime drama that will have its premiere on Sept. 29, stars Michael Sheen and Lizzy Caplan as the sex researchers Masters and Johnson.', 'lead_paragraph': 'CULVER CITY, Calif. — The set here on Stage 9 at Sony Pictures Studios was a near-perfect duplicate of a suburban American home of the 1950s, with a vintage refrigerator in the kitchen and a stone fireplace in the living room, where a wife clad in a coat and housedress put down her bag of groceries and placed her arms around her hardworking husband at the end of a long day.', 'print_section': 'AR', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlar