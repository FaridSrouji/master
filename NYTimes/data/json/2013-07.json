aption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/15/arts/ROWLING/ROWLING-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'This Detective Novel’s Story Doesn’t Add Up', 'kicker': None, 'content_kicker': None, 'print_headline': 'J. K. Rowling and the Pseudonymous Novel', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Rowling, J K', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Lyall, Sarah', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Sunday Times (British Newspaper)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Names, Personal', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-07-14T13:48:27+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By Sarah Lyall', 'person': [{'firstname': 'Sarah', 'middlename': None, 'lastname': 'Lyall', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e6329275-b308-5123-b687-fa93106e6f46', 'word_count': 1189, 'uri': 'nyt://article/e6329275-b308-5123-b687-fa93106e6f46'}, {'abstract': 'Giving my dates flip nicknames, like The Glamourpuss, was an attempt to keep the whole enterprise at an emotional distance.', 'web_url': 'https://parenting.blogs.nytimes.com/2013/07/14/widowed-and-keeping-dates-like-glamourpuss-and-crunchy-dad-at-a-distance/', 'snippet': 'Giving my dates flip nicknames, like The Glamourpuss, was an attempt to keep the whole enterprise at an emotional distance.', 'lead_paragraph': 'When I finally crawled out of my widow’s cave after more than two years of hibernation and ventured on a series of nerve-racking dates, I could not bring myself to allude to these men by their real names. If my curious teenagers