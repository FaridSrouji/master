le': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8416ce29-d605-5c72-a97a-ee542ad75425', 'word_count': 125, 'uri': 'nyt://article/8416ce29-d605-5c72-a97a-ee542ad75425'}, {'abstract': 'Fifty-four percent said the party should move further to the right.', 'web_url': 'https://takingnote.blogs.nytimes.com/2013/07/31/what-republican-voters-want/', 'snippet': 'Fifty-four percent said the party should move further to the right.', 'lead_paragraph': 'Republican voters have surveyed the wreckage of their party’s 2008 and 2012 presidential tickets and concluded that something important must be done. In a new survey by the Pew Research Center, solid majorities of Republicans said the party needs to “address major problems” (69 percent), which would require shifting positions on some issues (59 percent).', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What Republican Voters Want', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Polls and Public Opinion', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Ryan, Paul D Jr', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Pew Research Center', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-07-31T19:20:45+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Andrew Rosenthal', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Rosenthal', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ec135a22-647b-5f4a-a768-9e7e6325aa95', 'word_count': 376, 'uri': 'nyt://article/ec135a22-647b-5f4a-a768-9e7e6325aa95'}, {'abstract': 'In its semiannual transparency report, the micro-blogging service said it received 1,157 data requests, mostly from government officials in the United States, in the first half of 2013. But the data excludes national security requests, which have become a hot political issue in Washington.', 'web_url': 'https://bits.blogs.nytimes.com/2013/07/31/governments-led-by-u-s-seek-more-data-about-twitter-users/', 'snippet': 'In its semiannual transparency report, the micro-blogging service said it received 1,157 data requests, mostly from government officials in the United States, in the first half of 2013. But the data excludes national security requests, which have ...', 'lead_paragraph': 'The number of requests for Twitter user data from governments around the world continued to grow in the first half of 2013, the microblogging service said in its semiannual transparency report, released Wednesday. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/31/technology/31bits-twitter/31bits-twitter-jumbo.jpg', 'height': 247, 'width': 337, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/31/technology/31bits-twitter/31bits-twitter-superJumbo.jpg', 'height': 247, 'width': 337, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/31/technology/31bits-twitter/31bits-twitter-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/31/technology/31bits-twitter/31bits-twitter-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/31/technology/31bits-twitter/31bits-twitt