e': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Morgan Stanley Announces a Buyback, and Its Shares Rise', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': 'Morgan Stanley Announces a Buyback, and Its Shares Rise ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Company Reports', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Stocks and Bonds', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Gorman, James P', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Morgan Stanley', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-07-18T11:48:42+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Susanne Craig', 'person': [{'firstname': 'Susanne', 'middlename': None, 'lastname': 'Craig', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3870a413-aa07-5486-83f6-fe2b37d96115', 'word_count': 804, 'uri': 'nyt://article/3870a413-aa07-5486-83f6-fe2b37d96115'}, {'abstract': 'A slew of London revivals, from “Othello” to “Private Lives” to “Passion Play,” focus on the idea of married people misbehaving.', 'web_url': 'https://www.nytimes.com/2013/07/21/theater/london-stages-full-of-cheating-hearts.html', 'snippet': 'A slew of London revivals, from “Othello” to “Private Lives” to “Passion Play,” focus on the idea of married people misbehaving.', 'lead_paragraph': 'LONDON — Where would the theater be without adultery? No, no — I mean what happens onstage, not in the wings or dressing rooms. Long before Anna Karenina and Emma Bovary suffered for stepping out on their husbands in two of the greatest novels ever written, theater audiences were held rapt by fatal tales of cheating hearts. Think of Jason and Medea, or Agamemnon and Clytemnestra, or a millennium or so later, Shakespeare’s Othello, for whom just the idea of adultery was enough to bring on a homicidal fury.', 'print_section': 'AR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/21/arts/21LONDON1_SPAN/21LONDON-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/21/arts/21LONDON1_SPAN/21LONDON-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/21/arts/21LONDON1_SPAN/21LONDON-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/21/arts/21LONDON1_SPAN/21LONDON-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/21/arts/21LONDON1_SPAN/21LONDON-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/21/arts/21LONDON1_SPAN/21LONDON-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/21/arts/21LONDON1_SPAN/21LONDON-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Till the Playwright Does Us Part', 'kicker': None, 'content_kicker': None, 'print_headline': 'Till the Playwright Does Us Part', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 2, 'major': 'N'}, {'name':