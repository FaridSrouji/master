ion-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/18/science/18radiation/18radiation-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'New Radiation Therapy Prolongs Prostate Cancer Survival', 'kicker': 'Well', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Bones', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Hormones', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Prostate Cancer', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Radiation', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-07-17T21:00:24+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Health', 'byline': {'original': "By Anahad O'Connor", 'person': [{'firstname': 'Anahad', 'middlename': None, 'lastname': "O'Connor", 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/20842df7-b1d3-5c55-aa96-7a98cb7f394b', 'word_count': 720, 'uri': 'nyt://article/20842df7-b1d3-5c55-aa96-7a98cb7f394b'}, {'abstract': 'The only freshman to win a Heisman Trophy, Texas A&M’s Johnny Manziel said he saw himself as a fun-loving student and not as a celebrity.', 'web_url': 'https://www.nytimes.com/2013/07/18/sports/ncaafootball/johnny-off-season-returns-his-gaze-to-football.html', 'snippet': 'The only freshman to win a Heisman Trophy, Texas A&M’s Johnny Manziel said he saw himself as a fun-loving student and not as a celebrity.', 'lead_paragraph': 'HOOVER, Ala. — The television technician pointed to a spot on the floor behind the makeshift stage and declared: “That’s the line. Stay behind it.” She was ordering back the horde of reporters that was pressing close to Texas A&M quarterback Johnny Manziel. It was the last moment of refuge for the player called Johnny Football.', 'print_section': 'B', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/18/sports/18sec1/18sec1-articleLarge.jpg', 'height': 393, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/18/sports/18sec1/18sec1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 393}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/18/sports/18sec1/18sec1-jumbo.jpg', 'height': 671, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/18/sports/18sec1/18sec1-superJumbo.jpg', 'height': 1343, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/18/sports/18sec1/18sec1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/18/sports/18sec1/18sec1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/18/sports/18sec1/18sec1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Manziel Defends His Whirlwind Off-Season ', 'kicker': None, 'content_kicker': None, 'print_headline': 'Manziel Defends His Whirlwind Off-Season', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football (College)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Glier, Ray', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Southeastern Conference', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Texas A&M University', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Manziel, Johnny', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-07-17T21:01:43+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'College Football', 'byline': {'original': 'By Ray Glier', 'person': [{'firstname': 'Ray', 'middlename': None, 'lastname': 'Glier', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/686480e7-49e2-53c2-b468-547388ce41ab', 'word_count': 816, 'uri': 'nyt://article/686480e7-49e2-53c2-b468-547388ce41ab'}, {'abstract': 'Sweatshirts with a softer message.', 'web_url': 'https://runway.blogs.nytimes.com/2013/07/17/theres-really-no-need-to-shout/', 'snippet': 'Sweatshirts with a softer message.', 'lead_paragraph': 'The thing about those loud, satirical logo tees, or those with words like Bored (a personal favorite, actually) splashed across the front in gold block letters, is that they’ve become rather obnoxious. Right now, those that seem freshest convey a softer message. Acne has sweatshirts for men and women with “Magnetic,” “Mysterious” and “Romantic” on the front. Sonia by Sonia Rykiel put “Bonsoir” on a striped top. And Kiki de Montparnasse has a “Make Love” jersey shirt. It turns out that breezy minus the attitude is exceptionally cool. ', 'print_section': 'E', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'There’s Really No Need to Shout', 'kicker': 'On the Runway', 'content_kicker': None, 'print_headline': 'There’s Really No Need to Shout', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Rykiel, Sonia', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Kiki de Montparnasse', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-07-17T21:04:59+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By ERICA M. BLUMENTHAL', 'person': [{'firstname': 'Erica', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7bddbf7d-1294-5d65-abdc-284be20805e7', 'word_count': 90, 'uri': 'nyt://article/7bddbf7d-1294-5d65-abdc-284be20805e7'}, {'abstract': 'Because it’s going to work.', 'web_url': 'https://krugman.blogs.nytimes.com/2013/07/17/obamacare-is-the-rights-worst-nightmare/', 'snippet': 'Because it’s going to work.', 'lead_paragraph': 'News from New York: it looks as if insurance premiums on the individual market are going to plunge thanks to Obamacare. This shouldn’t come as a surprise; in fact, the New York experience perfectly illustrates why Obamacare had to look the way it does. And it also illustrates why conservatives should be terrified about this legislation, as it takes effect. Americans may have had a lot of misgivings in advance, thanks to vast, deliberately spread misinformation. But I agree with Matt Yglesias — unless the GOP finds even more ways to sabotage the plan, this thing is going to work, it’s going to be extremely popular, and it’s going to wreak havoc with conservative ideology.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Obamacare Is the Right’s Worst Nightmare', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-07-17T21:09:28+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/85221269-0673-5b2a-bf3e-4ccc6420d8c4', 'word_count': 444, 'uri': 'nyt://article/85221269-0673-5b2a-bf3e-4ccc6420d8c4'}, {'abstract': '“The Castle,” Howard Barker’s 1985 play, is making its New York debut in a smart and rowdy production from the Potomac Theater Project.', 'web_url': 'https://www.nytimes.com/2013/07/18/theater/reviews/the-castle-from-the-potomac-theater-project.html', 'snippet': '“The Castle,” Howard Barker’s 1985 play, is making its New York debut in a smart and rowdy production from the Potomac Theater Project.', 'lead_paragraph': 'Everybody has such a good time suffering in “The Castle” that even nonmasochists should be swept up by the ghastly glee of it all. This 1985 play by the British dramatist Howard Barker, making its New York debut in a smart and rowdy production from the Potomac Theater Project, takes us to a time when existence was hard, really hard, and you hadn’t lived properly unless you’d known an evisceration or two. ', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/18/arts/castle-1/castle-1-articleLarge.jpg', 'height': 398, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/18/arts/castle-1/castle-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 398}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/18/arts/castle-1/castle-1-jumbo.jpg', 'height': 679, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/18/arts/castle-1/castle-1-superJumbo.jpg', 'height': 1358, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/18/arts/castle-1/castle-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/18/arts/castle-1/castle-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/18/arts/castle-1/castle-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Back Home After War; Now to Fight', 'kicker': 'Theater Review', 'content_kicker': None, 'print_headline': 'Back Home After War; Now to Fight', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Barker, Howard', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Potomac Theater Project/NYC', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Maxwell, Jan', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Romagnoli, Richard', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Barlow, David', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Van Dyck, Jennifer', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Zukerman, Robert', 'rank': 10, 'major': 'N'}], 'pub_date': '2013-07-17T21:11:43+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Theater', 'subsection_name': 'Theater Reviews', 'byline': {'original': 'By Ben Brantley', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Brantley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/57a4e6ff-5347-5bf0-88d3-035e3f52cca3', 'word_count': 1000, 'uri': 'nyt://article/57a4e6ff-5347-5bf0-88d3-035e3f52cca3'}, {'abstract': 'Reinhard Plank introduces bike caps in three ultrachic colors.', 'web_url': 'https://runway.blogs.nytimes.com/2013/07/17/hide-the-helmet-hair/', 'snippet': 'Reinhard Plank introduces bike caps in three ultrachic colors.', 'lead_paragraph': 'When the bike helmet comes off — and helmets are the coolest — keep your pedal-to-the-metal riding style going with a bike cap from the Italian milliner Reinhard Plank. The cap, with its rounded crown and short brim, is available in beautiful shades of emerald green, gray and navy, and will add to your summery look in an ultrachic way.', 'print_section': 'E', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Hide the Helmet Hair', 'kicker': 'On the Runway', 'content_kicker': None, 'print_headline': 'Hide the Helmet Hair', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Hats and Caps', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-07-17T21:11:49+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By ERICA M. BLUMENTHAL', 'person': [{'firstname': 'Erica', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/06226424-00de-51bd-9b5b-2e8b81afd422', 'word_count': 67, 'uri': 'nyt://article/06226424-00de-51bd-9b5b-2e8b81afd422'}, {'abstract': 'A guidebook being published in August details more than 300 bouldering routes that traverse rock faces throughout Manhattan.', 'web_url': 'https://cityroom.blogs.nytimes.com/2013/07/17/when-rocks-call-a-new-guidebook-will-help-climbers-answer/', 'snippet': 'A guidebook being published in August details more than 300 bouldering routes that traverse rock faces throughout Manhattan.', 'lead_paragraph': 'A long, thin crack runs up a craggy gray slab of rock outcrop overlooking the Hudson River in Fort Tryon Park. Few pay it much attention. Runners jog past. Dogs trot by, occasionally raising a leg. Couples cuddle on a bench nearby.', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/18/nyregion/18cityroom-climbing/18cityroom-climbing-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/18/nyregion/18cityroom-climbing/18cityroom-climbing-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/18/nyregion/18cityroom-climbing/18cityroom-climbing-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/18/nyregion/18cityroom-climbing/18cityroom-climbing-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/18/nyregion/18cityroom-climbing/18cityroom-climbing-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/18/nyregion/18cityroom-climbing/18cityroom-climbing-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/18/nyregion/18cityroom-climbing/18cityroom-climbing-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '300 Manhattan Climbing Routes, and Not One of Them Indoors', '