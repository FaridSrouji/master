ges/2011/11/11/blogs/scuttlebot/scuttlebot-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Today’s Scuttlebot: The Secret Service Sells Fake IDs and Exes in Texts', 'kicker': 'Bits', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-07-22T22:18:21+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/01a384c9-2ca8-5193-9a70-631128b90490', 'word_count': 264, 'uri': 'nyt://article/01a384c9-2ca8-5193-9a70-631128b90490'}, {'abstract': 'This glam bag from Valentino would make the perfect birth present for Kate Middleton.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2013/07/22/feeling-for-a-sexy-clutch-thats-fit-for-a-duchess-and-new-mom/', 'snippet': 'This glam bag from Valentino would make the perfect birth present for Kate Middleton.', 'lead_paragraph': 'Now that the royal baby has finally arrived, I can’t think of a better birth present for Prince William to give the Duchess of Cambridge than this white mink clutch from Valentino. Its leather accent in an appropriately royal shade of blue make it a subtle way to announce, “It’s a boy” (to those living under a rock). With its diminutive size and studded leather handle, it’s the perfect bag to tote around His Royal Highness the Prince of Cambridge’s posh pacifiers.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Feeling For | A Sexy Clutch That’s Fit for a Duchess (and New Mom)', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-07-22T22:30:49+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Edward Barsamian', 'person': [{'firstname': 'Edward', 'middlename': None, 'lastname': 'Barsamian', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/95be7fa0-8a71-5dcd-a9ca-55d27092566f', 'word_count': 89, 'uri': 'nyt://article/95be7fa0-8a71-5dcd-a9ca-55d27092566f'}, {'abstract': 'For the British, the royal birth symbolically perpetuates the endurance of their own country.', 'web_url': 'https://www.nytimes.com/2013/07/23/opinion/britains-baby-bump.html', 'snippet': 'For the British, the royal birth symbolically perpetuates the endurance of their own country.', 'lead_paragraph': 'THE birth of the prince of Cambridge is the worst possible subject for a cynic like me. All we naysayers and pooh-poohers are obliged to stuff a sock in it. You simply cannot, you cannot, be down on the royal baby.', 'print_section': 'A', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/23/opinion/0723OPEDflake/0723OPEDflake-articleLarge.jpg', 'height': 406, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/23/opinion/0723OPEDflake/0723OPEDflake-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 406}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/23/opinion/0723OPEDflake/0723OPEDflake-jumbo.jpg', 'height': 692, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/23/opinion/0723OPEDflake/0723OPEDflake-superJumbo.jpg', 'height': 1385, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/23/opinion/0723