': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/21/magazine/21warriors1/21warriors1-superJumbo-v3.jpg', 'height': 1152, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/21/magazine/21warriors1/21warriors1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/21/magazine/21warriors1/21warriors1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/21/magazine/21warriors1/21warriors1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Sleep-Away Camp for Postmodern Cowboys', 'kicker': None, 'content_kicker': None, 'print_headline': 'Sleep-Away Camp For Postmodern Cowboys', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Eells, Josh', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Jordan', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Terrorism', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-07-19T14:07:06+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Josh Eells', 'person': [{'firstname': 'Josh', 'middlename': None, 'lastname': 'Eells', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/728d1ec5-e9fd-5d9f-8d6d-fd40eda35cd5', 'word_count': 4869, 'uri': 'nyt://article/728d1ec5-e9fd-5d9f-8d6d-fd40eda35cd5'}, {'abstract': 'The plan was to give $10,000 each to the other’s charity of choice. He cheated.', 'web_url': 'https://www.nytimes.com/2013/07/21/magazine/a-donation-deal-goes-awry.html', 'snippet': 'The plan was to give $10,000 each to the other’s charity of choice. He cheated.', 'lead_paragraph': 'I’m on the art-museum board, so that is my preferred artistic donee. An acquaintance repeatedly called me for a donation to the opera. I don’t like opera. I said he should donate to the art museum. He said he’d give to the museum whatever I gave to the opera. We agreed on $10,000 apiece. He called the next four years and offered to make the same deal. I accepted each year. As I was looking through our donor list for unrelated reasons, I discovered he has been giving only $1,000 a year. I sent him an e-mail telling him of my discovery, and he responded, “Nailed me.” As if it were funny. What is my ethical response? Demand my excess back from the opera? Threaten to sue him if he doesn’t pony up to the museum? Gossip?\xa0 T.S., LOCATION WITHHELD', 'print_section': 'MM', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/02/02/magazine/ethicist/ethicist-articleLarge.jpg', 'height': 1316, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/02/02/magazine/ethicist/ethicist-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 1316}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/02/02/magazine/ethicist/ethicist-jumbo.jpg', 'height': 1024, 'width': 467, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/02/02/magazine/ethicist