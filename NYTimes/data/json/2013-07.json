tion': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/21d99a77-f0db-5d71-a1db-d0ac36fbec6c', 'word_count': 0, 'uri': 'nyt://video/21d99a77-f0db-5d71-a1db-d0ac36fbec6c'}, {'abstract': 'The Art Production Fund and Fabiola Beracasa have created an outdoor exhibition that will run from Aug. 1 to Sept. 8.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/07/28/gallery-to-pop-up-in-montauk/', 'snippet': 'The Art Production Fund and Fabiola Beracasa have created an outdoor exhibition that will run from Aug. 1 to Sept. 8.', 'lead_paragraph': 'Now that much of the art world has decamped to the Hamptons for the remainder of the summer, it makes sense that a pop-up gallery would follow. The Art Production Fund and the philanthropist Fabiola Beracasa have created what they are calling an “outdoor pop-up exhibition” located on a vacant lot at 333 Old Montauk Highway, to run Aug. 1 to Sept. 8.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Gallery to Pop Up in Montauk', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'An Outdoor Gallery Pops Up in Montauk', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Art Production Fund', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Hamptons (NY)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Montauk (NY)', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-07-28T16:20:44+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Carol Vogel', 'person': [{'firstname': 'Carol', 'middlename': None, 'lastname': 'Vogel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7b87bdb7-97f1-5bd5-b8fa-56fb6a90eb7b', 'word_count': 135, 'uri': 'nyt://article/7b87bdb7-97f1-5bd5-b8fa-56fb6a90eb7b'}, {'abstract': 'The 20th Century Fox film was No. 1 at North American theaters over the weekend, but fell short of expectations, earning about $55 million.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/07/28/a-tame-box-office-for-the-wolverine/', 'snippet': 'The 20th Century Fox film was No. 1 at North American theaters over the weekend, but fell short of expectations, earning about $55 million.', 'lead_paragraph': 'Wolverine’s claws have been clipped. The hard-working X-Men character was No. 1 at North American theaters over the weekend, with ticket sales of about $55 million, but 20th Century Fox had hoped “The Wolverine” – the sixth installment in this superhero franchise – would take in at least 15 percent more. (Some box office analysts had even predicted an opening-weekend total of $75 million to $85 million.) Fox, which said it spent about $120 million to make the movie, not including marketing costs, hopes that strong interest overseas will make up for the soft reception in the United States and Canada, where audiences are increasingly expressing their fatigue with Hollywood’s recycled formulas by staying home. ', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Tame Box Office for ‘The Wolverine’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'A Tame Box Office for ‘The Wolverine’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'ALLEN, WOODY', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Hollywood.com', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Twentieth Century Fox', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-07-28T16:27:33+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Brooks Barnes', 'person': [{'firstname': 'Brooks', 'middlena