1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/68597cdd-1e48-5fed-b7df-b3d9034f5fb3', 'word_count': 1223, 'uri': 'nyt://article/68597cdd-1e48-5fed-b7df-b3d9034f5fb3'}, {'abstract': 'Beyond rituals and robes, David Butow set out to photograph the essence of spiritual experience among Buddhist monks in several countries.', 'web_url': 'https://lens.blogs.nytimes.com/2013/07/23/the-inner-lives-of-buddhist-monks/', 'snippet': 'Beyond rituals and robes, David Butow set out to photograph the essence of spiritual experience among Buddhist monks in several countries.', 'lead_paragraph': 'When David Butow decided to spend 2012 traveling the world to photograph Buddhism, he knew there would be a rich abundance of visual material: colorful clothing, vibrant decorations and precisely choreographed rituals.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Photographing the Part of Buddhism That Can’t Be Seen', 'kicker': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Buddhism', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Monasteries and Monks', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Butow, David', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-07-23T09:00:42+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By James Estrin', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': 'Estrin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a4f6d46d-3725-5db8-b399-4f49ca840604', 'word_count': 372, 'uri': 'nyt://article/a4f6d46d-3725-5db8-b399-4f49ca840604'}, {'abstract': 'Surfing, skating, hot rodding, tattooing, graffiti: all things that came together to create Southern California’s beachy, colorful, laid-back Kustom Kulture aesthetic. For the rest of the summer a gallery in Huntington Beach, Calif. is displaying pieces from that genre.', 'web_url': 'https://wheels.blogs.nytimes.com/2013/07/23/a-revival-of-kustom-kulture-in-california/', 'snippet': 'Surfing, skating, hot rodding, tattooing, graffiti: all things that came together to create Southern California’s beachy, colorful, laid-back Kustom Kulture aesthetic. For the rest of the summer a gallery in Huntington Beach, Calif. is displaying ...', 'lead_paragraph': 'What do you call the powerful concoction of imagery formed by tattoo art, surf culture, cartoons and hot rods? You call it Kustom Kulture. Fashioned from the tastes and stylistic innovations of ’50s greasers and ’60s hot rodders, Kustom Kulture has continued to evolve, receiving input from other fringe groups along the way: lowriders, punks, bikers, scooterboys and so on.', 'print_section': 'AU', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/22/automobiles/wheels/kustom-kulture/kustom-kulture-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/22/automobiles/wheels/kustom-kulture/kustom-kulture-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/22/automobiles/wheels/kustom-kulture/kustom-kulture-jumbo.jpg', 'height': 577, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/22/automobiles/wheels/kustom-kulture/kustom-kulture-superJumbo.jpg', 'height': 1154, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/22/automobiles/wheels/kustom-kulture/kustom-kulture-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/22/automobiles/wheels/kustom-kulture/kustom-kulture-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/22/automobiles/wheels/kustom-kulture/kustom-kulture-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Revival of Kustom Kulture in California', 'kicker': 'Wheels', 'content_kicker': None, 'print_headline': 'A California Museum\r\nRevives Kustom Kulture', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Automobiles', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Graffiti', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Skateboarding', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Surfing', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'BARRIS, GEORGE', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Hardy, Don Ed', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Z-Boys', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'California', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Huntington Beach (Calif)', 'rank': 10, 'major': 'N'}], 'pub_date': '2013-07-23T10:00:27+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Automobiles', 'byline': {'original': 'By Phil Patton', 'person': [{'firstname': 'Phil', 'middlename': None, 'lastname': 'Patton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'n