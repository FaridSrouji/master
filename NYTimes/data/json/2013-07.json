.nytimes.com/2013/07/06/bencic-adds-wimbledon-title-to-successful-season/', 'snippet': 'Belinda Bencic topped Taylor Townsend in three sets to win the girls’ singles title a month after she captured the French Open girls’ final.', 'lead_paragraph': 'WIMBLEDON, England — For a while Saturday afternoon at Wimbledon, Belinda Bencic’s dream ticket appeared to be slipping away. She won the French Open girls’ title last month, but that final was played on a back court at Roland Garros in front of a smattering of spectators. Wimbledon, on the other hand, offers the juniors a bigger stage, and a slightly star-struck Bencic, 16, walked out onto a packed Court 1 to face the big hitting 17-year-old Taylor Townsend.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Bencic Adds Wimbledon Title to Successful Season', 'kicker': 'Straight Sets', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Tennis', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Wimbledon Tennis Tournament', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Bencic, Belinda', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Hingis, Martina', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Molitor, Melanie', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Townsend, Taylor', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-07-06T19:56:44+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By David Cox', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Cox', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e437f07f-622e-5c35-8f5a-0918c45999df', 'word_count': 611, 'uri': 'nyt://article/e437f07f-622e-5c35-8f5a-0918c45999df'}, {'abstract': 'The Long Island Railroad disability scandal has an infuriating coda.', 'web_url': 'https://www.nytimes.com/2013/07/07/opinion/sunday/payback-on-the-lirr.html', 'snippet': 'The Long Island Railroad disability scandal has an infuriating coda.', 'lead_paragraph': 'For a working schlub who commutes from the suburbs, the Long Island Rail Road disability scandal of 2008 was powerful evidence that the game of life is rigged.', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/sunday-review/07editorialSUB/07editorialSUB-articleLarge.jpg', 'height': 420, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/07/sunday-review/07editorialSUB/07editorialSUB-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 420}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/sunday-review/07editorialSUB/07editorialSUB-jumbo.jpg', 'height': 717, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/sunday-review/07editorialSUB/07editorialSUB-superJumbo.jpg', 'height': 1433, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/sunday-review/07editorialSUB/07editorialSUB-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/07/sunday-review/07editorialSUB/07editorialSUB-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/sunday-review/07editorialSUB/07editorialSUB-thumbLarge.jpg', 'height': 150, 'wid