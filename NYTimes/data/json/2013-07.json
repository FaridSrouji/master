ction.', 'lead_paragraph': 'Music has the power to transport people to another time and place. Invited to name a song that evokes moments of nostalgia, New York Times readers offered more than 150, from Frank Sinatra to Guns N’ Roses. Here is a selection.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/06/24/science/24nostalgia-callout/24nostalgia-callout-articleLarge.jpg', 'height': 398, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/06/24/science/24nostalgia-callout/24nostalgia-callout-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 398}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/06/24/science/24nostalgia-callout/24nostalgia-callout-jumbo.jpg', 'height': 679, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/06/24/science/24nostalgia-callout/24nostalgia-callout-superJumbo.jpg', 'height': 1350, 'width': 2036, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/06/24/science/24nostalgia-callout/24nostalgia-callout-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/06/24/science/24nostalgia-callout/24nostalgia-callout-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/06/24/science/24nostalgia-callout/24nostalgia-callout-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Nostalgia Playlist', 'kicker': None, 'c