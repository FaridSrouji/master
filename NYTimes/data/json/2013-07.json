ubject', 'value': 'Salsa Dancing', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Toro, Yomo', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-07-28T21:24:01+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Mona el Naggar', 'person': [{'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/39e088a0-ef46-5772-90f8-6edef7a6e044', 'word_count': 959, 'uri': 'nyt://article/39e088a0-ef46-5772-90f8-6edef7a6e044'}, {'abstract': 'Festival TBD: Emergency Glitter focused on a new generation of choreographers whose efforts loosely represent a cross section of what is happening in dance today.', 'web_url': 'https://www.nytimes.com/2013/07/29/arts/dance/trespassing-on-the-proving-ground-of-the-next-generation.html', 'snippet': 'Festival TBD: Emergency Glitter focused on a new generation of choreographers whose efforts loosely represent a cross section of what is happening in dance today.', 'lead_paragraph': 'When is the last time so much new dance crept into a New York summer? At Abrons Arts Center, the producer Ben Pryor gave downtown dance a jolt with his inaugural Festival TBD: Emergency Glitter, which ended Sunday, a five-day event focusing on a new generation of choreographers. Their efforts loosely represent a cross-section of what is happening in dance today: A return to full-bodied movement with toes that aren’t afraid to point. Exploring the objectified body with a feminist eye. Showing the formality of a flexed buttock.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/29/arts/emergency1/emergency1-articleLarge.jpg', 'height': 465, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xl