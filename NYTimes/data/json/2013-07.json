umbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/realestate/07mort-gr/07mort-gr-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Pre-Closing Credit Checks', 'kicker': None, 'content_kicker': None, 'print_headline': 'That TV? Buy It After Closing', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Prevost, Lisa', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mortgages', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Credit Scores', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Federal National Mortgage Assn (Fannie Mae)', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-07-05T14:39:46+0000', 'document_type': 'article', 'news_desk': 'RealEstate', 'section_name': 'Real Estate', 'byline': {'original': 'By Lisa Prevost', 'person': [{'firstname': 'Lisa', 'middlename': None, 'lastname': 'Prevost', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/74977007-05f5-588b-8744-8b06db15b3ec', 'word_count': 615, 'uri': 'nyt://article/74977007-05f5-588b-8744-8b06db15b3ec'}, {'abstract': 'In these essays, Chuck Klosterman considers public perceptions of villainy and his affection for con men.', 'web_url': 'https://www.nytimes.com/2013/07/07/books/review/chuck-klostermans-i-wear-the-black-hat.html', 'snippet': 'In these essays, Chuck Klosterman considers public perceptions of villainy and his affection for con men.', 'lead_paragraph': 'Reviewing Edmund Wilson’s “Apologies to the Iroquois,” W. H. Auden suggested that “one of the ways in which an Intellectual Dandy can be recognized is by the unpredictability of his work.” With this in mind, we can certainly. . . . But this is not how one begins a review of a Chuck Klosterman book. One begins a review of a Chuck Klosterman book like this: If Chuck Klosterman were murdered tomorrow by the lead singer of Limp Bizkit — a man he has characterized in print as “rock’s sleaziest baboon” — then “I Wear the Black Hat” would be remembered as his fifth-greatest book. Better?', 'print_section': 'BR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/0707-bks-PARKER/0707-bks-PARKER-articleLarge.jpg', 'height': 689, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/07/books/review/0707-bks-PARKER/0707-bks-PARKER-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 689}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/0707-bks-PARKER/0707-bks-PARKER-jumbo.jpg', 'height': 1024, 'width': 892, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/0707-bks-PARKER/0707-bks-PARKER-superJumbo.jpg', 'height': 1619, 'width': 1409, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/0707-bks-PARKER/0707-bks-PARKER-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/07/books/review/0707-bks-PARKER/0707-bks-PARKER-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/0707-bks-PARKER/0707-bks-PARKER-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Badfellas', 'kicker': None, 'content_kicker': None, 'print_headline': 'Badfellas', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Parker, James', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Klosterman, Chuck', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-07-05T14:39:50+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By James Parker', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': 'Parker', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/4b45d536-ad32-5423-ad38-eaa9ef4a8642', 'word_count': 1180, 'uri': 'nyt://article/4b45d536-ad32-5423-ad38-eaa9ef4a8642'}, {'abstract': 'Franz Kafka’s life was complex and surreal, this second volume of a scholarly biography shows.', 'web_url': 'https://www.nytimes.com/2013/07/07/books/review/kafka-the-years-of-insight-by-reiner-stach.html', 'snippet': 'Franz Kafka’s life was complex and surreal, this second volume of a scholarly biography shows.', 'lead_paragraph': 'Kafka. K. The letter is his alone. He liked the word “Zweifellosigkeit,” which can be awkwardly translated as “indubitableness.” To be true, a work had to be indubitable. He felt his story “The Judgment” to be so. He wrote it in eight hours, almost in ecstasy. “This is the only way to write,” he said. He dedicated it to Felice Bauer, a woman he had recently met at his friend Max Brod’s house. In his diary he describes her as having an “empty face that wore its emptiness openly.” From 1912 to 1917 he wrote hundreds of letters to her. When he stopped corresponding, he dreamed of her as “someone who was dead and could never live again.” He burned her letters when their long engagement was finally broken off; she saved his. They are one of the great unnerving monuments of literature.', 'print_section': 'BR', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/0707-bks-WIlliams1/0707-bks-WIlliams1-articleLarge.jpg', 'height': 457, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/07/books/review/0707-bks-WIlliams1/0707-bks-WIlliams1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 457}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/0707-bks-WIlliams1/0707-bks-WIlliams1-jumbo.jpg', 'height': 780, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/0707-bks-WIlliams1/0707-bks-WIlliams1-superJumbo.jpg', 'height': 1439, 'width': 1889, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/0707-bks-WIlliams1/0707-bks-WIlliams1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/07/books/review/0707-bks-WIlliams1/0707-bks-WIlliams1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/0707-bks-WIlliams1/0707-bks-WIlliams1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Kafkaesque', 'kicker': None, 'content_kicker': None, 'print_headline': 'Kafkaesque', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Kafka, Franz', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Stach, Reiner', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-07-05T14:40:27+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Joy Williams', 'person': [{'firstname': 'Joy', 'middlename': None, 'lastname': 'Williams', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/7f3d41e1-a318-5ada-82a7-523b85357b0e', 'word_count': 2439, 'uri': 'nyt://article/7f3d41e1-a318-5ada-82a7-523b85357b0e'}, {'abstract': 'In the wrong hands, a sturdy, aerodynamic book can do as much harm as good.', 'web_url': 'https://www.nytimes.com/2013/07/07/books/review/clunkers.html', 'snippet': 'In the wrong hands, a sturdy, aerodynamic book can do as much harm as good.', 'lead_paragraph': 'On a recent flight from El Paso to Austin, just before takeoff, I leaned forward to stuff my paperback copy of “The Brothers Karamazov” into the seat pocket. A flight attendant named Susan immediately appeared over my shoulder to scold me for placing the book there, explaining how it could dislodge during the ascent and cause injury. I removed it, pointed to the title and explained to her that if the book — granted, a hefty one — caused an injury, the wound would be spiritual rather than physical. She wasn’t amused (although my seatmate was).', 'print_section': 'BR', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/0707-bks-McWilliams/0707-bks-McWilliams-articleLarge.jpg', 'height': 198, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/07/books/review/0707-bks-McWilliams/0707-bks-McWilliams-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 198}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/0707-bks-McWilliams/0707-bks-McWilliams-jumbo.jpg', 'height': 339, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/0707-bks-McWilliams/0707-bks-McWilliams-superJumbo.jpg', 'height': 678, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/0707-bks-McWilliams/0707-bks-McWilliams-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/07/books/review/0707-bks-McWilliams/0707-bks-McWilliams-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/0707-bks-McWilliams/0707-bks-McWilliams-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Clunkers', 'kicker': 'Essay', 'content_kicker': None, 'print_headline': 'Clunkers', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'McWilliams, James', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'AIRLINES AND AIRPLANES', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-07-05T14:40:31+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By James Mcwilliams', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': 'Mcwilliams', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/23dd09bd-6959-51a2-bdf9-76a3502b04c2', 'word_count': 998, 'uri': 'nyt://article/23dd09bd-6959-51a2-bdf9-76a3502b04c2'}, {'abstract': 'The Renaissance Borgias and their Machiavellian magnetism.', 'web_url': 'https://www.nytimes.com/2013/07/07/books/review/blood-and-beauty-the-borgias-by-sarah-dunant.html', 'snippet': 'The Renaissance Borgias and their Machiavellian magnetism.', 'lead_paragraph': 'On June 29 in the jubilee year of 1500, lightning made a direct hit on Vatican City, striking the roof directly above the corrupt, scheming Spanish-born Pope Alexander VI — better known in our time as Rodrigo Borgia — while he sat on his majestic throne. The blast sent a stone fireplace on a higher floor crashing through the ceiling, leaving His Holiness “engulfed by an avalanche of wood and plaster.” In her evocation of this scene in “Blood and Beauty,” her novel about the notorious Borgias, Sarah Dunant sends papal guards rushing to save their lord, “throwing themselves onto the pile, tearing at the rubble with their bare hands.” ', 'print_section': 'BR', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07SCHILLINGER/07SCHILLINGER-articleLarge.jpg', 'height': 909, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/07/books/review/07SCHILLINGER/07SCHILLINGER-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 909}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07SCHILLINGER/07SCHILLINGER-jumbo.jpg', 'height': 1024, 'width': 677, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07SCHILLINGER/07SCHILLINGER-superJumbo.jpg', 'height': 2048, 'width': 1353, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07SCHILLINGER/07SCHILLINGER-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/07/books/review/07SCHILLINGER/07SCHILLINGER-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07SCHILLINGER/07SCHILLINGER-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Poison, Incest, Intrigue', 'kicker': None, 'content_kicker': None, 'print_headline': 'Poison, Incest, Intrigue', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Schillinger, Liesl', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Dunant, Sarah', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-07-05T14:40:41+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Liesl Schillinger', 'person': [{'firstname': 'Liesl', 'middlename': None, 'lastname': 'Schillinger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/2abf5dc2-8607-5727-9166-c3ba62ad4cb6', 'word_count': 1274, 'uri': 'nyt://article/2abf5dc2-8607-5727-9166-c3ba62ad4cb6'}, {'abstract': 'A chronicle of the 1972 hijacking of Western Airlines Flight 701.', 'web_url': 'https://www.nytimes.com/2013/07/07/books/review/the-skies-belong-to-us-by-brendan-i-koerner.html', 'snippet': 'A chronicle of the 1972 hijacking of Western Airlines Flight 701.', 'lead_paragraph': 'On June 2, 1972, a few minutes before his flight from Los Angeles was scheduled to land in Seattle, a tall, skinny black man in an Army dress uniform walked up the aisle and handed the flight attendant an index card that said he was wired to bomb the plane. Like everything else about the man, his note seemed to veer between the meticulous and the insane. He had drawn a diagram of the bomb he said he was carrying in his briefcase; it was so credible the pilots concluded he had had training in explosives. But his note seemed the product of a manic mind: “Success through Death,” it read, and it said that he had accomplices in the cabin from the violent radical Weatherman group, and the not-violent radical group Students for a Democratic Society. The pilots decided to comply. They asked the man where he wanted to go. North Vietnam, he said.', 'print_section': 'BR', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07WALLACEWELLS/07WALLACEWELLS-articleLarge.jpg', 'height': 503, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/07/books/review/07WALLACEWELLS/07WALLACEWELLS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 503}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07WALLACEWELLS/07WALLACEWELLS-jumbo.jpg', 'height': 858, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07WALLACEWELLS/07WALLACEWELLS-superJumbo.jpg', 'height': 1716, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07WALLACEWELLS/07WALLACEWELLS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/07/books/review/07WALLACEWELLS/07WALLACEWELLS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07WALLACEWELLS/07WALLACEWELLS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Theirs for the Taking', 'kicker': None, 'content_kicker': None, 'print_headline': 'Theirs for the Taking', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Koerner, Brendan I', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Hijacking', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-07-05T14:41:59+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Benjamin Wallace-Wells', 'person': [{'firstname': 'Benjamin', 'middlename': None, 'lastname': 'Wallace-Wells', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/ef634e06-f580-58b1-9afd-0af6e8a68b4b', 'word_count': 1222, 'uri': 'nyt://article/ef634e06-f580-58b1-9afd-0af6e8a68b4b'}, {'abstract': 'Early on, Andrew Hudgins found a comic way to explore taboos.', 'web_url': 'https://www.nytimes.com/2013/07/07/books/review/the-joker-a-memoir-by-andrew-hudgins.html', 'snippet': 'Early on, Andrew Hudgins found a comic way to explore taboos.', 'lead_paragraph': 'Have you heard the one about the poet who couldn’t stop telling jokes, no matter how hoary, juvenile or offensive? Well, you’re about to, because it’s the subject of “The Joker,” Andrew Hudgins’s raw and risky account of a “need to laugh” that can seem “peculiar, immature and even socially corrosive to those who do not share it.” As a memoir, the book is an odd duck in the pond of joke lit, which is populated mostly by psychologists like Freud, folklorists like Gershon Legman and cultural journalists like Jim Holt.', 'print_section': 'BR', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/0707-bks-Greenman/0707-bks-Greenman-articleLarge.jpg', 'height': 862, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/07/books/review/0707-bks-Greenman/0707-bks-Greenman-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 862}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/0707-bks-Greenman/0707-bks-Greenman-jumbo.jpg', 'height': 1024, 'width': 714, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/0707-bks-Greenman/0707-bks-Greenman-superJumbo.jpg', 'height': 2048, 'width': 1427, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/0707-bks-Greenman/0707-bks-Greenman-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/07/books/review/0707-bks-Greenman/0707-bks-Greenman-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/0707-bks-Greenman/0707-bks-Greenman-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Was It Something I Said?', 'kicker': None, 'content_kicker': None, 'print_headline': 'Was It Something I Said?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Hudgins, Andrew', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Comedy and Humor', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-07-05T14:42:01+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Ben Greenman', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Greenman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/529f8571-22f9-5528-bb5f-6a1c903f0958', 'word_count': 1390, 'uri': 'nyt://article/529f8571-22f9-5528-bb5f-6a1c903f0958'}, {'abstract': 'A dipsomaniac writes a bar guide in Thomas Kennedy’s novel.', 'web_url': 'https://www.nytimes.com/2013/07/07/books/review/kerrigan-in-copenhagen-by-thomas-e-kennedy.html', 'snippet': 'A dipsomaniac writes a bar guide in Thomas Kennedy’s novel.', 'lead_paragraph': 'The essay, the guidebook, the love story, the comforting exchange of facts in a bewildering world of emotion — all are to be found in Thomas E. Kennedy’s “Kerrigan in Copenhagen.” The novel’s title character, Terrence Kerrigan, is an American expat whose pregnant wife packed up their 2-year-old daughter and vanished, leaving him to eke out a somewhat intellectual and definitely dipsomaniacal middle age in the archly named “serving houses” of Denmark’s capital city. The year is 1999, and Kerrigan has been hired to write a guide to the 100 best bars in town. The result is a spiraling exploration of alcohol, history, literature, art and jazz — and Kerrigan’s wounded psyche. ', 'print_section': 'BR', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07COKAL/07COKAL-articleLarge.jpg', 'height': 714, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/07/books/review/07COKAL/07COKAL-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 714}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07COKAL/07COKAL-jumbo.jpg', 'height': 1024, 'width': 861, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07COKAL/07COKAL-superJumbo.jpg', 'height': 1894, 'width': 1591, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07COKAL/07COKAL-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/07/books/review/07COKAL/07COKAL-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07COKAL/07COKAL-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Soused', 'kicker': None, 'content_kicker': None, 'print_headline': 'Soused', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Kennedy, Thomas E', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-07-05T14:42:02+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Susann Cokal', 'person': [{'firstname': 'Susann', 'middlename': None, 'lastname': 'Cokal', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/6146b24a-a02f-598d-bc93-cc20b1ed4389', 'word_count': 625, 'uri': 'nyt://article/6146b24a-a02f-598d-bc93-cc20b1ed4389'}, {'abstract': 'Jincy Willett’s heroine, a reclusive novelist, gets her 15 minutes.', 'web_url': 'https://www.nytimes.com/2013/07/07/books/review/amy-falls-down-a-novel-by-jincy-willett.html', 'snippet': 'Jincy Willett’s heroine, a reclusive novelist, gets her 15 minutes.', 'lead_paragraph': 'Most of us have dreams of glory, imagining those 15 minutes when everybody who’s anybody knows who we are and what we’re famous for. Writers are particularly susceptible to this fantasy. And now that the Internet spreads the news even before it happens, our pirouette in the spotlight seems closer than ever. ', 'print_section': 'BR', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07SUBREED/07SUBREED-jumbo.jpg', 'height': 601, 'width': 459, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07SUBREED/07SUBREED-superJumbo.jpg', 'height': 601, 'width': 459, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07SUBREED/07SUBREED-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/07/books/review/07SUBREED/07SUBREED-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07SUBREED/07SUBREED-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Altered Ego', 'kicker': None, 'content_kicker': None, 'print_headline': 'Altered Ego', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Willett, Jincy', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-07-05T14:42:08+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Kit Reed', 'person': [{'firstname': 'Kit', 'middlename': None, 'lastname': 'Reed', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/3d240a5f-8ed4-58a4-94e1-57206e3e16c0', 'word_count': 618, 'uri': 'nyt://article/3d240a5f-8ed4-58a4-94e1-57206e3e16c0'}, {'abstract': 'In Lori Roy’s novel “Until She Comes Home,” a murder shakes up life in a working-class Detroit neighborhood in 1958.', 'web_url': 'https://www.nytimes.com/2013/07/07/books/review/lori-roys-until-she-comes-home-and-more.html', 'snippet': 'In Lori Roy’s novel “Until She Comes Home,” a murder shakes up life in a working-class Detroit neighborhood in 1958.', 'lead_paragraph': 'If you really want to know what shape your hometown is in, just take a good look at the street you live on, trying to see it as a stranger might. That’s the simple, heartbreaking truth Lori Roy delivers, sotto voce, in UNTIL SHE COMES HOME (Dutton, $26.95), a quietly shocking account of the tiny tremors in the life of a city that warn of cataclysms to come.', 'print_section': 'BR', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/0707-bks-CRIME/0707-bks-CRIME-articleLarge.jpg', 'height': 602, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/07/books/review/0707-bks-CRIME/0707-bks-CRIME-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 602}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/0707-bks-CRIME/0707-bks-CRIME-jumbo.jpg', 'height': 1024, 'width': 1022, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/0707-bks-CRIME/0707-bks-CRIME-superJumbo.jpg', 'height': 1416, 'width': 1412, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/0707-bks-CRIME/0707-bks-CRIME-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/07/books/review/0707-bks-CRIME/0707-bks-CRIME-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/0707-bks-CRIME/0707-bks-CRIME-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Missing in Motown', 'kicker': None, 'content_kicker': None, 'print_headline': 'Missing in Motown', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Roy, Lori', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Piccirilli, Tom', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Hiebert, Michael', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Holt, Jonathan', 'rank': 10, 'major': 'N'}], 'pub_date': '2013-07-05T14:42:08+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Marilyn Stasio', 'person': [{'firstname': 'Marilyn', 'middlename': None, 'lastname': 'Stasio', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/e77dee01-11fe-5e49-b8bc-9ab841b98f04', 'word_count': 912, 'uri': 'nyt://article/e77dee01-11fe-5e49-b8bc-9ab841b98f04'}, {'abstract': 'It’s wedding season, and Elin Hilderbrand’s “Beautiful Day,” No. 7 on the hardcover fiction list, features a bunch of cynics at a Nantucket Island ceremony.', 'web_url': 'https://www.nytimes.com/2013/07/14/books/review/inside-the-list.html', 'snippet': 'It’s wedding season, and Elin Hilderbrand’s “Beautiful Day,” No. 7 on the hardcover fiction list, features a bunch of cynics at a Nantucket Island ceremony.', 'lead_paragraph': 'BRIDE AND DOOM: It’s wedding season, and blissed-out newlyweds face very different challenges in two newcomers to the hardcover fiction list. In Elin Hilderbrand’s “Beautiful Day,” at No. 7, the guests who descend on a perfect Nantucket Island wedding turn out to be a bunch of cynics whose own marriages have imploded or are about to. “Margot wondered if all family wedding weekends were doomed to be exercises in painful self-\xadexamination,” Hilderbrand writes of the maid of honor, who at 40 might be expected to know that most family occasions are exercises in painful self-\xadexamination. Oh, well. Hilderbrand has lived for two decades on Nantucket, where all 12 of her novels are set, and she understands that readers turn to her mainly for glimpses of “East Coast Yankee blue-blood privilege and elitism at its very finest,” which she provides in silver-plated bucket loads. “Beautiful Day” is her seventh consecutive best seller.', 'print_section': 'BR', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07insidelist/07insidelist-jumbo.jpg', 'height': 450, 'width': 451, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07insidelist/07insidelist-superJumbo.jpg', 'height': 450, 'width': 451, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07insidelist/07insidelist-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/07/books/review/07insidelist/07insidelist-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07insidelist/07insidelist-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Inside the List', 'kicker': None, 'content_kicker': None, 'print_headline': 'TBR: Inside the List', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-07-05T14:42:13+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Gregory Cowles', 'person': [{'firstname': 'Gregory', 'middlename': None, 'lastname': 'Cowles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/777620af-4e17-5494-9424-2a671d40006e', 'word_count': 609, 'uri': 'nyt://article/777620af-4e17-5494-9424-2a671d40006e'}, {'abstract': 'In this novel, an Argentine born in the 1970s attempts to “solve the puzzle” of his father’s life.', 'web_url': 'https://www.nytimes.com/2013/07/07/books/review/my-fathers-ghost-is-climbing-in-the-rain-by-patricio-pron.html', 'snippet': 'In this novel, an Argentine born in the 1970s attempts to “solve the puzzle” of his father’s life.', 'lead_paragraph': 'In the 1970s, during the years that Argentina’s last military dictatorship was busy raping, torturing and killing thousands of the country’s citizens, a large obelisk in Buenos Aires was adorned with this menacing piece of advice: \xad“Silence is health.” That dictatorship ended in 1983, but no one recovers quickly from a bludgeon, especially not a child. The Argentine novelist Patricio Pron was born in 1975, a year before the Dirty War began. The nameless narrator of his artful novel “My Fathers’ Ghost Is Climbing in the Rain” isn’t merely silent; he’s erased. ', 'print_section': 'BR', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07SUBVALDES/07SUBVALDES-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/07/books/review/07SUBVALDES/07SUBVALDES-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07SUBVALDES/07SUBVALDES-jumbo.jpg', 'height': 680, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07SUBVALDES/07SUBVALDES-superJumbo.jpg', 'height': 1360, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07SUBVALDES/07SUBVALDES-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/07/books/review/07SUBVALDES/07SUBVALDES-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07SUBVALDES/07SUBVALDES-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What Did You Do in the Dirty War?', 'kicker': None, 'content_kicker': None, 'print_headline': 'What Did You Do in the Dirty War?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Valdes, Marcela', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Pron, Patricio', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-07-05T14:42:13+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Marcela Valdes', 'person': [{'firstname': 'Marcela', 'middlename': None, 'lastname': 'Valdes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/c04e1047-173b-504a-a09b-cd79b06ac8c0', 'word_count': 1253, 'uri': 'nyt://article/c04e1047-173b-504a-a09b-cd79b06ac8c0'}, {'abstract': 'John Gray reimagines our place in the world.', 'web_url': 'https://www.nytimes.com/2013/07/07/books/review/john-grays-silence-of-animals.html', 'snippet': 'John Gray reimagines our place in the world.', 'lead_paragraph': 'John Gray’s “Silence of Animals” is an attack on humanism. He condemns this widely accepted secular faith as a form of delusional self-flattery.', 'print_section': 'BR', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07nagel/07nagel-articleLarge.jpg', 'height': 1013, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/07/books/review/07nagel/07nagel-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 1013}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07nagel/07nagel-jumbo.jpg', 'height': 1013, 'width': 600, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07nagel/07nagel-superJumbo.jpg', 'height': 1013, 'width': 600, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07nagel/07nagel-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/07/books/review/07nagel/07nagel-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/07/books/review/07nagel/07nagel-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline'