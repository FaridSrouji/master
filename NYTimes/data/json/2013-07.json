': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Adirondack Park (NY)', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-07-23T01:26:08+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Jesse McKinley', 'person': [{'firstname': 'Jesse', 'middlename': None, 'lastname': 'McKinley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/47f21958-0c7d-5e40-b3a7-7c405da12376', 'word_count': 794, 'uri': 'nyt://article/47f21958-0c7d-5e40-b3a7-7c405da12376'}, {'abstract': 'Lottery numbers for New York, New Jersey and Connecticut.', 'web_url': 'https://www.nytimes.com/2013/07/23/nyregion/lottery-numbers.html', 'snippet': 'Lottery numbers for New York, New Jersey and Connecticut.', 'lead_paragraph': 'July 22, 2013', 'print_section': 'A', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Lottery Numbers', 'kicker': None, 'content_kicker': None, 'print_headline': 'Lottery Numbers', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Lotteries', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'New York State', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New Jersey', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Connecticut', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-07-23T01:37:19+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'List', '_id': 'nyt://article/ba352b38-6f40-57c2-acdc-19ce595e6423', 'word_count': 179, 'uri': 'nyt://article/ba352b38-6f40-57c2-acdc-19ce595e6423'}, {'abstract': 'For the first time, the Pentagon provided explicit details to Congress about the logistics, costs and risks of options for intervening in Syria’s two-and-a-half-year-old war.', 'web_url': 'https://www.nytimes.com/2013/07/23/world/middleeast/pentagon-outlining-options-to-congress-suggests-syria-campaign-would-be-costly.html', 'snippet': 'For the first time, the Pentagon provided explicit details to Congress about the logistics, costs and risks of options for intervening in Syria’s two-and-a-half-year-old war.', 'lead_paragraph': 'WASHINGTON — The Pentagon has provided Congress with its first detailed list of military options to stem the bloody civil war in Syria, suggesting that a campaign to tilt the balance from President Bashar al-Assad to the opposition would be a vast undertaking, costing billions of dollars, and could backfire on the United States.', 'print_section': 'A', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/23/world/middleeast/DIPLO/DIPLO-REFER-articleLarge.jpg', 'height': 392, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/23/world/middleeast/DIPLO/DIPLO-REFER-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 392}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/23/world/middleeast/DIPLO/DIPLO-REFER-jumbo.jpg', 'height': 669, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/23/world/middleeast/DIPLO/DIPLO-REFER-superJumbo.jpg', 'height': 1339, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/23/world/middleeast/DIPLO/DIPLO-REFER-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'image