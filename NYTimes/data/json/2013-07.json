and the interplay between them felt comfortable, if not quite cozy.', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/27/arts/trio/trio-articleLarge.jpg', 'height': 384, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/27/arts/trio/trio-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 384}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/27/arts/trio/trio-jumbo.jpg', 'height': 655, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/27/arts/trio/trio-superJumbo.jpg', 'height': 1310, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/27/arts/trio/trio-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/27/arts/trio/trio-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/27/arts/trio/trio-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Taking Collaboration to a Whole New Level', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Taking Collaboration To a Whole New Level', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Hersch, Fred', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Lovano, Joe', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Village Vanguard', 'rank': 4, 'ma