CTION-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/29/sports/INDUCTION/INDUCTION-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/29/sports/INDUCTION/INDUCTION-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Only Echoes Stir the Quiet at the Hall of Fame', 'kicker': None, 'content_kicker': None, 'print_headline': 'Only Echoes of Past Glory Stir the Quiet at Cooperstown', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Baseball Hall of Fame', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Doping (Sports)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Cooperstown (NY)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'White, Deacon (1847-1939)', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': "O'Day, Hank (1859-1935)", 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Ruppert, Jacob (1867-1939)', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-07-29T00:57:40+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Richard Sandomir', 'person': [{'firstname': 'Richard', 'middlename': None, 'lastname': 'Sandomir', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8e9970ed-b548-501a-8c05-76d60ed58409', 'word_count': 1243, 'uri': 'nyt://article/8e9970ed-b548-501a-8c05-76d60ed58409'}, {'abstract': 'Because of methane leaks, shale gas is not a “bridge” to a renewable energy future — it’s a gangplank to more warming and away from truly clean energy investments.', 'web_url': 'https://www.nytimes.com/2013/07/29/opinion/gangplank-to-a-warm-future.html', 'snippet': 'Because of methane leaks, shale gas is not a “bridge” to a renewable energy future — it’s a gangplank to more warming and away from truly clean energy investments.', 'lead_paragraph': 'ITHACA, N.Y. — MANY concerned about climate change, including President Obama, have embraced hydraulic fracturing for natural gas. In his recent climate speech, the president went so far as to lump gas with renewables as “clean energy.” ', 'print_section': 'A', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Gangplank to a Warm Future', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'Gangplank To a Warm Future', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Ingraffea, Anthony R', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Greenhouse Gas Emissions', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Methane', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Shale', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Hydraulic Fracturing', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Alternative and Renewable Energy', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Natural Gas', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-07-29T01:07:03+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Anthony R. Ingraffea', 'person': [{'firstname': 'Anthony', 'middlename': 'R.', 'lastname': 'Ingraffea', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/eb2cf0b3-b2e7-55e3-9626-1f0e2583ceae', 'word_count': 753, 'uri': 'nyt://article/eb2cf0b3-b2e7-55e3-9626-1f0e2583ceae'}, {'abstract': 'As God — along with Bach, Beethoven and Mozart — is my witness, you cannot “reach” a crescendo.', 'web_url': 'https://www.nytimes.com/2013/07/29/opinion/a-crescendo-of-errors.html', 'snippet': 'As God — along with Bach, Beethoven and Mozart — is my witness, you cannot “reach” a crescendo.', 'lead_paragraph': 'FITZGERALD did it. Can you believe that? And in “Gatsby,” no less. It sent me reeling. The historian James M. McPherson did it in “Battle Cry of Freedom.” Twice. George F. Will, William Safire and countless other prominent journalists have done it, as have Southern writers, Northern writers, writers of science and of science fiction, novices and old pros.', 'print_section': 'A', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Crescendo of Errors', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'A Crescendo of Errors', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Writing and Writers', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Hoffman, Miles', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'English Language', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-07-29T01:07:57+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Miles Hoffman', 'person': [{'firstname': 'Miles', 'middlename': None, 'lastname': 'Hoffman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/a6725f2e-666f-5ff0-bee1-dd20561f58be', 'word_count': 489, 'uri': 'nyt://article/a6725f2e-666f-5ff0-bee1-dd20561f58be'}, {'abstract': 'The merger of Omnicom and Publicis signals that advertising is now firmly in the business of collecting and selling the personal information of millions of consumers.', 'web_url': 'https://www.nytimes.com/2013/07/29/business/media/two-ad-giants-in-merger-deal-chasing-google.html', 'snippet': 'The merger of Omnicom and Publicis signals that advertising is now firmly in the business of collecting and selling the personal information of millions of consumers.', 'lead_paragraph': 'For years, the advertising business has been driven by the Madison Avenue mythology of small independent shops coming up with the snappy catchphrase or memorable TV commercial that becomes part of everyday culture.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Two Ad Giants Chasing Google in Merger Deal', 'kicker': None, 'content_kicker': None, 'print_headline': 'Two Ad Giants Chasing Google In Merger Deal', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Vega, Tanzina', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mergers, Acquisitions and Divestitures', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Publicis Groupe', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Omnicom Group Inc', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Data-Mining and Database Marketing', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-07-29T01:09:33+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Tanzina Vega', 'person': [{'firstname': 'Tanzina', 'middlename': None, 'lastname': 'Vega', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a3353775-2591-5223-b21b-a0d3827c97ac', 'word_count': 1210, 'uri': 'nyt://article/a3353775-2591-5223-b21b-a0d3827c97ac'}, {'abstract': 'A court in Kiev fined three activists o