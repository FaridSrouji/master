ne': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Text', '_id': 'nyt://article/c5f3eb47-4058-551e-bf8f-9663861637b6', 'word_count': 258, 'uri': 'nyt://article/c5f3eb47-4058-551e-bf8f-9663861637b6'}, {'abstract': 'A special committee of Dell’s board is poised to adjourn the vote on Thursday morning because it is concerned that the offer may be defeated by shareholders, people briefed on the matter said on Tuesday.', 'web_url': 'https://dealbook.nytimes.com/2013/07/16/worried-about-defeat-for-dell-offer-board-and-bidders-prepare-maneuvers/', 'snippet': 'A special committee of Dell’s board is poised to adjourn the vote on Thursday morning because it is concerned that the offer may be defeated by shareholders, people briefed on the matter said on Tuesday.', 'lead_paragraph': 'July 17, 5:05 p.m. | Updated ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Worried About Defeat for Dell Offer, Board and Bidders Prepare Maneuvers', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Mergers, Acquisitions and Divestitures', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Dell, Michael S', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Icahn, Carl C', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Dell Inc', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Silver Lake Partners', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Southeastern Asset Management', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-07-16T23:51:44+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Michael J. de la Merced', 'person': [{'firstname': 'Michael', 'middlename': 'J.', 'lastname': 'de la Merced', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e0c6e1bd-799a-541a-a316-c93b2f1ceb03', 'word_count': 666, 'uri': 'nyt://article/e0c6e1bd-799a-541a-a316-c93b2f1ceb03'}, {'abstract': 'Ms. Cheney, the older daughter of former Vice President Dick Cheney, announced an intent to run, setting up a Republican primary clash next year that party officials had hoped to avoid.', 'web_url': 'https://www.nytimes.com/2013/07/17/us/politics/liz-cheney-to-challenge-senator-michael-enzi-of-wyoming.html', 'snippet': 'Ms. Cheney, the older daughter of former Vice President Dick Cheney, announced an intent to run, setting up a Republican primary clash next year that party officials had hoped to avoid.', 'lead_paragraph': 'WASHINGTON — Liz Cheney, the older daughter of former Vice President Dick Cheney, announced Tuesday that she intended to challenge Senator Michael B. Enzi of Wyoming in a Republican primary clash in next year that national and state party officials had hoped to avoid.', 'print_section': 'A', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Liz Cheney to Challenge Senator Michael Enzi of Wyoming', 'kicker': None, 'content_kicker': None, 'print_headline': 'Liz Cheney\r\nTo Challenge\r\nG.O.P. Senator\r\nIn Wyoming', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Martin, Jonathan', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Cheney, Liz', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Enzi, Michael B', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Wyoming', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Elections, Senate', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-07-16T23:54:34+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Jonathan Martin', 'person': [{'firstname': 'Jonathan', 'middlename': None, 'lastname': 'Martin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/99a2b79b-fe6b-5892-b8dd-2ffd21e5007e', 'word_count': 849, 'uri': 'nyt://article/99a2b79b-fe6b-5892-b8dd-2ffd21e5007e'}, {'abstract': 'After a year of siege, the city of Homs in central Syria may well be the site of the most concentrated destruction in the country.', 'web_url': 'https://www.nytimes.com/2013/07/17/world/middleeast/ruins-in-a-center-of-syrias-uprising.html', 'snippet': 'After a year of siege, the city of Homs in central Syria may well be the site of the most concentrated destruction in the country.', 'lead_paragraph': 'BEIRUT, Lebanon — Little by little, the central Syrian city of Homs is losing its infrastructure and its landmarks. The national hospital lies in ruins. Rebel-held neighborhoods stretch for blocks without an intact building. Many government offices are closed. The silver-domed mosque of Khalid bin al-Waleed — named for an early Islamic warrior particularly revered by Sunnis — stands pockmarked and perforated.', 'print_section': 'A', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/17/world/0917HOMS01/0917HOMS01-articleLarge.jpg', 'height': 423, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/07/17/world/0917HOMS01/0917HOMS01-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 423}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/17/world/0917HOMS01/0917HOMS01-jumbo.jpg', 'height': 722, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/17/world/0917HOMS01/0917HOMS01-superJumbo.jpg', 'height': 1445, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/17/world/0917HOMS01/0917HOMS01-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/07/17/world/0917HOMS01/0917HOMS01-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/07/17/world/0917HOMS01/0917HOMS01-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Ruins in a Center of Syria’s Uprising', 'kicker': None, 'content_kicker': None, 'print_headline': 'Ruins in a Center of Syria’s Uprising', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Middle East and North Africa Unrest (2010- )', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Homs (Syria)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Assad, Bashar al-', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Free Syrian Army', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Syria', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-07-16T23:57:46+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Anne Barnard and an Employee of The New York Times', 'person': [{'firstname': 'Anne', 'middlename': None, 'lastname': 'Barnard', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_materia