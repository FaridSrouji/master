, 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Sony Corporation', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Dish Network', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-07-24T19:22:11+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Brian Stelter', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Stelter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a617972c-25f3-5c40-a2bc-e68edf3c33fe', 'word_count': 570, 'uri': 'nyt://article/a617972c-25f3-5c40-a2bc-e68edf3c33fe'}, {'abstract': 'Was this the best first half of a year for private-sector jobs since 1999, as President Obama claimed in his speech on the economy? Well, sort of.', 'web_url': 'https://economix.blogs.nytimes.com/2013/07/24/strongest-since-1999/', 'snippet': 'Was this the best first half of a year for private-sector jobs since 1999, as President Obama claimed in his speech on the economy? Well, sort of.', 'lead_paragraph': 'So said President Obama in a speech in Illinois on Wednesday. And by one measure he has the facts to back him up, at least for now. But those facts could easily be revised away next week, when the July jobs report comes out. And no one reading that statement should overlook that he said “private sector.” If you talk about all jobs, the record is not nearly so impressive.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Strongest Since 1999?', 'kicker': 'Economix', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords':