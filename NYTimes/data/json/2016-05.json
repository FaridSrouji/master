nion/19douthatWeb/19douthatWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/19/opinion/19douthatWeb/19douthatWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Dying of the Third-Party Dream', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Third-Party Politics (US)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Clinton, Hillary Rodham', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-05-19T07:21:05+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Campaign Stops', 'byline': {'original': 'By Ross Douthat', 'person': [{'firstname': 'Ross', 'middlename': None, 'lastname': 'Douthat', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/ef61aa0d-0f74-5ebe-b6ba-a64507aa9a50', 'word_count': 1027, 'uri': 'nyt://article/ef61aa0d-0f74-5ebe-b6ba-a64507aa9a50'}, {'abstract': 'Two decades later, it was finally tested. There was a match.', 'web_url': 'https://www.nytimes.com/2016/05/19/opinion/the-saga-of-my-rape-kit.html', 'snippet': 'Two decades later, it was finally tested. There was a match.', 'lead_paragraph': 'Cambridge, England — MY rape kit was created on the evening of Sunday, Jan. 12, 1992, at Magee-Womens Hospital in Pittsburgh. Tiny pieces of evidence were swabbed, plucked and combed from me: bits of me and, they hoped, bits of him, to be used in court one day to prove who had done this to me. Like many evidence kits collected at that time, it was not analyzed for DNA, and became part of what is called the backlog: untested rape kits across the country, which number at minimum in the tens of thousands.', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/19/opinion/19winslow/19winslow-articleLarge.jpg', 'height': 962, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/05/19/opinion/19winslow/19winslow-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 962}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/19/opinion/19winslow/19winslow-jumbo.jpg', 'height': 1024, 'width': 639, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/19/opinion/19winslow/19winslow-superJumbo.jpg', 'height': 1670, 'width': 1042, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/19/opinion/19winslow/19winslow-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/05/19/opinion/19winslow/19winslow-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/19/opinion/19winslow/19winslow-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Saga of My Rape Kit', 'kicker': 'Op-Ed Contribu