d': 'nyt://article/5feca5ad-a885-556a-8b50-0893b26ffbc6', 'word_count': 855, 'uri': 'nyt://article/5feca5ad-a885-556a-8b50-0893b26ffbc6'}, {'abstract': 'Colin Gee and Angie Smalis presented two works at Abrons Arts Center as part of Travelogues, a series organized by Laurie Uprichard.', 'web_url': 'https://www.nytimes.com/2016/05/09/arts/dance/review-in-travelogues-dance-postcards-exactingly-handwritten.html', 'snippet': 'Colin Gee and Angie Smalis presented two works at Abrons Arts Center as part of Travelogues, a series organized by Laurie Uprichard.', 'lead_paragraph': 'Watching two people make tiny adjustments to their torsos for an hour might not sound like the most exciting night at the theater. But when those people are Colin Gee and Angie Smalis, it’s uncannily absorbing. On Friday Mr. Gee, an American performer with a background in physical theater, and Ms. Smalis, a Greek dancer living in Limerick, Ireland, brought two works to Abrons Arts Center: “Chaplet of Roses” (2014) and “They Go Out in Joy” (2016). In doing what looked like very little, they accomplished a lot.', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/09/arts/09TRAVELOGUES/09TRAVELOGUES-articleLarge.jpg', 'height': 397, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/05/09/arts/09TRAVELOGUES/09TRAVELOGUES-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 397}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/09/arts/09TRAVELOGUES/09TRAVELOGUES-jumbo.jpg', 'height': 677, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/09/arts/09TRAVELOGUES/09TRAVELOGUES-superJumbo.jpg', 'height': 1353, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/09/arts/09TRAVELOGUES/09TRAVELOGUES-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/05/09/arts/09TRAVELOGUES/09TRAVELOGUES-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/09/arts/09TRAVELOGUES/09TRAVELOGUES-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: In Travelogues, Dance Postcards, Exactingly Handwritten', 'kicker': None, 'content_kicker': None, 'print_headline': 'Dances Like Postcards, Exactingly Handwritten', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dancing', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'Chaplet of Roses (Dance)', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'They Go Out in Joy (Dance)', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'ABRONS ARTS CENTER', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Smalis, Angie', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Gee, Colin', 'rank': 7, 'major': 'N'}], 'pub_date': '2016-05-08T21:23:03+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Siobhan Burke', 'person': [{'firstname': 'Siobhan', 'middlename': None, 'lastname': 'Burke', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/9afec51d-3fbb-57f2-a06f-4847ffbf74d2', 'word_count': 408, 'uri': 'nyt://article/9afec51d-3fbb-57f2-a06f-4847ffbf74d2'}, {'abstract': 'Dr. Mukherjee, the author of the Pulitzer Prize-winning cancer book “The Emperor of All Maladies,” explores the history of genetic discovery.', 'web_url': 'https://www.nytimes.com/2016/05/09/books/review-siddhartha-mukherjees-the-gene-a-molecular-pursuit-of-the-self.html', 'snippet': 'Dr. Mukherjee, the author of the Pulitzer Prize-winning cancer book “The Emperor of All Maladies,” explores the history of genetic discovery.', 'lead_paragraph': 'Thank heavens Gregor Mendel was a lousy priest. Had he shown even the faintest aptitude for oratory or ministering to the poor, he might never have determined the basic laws of heredity. But bumbling he was, and he made a rotten university student to boot; his failures drove him straight to his room, where he bred mice in secret. The experiment scandalized his superiors.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/09/arts/09BOOKmukherjeeJP/09BOOKSIDDHARTHAJP-articleLarge.jpg', 'height': 788, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/05/09/arts/09BOOKmukherjeeJP/09BOOKSIDDHARTHAJP-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 788}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/09/arts/09BOOKmukherjeeJP/09BOOKSIDDHARTHAJP-jumbo.jpg', 'height': 1024, 'width': 780, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/09/arts/09BOOKmukherjeeJP/09BOOKSIDDHARTHAJP-superJumbo.jpg', 'height': 1499, 'width': 1141, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/09/arts/09BOOKmukherjeeJP/09BOOKmukherjeeJP-thumbStandard.jpg', 'height': 