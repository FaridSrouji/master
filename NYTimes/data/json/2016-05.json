web1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 354}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/05/us/05TRUMPHUNDREDweb1/05TRUMPHUNDREDweb1-jumbo.jpg', 'height': 605, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/05/us/05TRUMPHUNDREDweb1/05TRUMPHUNDREDweb1-superJumbo.jpg', 'height': 1209, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/05/us/05TRUMPHUNDREDweb1/05TRUMPHUNDREDweb1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/05/05/us/05TRUMPHUNDREDweb1/05TRUMPHUNDREDweb1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/05/us/05TRUMPHUNDREDweb1/05TRUMPHUNDREDweb1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘President Trump?’ Here’s How He Says It Would Look', 'kicker': None, 'content_kicker': None, 'print_headline': '‘President Trump?’ Here’s How He Says It Would Look', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Trump, Donald J', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 4, 'major': 'N'}], 'pub_date': '2016-05-04T16:58:18+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Patrick Healy', 'person': [{'firstname': 'Patrick', 'middlename': None, 'lastname': 'Healy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/97c8e5ea-629b-530c-9688-4a51cd4c57b6', 'word_count': 1706, 'uri': 'nyt://article/97c8e5ea-629b-530c-9688-4a51cd4c57b6'}, {'abstract': 'Régime des Fleurs collaborated with Burrow bakery’s Ayako Kurokawa on an uplifting creation.', 'web_url': 'https://www.nytimes.com/2016/05/04/t-magazine/food/cookie-bouquet-brooklyn-regime-des-fleurs-burrow-bakery.html', 'snippet': 'Régime des Fleurs collaborated with Burrow bakery’s Ayako Kurokawa on an uplifting creation.', 'lead_paragraph': 'Fascinated by “impossible bouquets,” the Dutch Baroque still-life paintings that took years to complete because each flower could only be painted while in season, the Régime des Fleurs perfumers Alia Raza and Ezra Woods have recreated the art form — with a treat for the senses. “It’s our goal to bring a sense of floralcy to everything — that includes food,” Raza says. Their first foray into “edible experiences” was with Timelapse, a fragrance made with food-grade botanical extractions and alcohol — available in the Régime des Fleurs Spritz, a gin-prosecco cocktail at Dimes. Now the duo has collaborated with Burrow bakery’s Ayako Kurokawa on a scented and flavored cookie, as part of Régime des Fleurs’s ongoing Artefact program of collaborations. “We used essences that can be used for both perfumery and flavoring,” says Woods. “It’s meant to be tasty but subtle — and hard to put your finger on.” The dough and icing are subtly infused with notes of bergamot, orange, elderflower and almond to conjure up the uplifting feelings Kurokawa’s hand-painted watercolor-like bouquets represents. Each cookie is made to order in Brooklyn, and takes about a day and a half to complete.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/04/t-magazine/04tmag-cookie/04tmag-cookie-articleLarge.jpg', 'height': 394, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/05/04/t-magazine/04tmag-cookie/04tmag-cookie-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 394}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/04/t-magazine/04tmag-cookie/04tmag-cookie-jumbo.jpg', 'height': 672, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/04/t-magazine/04tmag-cookie/04tmag-cookie-superJumbo.jpg', 'height': 1343, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/04/t-magazine/04tmag-cookie/04tmag-cookie-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/05/04/t-magazine/04tmag-cookie/04tmag-cookie-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/04/t-magazine/04tmag-cookie/04tmag-cookie-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Cookie Bouquet From a Cult Brooklyn Baker and Two Perfumers', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Bakeries and Baked Products', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Brooklyn (NYC)', 'rank': 2, 'major': 'N'}], 'pub_date': '2016-05-04T17:00:03+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'subsection_name': 'Food', 'byline': {'original'