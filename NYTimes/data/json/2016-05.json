: [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/12/opinion/krugman-circular/krugman-circular-articleLarge-v2.jpg', 'height': 591, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/11/12/opinion/krugman-circular/krugman-circular-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 591}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/12/opinion/krugman-circular/krugman-circular-jumbo-v5.jpg', 'height': 1008, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/12/opinion/krugman-circular/krugman-circular-superJumbo-v5.jpg', 'height': 1852, 'width': 1881, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/12/opinion/krugman-circular/krugman-circular-thumbStandard-v5.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/11/12/opinion/krugman-circular/krugman-circular-thumbStandard-v5.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/12/opinion/krugman-circular/krugman-circular-thumbLarge-v7.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Truth and Trumpism', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': 'Truth  and  Trumpism', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Krugman, Paul', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Trump