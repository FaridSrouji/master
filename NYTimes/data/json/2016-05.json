ages/2016/05/24/nyregion/24PAPERT2/24PAPERT2-jumbo.jpg', 'height': 1024, 'width': 726, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/24/nyregion/24PAPERT2/24PAPERT2-superJumbo.jpg', 'height': 2048, 'width': 1452, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/24/nyregion/24PAPERT2/24PAPERT2-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/05/24/nyregion/24PAPERT2/24PAPERT2-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/24/nyregion/24PAPERT2/24PAPERT2-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Fred Papert, Innovative Ad Man and Champion of Grand Central, Dies at 89', 'kicker': None, 'content_kicker': None, 'print_headline': 'Fred Papert, 89, Dies; Protected Grand Central Terminal', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Papert, Fred', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Grand Central Terminal (Manhattan, NY)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Times Square and 42nd Street (Manhattan, NY)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-05-23T22:04:58+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Sam Roberts', 'person': [{'firstname': 'Sam', 'middlename': None, 'lastname': 'Roberts', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/a915cd49-8a15-5f5b-9cdf-f11efd714967', 'word_count': 998, 'uri': 'nyt://article/a915cd49-8a15-5f5b-9cdf-f11efd714967'}, {'abstract': 'T’s picks for the most interesting pavilions at the 15th edition of the fair, whose theme this year is “Reporting From the Front.”', 'web_url': 'https://www.nytimes.com/2016/05/23/t-magazine/venice-architecture-biennale-guide.html', 'snippet': 'T’s picks for the most interesting pavilions at the 15th edition of the fair, whose theme this year is “Reporting From the Front.”', 'lead_paragraph': 'The architect Alejandro Aravena, the surprise winner of this year’s Pritzker prize (and subject of a feature by Michael Kimmelman in T’s upcoming issue) wants to pull architectural focus away from starry prestige projects and attention-grabbing landmark buildings. Under Aravena’s direction, this year’s Venice Architecture Biennale will focus on architecture that addresses actual — and often urgent — daily human needs. He views the advancement of architecture not as “a goal in itself but a way to improve people’s quality of life.” Later this week, Aravena’s central exhibition, “Reporting From the Front,” will open alongside national presentations and special projects. Many, including the handful of diverse projects below, offer their own reports from architecture’s many fronts.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/24/t-magazine/24tmag-venice-01/24tmag-venice-01-articleLarge.jpg', 'height': 450, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/05/24/t-magazine/24tmag-venice-01/24tmag-venice-01-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 450}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/24/t-magazine/24tmag-venice-01/24tmag-venice-01-jumbo.jpg', 'height': 768, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/24/t-magazine/24tmag-venice-01/24tmag-venice-01-superJumbo.jpg', 'height': 1536, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/24/t-magazine/24tmag-venice-01/24tmag-venice-01-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/05/24/t-magazine/24tmag-venice-01/24tmag-venice-01-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/24/t-magazine/24tmag-venice-01/24tmag-venice-01-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Six Not-to-Miss Shows at the Venice Architecture Biennale', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ARCHITECTURE', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Venice Architecture Biennale', 'rank': 2, 'major': 'N'}], 'pub_date': '2016-05-23T22:13:13+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Hettie Judah', 'person': [{'firstname': 'Hettie', 'middlename': None, 'lastname': 'Judah', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/97621046-b1ff-559c-95e5-707cc5e36bf0', 'word_count': 564, 'uri': 'nyt://article/97621046-b1ff-559c-95e5-707cc5e36bf0'}, {'abstract': 'None of us are angels.', 'web_url': 'https://krugman.b