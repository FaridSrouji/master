em.', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/22/opinion/sunday/22Bergman/22Bergman-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/05/22/opinion/sunday/22Bergman/22Bergman-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/22/opinion/sunday/22Bergman/22Bergman-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/22/opinion/sunday/22Bergman/22Bergman-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/22/opinion/sunday/22Bergman/22Bergman-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/05/22/opinion/sunday/22Bergman/22Bergman-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/22/opinion/sunday/22Bergman/22Bergman-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Israel’s Army Goes to War With Its Politicians', 'kicker': 'Opinion', 'content_kicker': None, 'print_headline': 'Israel’s Army vs. Israel’s Politicians', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Bergman, Ronen', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Israel', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Netanyahu, Benjamin', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Lieberman, Avigdor', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-05-21T18:30:05+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Ronen Bergman', 'person': [{'firstname': 'Ronen', 'middlename': None, 'lastname': 'Bergman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/3b483a0b-2432-57a8-8655-9a1ce6612e2c', 'word_count': 1160, 'uri': 'nyt://article/3b483a0b-2432-57a8-8655-9a1ce6612e2c'}, {'abstract': 'A new kind of centralized media, and a new kind of power.', 'web_url': 'https://www.nytimes.com/2016/05/22/opinion/sunday/facebooks-subtle-empire.html', 'snippet': 'A new kind of centralized media, and a new kind of power.', 'lead_paragraph': 'IN one story people tell about the news media, we have moved from an era of consolidation and authority to an era of fragmentation and diversity. Once there were three major television networks, and everyone believed what Walter Cronkite handed down from Sinai. Then came cable TV and the talk radio boom, and suddenly people could seek out ideologically congenial sources and tune out the old mass-culture authorities. Then finally the Internet smashed the remaining media monopolies, scattered news readers to the online winds, and opened an age of purely individualized news consumption.', 'print_section': 'SR', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/22/opinion/sunday/22douthat/22douthat-articleLarge.jpg', 'height': 420, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlar