': None}, 'keywords': [{'name': 'subject', 'value': 'Social Media', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Millennial Generation', 'rank': 2, 'major': 'N'}], 'pub_date': '2016-05-19T18:14:57+0000', 'document_type': 'article', 'news_desk': 'Letters', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/36357a38-d422-5fee-b780-992fc30b194a', 'word_count': 142, 'uri': 'nyt://article/36357a38-d422-5fee-b780-992fc30b194a'}, {'abstract': 'Ms. Silva, a trumpet player from Portugal, will perform in Manhattan and Brooklyn throughout the week.', 'web_url': 'https://www.nytimes.com/2016/05/22/arts/music/susana-santos-silva-measured-and-free-plays-new-york.html', 'snippet': 'Ms. Silva, a trumpet player from Portugal, will perform in Manhattan and Brooklyn throughout the week.', 'lead_paragraph': 'Susana Santos Silva, a young trumpeter from Porto, Portugal, is a fearless jazz musician who can determine a context for herself wherever she is. She plays with a warm tone and a mute until she wants to recast it for the ensemble and the space she’s playing in; she’s equally comfortable with carefully measured phrases as she is with relaxed free improvisation. She’s in town as part of the Orquestra Jazz de Matosinhos, a big band that works with the jazz guitarist Kurt Rosenwinkel at the Blue Note through the week leading up to Sunday, May 22, and then she’s doing a run of small Brooklyn gigs with some of the best improvisers in town. On Monday, she’s at 65 Fen, with the bassist Pascal Niggenkemper and the drummer Carlo Costa; on Tuesday, at Korzo, with the bassist Thomas Morgan and pianist Craig Taborn; on Thursday, she’ll play in a duo with the saxophonist Ingrid Laubrock at Manhattan Inn; and on May 29, she’ll play in a trio with the pianist Kris Davis and the violist Mat Maneri at IBeam. (susanasantossilva.com)', 'print_section': 'AR', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/22/arts/22GUIDE6/22GUIDE6-articleLarge-v2.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/05/22/arts/22GUIDE6/22GUIDE6-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/22/arts/22GUIDE6/22GUIDE6-jumbo-v2.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/22/arts/22GUIDE6/22GUIDE6-superJumbo-v2.jpg', 'height': 2048, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/22/arts/22GUIDE6/22GUIDE6-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/05/22/arts/22GUIDE6/22GUIDE6-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/22/arts/22GUIDE6/22GUIDE6-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Susana Santos Silva, Measured and Free, Plays New York', 'kicker': None, 'content_kicker': None, 'print_headline': 'Pop; A Young Player, Measured but Free', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Jazz', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Silva, Susana Santos (1979- )', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Orquestra Jazz de Matosinhos', 'rank': 3, 'major': 'N'}], 'pub_date': '2016-05-19T18:15:18+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Ben Ratliff', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Ratliff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f25f75f3-be10-5bd4-89c9-58bbd7e416ee', 'word_count': 181, 'uri': 'nyt://article/f25f75f3-be10-5bd4-89c9-58bbd7e416ee'}, {'abstract': 'This ESPN documentary extends the narrative beyond the O.J. Simpson murder trial, as a biography and a history of race, fame, sports and Los Angeles.', 'web_url': 'https://www.nytimes.com/2016/05/20/movies/oj-made-in-america-review.html', 'snippet': 'This ESPN documentary extends the narrative beyond the O.J. Simpson murder trial, as a biography and a history of race, fame, sports and Los Angeles.', 'lead_paragraph': 'Back in 1995, “trial of the century” may have seemed a little over the top, even as the television-watching public was transfixed by gavel-to-gavel coverage, and hitherto obscure Los Angeles lawyers became household names. More than 20 years later, though, it sounds like an understatement. The trial of O. J. Simpson for the murders of Nicole Brown Simpson and Ronald L. Goldman touched every exposed nerve in the American body politic and forced Americans to confront matters we often prefer to cloak in euphemism and denial: racial division, domestic violence, the hyperactivity of the news media and the toxicity of celebrity culture.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/19/arts/20OJ/20OJ-articleLarge.jpg', 'height': 398, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/05/19/arts/20OJ/20OJ-articleLarge.jpg', 'xlargewidth': 