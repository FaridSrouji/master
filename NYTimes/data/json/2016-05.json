th': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/08/world/middleeast/09EGYPT/09EGYPT-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/05/08/world/middleeast/09EGYPT/09EGYPT-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/08/world/middleeast/09EGYPT/09EGYPT-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Ambush Kills 8 Police Officers in Egypt', 'kicker': None, 'content_kicker': None, 'print_headline': 'ISIS Claims Fatal Ambush of 8 Officers in Cairo District', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Murders, Attempted Murders and Homicides', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Islamic State in Iraq and Syria (ISIS)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Attacks on Police', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Cairo (Egypt)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Terrorism', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Sisi, Abdel Fattah el-', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Fatalities)', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Egypt', 'rank': 9, 'major': 'N'}], 'pub_date': '2016-05-08T13:01:11+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Declan Walsh', 'person': [{'firstname': 'Declan', 'middlename': None, 'lastname': 'Walsh', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1766f948-0e84-5ff5-9e21-442a393c4c91', 'word_count': 649, 'uri': 'nyt://article/1766f948-0e84-5ff5-9e21-442a393c4c91'}, {'abstract': 'More than almost any other TV show, “Outlander” is ruled by the internal life of its female lead.', 'web_url': 'https://www.nytimes.com/2016/05/07/arts/television/outlander-season-2-episode-5-recap.html', 'snippet': 'More than almost any other TV show, “Outlander” is ruled by the internal life of its female lead.', 'lead_paragraph': 'More than almost any other show on television, “Outlander” is ruled by the internal life of its female lead character. Between the occasional voice over and how her perspective shapes the show’s mood and tone, Claire has proved to be the emotional anchor. Even though Jamie’s point of view has taken center stage in a few episodes, it’s Claire that guides the audience, allowing us to understand the politics and intrigue of the various worlds she moves through. Which is what makes this week’s episode, “Untimely Resurrection,” such a curious one.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/07/arts/television/07outlander2/07outlander2-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/05/07/arts/television/07outlander2/07outlander2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/07/arts/television/07outlander2/07outlander2-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/07/arts/television/07outlander2/07outlander2-superJumbo.jpg', 'height': 1200, 'width': 1800, 'subType': 'superJumbo', 'crop_name': 'superJum