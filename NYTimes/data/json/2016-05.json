acy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/10/arts/10PHILHARMONIA/10PHILHARMONIA-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/05/10/arts/10PHILHARMONIA/10PHILHARMONIA-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/10/arts/10PHILHARMONIA/10PHILHARMONIA-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: Philharmonia Baroque Unearths a 300-Year-Old Rarity', 'kicker': None, 'content_kicker': None, 'print_headline': 'Feting an Imperial Birth, in a Rarity Resurrected', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Classical Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Scarlatti, Allessandro', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'McGegan, Nicholas', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Philharmonia Baroque Orchestra', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'La Gloria di Primavera (Musical Work)', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Carnegie Hall', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 7, 'major': 'N'}], 'pub_date': '2016-05-09T21:55:24+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By James R. Oestreich', 'person': [{'firstname': 'James', 'middlename': 'R.', 'lastname': 'Oestreich', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/b6a5f86a-c005-5d03-8580-89c759731e77', 'word_count': 513, 'uri': 'nyt://article/