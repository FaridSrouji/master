lide-60E7-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/12/blogs/12-lens-rawiya-slide-60E7/12-lens-rawiya-slide-60E7-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Hidden Stories of Arab Women', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2016-05-12T06:06:17+0000', 'document_type': 'multimedia', 'news_desk': 'Blogs', 'section_name': 'Blogs', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/3ed78e1a-4624-5022-b993-9361c59906ca', 'word_count': 0, 'uri': 'nyt://slideshow/3ed78e1a-4624-5022-b993-9361c59906ca'}, {'abstract': 'Stephen Curry sank a 3-pointer with 24.9 seconds left and followed it with two free throws to seal the win.', 'web_url': 'https://www.nytimes.com/2016/05/12/sports/basketball/stephen-curry-golden-state-warriors-eliminate-portland-trail-blazers.html', 'snippet': 'Stephen Curry sank a 3-pointer with 24.9 seconds left and followed it with two free throws to seal the win.', 'lead_paragraph': 'OAKLAND, Calif. — The playoffs feel different for the Golden State Warriors this time around. A year ago, the Warriors were talented upstarts, a team of long-distance cyborgs who were neither saddled with great expectations nor distracted by the spotlight of a history-making chase. It was fun and games.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/12/sports/12warriors/12warriors-articleLarge.jpg', 'height': 910, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/05/12/sports/12warriors/12warriors-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 910}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/12/sports/12warriors/12warriors-jumbo.jpg', 'height': 1024, 'width': 676, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/12/sports/12warriors/12warriors-superJumbo.jpg', 'height': 2048, 'width': 1351, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/12/sports/12warriors/12warriors-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/05/12/sports/12warriors/12warriors-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/12/sports/12warriors/12warriors-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Warriors Again Overcome Slow Start, This Time Eliminating Trail Blazers', 'kicker': 'Warriors 125, Trail Blazers 121 | Golden State wins series, 4-1', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Basketball', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Playoff Games', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Curry, Stephen', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Golden State Warriors', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Portland Trail Blazers', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-05-12T06:16:31+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Basketball', 'byline': {'original': 'By Scott Cacciola', 'person': [{'firstname': 'Scott', 'middlename': None, 'lastname': 'Cacciola', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e69a0460-6fed-591f-966c-ebc510f87ce5', 'word_count': 859, 'uri': 'nyt://article/e69a0460-6fed-591f-966c-ebc510f87ce5'}, {'abstract': 'Rawiya, a collective of female Arab photographers, is challenging and changing how women in the region are portrayed.', 'web_url': 'https://lens.blogs.nytimes.com/2016/05/12/rawiya-the-hidden-stories-of-arab-women/', 'snippet': 'Rawiya, a collective of female Arab photographers, is challenging and changing how women in the region are portrayed.', 'lead_paragraph': 'Tasneem Alsultan was browsing in a Dubai bookstore a few years ago when she found “She Who Tells a Story,” a collection of photo essays by members of Rawiya, a collective of Arab women. Ms. Alsultan then had a thriving wedding photography business in Saudi Arabia and the gulf states, but she had no idea what possibilities awaited beyond that. As she paged through the volume, however, Ms. Alsultan saw clearly a new path — to tell dignified stories of Arab women. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Hidden Stories of Arab Women', 'kicker': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Photography', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 8, 'major': 'N'}], 'pub_date': '2016-05-12T07:00:09+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By James Estrin', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': 'Estrin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5904c18f-e214-5436-b94f-2f19c99ba976', 'word_count': 677, 'uri': 'nyt://article/5904c18f-e214-5436-b94f-2f19c99ba976'}, {'abstract': 'Allowing people to buy into Medicare may be politically difficult, but it is important to explore what could be done to expand health coverage.', 'web_url': 'https://www.nytimes.com/2016/05/12/opinion/a-medicare-option-for-the-uninsured.html', 'snippet': 'Allowing people to buy into Medicare may be politically difficult, but it is important to explore what could be done to expand health coverage.', 'lead_paragraph': 'Health policy experts have long argued that Congress should let older Americans buy into Medicare before they become eligible for it at 65. Hillary Clinton said this week that she supports this option,  which could help expand coverage and cut the cost of insurance for some people.', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/12/opinion/12thu3web/12thu3web-articleLarge.jpg', 'height': 394, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/05/12/opinion/12thu3web/12thu3web-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 394}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/12/opinion/12thu3web/12thu3web-jumbo.jpg', 'height': 672, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/12/opinion/12thu3web/12thu3web-superJumbo.jpg', 'height': 1343, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/12/opinion/12thu3web/12thu3web-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name':