glocations', 'value': 'ARIZONA', 'rank': 4, 'major': 'N'}], 'pub_date': '2016-05-05T01:13:01+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Fernanda Santos', 'person': [{'firstname': 'Fernanda', 'middlename': None, 'lastname': 'Santos', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9109897b-ab4e-58b1-af6a-c819d328b212', 'word_count': 769, 'uri': 'nyt://article/9109897b-ab4e-58b1-af6a-c819d328b212'}, {'abstract': 'Mr. Gatewood gravitated toward extreme behavior, extreme people and extreme situations.', 'web_url': 'https://www.nytimes.com/slideshow/2016/05/05/arts/photographer-charles-gatewood.html', 'snippet': 'Mr. Gatewood gravitated toward extreme behavior, extreme people and extreme situations.', 'lead_paragraph': 'Mr. Gatewood gravitated toward extreme behavior, extreme people and extreme situations.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/05/arts/20160505gatewood-obit-slide-9O0L/20160505gatewood-obit-slide-9O0L-articleLarge.jpg', 'height': 441, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/05/05/arts/20160505gatewood-obit-slide-9O0L/20160505gatewood-obit-slide-9O0L-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 441}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/05/arts/20160505gatewood-obit-slide-9O0L/20160505gatewood-obit-slide-9O0L-jumbo.jpg', 'height': 753, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/05/arts/20160505gatewood-obit-slide-9O0L/20160505gatewood-obit-slide-9O0L-superJumbo.jpg', 'height': 1506, 'width': 204