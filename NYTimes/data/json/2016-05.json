': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/12/arts/12COMEDYJP/12COMEDYJP-articleLarge.jpg', 'height': 890, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/05/12/arts/12COMEDYJP/12COMEDYJP-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 890}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/12/arts/12COMEDYJP/12COMEDYJP-jumbo.jpg', 'height': 1024, 'width': 691, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/12/arts/12COMEDYJP/12COMEDYJP-superJumbo.jpg', 'height': 2048, 'width': 1382, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/12/arts/12COMEDYJP/12COMEDYJP-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/05/12/arts/12COMEDYJP/12COMEDYJP-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/12/arts/12COMEDYJP/12COMEDYJP-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Comic on the Verge, His Absurdism on the Fly', 'kicker': 'On Comedy', 'content_kicker': None, 'print_headline': 'Funny Guy on the Rise, Absurdism on the Fly', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Scovel, Rory (1983- )', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Comedy and Humor', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': "Caroline's on Broadway", 'rank': 4, 'major': 'N'}], 'pub_date': '2016-05-11T21:51:57+0000', 'document_type': 'article', 'news_desk