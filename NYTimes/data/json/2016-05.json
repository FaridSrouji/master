ption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/21/arts/21CALINCAMO1/21CALINCAMO1-superJumbo.jpg', 'height': 1304, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/21/arts/21CALINCAMO1/21CALINCAMO1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/05/21/arts/21CALINCAMO1/21CALINCAMO1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/21/arts/21CALINCAMO1/21CALINCAMO1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: In ‘Cal in Camo,’ a Raw Welcome to Motherhood', 'kicker': None, 'content_kicker': None, 'print_headline': 'Longing for the Kind of Bond a Crying Baby Can’t Provide', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Rattlestick Playwrights Theater', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Colt Coeur', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Hoffman, William Francis', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Campbell-Holt, Adrienne', 'rank': 6, 'major': 'N'}, {'name': 'creative_works', 'value': 'Cal in Camo (Play)', 'rank': 7, 'major': 'N'}], 'pub_date': '2016-05-21T02:00:05+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Theater', 'byline': {'original': 'By Ben Brantley', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Brantley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/26