e', 'url': 'images/2016/05/03/nyregion/03churchfire1/03churchfire1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/03/nyregion/03churchfire1/03churchfire1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/05/03/nyregion/03churchfire1/03churchfire1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/03/nyregion/03churchfire1/03churchfire1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Serbs in New York Mourn a Spiritual Pillar, Swallowed by Flames', 'kicker': None, 'content_kicker': None, 'print_headline': 'Mourning a Spiritual Pillar, Swallowed by Flames', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fires and Firefighters', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Churches (Buildings)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Serbian Orthodox Cathedral of St Sava (Manhattan, NY)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Historic Buildings and Sites', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Flatiron District (Manhattan, NY)', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 7, 'major': 'N'}], 'pub_date': '2016-05-03T00:20:18+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Corey Kilgannon', 'person': [{'firstname': 'Corey', 'middlename': None, 'lastname': 'Kilgannon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6afd885c-1a7d-5b19-bb34-e82072f94fcc', 'word_count': 656, 'uri': 'nyt://article/6afd885c-1a7d-5b19-bb34-e82072f94fcc'}, {'abstract': 'A protest at the Parliament in Baghdad shows a Shiite cleric’s power, which could further destabilize a government already in trouble.', 'web_url': 'https://www.nytimes.com/2016/05/03/opinion/turbulent-politics-in-baghdad.html', 'snippet': 'A protest at the Parliament in Baghdad shows a Shiite cleric’s power, which could further destabilize a government already in trouble.', 'lead_paragraph': 'The brief takeover of the Iraqi Parliament building by supporters of the Shiite cleric Moktada al-Sadr over the weekend was rich in symbolism. On Saturday, the demonstrators penetrated the heavily guarded Green Zone, toppling cement walls that have long barricaded the country’s ruling elite from the people it is supposed to serve. They ransacked lawmakers’ offices, waving Iraqi flags as they demanded that the country’s political patronage networks be replaced by a new administration of technocrats. On Sunday, heeding Mr. Sadr’s call, they retreated.', 'print_section': 'A', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/03/opinion/03tue2/03tue2-articleLarge.jpg', 'height': 648, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/05/03/opinion/03tue2/03tue2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 648}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/03/opinion/03tue2/03tue2-jumbo.jpg', 'height': 1024, 'width': 948, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/03/opinion/03tue2/03tue2-superJumbo.jpg', 'height': 1500, 'width': 1388, 'subType': 'sup