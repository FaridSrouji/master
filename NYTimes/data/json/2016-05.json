umbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/05/fashion/20160505OTRCHANEL-slide-3G2L/20160505OTRCHANEL-slide-3G2L-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/05/05/fashion/20160505OTRCHANEL-slide-3G2L/20160505OTRCHANEL-slide-3G2L-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/05/fashion/20160505OTRCHANEL-slide-3G2L/20160505OTRCHANEL-slide-3G2L-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Chanel Goes to Havana', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Chanel SA', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Lagerfeld, Karl', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Havana (Cuba)', 'rank': 4, 'major': 'N'}], 'pub_date': '2016-05-05T13:23:59+0000', 'document_type': 'multimedia', 'news_desk': 'Fashion & Style', 'section_name': 'Fashion & Style', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/b056ecae-c63f-5ea0-8873-164fe9485761', 'word_count': 0, 'uri': 'nyt://slideshow/b056ecae-c63f-5ea0-8873-164fe9485761'}, {'abstract': 'The Italian director Luca Guadagnino places four people — two of whom are Tilda Swinton and Ralph Fiennes — on a beautiful island, and all of their senses are pushed to the extreme.', 'web_url': 'https://www.nytimes.com/2016/05/08/movies/a-bigger-splash-luca-guadagnino-tilda-swinton-ralph-fiennes-interview.html', 'snippet': 'The Italian director Luca Guadagnino places four people — two of whom are Tilda Swinton and Ralph Fiennes — on a beautiful island, and all of their senses are pushed to the extreme.', 'lead_paragraph': 'Midway through “A Bigger Splash,” the latest hedonistic trip from the Italian director Luca Guadagnino, Ralph Fiennes’s character, Harry, puts on the Rolling Stones’ “Emotional Rescue” album and starts to dance. His shoulders twitch, his body flails, and in a sort of drunken ritual set in the middle of a luxurious vacation home on an island off the coast of Sicily, he tears through the house, his awkward movements getting bigger and more daring — the music propelling him into a state of almost fearsome abandon.', 'print_section': 'AR', 'print_page': '25', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/08/arts/08SPLASH1/08SPLASH1-articleLarge.jpg', 'height': 428, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/05/08/arts/08SPLASH1/08SPLASH1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 428}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/08/arts/08SPLASH1/08SPLASH1-jumbo.jpg', 'height': 730, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/08/arts/08SPLASH1/08SPLASH1-superJumbo.jpg', 'height': 1460, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/08/arts/08SPLASH1/08SPLASH1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/05/08/arts/08SPLASH1/08SPLAS