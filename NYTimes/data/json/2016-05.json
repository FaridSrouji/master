', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/23/arts/23BOOKZEISLER2/23BOOKZEISLER2-superJumbo-v3.jpg', 'height': 2048, 'width': 1471, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/23/arts/23BOOKZEISLER2/23BOOKZEISLER2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/05/23/arts/23BOOKZEISLER2/23BOOKZEISLER2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/23/arts/23BOOKZEISLER2/23BOOKZEISLER2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: ‘We Were Feminists Once,’ on a Movement Co-Opted', 'kicker': 'Books of The Times', 'content_kicker': None, 'print_headline': 'Bemoaning Feel-Good Feminism as a Brand', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Zeisler, Andi', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': "Women's Rights", 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'We Were Feminists Once: From Riot Grrrl to CoverGirl, the Buying and Selling of a Political Movement (Book)', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-05-22T21:31:01+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By Jennifer Senior', 'person': [{'firstname': 'Jennifer', 'middlename': None, 'lastname': 'Senior', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': '