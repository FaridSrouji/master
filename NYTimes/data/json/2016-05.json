lide-T5BB/10tmag-rogers-slide-T5BB-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/10/t-magazine/10tmag-rogers-slide-T5BB/10tmag-rogers-slide-T5BB-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/10/t-magazine/10tmag-rogers-slide-T5BB/10tmag-rogers-slide-T5BB-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/10/t-magazine/10tmag-rogers-slide-T5BB/10tmag-rogers-slide-T5BB-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/05/10/t-magazine/10tmag-rogers-slide-T5BB/10tmag-rogers-slide-T5BB-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/10/t-magazine/10tmag-rogers-slide-T5BB/10tmag-rogers-slide-T5BB-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How to Prepare Spring Asparagus, by Ruth Rogers', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Asparagus', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Sauces', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Prosecco (Wine)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Edible Schoolyard NYC', 'rank': 4, 'major': 'N'}], 'pub_date': '2016-05-10T18:11:06+0000', 'document_type': 'multimedia', 'news_desk': 'T Magazine', 'section_name': 'T Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/c8907621-8523-5978-8f5d-23f8b2fe7450', 'word_count': 0, 'uri': 'nyt://slideshow/c8907621-8523-5978-8f5d-23f8b2fe7450'}, {'abstract': 'Ahead of her appearance at the Edible Schoolyard NYC spring benefit this month, the restaurant’s chef and owner Ruth Rogers shares a recipe with T.', 'web_url': 'https://www.nytimes.com/2016/05/10/t-magazine/food/asparagus-recipe-london-river-cafe.html', 'snippet': 'Ahead of her appearance at the Edible Schoolyard NYC spring benefit this month, the restaurant’s chef and owner Ruth Rogers shares a recipe with T.', 'lead_paragraph': 'Ruth Rogers, the vivacious restaurateur who traded Woodstock for London almost 50 years ago, is stationed in the shiny, open-plan kitchen of her Georgian terrace home. Sunshine streams into the double-height living space, where no fewer than eight sash windows look out onto a palatial Chelsea Square. Today, the celebrated chef and proprietor of what is surely the city’s most cherished Italian dining room, the River Café, is wearing a knitted dress in shocking pink (the favorite hue of her husband, the architect Richard Rogers). On the far wall, a smudgy Cy Twombly canvas hangs above a row of ceramics. The unglazed vessels look very Edmund de Waal, but in fact are the creation of Rogers’s mother-in-law, Dada, who first taught her to cook. “Edmund de Waal admired them when he came to dinner,” says Rogers of the ceramicist’s handiwork, as she scales a ladder to reach a vertiginous kitchen cupboard. The whisk she procures proves essential in the day’s delicious agenda: the preparation of white and green asparagus served with a sparkly take on a traditional Bagna Cauda (meaning “hot bath”) sauce. Here, the red wine that typically makes up this centuries-old northern Italian recipe, featuring garlic and anchovies, is swapped for Prosecco (the full recipe for which is detailed below).', 'print_section': 'ST', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/10/t-magazine/10tmag-rogers-slide-S96B/10tmag-rogers-slide-S96B-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/05/10/t-magazine/10tmag-rogers-slide-S96B/10tmag-rogers-slide-S96B-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/10/t-magazine/10tmag-rogers-slide-S96B/10tmag-rogers-slide-S96B-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/10/t-magazine/10tmag-rogers-slide-S96B/10tmag-rogers-slide-S96B-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/10/t-magazine/10tmag-rogers-slide-S96B/10tmag-rogers-slide-S96B-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/05/10/t-magazine/10tmag-rogers-slide-S96B/10tmag-rogers-slide-S96B-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/10/t-magazine/10tmag-rogers-slide-S96B/10tmag-rogers-slide-S96B-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Spring Asparagus Dish From London’s Beloved River Café', 'kicker': None, 'content_kicker': None, 'print_headline': 'Food Matters; Asparagus, With Respect', 'name': None, 'seo': 