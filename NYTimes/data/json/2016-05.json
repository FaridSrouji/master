ourseasons/29fourseasons-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/05/29/dining/29fourseasons/29fourseasons-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/29/dining/29fourseasons/29fourseasons-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Four Seasons Restaurant Is Headed for New Space on Park Ave.', 'kicker': None, 'content_kicker': None, 'print_headline': 'Four Seasons to Decamp in July From Home Since 1959', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Restaurants', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Relocation of Business', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate (Commercial)', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Four Seasons Restaurant (Manhattan, NY)', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Grill Room, Four Seasons Restaurant (Manhattan, NY)', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Manhattan (NYC)', 'rank': 7, 'major': 'N'}], 'pub_date': '2016-05-28T23:20:55+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f46c2311-8557-5a01-8fe4-00f8b9a2867c', 'word_count': 514, 'uri': 'nyt://article/f46c2311-8557-5a01-8fe4-00f8b9a2867c'}, {'abstract': 'The top-seeded Djokovic, who has seen the path to his first French Open title eased by the injury to Rafael Nadal, hustled to complete his match before it was too dark to play.', 'web_url': 'https://www.nytimes.com/2016/05/29/sports/tennis/novak-djokovic-shines-as-night-falls-at-the-french-open.html', 'snippet': 'The top-seeded Djokovic, who has seen the path to his first French Open title eased by the injury to Rafael Nadal, hustled to complete his match before it was too dark to play.', 'lead_paragraph': 'PARIS — It is not often that a tennis player leads a cheer for a chair umpire, or insists that he come down from his perch and join a post-match interview. But after beating Aljaz Bedene — and the encroaching darkness — in the last match of the day at Roland Garros, Novak Djokovic was in a cheerful and appreciative mood.', 'print_section': 'SP', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/29/sports/29TENNIS/29TENNIS-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/05/29/sports/29TENNIS/29TENNIS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/29/sports/29TENNIS/29TENNIS-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/29/sports/29TENNIS/29TENNIS-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/29/sports/29TENNIS/29TENNIS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/05/29/sports/29TENNIS/29TENNIS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, 