Cadogan Hotel.', 'print_section': 'AR', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/08/arts/08RUPERT-COMBO/08RUPERT-COMBO-articleLarge.jpg', 'height': 446, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/05/08/arts/08RUPERT-COMBO/08RUPERT-COMBO-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 446}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/08/arts/08RUPERT-COMBO/08RUPERT-COMBO-jumbo.jpg', 'height': 762, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/08/arts/08RUPERT-COMBO/08RUPERT-COMBO-superJumbo.jpg', 'height': 1524, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/08/arts/08RUPERT-COMBO/08RUPERT-COMBO-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/05/08/arts/08RUPERT-COMBO/08RUPERT-COMBO-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/08/arts/08RUPERT-COMBO/08RUPERT-COMBO-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Rupert Everett Gets His Oscar (Wilde, That Is)', 'kicker': None, 'content_kicker': None, 'print_headline': 'On a First-Name Basis With Oscar Wilde', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Wilde, Oscar', 'rank': 2, 'major'