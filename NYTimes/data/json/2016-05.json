ALPASO/12MALPASO-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 421}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/12/arts/12MALPASO/12MALPASO-jumbo.jpg', 'height': 718, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/12/arts/12MALPASO/12MALPASO-superJumbo.jpg', 'height': 1437, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/12/arts/12MALPASO/12MALPASO-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/05/12/arts/12MALPASO/12MALPASO-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/12/arts/12MALPASO/12MALPASO-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: Malpaso, Like the Familiar Comfort of an Old Sweater', 'kicker': None, 'content_kicker': None, 'print_headline': 'Like the Familiar Comfort of an Old Sweater', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dancing', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Joyce Theater', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Cuba', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Festivals', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'MalPaso Dance Co', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Delgado, Osnel', 'rank': 7, 'major': 'N'}], 'pub_date': '2016-05-11T22:00:38+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name':