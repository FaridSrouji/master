e': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Louis Vuitton', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Ghesquiere, Nicolas', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Brazil', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Rio de Janeiro (Brazil)', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-05-31T17:13:17+0000', 'document_type': 'multimedia', 'news_desk': 'T Magazine', 'section_name': 'T Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/07c5a673-5121-519d-ba32-d29edf75dd45', 'word_count': 0, 'uri': 'nyt://slideshow/07c5a673-5121-519d-ba32-d29edf75dd45'}, {'abstract': 'From the archives of the International Herald Tribune: In June 1941, clothing rationed by coupons throughout Great Britain.', 'web_url': 'https://iht-retrospective.blogs.nytimes.com/2016/05/31/1941-clothing-rationed-by-coupons/', 'snippet': 'From the archives of the International Herald Tribune: In June 1941, clothing rationed by coupons throughout Great Britain.', 'lead_paragraph': 'LONDON — Beginning tomorrow [June 1], all clothing, footwear, cloth and knitting wool will be rationed throughout Great Britain. This dramatic and drastic rationing action has been taken as a war-time measure to secure the fullest possible transfer of the national resources of man power, machinery and material to war products. Each person will be allowed sixty-six coupons a year. Men’s suits will require twenty-six coupons; shirts, five; socks, three; undershirts, five; pajamas, eight; collars or ties, one each; gloves, two; workmen’s overalls, six. Women’s dresses will require eleven coupons if woolen, or seven if other material.\xa0—\xa0 New York Herald Tribune, June 1, 1941', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/06/01/blogs/01-iht-retrospective-clothes/01-iht-retrospective-clothes-articleLarge.jpg', 'height': 635, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/06/01/blogs/01-iht-retrospective-clothes/01-iht-retrospective-clothes-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 635}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/06/01/blogs/01-iht-retrospective-clothes/01-iht-retrospective-clothes-jumbo.jpg', 'height': 678, 'width': 641, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/06/01/blogs/01-iht-retrospective-clothes/01-iht-retrospective-clothes-superJumbo.jpg', 'height': 678, 'width': 641, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/06/01/blogs/01-iht-retrospective-clothes/01-iht-retrospective-clothes-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/06/01/blogs/01-iht-retrospective-clothes/01-iht-retrospective-clothes-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/06/01/blogs/01-iht-retrospective-clothes/01-iht-retrospective-clothes-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '1941: Clothing Rationed by Coupons', 'kicker': 'IHT Retrospective', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Textiles', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'World War II (1939-45)', 'rank'