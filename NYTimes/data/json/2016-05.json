-articleLarge.jpg', 'height': 421, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/04/02/science/wellhospital/wellhospital-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 421}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/04/02/science/wellhospital/wellhospital-jumbo.jpg', 'height': 547, 'width': 780, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/04/02/science/wellhospital/wellhospital-superJumbo.jpg', 'height': 547, 'width': 780, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/04/02/science/wellhospital/wellhospital-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/04/02/science/wellhospital/wellhospital-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/04/02/science/wellhospital/wellhospital-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Picking Up an Infection in the Hospital', 'kicker': 'Well', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Clostridium Difficile (Bacterium)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Emergency Medical Treatment', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Hospitals', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Hygiene and Cleanliness', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Infections', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Staphylococcus Aureus', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-05-11T14:00:25+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Health', 'byline': {'original': 'By Eric Taub', 'person': [{'firstname': 'Eric', 'middlename': None, 'lastname': 'Taub', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/be6cf311-6b6f-57ca-8c09-662411662f75', 'word_count': 1391, 'uri': 'nyt://article/be6cf311-6b6f-57ca-8c09-662411662f75'}, {'abstract': 'Once embraced by Jewish Israelis of all stripes, the army has become estranged from much of the public.', 'web_url': 'https://www.nytimes.com/2016/05/12/opinion/the-israel-defense-forces-vs-the-people-of-israel.html', 'snippet': 'Once embraced by Jewish Israelis of all stripes, the army has become estranged from much of the public.', 'lead_paragraph': 'TEL AVIV — Israel’s army is a people’s army, and this is usually a time when we Israelis recognize that. On Wednesday, we solemnly mark Memorial Day. On Thursday, we joyously celebrate Independence Day. It’s a week when the country salutes the Israel Defense Forces, the institution that defends its fragile being, and the I.D.F. salutes the public, which sends its sons and daughters to mandatory service.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/12/opinion/11rosnerSub/11rosnerSub-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/05/12/opinion/11rosnerSub/11rosnerSub-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/12/opinion/11rosnerSub/11rosnerSub-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'ran