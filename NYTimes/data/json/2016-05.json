o': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Cohen, Carrie H', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Morrison & Foerster', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Legal Profession', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Justice Department', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Appointments and Executive Changes', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-05-09T21:33:57+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'DealBook', 'byline': {'original': 'By Benjamin Weiser', 'person': [{'firstname': 'Benjamin', 'middlename': None, 'lastname': 'Weiser', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9b4e2897-dc69-5723-9f3d-a80846297e35', 'word_count': 320, 'uri': 'nyt://article/9b4e2897-dc69-5723-9f3d-a80846297e35'}, {'abstract': 'Dianne Wiest delivers a fearless performance in a play that examines the trap that human life can become, at Yale Repertory Theater.', 'web_url': 'https://www.nytimes.com/2016/05/10/theater/review-happy-days-an-unsettling-glimpse-into-the-existential-abyss.html', 'snippet': 'Dianne Wiest delivers a fearless performance in a play that examines the trap that human life can become, at Yale Repertory Theater.', 'lead_paragraph': 'NEW HAVEN — The image we see when the curtain rises on “Happy Days” is as bizarre as it is bleak, even by the hardly cheery standards of the play’s author, Samuel Beckett. Winnie, the central character — really the only one — is immured in earth up to her waist. In the Yale Repertory Theater production here, the Winnie who greets us after the ringing of the wake-up bell is none other than Dianne Wiest, the Oscar winner and onetime regular in Woody Allen movies who has recently returned to the stage, where her career began.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/10/arts/10HAPPYDAYx/10HAPPYDAY-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/05/10/arts/10HAPPYDAYx/10HAPPYDAY-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/10/arts/10HAPPYDAYx/10HAPPYDAY-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/10/arts/10HAPPYDAYx/10HAPPYDAY-superJumbo.jpg', 'height': 1332, 'width': 1999, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/10/arts/10HAPPYDAYx/10HAPPYDAY-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/05/10/arts/10HAPPYDAYx/10HAPPYDAY-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/10/arts/10HAPPYDAYx/10HAPPYDAY-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: ‘Happy Days,’ an Unsettling Glimpse Into the Existential Abyss', 'kicker': None, 'content_kicker': None, 'print_headline': 'An Unsettling Glimpse  Into the Existential Abyss', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Beckett, Samuel', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Yale