/05/04/arts/04SINALAS/04SINALAS-jumbo.jpg', 'height': 577, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/04/arts/04SINALAS/04SINALAS-superJumbo.jpg', 'height': 1154, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/04/arts/04SINALAS/04SINALAS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/05/04/arts/04SINALAS/04SINALAS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/05/04/arts/04SINALAS/04SINALAS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: ‘Sin Alas’ Opens Up a Time Capsule in a Changing Havana', 'kicker': None, 'content_kicker': None, 'print_headline': ' A Changing Cuba Unfolds, but the Past Rushes Back', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Sin Alas (Movie)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Chace, Ben', 'rank': 3, 'major': 'N'}], 'pub_date': '2016-05-03T22:00:28+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Movies', 'byline': {'original': 'By Manohla Dargis', 'person': [{'firstname': 'Manohla', 'middlename': None, 'lastname': 'Dargis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/ab601f1f-faf9-5e28-a3c7-a063b73bb713', 'word_count': 462, 'uri': 'nyt://article/ab601f1f-faf9-5e28-a3c7-a063b73bb713'}