ness/state-tax-revenue-map-ebpromo/state-tax-revenue-map-1614295652582-superJumbo-v3.png', 'height': 1331, 'width': 2000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/02/25/business/state-tax-revenue-map-ebpromo/state-tax-revenue-map-1614295652582-thumbStandard-v3.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/02/25/business/state-tax-revenue-map-ebpromo/state-tax-revenue-map-1614295652582-thumbStandard-v3.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/02/25/business/state-tax-revenue-map-ebpromo/state-tax-revenue-map-1614295652582-thumbLarge-v3.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'State Aid, California, Cuomo: Your Monday Evening Briefing', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2021-03-01T22:54:31+0000', 'document_type': 'article', 'news_desk': 'NYTNow', 'section_name': 'Briefing', 'byline': {'original': 'By Victoria Shannon and Judith Levitt', 'person': [{'firstname': 'Victoria', 'middlename': None, 'lastname': 'Shannon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Judith', 'middlename': None, 'lastname': 'Levitt', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'briefing', '_id': 'nyt://article/5f81652a-a0f4-5475-9533-52ec75e6d06e', 'word_count': 1396, 'uri': 'nyt://article/5f81652a-a0f4-5475-9533-52ec75e6d06e'}, {'abstract': 'Two services, WEAT and Taste, offer New Yorkers dinner ideas from the likes of Bolero, Mifune and Casa Enrique.', 'web_url': 'https://www.nytimes.com/2021/03/01/dining/weat-meal-kit-taste.html', 'snippet': 'Two services, WEAT and Taste, offer New Yorkers dinner ideas from the likes of Bolero, Mifune and Casa Enrique.', 'lead_paragraph': 'Food delivery platforms for restaurants cover a wide spectrum of cuisines and prices. The new service WEAT offers meal packages from small independent restaurants trying to hang on during the pandemic. The boxes, from an array of cuisines, contain the components for dishes to prepare. A dumpling kit with a bamboo steamer from 456 New Shanghai is $40, and a copious and complex Vietnamese meal serving two from Bolero is $80 ($75 for vegetarian). Individual items are also sold. Ingredients are premeasured — often including items that are hard to find — and some of the instructions and labeling could be more precise. Ramp up the price point and you have another set of options from Taste, offering complete meal boxes from restaurants with Michelin stars on a weekly rotating basis. They require finishing at home with well-written instructions. The restaurants include Musket Room (fine duck rillettes, roast chicken, barley with mushrooms), Crown Shy, Benno, Mifune, Gabriel Kreuther, Casa Enrique and others, $29 to $108 per person. Delivery is extra, but not punishing. ', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/03/dining/01burner-kit/01burner-kit-articleLarge.jpg', 'height': 503, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/03/03/dining/01burner-kit/01burner-kit-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 503}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/03/dining/01burner-kit/01burner-kit-jumbo.jpg', 'height': 858, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'l