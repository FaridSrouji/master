me': 'New York', 'byline': {'original': 'By James Estrin', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': 'Estrin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e6642762-2b3f-50e1-af44-6d381b2bfd0d', 'word_count': 497, 'uri': 'nyt://article/e6642762-2b3f-50e1-af44-6d381b2bfd0d'}, {'abstract': 'The Pulitzer Prize-winning novelist and Academy Award-winning screenwriter explored the myths and legacies of the West in his work.', 'web_url': 'https://www.nytimes.com/2021/03/26/books/best-larry-mcmurtry-books.html', 'snippet': 'The Pulitzer Prize-winning novelist and Academy Award-winning screenwriter explored the myths and legacies of the West in his work.', 'lead_paragraph': 'Larry McMurtry, who died on Thursday at age 84, left behind a trove of work that explored the myths and legacy of the West. Many of his best books — including “Horseman, Pass By,” “The Last Picture Show,” “Leaving Cheyenne” and “Lonesome Dove” — were made into movies or TV shows that have since eclipsed the original novels. Do yourself a favor and pick them up again.', 'print_section': 'A', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/14/books/MCMURTRYREADER1/MCMURTRYREADER1-articleLarge.jpg', 'height': 397, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/08/14/books/MCMURTRYREADER1/MCMURTRYREADER1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 397}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/14/books/MCMURTRYREADER1/MCMURTRYREADER1-jumbo.jpg', 'height': 678, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': '