 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8fad5440-bf72-5419-bac2-32f15102145b', 'word_count': 1300, 'uri': 'nyt://article/8fad5440-bf72-5419-bac2-32f15102145b'}, {'abstract': 'The city may be only months from seeming like its old self. But the pandemic has changed many lives.', 'web_url': 'https://www.nytimes.com/2021/03/27/nyregion/pandemic-nyc.html', 'snippet': 'The city may be only months from seeming like its old self. But the pandemic has changed many lives.', 'lead_paragraph': 'The old job, the old office, the old week — for many New Yorkers, the possibility of the return of something resembling their old life appears finally within reach. For them, the year of the pandemic was a blip, a pause, however frustrating, in their lives.', 'print_section': 'A', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/28/nyregion/00nyvirus-mood-04/00nyvirus-mood-04-articleLarge-v2.jpg', 'height': 800, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/03/28/nyregion/00nyvirus-mood-04/00nyvirus-mood-04-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 800}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/28/nyregion/00nyvirus-mood-04/00nyvirus-mood-04-jumbo-v2.jpg', 'height': 1024, 'width': 768, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/28/nyregion/00nyvirus-mood-04/00nyvirus-mood-04-superJumbo-v2.jpg', 'height': 2048, 'width': 1536, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/28/nyregion/00nyvirus-mood-04/00nyvirus-mood-04-thumbStandard-v2.jpg', 'height':