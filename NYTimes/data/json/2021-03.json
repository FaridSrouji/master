major': 'N'}], 'pub_date': '2021-03-13T16:58:57+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'byline': {'original': 'By Jessica Silver-Greenberg and Robert Gebeloff', 'person': [{'firstname': 'Jessica', 'middlename': None, 'lastname': 'Silver-Greenberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Robert', 'middlename': None, 'lastname': 'Gebeloff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0a73fe88-5445-51a9-b0ac-8f3450c7e3f1', 'word_count': 240, 'uri': 'nyt://article/0a73fe88-5445-51a9-b0ac-8f3450c7e3f1'}, {'abstract': 'You’ll have to get up pretty early in the morning, in the dark, to solve this Emily Cox and Henry Rathvon acrostic.', 'web_url': 'https://www.nytimes.com/2021/03/13/crosswords/variety-acrostic.html', 'snippet': 'You’ll have to get up pretty early in the morning, in the dark, to solve this Emily Cox and Henry Rathvon acrostic.', 'lead_paragraph': 'ACROSTIC — If you’re here for hints, get ready to spring forward and finish this acrostic. That last sentence is kind of a spoiler, actually, especially if it reminds you (as it did me) that daylight saving happens this weekend; that’s the subject of the passage today. It’s from a book called “Spring Forward: The Annual Madness of Daylight Saving Time,” by Michael Downing, and it involves a proposal by an American founding father that long preceded electric light.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Variety: Acrostic', 'kicker': 'SUNDAY VARIETY COLUMN', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Acrostic Puzzles', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Downing, Michael', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Cox, Emily (Crossword Constructor)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Rathvon, Henry', 'rank': 4, 'major': 'N'}], 'pub_date': '2021-03-13T17:00:02+0000', 'document_type': 'article', 'news_desk': 'Games', 'section_name': 'Crosswords & Games', 'byline': {'original': 'By Caitlin Lovinger', 'person': [{'firstname': 'Caitlin', 'middlename': None, 'lastname': 'Lovinger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/65a91dd0-0abd-57a0-a26d-10fda52ae501', 'word_count': 244, 'uri': 'nyt://article/65a91dd0-0abd-57a0-a26d-10fda52ae501'}, {'abstract': '“Her door being kicked in was our door being kicked in,” a former state representative said as the first anniversary of Ms. Taylor’s death approached. “It really has transformed everything.”', 'web_url': 'https://www.nytimes.com/2021/03/13/us/breonna-taylor-death-anniversary.html', 'snippet': '“Her door being kicked in was our door being kicked in,” a former state representative said as the first anniversary of Ms. Taylor’s death approached. “It really has transformed everything.”', 'lead_paragraph': 'Exactly one year ago, a young woman died as a barrage of police gunfire ripped through the walls of her modest apartment in Louisville, Ky. For months, her death went largely unrecognized.', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/13/us/13breonna1/merlin_185004384_aff5ff2b-2e16-4471-bba7-3cc24e5f0af2-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/03/13/us/13breonna1/merlin_185004384_aff5ff2b-2e16-4471-bba7-3cc24e5f0af2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/13/us/13b