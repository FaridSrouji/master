sters with messages: “I survived the Hough riots”; “Growing your own food is like printing your own money.”', 'print_section': 'M2', 'print_page': '50', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/26/t-magazine/26tmag-terroir-02/26tmag-terroir-02-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/03/26/t-magazine/26tmag-terroir-02/26tmag-terroir-02-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/26/t-magazine/26tmag-terroir-02/26tmag-terroir-02-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/26/t-magazine/26tmag-terroir-02/26tmag-terroir-02-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/26/t-magazine/26tmag-terroir-02/26tmag-terroir-02-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/03/26/t-magazine/26tmag-terroir-02/26tmag-terroir-02-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/26/t-magazine/26tmag-terroir-02/26tmag-terroir-02-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Growers, Bakers and Beekeepers Embracing the Terroir of American Cities', 'kicker': 'Food Matters', 'content_kicker': None, 'print_headline': 'The Tast