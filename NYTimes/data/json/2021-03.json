 None, 'type': 'image', 'url': 'images/2021/04/04/business/22timbray5/22timbray5-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What Is Amazon Doing to Our Country?', 'kicker': 'Nonfiction', 'content_kicker': None, 'print_headline': 'Prime Suspect', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Delivery Services', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Income Inequality', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Amazon.com Inc', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Washington Post', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Bezos, Jeffrey P', 'rank': 8, 'major': 'N'}, {'name': 'creative_works', 'value': 'Fulfillment: Winning and Losing in One-Click America (Book)', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'MacGillis, Alec', 'rank': 10, 'major': 'N'}], 'pub_date': '2021-03-24T09:00:05+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Xiaowei Wang', 'person': [{'firstname': 'Xiaowei', 'middlename': None, 'lastname': 'Wang', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/a945b361-d47e-5384-8010-b9098dde092c', 'word_count': 1269, 'uri': 'nyt://article/a945b361-d47e-5384-8010-b9098dde092c'}, {'abstract': 'The Japanese clay vessel is perfect for hot pots like this chicken-meatball nabe.', 'web_url': 'https://www.nytimes.com/2021/03/24/magazine/donabe-recipe.html', 'snippet': 'The Japanese clay vessel is perfect for hot pots like this chicken-meatball nabe.', 'lead_paragraph': 'A donabe is a Japanese cooking vessel made of clay — do means “clay,” nabe means “pot.” But if you talk to Naoko Takei Moore, it’s also a way of thinking about cooking, a way of finding joy in the day-to-day of the kitchen. Takei Moore, who was born in Yokohama and grew up in Tokyo, remembers the communal-style donabe at the center of her family’s dining table year round, and how it drew everyone toward it for the simmering dish known as a nabe, or hot pot. “The most common style when I was growing up was yosenabe, which means anything goes,” she said. Some nights, that meant a pot of fish and vegetables in a miso broth, or a clean-out-the-fridge pot of scraps simmered in dashi. Some nights it was tiny handmade meatballs seasoned with white miso and ginger, or big wobbly cuts of soft tofu with whatever vegetables looked good. “I loved it, but didn’t think it was anything special,” she said. ', 'print_section': 'MM', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/28/magazine/28mag-eat/28mag-eat-articleLarge.jpg', 'height': 505, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/03/28/magazine/28mag-eat/28mag-eat-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 505}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/28/magazine/28mag-eat/28mag-eat-jumbo.jpg', 'height': 862, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/28/magazine/28mag-eat/28mag-eat-superJumbo.jpg', 'height': 1724, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 't