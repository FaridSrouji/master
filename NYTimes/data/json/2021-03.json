 I never found the right chair.', 'print_section': 'BU', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/07/business/06Workfriend-01/merlin_184316538_68fd19ee-cae2-415e-b3ef-820061c8fab9-articleLarge.jpg', 'height': 750, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/03/07/business/06Workfriend-01/merlin_184316538_68fd19ee-cae2-415e-b3ef-820061c8fab9-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 750}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/07/business/06Workfriend-01/merlin_184316538_68fd19ee-cae2-415e-b3ef-820061c8fab9-jumbo.jpg', 'height': 1024, 'width': 820, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/07/business/06Workfriend-01/merlin_184316538_68fd19ee-cae2-415e-b3ef-820061c8fab9-superJumbo.jpg', 'height': 2048, 'width': 1639, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/07/business/06Workfriend-01/merlin_184316538_68fd19ee-cae2-415e-b3ef-820061c8fab9-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/03/07/business/06Workfriend-01/merlin_184316538_68fd19ee-cae2-415e-b3ef-820061c8fab9-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/07/business/06Workfriend-01/merlin_184316538_68fd19ee-cae2-415e-b3ef-820061c8fab9-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Year W