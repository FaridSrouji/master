021/03/30/sports/30nfl-meeting-1/30nfl-meeting-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/03/30/sports/30nfl-meeting-1/30nfl-meeting-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/30/sports/30nfl-meeting-1/30nfl-meeting-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'N.F.L. Officially Adds 17th Regular Season Game', 'kicker': None, 'content_kicker': None, 'print_headline': 'Done Deal: League Adds One More Game, Pushing Back Super Bowl', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'National Football League', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Goodell, Roger', 'rank': 3, 'major': 'N'}], 'pub_date': '2021-03-30T19:58:56+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Ken Belson', 'person': [{'firstname': 'Ken', 'middlename': None, 'lastname': 'Belson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1287e0c7-a483-553d-aee0-982b0d1928aa', 'word_count': 834, 'uri': 'nyt://article/1287e0c7-a483-553d-aee0-982b0d1928aa'}, {'abstract': 'The creators of Canal Street Research Association have lost their lease but they can still show the way for a new arts community.', 'web_url': 'https://www.nytimes.com/2021/03/30/arts/design/bootlegs-art-canal-street.html', 'snippet': 'The creators of Canal Street Research Association have lost their lease but they can still show the way for a new arts community.', 'lead_paragraph': 'The central section of Canal Street, between the thrum of Chinatown and the maw of the Holland Tunnel, is a great artery only in the utilitarian sense. In the early 1800s, an actual canal moved water fouled by manufacturing waste to the Hudson River. Some planners imagined a Venice-like promenade, but it was rudely paved over instead.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/29/arts/29canal-research-1/29canal-research-1-articleLarge-v2.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/03/29/arts/29canal-research-1/29canal-research-1-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/29/arts/29canal-research-1/29canal-research-1-jumbo-v2.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/29/arts/29canal-research-1/29canal-research-1-superJumbo-v2.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/29/arts/29canal-research-1/29canal-research-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/03/29/arts/29canal-research-1/29canal-research-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/29/arts/29canal-research-1/29canal-research-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Bags, Bootlegs and Art: A Quirky Communion on Canal Street', 'kicker': 'Reporter’s Notebook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Culture (Arts)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Counterfeit Merchandise', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Canal Street (Manhattan, NY)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Lin, Ming (Artist)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Tatarsky, Alexandra', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Canal Street Research Assn', 'rank': 7, 'major': 'N'}], 'pub_date': '2021-03-30T19:59:19+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Siddhartha Mitter', 'person': [{'firstname': 'Siddhartha', 'middlename': None, 'lastname': 'Mitter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1dea89a4-9ec7-5aed-b065-c606e4711de5', 'word_count': 1363, 'uri': 'nyt://article/1dea89a4-9ec7-5aed-b065-c606e4711de5'}, {'abstract': 'Modern Love in miniature, featuring reader-submitted stories of no more than 100 words.', 'web_url': 'https://www.nytimes.com/2021/03/30/style/tiny-modern-love-stories-i-didnt-want-her-to-stay-long.html', 'snippet': 'Modern Love in miniature, featuring reader-submitted stories of no more than 100 words.', 'lead_paragraph': '“Why is this night different from all the others?” Last Passover, there were more ways than usual. My father was hospitalized with low oxygen. My mother and sister, also sick, spent the holiday clutching their phones in case he called. I was with my partner, crying over chicken broth, gripped by fear. This year, I remember the virus that passed over my own blood, sparing my father as the Israelites were spared from the final plague. I find new meaning in “Dayenu,” a Seder song of gratitude with the refrain: “It would have been enough.” My family’s health will always be enough. — Amanda Glickman', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/02/23/fashion/00MARCH-TINYLOVEILLO3/00MARCH-TINYLOVEILLO3-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/02/23/fashion/00MARCH-TINYLOVEILLO3/00MARCH-TINYLOVEILLO3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/02/23/fashion/00MARCH-TINYLOVEILLO3/00MARCH-TINYLOVEILLO3-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/02/23/fashion/00MARCH-TINYLOVEILLO3/00MARCH-TINYLOVEILLO3-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/02/23/fashion/00MARCH-TINYLOVEILLO3/00MARCH-TINYLOVEILLO3-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/02/23/fashion/00MARCH-TINYLOVEILLO3/00MARCH-TINYLOVEILLO3-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/02/23/fashion/00MARCH-TINYLOVEILLO3/00MARCH-TINYLOVEILLO3-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Tiny Love Stori