-v3.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/26/world/26france-rwanda-1sub/26france-rwanda-1sub-jumbo-v3.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/26/world/26france-rwanda-1sub/26france-rwanda-1sub-superJumbo-v3.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/26/world/26france-rwanda-1sub/26france-rwanda-1sub-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/03/26/world/26france-rwanda-1sub/26france-rwanda-1sub-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/26/world/26france-rwanda-1sub/26france-rwanda-1sub-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'France Has ‘Overwhelming’ Responsibility for Rwanda Genocide, Report Says', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'War Crimes, Genocide and Crimes Against Humanity', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'France', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Rwanda', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'AFRICA', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Kagame, Paul', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Mitterrand, Francois', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Ma