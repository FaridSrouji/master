-v2.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/06/arts/05violin-2/05violin-2-superJumbo-v2.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/06/arts/05violin-2/05violin-2-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/03/06/arts/05violin-2/05violin-2-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/06/arts/05violin-2/05violin-2-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Composer’s Notes Echo After His Death', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Composer’s Notes  Echo After His Death', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Classical Music', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Orchestre Philharmonique de Radio France', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Aho, Kalevi', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Hahn, Hilary', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Rautavaara, Einojuhani', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Franck, Mikko', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Finland', 'rank': 7, 'major': 'N'}], 'pub_date': '2021-03-05T15:20:33+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Corinna da Fonseca-Wollheim', 'person': [{'firstname': '', 'middlename'