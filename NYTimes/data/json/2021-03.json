 5, 'major': 'N'}, {'name': 'subject', 'value': 'Dementia', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Grief (Emotion)', 'rank': 7, 'major': 'N'}], 'pub_date': '2021-03-31T09:00:30+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Sarah Mervosh', 'person': [{'firstname': 'Sarah', 'middlename': None, 'lastname': 'Mervosh', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/780e4af6-12dd-576c-9588-ff2c0f687bc9', 'word_count': 1552, 'uri': 'nyt://article/780e4af6-12dd-576c-9588-ff2c0f687bc9'}, {'abstract': 'Generation Etsy has dusted off the wooden box handbags she designed in the 1960s. And now her son, Jeep, is publishing a memoir.', 'web_url': 'https://www.nytimes.com/2021/03/31/style/enid-collins-bags.html', 'snippet': 'Generation Etsy has dusted off the wooden box handbags she designed in the 1960s. And now her son, Jeep, is publishing a memoir.', 'lead_paragraph': 'If the handbag is indeed going the way of the hat — not an item we need, as a year of quarantine proved, but a flourish, a fillip, a pick-me-up — then Enid Collins, a prolific accessories designer of the last century, was prescient. “Make something good, something with personality, glamorize it like hell, and then get up and brag about it loudly!” she wrote once, laying out her winning formula to a relative.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/01/fashion/31ENIDCOLLINS-daisies/31ENIDCOLLINS-daisies-articleLarge-v2.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/04/01/fashion/31ENIDCOLLINS-daisies/31ENIDCOLLINS-daisies-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit