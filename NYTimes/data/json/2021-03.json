ion/sunday/07Bruni/07Bruni-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/07/opinion/sunday/07Bruni/07Bruni-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Is the Burger Nearing Extinction?', 'kicker': None, 'content_kicker': None, 'print_headline': 'Beef Is Past Its Prime', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Hamburgers', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Fungi', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Proteins', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Start-ups', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Fast Food Industry', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Meat', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Good Food Institute', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': "Nature's Fynd (Fynder Group Inc)", 'rank': 8, 'major': 'N'}], 'pub_date': '2021-03-06T19:29:35+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Frank Bruni', 'person': [{'firstname': 'Frank', 'middlename': None, 'lastname': 'Bruni', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/7fcc7476-cfb1-53b5-aab8-3c35a2eca07b', 'word_count': 1321, 'uri': 'nyt://article/7fcc7476-cfb1-53b5-aab8-3c35a2eca07b'}, {'abstract': 'The Dr. Seuss cancellation illustrates all the problems that they used to have with censorship.', 'web_url': 'https://www.nytimes.com/2021/03/06/opinion/dr-seuss-books-liberalism.html', 'snippet': 'The Dr. Seuss cancellation illustrates all the problems that they used to have with censorship.', 'lead_paragraph': 'From the idealistic liberalism of my high school English teachers, I learned that to try to get rid of offensive literature is the great sin of easily triggered rubes. A special horror at banning books, which usually meant removing them from the curriculum in some rural school district, pervaded our libraries and classrooms. And a particular shame seemed to throb in my teachers’ breasts when they admitted that some books were even targeted — “The Adventures of Huckleberry Finn,” say — for misguided progressive reasons.', 'print_section': 'SR', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/07/opinion/06douthat-lead/06douthat-lead-articleLarge.jpg', 'height': 847, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/03/07/opinion/06douthat-lead/06douthat-lead-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 847}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/07/opinion/06douthat-lead/06douthat-lead-jumbo.jpg', 'height': 1024, 'width': 725, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/07/opinion/06douthat-lead/06douthat-lead-superJumbo.jpg', 'height': 2048, 'width': 1450, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/07/opinion/06douthat-lead/06douthat-lead-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/03/07/opinion/06douthat-lead/06douthat-lead-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 't