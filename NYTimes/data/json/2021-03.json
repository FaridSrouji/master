9c3abd3', 'word_count': 1317, 'uri': 'nyt://article/a3100582-b470-5d2b-baf4-91c559c3abd3'}, {'abstract': 'The career of the New York governor helps explain how someone so powerful and popular could find himself alone so fast.', 'web_url': 'https://www.nytimes.com/2021/03/19/podcasts/the-daily/andrew-cuomo-sexual-harassement-nursing-homes.html', 'snippet': 'The career of the New York governor helps explain how someone so powerful and popular could find himself alone so fast.', 'lead_paragraph': 'Since entering the political fray in the 1970s as an aide to his father, Mario Cuomo, a three-term New York governor, Andrew Cuomo has always been known as a hard-charging, ruthless operator.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Ruthless Rise and Lonely Decline of Andrew Cuomo', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Sexual Harassment', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Party', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Cuomo, Andrew M', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Cuomo, Mario M', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'New York State', 'rank': 7, 'major': 'N'}], 'pub_date': '2021-03-19T10:01:16+0000', 'document_type': 'article', 'news_desk': 'Podcasts', 'section_name': 'Podcasts', 'subsection_name': 'The Daily', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bc52f4a8-07db-5f4e-a5f5-13347b4608a4', 'word_count': 322, 'uri': 'nyt://article/bc52f4a8-07db-5f4e-a5f5-13347b4608a4'}, {'abstract': 'The Biden administration’s strategy to curb Beijing faces a stiff challenge as China uses its economic, diplomatic and military might to deflect criticism.', 'web_url': 'https://www.nytimes.com/2021/03/19/world/asia/china-us-alaska.html', 'snippet': 'The Biden administration’s strategy to curb Beijing faces a stiff challenge as China uses its economic, diplomatic and military might to deflect criticism.', 'lead_paragraph': 'ANCHORAGE — The Biden administration’s first face-to-face encounter with China ended Friday after a vivid demonstration of how the world’s two largest economic and technological powers are facing a widening gulf of distrust and disagreements on a range of issues that will shape the global landscape for years to come.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Tense Talks With China Left U.S. ‘Cleareyed’ About Beijing’s Intentions, Officials Say', 'kicker': None, 'content_kicker': None, 'print_headline': 'Testy Exchange Shows the U.S. A Bolder China', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'China', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States International Relations', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'State Department', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Biden, Joseph R Jr', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Blinken, Antony J', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Sullivan, Jacob J (1976- )', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Xi Jinping', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Wang Yi', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Yang Jiechi', 'rank': 10, 'major': 'N'}, {'name': 'organizations', 'value': 'Communist Party of China', 'rank': 11, 'major': 'N'}, {'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 12, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 13, 'major': 'N'}, {'name': 'subject', 'value': 'Economic Conditions and Trends', 'rank': 14, 'major': 'N'}, {'name': 'subject', 'value': 'International Trade and World Market', 'rank': 15, 'major': 'N'}], 'pub_date': '2021-03-19T10:20:08+0000', 'document_type': 'article', 'news_desk': 'Washington', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Lara Jakes and Steven Lee Myers', 'person': [{'firstname': 'Lara', 'middlename': None, 'lastname': 'Jakes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Steven', 'middlename': 'Lee', 'lastname': 'Myers', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f0410673-ac26-5a2b-a9e1-993c51280e12', 'word_count': 1659, 'uri': 'nyt://article/f0410673-ac26-5a2b-a9e1-993c51280e12'}, {'abstract': 'Modest measures can reverse the dangerous decay in relations.', 'web_url': 'https://www.nytimes.com/2021/03/19/opinion/us-china-biden.html', 'snippet': 'Modest measures can reverse the dangerous decay in relations.', 'lead_paragraph': 'Since taking office nearly two months ago, the Biden administration has been a whirlwind of activity in reforming and revisiting almost every key problem area but one: the chaotic and incoherent China policy it inherited from the Trump administration.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/22/opinion/22johnson2-inyt/merlin_185227233_999c3c6e-2437-4e66-94a7-5256f968e3d7-articleLarge.jpg', 'height': 323, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/03/22/opinion/22johnson2-inyt/merlin_185227233_999c3c6e-2437-4e66-94a7-5256f968e3d7-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 323}}, {'rank': 0, 'subtype':