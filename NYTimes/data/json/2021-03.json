umbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/07/multimedia/07ah-ILLOSDUNGEONS-02/07ah-ILLOS-02-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Escape Your Reality With Role-Playing Games', 'kicker': None, 'content_kicker': None, 'print_headline': 'Escape Reality With Role-Playing Games', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Quarantine (Life and Culture)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Games', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Content Type: Service', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'Dungeons & Dragons (Game)', 'rank': 5, 'major': 'N'}], 'pub_date': '2021-03-07T04:41:06+0000', 'document_type': 'article', 'news_desk': 'AtHome', 'section_name': 'At Home', 'byline': {'original': 'By Alexis Soloski', 'person': [{'firstname': 'Alexis', 'middlename': None, 'lastname': 'Soloski', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/343fc78b-1b36-5a83-bc94-36b0103d10cd', 'word_count': 1205, 'uri': 'nyt://article/343fc78b-1b36-5a83-bc94-36b0103d10cd'}, {'abstract': 'A simple roll of newspaper creates a biodegradable pot to get your spring planting season off the ground.', 'web_url': 'https://www.nytimes.com/2021/03/06/at-home/grow-seedlings-with-newspaper.html', 'snippet': 'A simple roll of newspaper creates a biodegradable pot to get your spring planting season off the ground.', 'lead_paragraph': 'For those dreaming of spring, starting seeds indoors allows you to begin the growing season earlier than planting them outdoors (where you have to wait until after the final frost). And some plants, like certain tender vegetables, just do better starting indoors. With so many seeds in those little packets, finding enough containers can be a task. Instead of buying containers (or even using recycled plastic ones), try a simple technique to turn this newspaper into biodegradable pots that you can plant directly into your garden (therefore not disturbing your seedlings’ roots) when conditions are suitable. Until then, enjoy the up-close seed-sprouting show, which every year feels like a mini-miracle.', 'print_section': 'D', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/07/multimedia/07ah-seedlingactivity1/07ah-seedlingactivity1-articleLarge.jpg', 'height': 450, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/03/07/multimedia/07ah-seedlingactivity1/07ah-seedlingactivity1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 450}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/07/multimedia/07ah-seedlingactivity1/07ah-seedlingactivity1-jumbo.jpg', 'height': 768, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/07/multimedia/07ah-seedlingactivity1/07ah-seedlingactivity1-superJumbo.jpg', 'height': 1536, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/07/multimedia/07ah-seedlingactivity1/07ah-seedlingactivity1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/03/07/multimedia/07ah-seedlingactivity1/07ah-seedlingactivity1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight':