, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/03/11/sports/11golftenn1/merlin_182993427_b0502a37-c08f-46b7-9bbc-b5bbfab23e8e-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/11/sports/11golftenn1/merlin_182993427_b0502a37-c08f-46b7-9bbc-b5bbfab23e8e-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/11/sports/11golftenn1/merlin_182993427_b0502a37-c08f-46b7-9bbc-b5bbfab23e8e-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/11/sports/11golftenn1/11golftenn1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/03/11/sports/11golftenn1/11golftenn1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/11/sports/11golftenn1/11golftenn1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Pandemic Drove People to Tennis and Golf. Will They Keep Playing?', 'kicker': None, 'content_kicker': None, 'print_headline': 'Tennis and Golf Look to Sustain Participation Surge', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Golf', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Tennis', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Shutdowns (Institutional)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'National Golf Foundation', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'United States Tennis Assn', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Quarantine (Life and Culture)', 'rank': 6, 'major': 'N'}], 'pub_date': '2021-03-12T00:46:21+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By Matthew Futterman and Bill Pennington', 'person': [{'firstname': 'Matthew', 'middlename': None, 'lastname': 'Futterman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Bill', 'middlename': None, 'lastname': 'Pennington', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fa6b9e9b-32b7-53c8-9394-022394a697b2', 'word_count': 1394, 'uri': 'nyt://article/fa6b9e9b-32b7-53c8-9394-022394a697b2'}, {'abstract': 'A new book reveals how the former first lady not only provided a spouse’s emotional ballast but also served as an unrivaled counselor who helped persuade Lyndon B. Johnson to stay in office.', 'web_url': 'https://www.nytimes.com/2021/03/11/us/politics/lady-bird-johnson-diaries-lbj.html', 'snippet': 'A new book reveals how the former first lady not only provided a spouse’s emotional ballast but also served as an unrivaled counselor who helped persuade Lyndon B. Johnson to stay in office.', 'lead_paragraph': 'WASHINGTON — He had been president for only two years, but that night in fall 1965 he had had enough. Lyndon B. Johnson had spiraled into depression, and from his hospital bed after gallbladder surgery, he talked of throwing it all away and retreating into seclusion back home in Texas.', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/11/us/politics/11dc-diaries-1/merlin_184883742_2f0416cf-6e7b-4d54-82