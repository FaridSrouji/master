{'name': 'subject', 'value': 'Teachers and School Employees', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Education', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Day Care Centers', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Children and Childhood', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Coronavirus Risks and Safety Concerns', 'rank': 8, 'major': 'N'}], 'pub_date': '2020-06-12T09:00:22+0000', 'document_type': 'article', 'news_desk': 'Upshot', 'section_name': 'The Upshot', 'byline': {'original': 'By Claire Cain Miller and Margot Sanger-Katz', 'person': [{'firstname': 'Claire', 'middlename': 'Cain', 'lastname': 'Miller', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Margot', 'middlename': None, 'lastname': 'Sanger-Katz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f5f71dbc-d9c2-5748-a303-fac84b93ec5a', 'word_count': 359, 'uri': 'nyt://article/f5f71dbc-d9c2-5748-a303-fac84b93ec5a'}, {'abstract': 'In a rare interview, the Nobel Prize winner discusses mortality, drawing inspiration from the past, and his new album, “Rough and Rowdy Ways.”', 'web_url': 'https://www.nytimes.com/2020/06/12/arts/music/bob-dylan-rough-and-rowdy-ways.html', 'snippet': 'In a rare interview, the Nobel Prize winner discusses mortality, drawing inspiration from the past, and his new album, “Rough and Rowdy Ways.”', 'lead_paragraph': 'A few years ago, sitting beneath shade trees in Saratoga Springs, N.Y., I had a two-hour discussion with Bob Dylan that touched on Malcolm X, the French Revolution, Franklin Roosevelt and World War II. At one juncture, he asked me what I knew about the Sand Creek Massacre of 1864. When I answered, “Not enough,” he got up from his folding chair, climbed into his tour bus, and came back five minutes later with photocopies describing how U.S. troops had butchered hundreds of peaceful Cheyenne and Arapahoe in southeastern Colorado.', 'print_section': 'AR', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/14/arts/14dylan1/merlin_146478750_0a7f707b-ed5c-4046-a922-d33d68db402d-articleLarge.jpg', 'height': 416, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/06/14/arts/14dylan1/merlin_146478750_0a7f707b-ed5c-4046-a922-d33d68db402d-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 416}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/14/arts/14dylan1/merlin_146478750_0a7f707b-ed5c-4046-a922-d33d68db402d-jumbo.jpg', 'height': 710, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/14/arts/14dylan1/merlin_146478750_0a7f707b-ed5c-4046-a922-d33d68db402d-superJumbo.jpg', 'height': 1419, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/14/arts/14dylan1/merlin_146478750_0a7f707b-ed5c-4046-a922-d33d68db402d-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/06/14/arts/14dylan1/merlin_146478750_0a7f707b-ed5c-4046-a922-d33d68db402d-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/14/arts/14dylan1/merlin_146478750_0a7f707b-ed5c-4046-a922-d33d68db402d-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Bob Dylan Has a Lot on His Mind', '