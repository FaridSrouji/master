es', 'kicker': None, 'content_kicker': None, 'print_headline': 'Men Accused Of Murdering Black Jogger Are Indicted', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Murders, Attempted Murders and Homicides', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Arbery, Ahmaud (1994-2020)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Holmes, Joyette M (1975- )', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'McMichael, Gregory (1955- )', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'McMichael, Travis (1986- )', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'BRUNSWICK (GA)', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Georgia', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'George Floyd Protests (2020)', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Bryan, William Roddie', 'rank': 9, 'major': 'N'}], 'pub_date': '2020-06-24T20:35:09+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Richard Fausset', 'person': [{'firstname': 'Richard', 'middlename': None, 'lastname': 'Fausset', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c60bc350-dd78-5627-9389-2e8e75b9726b', 'word_count': 682, 'uri': 'nyt://article/c60bc350-dd78-5627-9389-2e8e75b9726b'}, {'abstract': 'Having a seat at the table is good, but people of color need to be able to set the agenda too.', 'web_url': 'https://www.nytimes.com/2020/06/24/opinion/2020-campaigns-diversity.html', 'snippet': 'Having a seat at the table is good, but people of color need to be able to set the agenda too.', 'lead_paragraph': 'I have worked in politics for over 30 years. For most of those years, there have rarely been black or brown faces at the top level of most campaigns I’ve worked on. I am often the lone voice telling a room full of campaign professionals what it’s like to be pulled over by the police when you’re a brown man.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/27/opinion/24rocha1/merlin_170349615_13d79968-0ac5-4e3e-844d-5dea7c6f869a-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/06/27/opinion/24rocha1/merlin_170349615_13d79968-0ac5-4e3e-844d-5dea7c6f869a-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/27/opinion/24rocha1/merlin_170349615_13d79968-0ac5-4e3e-844d-5dea7c6f869a-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/27/opinion/24rocha1/merlin_170349615_13d79968-0ac5-4e3e-844d-5dea7c6f869a-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/27/opinion/24rocha1/24rocha1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/06/27/opinion/24rocha1/24rocha1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/27/opinion/24rocha1/24rocha1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The People Running Campaigns Don’t Look Like Me', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value'