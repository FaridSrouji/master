dlename': None, 'lastname': 'Kepner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4f23f1ad-f0d4-58e8-be8f-e95fff5f04d9', 'word_count': 802, 'uri': 'nyt://article/4f23f1ad-f0d4-58e8-be8f-e95fff5f04d9'}, {'abstract': 'The restaurant has opened an online shop to sell imported condiments along with its house wine, pottery and more.', 'web_url': 'https://www.nytimes.com/2020/06/22/dining/atoboy-atonae-shop.html', 'snippet': 'The restaurant has opened an online shop to sell imported condiments along with its house wine, pottery and more.', 'lead_paragraph': 'Some hard-to-find Korean condiments are now being sold by the restaurant Atoboy on its website Atonae. Along with the typical gochujang ($22 for about eight ounces), you’ll find Korean ganjang and cheongjang soy sauces ($25 for 8.45 ounces), lightly roasted perilla oil ($36 for 6.7 ounces) and lightly roasted sesame oil ($42 for 6.7 ounces). The condiments are imported from South Korea. The house’s California chenin blanc, made in collaboration with Broc Cellars, is $165 for six bottles.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/24/dining/24Burner-Atoboy-b/24Burner-Atoboy-b-articleLarge.jpg', 'height': 800, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/06/24/dining/24Burner-Atoboy-b/24Burner-Atoboy-b-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 800}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/24/dining/24Burner-Atoboy-b/24Burner-Atoboy-b-jumbo.jpg', 'height': 1024, 'width': 768, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/24/dining/24Burner-Atoboy-b/24Burner-Atoboy-b-superJumbo.jpg', 'height': 2048, 'width': 1536, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/24/dining/24Burner-Atoboy-b/24Burner-Atoboy-b-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/06/24/dining/24Burner-Atoboy-b/24Burner-Atoboy-b-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/24/dining/24Burner-Atoboy-b/24Burner-Atoboy-b-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Korean Condiments and House Wine From Atoboy', 'kicker': 'Front Burner', 'content_kicker': None, 'print_headline': 'To Season: Korean Condiments  From Atoboy', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Atoboy (Manhattan, NY, Restaurant)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Shopping and Retail', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Condiments', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'South Korea', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Wines', 'rank': 6, 'major': 'N'}], 'pub_date': '2020-06-23T00:18:25+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d8f530ca-ac87-5842-adde-9ea3e34a0910', 'word_count': 105, 'uri': 'nyt://article/d8f530ca-ac87-5842-adde-9ea3e34a0910'}, {'abstract': 'A new food guide provides a deep history of the Italian table, with etiquette, dishes and provincial specialties.', 'web_url': 'https://www.nytimes.com/2020/06/22/dining/eat-like-an-italian.html', 'snippet': 'A new food guide provides a deep history of the Italian table, with etiquette, dishes and provincial specialties.', 'lead_paragraph': 'Edwin Garrubbo — who is in the cosmetics business and an Italophile, with family ties to Italy — has written the “Garrubbo Guide,” a well-researched book with just about every detail of the Italian table. And for him, it’s best appreciated in Italy; he says America does not come close. He provides a concise history of Italian food and rules like “don’t cut your spaghetti” and describes most ingredients and dishes in detail. The book also gives a rundown of Italian wines and pasta shapes, lists the specialties of each province and includes a glossary. When it comes to coffee, he does not have nice things to say about Starbucks.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/22/dining/22BurnerBook/merlin_173630577_62be9e21-d0ea-4a64-9775-e3606348085a-articleLarge.jpg', 'height': 959, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/06/22/dining/22BurnerBook/merlin_173630577_62be9e21-d0ea-4a64-9775-e3606348085a-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 959}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/22/dining/22BurnerBook/merlin_173630577_62be9e21-d0ea-4a64-9775-e3606348085a-jumbo.jpg', 'height': 1024, 'width': 641, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/22/dining/22BurnerBook/merlin_173630577_62be9e21-d0ea-4a64-9775-e3606348085a-superJumbo.jpg', 'height': 1200, 'width': 751, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/22/dining/22BurnerBook/22BurnerBook-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/06/22/dining/22BurnerBook/22BurnerBook-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/22/dining/22BurnerBook/22BurnerBook-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Eat Like an Italian', 'kicker': 'Front Burner', 'content_kicker': None, 'print_headline': 'To Consult: Rules of the Italian Table: ‘Don’t Cut Your Spaghetti’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Italy', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Italian Food (Cuisine)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Garrubbo, Edwin', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'Garrubbo Guide: The Importance of Eating Italian (Book)', 'rank': 5, 'major': 'N'}], 'pub_date': '2020-06-23T00:20:35+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1b7f1361-31b9-5946-aca8-59ae9a35fcec', 'word_count': 149, 'uri': 'nyt://article/1b7f1361-31b9-5946-aca8-59ae9a35fcec'}, {'abstract': 'No other developed country is doing so badly.', 'web_url': 'https://www.nytimes.com/2020/06/22/opinion/us-coronavirus-trump.html', 'snippet': 'No other developed country is doing so badly.', 'lead_paragraph': 'Graphs of the coronavirus curves in Britain, Canada, Germany and Italy look like mountains, with steep climbs up and then back down. The one for America shows a fast climb up to a plateau. For a while, the number of new cases in the U.S. was at least slowly declining. Now, according to The Times, it’s up a terrifying 22 percent over the last 14 days.', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/22/opinion/22goldbergWeb/merlin_173741667_a9a729a9-6b38-450f-9a96-5e342eb0d1ef-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/06/22/opinion/22goldbergWeb/merlin_173741667_a9a729a9-6b38-450f-9a96-5e342eb0d1ef-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/22/opinion/22goldbergWeb/merlin_173741667_a9a729a9-6b38-450f-9a96-5e342eb0d1ef-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/22/opinion/22goldbergWeb/merlin_173741667_a9a729a9-6b38-450f-9a96-5e342eb0d1ef-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/22/opinion/22goldbergWeb/22goldbergWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', '