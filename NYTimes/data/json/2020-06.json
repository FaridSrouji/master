/nyregion/14doctorow/merlin_93590132_0a029faf-4ac9-4631-b8aa-7b1a73608809-articleLarge.jpg', 'height': 887, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/06/14/nyregion/14doctorow/merlin_93590132_0a029faf-4ac9-4631-b8aa-7b1a73608809-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 887}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/14/nyregion/14doctorow/merlin_93590132_0a029faf-4ac9-4631-b8aa-7b1a73608809-jumbo.jpg', 'height': 1024, 'width': 693, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/14/nyregion/14doctorow/merlin_93590132_0a029faf-4ac9-4631-b8aa-7b1a73608809-superJumbo.jpg', 'height': 2048, 'width': 1386, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/14/nyregion/14doctorow/10doctorow-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/06/14/nyregion/14doctorow/10doctorow-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/14/nyregion/14doctorow/10doctorow-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Master Storyteller’s Advice for Graduates: ‘Be Brave. Be Kind.’', 'kicker': None, 'content_kicker': None, 'print_headline': '‘Be Brave. Be Kind.’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Education (K-12)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Commencement Speeches', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Bronx High S