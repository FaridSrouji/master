r': 'N'}], 'pub_date': '2020-06-17T00:01:12+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Manohla Dargis and A.O. Scott', 'person': [{'firstname': 'Manohla', 'middlename': None, 'lastname': 'Dargis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'A.', 'middlename': 'O.', 'lastname': 'Scott', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9ba05a63-def9-53f6-b373-d51d278427cc', 'word_count': 1404, 'uri': 'nyt://article/9ba05a63-def9-53f6-b373-d51d278427cc'}, {'abstract': 'Over 280 million people a week depend on the V.O.A. for news. Its independence is why it is so trusted.', 'web_url': 'https://www.nytimes.com/2020/06/16/opinion/voice-of-america.html', 'snippet': 'Over 280 million people a week depend on the V.O.A. for news. Its independence is why it is so trusted.', 'lead_paragraph': 'Founded in 1942, the Voice of America was never meant to be a megaphone for the American government. The concept was the opposite: A federally funded broadcaster would showcase American values around the world by offering unbiased news and a true picture of American life. That mission is enshrined in what the V.O.A. calls its “firewall,” which “prohibits interference by any U.S. government official in the objective, independent reporting of news.”', 'print_section': 'A', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/17/opinion/17voa2/17voa2-articleLarge-v9.jpg', 'height': 517, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/06/17/opinion/17voa2/17voa2-articleLarge-v9.jpg', 'xlargewidth': 600, 'xlargeheight': 517}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'ty