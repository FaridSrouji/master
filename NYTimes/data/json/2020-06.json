'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Jim', 'middlename': None, 'lastname': 'Huylebroek', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a96e71b7-5807-5963-b830-f1333fa1612e', 'word_count': 1291, 'uri': 'nyt://article/a96e71b7-5807-5963-b830-f1333fa1612e'}, {'abstract': 'Jennifer Clair, who runs a cooking school, now offers a five-week camp to brush up on the basics.', 'web_url': 'https://www.nytimes.com/2020/06/08/dining/home-cooking-classes.html', 'snippet': 'Jennifer Clair, who runs a cooking school, now offers a five-week camp to brush up on the basics.', 'lead_paragraph': 'Perhaps you’ve been cooking for going on three months now, but the kitchen is still a challenge. Jennifer Clair, who has been running a hands-on cooking school for many years, is now offering a virtual five-week “camp” for adults, a series of lessons on the basics. From proper knife work, it goes on to preparing vegetables, then chicken, eggs, and legumes and grains. Each two-hour session includes the preparation of at least one and as many as four recipes. It’s open to one screen per household; each session is joined by a maximum of 10 screens. There are multiple sessions of each course.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/10/dining/08burner-class/merlin_173166693_239e3866-f0b6-420a-9939-b8e2727587e2-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/06/10/dining/08burner-class/merlin_173166693_239e3866-f0b6-420a-9939-b8e2727587e2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/10/dining/08burner-class/merlin_173166693_239e3866-f0b6-420a-9939-b8e2727587e2-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/10/dining/08burner-class/merlin_173166693_239e3866-f0b6-420a-9939-b8e2727587e2-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/10/dining/08burner-class/08burner-class-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/06/10/dining/08burner-class/08burner-class-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/10/dining/08burner-class/08burner-class-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Cooking Camp for Adults', 'kicker': 'Front Burner', 'content_kicker': None, 'print_headline': 'To Learn: Sharpen Your Skills At Cooking Camp', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ADULT EDUCATION', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Home Cooking New York', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Clair, Jennifer', 'rank': 4, 'major': 'N'}], 'pub_date': '2020-06-08T20:55:31+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organizat