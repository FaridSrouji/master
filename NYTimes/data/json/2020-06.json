17/arts/14brundage/14brundage-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Asian Art Museum to Remove Bust of Patron. That’s Just a Start.', 'kicker': None, 'content_kicker': None, 'print_headline': 'Museum To Move Patron’s Likeness', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Asian Art Museum', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Museums', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Xu, Jay', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Brundage, Avery', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Monuments and Memorials (Structures)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Discrimination', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Arts and Antiquities Looting', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'San Francisco (Calif)', 'rank': 8, 'major': 'N'}], 'pub_date': '2020-06-15T21:55:45+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Carol Pogash', 'person': [{'firstname': 'Carol', 'middlename': None, 'lastname': 'Pogash', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2dffc69d-f327-5af7-9a56-3ccdf4002896', 'word_count': 1540, 'uri': 'nyt://article/2dffc69d-f327-5af7-9a56-3ccdf4002896'}, {'abstract': 'He was behind Tina Turner’s “Better Be Good to Me” and hits by the Fixx and Howard Jones. He also made a dozen albums of his own songs.', 'web_url': 'https://www.nytimes.com/2020/06/15/arts/music/rupert-hine-synth-pop-music-producer-dies-at-72.html', 'snippet': 'He was behind Tina Turner’s “Better Be Good to Me” and hits by the Fixx and Howard Jones. He also made a dozen albums of his own songs.', 'lead_paragraph': 'Rupert Hine, a prolific English producer and songwriter who thrived in the synth-pop heyday of the 1980s making hits with Tina Turner, the Fixx and Howard Jones, died on June 4 at his home in Wiltshire, England. He was 72.', 'print_section': 'B', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/16/obituaries/15Hine1/15Hine1-articleLarge.jpg', 'height': 404, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/06/16/obituaries/15Hine1/15Hine1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 404}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/16/obituaries/15Hine1/15Hine1-jumbo.jpg', 'height': 689, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/16/obituaries/15Hine1/15Hine1-superJumbo.jpg', 'height': 1378, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/16/obituaries/15Hine1/15Hine1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/06/16/obituaries/15Hine1/15Hine1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/16/obituaries/15Hine1/15Hine1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Rupert Hine, Synth-Pop Music Producer, Dies at 72', 'kicker': None, 'content_kicker': None, 'print_headline': 'Rupert Hine, Source of Studio Magic in ’80s Synth-Pop Hits, Dies at 72', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Pop and Rock Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Nineteen Hundred Eighties', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Sheik, Duncan', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Bush, Kate', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Turner, Tina', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Hine, Rupert (1947-2020)', 'rank': 7, 'major': 'N'}], 'pub_date': '2020-06-15T21:59:50+0000', 'document_type': 'article', 'news_desk': 'Obits', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Jon Pareles', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Pareles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/aa074b80-a1c3-5b2c-acf8-33320d2c5905', 'word_count': 892, 'uri': 'nyt://article/aa074b80-a1c3-5b2c-acf8-33320d2c5905'}, {'abstract': 'Why are investors rushing to buy junk?', 'web_url': 'https://www.nytimes.com/2020/06/15/opinion/coronavirus-stock-market.html', 'snippet': 'Why are investors rushing to buy junk?', 'lead_paragraph': 'After all these years, Hertz is No. 1 again. Not in market share: The car-rental company is a distant second to Enterprise. But Hertz has become Exhibit #1 of the madness that has been sweeping the stock market in these times of Covid-19 — a madness that may do considerable harm, not because stock prices themselves matter all that much, but because Donald Trump and his minions treat the stock market as a measure of their success.', 'print_section': 'A', 'print_page': '31', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/15/opinion/15krugman1/me