name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'AIRLINES AND AIRPLANES', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Labor and Jobs', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Coronavirus (2019-nCoV)', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'AIR FRANCE', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'AIRBUS INDUSTRIE', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Dassault Aviation SA', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Safran SA', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Thales SA', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'France', 'rank': 10, 'major': 'N'}], 'pub_date': '2020-06-09T17:49:27+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Liz Alderman', 'person': [{'firstname': 'Liz', 'middlename': None, 'lastname': 'Alderman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8115e818-c553-5d37-8155-729577a9f6f3', 'word_count': 458, 'uri': 'nyt://article/8115e818-c553-5d37-8155-729577a9f6f3'}, {'abstract': 'Some came to the streets to dance. Others were moved to dance more spontaneously, and surprised to find themselves seen by millions online.', 'web_url': 'https://www.nytimes.com/2020/06/09/arts/dance/dancing-protests-george-floyd.html', 'snippet': 'Some came to the streets to dance. Others were moved to dance more spontaneously, and surprised to find themselves seen by millions online.', 'lead_paragraph': 'As protesters streamed through the streets of New York on Sunday afternoon, one group’s chants of “Black lives matter!” and “No justice, no peace!” gave way to a sound more often heard at weddings and block parties. On 125th Street in Harlem, hundreds of people, many of them professional dancers, had congregated for a peaceful march across town and a collective performance of the Electric Slide.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/10/arts/09street-dance1/merlin_173337204_a23056f4-81df-4acf-b661-d15e54be415c-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/06/10/arts/09street-dance1/merlin_173337204_a23056f4-81df-4acf-b661-d15e54be415c-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/10/arts/09street-dance1/merlin_173337204_a23056f4-81df-4acf-b661-d15e54be415c-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/10/arts/09street-dance1/merlin_173337204_a23056f4-81df-4acf-b661-d15e54be415c-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/10/arts/09street-dance1/09street-dance1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/06/10/arts/09street-dance1/09street-dance1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/10/arts/09street-dance1/09street-dance1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Dancing