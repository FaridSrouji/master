'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 9, 'major': 'N'}], 'pub_date': '2020-06-12T18:01:42+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Amy Harmon and Sabrina Tavernise', 'person': [{'firstname': 'Amy', 'middlename': None, 'lastname': 'Harmon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Sabrina', 'middlename': None, 'lastname': 'Tavernise', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/92261130-2a26-5766-a80b-d7fc9111f31e', 'word_count': 1390, 'uri': 'nyt://article/92261130-2a26-5766-a80b-d7fc9111f31e'}, {'abstract': 'My autistic son tried to hug an employee. Did you really need a police officer on the scene?', 'web_url': 'https://www.nytimes.com/2020/06/12/opinion/sunday/target-police-racism.html', 'snippet': 'My autistic son tried to hug an employee. Did you really need a police officer on the scene?', 'lead_paragraph': 'UNION, N.J. — Last week, the Target Corporation sent out an email about its commitment to “social justice.” “We stand with black families,” it said. A year and half ago, when a police officer intervened after an incident involving my disabled African-American son in a Target store, our family didn’t even get an apology.', 'print_section': 'SR', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/14/opinion/sunday/oliver1/oliver1-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/06/14/opinion/sunday/oliver1/oliver1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/20