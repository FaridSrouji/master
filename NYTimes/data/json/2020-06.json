le/6b32bb2b-68a5-59f8-8b36-21ce6575dc94'}, {'abstract': 'Quotation of the Day for Monday, June 29, 2020.', 'web_url': 'https://www.nytimes.com/2020/06/29/todayspaper/quotation-of-the-day-houston-surge-fills-hospitals-with-the-young.html', 'snippet': 'Quotation of the Day for Monday, June 29, 2020.', 'lead_paragraph': '“It hit me like a truck. Even if you are young and not at risk, it’s pretty scary.”', 'print_section': 'A', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Quotation of the Day: Houston Surge Fills Hospitals With the Young', 'kicker': None, 'content_kicker': None, 'print_headline': 'Quote of the Day', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2020-06-29T05:52:43+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Today’s Paper', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Quote', '_id': 'nyt://article/fdc45acf-356e-5b48-b398-517e149a0175', 'word_count': 29, 'uri': 'nyt://article/fdc45acf-356e-5b48-b398-517e149a0175'}, {'abstract': 'Police and paramilitary forces surrounded the exchange in Karachi during a firefight in which at least three security officers and four attackers were killed.', 'web_url': 'https://www.nytimes.com/2020/06/29/world/asia/pakistan-stock-exchange-shooting.html', 'snippet': 'Police and paramilitary forces surrounded the exchange in Karachi during a firefight in which at least three security officers and four attackers were killed.', 'lead_paragraph': 'Armed with assault rifles and hand grenades, separatist militants tried to storm Pakistan’s stock exchange in the city of Karachi on Monday, killing three people and wounding several others before security officers shot and killed the attackers, officials said.', 'print_section': 'A', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Gunmen Wage Deadly Battle at Pakistan Stock Exchange', 'kicker': None, 'con