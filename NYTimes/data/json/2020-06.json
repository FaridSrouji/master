virus-china/16virus-china-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/16/world/16virus-china/16virus-china-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Schools Shut in Beijing as Coronavirus Flares', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Coronavirus (2019-nCoV)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Communist Party of China', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Beijing (China)', 'rank': 4, 'major': 'N'}], 'pub_date': '2020-06-16T18:51:53+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Chris Buckley', 'person': [{'firstname': 'Chris', 'middlename': None, 'lastname': 'Buckley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ecbe8860-b9d4-5d35-9099-18b9cdf71db5', 'word_count': 822, 'uri': 'nyt://article/ecbe8860-b9d4-5d35-9099-18b9cdf71db5'}, {'abstract': 'A host of reasons raise questions about the effectiveness of this reform.', 'web_url': 'https://www.nytimes.com/2020/06/16/opinion/police-qualified-immunity.html', 'snippet': 'A host of reasons raise questions about the effectiveness of this reform.', 'lead_paragraph': 'The national movement galvanized by the killing of George Floyd has created the possibility of transformational change to policing. One reform that has generated broad discussion is eliminating “qualified immunity,” the court-created doctrine that makes it difficult for people whose civil rights are violated by police officers to obtain money damages in lawsuits. There are good arguments for getting rid of this immunity, or at least seriously restricting it. But abolishing it is unlikely to change police behavior all that much.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/16/opinion/16Epps/16Epps-articleLarge.jpg', 'height': 389, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/06/16/opinion/16Epps/16Epps-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 389}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/16/opinion/16Epps/16Epps-jumbo.jpg', 'height': 665, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/16/opinion/16Epps/16Epps-superJumbo.jpg', 'height': 1329, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/16/opinion/16Epps/16Epps-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/06/16/opinion/16Epps/16Epps-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/16/opinion/16Epps/16Epps-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Abolishing Qualified Immunity Is Unlikely to Alter Police Behavior', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Police Brutality, Misconduct and Shootings', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Immunity from Prosecution', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Police', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Police Department (Chicago, Ill)', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Supreme Court (US)', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Chauvin, Derek (1976- )', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Sotomayor, Sonia', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Thomas, Clarence', 'rank': 9, 'major': 'N'}], 'pub_date': '2020-06-16T19:00:10+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Daniel Epps', 'person': [{'firstname': 'Daniel', 'middlename': None, 'lastname': 'Epps', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/4243ce12-9801-5a16-86b8-e65e8327093f', 'word_count': 1052, 'uri': 'nyt://article/4243ce12-9801-5a16-86b8-e65e8327093f'}, {'abstract': 'Modern Love in miniature, featuring reader-submitted stories of no more than 100 words.', 'web_url': 'https://www.nytimes.com/2020/06/16/style/tiny-modern-love-stories-coronavirus-a-tipsy-celebratory-state-of-bliss.html', 'snippet': 'Modern Love in miniature, featuring reader-submitted stories of no more than 100 words.', 'lead_paragraph': 'I have one brother, Alex — a tall, broad black man who is a train operator for New York City’s M.T.A. The world is finally realizing that he’s “essential.” While Alex’s uniform may protect him from extrajudicial profiling, it also endangers him, requiring him to be exposed to the coronavirus. He’s always had to be tough, but since living with his girlfriend, he’s changed. Alex now tells my parents and me that he loves us. Out loud. I remember this change in myself when I first fell in love. Alex and I are 3,000 miles apart, but we’ve never been closer. — Kimberly Reyes', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/07/06/fashion/06TINYLOVE-illo2/06TINYLOVE-illo2-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/07/06/fashion/06TINYLOVE-illo2/06TINYLOVE-illo2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/07/06/fashion/06TINYLOVE-illo2/06TINYLOVE-illo2-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/07/06/fashion/06TINYLOVE-illo2/06TINYLOVE-illo2-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/07/06/fashion/06TINYLOVE-illo2/06TINYLOVE-illo2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/07/06/fashion/06TINYLOVE-illo2/06TINYLOVE-illo2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/07/06/fashion/06TINYLOVE-illo2/06TINYLOVE-illo2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Tiny Love Stories: ‘A Tipsy, Celebratory State of Bliss’', 'kicker': 'Modern Love', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Love (Emotion)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Modern Love (Times Column)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Dating and Relationships', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Quarantines', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Coronavirus (2019-nCoV)', 'rank': 5, 'major': 'N'}], 'pub_date': '2020-06-16T19:00:10+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Style', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8d80d737-5739-5980-b497-a39b35b25770', 'word_count': 497, 'uri': 'nyt://article/8d80d737-5739-5980-b497-a39b35b25770'}, {'abstract': 'Secretaries of state do more than count ballots and issue drivers’ licenses. They safeguard our democracy.', 'web_url': 'https://www.nytimes.com/2020/06/16/opinion/voting-rights-elections-secretary-of-state.html', 'snippet': 'Secretaries of state do more than count ballots and issue drivers’ licenses. They safeguard our democracy.', 'lead_paragraph': 'The big news from Georgia’s primary election last Tuesday wasn’t who won and who lost. It was the galling meltdown at polling places in black communities across the state. New voting machines were missing or didn’t work. Voters waited hours in line to cast their ballots. Some understandably gave up.', 'print_section': 'A', 'print_page': '25', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/16/opinion/16Kurz2/merlin_173379906_a73b0631-fd23-46cb-b9b2-23f35e631a6e-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/06/16/opinion/16Kurz2/merlin_173379906_a73b0631-fd23-46cb-b9b2-23f35e631a6e-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'ur