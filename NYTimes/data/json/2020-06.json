rge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'All I Have to Offer You Is Me', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Callies, Larry', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cowboys and Cowgirls', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Blacks', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Country Music', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'MCA Records', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Houston (Tex)', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Nashville (Tenn)', 'rank': 8, 'major': 'N'}], 'pub_date': '2020-06-16T19:09:15+0000', 'document_type': 'multimedia', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Dillon Hayes', 'person': [{'firstname': 'Dillon', 'middlename': None, 'lastname': 'Hayes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/7e170875-ab05-5cce-8e2c-f2777efa6d6e', 'word_count': 0, 'uri': 'nyt://video/7e170875-ab05-5cce-8e2c-f2777efa6d6e'}, {'abstract': 'Larry Callies comes from a long line of black Americans living and working on the frontier.', 'web_url': 'https://www.nytimes.com/2020/06/16/opinion/all-i-have-to-offer-you-is-me-black-cowboys.html', 'snippet': 'Larry Callies comes from a long line of black Americans living and working on the frontier.', 'lead_paragraph': 'Cowboys are among the most iconic figures of the American West. They’re mythologized as strong, independent people who live and die by their own terms on the frontier. And in movies, the people who play them are mostly white. But as with many elements of Americana, the idea of who cowboys are is actually whitewashed — scholars estimate that in the pioneer era, one in four cowboys were black. The historian Quintard Taylor writes about how before then, enslaved people “were part of the expansion of the livestock industry into colonial South Carolina, passing their herding skills down through the generations and steadily across the Gulf Coast states to Texas.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Black Cowboy Confronts the Whitewashed History of the West', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cowboys and Cowgirls', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Callies, Larry', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Country Music', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Blacks', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Houston (Tex)', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Texas', 'rank': 7, 'major': 'N'}], 'pub_date': '2020-06-16T19:09:45+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Dillon Hayes', 'person': [{'firstname': 'Dillon', 'middlename': None, 'lastname': 'Hayes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/315b77c7-bf5e-5a87-aabe-839b7ca1efa8', 'word_count': 296, 'uri': 'nyt://article/315b77c7-bf5e-5a87-aabe-839b7ca1efa8'}, {'abstract': 'The Norwegian bassist’s group, Overseas, is releasing a live album featuring a decade’s worth of his immersive compositions.', 'web_url': 'https://www.nytimes.com/2020/06/16/arts/music/eivind-opsvik-overseas.html', 'snippet': 'The Norwegian bassist’s group, Overseas, is releasing a live album featuring a decade’s worth of his immersi