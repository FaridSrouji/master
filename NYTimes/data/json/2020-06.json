eo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Bowman, Jamaal', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Engel, Eliot L', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Elections, House of Representatives', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Primaries and Caucuses', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Party', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Bronx (NYC)', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Westchester County (NY)', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'New York State', 'rank': 8, 'major': 'N'}], 'pub_date': '2020-06-17T09:00:16+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Jesse McKinley', 'person': [{'firstname': 'Jesse', 'middlename': None, 'lastname': 'McKinley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d8316b58-50e1-5659-89c8-59169eee38e5', 'word_count': 1422, 'uri': 'nyt://article/d8316b58-50e1-5659-89c8-59169eee38e5'}, {'abstract': 'Using emergency relief at the court, the administration has imposed controversial policies without a final determination of their legality.', 'web_url': 'https://www.nytimes.com/2020/06/17/opinion/supreme-courts-trump-relief.html', 'snippet': 'Using emergency relief at the court, the administration has imposed controversial policies without a final determination of their legality.', 'lead_paragraph': 'In the coming weeks, the Supreme Court is expected to clear its docket of current term cases, with potential major decisions on DACA, abortion, President Trump’s financial records and public funding for religious schools. Like Monday’s ruling on L.G.B.T. discrimination, it’s a safe bet that they will generate outsize attention — and that the decisions will be deeply controversial in some quarters.', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/17/opinion/17Vladeck/merlin_156586044_cb0823c2-3f4b-4eb2-8b79-18d505a603c9-articleLarge.jpg', 'height': 450, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/06/17/opinion/17Vladeck/merlin_156586044_cb0823c2-3f4b-4eb2-8b79-18d505a603c9-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 450}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/17/opinion/17Vladeck/merlin_156586044_cb0823c2-3f4b-4eb2-8b79-18d505a603c9-jumbo.jpg', 'height': 768, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/17/opinion/17Vladeck/merlin_156586044_cb0823c2-3f4b-4eb2-8b79-18d505a603c9-superJumbo.jpg', 'height': 1536, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/17/opinion/17Vladeck/merlin_156586044_cb0823c2-3f4b-4eb2-8b79-18d505a603c9-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/06/17/opinion/17Vladeck/merlin_156586044_cb0823c2-3f4b-4eb2-8b79-18d505a603c9-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/17/opinion/17Vladeck/merlin_156586044_cb0823c2-3f4b-4eb2-8b79-18d505a603c9-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How the Supreme Court Is Quietly Enabling Trump', 'kicker': None, 'conten