middlename': None, 'lastname': 'Shannon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Hiroko', 'middlename': None, 'lastname': 'Masuike', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'briefing', '_id': 'nyt://article/43f4ce04-4e3f-5b0d-8257-e3f4d5e33e5e', 'word_count': 1116, 'uri': 'nyt://article/43f4ce04-4e3f-5b0d-8257-e3f4d5e33e5e'}, {'abstract': 'The police commissioner said the timing had nothing to do with the prosecutors’ decisions to drop charges against certain protesters, but it seemed to reflect a growing divide.', 'web_url': 'https://www.nytimes.com/2020/06/15/nyregion/nypd-district-attorneys-protests.html', 'snippet': 'The police commissioner said the timing had nothing to do with the prosecutors’ decisions to drop charges against certain protesters, but it seemed to reflect a growing divide.', 'lead_paragraph': 'A few hours after the Manhattan district attorney announced he would not prosecute some of the protesters who had been arrested during demonstrations against police brutality, the Police Department sent him a message: All the officers assigned to his office would be pulled off the job to help with crowd control.', 'print_section': 'A', 'print_page': '28', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/12/nyregion/00nyunrest-prosecutors-1/merlin_173179575_e51d89f7-abe3-44f1-82e7-9f996e0608c1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/06/12/nyregion/00nyunrest-prosecutors-1/merlin_173179575_e51d89f7-abe3-44f1-82e7-9f996e0608c1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/12/nyregion/00nyunrest-pro