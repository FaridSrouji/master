 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/30/obituaries/30Mandel-sub/30Mandel-sub-articleLarge.jpg', 'height': 476, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/06/30/obituaries/30Mandel-sub/30Mandel-sub-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 476}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/30/obituaries/30Mandel-sub/30Mandel-sub-jumbo.jpg', 'height': 812, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/30/obituaries/30Mandel-sub/30Mandel-sub-superJumbo.jpg', 'height': 1623, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/30/obituaries/30Mandel-sub/30Mandel-sub-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/06/30/obituaries/30Mandel-sub/30Mandel-sub-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/30/obituaries/30Mandel-sub/30Mandel-sub-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Johnny Mandel, 94, Writer of Memorable Movie Scores, Is Dead', 'kicker': None, 'content_kicker': None, 'print_headline': 'Johnny Mandel, Composer for ‘M*A*S*H’ and Other Films, Dies at 94', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Mandel, John A (1925-2020)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank'