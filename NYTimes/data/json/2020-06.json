n outdoors is beautiful but it sort of wants to kill you.', 'print_section': 'BR', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/20/books/review/20blackall-derby/20blackall-derby-articleLarge.jpg', 'height': 359, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/06/20/books/review/20blackall-derby/20blackall-derby-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 359}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/20/books/review/20blackall-derby/20blackall-derby-jumbo.jpg', 'height': 613, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/20/books/review/20blackall-derby/20blackall-derby-superJumbo.jpg', 'height': 1225, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/20/books/review/20blackall-derby/20blackall-derby-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/06/20/books/review/20blackall-derby/20blackall-derby-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/20/books/review/20blackall-derby/20blackall-derby-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘I’m Here,’ Outside Says. ‘I Miss You.’', 'kicker': 'Children’s Books', 'content_kicker': None, 'print_headline': 'Nature', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value'