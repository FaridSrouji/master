ltry', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Factory Farming', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Tyson Foods Inc', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Coronavirus (2019-nCoV)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Executive Orders and Memorandums', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Tyson, John H', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Virginia', 'rank': 10, 'major': 'N'}, {'name': 'subject', 'value': 'your-feed-opinionvideo', 'rank': 11, 'major': 'N'}], 'pub_date': '2020-06-15T09:00:10+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Jerald Brooks and Lakesha Bailey', 'person': [{'firstname': 'Jerald', 'middlename': None, 'lastname': 'Brooks', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Lakesha', 'middlename': None, 'lastname': 'Bailey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/c96641be-dde3-5fe7-92cb-64401eaeba72', 'word_count': 313, 'uri': 'nyt://article/c96641be-dde3-5fe7-92cb-64401eaeba72'}, {'abstract': 'The intensifying rift between the military and the president demands attention.', 'web_url': 'https://www.nytimes.com/2020/06/15/opinion/trump-military.html', 'snippet': 'The intensifying rift between the military and the president demands attention.', 'lead_paragraph': 'The first time I saw President Trump referred to as “Cadet Bone Spurs” I laughed, the second time I smiled and the third time I cringed. It’s an apt slur, but it lumps him together with all the other politicians whose military huzzahs contradict their personal histories and whose insult to our men and women in uniform can be reduced to dodging the draft.', 'sourc