34d12', 'word_count': 836, 'uri': 'nyt://article/5278743d-4f4c-5b25-92d3-183db0234d12'}, {'abstract': 'Quotation of the Day for Friday, June 26, 2020.', 'web_url': 'https://www.nytimes.com/2020/06/25/todayspaper/quotation-of-the-day-as-fireworks-light-up-city-skeptics-seek-true-meaning.html', 'snippet': 'Quotation of the Day for Friday, June 26, 2020.', 'lead_paragraph': '“The past few weeks it’s been like the day before the 4th of July every day. We can’t keep our shelves stocked.”', 'print_section': 'A', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Quotation of the Day: As Fireworks Light Up City, Skeptics Seek ‘True’ Meaning', 'kicker': None, 'content_kicker': None, 'print_headline': 'Quote of the Day', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2020-06-26T02:55:53+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Today’s Paper', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Quote', '_id': 'nyt://article/b52b52ea-9001-53c7-ba82-6a7bcafdb4a1', 'word_count': 52, 'uri': 'nyt://article/b52b52ea-9001-53c7-ba82-6a7bcafdb4a1'}, {'abstract': 'Corrections that appeared in print on Friday, June 26, 2020.', 'web_url': 'https://www.nytimes.com/2020/06/25/pageoneplus/corrections-june-26-2020.html', 'snippet': 'Corrections that appeared in print on Friday, June 26, 2020.', 'lead_paragraph': 'An article on Thursday about the indictment of the President Hashim Thaci of Kosovo for war crimes committed during Kosovo’s battle for independence from Serbia misstated the year that the Kosovar Parliament founded a special judicial system to investigate possible war crimes carried out by guerrilla groups. It was 2015, not 2016.', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Corrections: June 26, 2020', 'kicker': None, 'content_kicker': None, 'print_headline': 'Corrections', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2020-06-26T02:56:17+0000', 'document_type': 'article', 'news_desk': 'Corrections', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Correction', '_id': 'nyt://article/9ff1141d-7300-5f3c-b67d-e2551c904d18', 'word_count': 149, 'uri': 'nyt://article/9ff1141d-7300-5f3c-b67d-e2551c904d18'}, {'abstract': 'With his camera and red arm band, he captured the dark side of Mao’s revolution at great personal risk. Many of the images were stashed under a floor, going undeveloped for years.', 'web_url': 'https://www.nytimes.com/2020/06/25/world/asia/li-zhensheng-dead.html', 'snippet': 'With his camera and red arm band, he captured the dark side of Mao’s revolution at great personal risk. Many of the images were stashed under a floor, going undeveloped for years.', 'lead_paragraph': 'Li Zhensheng, a photographer who at great personal risk documented the dark side of Mao Zedong’s Cultural Revolution, producing powerful black-and-white images that remain a rare visual testament to the brutality of that tumultuous period, many of them not developed or seen for years, has died. He was 79. ', 'print_section': 'B', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/28/obituaries/28Li-obit12/25Li-obit12-articleLarge.jpg', 'height': 593, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/06/28/obituaries/28Li-obit12/25Li-obit12-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 593}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/28/obituaries/28Li-obit12/25Li-obit12-jumbo.jpg', 'height': 1013, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 't