 editors on the team felt was not well enough understood.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/22/us/politics/22insider/merlin_173710080_545743b3-8c62-4de4-83bf-22a342b7a8aa-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/06/22/us/politics/22insider/merlin_173710080_545743b3-8c62-4de4-83bf-22a342b7a8aa-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/22/us/politics/22insider/merlin_173710080_545743b3-8c62-4de4-83bf-22a342b7a8aa-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/22/us/politics/22insider/merlin_173710080_545743b3-8c62-4de4-83bf-22a342b7a8aa-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/22/us/politics/22insider/merlin_173710080_545743b3-8c62-4de4-83bf-22a342b7a8aa-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/06/22/us/politics/22insider/merlin_173710080_545743b3-8c62-4de4-83bf-22a342b7a8aa-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/22/us/politics/22insider/merlin_173710080_545743b3-8c62-4de4-83bf-22a342b7a8aa-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Joy, Pain and Juneteenth', 'kicker': 'The Dai