ayed by the character’s choice.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/13/arts/12delroy-lindo3-copy/12delroy-lindo3-copy-articleLarge-v4.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/06/13/arts/12delroy-lindo3-copy/12delroy-lindo3-copy-articleLarge-v4.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/13/arts/12delroy-lindo3-copy/12delroy-lindo3-copy-jumbo-v4.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/13/arts/12delroy-lindo3-copy/12delroy-lindo3-copy-superJumbo-v4.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/13/arts/12delroy-lindo3-copy/12delroy-lindo3-copy-thumbStandard-v5.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/06/13/arts/12delroy-lindo3-copy/12delroy-lindo3-copy-thumbStandard-v5.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/13/arts/12delroy-lindo3-copy/12delroy-lindo3-copy-thumbLarge-v5.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Delroy Lindo on ‘Da 5 Bloods’ and Playing a Trump Supporter', 'kicker': None, 'content_kicker': None, 'print_headline': 'He Just Plays a Trumpite on Film', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'