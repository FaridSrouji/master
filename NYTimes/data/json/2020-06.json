future.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/07/02/arts/30moving-watching-4/merlin_174042102_691e3fcc-6e57-439c-b6a2-0236e47e66b6-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/07/02/arts/30moving-watching-4/merlin_174042102_691e3fcc-6e57-439c-b6a2-0236e47e66b6-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/07/02/arts/30moving-watching-4/merlin_174042102_691e3fcc-6e57-439c-b6a2-0236e47e66b6-jumbo.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/07/02/arts/30moving-watching-4/merlin_174042102_691e3fcc-6e57-439c-b6a2-0236e47e66b6-superJumbo.jpg', 'height': 1152, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/07/02/arts/30moving-watching-4/30moving-watching-4-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/07/02/arts/30moving-watching-4/30moving-watching-4-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/07/02/arts/30moving-watching-4/30moving-watching-4-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Before the World Shut Down, a ‘Rite of Spring’ on a Senegal Beach', 'kicker': 'Watching and Moving', 'content_kicker': None, 'print_hea