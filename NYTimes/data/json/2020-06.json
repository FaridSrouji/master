e': 'glocations', 'value': 'China', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Canada', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Political Prisoners', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Spavor, Michael', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Kovrig, Michael', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'International Relations', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Huawei Technologies Co Ltd', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Meng Wanzhou', 'rank': 8, 'major': 'N'}], 'pub_date': '2020-06-19T04:58:49+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Javier C. Hernández and Catherine Porter', 'person': [{'firstname': 'Javier', 'middlename': 'C.', 'lastname': 'Hernández', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Catherine', 'middlename': None, 'lastname': 'Porter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a72497cc-a650-595a-bffd-0c5c11ceb17f', 'word_count': 1158, 'uri': 'nyt://article/a72497cc-a650-595a-bffd-0c5c11ceb17f'}, {'abstract': 'A recording of Leontyne Price singing Verdi is streaming on the Met Opera’s site. And the one-woman show with Holland Taylor as Ann Richards airs on PBS.', 'web_url': 'https://www.nytimes.com/2020/06/19/arts/television/whats-on-tv-friday-la-forza-del-destino-and-ann.html', 'snippet': 'A recording of Leontyne Price singing Verdi is streaming on the Met Opera’s site. And the one-woman show with Holland Taylor as Ann Richards airs on PBS.', 'lead_paragraph': 'LA FORZA DEL DESTINO Stream on Metopera.org. The venerable soprano Leontyne Price stars in this 1984 Metropolitan Opera production of Verdi’s “La Forza del Destino,” a somber tragedy set in 18th-century Spain and Italy. This production is near the end of Price’s Met career — she retired from opera the following year — and in a review for The New York Times, Will Crutchfield wrote that her “low notes have lost focus, the high ones strength and vibrancy.” But, he added, “In between she has preserved to an extraordinary degree the core of beauty that made her unique. With a broad lyrical line she can still bring tears to the eyes.”', 'print_section': 'C', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/19/arts/19tvcol-laforza/19tvcol-laforza-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/06/19/arts/19tvcol-laforza/19tvcol-laforza-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/19/arts/19tvcol-laforza/19tvcol-laforza-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/19/arts/19tvcol-laforza/19tvcol-laforza-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/19/arts/19tvcol-laforza/19tvcol-laforza-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/06/19/arts/19tvcol-laforza/19tvcol-laforza-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/06/19/arts/19tvcol-laforza/19tvcol-laforza-thumbLarge.jpg', 'h