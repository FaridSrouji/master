organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/c5d1cec0-a7de-5652-aa63-0a4d51c6ff23', 'word_count': 462, 'uri': 'nyt://article/c5d1cec0-a7de-5652-aa63-0a4d51c6ff23'}, {'abstract': 'Nondairy ice cream and hot meals share space in Scoops, shop that conforms to the dietary traditions of Rastafarians.', 'web_url': 'https://cityroom.blogs.nytimes.com/2011/05/12/neighborhood-joint-scoops/', 'snippet': 'Nondairy ice cream and hot meals share space in Scoops, shop that conforms to the dietary traditions of Rastafarians.', 'lead_paragraph': 'A young man stepped in from a wet and howling Friday afternoon, letting the door swing shut behind him. In the shop, the air was thick with incense and spice. A European soccer match on a small television set competed with the reggae playing on the stereo and the crackle of mock salmon steaks frying on the stove.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'At Scoops in Brooklyn, Ital Food (Even Ice Cream)', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Health Foods', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Rastafarianism', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Vegan', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Prospect Lefferts Gardens (NYC)', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-05-12T23:47:35+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Freda Moon', 'person': [{'firstname': 'Freda', 'middlename': None, 'lastname': 'Moon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/84d0c328-551e-56ca-bd2b-d81fdd8be3fb', 'word_count': 134, 'uri': 'nyt://article/84d0c328-551e-56ca-bd2b-d81fdd8be3fb'}, {'abstract': 'Doubt was cast on a rationale given by Officer Kenneth Moreno as to why he did not call an ambulance for a drunken woman whom he is accused of raping.', 'web_url': 'https://www.nytimes.com/2011/05/13/nyregion/paramedic-challenges-officers-story-in-rape-case.html', 'snippet': 'Doubt was cast on a rationale given by Officer Kenneth Moreno as to why he did not call an ambulance for a drunken woman whom he is accused of raping.', 'lead_paragraph': 'Testimony in the rape trial of two police officers ended on Thursday with a paramedic contesting one officer’s emotional account of his futile effort to save a man’s life.', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Paramedic Challenges Officer’s Story in Rape Case', 'kicker': None, 'content_kicker': None, 'print_headline': 'Paramedic Challenges Officer’s Story In Rape Case', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Moreno, Kenneth', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Police Department (NYC)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Sex Crimes', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Mata, Franklin L', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-05-12T23:47:51+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By John Eligon', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Eligon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c749cf16-1db9-5528-b12b-deda3a6beb4b', 'word_count': 578, 'uri': 'nyt://article/c749cf16-1db9-5528-b12b-deda3a6beb4b'}, {'abstract': 'Claudio Caponigro’s hole-in-the-wall barbershop on East 116th Street, an unchanging mainstay in a gentrifying neighborhood, is threatened by a rent increase.', 'web_url': 'https://www.nytimes.com/2011/05/13/nyregion/east-harlem-rent-tripling-barber-may-have-to-close-shop-after-60-years.html', 'snippet': 'Claudio Caponigro’s hole-in-the-wall barbershop on East 116th Street, an unchanging mainstay in a gentrifying neighborhood, is threatened by a rent increase.', 'lead_paragraph': 'For 60 years, Claudio Caponigro’s hole-in-the-wall barbershop on East 116th Street has been an East Harlem landmark, with generations of men taking turns in one of the shop’s three ancient peppermint-color chairs, receiving his tender ministrations among leather strops and bottles of Jeris hair tonic.', 'print_section': 'A', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/13/nyregion/13barber_337_span/BARBER1-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/13/nyregion/13barber_337_span/BARBER1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/13/nyregion/13barber_337_span/BARBER1-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/13/nyregion/13barber_337_span/BARBER1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/13/nyregion/13barber_337_span/BARBER1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Constant in a Changing Neighborhood Is Endangered', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Constant in a Changing Neighborhood Is Endangered', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'East Harlem (NYC)', 'rank': 1, 'major': 'N'}, {'name': 'subject',