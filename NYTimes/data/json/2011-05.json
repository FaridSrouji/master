, {'abstract': 'Mr. Wilson, a pivotal player in the Off Off Broadway movement, got his start at Caffe Cino in Greenwich Village.', 'web_url': 'https://www.nytimes.com/2011/05/16/arts/doric-wilson-72-playwright-in-gay-theater-dies.html', 'snippet': 'Mr. Wilson, a pivotal player in the Off Off Broadway movement, got his start at Caffe Cino in Greenwich Village.', 'lead_paragraph': 'Doric Wilson, a playwright whose satirical, wisecracking works are considered bricks in the foundations of the Off Off Broadway and gay theater movements, died May 7 at his home in Manhattan. He was 72.', 'print_section': 'B', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/16/arts/wilson-obit/wilson-obit-jumbo.jpg', 'height': 496, 'width': 416, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/16/arts/wilson-obit/wilson-obit-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/16/arts/wilson-obit/wilson-obit-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Doric Wilson, Playwright and Mainstay of Gay Theater, Dies at 72', 'kicker': None, 'content_kicker': None, 'print_headline': 'Doric Wilson, 72, Playwright And Mainstay of Gay Theater', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Writing and Writers', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Greenwich Village (NYC)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Homosexuality', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-05-15T23:47:55+0000', 'document_type': 'article