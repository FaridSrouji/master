4, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/11/dining/11fcalspan/11fcalspan-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/11/dining/11fcalspan/11fcalspan-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Dining Calendar', 'kicker': None, 'content_kicker': None, 'print_headline': 'Calendar', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-05-10T22:25:26+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/84677b78-5d5e-52d2-9fe1-1546654c4de5', 'word_count': 1023, 'uri': 'nyt://article/84677b78-5d5e-52d2-9fe1-1546654c4de5'}, {'abstract': 'Once you get past the name and appearance, you will find that blood clams have a crisp succulence and a flavor that is not as briny as a littleneck or cherrystone clam.', 'web_url': 'https://www.nytimes.com/2011/05/11/dining/blood-clams-worth-a-second-look.html', 'snippet': 'Once you get past the name and appearance, you will find that blood clams have a crisp succulence and a flavor that is not as briny as a littleneck or cherrystone clam.', 'lead_paragraph': 'Once you get past the off-putting name and appearance, you will find that blood clams have a deliciously crisp succulence, like geoduck, and a flavor that is not as briny as a littleneck or cherrystone clam. The redness that gives these cockles their name is due to a high level of hemoglobin. They are about the size of a lime and have very hard shells, with black, hairy material covering part of the shell. ', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/11/dining/11clamsspan/11clamsspan-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/11/dining/11clamsspan/11clamsspan-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/11/dining/11clamsspan/11clamsspan-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/11/dining/11clamsspan/11clamsspan-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/11/dining/11clamsspan/11clamsspan-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Blood Clams: Worth a Second Look', 'kicker': 'Food Stuff', 'content_kicker': None, 'print_headline': 'Not Exactly Beauties, These Clams Have a Winning Taste', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Clams', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-05-10T22:25:27+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4daa68b2-0524-59fe-8ea7-6d1d56d4f8fc', 'word_count': 241, 'uri': 'nyt://article/4daa68b2-0524-59fe-8ea7-6d1d56d4f8fc'}, {'abstract': 'Made at a restaurant in Vermont, Gringo Jack’s flaky chips can now be ordered online.', 'web_url': 'https://www.nytimes.com/2011/05/11/dining/tortilla-chips-of-a-different-munchability.html', 'snippet': 'Made at a restaurant in Vermont, Gringo Jack’s flaky chips can now be ordered online.', 'lead_paragraph': 'A trip to Vermont is no longer the only way to obtain Gringo Jack’s tortilla chips, which are made at the restaurant by the same name in Manchester. These smallish flour chips can now be ordered online. Their munchability is driven by exceptional flakiness — a similar texture, if not taste, to that of the fried noodles offered in Chinese restaurants. The plain ones are fine; the whole-wheat version has deeper flavor; and the spiced ones, hand-dusted with a ruddy, vibrant mixture, suit creamy dips and make a nice garnish for ceviche, salads and soups. ', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/11/dining/11chips/11chips-jumbo.jpg', 'height': 1024, 'width': 712, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/11/dining/11chips/11chips-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/11/dining/11chips/11chips-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Tortilla Chips of a Different Munchability', 'kicker': 'Food Stuff', 'content_kicker': None, 'print_headline': 'Chips of a Different Munchability', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Snack Foods', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-05-10T22:25:27+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Flo