organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/07c00a47-b175-57d7-a9d5-9db5d8258b1e', 'word_count': 790, 'uri': 'nyt://article/07c00a47-b175-57d7-a9d5-9db5d8258b1e'}, {'abstract': 'Mr. Cornuelle’s book, “Reclaiming the American Dream,” promoted volunteerism to help solve social problems.', 'web_url': 'https://www.nytimes.com/2011/05/04/us/04cornuelle.html', 'snippet': 'Mr. Cornuelle’s book, “Reclaiming the American Dream,” promoted volunteerism to help solve social problems.', 'lead_paragraph': 'Richard Cornuelle, a libertarian writer whose best-known book, “Reclaiming the American Dream,” championed volunteerism as a means of addressing social problems like poverty, unemployment, delinquency and urban blight, died on April 26 at his home in Manhattan. He was 84.', 'print_section': 'B', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/04/nyregion/Cornuelle/Cornuelle-jumbo.jpg', 'height': 1024, 'width': 992, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/04/nyregion/Cornuelle/Cornuelle-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/04/nyregion/Cornuelle/Cornuelle-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Richard Cornuelle, Libertarian Author, Dies at 84', 'kicker': None, 'content_kicker': None, 'print_headline': 'Richard Cornuelle, Libertarian Author, 84', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Writing and Writers', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 3, 'major': 'N'