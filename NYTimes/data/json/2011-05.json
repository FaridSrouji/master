s/2011/05/16/arts/TRIBUTE/TRIBUTE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/16/arts/TRIBUTE/TRIBUTE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Her Folksy Parlor, Crowded With Family and Friends', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Her Folksy Parlor, Crowded With Family and Friends', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'McGarrigle, Kate', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-05-15T22:02:24+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Jon Pareles', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Pareles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/90a7e9ae-e8f0-57dc-86a9-033534518e37', 'word_count': 661, 'uri': 'nyt://article/90a7e9ae-e8f0-57dc-86a9-033534518e37'}, {'abstract': '“Freedom Riders” chronicles a crucial, devastating episode of the civil rights movement in May 1961.', 'web_url': 'https://www.nytimes.com/2011/05/16/arts/television/freedom-riders-civil-rights-documentary-review.html', 'snippet': '“Freedom Riders” chronicles a crucial, devastating episode of the civil rights movement in May 1961.', 'lead_paragraph': 'The filmmaker Stanley Nelson has a stunning accomplishment in “Freedom Riders,” a documentary that chronicles a crucial, devastating episode of the civil rights movement, an episode whose gruesome visuals impinged on the perception of American liberty around the world. Commemorating the 50th anniversary of the freedom rides, the film (to be shown Monday on PBS) is a story of ennobled youth and noxious hatred, of decided courage and inexplicable brutality. In May 1961 the Congress of Racial Equality sought to challenge the segregation of interstate travel on public transport and sent forth activists, both black and white, and many of them students, on a bus journey through the South, where they were received with violence that law enforcers refused to tame.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/16/arts/FREEDOM/FREEDOM-jumbo.jpg', 'height': 719, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/16/arts/FREEDOM/FREEDOM-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/16/arts/FREEDOM/FREEDOM-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Voices From the Buses on the Road to Civil Rights', 'kicker': 'Television Review', 'content_kicker': None, 'print_headline': 'Voices From the Buses on the Road to Civil Rights', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Segregation', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Civil Rights and Liberties', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Race and Ethnicity', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Public Broadcasting Service', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Documentary Films and Programs', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-05-15T22:04:57+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Ginia Bellafante', 'person': [{'firstname': 'Ginia', 'middlename': None, 'lastname': 'Bellafante', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/a556cdc4-5ca2-5eb7-886d-3d1c15443903', 'word_count': 738, 'uri': 'nyt://article/a556cdc4-5ca2-5eb7-886d-3d1c15443903'}, {'abstract': 'Donald Glover, of the NBC sitcom “Community,” gave a performance that was part comedy, mostly music at a sold-out Music Hall of Williamsburg on Saturday night.', 'web_url': 'https://www.nytimes.com/2011/05/16/arts/music/donald-glover-at-music-hall-of-williamsburg-review.html', 'snippet': 'Donald Glover, of the NBC sitcom “Community,” gave a performance that was part comedy, mostly music at a sold-out Music Hall of Williamsburg on Saturday night.', 'lead_paragraph': 'Donald Glover was part of a comedy troupe that became famous for making viral videos, which earned him a job as a sitcom writer, which he abandoned before landing a spot as a sitcom star, which he’s now leveraged into a side career in music.', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/16/arts/GLOVER/GLOVER-articleLarge.jpg', 'height': 351, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/16/arts/GLOVER/GLOVER-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 351}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/16/arts/GLOVER/GLOVER-jumbo.jpg', 'height': 792, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/16/arts/GLOVER/GLOVER-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/16/arts/GLOVER/GLOVER-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Comedian Who Raps, or Rapper?', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Comedian Who Raps, Or Rapper?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Glover, Donald', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Rap and Hip-Hop', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-05-15T22:06:46+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Jon Caramanica', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Caramanica', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/be6c954c-dae8-59b5-b123-5f77264ed30a', 'word_count': 538, 'uri': 'nyt://article/be6c954c-dae8-59b5-b123-5f77264ed30a'}, {'abstract': 'Annie Jacobsen’s exhaustively researched book asserts that its title subject was a cold war site, not a home to little green men.', 'web_url': 'https://www.nytimes.com/2011/05/16/books/area-51-by-annie-jacobsen-review.html', 'snippet': 'Annie Jacobsen’s exhaustively researched book asserts that its title subject was a cold war site, not a home to little green men.', 'lead_paragraph': 'At the start of “Area 51,” Annie Jacobsen’s cauldron-stirring book about America’s most mysterious military installation, Ms. Jacobsen offers a passing glimpse of a large-headed little gray space alien being interrogated by scientists in white coats. This is both a tease and a distraction. Yes, Ms. Jacobsen will eventually address the U.F.O. issue with which conspiracy theorists eagerly associate Area 51, but her book is not science fiction. It’s much more levelheaded. It is an assertive account, revelatory but also mystifying, of the long-hidden United States weaponry and espionage programs to which she says Area 51 is home. (Some say Area 51 is home to nothing, because it does not officially exist.)', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/16/arts/JPBOOK/JPBOOK-jumbo.jpg', 'height': 1024, 'width': 815, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/16/arts/JPBOOK/JPBOOK-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/16/arts/JPBOOK/JPBOOK-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Military Post’s Secrets: Espionage, Not Aliens', 'kicker': 'Books of The Times', 'content_kicker': None, 'print_headline': 'A Military Post’s Secrets: Espionage, Not Aliens', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Unidentified Flying Objects (UFO)', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-05-15T22:11:48+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By Janet Maslin', 'person': [{'firstname': 'Janet', 'middlename': None, 'lastname': 'Maslin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/c05ce527-2a87-550d-a369-1d8169ed9031', 'word_count': 1179, 'uri': 'nyt://article/c05ce527-2a87-550d-a369-1d8169ed9031'}, {'abstract': 'An extreme reaction to a business can elicit a review, but more people in general use the “Like” button because it is a short-form action.', 'web_url': 'https://www.nytimes.com/2011/05/16/business/media/16drill.html', 'snippet': 'An extreme reaction to a business can elicit a review, but more people in general use the “Like” button because it is a short-form action.', 'lead_paragraph': 'The online review, long the default means on the Internet to express support for a local business, has been eclipsed by Facebook’s one-click “Like” button.', 'print_section': 'B', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Web Critics Sum It All Up in a Word', 'kicker': 'Drilling Down', 'content_kicker': None, 'print_headline': 'Web Critics Sum It All Up in a Word', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Facebook.com', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Social Networking (Internet)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-05-15T22:26:26+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Teddy Wayne', 'person': [{'firstname': 'Teddy', 'middlename': None, 'lastname': 'Wayne', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e50dcdb2-5029-5f2b-a23b-00fa45739ddd', 'word_count': 206, 'uri': 'nyt://article/e50dcdb2-5029-5f2b-a23b-00fa45739ddd'}, {'abstract': 'New leaders for the Baryshnikov Arts Center and Hartford Stage.', 'web_url': 'https://www.nytimes.com/2011/05/16/arts/footnotes.html', 'snippet': 'New leaders for the Baryshnikov Arts Center and Hartford Stage.', 'lead_paragraph': 'Georgiana Pickett has been named the new executive director of the Baryshnikov Arts Center, the center has announced. Ms. Pickett has been the executive director of 651 ARTS at the Brooklyn Academy of Music since 2004. She replaces Stanford Makishi, a former dancer, who resigned in February. ... The director Darko Tresnjak (“The Merchant of Venice”) will take over as artistic director of the Hartford Stage theater company in Connecticut in July, Playbill.com reported. He will succeed Michael Wilson, who has served for the past 13 years and is to retire in June.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Footnotes', 'kicker': 'Arts, Briefly', 'content_kicker': None, 'print_headline': 'Footnotes', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Baryshnikov Arts Center', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Hartford Stage Co', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-05-15T22:33:30+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'Compiled by Rachel Lee Harris', 'person': [{'firstname': 'Rachel', 'middlename': 'Lee', 'lastname': 'Harris', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/1fb63b28-af55-584b-a943-a2ae26e78b1a', 'word_count': 97, 'uri': 'nyt://article/1fb63b28-af55-584b-a943-a2ae26e78b1a'}, {'abstract': 'The New Victory Theater will open its new season on Oct. 1 with a show starring new creations from an “Avenue Q” puppet maker.', 'web_url': 'https://www.nytimes.com/2011/05/16/theater/new-victory-to-open-with-the-little-prince.html', 'snippet': 'The New Victory Theater will open its new season on Oct. 1 with a show starring new creations from an “Avenue Q” puppet maker.', 'lead_paragraph': 'The New Victory Theater will open its new season on Oct. 1 with a show starring new creations from an “Avenue Q” puppet maker. The show, “The Little Prince,” an adaptation of the French fable by Antoine de Saint-Exupéry, written by Rick Cummins and John Scoullar, will feature life-size puppets designed by Michael Schupbach, an alumnus of the Jim Henson Muppet Workshop. The season continues Oct. 13 with the United States premiere of “White,” a contemporary work from the Catherine Wheels Theater Company, of Scotland, that was a 2010 Edinburgh Festival Fringe award-winner last year; and the Reduced Shakespeare Company’s “Complete World of Sports (abridged),” beginning on Oct. 21. Other highlights will include “Untapped!,” a dance and rock review from Australia (Nov. 11), and “Bai Xi,” a circus show from Shanghai (Dec. 2).', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'New Victory to Open With ‘The Little Prince’', 'kicker': 'Arts, Briefly', 'content_kicker': None, 'print_headline': 'New Victory to Open With ‘The Little Prince’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'New Victory Theater', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-05-15T22:34:51+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Theater', 'byline': {'original': 'Compiled by Rachel Lee Harris', 'person': [{'firstname': 'Rachel', 'middlename': 'Lee', 'lastname': 'Harris', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/813f733e-1fe9-584b-89c8-f7618f50ae48', 'word_count': 138, 'uri': 'nyt://article/813f733e-1fe9-584b-89c8-f7618f50ae48'}, {'abstract': 'Kevin Durant scored 39 points as Oklahoma City advanced to the Western Conference finals, where it will play Dallas starting Tuesday.', 'web_url': 'https://www.nytimes.com/2011/05/16/sports/basketball/nba-playoffs-thunder-ruins-grizzlies-upset-hopes.html', 'snippet': 'Kevin Durant scored 39 points as Oklahoma City advanced to the Western Conference finals, where it will play Dallas starting Tuesday.', 'lea