arden/12shows/Currents-1-jumbo.jpg', 'height': 1024, 'width': 1017, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/12/garden/12shows/Currents-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/12/garden/12shows/Currents-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Tender Is the Nightstand', 'kicker': 'Currents | Shows', 'content_kicker': None, 'print_headline': 'Tender Is the Nightstand', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Design', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-05-11T23:31:52+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Rima Suqi', 'person': [{'firstname': 'Rima', 'middlename': None, 'lastname': 'Suqi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0cbbc947-b50e-507e-877a-65f9cfb6f9f0', 'word_count': 158, 'uri': 'nyt://article/0cbbc947-b50e-507e-877a-65f9cfb6f9f0'}, {'abstract': 'The 78-year-old German designer, in town to celebrate the 50th birthday of his 606 Universal Shelving System, on design, his Japanese garden and his new foundation.', 'web_url': 'https://www.nytimes.com/2011/05/12/garden/qa-dieter-rams-designer-of-stereos-shavers-and-shelves.html', 'snippet': 'The 78-year-old German designer, in town to celebrate the 50th birthday of his 606 Universal Shelving System, on design, his Japanese garden and his new foundation.', 'lead_paragraph': 'Dieter Rams is considered by many to be a design legend. The 78-year-old German designer is probably best known for the work he did as the design director at Braun (a job he held from 1961 until 1997), where he was responsible for some of the best-looking and -sounding stereo components ever made, along with a host of other products like shavers and kitchen appliances. He has inspired a number of other designers, including Jasper Morrison, Naoto Fukasawa and Jonathan Ive, the senior vice president for industrial design at Apple, who wrote the foreword to “As Little Design as Possible: The Work of Dieter Rams,” by Sophie Lovell, out next month from Phaidon Press.', 'print_section': 'D', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/12/garden/QA-1/QA-1-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/12/garden/QA-1/QA-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/12/garden/QA-1/QA-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Dieter Rams, Designer of Stereos, Shavers and Shelves', 'kicker': 'Currents | Q&A', 'content_kicker': None, 'print_headline': 'A Man Who Made Stereos, Shavers and Shelves Beautiful', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Rams, Dieter', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Design', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-05-11T23:31:52+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Rima Suqi', 'person': [{'firstname': 'Rima', 'middlename': None, 'lastname': 'Suqi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Question', '_id': 'nyt://article/212580d8-931e-5c88-b947-b7c75f1b76e7', 'word_count': 1102, 'uri': 'nyt://article/212580d8-931e-5c88-b947-b7c75f1b76e7'}, {'abstract': 'A writer’s husband yearns for life beyond the hospital, and upon returning home finds solace in the familiar.', 'web_url': 'https://www.nytimes.com/2011/05/12/garden/diane-ackerman-after-a-stroke-relearning-home.html', 'snippet': 'A writer’s husband yearns for life beyond the hospital, and upon returning home finds solace in the familiar.', 'lead_paragraph': 'AFTER his stroke several years ago, my husband, Paul West, lived in the hospital rehabilitation unit for weeks, relearning the everyday feats we take for granted. How to swallow food, sit in a chair, steer a spoon, comb his hair. By far the toughest to relearn was language. To his shock and horror, he — a novelist — no longer knew how to speak, read, write or understand anything anyone said. Arduous work with physical therapists brought back some balance and dexterity. Then a few words returned to Paul helter-skelter, including one, usually slurred, that he sometimes uttered as a plea and often as a demand: “Home!” ', 'print_section': 'D', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/12/garden/Domestic/Domestic-jumbo.jpg', 'height': 1024, 'width': 687, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/12/garden/Domestic/Domestic-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/12/garden/Domestic/Domestic-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'After a Stroke, Relearning Home', 'kicker': 'Domestic Lives', 'content_kicker': None, 'print_headline': 'After a Stroke, Relearning Home', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Writing and Writers', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Stroke', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Therapy and Rehabilitation', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-05-11T23:31:52+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Diane Ackerman', 'person': [{'firstname': 'Diane', 'middlename': None, 'lastname': 'Ackerman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6bb150e9-baa2-5643-b102-e692866c8968', 'word_count': 1368, 'uri': 'nyt://article/6bb150e9-baa2-5643-b102-e692866c8968'}, {'abstract': 'A new site, reCrib.com, recycles well-designed cribs, strollers and toys.', 'web_url': 'https://www.nytimes.com/2011/05/12/garden/a-site-for-secondhand-baby-and-kids-gear.html', 'snippet': 'A new site, reCrib.com, recycles well-designed cribs, strollers and toys.', 'lead_paragraph': '“Baby and kids’ gear now is fantastic: it’s beautiful, modern and well designed,” said Michelle Lehmann, a mother of two, ages 5 and 3. “It’s also really expensive.” That’s why she and her husband, Daniel, started reCrib, an online market for gently used furniture and toys for children.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/12/garden/12online/Currents-6-jumbo.jpg', 'height': 750, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/12/garden/12online/Currents-6-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/12/garden/12online/Currents-6-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Site for Secondhand Baby and Kids’ Gear', 'kicker': 'Currents | Online', 'content_kicker': None, 'print_headline': 'Second (Loving) Hands', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baby Carriages, Strollers and Carriers', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Children and Youth', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Furniture', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-05-11T23:31:54+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Tim McKeough', 'person': [{'firstname': 'Tim', 'middlename': None, 'lastname': 'McKeough', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/06cd42b7-e97f-5a22-a157-21ea758cb325', 'word_count': 171, 'uri': 'nyt://article/06cd42b7-e97f-5a22-a157-21ea758cb325'}, {'abstract': 'The first piece of advice offered by tiling experts? Start small.', 'web_url': 'https://www.nytimes.com/2011/05/12/garden/learning-to-tile-and-taking-it-slow-the-pragmatist.html', 'snippet': 'The first piece of advice offered by tiling experts? Start small.', 'lead_paragraph': 'MY Italian forbears might be pleased that their descendants could make a living without a set of masonry tools, but I’ve long considered it a mark of shame that I never learned how to handle a trowel.', 'print_section': 'D', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/12/garden/Pragmatist-cover/Pragmatist-cover-jumbo.jpg', 'height': 1023, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/12/garden/Pragmatist-cover/Pragmatist-cover-thumbStandard.jpg', 'height': 75, 'width'