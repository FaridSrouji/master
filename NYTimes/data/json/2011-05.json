lways claimed.', 'print_section': 'A', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Chile Military File Suggests Allende May Not Have Killed Himself', 'kicker': 'World Briefing | The Americas', 'content_kicker': None, 'print_headline': 'Chile: Further Inquiry on Ex-President’s Death', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Chile', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Allende, Salvador', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-05-31T17:41:53+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Americas', 'byline': {'original': 'By Pascale Bonnefoy', 'person': [{'firstname': 'Pascale', 'middlename': None, 'lastname': 'Bonnefoy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0b98b744-3409-508c-a602-667d07021110', 'word_count': 262, 'uri': 'nyt://article/0b98b744-3409-508c-a602-667d07021110'}, {'abstract': 'Marion Bartoli defeated Svetlana Kuznetsova, 7-6 (4), 6-4, to advance to the semifinals of the French Open.', 'web_url': 'https://straightsets.blogs.nytimes.com/2011/05/31/bartoli-bounds-past-kuznetsova-into-semifinals/', 'snippet': 'Marion Bartoli defeated Svetlana Kuznetsova, 7-6 (4), 6-4, to advance to the semifinals of the French Open.', 'lead_paragraph': 'PARIS — Marion Bartoli of France likes to bounce up and down as she stands at the baseline preparing to serve. There was extra bounce in the 23rd minute of her quarterfinal match Tuesday at the French Open.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Bartoli Bounds Past Kuznetsova Into Semifinals', 'kicker': 'Straight Sets', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'French Open (Tennis)', 'rank': 1, 'major': 'N'}, {'