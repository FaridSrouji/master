idth': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/31/sports/basketball/31rhodenpix/31rhodenpix-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Rollins, Fearless Forecaster, Makes Call on N.B.A. Finals, Too', 'kicker': 'Sports of The Times', 'content_kicker': None, 'print_headline': 'Rollins, Fearless Forecaster, Makes Call on N.B.A. Finals, Too', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Kidd, Jason', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Philadelphia Phillies', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Nowitzki, Dirk', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Basketball', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Dallas Mavericks', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Rollins, Jimmy', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Miami Heat', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Baseball', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'National Basketball Assn', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'James, LeBron', 'rank': 10, 'major': 'N'}], 'pub_date': '2011-05-30T16:28:50+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Basketball', 'byline': {'original': 'By William C. Rhoden', 'person': [{'firstname': 'William', 'middlename': 'C.', 'lastname': 'Rhoden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6f88450a-6210-5707-b918-08f2e5f46d84', 'word_count': 854, 'uri': 'nyt://article/6f88450a-6210-5707-b918-08f2e5f46d84'}, {'abstract': 'The fight against the disease has altered medicine, shaped research and highlighted the challenges that remain.', 'web_url': 'https://www.nytimes.com/2011/05/31/health/31aids.html', 'snippet': 'The fight against the disease has altered medicine, shaped research and highlighted the challenges that remain.', 'lead_paragraph': 'At first it seemed an oddity: a scattering of reports in the spring and early summer of 1981 that young gay men in New York and California were ill with forms of pneumonia and cancer usually seen only in people with severely weakened immune systems. ', 'print_section': 'D', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/31/science/AIDS-span/AIDS-articleLarge.jpg', 'height': 401, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/31/science/AIDS-span/AIDS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 401}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/31/science/AIDS-span/AIDS-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/31/science/AIDS-span/AIDS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/31/science/AIDS-span/AIDS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': '30 Years In, We Are Still Learning From AIDS', 'kicker': 'The Doctor’s World', 'content_kicker': None, 'print_headline': '30 Years In, We Are Still Learning From AIDS', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Medicine and Health', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Acquired Immune Deficiency Syndrome', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Epidemics', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-05-30T16:45:47+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Health', 'byline': {'original': 'By Lawrence K. Altman, M.D', 'person': [{'firstname': 'Lawrence', 'middlename': 'K.', 'lastname': 'Altman', 'qualifier': 'M.D', 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/13275763-a601-5b06-8611-45a1fd77fefb', 'word_count': 1742, 'uri': 'nyt://article/13275763-a601-5b06-8611-45a1fd77fefb'}, {'abstract': 'Peter Martins, the ballet master in chief of the company, had stepped in for an injured Ask la Cour.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/05/30/at-new-york-city-ballet-the-big-boss-plays-the-big-boss/', 'snippet': 'Peter Martins, the ballet master in chief of the company, had stepped in for an injured Ask la Cour.', 'lead_paragraph': '\xa0A mild tremor of excitement ran through the New York City Ballet audience on Sunday afternoon as the cast of George Balanchine’s “Slaughter on Tenth Avenue” took a bow. The dark-suited and hatted dancer who had played the “Big Boss” in the delightful tale of murder and mayhem at the ballet, had just popped out of the wings, performed a quick, modest salute, and popped back in. It took a moment to realize that the Big Boss was in fact the Big Boss. Peter Martins, the ballet master in chief of the company, had stepped in for an injured Ask la Cour the previous night, and reappeared at the matinee with no fanfare or announcement of the change in cast.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'At City Ballet, the Big Boss Plays the ‘Big Boss’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Martins, Peter', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York City Ballet', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-05-30T16:53:08+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Roslyn Sulcas', 'person': [{'firstname': 'Roslyn', 'middlename': None, 'lastname': 'Sulcas', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/738bac47-396c-5fdb-a6f0-52858a4f1622', 'word_count': 204, 'uri': 'nyt://article/738bac47-396c-5fdb-a6f0-52858a4f1622'}, {'abstract': 'I’ve decided to take on two personal challenges during my Mediterranean trip: exercising regularly and learning to like olives.', 'web_url': 'https://frugaltraveler.blogs.nytimes.com/2011/05/30/exercise-and-olives/', 'snippet': 'I’ve decided to take on two personal challenges during my Mediterranean trip: exercising regularly and learning to like olives.', 'lead_paragraph': 'I’m spending a lot of time alone this summer, and though I’m a pretty good companion for myself (I think that all my jokes are hilarious), there’s always room for more ways to stay entertained.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Exercise and Olives', 'kicker': 'Frugal Traveler', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Exercise', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Olives', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Mediterranean Sea', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Spain', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-05-30T16:57:26+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Travel', 'byline': {'original': 'By Seth Kugel', 'person': [{'firstname': 'Seth', 'middlename': None, 'lastname': 'Kugel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/067e7490-e7e7-5dd6-a424-eb84c4