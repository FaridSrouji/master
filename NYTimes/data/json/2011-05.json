: 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/12/opinion/12lettersimg/12lettersimg-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Coming Soon: Smoke-Free in the Park', 'kicker': 'Letters', 'content_kicker': None, 'print_headline': 'Coming Soon: Smoke-Free in the Park', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Parks and Other Recreation Areas', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Beaches', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Smoking and Tobacco', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-05-11T23:32:49+0000', 'document_type': 'article', 'news_desk': 'Letters', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/0c30e83a-1505-58e6-9b65-39fb6fe86ec4', 'word_count': 793, 'uri': 'nyt://article/0c30e83a-1505-58e6-9b65-39fb6fe86ec4'}, {'abstract': 'About that “new normal” — oops.', 'web_url': 'https://krugman.blogs.nytimes.com/2011/05/11/spilled-beveridge/', 'snippet': 'About that “new normal” — oops.', 'lead_paragraph': 'Last year there was a flurry of interest in the apparent fact that there were many more job vacancies than one should have expected given the high level of unemployment — a shift in the so-called Beveridge curve. And this was seized on by a number of people as evidence that much of our current unemployment is structural, that we need to accept a “new normal” of high unemployment rates. See Mike Konczal on this eagerness.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Spilled Beveridge', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-05-11T23:35:03+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'by