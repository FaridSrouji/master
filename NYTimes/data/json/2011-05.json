: '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/53b36db8-c685-55fa-b04d-588979145125', 'word_count': 349, 'uri': 'nyt://article/53b36db8-c685-55fa-b04d-588979145125'}, {'abstract': 'In Indiana on Friday, President Obama visited a company that makes hybrid vehicle transmissions to showcase his administration’s commitment to fuel-efficient technologies.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2011/05/06/obama-calls-for-end-of-oil-subsidies/', 'snippet': 'In Indiana on Friday, President Obama visited a company that makes hybrid vehicle transmissions to showcase his administration’s commitment to fuel-efficient technologies.', 'lead_paragraph': 'With gasoline prices still hovering above $4 a gallon, President Obama renewed his call on Friday to close tax loopholes for large oil companies, declaring, “If you’re already paying them at the gas pump, we don’t need to pay them through the tax code.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Obama Calls for End of Oil Subsidies', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fuel Efficiency', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Hybrid Vehicles', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Oil (Petroleum) and Gasoline', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-05-06T19:58:43+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Mark Landler', 'person': [{'firstname': 'Mark', 'middlename': None, 'lastname': 'Landler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/433d91fc-5f95-59e2-8623-2859f6083bd7', 'word_count': 345, 'uri': 'nyt://article/433d91f