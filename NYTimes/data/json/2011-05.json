Z-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/12/arts/KRANTZ/KRANTZ-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Director Is Born With ‘The Big Bang’', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Director Is Born With ‘The Big Bang’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Banderas, Antonio', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-05-11T21:37:00+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Movies', 'byline': {'original': 'By Brooks Barnes', 'person': [{'firstname': 'Brooks', 'middlename': None, 'lastname': 'Barnes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5530a1b4-8ba7-585d-a985-379628febbb7', 'word_count': 961, 'uri': 'nyt://article/5530a1b4-8ba7-585d-a985-379628febbb7'}, {'abstract': 'NBC’s singing competition “The Voice” earned the highest ratings on Tuesday.', 'web_url': 'https://www.nytimes.com/2011/05/12/arts/television/voice-has-a-niche.html', 'snippet': 'NBC’s singing competition “The Voice” earned the highest ratings on Tuesday.', 'lead_paragraph': 'NBC’s singing competition “The Voice” earned the highest ratings on Tuesday in the demographic of viewers 18 to 49, lifting the network to first place on the night in that age group for the third consecutive week. According to Nielsen’s estimates, the reality show attracted a more modest result in total viewers (10.3 million). NBC ranked third over all in total viewers, behind CBS, which drew 17.1 million for “NCIS” and 14.7 million for “NCIS: Los Angeles,” ABC and Fox.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '‘Voice’ Has a Niche', 'kicker': 'Arts, Briefly', 'content_kicker': None, 'print_headline': '‘Voice’ Has a Niche', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-05-11T21:37:54+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Benjamin Toff', 'person': [{'firstname': 'Benjamin', 'middlename': None, 'lastname': 'Toff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/1012219c-ae41-5e6c-9811-a669a8a9aa45', 'word_count': 85, 'uri': 'nyt://article/1012219c-ae41-5e6c-9811-a669a8a9aa45'}, {'abstract': 'The insider trading case against Raj Rajaratnam stemmed from an investigation that began well before the crimes were committed, and that made all the difference.', 'web_url': 'https://dealbook.nytimes.com/2011/05/11/a-case-that-got-a-head-start-on-the-crime/', 'snippet': 'The insider trading case against Raj Rajaratnam stemmed from an investigation that began well before the crimes were committed, and that made all the difference.', 'lead_paragraph': 'The insider trading case against Raj Rajaratnam stemmed from an investigation that began well before the crimes were committed, and that made all the difference, Floyd Norris of The New York Times reports. Read more »', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Case That Got a Head Start on the Crime', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Insider Trading', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Rajaratnam, Raj', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Galleon Group', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-05-11T21:38:27+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Dealbook', 'person': [{'firstname': 'Dealbook', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/70349dc0-9d9f-51e7-985b-b7b5cb7b13a1', 'word_count': 36, 'uri': 'nyt://article/70349dc0-9d9f-51e7-985b-b7b5cb7b13a1'}, {'abstract': 'Striking chamber pieces by Magnus Lindberg framed the latest Movado Hour program at the Baryshnikov Arts Center on Tuesday evening: one from near the start of his career, the other a premiere.', 'web_url': 'https://www.nytimes.com/2011/05/12/arts/music/movado-hour-with-lindberg-premiere-review.html', 'snippet': 'Striking chamber pieces by Magnus Lindberg framed the latest Movado Hour program at the Baryshnikov Arts Center on Tuesday evening: one from near the start of his career, the other a premiere.', 'lead_paragraph': 'The Finnish composer Magnus Lindberg has become a familiar face to audiences of the New York Philharmonic, where he has been serving as composer in residence since the start of Alan Gilbert’s tenure as music director in 2009. Mr. Lindberg’s chamber music has received comparatively less exposure during his time in New York. (It was the focus of a Making Music program at Carnegie Hall in 2002.)', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/12/arts/MOVADO/MOVADO-jumbo.jpg', 'height': 740, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Two by a Finnish Composer, and Variations Inspired by a Birthday', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Two by a Finnish Composer, and Variations Inspired by a Birthday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Lindberg, Magnus', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'v