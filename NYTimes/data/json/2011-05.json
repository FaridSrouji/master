d': 'nyt://article/7dc9b849-c484-5ca1-825b-4ac859a9d724', 'word_count': 560, 'uri': 'nyt://article/7dc9b849-c484-5ca1-825b-4ac859a9d724'}, {'abstract': 'The editor Robert Loomis, who is retiring from Random House after 54 years, is known for nurturing writers including Maya Angelou, William Styron, Shelby Foote and Calvin Trillin.', 'web_url': 'https://www.nytimes.com/2011/05/09/books/robert-loomis-book-editor-retiring-from-random-house.html', 'snippet': 'The editor Robert Loomis, who is retiring from Random House after 54 years, is known for nurturing writers including Maya Angelou, William Styron, Shelby Foote and Calvin Trillin.', 'lead_paragraph': 'If anyone is qualified to talk about the good old days of book publishing, it is Robert Loomis. ', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/09/arts/LOOMIS/LOOMIS-jumbo.jpg', 'height': 1024, 'width': 845, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/09/arts/LOOMIS/LOOMIS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/09/arts/LOOMIS/LOOMIS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Nurturer of Authors Is Closing the Book', 'kicker': None, 'content_kicker': None, 'print_headline': 'Nurturer Of Authors Is Closing The Book', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Random House', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Loomis, Robert', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Book Trade and Publishing', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Writing and Writers', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-05-08T22:04:11+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By Julie Bosman', 'person': [{'firstname': 'Julie', 'middlename': None, 'lastname': 'Bosman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5a4342b0-dd1f-5b76-902e-4cfddab55e60', 'word_count': 952, 'uri': 'nyt://article/5a4342b0-dd1f-5b76-902e-4cfddab55e60'}, {'abstract': 'John Chamberlain, 84, has almost singlehandedly given automotive metal a place in the history of sculpture, and now has a new gallery and two new shows.', 'web_url': 'https://www.nytimes.com/2011/05/09/arts/design/john-chamberlain-the-crushed-car-sculptor.html', 'snippet': 'John Chamberlain, 84, has almost singlehandedly given automotive metal a place in the history of sculpture, and now has a new gallery and two new shows.', 'lead_paragraph': 'SHELTER ISLAND, N.Y. — When a visitor pulled up outside an elegant shingled house here on a recent morning, three intact cars with familiar names — a Mitsubishi, a Land Rover, a Ford — were parked in the driveway. Next to them, wheel-less and sitting atop shipping pallets, were two sinuous, towering conglomerations of paint-encrusted steel that had clearly once been cars but that had been crushed, twisted, crumpled and squeezed into another realm of existence, somewhere between oblivion and timelessness.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/09/arts/CHAMBERLAIN/CHAMBERLAIN-articleLarge.jpg', 'height': 369, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/09/arts/CHAMBERLAIN/CHAMBERLAIN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 369}}, {'rank':