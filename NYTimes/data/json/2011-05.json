pations', 'content_kicker': None, 'print_headline': 'When Fear Stifles Initiative', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Labor and Jobs', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Layoffs and Job Reductions', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Executives and Management', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-05-14T17:58:03+0000', 'document_type': 'article', 'news_desk': 'SundayBusiness', 'section_name': 'Job Market', 'byline': {'original': 'By Robert W. Goldfarb', 'person': [{'firstname': 'Robert', 'middlename': 'W.', 'lastname': 'Goldfarb', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2d0d53b5-e0db-5ec8-a6ac-6865507b14a8', 'word_count': 684, 'uri': 'nyt://article/2d0d53b5-e0db-5ec8-a6ac-6865507b14a8'}, {'abstract': 'On your Sunday teevee.', 'web_url': 'https://krugman.blogs.nytimes.com/2011/05/14/head-talking/', 'snippet': 'On your Sunday teevee.', 'lead_paragraph': 'From Cvltvre Made Stupid.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Head, Talking', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-05-14T18:00:01+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/09501914-4fc7-5fa6-a5b0-761e85676b5f', 'word_count': 18, 'uri': 'nyt://article/09501914-4fc7-5fa6-a5b0-761e85676b5f'}, {'abstract': 'A former deputy foreign minister is the highest-profile politician to be sentenced in a series of trials that has been purging the beleaguered opposition in the former Soviet republic.', 'web_url': 'https://www.nytimes.com/2011/05/15/world/europe/15belarus.html', 'snippet': 'A former deputy foreign minister is the highest-profile politician to be sentenced in a series of trials that has been purging the beleaguered opposition in the former Soviet republic.', 'lead_paragraph': 'MOSCOW — Belarus sentenced a leading opponent of the country’s authoritarian president to five years in prison on Saturday for organizing a large antigovernment protest. The sentence is the harshest punishment yet in a far-reaching crackdown that shows little sign of abating. ', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/15/world/sub-15belarus/sub-15belarus-jumbo.jpg', 'height': 730, 'width': 657, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/15/world/sub-15belarus/sub-15belarus-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/15/world/sub-15belarus/sub-15belarus-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Belarus Opposition Leader Gets a Five-Year Sentence', 'kicker': None, 'content_kicker': None, 'print_headline': 'Belarus Opposition Leader Gets a Five-Year Sentence', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Sannikov, Andrei', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Demonstrations, Protests, and Riots', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Belarus', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Lukashenko, Aleksandr G', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-05-14