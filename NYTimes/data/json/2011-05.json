': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Auctions', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Stone, Allan', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': "Sotheby's", 'rank': 4, 'major': 'N'}], 'pub_date': '2011-05-11T04:31:18+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Carol Vogel', 'person': [{'firstname': 'Carol', 'middlename': None, 'lastname': 'Vogel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/905b962e-c9ce-5de7-8c8b-f8f8781d6954', 'word_count': 674, 'uri': 'nyt://article/905b962e-c9ce-5de7-8c8b-f8f8781d6954'}, {'abstract': 'Officials in Chile have approved a huge hydroelectric project in the heart of Patagonia, setting off protests by environmentalists in several cities.', 'web_url': 'https://www.nytimes.com/2011/05/11/world/americas/11briefs-ART-Chilebrf.html', 'snippet': 'Officials in Chile have approved a huge hydroelectric project in the heart of Patagonia, setting off protests by environmentalists in several cities.', 'lead_paragraph': ' Officials in Chile have approved a huge hydroelectric project in the heart of Patagonia, setting off protests by environmentalists in several cities. The Environmental Assessment Commission of Coyhaique, a regional government commission in southern Chile, approved on Monday the $3.2 billion project, which involves a series of five dams in the sparsely populated region of Aysén, which is dotted with nature reserves. Government officials say the HidroAysén project is needed to help stave off an energy squeeze in Chile, which imports about 70 percent of its energy. Environmentalists say it will flood thousands of acres of largely undeveloped territory and damage ranching and tourism. The police arrested at least 60 people late Monday in Santiago at a downtown protest that attracted thousands. Hundreds of demonstrators also took to the streets in at least four other Chilean cities. Opponents, including some members of Chile’s Congress, said Tuesday that they would appeal in court, while opposition legislators said they would request a congressional investigation into irregularities in the project’s approval. ', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Chile: Power Project Approved', 'kicker': 'World Briefing | THE AMERICAS', 'content_kicker': None, 'print_headline': 'Chile: Power Project Approved', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Politics and Government', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Patagonia (Argentina)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Environment', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-05-11T04:38:35+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Americas', 'byline': {'original': 'By Alexei Barrionuevo', 'person': [{'firstname': 'Alexei', 'middlename': None, 'lastname': 'Barrionuevo', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/da149772-2848-5aa1-a868-a30533ec6723', 'word_count': 169, 'uri': 'nyt://article/da149772-2848-5aa1-a868-a30533ec6723'}, {'abstract': 'First baseman Ike Davis, who leads the team in home runs and runs batted in, left in the fifth inning with a strained left calf and is listed as day to day.', 'web_url': 'https://www.nytimes.com/2011/05/11/sports/baseball/ike-davis-helps-mets-win-but-is-injured-in-collision.html', 'snippet': 'First baseman Ike Davis, who leads the team in home runs and runs batted in, left in the fifth inning with a strained left calf and is listed as day to day.', 'lead_paragraph': 'DENVER — A well-earned victory on a soggy evening at Coors Field was tinged with a measure of concern for the Mets, who suffered a loss despite their 4-3 victory over the Colorado Rockies.', 'print_section': 'B', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/11/sports/mets/mets-articleLarge.jpg', 'height': 315, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/11/sports/mets/mets-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 315}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/11/sports/mets/mets-jumbo.jpg', 'height': 771, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/11/sports/mets/mets-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/11/sports/mets/mets-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Davis Helps Mets Win, but Is Injured in a Collision', 'kicker': 'Mets 4, Rockies 3', 'content_kicker': None, 'print_headline': 'Davis Helps the Mets Win, But Is Injured in a Collision', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Davis, Ike', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Mets', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Colorado Rockies', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-05-11T04:42:53+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By David Waldstein', 'person': [{'firstname':