kicker': 'Riff', 'content_kicker': None, 'print_headline': '‘Shrieking, Squirming, Beatings,Panic, a Severed Finger and a Facial Tattoo’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Phillips, Todd', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'APATOW, JUDD', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Comedy and Humor', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-05-26T02:00:27+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Adam Sternbergh', 'person': [{'firstname': 'Adam', 'middlename': None, 'lastname': 'Sternbergh', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fcf40b5c-1a94-54c9-b751-ad1c249dd231', 'word_count': 1803, 'uri': 'nyt://article/fcf40b5c-1a94-54c9-b751-ad1c249dd231'}, {'abstract': 'In the (tiny) kitchen with Danny Bowien of Mission Chinese, a (fabulous) restaurant within a restaurant.', 'web_url': 'https://www.nytimes.com/2011/05/29/magazine/mark-bittman-san-franciscos-new-pop-up-restaurant.html', 'snippet': 'In the (tiny) kitchen with Danny Bowien of Mission Chinese, a (fabulous) restaurant within a restaurant.', 'lead_paragraph': 'It’s not a coincidence that three of the country’s hottest destination restaurants are more or less dives — the kinds of places for which you have to put on your worst clothes. And it’s not a coincidence that they all take chances; as with television shows, the best new restaurants aren’t copycats. Two of these places — Torrisi Italian Specialties (written about in the magazine a few weeks ago) and M. Wells, a reborn diner — are in New York and have European roots.', 'print_section': 'MM', 'print_page': '46', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': No