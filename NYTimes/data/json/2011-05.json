edia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/29/nyregion/29COMEDYWEDO-NOT-OPEN-UP-HOLD-CONTRAST-MATCH-MERLIN-FOR-COLOR1/29COMEDYWEDO-NOT-OPEN-UP-HOLD-CONTRAST-MATCH-MERLIN-FOR-COLOR1-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/29/nyregion/29COMEDYWEDO-NOT-OPEN-UP-HOLD-CONTRAST-MATCH-MERLIN-FOR-COLOR1/29COMEDYWEDO-NOT-OPEN-UP-HOLD-CONTRAST-MATCH-MERLIN-FOR-COLOR1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/29/nyregion/29COMEDYWEDO-NOT-OPEN-UP-HOLD-CONTRAST-MATCH-MERLIN-FOR-COLOR1/29COMEDYWEDO-NOT-OPEN-UP-HOLD-CONTRAST-MATCH-MERLIN-FOR-COLOR1-jumbo.jpg', 'height': 728, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/29/nyregion/29COMEDYWEDO-NOT-OPEN-UP-HOLD-CONTRAST-MATCH-MERLIN-FOR-COLOR1/29COMEDYWEDO-NOT-OPEN-UP-HOLD-CONTRAST-MATCH-MERLIN-FOR-COLOR1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/29/nyregion/29COMEDYWEDO-NOT-OPEN-UP-HOLD-CONTRAST-MATCH-MERLIN-FOR-COLOR1/29COMEDYWEDO-NOT-OPEN-UP-HOLD-CONTRAST-MATCH-MERLIN-FOR-COLOR1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'You Call This a Golden Age? 1950s TV, via Neil Simon', 'kicker': 'Theater Review | Westchester', 'content_kicker': None, 'print_headline': 'You Call This a Golden Age? 1950s TV, via Neil Simon', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Simon, Neil', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Schoolhouse Theater', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Westchester County (NY)', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-05-28T02:58:06+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Anita Gates', 'person': [{'firstname': 'Anita', 'middlename': None, 'lastname': 'Gates', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/de489169-16b2-522c-8a43-b847f8211c96', 'word_count': 650, 'uri': 'nyt://article/de489169-16b2-522c-8a43-b847f8211c96'}, {'abstract': 'Lighting designers are rarely on our minds as we watch plays. But this one is crucial.', 'web_url': 'https://www.nytimes.com/2011/05/29/nyregion/greetings-is-at-the-penguin-rep-theater-review.html', 'snippet': 'Lighting designers are rarely on our minds as we watch plays. But this one is crucial.', 'lead_paragraph': 'We couldn’t actually see theater without them, but lighting designers are rarely on our minds as we watch plays. It’s a little different with Tom Dudzick’s 1990 comedy “Greetings!” He’s made the lights a crucial part of his story. And Martin E. Vreeland, the designer of the lighting effects in the production at Penguin Rep Theater in Stony Point, in Rockland County, has gotten them all just right.', 'print_section': 'WE', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/29/nyregion/29THEATWE1/29THEATWE1-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/29/nyregion/29THEATWE1/29THEATWE1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/29/nyregion/29THEATWE1/29THEATWE1-jumbo.jpg', 'height': 768, 'width': 1024, 'subTyp