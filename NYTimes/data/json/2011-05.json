ars.', 'print_section': 'F', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/03/world/sub-03qaeda/sub-03qaeda-jumbo.jpg', 'height': 665, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Even Before Al Qaeda Lost Its Founder, It May Have Lost Some of Its Allure', 'kicker': None, 'content_kicker': None, 'print_headline': 'Even Before Al Qaeda Lost Its Founder, It May Have Lost Some of Its Allure', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'bin Laden, Osama', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Terrorism', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Awlaki, Anwar al-', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Zawahri, Ayman Al-', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'AL QAEDA', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-05-03T01:55:34+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'byline': {'original': 'By Scott Shane and Robert F. Worth', 'person': [{'firstname': 'Scott', 'middlename': None, 'lastname': 'Shane', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Robert', 'middlename': 'F.', 'lastname': 'Worth', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ab3f26c1-7afd-520b-8176-c6f69262e88a', 'word_count': 1052, 'uri': 'nyt://article/ab3f26c1-7afd-520b-8176-c6f69262e88a'}, {'abstract': 'Kevan Choset always gets his man.', 'web_url': 'https://wordplay.blogs.nytimes.com/2011/05/02/foot/', 'snippet': 'Kevan Choset always gets his man.', 'lead_paragraph': 'TUESDAY’S PUZZLE — It’s a bird! It’s a plane! It’s … Kevan Choset, back to put us through our puzzle paces.', 'source': 'The New York Times'