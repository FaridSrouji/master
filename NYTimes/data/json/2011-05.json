': [{'firstname': 'Donald', 'middlename': 'G.', 'lastname': 'McNeil', 'qualifier': 'Jr', 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ec713ccf-8846-5498-b727-30a3e3854b4e', 'word_count': 255, 'uri': 'nyt://article/ec713ccf-8846-5498-b727-30a3e3854b4e'}, {'abstract': 'The fate of the former B. F. Goodrich Building on Broadway is uncertain.', 'web_url': 'https://cityroom.blogs.nytimes.com/2011/05/16/once-a-bustling-autombile-row-anchor-now-empty/', 'snippet': 'The fate of the former B. F. Goodrich Building on Broadway is uncertain.', 'lead_paragraph': 'It was a dignified mainstay of Automobile Row, the line of glittery showrooms and automobile-related offices that stretched up Broadway from the West 50s to somewhere north of Columbus Circle. Its tire-company name lingered when new tenants moved in, among them a studio where stars like Duke Ellington made recordings.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Once a Bustling Automobile Row Anchor, Now Empty', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Building (Construction)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Historic Buildings and Sites', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Housing and Real Estate', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Office Buildings and Commercial Properties', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Buildings Department (NYC)', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Extell', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Landmarks Preservation Commission', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'COLUMBUS CIRCLE (NYC)', 'rank': 8, 'major': 'N'}], 'pub_date': '2011-05-16T18:39:25+0000', 'document_type': 'article', 'news_desk': ''