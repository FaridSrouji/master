: 'N'}], 'pub_date': '2011-05-23T17:29:00+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Carl Hulse', 'person': [{'firstname': 'Carl', 'middlename': None, 'lastname': 'Hulse', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2d464663-ba66-50ef-b182-646c14d31ae5', 'word_count': 1099, 'uri': 'nyt://article/2d464663-ba66-50ef-b182-646c14d31ae5'}, {'abstract': 'Morning Line for Monday, May 23', 'web_url': 'https://therail.blogs.nytimes.com/2011/05/23/morning-line-its-all-how-you-look-at-it/', 'snippet': 'Morning Line for Monday, May 23', 'lead_paragraph': 'In the aftermath of the Preakness, there are basically two types of Triple Crown stories. They correspond to the glass half empty or the glass half full view of the Triple Crown. The story lines are: (1) What do we do now without a Triple Crown winner for another year and (2) maybe we can have a rivalry between the Kentucky Derby winner Animal Kingdom and the Preakness winner Shackleford that will be settled in the Belmont Stakes.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Morning Line: It’s All How You Look at It', 'kicker': 'The Rail', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Horse Racing', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-05-23T17:30:30+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'byline': {'original': 'By Bennett Liebman', 'person': [{'firstname': 'Bennett', 'middlename': None, 'lastname': 'Liebman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/9efcdad1-0c3c-5b12-b582-c32aaaccb178', 'word_count': 987, 'uri': 'nyt://article/9efcdad1-0c3c-5b12-b582-c32aaaccb178'}, {'abstract': 'Conditions in overcrowded prisons violate the ban on cruel and unusual punishment, the Supreme Court ruled.', 'web_url': 'https://www.nytimes.com/2011/05/24/us/24scotus.html', 'snippet': 'Conditions in overcrowded prisons violate the ban on cruel and unusual punishment, the Supreme Court ruled.', 'lead_paragraph': 'WASHINGTON — Conditions in California’s overcrowded prisons are so bad that they violate the Eighth Amendment’s ban on cruel and unusual punishment, the Supreme Court ruled on Monday, ordering the state to reduce its prison population by more than 30,000 inmates.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/24/us/SCOTUS/SCOTUS-articleLarge.jpg', 'height': 316, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/24/us/SCOTUS/SCOTUS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 316}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/24/us/SCOTUS/SCOTUS-jumbo.jpg', 'height': 539, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/24/us/SCOTUS/SCOTUS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/24/us/SCOTUS/SCOTUS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Justices, 5-4, Tell California to Cut Prisoner Population', 'kicker': None, 'content_kicker': None, 'print_headline': 'JUSTICES, 5-4, TELL CALIFORNIA TO CUT PRISON CROWDING', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Prisons and Prisoners', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Supreme Court', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'California', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-05-23T17:36:25+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Adam Liptak', 'person': [{'firstname': 'Adam', 'middlename': None, 'lastname': 'Liptak', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a23925b8-e2d0-55ff-b264-95c0a588c538', 'word_count': 1073, 'uri': 'nyt://article/a23925b8-e2d0-55ff-b264-95c0a588c538'}, {'abstract': 'In “The Fear: Robert Mugabe and the Martyrdom of Zimbabwe,” Peter Godwin details many of the brutal actions employed by the Mugabe government to maintain control.', 'web_url': 'https://www.nytimes.com/2011/05/24/books/the-fear-robert-mugabe-and-the-martyrdom-of-zimbabwe-by-peter-godwin.html', 'snippet': 'In “The Fear: Robert Mugabe and the Martyrdom of Zimbabwe,” Peter Godwin details many of the brutal actions employed by the Mugabe government to maintain control.', 'lead_paragraph': 'An authoritarian government willing to use the most brutal means to hold on to power; a dictator whose thugs have murdered, tortured, imprisoned or intimidated tens of thousands of civilians; and individuals who have risked their lives simply to exercise their most fundamental rights — this is the state of affairs not only in Libya today, but also in Zimbabwe, which has suffered the ravages of more than 30 years under the autocratic rule of President Robert Mugabe. ', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/24/arts/BOOK/BOOK-jumbo.jpg', 'height': 1024, 'width': 709, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/24/arts/BOOK/BOOK-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/24/arts/BOOK/BOOK-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Where Dissidents Are the Prey, and Horror Is a Weapon', 'kicker': 'Books of The Times', 'content_kicker': None, 'print_headline': 'Where Dissidents Are the Prey, and Horror Is a Weapon', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Mugabe, Robert', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Godwin, Peter', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-05-23T17:42:06+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By Michiko Kakutani', 'person': [{'firstname': 'Michiko', 'middlename': None, 'lastname': 'Kakutani', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/6d85c8d8-c7fd-55ab-b096-72bbb2658320', 'word_count': 1341, 'uri': 'nyt://article/6d85c8d8-c7fd-55ab-b096-72bbb2658320'}, {'abstract': 'Oscar de la Renta is no stranger to Spain, which is exactly where he went with the Resort collection he showed last week.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2011/05/23/just-one-look-oscar-de-la-renta-resort/', 'snippet': 'Oscar de la Renta is no stranger to Spain, which is exactly where he went with the Resort collection he showed last week.', 'lead_paragraph': 'Oscar de la Renta is no stranger to Spain, which is exactly where he went with the Resort collection he showed last week. The clothes were at their most Modern (with a capital M), when the designer sidestepped ruffles and other Flamenco finery in favor of graphic cubist motifs inspired by the work of Picasso and Gris. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Just One Look | Oscar de la Renta Resort', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-05-23T17:45:01+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Alix Browne', 'person': [{'firstname': 'Alix', 'middlename': None, 'lastname': 'Browne', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/18e39844-8fbc-542f-92e7-e5efc7788105', 'word_count': 61, 'uri': 'nyt://article/18e39844-8fbc-542f-92e7-e5efc7788105'}, {'abstract': 'Many youngsters and most teenagers do not get enough sleep, and this can result in serious consequences, impairing school performance and even raising the risk of depression and other mood disorders.', 'web_url': 'https://well.blogs.nytimes.com/2011/05/23/how-much-do-your-children-sleep/', 'snippet': 'Many youngsters and most teenagers do not get enough sleep, and this can result in serious consequences, impairing school performance and even raising the risk of depression and other mood disorders.', 'lead_paragraph': 'In this week’s Personal Health column, Jane Brody writes about the sleep needs of children and teenagers, finding that many young people are not getting nearly enough sleep.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'How Much Do Your Children Sleep?', 'kicker': 'Well', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Children and Youth', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Medicine and Health', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Sleep', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Teenagers and Adolescence', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-05-23T17:45:58+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Health', 'byline': {'original': 'By Tara Parker-Pope', 'person': [{'firstname': 'Tara', 'middlename': None, 'lastname': 'Parker-Pope', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/cad8d8f9-3d26-5a66-a242-ab993833fe44', 'word_count': 124, 'uri': 'nyt://article/cad8d8f9-3d26-5a66-a242-ab993833fe44'}, {'abstract': 'How to make your iPhone battery last a lot longer? About a minute of maintenance.', 'web_url': 'https://pogue.blogs.nytimes.com/2011/05/23/four-ways-to-make-your-battery-last-longer/', 'snippet': 'How to make your iPhone battery last a lot longer? About a minute of maintenance.', 'lead_paragraph': 'A good friend of mine had been complaining that her iPhone 3GS battery was holding less and less of a charge. When we got together at 5 p.m. one recent day, it was at 5 percent full — and it had been fully charged that morning. She had barely used it all day. The phone was apparently running itself dry simply by being turned on.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Four Ways to Make Your Battery Last Longer', 'kicker': 'Pogue&#039;s Posts', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Batteries', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'iPhone', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Apple Incorporated', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-05-23T17:48:28+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By David Pogue', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Pogue', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/f48dba89-5487-54dc-9abb-cc792f3e78cb', 'word_count': 609, 'uri': 'nyt://article/f48dba89-5487-54dc-9abb-cc792f3e78cb'}, {'abstract': 'In a nod to the incredible popularity of AMC’s “Walking Dead” and books like Max Brooks’s “World War Z” (a great read, by the way) — and perhaps even to the believers who thought May 21 would be the end of the world — the Centers for Disease Control have helpfully published “Preparedness 101: Zombie Apocalypse.”', 'web_url': 'https://6thfloor.blogs.nytimes.com/2011/05/23/what-to-do-when-the-zombies-come/', 'snippet': 'In a nod to the incredible popularity of AMC’s “Walking Dead” and books like Max Brooks’s “World War Z” (a great read, by the way) — and perhaps even to the believers who thought May 21 would be the end of the world — the Centers for Disease Contr...', 'lead_paragraph': 'http://www.youtube.com/watch?v=R1v0uFms68U', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What to Do When the Zombies Come', 'kicker': 'The 6th Floor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Thompson, Clive', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Centers for Disease Control and Prevention', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-05-23T17:48:54+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Magazine', 'byline': {'original': 'By Lia Miller', 'person': [{'firstname': 'Lia', 'middlename': None, 'lastname': 'Miller', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/68b83b8e-11b2-5b1c-8ba9-3a3397d08560', 'word_count': 285, 'uri': 'nyt://article/68b83b8e-11b2-5b1c-8ba9-3a3397d08560'}, {'abstract': 'The superslow movies of Apichatpong Weerasethakul are featured in a new installation at the New Museum.', 'web_url': 'https://6thfloor.blogs.nytimes.com/2011/05/23/ghost-stories/', 'snippet': 'The superslow movies of Apichatpong Weerasethakul are featured in a new installation at the New Museum.', 'lead_paragraph': 'Apichatpong Weerasethakul may not be a household name, even if the Thai filmmaker won the Jury Prize at Cannes one year, the Palme d’Or another. His first museum show, at the\xa0New Museum on the Bowery, opened on May 20.\xa0Weerasethakul is known for making superslow movies, usually set in the Thai countryside, that blend Thai folk tales and contemporary life (with an occasional reference to Godard).', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Ghost Stories', 'kicker': 'The 6th Floor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Weerasethakul, Apichatpong', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Times', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Thailand', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-05-23T17:51:25+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Magazine', 'byline': {'original': 'By Sheila Glaser', 'person': [{'firstname': 'Sheila', 'middlename': None, 'lastname': 'Glaser', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/61221132-a598-5a56-9956-35c419ecce22', 'word_count': 311, 'uri': 'nyt://article/61221132-a598-5a56-9956-35c419ecce22'}, {'abstract': "The Times's Megan Liberman and Jim Rutenberg discuss what the announcement by Tim Pawlenty, the former governor of Minnesota, means for the Republican Party and the 2012 presidential race.", 'web_url': 'https://www.nytimes.com/video/us/politics/100000000831291/caucus--pawlenty-declares.html', 'snippet': "The Times's Megan Liberman and Jim