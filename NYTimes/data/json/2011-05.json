ame': None, 'lastname': 'Longman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c4c459ef-8fdf-56b6-83d7-8c39015f09f8', 'word_count': 809, 'uri': 'nyt://article/c4c459ef-8fdf-56b6-83d7-8c39015f09f8'}, {'abstract': 'WNYE-FM, the city-owned noncommercial station at 91.5 on the dial, will begin broadcasting the indie music service “The Alternate Side.”', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/05/29/a-new-radio-home-for-alternative-music/', 'snippet': 'WNYE-FM, the city-owned noncommercial station at 91.5 on the dial, will begin broadcasting the indie music service “The Alternate Side.”', 'lead_paragraph': 'New York City’s alternative music scene will get a lift starting Wednesday, June 1, when WNYE-FM, the city-owned noncommercial station at 91.5 on the dial, begins broadcasting the indie music service “The Alternate Side” from 6 a.m. to noon. The program, started in 2008 by Fordham University’s public station WFUV-FM with support from the New York State Music Fund, has showcased artists like the Strokes and TV on the Radio as well as newer local groups like Freelance Whales.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A New Radio Home for Alternative Music', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Radio', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'WFUV', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'WNYE', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-05-29T18:59:53+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Elizabeth Jensen', 'person': [{'firstname': 'Elizabeth', 'middlename': None, 'lastname': 'Jensen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bcd9adfd-c71a-501e-90a0-6a376a90bdbb', 'word_count': 184, 'uri': 'nyt://article/bcd9adfd-c71a-501e-90a0-6a376a90bdbb'}, {'abstract': 'The strongest films have benefited from 3-D, but consumers are rejecting middling movies that employ the technology to wring more money from moviegoers.', 'web_url': 'https://www.nytimes.com/2011/05/30/business/media/30panda.html', 'snippet': 'The strongest films have benefited from 3-D, but consumers are rejecting middling movies that employ the technology to wring more money from moviegoers.', 'lead_paragraph': 'LOS ANGELES — Has the 3-D boom already gone bust? It’s starting to look that way — at least for American moviegoers — even as Hollywood prepares to release a glut of the gimmicky pictures.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/30/business/media/30panda-span/30panda-span-articleLarge.jpg', 'height': 315, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/30/business/media/30panda-span/30panda-span-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 315}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/30/business/media/30panda-span/30panda-span-jumbo.jpg', 'height': 435, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/30/business/media/30panda-span/30panda-span-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/30/business/media/30panda-span/30panda-span-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}