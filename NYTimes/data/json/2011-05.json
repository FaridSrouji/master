pe': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/02/world/CANADA/CANADA-jumbo.jpg', 'height': 1024, 'width': 737, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/02/world/CANADA/CANADA-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/02/world/CANADA/CANADA-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Canadian Party Gains Strength', 'kicker': None, 'content_kicker': None, 'print_headline': 'Canada&#8217;s Third Party Gains Traction', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Liberal Party', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Canada', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Harper, Stephen J', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Elections', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-05-01T20:44:00+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Americas', 'byline': {'original': 'By Ian Austen', 'person': [{'firstname': 'Ian', 'middlename': None, 'lastname': 'Austen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/99e1dcf5-e7c9-5631-8552-3d29f46a94f6', 'word_count': 750, 'uri': 'nyt://article/99e1dcf5-e7c9-5631-8552-3d29f46a94f6'}, {'abstract': 'Bang on a Can All-Stars and Friends, Kronos Quartet and two other ensembles played the music of Steve Reich at Carnegie Hall.', 'web_url': 'https://www.nytimes.com/2011/05/02/arts/music/steve-reich-by-kronos-quartet-and-others-at-carnegie-hall.html', 'snippet': 'Bang on a Can All-Stars and Friends, Kronos Quartet and two other ensembles played the music of Steve Reich at Carnegie Hall.', 'lead_paragraph': 'Steve Reich is in the enviable position, for a living composer, of not having to wait for milestone birthday celebrations to hear his music performed. Certain seminal works — “Drumming” (1971), Music for 18 Musicians (1976) and “Different Trains” (1988) — are heard at least once a season, and new scores are added immediately to his expansive Nonesuch discography. So when those birthdays do come — like Mr. Reich’s 75th birthday, on Oct. 3 — the stakes are raised: How do you make a concert of a composer’s works seem special when the music is heard all the time? ', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/02/arts/bang/bang-articleLarge.jpg', 'height': 293, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/02/arts/bang/bang-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 293}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/02/arts/bang/bang-jumbo.jpg', 'height': 500, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Four Ensembles Unite for a Contemporary Composer’s Big Birthday', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Four Ensembles Unite for a Contemporary Composer’s Big Birthday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Kronos Quartet', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Bang on a Can All-Stars', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-05-01T20:57:50+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Allan Kozinn', 'person': [{'firstname': 'Allan', 'middlename': None, 'lastname': 'Kozinn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/754194bc-c9fd-5607-bf60-096c876a02ad', 'word_count': 579, 'uri': 'nyt://article/754194bc-c9fd-5607-bf60-096c876a02ad'}, {'abstract': 'Romulo Larrea Tango Ensemble of Quebec played up wit in its program “Tangos From Gardel to Piazzolla” at Town Hall.', 'web_url': 'https://www.nytimes.com/2011/05/02/arts/dance/romulo-larrea-tango-ensemble-at-town-hall-review.html', 'snippet': 'Romulo Larrea Tango Ensemble of Quebec played up wit in its program “Tangos From Gardel to Piazzolla” at Town Hall.', 'lead_paragraph': 'Lots of shows do their best to break down the fourth wall, but tango productions tend to rely on it. There the audience members are, seated demurely in their rows of chairs, while on stage the dancers and musicians, dressed to the glittery nines, evoke sultry encounters in romantic, far-flung locales. The whole point is to be transported to another place.', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/02/arts/tango/tango-jumbo.jpg', 'height': 691, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Sensual Spanish Accent Arrives by Way of Quebec', 'kicker': 'Dance Review', 'content_kicker': None, 'print_headline': 'Sensual Spanish Accent Arrives by Way of Quebec', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Tango', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Dancing', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-05-01T21:00:48+0000', 'document_type': 'article', 'news_desk': 'Cul