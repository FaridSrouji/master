'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/09/arts/HOLLOWAY1/HOLLOWAY1-articleLarge.jpg', 'height': 315, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/09/arts/HOLLOWAY1/HOLLOWAY1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 315}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/09/arts/HOLLOWAY1/HOLLOWAY1-jumbo.jpg', 'height': 557, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'The Mystery That Won’t Go Away', 'kicker': 'Critic’s Notebook', 'content_kicker': None, 'print_headline': 'The Mystery That Won’t Go Away', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Lifetime Television', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Holloway, Natalee', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-05-08T22:16:17+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Ginia Bellafante', 'person': [{'firstname': 'Ginia', 'middlename': None, 'lastname': 'Bellafante', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9d330929-2198-57e6-a1f1-83393b60d983', 'word_count': 743, 'uri': 'nyt://article/9d330929-2198-57e6-a1f1-83393b60d983'}, {'abstract': 'Yuck, a band that nails the drone sound of the early 1990s, played a show at the Bowery Ballroom that was flawless, for better and for worse.', 'web_url': 'https://www.nytimes.com/2011/05/09/arts/music/yuck-at-the-bowery-ballroom-review.html', 'snippet': 'Yuck, a band that nails the drone sound of the early 1990s, played a show at the Bowery Ballroom that was flawless, for better and for worse.', 'lead_paragraph': 'Yuck really nails the drone, that low, slow guitar moan of the early 1990s — not guttural in a grunge way, but something a little more restrained and polite, maybe even a bit resigned.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/09/arts/YUCK/YUCK-jumbo.jpg', 'height': 1024, 'width': 844, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/09/arts/YUCK/YUCK-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/09/arts/YUCK/YUCK-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Diving Into the Simulacrum, Moptop First', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Diving Into the Simulacrum, Moptop First', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Yuck (Music Group)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Rock Music', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-05-08T22:17:31+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Jon Caramanica', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Caramanica', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/8ecc64bb-07cf-57b8-849e-3d5e710c1cd2', 'word_count': 506, 'uri': 'nyt://article/8ecc64bb-07cf-57b8-849e-3d5e710c1cd2'}, {'abstract': 'The Orpheus Chamber Orchestra and the Toledo Symphony performed at Carnegie Hall as part of the Spring for Music festival.', 'web_url': 'https://www.nytimes.com/2011/05/09/arts/music/orpheus-and-toledo-symphony-at-carnegie-hall-review.html', 'snippet': 'The Orpheus Chamber Orchestra and the Toledo Symphony performed at Carnegie Hall as part of the Spring for Music festival.', 'lead_paragraph': 'Spring for Music, the new festival of North American symphony and chamber orchestras at Carnegie Hall, started on a relatively subdued note on Friday night with the Orpheus Chamber Orchestra, but caught fire on Saturday evening with the Toledo Symphony.', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/09/arts/ORPHEUS/ORPHEUS-articleLarge.jpg', 'height': 375, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/09/arts/ORPHEUS/ORPHEUS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 375}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/09/arts/ORPHEUS/ORPHEUS-jumbo.jpg', 'height': 677, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Something Borrowed and Something New', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Something Borrowed and Something New', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Orpheus Chamber Orchestra', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-05-08T22:19:34+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By James R. Oestreich', 'person': [{'firstname': 'James', 'middlename': 'R.', 'lastname': 'Oestreich', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/078d87a8-766d-5897-8844-eae1311a2dd8', 'word_count': 726, 'uri': 'nyt://article/078d87a8-766d-5897-8844-eae1311a2dd8'}, {'abstract': 'Worried about the soaring prices of commodities, exchange officials are raising the collateral needed to guarantee trades.', 'web_url': 'https://www.nytimes.com/2011/05/09/business/economy/09commodities.html', 'snippet': 'Worried about the soaring prices of commodities, exchange officials are raising the collateral needed to guarantee trades.', 'lead_paragraph': 'On April 25, half a dozen officials from the CME Group, which runs many of the nation’s commodities exchanges, met via videophone to discuss the eye-popping rise in the price of silver, which had doubled in just six months to about $47 a troy ounce. ', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/09/business/jpCOMMODITIES/jpCOMMODITIES-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/09/business/jpCOMMODITIES/jpCOMMODITIES-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/09/business/jpCOMMODITIES/jpCOMMODITIES-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Response to Volatility in Silver Takes Hold', 'kicker': None, 'content_kicker': None, 'print_headline': 'Response to Volatility in Silver Takes Hold', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Futures and Options Trading', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Commodities', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'CME Group Inc', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Silver', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Prices (Fares, Fees and Rates)', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-05-08T22:24:01+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By William Neuman and Graham Bowley', 'person': [{'firstname': 'William', 'middlename': None, 'lastname': 'Neuman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Graham', 'middlename': None, 'lastname': 'Bowley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c5704dcf-43b6-5b6b-b79d-3f181d353fdf', 'word_count': 1210, 'uri': 'nyt://article/c5704dcf-43b6-5b6b-b79d-3f181d353fdf'}, {'abstract': 'The venerable Cuban group Los Muñequitos de Matanzas brought its kinetic energy to Symphony Space as part of the ¡Sí Cuba! Festival.', 'web_url': 'https://www.nytimes.com/2011/05/09/arts/music/los-munequitos-de-matanzas-at-si-cuba-festival-review.html', 'snippet': 'The venerable Cuban group Los Muñequitos de Matanzas brought its kinetic energy to Symphony Space as part of the ¡Sí Cuba! Festival.', 'lead_paragraph': 'Rhythm serves both gods and lovers in the music of Los Muñequitos de Matanzas, the venerable Cuban group that returned to New York City last week for the first time since 2002 with concerts at Symphony Space. Presented by the World Music Institute, the three shows were part of the citywide ¡Sí Cuba! festival.', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/09/arts/MANTANZAS1/MANTANZAS1-articleLarge.jpg', 'height': 367, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/09/arts/MANTANZAS1/MANTANZAS1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 367}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/09/arts/MANTANZAS1/MANTANZAS1-jumbo.jpg', 'height': 736, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Roaring Back With Rumba and Religion', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Roaring Back With Rumba and Religion', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Cuba', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-05-08T22:26:03+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Jon Pareles', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Pareles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/c2fe0220-f020-5b34-98c9-4a79281d759e', 'word_count': 507, 'uri': 'nyt://article/c2fe0220-f020-5b34-98c9-4a79281d759e'}, {'abstract': 'Burt Bacharach’s new musical, “Some Lovers,” will have its debut at the Old Globe theater in San Diego this year, Playbill reported.', 'web_url': 'https://www.nytimes.com/2011/05/09/theater/bacharach-musical-to-open-in-san-diego.html', 'snippet': 'Burt Bacharach’s new musical, “Some Lovers,” will have its debut at the Old Globe theater in San Diego this year, Playbill reported.', 'lead_paragraph': 'Burt Bacharach’s new musical, “Some Lovers,” will have its debut at the Old Globe theater in San Diego this year, Playbill reported. Mr. Bacharach, whose “I Say a Little Prayer” and “Do You Know the Way to San Jose?” are among his most famous pop songs, wrote the music to the show, which is based on “The Gift of the Magi,” the O. Henry short story. The book and lyrics are by Steven Sater (“Spring Awakening”). “Some Lovers” is to run Nov. 26 to Dec. 31 as part of the Old Globe’s 2011-12 season, which also includes the premieres of works by Matthew Lopez (“The Whipping Man”), Gaby Alter and Itamar Moses, and Jonathan Caren, as well as the West Coast premiere of “The Scottsboro Boys.”', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Bacharach Musical to Open in San Diego', 'kicker': 'Arts, Briefly', 'content_kicker': None, 'print_headline': 'Bacharach Musical To Open in San Diego', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Bacharach, Burt', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-05-08T22:31:47+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Theater', 'byline': {'original': 'Compiled by Rachel Lee Harris', 'person': [{'firstname': 'Rachel', 'middlename': 'Lee', 'lastname': 'Harris', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/31c22659-8d1d-536f-a087-46f19033a799', 'word_count': 132, 'uri': 'nyt://article/31c22659-8d1d-536f-a087-46f19033a799'}, {'abstract': '“Thor,” a thundering big-screen debut for the comic-book realm’s god of thunder, was No. 1 at North American theaters over the weekend.', 'web_url': 'https://www.nytimes.com/2011/05/09/movies/thor-shows-box-office-muscle.html', 'snippet': '“Thor,” a thundering big-screen debut for the comic-book realm’s god of thunder, was No. 1 at North American theaters over the weekend.', 'lead_paragraph': 'Marvel did it again: “Thor,” a thundering big-screen debut for the comic-book realm’s god of thunder, played by Chris Hemsworth, right, was No. 1 at North American theaters over the weekend with an estimated $66 million in ticket sales. Imax theaters, showing their might with the fan-boy audience, contributed a notable 10 percent of that total. “Thor” (produced by Disney-owned Marvel for about $150 million and distributed by Paramount Pictures) has taken in an additional $176 million overseas. “Fast Five” (Universal Pictures) dropped 62 percent in its second weekend to second place, taking in about $32.5 million for a new total of about $140 million, according to Hollywood.com, which compiles box-office statistics. “Jumping the Broom” (Sony Pictures Entertainment) was third with a stronger-than-expected $13.7 million. “Something Borrowed,” a romantic comedy from Warner Brothers, was fourth with about $13.2 million. “Rio” (20th Century Fox) chugged along in fifth place, selling about $8.2 million in tickets for a four-week total of $114.9 million. “The Beaver,” representing Mel Gibson’s first film since his domestic meltdown and Jodie Foster’s third attempt at directing, was essentially ignored, taking in $104,000 in 22 theaters.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '‘Thor’ Shows Box-Office Muscle', 'kicker': 'Arts, Briefly', 'content_kicker': None, 'print_headline': '‘Thor’ Shows Box-Office Muscle', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-05-08T22:32:33+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Movies', 'byline': {'original': 'By Brooks Barnes', 'person': [{'firstname': 'Brooks', 'middlename': None, 'lastname': 'Barnes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/78a65488-efe1-54b9-9c3f-d7752afd27ac', 'word_count': 200, 'uri': 'nyt://article/78a65488-efe1-54b9-9c3f-d7752afd27ac'}, {'abstract': 'The technology colossus will spend the near future trying to gather momentum again. An analyst says the changes will take years.', 'web_url': 'https://www.nytimes.com/2011/05/09/technology/09cisco.html', 'snippet': 'The technology colossus will spend the near future trying to gather momentum again. An analyst says the changes will take years.', 'lead_paragraph': 'SAN FRANCISCO — John T. Chambers, one of the best salesmen in Silicon Valley, has been having trouble selling anyone on his company’s future.', 'print_section': 'B', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/09/business/CISCO/CISCO-jumbo.jpg', 'height': 887, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/09/business/CISCO/CISCO-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/09/business/CISCO/CISCO-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Contrite Cisco Regroups Before Skeptical Wall St.', 'kicker': None, 'content_kicker': None, 'print_headline': 'Contrite Cisco Regroups Before Skeptical Wall St.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Chambers, John T', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Telephones and Telecommunications', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Cisco Systems Inc', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Executives and Management', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-05-08T22:34:52+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'byline': {'original': 'By Verne G. Kopytoff', 'person': [{'firstname': 'Verne', 'middlename': 'G.', 'lastname': 'Kopytoff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4c108742-c38e-57b4-9b7b-342d21124032', 'word_count': 1078, 'uri': 'nyt://article/4c108742-c38e-57b4-9b7b-342d21124032'}, {'abstract': 'Simon & Schuster has created a Facebook app called Book Battle, a literary version of hotornot.com.', 'web_url': 'https://www.nytimes.com/2011/05/09/books/books-to-square-off-on-a-facebook-app.html', 'snippet': 'Simon & Schuster has created a Facebook app called Book Battle, a literary version of hotornot.com.', 'lead_paragraph': 'Simon & Schuster has created a Facebook app called Book Battle, a literary version of hotornot.com. Users can vote on book covers, games, authors or characters, which will be presented in slide-show format. The app could give the publisher the opportunity to gauge readers’ preferences, drum up interest in its books and build a presence in social media. The first matchups on the app will feature two young-adult series by Cassandra Clare, “The Mortal Instruments” and “The Infernal Devices,” the publisher said on Sunday.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Books to Square Off on a Facebook App', 'kicker': 'Arts, Briefly', 'content_kicker': None, 'print_headline': 'Books to Square Off On a Facebook App', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Social Networking (Internet)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Simon & Schuster Inc', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-05-08T22:35:42+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By Julie Bosman', 'person': [{'firstname': 'Julie', 'middlename': None, 'lastname': 'Bosman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/e4c9e897-98c2-5de0-941e-e4abfbafd25f', 'word_count': 84, 'uri': 'nyt://article/e4c9e897-98c2-5de0-941e-e4abfbafd25f'}, {'abstract': 'Jason Terry scored 32 points and the Mavericks swept the Lakers and ended Phil Jackson’s championship-laden coaching career.', 'web_url': 'https://www.nytimes.com/2011/05/09/sports/basketball/09mavericks.html', 'snippet': 'Jason Terry scored 32 points and the Mavericks swept the Lakers and ended Phil Jackson’s championship-laden coaching career.', 'lead_paragraph': 'DALLAS — Phil Jackson took the final stroll alone. His players rushed in front of him and into an off-season of scrutiny and uncertainty. His faithful assistants — Frank Hamblen, Brian Shaw and Jim Cleamons — paced behind him. Away from the court and in the concrete maze in the depths of the American Airlines Center, Jackson cracked a smile, the calm in the storm, during his walk toward retirement Sunday. ', 'print_section': 'D', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/09/sports/ymavericks/ymavericks-jumbo.jpg', 'height': 891, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/09/sports/ymavericks/ymavericks-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/09/sports/ymavericks/ymavericks-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Exit for Jackson Comes Sooner Than Expected', 'kicker': 'Playoffs | Mavericks 122, Lakers 86', 'content_kicker': None, 'print_headline': 'Exit for Jackson Comes Sooner Than Expected', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Basketball', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Dallas Mavericks', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Terry, Jason', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Los Angeles Lakers', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Playoff Games', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Coaches and Managers', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Jackson, Phil', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-05-08T22:39:01+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Basketball', 'byline': {'original': 'By Jonathan Abrams', 'person': [{'firstname': 'Jonathan', 'middlename': None, 'lastname': 'Abrams', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3c1966fc-c95a-50b1-8a5d-e2a2360ef127', 'word_count': 944, 'uri': 'nyt://article/3c1966fc-c95a-50b1-8a5d-e2a2360ef127'}, {'abstract': 'Susan F. Martin’s book “A Nation of Immigrants” argues that the United States has historically favored immigration more consistently than it has immigrants.', 'web_url': 'https://www.nytimes.com/2011/05/09/books/a-nation-of-immigrants-susan-f-martins-book.html', 'snippet': 'Susan F. Martin’s book “A Nation of Immigrants” argues that the United States has historically favored immigration more consistently than it has immigrants.', 'lead_paragraph': 'WASHINGTON — So deeply has the phrase “a nation of immigrants” seeped into the American psyche that millions of people reflexively use it while few know who coined the phrase. (It was Senator John F. Kennedy, in a 1958 book by that name.)', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/09/arts/JPIMMIG/JPIMMIG-jumbo.jpg', 'height': 1024, 'width': 653, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Favoring Immigration if Not the Immigrant', 'kicker': None, 'content_kicker': None, 'print_headline': 'Favoring Immigration If Not the Immigrant', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-05-08T22:39:58+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By Jason DeParle', 'person': [{'firstname': 'Jason', 'middlename': None, 'lastname': 'DeParle', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dafd7502-de49-5d4c-9f2b-cb588b2d20a5', 'word_count': 1093, 'uri': 'nyt://article/dafd7502-de49-5d4c-9f2b-cb588b2d20a5'}, {'abstract': 'Photos from the production at the Metropolitan Opera.', 'web_url': 'https://www.nytimes.com/slideshow/2011/05/09/arts/music/20110509-ariadne.html', 'snippet': 'Photos from the production at the Metropolitan Opera.', 'lead_paragraph': 'Photos from the production at the Metropolitan Opera.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/09/arts/music/20110509-ariadne-slide-D2KA/20110509-ariadne-slide-D2KA-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/09/arts/music/20110509-ariadne-slide-D2KA/20110509-ariadne-slide-D2KA-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard