t one.', 'print_section': 'A', 'print_page': '23A', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/08/us/08CNCCALM2/08CNCCALM2-jumbo.jpg', 'height': 678, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/08/us/08CNCCALM2/08CNCCALM2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/08/us/08CNCCALM2/08CNCCALM2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Culture of Calm Is Threatened by Budget Cuts', 'kicker': 'Chicago News Cooperative', 'content_kicker': None, 'print_headline': 'Culture of Calm Is Threatened by Budget Cuts', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Education (K-12)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Huberman, Ron', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'School Discipline (Students)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Albert, Derrion', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Chicago (Ill)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Duncan, Arne', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-05-09T01:00:22+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Rebecca Vevea', 'person': [{'firstname': 'Rebecca', 'middlename': None, 'lastname': 'Vevea', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/817fb2cc-4bec-5ba4-9423-354c967acb03', 'word_count': 1165, 'uri': 'nyt://article/817fb2cc-4bec-5ba4-9423-354c967acb03'}, {'abstract': 'There is pressure to declassify thousands of secret files detailing the post-Nazi life of Adolf Eichmann.', 'web_url': 'https://www.nytimes.com/2011/05/09/arts/anniversary-of-adolf-eichmanns-trial-sheds-light-on-postwar-germany.html', 'snippet': 'There is pressure to declassify thousands of secret files detailing the post-Nazi life of Adolf Eichmann.', 'lead_paragraph': 'BERLIN — Germany is famous for confronting its Nazi past. But confronting the years after the war is another matter. The latest proof comes as the country’s foreign intelligence agency, the BND, refuses to declassify several thousand secret files detailing what Adolf Eichmann, the high-ranking Nazi who helped orchestrate the Holocaust, was doing between 1945 and his capture by Mossad agents in Buenos Aires in 1960. More than a few Germans have been speculating that the refusal has as much to do with tarnishing a cherished era as with betraying potential sources.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/09/arts/jp-eichmann/jp-eichmann-jumbo.jpg', 'height': 696, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/09/arts/jp-eichmann/jp-eichmann-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/09/arts/jp-eichmann/jp-eichmann-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': '50 Years After Trial, Eichmann Secrets Live On', 'kicker': 'Abroad', 'content_kicker': None, 'print_headline': '50 Years After Trial, Eichmann Secrets Live On', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Germany', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'War Crimes, Genocide and Crimes Against Humanity', 'rank': 2, 'major':