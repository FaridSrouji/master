er “Mickey Mouse hands.”', 'print_section': 'D', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/28/sports/indy-car-1/indy-car-1-articleLarge.jpg', 'height': 365, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/28/sports/indy-car-1/indy-car-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 365}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/28/sports/indy-car-1/indy-car-1-jumbo.jpg', 'height': 693, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/28/sports/indy-car-1/indy-car-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/28/sports/indy-car-1/indy-car-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Lasting Choice in a Sport of Split-Second Decisions', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Lasting Choice in a Sport Full of Split-Second Decisions', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Indianapolis 500 (Auto Race)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Sports Injuries', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'De Silvestro, Simona', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Automobile Racing', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-05-28T00:53:56+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Auto Racing', 'byline': {'original': 'By Dave Caldwell', 'person': [{'firstname': 'Dave', 'middlename': None, 'lastname': 'Caldwell', 'qualifier': None, 'title': None, 'role': 'reported', 'organiz