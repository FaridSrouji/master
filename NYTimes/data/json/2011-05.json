_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/31/world/31mladic_cnd/31mladic_cnd-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/31/world/31mladic_cnd/31mladic_cnd-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/31/world/31mladic_cnd/31mladic_cnd-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/31/world/31mladic_cnd/31mladic_cnd-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/31/world/31mladic_cnd/31mladic_cnd-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Mladic Appeals Extradition on Health Grounds', 'kicker': 'World Briefing | Europe', 'content_kicker': None, 'print_headline': 'Serbia: War Crime Suspect Appeals', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Mladic, Ratko', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'War Crimes, Genocide and Crimes Against Humanity', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Extradition', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'International Criminal Tribunal for the former Yugoslavia', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Serbia', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-05-30T18:06:46+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Doreen Carvajal', 'person': [{'firstname': 'Doreen', 'middlename': None, 'lastname': 'Carvajal', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5172d144-44e1-5bf7-bec4-30cf923ba70d', 'word_count': 372, 'uri': 'nyt://article/5172d144-44e1-5bf7-bec4-30cf923ba70d'}, {'abstract': 'Gael Monfils used his backhand consistently to hold off David Ferrer in their French Open match Monday.', 'web_url': 'https://straightsets.blogs.nytimes.com/2011/05/30/the-difference-maker-monfilss-backhand/', 'snippet': 'Gael Monfils used his backhand consistently to hold off David Ferrer in their French Open match Monday.', 'lead_paragraph': 'Gael Monfils won the first set over David Ferrer with remarkably consistent play off the backhand side. It was clear from the outset that Ferrer was going to work over the Monfils backhand, trying to break down the shot with a relentless assault. Monfils was ready, however, and played patiently with a high shot tolerance to thwart the Spaniard’s opening tactics. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Difference-Maker: Monfils’s Backhand', 'kicker': 'Straight Sets', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Monfils, Gael', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'French Open (Tennis)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Tennis', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Ferrer, David', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-05-30T18:17:08+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By Geoff Macdonald', 'person': [{'firstname': 'Geoff', 'middlename': None, 'lastname': 'Macdonald', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c1420b6b-5b9c-5ed6-9878-b74ee75ecdd6', 'word_count': 167, 'uri': 'nyt://article/c1420b6b-5b9c-5ed6-9878-b74ee75ecdd6'}, {'abstract': '“The Hangover Part II” has led the way at North American theaters for this Memorial Day weekend. But attendance is still down for the year.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/05/30/box-office-welcomes-another-hangover/', 'snippet': '“The Hangover Part II” has led the way at North American theaters for this Memorial Day weekend. But attendance is still down for the year.', 'lead_paragraph': '“The Hangover Part II” has sold about $137.4 million in tickets since opening in North American theaters on Thursday, according to results compiled by Hollywood.com. That performance — the biggest debut for a live-action comedy and the strongest opening for an R-rated comedy — helped drive robust business for the Memorial Day weekend.Audiences for the top 12 films over the four-day weekend spent about $272.8 million on tickets, up 48 percent from the same period last year. (The figures were not adjusted for inflation or to account for 3-D and Imax ticket prices.)', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Box Office Welcomes Another ‘Hangover’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-05-30T18:21:29+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Felicia R. Lee', 'person': [{'firstname': 'Felicia', 'middlename': 'R.', 'lastname': 'Lee', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/146a92e8-14d8-505f-9f4a-0519c679c068', 'word_count': 226, 'uri': 'nyt://article/146a92e8-14d8-505f-9f4a-0519c679c068'}, {'abstract': 'The president of FIFA deflected many questions during an often contentious 30-minute news conference that centered on recent suspensions handed down by the group’s ethics committee.', 'web_url': 'https://www.nytimes.com/2011/05/31/sports/soccer/blatter-sidesteps-tough-questions.html', 'snippet': 'The president of FIFA deflected many questions during an often contentious 30-minute news conference that centered on recent suspensions handed down by the group’s ethics committee.', 'lead_paragraph': 'Sepp Blatter, the embattled president of FIFA, endured more than 30 minutes of questions, many of which he deflected, during an often contentious news conference Monday in Zurich.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/31/sports/soccer/31blatterpix/31blatterpix-jumbo.jpg', 'height': 734, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/31/sports/soccer/31blatterpix/31blatterpix-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/31/sports/soccer/31blatterpix/31blatterpix-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Blatter Sidesteps Tough Questions', 'kicker': None, 'content_kicker': None, 'print_headline': 'Blatter Sidesteps Tough Questions', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Ethics (Institutional)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'International Federation of Association Football (FIFA)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Blatter, Sepp', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Soccer', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-05-30T18:29:28+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name':