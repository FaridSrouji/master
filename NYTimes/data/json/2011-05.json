ene', 'kicker': 'The Bay Citizen', 'content_kicker': None, 'print_headline': 'A Havana Connection Infuses the Music Scene', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Festivals', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Cuba', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'San Francisco Bay Area (Calif)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Salsa Dancing', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-05-20T00:53:21+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Reyhan Harmanci', 'person': [{'firstname': 'Reyhan', 'middlename': None, 'lastname': 'Harmanci', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b14492bc-566c-50a6-8c42-82802f0735fe', 'word_count': 821, 'uri': 'nyt://article/b14492bc-566c-50a6-8c42-82802f0735fe'}, {'abstract': 'Falling sales and rising costs have an effect on the first quarter for Sears and Gap,', 'web_url': 'https://www.nytimes.com/2011/05/20/business/20shop.html', 'snippet': 'Falling sales and rising costs have an effect on the first quarter for Sears and Gap,', 'lead_paragraph': 'Sears Holdings, the department store chain, swung to a first-quarter loss as shoppers cut back on spending.', 'print_section': 'B', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/20/business/Shop/Shop-jumbo.jpg', 'height': 710, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Retailers Fall Short as Shoppers Cut Back', 'kicker': None, 'content_kicker': None, 'print_headline': 'Retailers Fall Short as Shoppers Cut Back', 'name': None, 'seo': None