-jp-schiavone/y-jp-schiavone-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/24/sports/y-jp-schiavone/y-jp-schiavone-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'For Schiavone, Taste of Limelight Has Lingered', 'kicker': None, 'content_kicker': None, 'print_headline': 'For Schiavone, Taste of Limelight Has Lingered', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'French Open (Tennis)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Tennis', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Oudin, Melanie', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Schiavone, Francesca', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-05-23T14:39:09+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By John Branch', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Branch', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8411df04-0bf4-57ed-ae92-e123196442fb', 'word_count': 1012, 'uri': 'nyt://article/8411df04-0bf4-57ed-ae92-e123196442fb'}, {'abstract': 'New York City Opera has announced it is leaving Lincoln Center for undetermined locations in New York City next season.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/05/23/where-should-new-york-city-opera-go/', 'snippet': 'New York City Opera has announced it is leaving Lincoln Center for undetermined locations in New York City next season.', 'lead_paragraph': 'New York City Opera has announced that it is leaving Lincoln Center for undetermined locations in New York City next season. It has yet to announce what operas it will perform, or where, leaving an opening for readers to make suggestions. The organization did indicate some parameters: three of the operas will be suitable for a larger house, and two for smaller spaces. Already, reader e-mail to The New York Times has raised the Brooklyn Academy of Music as a fine potential home. What do you think of the decision to leave Lincoln Center? Where should City Opera go?', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Where Should New York City Opera Go?', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Opera', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York City Opera', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-05-23T14:41:51+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Daniel J. Wakin', 'person': [{'firstname': 'Daniel', 'middlename': 'J.', 'lastname': 'Wakin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/2f9ed43c-386d-5214-99d3-7b06b91b630b', 'word_count': 99, 'uri': 'nyt://article/2f9ed43c-386d-5214-99d3-7b06b91b630b'}, {'abstract': 'A Frenchman ranked No. 140 defeated the sixth seed in the French Open’s biggest upset so far.', 'web_url': 'https://straightsets.blogs.nytimes.com/2011/05/23/berdych-is-stunned-in-the-first-round/', 'snippet': 'A Frenchman ranked No. 140 defeated the sixth seed in the French Open’s biggest upset so far.', 'lead_paragraph': 'PARIS — Tomas Berdych, who rode his power game to the semifinals of the 2010 French Open, became the first high-seeded victim of this year’s tournament.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Qualifier Surprises Berdych, to Home Crowd’s Delight', 'kicker': 'Straight Sets', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': 