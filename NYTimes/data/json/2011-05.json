alifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/a8823a14-0342-5c56-9552-9d2e3e585cc2', 'word_count': 564, 'uri': 'nyt://article/a8823a14-0342-5c56-9552-9d2e3e585cc2'}, {'abstract': 'The chairman of the Senate Budget Committee, Kent Conrad, announced Thursday that the panel would indefinitely defer work on a budget for the coming fiscal year.', 'web_url': 'https://www.nytimes.com/2011/05/20/us/20brfs-SENATECOMMIT_BRF.html', 'snippet': 'The chairman of the Senate Budget Committee, Kent Conrad, announced Thursday that the panel would indefinitely defer work on a budget for the coming fiscal year.', 'lead_paragraph': 'The chairman of the Senate Budget Committee, Kent Conrad, announced Thursday that the panel would indefinitely defer work on a budget for the coming fiscal year. Mr. Conrad said the size of the projected annual deficits and the divisions between the two parties argued for awaiting the results of the bipartisan talks between Vice President Joseph R. Biden Jr. and Congressional leaders of both parties. All 11 Republicans on the Senate Budget Committee issued a statement criticizing the budget delay. ', 'print_section': 'A', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Washington: Senate Committee to Defer Budget Talks', 'kicker': 'National Briefing | WASHINGTON', 'content_kicker': None, 'print_headline': 'Senate Committee to Defer Budget Talks', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Budgets and Budgeting', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Conrad, Kent', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate Committee on the Budget', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-05-20T00:52:07+0000', 'document_type': 'article', 'n