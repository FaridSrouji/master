: 'nyt://article/3772b50c-7e76-5d06-9662-56d86f21f1c3'}, {'abstract': 'The mayor is taking on the teachers’ union amid an incendiary debate over the impact of public employees’ benefits and protections.', 'web_url': 'https://www.nytimes.com/2011/05/07/nyregion/bloombergs-planned-teacher-layoffs-imperil-his-legacy.html', 'snippet': 'The mayor is taking on the teachers’ union amid an incendiary debate over the impact of public employees’ benefits and protections.', 'lead_paragraph': 'Mayor Michael R. Bloomberg’s threats of teacher layoffs have had a ring of déjà vu. He used the same threat last year to squeeze more money from the federal government and to press his case for abolishing the state law that protects the most senior teachers from losing their jobs.', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/07/nyregion/TEACHERS/TEACHERS-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/07/nyregion/TEACHERS/TEACHERS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/07/nyregion/TEACHERS/TEACHERS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Looming Layoffs at Schools Imperil Bloomberg’s Legacy', 'kicker': 'News Analysis', 'content_kicker': None, 'print_headline': 'Looming Layoffs at Schools Imperil Mayor’s Legacy', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Teachers and School Employees', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bloomberg, Michael R', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Performance Evaluations (Labor)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Seniority Systems', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Layoffs and Job Reductions', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Mulgrew, Michael', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'United Federation of Teachers', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Organized Labor', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'Government Employees', 'rank': 10, 'major': 'N'}], 'pub_date': '2011-05-07T02:03:14+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Fernanda Santos and Sharon Otterman', 'person': [{'firstname': 'Fernanda', 'middlename': None, 'lastname': 'Santos', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Sharon', 'middlename': None, 'lastname': 'Otterman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News Analysis', '_id': 'nyt://article/ff030977-7159-523f-ac4f-ea360d50bf01', 'word_count': 912, 'uri': 'nyt://article/ff030977-7159-523f-ac4f-ea360d50bf01'}, {'abstract': 'The $65.7 billion proposal includes cutting 5 percent of the city’s schoolteachers, as well as other municipal jobs.', 'web_url': 'https://www.nytimes.com/2011/05/07/nyregion/bloomberg-budget-calls-for-teacher-layoffs.html', 'snippet': 'The $65.7 billion proposal includes cutting 5 percent of the city’s schoolteachers, as well as other municipal jobs.', 'lead_paragraph': 'Mayor Michael R. Bloomberg proposed on Friday to lay off 5,400 New York City workers, including 5 percent of all schoolteachers, in what would be the first significant city job cuts in two decades.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': '