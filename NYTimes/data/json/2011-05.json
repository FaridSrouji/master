uri': 'nyt://article/de4a6212-879d-56d6-81f2-10c3d564c53e'}, {'abstract': 'Video-on-demand technology has become a balancing act for executives weighing how to offer more programming without threatening traditional ad revenue.', 'web_url': 'https://www.nytimes.com/2011/05/02/business/media/02episodes.html', 'snippet': 'Video-on-demand technology has become a balancing act for executives weighing how to offer more programming without threatening traditional ad revenue.', 'lead_paragraph': 'Television viewers who miss their favorite show or want to check out the buzz surrounding a new series are increasingly turning to video-on-demand, whether on television sets, computers or tablets like the iPad. But the growing technology has created a balancing act for broadcast and cable executives weighing how to offer more programming without threatening traditional ad dollars and syndication rights.', 'print_section': 'B', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/02/business/02episodes1/02episodes1-jumbo.jpg', 'height': 762, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/02/business/02episodes1/02episodes1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/02/business/02episodes1/02episodes1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'On-Demand Viewing Poses a Test for Broadcasters', 'kicker': None, 'content_kicker': None, 'print_headline': 'On-Demand Viewing Poses a Test for Broadcasters', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cable Television', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 2,