Times', 'multimedia': [], 'headline': {'main': 'The Morning Line: All About Animal Kingdom', 'kicker': 'The Rail', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-05-28T20:32:13+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'byline': {'original': 'By Bennett Liebman', 'person': [{'firstname': 'Bennett', 'middlename': None, 'lastname': 'Liebman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d0392b72-f074-5414-aa71-2d1a0d726082', 'word_count': 699, 'uri': 'nyt://article/d0392b72-f074-5414-aa71-2d1a0d726082'}, {'abstract': 'Can a woman who made it in a man’s world go to a man’s world and make it safe for women?', 'web_url': 'https://www.nytimes.com/2011/05/29/opinion/29dowd.html', 'snippet': 'Can a woman who made it in a man’s world go to a man’s world and make it safe for women?', 'lead_paragraph': 'PARIS', 'print_section': 'WK', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/maureen-dowd/maureen-dowd-articleLarge.png', 'height': 300, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/02/opinion/maureen-dowd/maureen-dowd-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 300}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/maureen-dowd/maureen-dowd-jumbo.png', 'height': 512, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/maureen-dowd/maureen-dowd-superJumbo.png', 'height': 1000, 'width': 2000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy':