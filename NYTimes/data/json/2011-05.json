imedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/27/arts/27Tipsy-span/JPTipsy2-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/27/arts/27Tipsy-span/JPTipsy2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/27/arts/27Tipsy-span/JPTipsy2-jumbo.jpg', 'height': 692, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/27/arts/27Tipsy-span/JPTipsy2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/27/arts/27Tipsy-span/JPTipsy2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Cocktails With a Beer Buzz', 'kicker': 'The Tipsy Diaries', 'content_kicker': None, 'print_headline': 'Cocktails With a Beer Buzz', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cocktails', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Rosa Mexicano', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'ALCOHOLIC BEVERAGES', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Summer (Season)', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-05-26T21:14:59+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Food', 'byline': {'original': 'By Frank Bruni', 'person': [{'firstname': 'Frank', 'middlename': None, 'lastname': 'Bruni', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7f8bde73-702a-5359-aef8-7a74314ca811', 'word_count': 1283, 'uri': 'nyt://article/7f8bde73-702a-5359-aef8-7a74314ca811'}, {'abstract': 'While Roy Halladay has pitched to expectations, Cole Hamels, not Cliff Lee, has emerged as the team’s second most valuable pitcher.', 'web_url': 'https://bats.blogs.nytimes.com/2011/05/26/keeping-score-among-phillies-four-aces-a-surprising-big-two/', 'snippet': 'While Roy Halladay has pitched to expectations, Cole Hamels, not Cliff Lee, has emerged as the team’s second most valuable pitcher.', 'lead_paragraph': 'When the Philadelphia Phillies added Cliff Lee to a formidable group of starters that included Roy Halladay, Roy Oswalt and Cole Hamels, pundits wasted no time predicting greatness for the team’s 2011 rotation.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Keeping Score: Among Phillies’ Four Aces, a Surprising Big Two', 'kicker': 'Bats', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Halladay, Roy', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Hamels, Cole', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Lee, Cliff', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Oswalt, Roy', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Philadelphia Phillies', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-05-26T21:15:13+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By NEIL PAINE', 'person': [{'firstname': 'Neil', 'middlename': None, 'lastname': 'PAINE', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/274938dc-cf66-57ec-8805-97565ebe5312', 'word_count': 556, 'uri': 'nyt://article/274938dc-cf66-57ec-8805-97565ebe5312'}, {'abstract': 'A selected guide to pop, rock and folk acts in New York and the area.', 'web_url': 'https://www.nytimes.com/2011/05/27/arts/music/pop-and-rock-listings-for-may-27-june-2.html', 'snippet': 'A selected guide to pop, rock and folk acts in New York and the area.', 'lead_paragraph': 'Pop', 'print_section': 'C', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Pop and Rock Listings for May 27-June 2', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Listings', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Guitars', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Nineteen Hundred Sixties', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-05-26T21:15:45+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/57d7d37e-f56d-5480-8408-d713c448f701', 'word_count': 1121, 'uri': 'nyt://article/57d7d37e-f56d-5480-8408-d713c448f701'}, {'abstract': 'A selected guide to jazz performances in New York.', 'web_url': 'https://www.nytimes.com/2011/05/27/arts/music/jazz-listings-for-may-27-june-2.html', 'snippet': 'A selected guide to jazz performances in New York.', 'lead_paragraph': 'Jazz', 'print_section': 'C', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Jazz Listings for May 27-June 2', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Listings', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'NIGHTCLUBS AND CABARETS', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-05-26T21:17:48+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/65c99b1b-a65b-567e-af46-b8668cabc58f', 'word_count': 2396, 'uri': 'nyt://article/65c99b1b-a65b-567e-af46-b8668cabc58f'}, {'abstract': 'Fresh signs of weakness in hiring and consumer spending suggest that policy makers may be too optimistic about the pace of recovery.', 'web_url': 'https://www.nytimes.com/2011/05/27/business/economy/27leonhardt.html', 'snippet': 'Fresh signs of weakness in hiring and consumer spending suggest that policy makers may be too optimistic about the pace of recovery.', 'lead_paragraph': 'The latest economic numbers have not been good. Jobless claims rose last week, the Labor Department said on Thursday. Another report showed that economic growth at the start of the year was no faster than the Commerce Department initially reported — “a real surprise,” said Ian Shepherdson of High Frequency Economics. ', 'print_section': 'B', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2010/04/19/business/leonhardt-75/leonhardt-75-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2010/04/19/business/leonhardt-75/leonhardt-75-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'The Economy Is Wavering. Does Washington Notice?', 'kicker': 'Economic Scene', 'content_kicker': None, 'print_headline': 'The Economy Is Wavering. Is Washington Paying Attention?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Economy', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Labor and Jobs', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Economic Conditions and Trends', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-05-26T21:19:39+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By David Leonhardt', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Leonhardt', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b9f2ef54-1c9e-5c87-8070-871928c903a2', 'word_count': 878, 'uri': 'nyt://article/b9f2ef54-1c9e-5c87-8070-871928c903a2'}, {'abstract': 'RockLive, which builds popular iPhone applications for professional athletes, released a new version of the game Mike Tyson Main Event.', 'web_url': 'https://bits.blogs.nytimes.com/2011/05/26/building-apps-for-mike-tyson-and-other-big-names/', 'snippet': 'RockLive, which builds popular iPhone applications for professional athletes, released a new version of the game Mike Tyson Main Event.', 'lead_paragraph': 'John and Sam Shahidi, two brothers from California, were working in the satellite television business when they came up with the idea for RunPee, an iPhone application that helps moviegoers figure out the optimal time to go the bathroom in the middle of a movie.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Building Apps for Mike Tyson and Other Big Names', 'kicker': 'Bits', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Computer and Video Games', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mobile Applications', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Tyson, Mike', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-05-26T21:20:53+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By Nick Bilton', 'person': [{'firstname': 'Nick', 'middlename': None, 'lastname': 'Bilton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3a116d42-db62-506e-803a-131a67d0cb41', 'word_count': 440, 'uri': 'nyt://article/3a116d42-db62-506e-803a-131a67d0cb41'}, {'abstract': 'New York City Ballet presents a triple bill with music by Richard Rodgers, Duke Ellington and Leonard Bernstein.', 'web_url': 'https://www.nytimes.com/2011/05/27/arts/dance/new-york-city-ballet-offers-broadway-triple-bill-review.html', 'snippet': 'New York City Ballet presents a triple bill with music by Richard Rodgers, Duke Ellington and Leonard Bernstein.', 'lead_paragraph': 'Ballet companies, like individual dancers, love to demonstrate how diverse they can be. So New York City Ballet, which began its six-week spring season with eight performances of high modernism (black-and-white costuming, no scenery, most of the music by Webern, Stravinsky and Hindemith), is now giving us a tribute to Broadway, with music by Richard Rodgers, Duke Ellington and Leonard Bernstein. ', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/27/arts/27NYCB/NYCB-jumbo.jpg', 'height': 1024, 'width': 966, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/27/arts/27NYCB/NYCB-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/27/arts/27NYCB/NYCB-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Ballet Meets Broadway Choreographers and Composers', 'kicker': 'Dance Review', 'content_kicker': None, 'print_headline': 'Ballet Meets Broadway Choreographers and Composers', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Robbins, Jerome', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Dancing', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Ellington, Duke', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Stroman, Susan', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'New York City Ballet', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Bernstein, Leonard', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-05-26T21:21:06+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Alastair Macaulay', 'person': [{'firstname': 'Alastair', 'middlename': None, 'lastname': 'Macaulay', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/1e560149-8236-5a16-ade5-eb1d41566b32', 'word_count': 945, 'uri': 'nyt://article/1e560149-8236-5a16-ade5-eb1d41566b32'}, {'abstract': 'The Mirror Visions Ensemble, centered on vocalists, performed pieces on Tuesday partly derived from works by the poets Edna St. Vincent Millay and Dana Gioia, among others.', 'web_url': 'https://www.nytimes.com/2011/05/27/arts/music/mirror-visions-ensemble-at-weill-recital-hall.html', 'snippet': 'The Mirror Visions Ensemble, centered on vocalists, performed pieces on Tuesday partly derived from works by the poets Edna St. Vincent Millay and Dana Gioia, among others.', 'lead_paragraph': 'Unlike most chamber music enterprises, the Mirror Visions Ensemble is run by singers rather than instrumentalists, and its programs are shaped with an ear to the poetry of song texts rather than to overarching notions of musical style. The group, directed by Tobé Malawista, a soprano, includes Scott Murphree, tenor; Jesse Blumberg, baritone; and Vira Slywotzky, soprano; with Margaret Kampmeier, the pianist, as its superb accompanist. ', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/27/arts/MIRROR/MIRROR-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/27/arts/MIRROR/MIRROR-articleLarge.jpg', 'xlargewidth