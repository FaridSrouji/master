: 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/17/world/LIBYA-FLOAT/LIBYA-FLOAT-articleLarge.jpg', 'height': 355, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/17/world/LIBYA-FLOAT/LIBYA-FLOAT-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 355}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/17/world/LIBYA-FLOAT/LIBYA-FLOAT-jumbo.jpg', 'height': 687, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/17/world/LIBYA-FLOAT/LIBYA-FLOAT-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/17/world/LIBYA-FLOAT/LIBYA-FLOAT-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Libyan Officials Threaten to Use ‘Human Shields’', 'kicker': None, 'content_kicker': None, 'print_headline': 'Libyan Officials Threaten To Use ‘Human Shields’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Civilian Casualties', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'North Atlantic Treaty Organization', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Middle East and North Africa Unrest (2010- )', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Qaddafi, Muammar el-', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Libya', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-05-17T00:18:56+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Africa', 'byline': {'original': 'By John F. Burns', 'person': [{'firstname': 'John', 'middlename': 'F.', 'lastname': 'Burns', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/41c0d0ae-3363-547f-8b54-d66faf8e7be9', 'word_count': 742, 'uri': 'nyt://article/41c0d0ae-3363-547f-8b54-d66faf8e7be9'}, {'abstract': 'President Obama is a millionaire with assets that could reach as high as $12 million, according to financial disclosure forms made public by the White House on Monday.', 'web_url': 'https://www.nytimes.com/2011/05/17/us/17brfs-OBAMAISAMILL_BRF.html', 'snippet': 'President Obama is a millionaire with assets that could reach as high as $12 million, according to financial disclosure forms made public by the White House on Monday.', 'lead_paragraph': 'President Obama is a millionaire with assets that could reach as high as $12 million, mostly from proceeds from his two best sellers, according to financial disclosure forms made public by the White House on Monday. The disclosures only require Mr. Obama and his wife, Michelle, to list the value of their assets in wide ranges. For example, the president lists royalties from “Dreams From My Father” as between $1 million and $5 million. Mr. Obama’s financial disclosures have largely remained the same since he took office in 2009. ', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Obama Is a Millionaire, Records Show', 'kicker': 'National Briefing | Washington', 'content_kicker': None, 'print_headline': 'Obama Is a Millionaire, Records Show', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Income', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-05-17T00:19:21+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Michael D. Shear', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', '