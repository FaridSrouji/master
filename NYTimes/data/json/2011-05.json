s', 'value': 'Corp for Public Broadcasting', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Public Broadcasting Service', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-05-08T22:57:55+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Elizabeth Jensen', 'person': [{'firstname': 'Elizabeth', 'middlename': None, 'lastname': 'Jensen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/47754b25-8cf5-538a-8b1c-96a9dc1eb04f', 'word_count': 308, 'uri': 'nyt://article/47754b25-8cf5-538a-8b1c-96a9dc1eb04f'}, {'abstract': 'Postgame reaction after Manchester United essentially won the Premier League title with a 2-1 victory over Chelsea at Old Trafford.', 'web_url': 'https://goal.blogs.nytimes.com/2011/05/08/reaction-to-manchester-united-chelsea/', 'snippet': 'Postgame reaction after Manchester United essentially won the Premier League title with a 2-1 victory over Chelsea at Old Trafford.', 'lead_paragraph': 'Manchester United essentially won the Premier League title on Sunday, stunning Chelsea with a first-minute goal by Javier Hernandez and holding on to win, 2-1. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Reaction to Manchester United-Chelsea', 'kicker': 'Goal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Soccer', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Ancelotti, Carlo', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Ferguson, Alex', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Chelsea Football Club', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'English Premier League', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Manchester United', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-0