'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/3a4449f5-4278-5ab0-b0eb-f533295e72a7', 'word_count': 236, 'uri': 'nyt://article/3a4449f5-4278-5ab0-b0eb-f533295e72a7'}, {'abstract': 'Marriott, Langham, Oberoi and other hotels are rolling out summer discounts for families.', 'web_url': 'https://intransit.blogs.nytimes.com/2011/05/20/hotels-pitch-savings-for-family-vacations/', 'snippet': 'Marriott, Langham, Oberoi and other hotels are rolling out summer discounts for families.', 'lead_paragraph': 'With summer approaching, many parents are planning family vacations. And just in time, some hotels are offering specials for travelers with children.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Hotels Pitch Savings for Family Vacations', 'kicker': 'In Transit', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Children and Youth', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'HOTELS AND MOTELS', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Fairmont Hotels and Resorts', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Oberoi Hotel (Mumbai)', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-05-20T15:24:20+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Travel', 'byline': {'original': 'By Shivani Vora', 'person': [{'firstname': 'Shivani', 'middlename': None, 'lastname': 'Vora', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/2e1f2247-4083-56ed-8c95-8f1818c8bcf9', 'word_count': 385, 'uri': 'nyt://article/2e1f2247-4083-56ed-8c95-8f1818c8bcf9'}, {'abstract': 'Exceptions will be made for development considered “vital to the nation,” like geothermal energy, oil, gas, electricity and land for rice and sugar cane.', 'web_url': 'https://green.blogs.nytimes.com/2011/05/20/on-our-radar-indonesia-signs-deal-to-protect-virgin-forests/', 'snippet': 'Exceptions will be made for development considered “vital to the nation,” like geothermal energy, oil, gas, electricity and land for rice and sugar cane.', 'lead_paragraph': 'Indonesia’s president signs a two-year moratorium on new logging concessions in the island nation’s still-prolific virgin forests, part of a $1 billion climate change deal with Norway intended to reduce carbon dioxide emissions from deforestation. Under the deal, more than 150 million acres of primary forest are expected to be protected. Indonesia “will not return to the past of unsustainable development practices,” a top environment adviser says. [The Jakarta Post]', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'On Our Radar: Indonesia Signs Deal to Protect Virgin Forests', 'kicker': 'Green', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-05-20T15:30:29+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Science', 'subsection_name': 'Environment', 'byline': {'original': 'By John Collins Rudolf', 'person': [{'firstname': 'John', 'middlename': 'Collins', 'lastname': 'Rudolf', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/a6ecd384-162b-5f5a-9cda-743488126682', 'word_count': 190, 'uri': 'nyt://article/a6ecd384-162b-5f5a-9cda-743488126682'}, {'abstract': 'Five Leaves, the Brooklyn cafe and bar, is about to expand its laid-back Aussie vibe with its new spot on Bedford Avenue.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2011/05/20/now-open-nights-and-weekends/', 'snippet': 'Five Leaves, the Brooklyn cafe and bar, is about to expand its laid-back Aussie vibe with its new spot on Bedford Avenue.', 'lead_paragraph': 'Five Leaves, the Brooklyn cafe and bar known for its ties to the late actor Heath Ledger (he discovered the space while skateboarding), is about to expand its laid-back Aussie vibe with its new spot, Nights and Weekends, located around the corner on Bedford Avenue. “I’m sort of spellbound by how the restaurant comes alive and becomes part of the street,” says Jud Mongell, one of several owners of the popular watering hole. On any given sunny day, hungry patrons pack the pavement in front of the cafe, which is across the street from McCarren Park. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Now Open | Nights and Weekends', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-05-20T15:30:42+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Stephanie La Cava', 'person': [{'firstname': 'Stephanie', 'middlename': None, 'lastname': 'La Cava', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/5aea7b32-9a6e-55f9-b936-8413db5f8f4a', 'word_count': 361, 'uri': 'nyt://article/5aea7b32-9a6e-55f9-b936-8413db5f8f4a'}, {'abstract': 'The French-born director of “Eternal Sunshine of the Spotless Mind” ultimately decided to head the festival’s short film jury to help get publicity for a D.I.Y. studio.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/05/20/michel-gondry-reluctant-cannes-judge/', 'snippet': 'The French-born director of “Eternal Sunshine of the Spotless Mind” ultimately decided to head the festival’s short film jury to help get publicity for a D.I.Y. studio.', 'lead_paragraph': 'CANNES, France — By his own admission, Michel Gondry is not really cut out to be a judge. “I’m against competition,” Mr. Gondry, the French-born director of “Eternal Sunshine of the Spotless Mind” and “The Green Hornet,” explained recently. This may present a challenge to his role as the president of the short film jury at the Cannes Film Festival here, where he is tasked with, you know, picking a winner.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Michel Gondry, Reluctant Cannes Judge', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cannes International Film Festival', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Gondry, Michel', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-05-20T15:33:03+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Melena Ryzik', 'person': [{'firstname': 'Melena', 'middlename': None, 'lastname': 'Ryzik', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/a95b5000-4ca3-56a5-acb2-5f5282b5a196', 'word_count': 806, 'uri': 'nyt://article/a95b5000-4ca3-56a5-acb2-5f5282b5a196'}, {'abstract': 'Sheepshead Bay, a busy area that is home to various ethnicities, retains a tranquillty, in part because of the water.', 'web_url': 'https://www.nytimes.com/interactive/2011/05/22/realestate/20110522liv_ss.html', 'snippet': 'Sheepshead Bay, a busy area that is home to various ethnicities, retains a tranquillty, in part because of the water.', 'lead_paragraph': 'Sheepshead Bay, a busy area that is home to various ethnicities, retains a tranquillty, in part because of the water.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Living In | Sheepshead Bay, Brooklyn', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'SHEEPSHEAD BAY (NYC)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Housing and Real Estate', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-05-20T15:33:26+0000', 'document_type': 'multimedia', 'news_desk': 'Real Estate', 'section_name': 'Real Estate', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/641db4f5-77fe-5299-9893-ad61c48e1337', 'word_count': 0, 'uri': 'nyt://interactive/641db4f5-77fe-5299-9893-ad61c48e1337'}, {'abstract': 'This Brooklyn neighborhood is, people who live there say, a hospitable place to raise a family and stay for decades, though it is both livelier and more crowded than it used to be.', 'web_url': 'https://www.nytimes.com/2011/05/22/realestate/calm-and-clamor-in-equal-measure-living-insheepshead-bay-brooklyn.html', 'snippet': 'This Brooklyn neighborhood is, people who live there say, a hospitable place to raise a family and stay for decades, though it is both livelier and more crowded than it used to be.', 'lead_paragraph': 'ON a sunny day, with a cool breeze blowing off the water and people sitting at sidewalk tables sipping tea from small glasses, Emmons Avenue in Sheepshead Bay, Brooklyn, could almost be in Istanbul — or even in the Ukrainian port city of Odessa. Which may explain why so many Turkish and Ukrainian immigrants have made themselves at home among the swirl of ethnicities in this rambling neighborhood at the city’s southern edge.', 'print_section': 'RE', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/22/realestate/living/living-articleLarge.jpg', 'height': 240, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/22/realestate/living/living-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 240}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/22/realestate/living/living-jumbo.jpg', 'height': 410, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/22/realestate/living/living-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/22/realestate/living/living-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Calm and Clamor, in Equal Measure', 'kicker': 'Living In | Sheepshead Bay, Brooklyn', 'content_kicker': None, 'print_headline': 'Calm and Clamor, in Equal Measure', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Housing and Real Estate', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'SHEEPSHEAD BAY (NYC)', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-05-20T15:33:53+0000', 'document_type': 'article', 'news_desk': 'RealEstate', 'section_name': 'Real Estate', 'byline': {'original': 'By Jake Mooney', 'person': [{'firstname': 'Jake', 'middlename': None, 'lastname': 'Mooney', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1e9784a5-ae37-51ee-8672-c2b8e9e27cba', 'word_count': 1537, 'uri': 'nyt://article/1e9784a5-ae37-51ee-8672-c2b8e9e27cba'}, {'abstract': 'The Mazda 2, which arrived in the United States late last year, is a useful four-door hatchback that is fun to drive. Actually, that’s its greatest strength.', 'web_url': 'https://www.nytimes.com/2011/05/22/automobiles/autoreviews/22WHEEL.html', 'snippet': 'The Mazda 2, which arrived in the United States late last year, is a useful four-door hatchback that is fun to drive. Actually, that’s its greatest strength.', 'lead_paragraph': 'A FRIEND recently asked me to recommend an economical, not altogether unattractive small car for his fiancée, whose Honda Fit was nearing the end of its lease. I have not met the lucky woman, but as her appointed car-geek counsel, I felt compelled to suggest a 1990 Subaru Loyale — roomy and good on gas, but about as pretty as a rust spot.', 'print_section': 'AU', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/22/automobiles/WHEE-2/WHEE-2-articleLarge.jpg', 'height': 315, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/22/automobiles/WHEE-2/WHEE-2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 315}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/22/automobiles/WHEE-2/WHEE-2-jumbo.jpg', 'height': 417, 'width': 794, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/22/automobiles/WHEE-2/WHEE-2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/22/automobiles/WHEE-2/WHEE-2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Its Footprint Is Small, but Its Chassis Is Classy', 'kicker': 'Behind the Wheel | 2011 Mazda 2', 'content_kicker': None, 'print_headline': 'Its Footprint Is Small But Its Chassis Is Classy', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Mazda Motor Corp', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Small Cars (Compact, Subcompact and Microcars)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Automobiles', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-05-20T15:37:11+0000', 'document_type': 'article', 'news_desk': 'Automobiles', 'section_name': 'Automobiles', 'subsection_name': 'New Cars', 'byline': {'original': 'By Jonathan Schultz', 'person': [{'firstname': 'Jonathan', 'middlename': None, 'lastname': 'Schultz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/3d195faa-9d21-59fa-a92d-e23beb8155af', 'word_count': 1156, 'uri': 'nyt://article/3d195faa-9d21-59fa-a92d-e23beb8155af'}, {'abstract': 'More than a century after the world’s first children’s museum opened in Brooklyn, the Bronx is finally catching up. Sort of.', 'web_url': 'https://cityroom.blogs.nytimes.com/2011/05/20/bronx-childrens-museum-rolls-out-and-we-do-mean-rolls/', 'snippet': 'More than a century after the world’s first children’s museum opened in Brooklyn, the Bronx is finally catching up. Sort of.', 'lead_paragraph': 'More than a century after the world’s first children’s museum opened in Brooklyn, the Bronx is finally catching up. Sort of.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Bronx Children’s Museum Rolls Out, in Bus Form', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Children and Youth', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Museums', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Bronx (NYC)', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-05-20T15:50:38+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Elissa Gootman', 'person': [{'firstname': 'Elissa', 'middlename': None, 'lastname': 'Gootman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/ff95db21-882c-571b-8742-2025754ff176', 'word_count': 962, 'uri': 'nyt://article/ff95db21-882c-571b-8742-2025754ff176'}, {'abstract': 'Thousands of Syrians took to the streets in what appeared to be a dangerous turn in the uprising. Rights groups said 26 people were killed by security forces.', 'web_url': 'https://www.nytimes.com/2011/05/21/world/middleeast/21syria.html', 'snippet': 'Thousands of Syrians took to the streets in what appeared to be a dangerous turn in the uprising. Rights groups said 26 people were killed by security forces.', 'lead_paragraph': 'BEIRUT, Lebanon — Thousands of Syrians took to the streets in virtually every region of the country on Friday in what appeared to be a sign of new momentum and a potentially dangerous turn in the nine-week uprising. Activists said security forces killed at least 26 people and wounded hundreds.', 'print_section': 'A', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Syrian Protesters Defy Crackdown and Gain Momentum', 'kicker': None, 'content_kicker': None, 'print_headline': 'At Great Risk, Thousands Stage Protests Across Syria', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Syria', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Assad, Bashar al-', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Middle East and North Africa Unrest (2010- )', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-05-20T15:52:36+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Anthony Shadid', 'person': [{'firstname': 'Anthony', 'middlename': None, 'lastname': 'Shadid', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/78f1de75-8e9d-5ed6-a511-2b9608d4effd', 'word_count': 1128, 'uri': 'nyt://article/78f1de75-8e9d-5ed6-a511-2b9608d4effd'}, {'abstract': 'Andrew Lloyd Webber said he would donate nearly $52 million to arts organizations in his home country, using money raised from the sale of a Picasso painting last year.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/05/20/lloyd-webber-pledges-funds-from-picasso-sale-to-british-arts-groups/', 'snippet': 'Andrew Lloyd Webber said he would donate nearly $52 million to arts organizations in his home country, using money raised from the sale of a Picasso painting last year.', 'lead_paragraph': 'Apparently not content for musicals like “Evita,” “Phantom of the Opera” and “Starlight Express” to be his only gifts to posterity, Andrew Lloyd Webber has decided to make a more easily quantifiable contribution to British culture: he has said he will donate £32 million – nearly $52 million – to arts organizations in his home country, BBC News reported. The announcement comes at a time when the British government has drastically reduced its financial support of cultural institutions as part of a nationwide austerity program.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Lloyd Webber Pledges Funds From Picasso Sale to British Arts Groups', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Auctions', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Lloyd Webber, Andrew', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Picasso, Pablo', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': "Christie's", 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Great Britain', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-05-20T16:10:35+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Dave Itzkoff', 'person': [{'firstname': 'Dave', 'middlename': None, 'lastname': 'Itzkoff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/0907dda0-8a95-51e0-aa9c-512dadd65e26', 'word_count': 194, 'uri': 'nyt://article/0907dda0-8a95-51e0-aa9c-512dadd65e26'}, {'abstract': 'Central bankers and economists at a gathering in Europe said the financial contagion of the last decade could have been avoided.', 'web_url': 'https://economix.blogs.nytimes.com/2011/05/20/reflections-on-warnings-unheeded/', 'snippet': 'Central bankers and economists at a gathering in Europe said the financial contagion of the last decade could have been avoided.', 'lead_paragraph': 'FRANKFURT — Jamie Dimon, chief executive of JPMorgan Chase, famously said at Davos in January that he was tired of everybody always picking on banks. Good thing he wasn’t at the going-away event for Gertrude Tumpel-Gugerell, outgoing member of the executive board of the European Central Bank. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Reflections on Warnings Unheeded', 'kicker': 'Economix', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'European Central Bank', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-05-20T16:13:24+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Jack Ewing', 'person': [{'firstname': 'Jack', 'middlename': None, 'lastname': 'Ewing', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/0e0ad23e-121b-5e50-887f-068883bef54d', 'word_count': 445, 'uri': 'nyt://article/0e0ad23e-121b-5e50-887f-068883bef54d'}, {'abstract': 'The Rail’s contributors and a guest picker make their Preakness selections.', 'web_url': 'https://therail.blogs.nytimes.com/2011/05/20/our-preakness-picks-dont-sweat-weve-got-this/', 'snippet': 'The Rail’s contributors and a guest picker make their Preakness selections.', 'lead_paragraph': 'The Rail’s contributors welcome this year’s Preakness Stakes guest picker, Kevin Plank, the founder and chief executive of Under Armour, the Baltimore-based athletic apparel company. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Our Preakness Picks (Don’t Sweat, We’ve Got This)', 'kicker': 'The Rail', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-05-20T16:13:53+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': '', '_id': 'nyt://article/5143f3ec-2d31-57c6-bedd-b357678e2a28', 'word_count': 106, 'uri': 'nyt://article/5143f3ec-2d31-57c6-bedd-b357678e2a28'}, {'abstract': 'Cheapism offers bargain eating tips via the social check-in service Foursquare.', 'web_url': 'https://bucks.blogs.nytimes.com/2011/05/20/do-tips-on-nearby-bargains-outweigh-privacy-concerns/', 'snippet': 'Cheapism offers bargain eating tips via the social check-in service Foursquare.', 'lead_paragraph': 'Ever been in an unfamiliar neighborhood, hungry but without much cash in your pocket? That’s where Cheapism would like to come in. The Web site, which helps you find bargains and inexpensive products, is now offering a “location-based” version.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Do Tips on Nearby Bargains Outweigh Privacy Concerns?', 'kicker': 'Bucks', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Mobile Applications', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Privacy', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Restaurants', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Smartphones', 'r