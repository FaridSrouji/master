ct', 'value': 'Energy and Power', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Greenhouse Gas Emissions', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Wind Power', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Long Island Power Authority', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Long Island (NY)', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-05-18T16:44:44+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Science', 'subsection_name': 'Environment', 'byline': {'original': 'By Matthew L. Wald', 'person': [{'firstname': 'Matthew', 'middlename': 'L.', 'lastname': 'Wald', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/079785e1-18a2-54c7-b94b-7fee2c3d99a2', 'word_count': 593, 'uri': 'nyt://article/079785e1-18a2-54c7-b94b-7fee2c3d99a2'}, {'abstract': 'When Cleveland landed the top pick in the N.B.A. draft on Tuesday night, Duke point guard Kyrie Irving smiled knowingly.', 'web_url': 'https://www.nytimes.com/2011/05/19/sports/basketball/fate-hands-cavaliers-a-no-1-pick.html', 'snippet': 'When Cleveland landed the top pick in the N.B.A. draft on Tuesday night, Duke point guard Kyrie Irving smiled knowingly.', 'lead_paragraph': 'There is a salty New York flavor to the New Jersey narrative of Kyrie Irving, who made the 20-minute drive from his home in West Orange to the N.B.A. Entertainment studio in Secaucus on Tuesday night and landed with both feet inside a made-for-television draft lottery drama.', 'print_section': 'B', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/19/sports/basketball/19aratonpix4/19aratonpix4-jumbo.jpg', 'height': 1024, 'width': 882, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit