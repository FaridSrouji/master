icker': 'The Learning Network', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-05-27T08:48:17+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By Holly Epstein Ojalvo', 'person': [{'firstname': 'Holly', 'middlename': 'Epstein', 'lastname': 'Ojalvo', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d2b10268-7f3c-5811-992c-98485534dfa2', 'word_count': 62, 'uri': 'nyt://article/d2b10268-7f3c-5811-992c-98485534dfa2'}, {'abstract': 'Warren Cofield has spent every night for the past dozen years at Elaine’s, but he has never been inside; he has worked the door crowd, angling for tips.', 'web_url': 'https://cityroom.blogs.nytimes.com/2011/05/27/outside-elaines-another-closing/', 'snippet': 'Warren Cofield has spent every night for the past dozen years at Elaine’s, but he has never been inside; he has worked the door crowd, angling for tips.', 'lead_paragraph': 'Of all the folks who will be disappointed at the closing of Elaine’s, one must include Warren Cofield, 49, who has been as much a regular as anyone at the famous Second Avenue boîte, mingling among the swells.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Outside Elaine’s, Another Closing', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Kaufman, Elaine', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': "ELAINE'S", 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Upper East Side (NYC)', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-05-27T09:00:09+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Corey Kilgannon', 'person': [{'firstname': 'Corey', 'middlename': None, 'lastna