: 799, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/08/automobiles/TESLA/TESLA-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/08/automobiles/TESLA/TESLA-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Tesla Prepares for a Gap as Roadster Winds Down', 'kicker': 'Greentech', 'content_kicker': None, 'print_headline': 'Tesla Prepares for a Gap As Roadster Winds Down', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Tesla Motors', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Lotus Cars Ltd', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Automobiles', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Silicon Valley (Calif)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Electric Vehicles', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Musk, Elon', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-05-06T16:07:20+0000', 'document_type': 'article', 'news_desk': 'Automobiles', 'section_name': 'Automobiles', 'byline': {'original': 'By Josie Garthwaite', 'person': [{'firstname': 'Josie', 'middlename': None, 'lastname': 'Garthwaite', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3b3ed820-0091-56c7-ab01-aa59e371ff87', 'word_count': 628, 'uri': 'nyt://article/3b3ed820-0091-56c7-ab01-aa59e371ff87'}, {'abstract': 'The Microsoft co-founder Paul Allen charts his uneasy relationship with Bill Gates during the software giant’s early years.', 'web_url': 'https://www.nytimes.com/2011/05/08/books/review/book-review-idea-man-by-paul-allen.html', 'snippet': 'The Microsoft co-founder Paul Allen charts his uneasy relationship with Bill Gates during the software giant’s early years.', 'lead_paragraph': 'Pity Paul Allen. All those billions, but Microsoft’s “other” founder doesn’t receive the credit or respect he feels he deserves. Sure, those vast storehouses of cash Allen earned while he was still in his 20s have allowed him to buy a pair of big-name professional sports teams, the Seattle Seahawks and the Portland Trail Blazers. (He is also co-owner of a soccer team.) He can soothe his resentments riding the seas on a 414-foot yacht, tended to by a full-time crew of more than 50. The yacht holds a basketball court, a movie theater and a fully equipped recording studio, complete with killer ocean views, that has allowed him to rub shoulders with the fabulous — Mick Jagger, Bono, Paul McCartney and a long list of Page Six names that populate this memoir. “One of the greatest creative minds in the world of technology,” writes Pete Carroll, the coach of the Seahawks and therefore an Allen employee, in a blurb gracing the book’s back cover. Tellingly, no one remotely connected to the technology world echoes that sentiment. ', 'print_section': 'BR', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/08/books/review/RIVLIN/RIVLIN-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/08/books/review/RIVLIN/RIVLIN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/08/books/review/RIVLIN/RIVLIN-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/08/books/review/RIVLIN/RIVLIN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/08/books/review/RIVLIN/RIVLIN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Paul Allen: Microsoft and Me', 'kicker': None, 'content_kicker': None, 'print_headline': 'Microsoft And Me', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'ALLEN, PAUL', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Gates, Bill', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Microsoft Corporation', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-05-06T16:15:55+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Gary Rivlin', 'person': [{'firstname': 'Gary', 'middlename': None, 'lastname': 'Rivlin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/ac88dfe4-a225-5385-93e2-ac757e3f7878', 'word_count': 1221, 'uri': 'nyt://article/ac88dfe4-a225-5385-93e2-ac757e3f7878'}, {'abstract': 'Sportswriters explain what to look for in this wide-open Kentucky Derby and why the big race still matters.', 'web_url': 'https://www.nytimes.com/2011/05/07/sports/07leading.html', 'snippet': 'Sportswriters explain what to look for in this wide-open Kentucky Derby and why the big race still matters.', 'lead_paragraph': 'For the casual sort of racing fan, and we mean those who have no idea that O.T.B. closed its doors, the Friday before the Kentucky Derby is the day to a) remember that they’re running the Kentucky Derby Saturday and b) figure out who on earth is in it. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Kentucky Puzzle', 'kicker': 'Leading Off', 'content_kicker': None, 'print_headline': 'The Kentucky Puzzle', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Kentucky Derby', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Basketball', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Boxing', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Pacquiao, Manny', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Mosley, Shane', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Zito, Nick', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Horse Racing', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Borel, Calvin', 'rank': 8, 'major': 'N'}], 'pub_date': '2011-05-06T16:21:07+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Lynn Zinser', 'person': [{'firstname': 'Lynn', 'middlename': None, 'lastname': 'Zinser', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/554dd94b-672d-529d-bcd7-12a4d79ec791', 'word_count': 722, 'uri': 'nyt://article/554dd94b-672d-529d-bcd7-12a4d79ec791'}, {'abstract': 'Guest blogger Amy Ernst writes about the importance of Lara Logan’s speaking out about her sexual assault earlier this year.', 'web_url': 'https://kristof.blogs.nytimes.com/2011/05/06/notes-from-a-young-american-in-congo-the-stigma-of-rape/', 'snippet': 'Guest blogger Amy Ernst writes about the importance of Lara Logan’s speaking out about her sexual assault earlier this year.', 'lead_paragraph': 'My father sent me the story about the CBS reporter Lara Logan, who survived a brutal sexual assault by a mob in Cairo’s Tahir Square in February. What hit me was not just the brutality of the attacks, but the redoubtable strength she showed by speaking out about potentially the most stigmatizing and painful experience a person can endure. It’s no secret that survivors of sexual assault such as Ms. Logan often choose not to come forward, and it’s not difficult to see why. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Notes From a Young American in Congo: The Stigma of Rape', 'kicker': 'Nicholas Kristof', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-05-06T16:29:05+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Amy Ernst', 'person': [{'firstname': 'Amy', 'middlename': None, 'lastname': 'Ernst', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/038cd431-da5f-569c-8146-3298a835f061', 'word_count': 869, 'uri': 'nyt://article/038cd431-da5f-569c-8146-3298a835f061'}, {'abstract': 'A critic speculates about what Shostakovich was really expressing in his string quartets.', 'web_url': 'https://www.nytimes.com/2011/05/08/books/review/book-review-music-for-silenced-voices-shostakovich-and-his-fifteen-quartets-by-wendy-lesser.html', 'snippet': 'A critic speculates about what Shostakovich was really expressing in his string quartets.', 'lead_paragraph': 'First, before we turn our attention to Stalin, to Soviet-era dissidence and to debates about Dmitri Shostakovich’s memoirs, listen. Try the Second String Quartet, from 1944, in which music can veer from somber melancholy to raucous jeers in just a few pages; or trace the coded allusions in the Eighth String Quartet, from 1960, in which the composer uses letters of his name to create a musical motif and invokes phrases from his earlier works that can drift like wisps of smoke; or stay focused through the other\xadworldly fugal opening of the last quartet, the 15th. “Play it so that flies drop dead in midair, and the audience starts leaving the hall from sheer boredom,” the composer told the players preparing its premiere in 1974.', 'print_section': 'BR', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/08/books/review/SUBB-Rothstein/SUBB-Rothstein-articleLarge.jpg', 'height': 359, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/08/books/review/SUBB-Rothstein/SUBB-Rothstein-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 359}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/08/books/review/SUBB-Rothstein/SUBB-Rothstein-jumbo.jpg', 'height': 674, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/08/books/review/SUBB-Rothstein/SUBB-Rothstein-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/08/books/review/SUBB-Rothstein/SUBB-Rothstein-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'What Shostakovich Was Really Expressing', 'kicker': None, 'content_kicker': None, 'print_headline': 'In a Subversive Key', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Lesser, Wendy', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'USSR (Former Soviet Union)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Volkov, Solomon', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Shostakovich, Dmitri', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-05-06T16:33:57+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Edward Rothstein', 'person': [{'firstname': 'Edward', 'middlename': None, 'lastname': 'Rothstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/1c9a1a96-5662-59e1-bffc-2ff24a7c6a93', 'word_count': 1860, 'uri': 'nyt://article/1c9a1a96-5662-59e1-bffc-2ff24a7c6a93'}, {'abstract': 'With all the scratching, biting, furniture wrecking, drapery shredding and hairball disgorging, it’s amazing the pets on “My Cat From Hell,” on Animal Planet, find time to get 20 hours of sleep per day.', 'web_url': 'https://www.nytimes.com/2011/05/07/arts/television/my-cat-from-hell-on-animal-planet.html', 'snippet': 'With all the scratching, biting, furniture wrecking, drapery shredding and hairball disgorging, it’s amazing the pets on “My Cat From Hell,” on Animal Planet, find time to get 20 hours of sleep per day.', 'lead_paragraph': 'What is the shortest measurable amount of time? You’d think the answer would involve advanced physics, something to do with some invisible force and nanoseconds. But no. Scientists now agree that the shortest measurable amount of time is the micro-instant between when a person first acquires a cat and when that person feels the need to use the phrase “bad kitty.”', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/06/arts/cat/cat-articleLarge.jpg', 'height': 315, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/06/arts/cat/cat-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 315}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/06/arts/cat/cat-jumbo.jpg', 'height': 680, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/06/arts/cat/cat-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/06/arts/cat/cat-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'And You Used to Think Hairballs Were Bad', 'kicker': 'Television Review | ‘My Cat From Hell’', 'content_kicker': None, 'print_headline': 'And You Used to Think Hairballs Were Bad', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'ANIMAL PLANET', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-05-06T16:40:58+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Neil Genzlinger', 'person': [{'firstname': 'Neil', 'middlename': None, 'lastname': 'Genzlinger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/b8143e93-6193-5708-9b52-3e58bfa28f17', 'word_count': 562, 'uri': 'nyt://article/b8143e93-6193-5708-9b52-3e58bfa28f17'}, {'abstract': 'Race, class and gender affect the identity struggles of the nuanced characters in Danzy Senna’s story collection.', 'web_url': 'https://www.nytimes.com/2011/05/08/books/review/book-review-you-are-free-by-danzy-senna.html', 'snippet': 'Race, class and gender affect the identity struggles of the nuanced characters in Danzy Senna’s story collection.', 'lead_paragraph': 'Barack Obama makes two appearances in Danzy Senna’s first story collection, “You Are Free”: in a photograph on an administrator’s desk at an exclusive preschool, and on the bumper sticker of a BMW. Seeing that BMW, the narrator of the story “Replacement Theory” observes, “The election had come and gone, the blackish man was in charge, and the slogan on the bumper — Yes We Can — already had the feeling of some dusty, long-gone revolution.”', 'print_section': 'BR', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/08/books/review/ROSENWAIKE-1303512333408/ROSENWAIKE-1303512333408-jumbo.jpg', 'height': 1024, 'width': 685, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/08/books/review/ROSENWAIKE-1303512333408/ROSENWAIKE-1303512333408-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/08/books/review/ROSENWAIKE-1303512333408/ROSENWAIKE-1303512333408-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Stories of Biracial America', 'kicker': None, 'content_kicker': None, 'print_headline': 'Under Their Skin', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Senna, Danzy', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Race and Ethnicity', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-05-06T16:44:57+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Polly Rosenwaike', 'person': [{'firstname': 'Polly', 'middlename': None, 'lastname': 'Rosenwaike', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/fca9ae4d-b905-5a02-8d8d-63d6e0e5cc72', 'word_count': 630, 'uri': 'nyt://article/fca9ae4d-b905-5a02-8d8d-63d6e0e5cc72'}, {'abstract': 'In one-day “money bomb,” Representative Ron Paul says he raised more than $1 million for his presidential campaign.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2011/05/06/ron-paul-sees-fund-raising-windfall-during-debate/', 'snippet': 'In one-day “money bomb,” Representative Ron Paul says he raised more than $1 million for his presidential campaign.', 'lead_paragraph': 'Representative Ron Paul of Texas has none of the typical attributes of a successful presidential candidate, except one: he can raise money.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Ron Paul Sees Fund-Raising Windfall on Debate Day', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Elections', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Paul, Ron', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-05-06T16:50:38+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Michael D. Shear', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/fb6f3d03-52cd-5404-9360-93ba8f3c3d31', 'word_count': 177, 'uri': 'nyt://article/fb6f3d03-52cd-5404-9360-93ba8f3c3d31'}, {'abstract': 'A memoir of a family sundered by their return to the land in the 1960s.', 'web_url': 'https://www.nytimes.com/2011/05/08/books/review/book-review-this-life-is-in-your-hands-by-melissa-coleman.html', 'snippet': 'A memoir of a family sundered by their return to the land in the 1960s.', 'lead_paragraph': 'Melissa Coleman’s father, Eliot, once suggested that evidence points to “the return to the land as a cyclical urge in history.” Some families work the land out of necessity, while others seek “the good life” through labor and simplicity. In the 1840s, Thoreau took to the woods to “live deliberately.” During the Great Depression, self-sufficiency was raised to new importance, and well-educated men like the writer and editor Elliott Merrick and the economist Ralph Borsodi found homesteading a rational and intellectual pursuit. The political climate of the late 1960s (and later the energy crisis of the ’70s) provoked back-to-the-land desires in many, including Eliot Coleman, who, inspired by Helen and Scott Nearing’s book “Living the Good Life,” moved in 1968 with his pregnant wife, Sue, to a remote 60-acre wood in coastal Maine. There, they developed sustainable, small-scale farming techniques that would help catalyze the organic movement. ', 'print_section': 'BR', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/08/books/review/Bergman/Bergman-articleLarge.jpg', 'height': 349, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/08/books/review/Bergman/Bergman-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 349}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/08/books/review/Bergman/Bergman-jumbo.jpg', 'height': 760, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/08/books/review/Bergman/Bergman-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/08/books/review/Bergman/Bergman-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Memoir of Living Off the Grid', 'kicker': None, 'content_kicker': None, 'print_headline': 'Casualties of the Good Life', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'AGRICULTURE', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Coleman, Melissa', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-05-06T16:52:16+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Megan Mayhew Bergman', 'person': [{'firstname': 'Megan', 'middlename': 'Mayhew', 'lastname': 'Bergman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/a3e9be56-3502-5282-9e76-626c57e56e99', 'word_count': 768, 'uri': 'nyt://article/a3e9be56-3502-5282-9e76-626c57e56e99'}, {'abstract': 'I was distraught. How could I now be forced to leave my boys, my platoon, in harm’s way while I worked a desk job in relative safety on a large forward operating base? I felt like I was being taken out of the game when my team needed me the most.', 'web_url': 'https://atwar.blogs.nytimes.com/2011/05/06/desk-guilt/', 'snippet': 'I was distraught. How could I now be forced to leave my boys, my platoon, in harm’s way while I worked a desk job in relative safety on a large forward operating base? I felt like I was being taken out of the game when my team needed me the most.', 'lead_paragraph': ' ZABUL PROVINCE, Afghanistan — I deployed last June with the Second Stryker Cavalry Regiment from Vilseck, Germany, to an isolated combat outpost in a remote district of Afghanistan’s Zabul Province.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Desk Guilt', 'kicker': 'At War', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Afghanistan War (2001- )', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'United States Army', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'AFGHANISTAN', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-05-06T17:00:50+0000', 'document_type': 'article', 'news_desk': '', 's