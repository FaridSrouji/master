ifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ff10e68f-87b3-5791-9da4-df71b00e546e', 'word_count': 709, 'uri': 'nyt://article/ff10e68f-87b3-5791-9da4-df71b00e546e'}, {'abstract': 'Two bombs were dropped by aircraft on a bridge outside the town of Abyei on Friday evening, a United Nations official said.', 'web_url': 'https://www.nytimes.com/2011/05/21/world/africa/21briefs-sudan.html', 'snippet': 'Two bombs were dropped by aircraft on a bridge outside the town of Abyei on Friday evening, a United Nations official said.', 'lead_paragraph': 'New fighting has broken out in the contested region of Abyei in central Sudan, the United Nations said Friday. Two bombs were dropped by aircraft on a bridge outside the town of Abyei on Friday evening, a United Nations official said. Hua Jiang, a United Nations spokeswoman in Sudan, said the world body had also been alerted to possible artillery fire in villages surrounding Abyei, which had not been independently confirmed. There were no casualties reported. On Thursday a United Nations convoy carrying 200 northern Sudanese soldiers was attacked in a southern-controlled part of the region.\xa0', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Sudan: Fighting Reported in Disputed Region', 'kicker': 'World Briefing | AFRICA', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Sudan', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'United Nations', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-05-21T02:37:58+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Africa', 'byline': {'original': 'By Josh Kron', 'person': [{'firstname': 'Josh', 'middlename': None, 'lastname': 'Kron', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 