, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/23/business/23OPRAH/23OPRAH-jumbo.jpg', 'height': 694, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/23/business/23OPRAH/23OPRAH-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/23/business/23OPRAH/23OPRAH-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Talk Show Ends, and Oprah Moves On', 'kicker': None, 'content_kicker': None, 'print_headline': 'Oprah Moves On to Her Next Best Life', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Oprah Winfrey Network', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Winfrey, Oprah', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-05-22T19:48:37+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Brian Stelter', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Stelter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d84c43e3-e95f-5eb3-b8a6-fbb626969b8a', 'word_count': 1214, 'uri': 'nyt://article/d84c43e3-e95f-5eb3-b8a6-fbb626969b8a'}, {'abstract': 'The American Guild of Musical Artists is considering filing unfair labor practice charges against New York City Opera after its board voted to cut staffing and move from Lincoln Center.', 'web_url': 'https://www.nytimes.com/2011/05/23/arts/music/unfair-labor-practice-charge-may-be-filed-against-city-opera.html', 'snippet': 'The American Guild of Musical Artists is considering filing unfair labor practice charges against New York City Opera after its board voted to cut staffing and move from Lincoln Center.', 'lead_paragraph': 'The American Guild of Musical Artists said it would consider filing unfair labor practice charges with the National Labor Relations Board\xa0against New York City Opera after that company’s board voted on Friday to cut staffing and move from its Lincoln Center home. Alan Gordon, the union’s national executive director, said the group might also seek an injunction to keep the company from using the name New York City Opera. George Steel, the opera’s general manager and artistic director, said on Friday that the move, the layoffs and the cuts to the production schedule were required to keep the company running and to ensure “a foundation for sustainable growth.” RACHEL LEE HARRIS', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Union Ponders Labor Charges', 'kicker': None, 'content_kicker': None, 'print_headline': 'Union Ponders Labor Charges', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'AMERICAN GUILD OF MUSICAL ARTISTS', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York City Opera', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'National Labor Relations Board', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Organized Labor', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-05-22T19:55:04+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Rachel Lee Harris', 'person': [{'firstname': 'Rachel', 'middlename': 'Lee', 'lastname': 'Harris', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/891dfef2-ee2f-5c9c-9676-5358383f590c', 'word_count': 114, 'uri': 'nyt://article/891dfef2-ee2f-5c9c-9676-5358383f590c'}, {'abstract': 'After 25 years, the final episode of "The Oprah Winfrey Show" will air on May 25.', 'web_url': 'https://www.nytimes.com/video/business/media/100000000830178/media-decoder-oprahs-final-show.html', 'snippet': 'After 25 years, the final episode of "The Oprah Winfrey Show" will air on May 25.', 'lead_paragraph': 'After 25 years, the final episode of "The Oprah Winfrey Show" will air on May 25.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/22/business/video-mediadecoder-oprah/video-mediadecoder-oprah-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/22/business/video-mediadecoder-oprah/video-mediadecoder-oprah-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/22/business/video-mediadecoder-oprah/video-mediadecoder-oprah-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/22/business/video-mediadecoder-oprah/video-mediadecoder-oprah-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': "Media Decoder: Oprah's Final Show", 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Winfrey, Oprah', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'Oprah Winfrey Show, The (TV Program)', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-05-22T19:59:03+0000', 'document_type': 'multimedia', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'Vijai Singh|Emily B. Hager', 'person': [{'firstname': 'Vijai', 'middlename': 'Singh', 'lastname': 'Emily', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/e919d6dc-373c-5532-b72c-97e144a4cfd8', 'word_count': 0, 'uri': 'nyt://video/e919d6dc-373c-5532-b72c-97e144a4cfd8'}, {'abstract': 'Budget pressures must not limit spending such that the military is unable to defend American interests, the defense secretary told graduates at Notre Dame.', 'web_url': 'https://www.nytimes.com/2011/05/23/us/politics/23gates.html', 'snippet': 'Budget pressures must not limit spending such that the military is unable to defend American interests, the defense secretary told graduates at Notre Dame.', 'lead_paragraph': 'WASHINGTON — In a grim warning about financial priorities during a time of fiscal crisis, the defense secretary, Robert M. Gates, said Sunday that budget pressures must not limit Pentagon spending such that the military is unable to defend American interests in an unpredictable world. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Gates Warns Against Big Cuts in Military Spending', 'kicker': None, 'content_kicker': None, 'print_headline': 'Gates Cautions Against Sharp Cuts in Military Spending', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Defense Department', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Gates, Robert M', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Federal Budget (US)', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-05-22T20:02:22+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Thom Shanker', 'person': [{'firstname': 'Thom', 'middlename': None, 'lastname': 'Shanker', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/89314495-b308-54e2-b0f4-0f95083f7c56', 'word_count': 447, 'uri': 'nyt://article/89314495-b308-54e2-b0f4-0f95083f7c56'}, {'abstract': 'The Palme d’Or went to the film by the American director and writer Terrence Malick.', 'web_url': 'https://www.nytimes.com/2011/05/23/movies/cannes-gives-top-prize-to-the-tree-of-life.html', 'snippet': 'The Palme d’Or went to the film by the American director and writer Terrence Malick.', 'lead_paragraph': 'CANNES, France — In a strong year that was nearly eclipsed by off-screen scandals, the top prize for the 64th Cannes Film Festival was given to “’The Tree of Life,” the long-awaited film from the American director and writer Terrence Malick. A story about transcendence that divided critics, who were alternately transported and turned off by its religious themes and elliptical storytelling, it is the first film from Mr. Malick since “The New World” (2005). The famously shy Mr. Malick did not appear to accept his award, which was introduced by Jane Fonda, who spoke in emphatic French before saying, “And maintenant, now, let’s cut to the chase.” The competition jury president, Robert De Niro, hurriedly announced the winner. ', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/23/arts/CANNES1/CANNES1-jumbo.jpg', 'height': 581, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Cannes Gives Top Prize to ‘The Tree of Life’', 'kicker': 'Critic’s Notebook', 'content_kicker': None, 'print_headline': '‘Tree of Life’ Receives Top Prize At Cannes', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Malick, Terrence', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cannes International Film Festival', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-05-22T20:15:52+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Movies', 'byline': {'original': 'By Manohla Dargis', 'person': [{'firstname': 'Manohla', 'middlename': None, 'lastname': 'Dargis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e9dd7f48-74c2-5eeb-88b6-97f536645f6d', 'word_count': 1379, 'uri': 'nyt://article/e9dd7f48-74c2-5eeb-88b6-97f536645f6d'}, {'abstract': 'After 25 years, the final episode of “The Oprah Winfrey Show” will air on May 25.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2011/05/22/oprahs-final-shows-what-to-expect/', 'snippet': 'After 25 years, the final episode of “The Oprah Winfrey Show” will air on May 25.', 'lead_paragraph': '', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Oprah’s Final Shows: What to Expect', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'Oprah Winfrey Show, The (TV Program)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-05-22T20:16:20+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Brian Stelter', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Stelter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/05c8e103-70ce-527c-a1ad-a0c2cbc172aa', 'word_count': 1, 'uri': 'nyt://article/05c8e103-70ce-527c-a1ad-a0c2cbc172aa'}, {'abstract': 'The Yankees scored eight runs in the seventh inning, denying the Mets a victory that would have given them a .500 record.', 'web_url': 'https://www.nytimes.com/2011/05/23/sports/baseball/on-strength-of-one-inning-yankees-defeat-mets.html', 'snippet': 'The Yankees scored eight runs in the seventh inning, denying the Mets a victory that would have given them a .500 record.', 'lead_paragraph': 'The Mets were nine outs away Sunday from evening their record at .500, from capturing a series against the Yankees, from reigning supreme in New York. Their nominal ace, Mike Pelfrey, was cruising. The bottom of the Yankees’ order was due up. ', 'print_section': 'D', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/23/sports/YYANKEES1/YYANKEES1-articleLarge.jpg', 'height': 342, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/23/sports/YYANKEES1/YYANKEES1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 342}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/23/sports/YYANKEES1/YYANKEES1-jumbo.jpg', 'height': 841, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/23/sports/YYANKEES1/YYANKEES1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/23/sports/YYANKEES1/YYANKEES1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'On Strength of One Inning, Yankees Thwart the Mets', 'kicker': 'Yankees 9, Mets 3', 'content_kicker': None, 'print_headline': 'On Strength of One Inning, Yankees Thwart the Mets', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Pelfrey, Mike', 'rank': 1, 'major': 'N'},