cs/07marriage.html', 'snippet': 'An immigration judge in Newark responded to an unusual signal from the Obama administration that it is exploring legal avenues for recognizing those marriages in immigration cases.', 'lead_paragraph': 'An immigration judge in Newark on Friday suspended the deportation of a Venezuelan man who is married to an American man, responding to an unusual signal this week from the Obama administration that it is exploring legal avenues for recognizing same-sex marriages in immigration cases.', 'print_section': 'A', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/07/us/MARRIAGE/MARRIAGE-jumbo.jpg', 'height': 686, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/07/us/MARRIAGE/MARRIAGE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/07/us/MARRIAGE/MARRIAGE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Judge Gives Immigrant in Same-Sex Marriage a Reprieve From Deportation', 'kicker': None, 'content_kicker': None, 'print_headline': 'Judge Gives Immigrant in Same-Sex Marriage a Reprieve From Deportation', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Holder, Eric H Jr', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Deportation', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Defense of Marriage Act (1996)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'valu