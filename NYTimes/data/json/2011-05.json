23B', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/08/us/08TTLANGER/08TTLANGER-articleLarge.jpg', 'height': 385, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/08/us/08TTLANGER/08TTLANGER-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 385}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/08/us/08TTLANGER/08TTLANGER-jumbo.jpg', 'height': 833, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/08/us/08TTLANGER/08TTLANGER-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/08/us/08TTLANGER/08TTLANGER-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Singer, Songwriter, Prodigy, All at 19', 'kicker': 'The Texas Tribune', 'content_kicker': None, 'print_headline': 'Singer, Songwriter, Prodigy, All at 19', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Grammy Awards', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Newport Folk Festival', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Plant, Robert', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Krauss, Alison', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Folk Music', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-05-07T21:44:18+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Andy Langer', 'person': [{'firstname': 'Andy', 'middlename': None, 'lastname': 'Langer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}],