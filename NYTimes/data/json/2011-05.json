': 'glocations', 'value': 'ARCTIC REGIONS', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Greenland', 'rank': 8, 'major': 'N'}], 'pub_date': '2011-05-12T11:16:15+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Science', 'subsection_name': 'Environment', 'byline': {'original': 'By Steven Lee Myers', 'person': [{'firstname': 'Steven', 'middlename': 'Lee', 'lastname': 'Myers', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/d1d0a1c2-6ab8-5a30-bf7f-4ff85091e25a', 'word_count': 529, 'uri': 'nyt://article/d1d0a1c2-6ab8-5a30-bf7f-4ff85091e25a'}, {'abstract': 'Ahmed Ferhani and his accomplice were charged on Thursday in a terrorism case unusual for the absence of the F.B.I. and the United States attorney’s office.', 'web_url': 'https://www.nytimes.com/2011/05/13/nyregion/two-men-arrested-in-new-york-terror-case-police-say.html', 'snippet': 'Ahmed Ferhani and his accomplice were charged on Thursday in a terrorism case unusual for the absence of the F.B.I. and the United States attorney’s office.', 'lead_paragraph': 'The 26-year-old man from Queens had discussed growing a beard and the side curls of a Hasidic Jew, the police commissioner said, a disguise that he apparently hoped would enable him to attack a synagogue in Manhattan “and take out the whole entire building.”', 'print_section': 'A', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/13/nyregion/TERROR/TERROR-jumbo.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/13/nyregion/TERROR/TERROR-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbna