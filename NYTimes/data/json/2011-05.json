': 'glocations', 'value': 'Michigan', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-05-24T23:42:25+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Michael D. Shear', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4de91888-49e2-5977-995a-774a0964e0a2', 'word_count': 959, 'uri': 'nyt://article/4de91888-49e2-5977-995a-774a0964e0a2'}, {'abstract': 'Pledging to provide relief to suburban homeowners, Gov. Andrew M. Cuomo and legislative leaders agreed to a 2 percent limit on property tax increases.', 'web_url': 'https://www.nytimes.com/2011/05/25/nyregion/in-albany-agreement-is-reached-to-cap-property-tax-increases-at-2-percent.html', 'snippet': 'Pledging to provide relief to suburban homeowners, Gov. Andrew M. Cuomo and legislative leaders agreed to a 2 percent limit on property tax increases.', 'lead_paragraph': 'ALBANY — Pledging to provide relief to highly taxed suburban homeowners, Gov. Andrew M. Cuomo and legislative leaders said Tuesday that they had agreed to place a 2 percent limit on property tax increases in a plan that rivals the toughest such measures in the nation. ', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/25/nyregion/PROPTAX/PROPTAX-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/25/nyregion/PROPTAX/PROPTAX-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/25/nyregion/PROPTAX/PROPTAX-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jum