he New York Times', 'multimedia': [], 'headline': {'main': 'Chilling Echoes From Sept. 11', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Chilling Echoes From Sept. 11: There’s still no national emergency communications network', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Disasters and Emergencies', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Emergency Telephone Numbers', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-05-23T01:15:50+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/af5f32ee-a71e-51fc-a9be-5a7a96112904', 'word_count': 457, 'uri': 'nyt://article/af5f32ee-a71e-51fc-a9be-5a7a96112904'}, {'abstract': 'The N.C.A.A. is being asked to put cheerleading on track to gain full status as a championship sport.', 'web_url': 'https://www.nytimes.com/2011/05/23/sports/gender-games-born-on-sideline-cheering-clamors-to-be-sport.html', 'snippet': 'The N.C.A.A. is being asked to put cheerleading on track to gain full status as a championship sport.', 'lead_paragraph': 'Hundreds of thousands of high school girls put on cheerleading uniforms each year and thousands more continue on to college, taking their place in a thriving American tradition that has been around for nearly as long as football. ', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/23/sports/YJPCHEER3/YJPCHEER3-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/23/sports/YJPCHEER3/YJPCHEER3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo'