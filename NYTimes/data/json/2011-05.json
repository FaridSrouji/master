4, 'width': 731, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/22/arts/GAGA/GAGA-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/22/arts/GAGA/GAGA-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Even Offstage, Lady Gaga’s Ready for the Stage', 'kicker': 'Music', 'content_kicker': None, 'print_headline': 'The Queen Pop Needs Her to Be', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Lady Gaga', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-05-18T12:00:29+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Jon Pareles', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Pareles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1434885e-18f1-5a2a-9b4b-b2972dd68bd4', 'word_count': 2078, 'uri': 'nyt://article/1434885e-18f1-5a2a-9b4b-b2972dd68bd4'}, {'abstract': 'Brad Pitt spoke about “The Tree of Life” and Terrence Malick in an interview at the Carlton Hotelon Tuesday.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/05/18/brad-pitt-discusses-the-tree-of-life/', 'snippet': 'Brad Pitt spoke about “The Tree of Life” and Terrence Malick in an interview at the Carlton Hotelon Tuesday.', 'lead_paragraph': 'CANNES, France — At the Cannes Film Festival, the world capital of auteur cinema, “The Tree of Life” was greeted with the sense of occasion befitting a Terrence Malick movie. But for much of the assembled media at this glamour-hungry event, it was also — and perhaps more to the point — a Brad Pitt movie. In fact, a good number of journalists left the film’s Monday morning press screening early to get in line for the news conference, where Mr. Pitt was the star attraction. (Mr. Malick, as expected, was not there.)', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Brad Pitt Discusses ‘The Tree of Life’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cannes International Film Festival', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Malick, Terrence', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Pitt, Brad', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Cannes (France)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'France', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-05-18T12:30:01+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Dennis Lim', 'person': [{'firstname': 'Dennis', 'middlename': None, 'lastname': 'Lim', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/3cb8659f-3e22-55e3-9152-523339cafb1a', 'word_count': 209, 'uri': 'nyt://article/3cb8659f-3e22-55e3-9152-523339cafb1a'}, {'abstract': 'The Day: The mayor’s record for winning friends and influencing enemies in Albany is almost as dismal as the Yankees’ won-lost record of late. Also, what City Room is reading in other papers and blogs.', 'web_url': 'https://cityroom.blogs.nytimes.com/2011/05/18/bloomberg-lobbies-for-gay-marriage-well-it-couldnt-hurt/', 'snippet': 'The Day: The mayor’s record for winning friends and influencing enemies in Albany is almost as dismal as the Yankees’ won-lost record of late. Also, what City Room is reading in other papers and blogs.', 'lead_paragraph': 'Mayor Michael R. Bloomberg went to Albany to ask that lawmakers make it possible for gay couples to marry in New York State. Naturally, advocates of same-sex marriage applauded him. They might just as easily have said, “Uh, oh.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Bloomberg Lobbies for Gay Marriage. Well, It Couldn’t Hurt.', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Same-Sex Marriage, Civil Unions and Domestic Partnerships', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bloomberg, Michael R', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New York State', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-05-18T12:34:09+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Clyde Haberman', 'person': [{'firstname': 'Clyde', 'middlename': None, 'lastname': 'Haberman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/a4bed97d-a30b-543f-8d35-ab08ea8c3fb0', 'word_count': 949, 'uri': 'nyt://article/a4bed97d-a30b-543f-8d35-ab08ea8c3fb0'}, {'abstract': 'Morgan Stanley’s chief executive, James P. Gorman, faced questions about progress on turnaround efforts and a struggling stock.', 'web_url': 'https://dealbook.nytimes.com/2011/05/18/blogging-morgan-stanleys-annual-meeting/', 'snippet': 'Morgan Stanley’s chief executive, James P. Gorman, faced questions about progress on turnaround efforts and a struggling stock.', 'lead_paragraph': 'There was no shortage of good topics on which shareholders can grill Morgan Stanley’s chief executive, James P. Gorman, at the firm’s annual meeting on Wednesday in Purchase, N.Y.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Blogging Morgan Stanley’s Annual Meeting', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-05-18T12:48:06+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Susanne Craig', 'person': [{'firstname': 'Susanne', 'middlename': None, 'lastname': 'Craig', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/ef56a8e1-0a0a-5f0c-a65e-a67cd32a6f95', 'word_count': 983, 'uri': 'nyt://article/ef56a8e1-0a0a-5f0c-a65e-a67cd32a6f95'}, {'abstract': 'From a position of strength, CBS is adding three dramas and two sitcoms to its prime time schedule in the fall, but is not making any dramatic changes.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2011/05/18/upfronts-cbs-adds-three-dramas-two-sitcoms-for-fall/', 'snippet': 'From a position of strength, CBS is adding three dramas and two sitcoms to its prime time schedule in the fall, but is not making any dramatic changes.', 'lead_paragraph': 'From a position of strength, CBS is adding three dramas and two sitcoms to its prime-time schedule in the fall, and is moving several of its established franchises to new time slots.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Upfronts: CBS Adds Three Dramas, Two Sitcoms for Fall', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'CBS Corp', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-05-18T12:53:07+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Brian Stelter', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Stelter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/cb5b9985-9cac-5570-a3bb-a75539c6b871', 'word_count': 580, 'uri': 'nyt://article/cb5b9985-9cac-5570-a3bb-a75539c6b871'}, {'abstract': 'When the creators of the brand Astier de Villatte set out to create candles, they were inspired by far-flung places like Brasilia and and Kobe.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2011/05/18/follow-their-nose/', 'snippet': 'When the creators of the brand Astier de Villatte set out to create candles, they were inspired by far-flung places like Brasilia and and Kobe.', 'lead_paragraph': 'If there is a place that the name Astier de Villatte conjures, it is most definitely Paris. For 15 years, Ivan Pericoli and Benoît Astier de Villatte have been creating furniture and wonderfully goopy, overglazed ceramics which they sell from their charming shop on the rue Saint Honoré. But when the two set out to create a new collection of candles, they broadened their horizons, following their noses — in their imaginations, at least — to far flung places like Brasilia and Kobe. Of the 20 different destination-oriented scents, created in collaboration with the fragrance company Takasago, some might seem vaguely familiar: Naples, for example, is a bouquet of “almond, orange blossom, and Ylang-Ylang, lightened by a refreshing touch of petitgrain and neroli.” Alcatraz, on the other hand (“Indian blond tobacco, yerba maté with its notes of dried hay, smoked lignum vitae and cinnamon spiced with black pepper”) seems to have been conjured not from an actual three-hour tour but a dream. And what is the smell of home? Rue Saint Honoré is described as a powdery cloud in which a few delicate green notes and a jasmine rose accord merge deliciously with the amber and leather atmosphere.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Follow Their Nose', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-05-18T13:00:12+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Alix Browne', 'person': [{'firstname': 'Alix', 'middlename': None, 'lastname': 'Browne', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/52997635-e79c-5d7d-8e9f-2b6233ea5320', 'word_count': 198, 'uri': 'nyt://article/52997635-e79c-5d7d-8e9f-2b6233ea5320'}, {'abstract': 'A former adviser to President Obama proposes giving utilities incentives for converting to cleaner forms of electricity without top-down mandates from the federal government or penalties for failure to comply.', 'web_url': 'https://green.blogs.nytimes.com/2011/05/18/youve-got-to-start-somewhere-a-climate-prescription/', 'snippet': 'A former adviser to President Obama proposes giving utilities incentives for converting to cleaner forms of electricity without top-down mandates from the federal government or penalties for failure to comply.', 'lead_paragraph': ' Hoping to find a way around the current political impasse on climate change and energy policy, a former top adviser to President Obama has devised a policy proposal to drive down greenhouse gas emissions from the utility industry over the next 20 years.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'You’ve Got to Start Somewhere: A Climate Prescription', 'kicker': 'Green', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Alternative and Renewable Energy', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Carbon Dioxide', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Electric Light and Power', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Global Warming', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Greenhouse Gas Emissions', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Brookings Institution', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Environmental Protection Agency', 'rank': 8, 'major': 'N'}], 'pub_date': '2011-05-18T13:00:54+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Science', 'subsection_name': 'Environment', 'byline': {'original': 'By John M. Broder', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/0e7351c0-d658-5e08-91c6-66545be7de7e', 'word_count': 631, 'uri': 'nyt://article/0e7351c0-d658-5e08-91c6-66545be7de7e'}, {'abstract': 'Iraq is still very dangerous, though not dangerous enough to scare off investors with an appetite for risk.', 'web_url': 'https://www.nytimes.com/2011/05/22/magazine/the-hot-money-cowboys-of-iraq.html', 'snippet': 'Iraq is still very dangerous, though not dangerous enough to scare off investors with an appetite for risk.', 'lead_paragraph': '“My friend, Iraq is a rich, virgin country!” one of its richest men, Namir al-Akabi, told me with a startling enthusiasm when I met him earlier this year at his office in Baghdad. Akabi is the chairman of the Almco Group of Companies, a conglomerate he built from nothing in the wake of the American invasion in 2003. What makes Iraq’s economic potential so great, he explained, despite everything, is not just its abundant natural resources — it is the shattered state of Iraq itself: the damage done by the American war, but also the long, steady decay under Saddam Hussein, from the war with Iran that began in 1980 through the invasion of Kuwait a decade later and the crushing international sanctions that followed the first gulf war. The country has been decimated, and therein lies its potential.', 'print_section': 'MM', 'print_page': '28', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'su