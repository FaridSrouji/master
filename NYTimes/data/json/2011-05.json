subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Speaking Up in Class, Silently, Using Social Media', 'kicker': None, 'content_kicker': None, 'print_headline': 'Speaking Up in Class, Silently, Using the Tools of Social Media', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'United States', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Education (K-12)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Social Networking (Internet)', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-05-12T19:11:55+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'Education', 'byline': {'original': 'By Trip Gabriel', 'person': [{'firstname': 'Trip', 'middlename': None, 'lastname': 'Gabriel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/628261b7-820c-5d30-b307-bdf98df74bbd', 'word_count': 1110, 'uri': 'nyt://article/628261b7-820c-5d30-b307-bdf98df74bbd'}, {'abstract': 'Rolando Sarabia, a veteran of the National Ballet of Cuba and Miami City Ballet, will replace Herman Cornejo in “Don Quixote” as a guest artist with Ballet Theater.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/05/12/abts-herman-cornejo-injured-exits-don-quixote/', 'snippet': 'Rolando Sarabia, a veteran of the National Ballet of Cuba and Miami City Ballet, will replace Herman Cornejo in “Don Quixote” as a guest artist with Ballet Theater.', 'lead_paragraph': 'Herman Cornejo, a principal dancer with American Ballet Theater, will not perform during the first two weeks of the company’s season, Kevin McKenzie, the artistic director, announced on Thursday. Mr. Cornejo, who withdrew due to an injury, was scheduled to perform in “Don Quixote” on May 19 and in Antony Tudor’s “Shadowplay” on May 24 and 25. Rolando Sarabia, a veteran of the National Ballet of Cuba and Miami City Ballet, will replace Mr. Cornejo for the performances of “Don Quixote.” Craig Salstein, a soloist, will replace Mr. Cornejo in “Shadowplay” at both performances. The company earlier announced that Ethan Stiefel, another principal, would withdraw from the entire season. This is the first time Mr. Sarabia will appear with the company.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'ABT’s Herman Cornejo Injured, Exits ‘Don Quixote’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'AMERICAN BALLET THEATER', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-05-12T19:18:21+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Julie Bloom', 'person': [{'firstname': 'Julie', 'middlename': None, 'lastname': 'Bloom', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/6f0e4fa2-02ea-5d4e-84a7-4d1e22abb1b2', 'word_count': 121, 'uri': 'nyt://article/6f0e4fa2-02ea-5d4e-84a7-4d1e22abb1b2'}, {'abstract': 'Mitt Romney addressed the health care law he once championed in his own home state by calling for a repeal of the health care law President Obama signed last year.', 'web_url': 'https://www.nytimes.com/2011/05/13/us/politics/13romney.html', 'snippet': 'Mitt Romney addressed the health care law he once championed in his own home state by calling for a repeal of the health care law President Obama signed last year.', 'lead_paragraph': 'ANN ARBOR, Mich. — Former Gov. Mitt Romney of Massachusetts came here on Thursday to address the biggest threat to his nascent presidential campaign, defending core elements of the health care law enacted in his home state five years ago even as he tried to reassure conservatives that he would work to roll back the similar national overhaul President Obama signed into law last year.', 'pr