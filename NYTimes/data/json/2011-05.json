ns', 'value': 'Upper East Side (NYC)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Kaufman, Elaine', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Restaurants', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': "ELAINE'S", 'rank': 4, 'major': 'N'}], 'pub_date': '2011-05-18T01:24:16+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By James Barron', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': 'Barron', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/684eb5db-f912-56b7-b7f4-e0fee78d8853', 'word_count': 969, 'uri': 'nyt://article/684eb5db-f912-56b7-b7f4-e0fee78d8853'}, {'abstract': 'Representative Paul D. Ryan made it clear on Tuesday that he would not run for the Senate seat being vacated by Herb Kohl, a Democrat who was first elected in 1988.', 'web_url': 'https://www.nytimes.com/2011/05/18/us/politics/18brfs-RYANSAYSHEWI_BRF.html', 'snippet': 'Representative Paul D. Ryan made it clear on Tuesday that he would not run for the Senate seat being vacated by Herb Kohl, a Democrat who was first elected in 1988.', 'lead_paragraph': 'Representative Paul D. Ryan, a Wisconsin Republican and the chairman of the House Budget Committee, made it clear on Tuesday that he would not run for the Senate seat being vacated by Herb Kohl, a Democrat who was first elected in 1988. Instead, Mr. Ryan said he would remain in the House and lead the Republican fight over the budget and the national debt. “Our nation is quickly approaching a debt crisis that will do serious damage to Wisconsinites and all Americans if it is not properly addressed,” Mr. Ryan said in a statement on his Web site. “I believe continuing to serve as chairman of the House Budget Committee allows me to have a greater impact in averting this debt-fueled economic crisis than if I were to run for the United States Senate.” ', 'print_section': 'A', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Ryan Says He Will Stay in the House', 'kicker': 'National Briefing | Washington', 'content_kicker': None, 'print_headline': 'Ryan Says He Will Stay in the House', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'National Debt (US)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Ryan, Paul D Jr', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Kohl, Herbert H', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-05-18T01:25:49+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Michael D. Shear', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/95c4898d-3a06-5fc5-a6eb-3aaef5f731c7', 'word_count': 138, 'uri': 'nyt://article/95c4898d-3a06-5fc5-a6eb-3aaef5f731c7'}, {'abstract': 'The critic Tom Carson has written about music, books, television and film for publications as diverse as The Village Voice and GQ.', 'web_url': 'https://www.nytimes.com/2011/05/22/books/review/up-front-tom-carson.html', 'snippet': 'The critic Tom Carson has written about music, books, television and film for publications as diverse as The Village Voice and GQ.', 'lead_paragraph': 'The critic Tom Carson has written about music, books, television and film for publications as diverse as The Village Voice and GQ.', 'print_section': 'BR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 