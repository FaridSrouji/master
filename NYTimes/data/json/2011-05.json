e', 'url': 'images/2011/05/04/dining/04stuffboulud/04stuffboulud-articleLarge.jpg', 'height': 364, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/04/dining/04stuffboulud/04stuffboulud-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 364}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/04/dining/04stuffboulud/STUFF1-jumbo.jpg', 'height': 677, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/04/dining/04stuffboulud/04stuffboulud-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/04/dining/04stuffboulud/04stuffboulud-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'New Tastes From Daniel Boulud, for Shoppers and Diners', 'kicker': 'Food Stuff', 'content_kicker': None, 'print_headline': 'New Tastes From Daniel Boulud, For Shoppers and Diners', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Boulud, Daniel', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Shopping and Retail', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-05-03T22:23:38+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bb9bcb26-74e4-50fd-a850-43174cd9b2ef', 'word_count': 200, 'uri': 'nyt://article/bb9bcb26-74e4-50fd-a850-43174cd9b2ef'}, {'abstract': 'The baker behind Momofuku Milk Bar, whose ingredients include cornflakes and chorizo, is nominated for a James Beard award 