ance/dance.html', 'snippet': 'A Listing of dance performances and festivals this summer.', 'lead_paragraph': 'California', 'print_section': 'AR', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/08/arts/DANCE1/DANCE1-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/08/arts/DANCE1/DANCE1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/08/arts/DANCE1/DANCE1-jumbo.jpg', 'height': 761, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/08/arts/DANCE1/DANCE1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/08/arts/DANCE1/DANCE1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Dance', 'kicker': 'Summer stages', 'content_kicker': None, 'print_headline': 'Dance', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dancing', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-05-05T23:52:14+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Claudia La Rocco', 'person': [{'firstname': 'Claudia', 'middlename': None, 'lastname': 'La Rocco', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/f29caa27-3e12-5ac6-962e-70014548f409', 'word_count': 1619, 'uri': 'nyt://article/f29caa27-3e12-5ac6-962e-70014548f409'}, {'abstract': 'The New York Philharmonic performed Bartok’s Second Violin Concerto and Beethoven’s “Eroica” Symphony at Avery Fisher Hall.', 'web_url': 'https://www.nytimes.com/2011/05/06/arts/music/new-york-philharmonic-plays-bartok-and-beethoven-review.html', 'snippet': 'The New York Philharmonic performed Bartok’s Second Violin Concerto and Beethoven’s “Eroica” Symphony at Avery Fisher Hall.', 'lead_paragraph': 'Alan Gilbert has generally tried to find a balance of elegance and grittiness in his programs with the New York Philharmonic, but it makes sense, now and again, to tip the scale one way or the other. The program Mr. Gilbert conducted on Wednesday evening tilted toward energetic brashness, with Bartok’s biting Second Violin Concerto on the first half and Beethoven’s “Eroica” Symphony on the second. The orchestra should have had Avery Fisher Hall rocking by the end of the evening, and there were moments when it did. But mostly the performances were more polite than supercharged. ', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/06/arts/06GILBERT-span/GILBERT-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/06/arts/06GILBERT-span/GILBERT-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/06/arts/06GILBERT-span/GILBERT-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/06/arts/06GILBERT-span/GILBERT-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/06/arts/06GILBERT-span/GILBERT-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Renderings Energetic and Brash', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Renderings Energetic And Brash', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'New York Philharmonic', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Gilbert, Alan', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-05-05T23:52:48+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Allan Kozinn', 'person': [{'firstname': 'Allan', 'middlename': None, 'lastname': 'Kozinn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/451d95af-35cb-52dc-ad53-bc4345d2bdab', 'word_count': 380, 'uri': 'nyt://article/451d95af-35cb-52dc-ad53-bc4345d2bdab'}, {'abstract': 'A listing of summer theater in the United States and Canada.', 'web_url': 'https://www.nytimes.com/2011/05/08/theater/summer-theater.html', 'snippet': 'A listing of summer theater in the United States and Canada.', 'lead_paragraph': 'Arkansas', 'print_section': 'AR', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/08/arts/THEATER1/THEATER1-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/08/arts/THEATER1/THEATER1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/08/arts/THEATER1/THEATER1-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None,