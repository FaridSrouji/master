cd3b50-6a24-50d2-8851-0febda36f4bd', 'word_count': 827, 'uri': 'nyt://article/ebcd3b50-6a24-50d2-8851-0febda36f4bd'}, {'abstract': 'The fund’s sexual norms are markedly different from those of Washington, leaving its female employees at risk of harassment.', 'web_url': 'https://www.nytimes.com/2011/05/20/business/20fund.html', 'snippet': 'The fund’s sexual norms are markedly different from those of Washington, leaving its female employees at risk of harassment.', 'lead_paragraph': 'WASHINGTON — It is an international island in the midst of the American capital, a sharp-elbowed place ruled by alpha male economists. The days are long, and employees are regularly pressed together for weeks on end during overseas “missions.” It is a climate in which romances often flourish — and lines are sometimes crossed.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/20/business/20fundPicA/20fundPicA-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/20/business/20fundPicA/20fundPicA-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/20/business/20fundPicA/20fundPicA-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'At I.M.F., Men on Prowl and Women on Guard', 'kicker': None, 'content_kicker': None, 'print_headline': 'At I.M.F., Men on Prowl and Women on Guard', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Strauss-Kahn, Dominique', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Sexual Harassment', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'International Monetary Fund', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Ethics (Institutional)', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-05-20T02:16:32+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Binyamin Appelbaum and Sheryl Gay Stolberg', 'person': [{'firstname': 'Binyamin', 'middlename': None, 'lastname': 'Appelbaum', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Sheryl', 'middlename': 'Gay', 'lastname': 'Stolberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/52317ede-e086-54b6-8d76-cee016b59954', 'word_count': 1098, 'uri': 'nyt://article/52317ede-e086-54b6-8d76-cee016b59954'}, {'abstract': 'A bill aimed at relieving school district mandates required by the state is a tough sell on both sides of the aisle.', 'web_url': 'https://www.nytimes.com/2011/05/20/us/20tteissler.html', 'snippet': 'A bill aimed at relieving school district mandates required by the state is a tough sell on both sides of the aisle.', 'lead_paragraph': 'Just past midnight, at the close of a 14-hour day last week on the floor of the Texas House, Representative Rob Eissler stood joking with reporters.', 'print_section': 'A', 'print_page': '19A', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/20/us/20TTESSLER/20TTESSLER-jumbo.jpg', 'height': 754, 'width': 641, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/20/us/20TTESSLER/20TTESSLER-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/20/us/20TTESSLER/20TTESSLER-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Education Legislation Struggle Breaks Old Alliances, Builds New Ones', 'kicker': 'The Texas Tribune', 'content_kicker': None, 'print_headline': 'Education Legislation Struggle Breaks Old Alliances, Builds New Ones', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Democratic Party', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'State Legislatures', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Education (K-12)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Texas', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-05-20T02:23:12+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Morgan Smith', 'person': [{'firstname': 'Morgan', 'middlename': None, 'lastname': 'Smith', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2a6bcb67-71ea-59f0-93d1-8cacb9bb2a42', 'word_count': 1025, 'uri': 'nyt://article/2a6bcb67-71ea-59f0-93d1-8cacb9bb2a42'}, {'abstract': 'The N.F.L. asked Thursday for more time to respond to the antitrust lawsuit brought by players in the Brady vs. N.F.L. case.', 'web_url': 'https://www.nytimes.com/2011/05/20/sports/football/nfl-requests-more-time-to-respond-to-players-lawsuit.html', 'snippet': 'The N.F.L. asked Thursday for more time to respond to the antitrust lawsuit brought by players in the Brady vs. N.F.L. case.', 'lead_paragraph': 'The N.F.L. asked Thursday for more time to respond to the antitrust lawsuit brought by players in the Brady vs. N.F.L. case. The N.F.L. has asked that the deadline, which is next Monday, be extended until July 6, arguing that the Court of Appeals for the Eighth Circuit is likely to have decided on the appeal of the now-delayed injunction that would end the lockout. That decision, the N.F.L. said, is likely to inform future actions, including whether to file a motion to dismiss the case. When the N.F.L. asked the players represented in the Brady suit to consent to the extension, they declined. The league’s motion asking for the extension is pending. The Brady plaintiffs would prefer no delays in the lawsuit, which, with its threat of treble damages if the league is found to have violated antitrust law with restrictions on free agency and the draft, may present the best leverage the players have in their contract negotiations. ', 'print_section': 'B', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'N.F.L. Requests More Time to Respond to Players’ Lawsuit', 'kicker': 'Sports Briefing | Pro Football', 'content_kicker': None, 'print_headline': 'N.F.L. Requests More Time To Respond to Players’ Lawsuit', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Lockouts', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'National Football League', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Organized Labor', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Antitrust Laws and Competition Issues', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Suits and Litigation', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-05-20T02:27:12+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Judy Battista', 'person': [{'firstname': 'Judy', 'middlename': None, 'lastname': 'Battista', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/ce7cc654-bd02-5e71-b874-4a2a002eb93c', 'word_count': 160, 'uri': 'nyt://article/ce7cc654-bd02-5e71-b874-4a2a002eb93c'}, {'abstract': 'Noodling, or catching catfish with bare hands, has stalwart fans but is illegal in the state. Now lawmakers are considering a bill that would change that.', 'web_url': 'https://www.nytimes.com/2011/05/20/us/20ttnoodling.html', 'snippet': 'Noodling, or catching catfish with bare hands, has stalwart fans but is illegal in the state. Now lawmakers are considering a bill that would change that.', 'lead_paragraph': 'Brady Knowlton has scurried up trees to escape elephants. He has been chased by lions. But in years of hunting, he said, no experience compares to plunging his bare hand into murky water and feeling the powerful jaw of a big catfish clamp down on his arm. ', 'print_section': 'A', 'print_page': '19A', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/20/us/20TTNOODLING1/20TTNOODLING1-articleLarge.jpg', 'height': 340, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/05/20/us/20TTNOODLING1/20TTNOODLING1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 340}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/20/us/20TTNOODLING1/20TTNOODLING1-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/05/20/us/20TTNOODLING1/20TTNOODLING1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/05/20/us/20TTNOODLING1/20TTNOODLING1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'There Is More Than One Way to Land a Catfish', 'kicker': 'The Texas Tribune', 'content_kicker': None, 'print_headline': 'There Is More Than One Way to Land a Catfish', 'name':