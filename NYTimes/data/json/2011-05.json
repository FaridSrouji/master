, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Consumer Protection', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mortgages', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Warren, Elizabeth', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Consumer Financial Protection Bureau', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-05-19T16:15:40+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Your Money', 'byline': {'original': 'By Ann Carrns', 'person': [{'firstname': 'Ann', 'middlename': None, 'lastname': 'Carrns', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/080dfc68-decf-5919-8b37-8d6cec5f9dd2', 'word_count': 342, 'uri': 'nyt://article/080dfc68-decf-5919-8b37-8d6cec5f9dd2'}, {'abstract': 'After a series of strong gallops over the past few days, Animal Kingdom enjoyed a more relaxed training program Thursday morning.', 'web_url': 'https://therail.blogs.nytimes.com/2011/05/19/a-quieter-morning-for-animal-kingdom/', 'snippet': 'After a series of strong gallops over the past few days, Animal Kingdom enjoyed a more relaxed training program Thursday morning.', 'lead_paragraph': 'After a series of strong gallops over the past few days, Animal Kingdom enjoyed a more relaxed training program Thursday morning in preparation for the Preakness Stakes on Saturday. We have not had quite as much rain here at Fair Hill as we have had recently, so he returned to the dirt track. This also gave the trainer Graham Motion the opportunity to let Animal Kingdom school a little in the gate.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Quieter Morning for Animal Kingdom', 'kicker': 'The Rail', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Preakness Stakes', 'rank': 1, 'major': 'N'}], 'pub_date'