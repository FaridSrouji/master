'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-11-22T15:24:09+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f1426090-43e8-59c4-b92a-e5f26ebdbaf4', 'word_count': 312, 'uri': 'nyt://article/f1426090-43e8-59c4-b92a-e5f26ebdbaf4'}, {'abstract': 'The filmmaker Guillermo del Toro’s new book offers a tour of his notebooks and his many collectibles.', 'web_url': 'https://www.nytimes.com/2013/11/24/books/review/del-toro-shares-his-curiosities.html', 'snippet': 'The filmmaker Guillermo del Toro’s new book offers a tour of his notebooks and his many collectibles.', 'lead_paragraph': 'Opening “Cabinet of Curiosities,” the filmmaker Guillermo del Toro’s oversize new book, is akin to bouncing around inside his hallucinatory brain. In addition to densely illustrated pages from notebooks for movies like “Hellboy” and “Pan’s Labyrinth,” it also includes pictures of Bleak House, where del Toro works and stores hundreds of artworks, figurines and props. “Catholics go to church, Jews go to temple,” del Toro writes. “I come here.”', 'print_section': 'BR', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/24/books/review/1124-bks-Openbook/1124-bks-Openbook-articleLarge.jpg', 'height': 427, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/24/books/review/1124-bks-Openbook/1124-bks-Openbook-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 427}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/24/books/review/1124-bks-Openbook/1124-bks-Ope