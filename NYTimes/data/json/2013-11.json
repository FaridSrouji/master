, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/04/arts/jp-barragan-2/jp-barragan-2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/04/arts/jp-barragan-2/jp-barragan-2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/04/arts/jp-barragan-2/jp-barragan-2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Tug of War Stretches Architect’s Legacy', 'kicker': None, 'content_kicker': None, 'print_headline': 'Tug of War Stretches Architect’s Legacy', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ARCHITECTURE', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Barragan, Luis', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Mexico', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Zanco, Federica', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Fehlbaum, Rolf', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Art in General', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Magid, Jill', 'rank': 9, 'major': 'N'}], 'pub_date': '2013-11-03T22:16:14+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Randy Kennedy', 'person': [{'firstname': 'Randy', 'middlename': None, 'lastname': 'Kennedy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fcd86561-b433-5cde-9369-fe477e0f77be', 'word_count': 1261, 'uri': 'nyt://article/fcd86561-b433-5cde-9369-fe477e0f77be'}, {'abstract': 'M.I.A., the British singer-rapper, included a live message from Julian Assange, as well as pan-cultural tunes from her new album, “Matangi,” to Terminal 5 on Friday.', 'web_url': 'https://www.nytimes.com/2013/11/04/arts/music/mia-and-julian-assange-on-live-video-come-to-terminal-5.html', 'snippet': 'M.I.A., the British singer-rapper, included a live message from Julian Assange, as well as pan-cultural tunes from her new album, “Matangi,” to Terminal 5 on Friday.', 'lead_paragraph': 'Not every dance party starts — as did M.I.A.’s show on Friday night at Terminal 5 — with a live video transmission from Julian Assange, the founder of WikiLeaks, urging a sold-out crowd to fight the “military occupation of cyberspace.” Mr. Assange called M.I.A. “the most courageous woman working in Western music” and “prescient.” He cited lyrics from “The Message,” a song M.I.A. released in 2010 with the lines “iPhone connected to the Internet/Connected to the Google/Connected to the government,” and added, “It turns out she was right.” ', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/04/arts/mia/mia-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/04/arts/mia/mia-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/04/arts/mia/mia-jumbo.jpg', 'height': 614, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/04/arts/mia/mia-superJumbo.jpg', 'height': 1229, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/04/arts/mia/mia-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/04/arts/mia/mia-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/04/arts/mia/mia-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Rebelling With Global Beats and WikiLeaks', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Rebelling With Global Beats and WikiLeaks', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'M I A', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Assange, Julian P', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-11-03T22:21:50+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Jon Pareles', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Pareles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/e157e49d-6900-52c0-816d-7d1aadfe5478', 'word_count': 580, 'uri': 'nyt://article/e157e49d-6900-52c0-816d-7d1aadfe5478'}, {'abstract': 'Glen Berger’s new book looks at the making of the Spider-Man musical that seemed to be doomed on several fronts.', 'web_url': 'https://www.nytimes.com/2013/11/04/books/song-of-spider-man-glen-bergers-take-on-a-troubled-show.html', 'snippet': 'Glen Berger’s new book looks at the making of the Spider-Man musical that seemed to be doomed on several fronts.', 'lead_paragraph': 'It’s unseemly to take pleasure in any creative failure. Artists strive and struggle all the time, and those who refuse to court the possibility of humiliation probably aren’t trying hard enough. If the sound of somebody’s well-intentioned work going splat makes you happy, perhaps you should seek worthier targets for your schadenfreude.', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/04/arts/book/book-articleLarge.jpg', 'height': 867, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/04/arts/book/book-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 867}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/04/arts/book/book-jumbo.jpg', 'height': 1024, 'width': 709, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/04/arts/book/book-superJumbo.jpg', 'height': 1198, 'width': 829, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/04/arts/book/book-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/04/arts/book/book-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/04/arts/book/book-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Spider-Man Caper Full of Broadway Characters, All of Them Real', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Spider-Man Caper Full of Broadway Characters, All of Them