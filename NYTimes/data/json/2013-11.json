 None, 'lastname': 'Zinoman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1a8bd9ec-ba98-5d10-ad5a-e95a058242a1', 'word_count': 997, 'uri': 'nyt://article/1a8bd9ec-ba98-5d10-ad5a-e95a058242a1'}, {'abstract': 'Britney Spears’s new album, “Britney Jean,” is out as an iTunes stream ahead of its Tuesday release date.', 'web_url': 'https://www.nytimes.com/2013/11/30/arts/music/britney-jean-britney-spearss-new-album-streaming-early.html', 'snippet': 'Britney Spears’s new album, “Britney Jean,” is out as an iTunes stream ahead of its Tuesday release date.', 'lead_paragraph': 'Britney Spears has been promising that her new album, “Britney Jean,” is her “most personal album ever” since July, when she first tweeted the phrase. Fans might have hoped for a candid look at a turbulent life: child stardom as a Mouseketeer, reinvention as a teenage tease and then a trashy sex symbol, marriages, motherhood, public meltdowns, stints in rehab and her rebound as a hitmaker, a judge on “The X Factor” and, at the end of December, a performer starting a two-year residency in Las Vegas. ', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/30/arts/30BRITNEY/30BRITNEY-jumbo.jpg', 'height': 498, 'width': 498, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/30/arts/30BRITNEY/30BRITNEY-superJumbo.jpg', 'height': 498, 'width': 498, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/30/arts/30BRITNEY/30BRITNEY-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/30/arts/30BRITNEY/30BRITNEY-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/30/arts/30BRITNEY/30BRITNEY-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Dancey, Trancey, and Dabs of Spice', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Dancey, Trancey, And Dabs Of Spice', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Spears, Britney', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-11-29T22:48:20+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Jon Pareles', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Pareles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/bd963393-6582-5a79-b731-05ffe641ee31', 'word_count': 852, 'uri': 'nyt://article/bd963393-6582-5a79-b731-05ffe641ee31'}, {'abstract': 'David Einhorn’s Greenlight Capital reported a 4.7 percent gain in the month of November, while Daniel Loeb’s Third Point Partners fund was up 2.7 percent for the month.', 'web_url': 'https://dealbook.nytimes.com/2013/11/29/gains-for-einhorn-and-loeb-could-bode-well-for-hedge-funds/', 'snippet': 'David Einhorn’s Greenlight Capital reported a 4.7 percent gain in the month of November, while Daniel Loeb’s Third Point Partners fund was up 2.7 percent for the month.', 'lead_paragraph': 'Forget about Black Friday. November is looking as if it could be the month that puts many hedge funds solidly in the black for the year, at least based on performance numbers for two notable portfolios.', '