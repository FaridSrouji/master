ATS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 950}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/03/sunday-review/03PLUTOCRATS/03PLUTOCRATS-jumbo.jpg', 'height': 1024, 'width': 647, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/03/sunday-review/03PLUTOCRATS/03PLUTOCRATS-superJumbo.jpg', 'height': 2048, 'width': 1293, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/03/sunday-review/03PLUTOCRATS/03PLUTOCRATS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/03/sunday-review/03PLUTOCRATS/03PLUTOCRATS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/03/sunday-review/03PLUTOCRATS/03PLUTOCRATS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Plutocrats vs. Populists', 'kicker': 'Opinion', 'content_kicker': None, 'print_headline': 'Plutocrats Vs. Populists', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Income Inequality', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Freeland, Chrystia', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'High Net Worth Individuals', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Philanthropy', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'de Blasio, Bill', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Bloomberg, Michael R', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Gates, Bill', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'va