ine': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Iraq War (2003-11)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Post-Traumatic Stress Disorder', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Suicides and Suicide Attempts', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Traumatic Brain Injury', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Veterans Day (US)', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'National Guard', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Veterans Affairs Department', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-11-11T13:30:30+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'byline': {'original': 'By Howard Somers and Jean Somers', 'person': [{'firstname': 'Howard', 'middlename': None, 'lastname': 'Somers', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Jean', 'middlename': None, 'lastname': 'Somers', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c1d84c72-b3a4-511c-8436-03b5b82bd9e9', 'word_count': 1462, 'uri': 'nyt://article/c1d84c72-b3a4-511c-8436-03b5b82bd9e9'}, {'abstract': 'The gunman also killed himself, the police said. Two of his victims were in a rock band called the Yellow Dogs, made up of other Iranian expatriates.', 'web_url': 'https://www.nytimes.com/2013/11/12/nyregion/4-dead-in-brooklyn-murder-suicide-police-say.html', 'snippet': 'The gunman also killed himself, the police said. Two of his victims were in a rock band called the Yellow Dogs, made up of other Iranian expatriates.', 'lead_paragraph': 'For their music they had risked the wrath of Iran’s government, practicing American-style rock in makeshift soundproof studios and performing it in underground clubs and parking lots, despite the threat of fines, detention or arrest. Growing up together in Tehran, they had found a sound: part punk, part garage rock, part their own invention.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/12/nyregion/SHOOTING/SHOOTING-articleLarge-v2.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/12/nyregion/SHOOTING/SHOOTING-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/12/nyregion/SHOOTING/SHOOTING-jumbo-v2.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/12/nyregion/SHOOTING/SHOOTING-superJumbo-v2.jpg', 'height': 1152, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/12/nyregion/SHOOTING/SHOOTING-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/12/nyregion/SHOOTING/SHOOTING-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/12/nyregion/SHOOTING/SHOOTING-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Bloody End for Iranian Rockers Seeking Musical Freedom in U.S.', 'kicker': None, 'content_kicker': None, 'print_headline': 'Bloody End for Iranian Rockers\r\nSeeking Musical Freedom in U.S.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations',