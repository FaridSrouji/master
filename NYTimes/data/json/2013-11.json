ine': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Supermarkets and Grocery Stores', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Upper West Side (Manhattan, NY)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Zingone Brothers (Manhattan, NY)', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-11-08T00:22:19+0000', 'document_type': 'multimedia', 'news_desk': 'New York', 'section_name': 'New York', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/ab83b79b-0785-5f99-b0bd-f9e394443abd', 'word_count': 0, 'uri': 'nyt://slideshow/ab83b79b-0785-5f99-b0bd-f9e394443abd'}, {'abstract': 'Joshua K. Dubrow and Jimi Adams, the authors of a study, write that young people should not be discouraged from pursuing sports as a means of upward mobility.', 'web_url': 'https://www.nytimes.com/2013/11/08/opinion/youth-and-sports.html', 'snippet': 'Joshua K. Dubrow and Jimi Adams, the authors of a study, write that young people should not be discouraged from pursuing sports as a means of upward mobility.', 'lead_paragraph': 'To the Editor:', 'print_section': 'A', 'print_page': '34', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Youth and Sports', 'kicker': 'Letter', 'content_kicker': None, 'print_headline': 'Youth and Sports', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Youth', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Scholarships and Fellowships', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'National Basketball Assn', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Athletics and Sports', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-11-08T00:23:50+0000', 'document_type': 'article', 'news_desk': 'Letters', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/ec3af83a-5963-5736-bacd-2ec574d8cd2c', 'word_count': 205, 'uri': 'nyt://article/ec3af83a-5963-5736-bacd-2ec574d8cd2c'}, {'abstract': 'The wing discusses his winning goal in May’s Champions League final and his thoughts on playing in some of the biggest rivalries in Europe.', 'web_url': 'https://www.nytimes.com/2013/11/08/sports/soccer/q-and-a-with-bayern-munichs-arjen-robben.html', 'snippet': 'The wing discusses his winning goal in May’s Champions League final and his thoughts on playing in some of the biggest rivalries in Europe.', 'lead_paragraph': 'Arjen Robben has won nearly every title while playing for club teams in the Netherlands, England, Spain and Germany. One year after missing a crucial penalty kick for Bayern Munich in the Champions League final against Chelsea in Munich’s home stadium, the Allianz Arena, Robben silenced (some) doubters by scoring the winning goal as Munich defeated its Bundesliga rival, Borussia Dortmund, to win the Champions League title at Wembley Stadium last May. Robben, 29, who plays wing for Munich, spoke with Jack Bell of The Times before sustaining an injury against Hertha Berlin in late October.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/04/sports/soccer/04robben2/04robben2-articleLarge.jpg', 'height': 410, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/04/sports/soccer/04robben2/04robben2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 410}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/04/sports/soccer/04robben2/04robben2-jumbo.jpg', 'height': 700, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/04/sports/soccer/04robben2/04robben2-superJumbo.jpg', 'height': 1399, 'wi