jor': 'N'}, {'name': 'organizations', 'value': 'Hezbollah', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Beirut (Lebanon)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Iran', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Lebanon', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-11-20T21:58:32+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Blogs', 'byline': {'original': 'By Christine Hauser', 'person': [{'firstname': 'Christine', 'middlename': None, 'lastname': 'Hauser', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e306db43-56cc-5dcc-b042-9dfaebae388b', 'word_count': 314, 'uri': 'nyt://article/e306db43-56cc-5dcc-b042-9dfaebae388b'}, {'abstract': 'Sporting overalls and arms covered in tattoos, Spleef Mczaul was recently walking along the street in the Maboneng Precinct in Johannesburg.', 'web_url': 'https://www.nytimes.com/2013/11/21/fashion/Diversity-in-fashion-in-johannesburg-south-africa.html', 'snippet': 'Sporting overalls and arms covered in tattoos, Spleef Mczaul was recently walking along the street in the Maboneng Precinct in Johannesburg.', 'lead_paragraph': 'Sporting overalls, yellow tinted glasses and arms covered in tattoos, Spleef Mczaul was recently walking along the street in the Maboneng Precinct in Johannesburg. Mr. Mczaul, who is opening a vintage store in the area, credits the neighborhood for bringing diversity in fashion to South Africa. “It’s people from different places coming together,” Mr. Mczaul said. “You’ll see someone who is wearing an English coat but with an African-print T-shirt.”', 'print_section': 'E', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Video: Fashion Diversity in Africa', 'kicker': 'Intersection', 'content_kicker': None, 'print_headline': 'Diversity In Africa', 'name': None, 'seo': None, 'sub': None}, 'key