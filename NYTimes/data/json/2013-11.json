rk Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/08/giving/CELL/CELL-articleLarge.jpg', 'height': 800, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/08/giving/CELL/CELL-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 800}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/08/giving/CELL/CELL-jumbo.jpg', 'height': 1024, 'width': 768, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/08/giving/CELL/CELL-superJumbo.jpg', 'height': 2048, 'width': 1536, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/08/giving/CELL/CELL-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/08/giving/CELL/CELL-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/08/giving/CELL/CELL-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Ubiquitous Across Globe, Cellphones Have Become Tool for Doing Good', 'kicker': None, 'content_kicker': None, 'print_headline': 'Ubiquitous Across Globe, Cellphones Have Become Tool for Doing Good', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cellular Telephones', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Philanthropy', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Third World and Developing Countries', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-11-08T19:02:19+0000', '