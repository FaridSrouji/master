ajor': 'N'}], 'pub_date': '2013-11-18T22:43:12+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By DIANA B. HENRIQUES', 'person': [{'firstname': 'Diana', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/366552b6-7bfe-551c-9c51-620152f3856a', 'word_count': 748, 'uri': 'nyt://article/366552b6-7bfe-551c-9c51-620152f3856a'}, {'abstract': 'New releases from Blood Orange, Daughtry and Randy Weston and Billy Harper.', 'web_url': 'https://www.nytimes.com/2013/11/19/arts/music/blood-orange-and-daughtry-have-new-albums.html', 'snippet': 'New releases from Blood Orange, Daughtry and Randy Weston and Billy Harper.', 'lead_paragraph': 'The work of Devonté Hynes radiates a thorough, passionate, forgetting-to-eat-or-sleep love for the last 30 years of pop. His current project, Blood Orange, is a trans-Atlantic notion of urban dance music from the early ‘80s to the early ‘90s: freestyle, Prince ballads, Janet Jackson’s “Control,” Neneh Cherry. It reads now, on balance, as a New York sound. But it’s a New York as experienced by an outsider, exotic and blurry, with an indeterminate time stamp.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/19/arts/newmusic/newmusic-articleLarge.jpg', 'height': 512, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/19/arts/newmusic/newmusic-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 512}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/19/arts/newmusic/newmusic-jumbo.jpg', 'height': 873, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/19/arts/newmusic/newmusic-superJumbo.jpg', 'height': 1747, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/19/arts/newmusic/newmusic-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/19/arts/newmusic/newmusic-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/19/arts/newmusic/newmusic-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Crossing the Ocean to Discover the Personal', 'kicker': None, 'content_kicker': None, 'print_headline': 'Crossing The Ocean To Discover The Personal', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Daughtry, Chris', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Harper, Billy', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Weston, Randy', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-11-18T22:45:25+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Ben Ratliff, Jon Caramanica and Nate Chinen', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Ratliff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Jon', 'middlename': None, 'lastname': 'Caramanica', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}, {'firstname': 'Nate', 'middlename': None, 'lastname': 'Chinen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 3}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/f1fd768f-7b89-5f7b-be42-d5107eee56bb', 'word_count': 1265, 'uri': 'nyt://article/f1fd768f-7b89-5f7b-be42-d5107eee56bb'}, {'abstract': 'Birds are migrating earlier and earlier each year, and scientists have long suspected that climate change is responsible.', 'web_url': 'https://www.nytimes.com/2013/11/19/science/an-earlier-exodus-amid-climate-change.html', 'snippet': 'Birds are migrating earlier and earlier each year, and scientists have long suspected that climate change is responsible.', 'lead_paragraph': 'Birds are migrating earlier and earlier each year, and scientists have long suspected that climate change is responsible. A new study by researchers at the University of East Anglia in England shows that individual birds migrate like clockwork, but nesting and hatching are happening earlier as a result of warmer temperatures, and this appears to be linked to the advancing of overall migration patterns.', 'print_section': 'D', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/19/science/19FLOA_SPAN/19FLOA-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/19/science/19FLOA_SPAN/19FLOA-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/19/science/19FLOA_SPAN/19FLOA-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/19/science/19FLOA_SPAN/19FLOA-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thu