nk': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Philippines', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Humanitarian Aid', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Shortages', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-11-14T08:10:49+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Gerry Mullany', 'person': [{'firstname': 'Gerry', 'middlename': None, 'lastname': 'Mullany', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/72d3bf8c-297d-5977-b30f-5611240f4f20', 'word_count': 518, 'uri': 'nyt://article/72d3bf8c-297d-5977-b30f-5611240f4f20'}, {'abstract': 'Mr. Bal spoke about his unexpected termination from the magazine.', 'web_url': 'https://india.blogs.nytimes.com/2013/11/14/a-conversation-with-former-political-editor-of-open-magazine-hartosh-singh-bal/', 'snippet': 'Mr. Bal spoke about his unexpected termination from the magazine.', 'lead_paragraph': 'Hartosh Singh Bal, the political editor of Open magazine, announced on Wednesday that he had received a letter of termination. It was the second high-profile sacking within the Indian media in the space of a month; in late October, Siddharth Varadarajan resigned as editor-in-chief of The Hindu, an influential daily newspaper, when the paper’s owners told him he would be replaced.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/14/world/asia/14-hartosh-IndiaInk/14-hartosh-IndiaInk-articleLarge.jpg', 'height': 889, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/14/world/asia/14-hartosh-IndiaInk/14-hartosh-IndiaInk-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 889}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None