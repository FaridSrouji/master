mage', 'url': 'images/2010/05/27/business/media/stuart-elliott-headshot/stuart-elliott-headshot-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Q. and A. With Stuart Elliott', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Kraft Foods Group Inc', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': "Domino's Pizza Inc", 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Crispin Porter & Bogusky', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-11-18T17:32:08+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Stuart Elliott', 'person': [{'firstname': 'Stuart', 'middlename': None, 'lastname': 'Elliott', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Question', '_id': 'nyt://article/2455ef03-261b-5167-8066-65082deb940f', 'word_count': 821, 'uri': 'nyt://article/2455ef03-261b-5167-8066-65082deb940f'}, {'abstract': 'Ketchum acquired Icon International Communications of Singapore and Pete Naylor was named to an Interactive Advertising Bureau publisher-in-residence program.', 'web_url': 'https://www.nytimes.com/2013/11/18/business/media/accounts-and-people-of-note-in-the-advertising-industry.html', 'snippet': 'Ketchum acquired Icon International Communications of Singapore and Pete Naylor was named to an Interactive Advertising Bureau publisher-in-residence program.', 'lead_paragraph': 'Nathy Aviram joined McCann Erickson New York as executive vice president and director of integrated production. He assumes duties from Diane Hill, who had been senior vice president and director of integrated production; she left to return to BBDO New York, where she had previously worked, and is now senior vice president and group executive producer there. Mr. Aviram has worked for agencies that include TBWA/Chiat/Day New York and Y&R New York. McCann Erickson New York is part of the McCann Erickson Worldwide division of the McCann Worldgroup, which is owned by the Interpublic Group of Companies.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Accounts and People of Note in the Advertising Industry', 'kicker': 'Webdenda', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Appointments and Executive Changes', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Public Relations and Publicity', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Mergers, Acquisitions and Divestitures', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-11-18T17:32:08+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/e20588e2-ebd8-5fb1-a5c1-4fc7064da51a', 'word_count': 1312, 'uri': 'nyt://article/e20588e2-ebd8-5fb1-a5c1-4fc7064da51a'}, {'abstract': 'Helen Sneed’s “Fix Me, Jesus,” at Abingdon Theater, delves into a panic attack.', 'web_url': 'https://www.nytimes.com/2013/11/19/theater/reviews/histrionic-back-story-of-a-wedding-party.html', 'snippet': 'Helen Sneed’s “Fix Me, Jesus,” at Abingdon Theater, delves into a panic attack.', 'lead_paragraph': 'The cause of Annabell Armstrong’s latest panic attack seems petty: Annabell (a frenetic Polly Lee) is at Neiman Marcus in Dallas, and she cannot find the perfect dress for a cousin’s wedding. But as Helen Sneed’s 95-minute play explains again and again, her histrionics are but a manifestation of a lifetime of accumulated anxieties and emotional traumas, as evidenced by the memories that wander, unwanted, into the store’s dressing room. ', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/19/theater/19fix-web/19fix-web-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/19/theater/19fix-web/19fix-web-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/19/theater/19fix-web/19fix-web-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/19/theater/19fix-web/19fix-web-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/19/theater/19fix-web/19fix-web-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/19/theater/19fix-web/19fix-web-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/19/theater/19fix-web/19fix-web-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Before the Wedding, the Histrionics (but Not the Bride’s)', 'kicker': 'Theater Review', 'content_kicker': None, 'print_headline': 'Before the Wedding, the Histrionics (but Not the Bride’s)', 'name': None, 'seo': Non