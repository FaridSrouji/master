2b2-0925-5f42-9249-a901f976e7a6', 'word_count': 1107, 'uri': 'nyt://article/d1d922b2-0925-5f42-9249-a901f976e7a6'}, {'abstract': 'Madison Gate Records, a little-known unit of Sony Pictures, signed Pentatonix after the five-member group won the television talent show “The Sing-Off.”', 'web_url': 'https://www.nytimes.com/2013/11/18/business/media/behind-a-cappella-groups-success-a-tiny-label.html', 'snippet': 'Madison Gate Records, a little-known unit of Sony Pictures, signed Pentatonix after the five-member group won the television talent show “The Sing-Off.”', 'lead_paragraph': 'CULVER CITY, Calif. — If you stopped 100 people on the manicured Sony Pictures lot here and asked them to point you toward Shelly Bunge’s office, they would most likely give you the same blank stare. Who?', 'print_section': 'B', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Tiny Label Is Behind an a Cappella Group’s Success', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': 'A Tiny Label Is Behind An A Cappella Group’s Success', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Sony Corporation', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Pentatonix (Music Group)', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Madison Gate Records', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Bunge, Shelly', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-11-17T23:23:08+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Brooks Barnes', 'person': [{'firstname': 'Brooks', 'middlename': None, 'lastname': 'Barnes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/36bdf4fa-21ff-5729-a4b1-1eaf3f6fc181', 'word_count': 361, 'uri': 'nyt://article/36bdf4fa-21ff-5729-a4b1-1eaf3f6fc181'}, {'abstract': 'The Richard Tucker Music Foundation said on Sunday that it had increased the size of the cash prize given to the winner of the annual Richard Tucker Award to $50,000 from $30,000.', 'web_url': 'https://www.nytimes.com/2013/11/18/arts/music/larger-prize-for-tucker-award.html', 'snippet': 'The Richard Tucker Music Foundation said on Sunday that it had increased the size of the cash prize given to the winner of the annual Richard Tucker Award to $50,000 from $30,000.', 'lead_paragraph': 'The Richard Tucker Music Foundation said on Sunday that it had increased the size of the cash prize given to the winner of the annual Richard Tucker Award to $50,000 from $30,000. As previously announced, the mezzo-soprano Isabel Leonard is the 2013 recipient at the ceremony, scheduled for Sunday night at Avery Fisher Hall, Lincoln Center; this year is the centenary of Tucker’s birth. The award goes to an artist considered on the verge of a major international career. Ms. Leonard is a regular at the Metropolitan Opera and has recently performed in productions of Mozart’s “Così Fan Tutte” and Poulenc’s “Dialogues of the Carmelites.”', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Larger Prize for Tucker Award', 'kicker': 'Arts, Briefly', 'content_kicker': None, 'print_headline': 'Larger Prize For Tucker Award', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Awards, Decorations and Honors', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Tucker, Richard, Music Foundation', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Opera', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-11-17T23:31:04+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'Compiled by Adam W. Kepler', 'person': [{'firstname': 'Adam', 'middlename': 'W.', 'lastname': 'Kepler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/b751c688-e482-56eb-8095-4026d92e149b', 'word_count': 105, 'uri': 'nyt://article/b751c688-e482-56eb-8095-4026d92e149b'}, {'abstract': 'Mobile games are a major growth opportunity, and analysts say a recent flop underscores the challenges Disney faces in a shifting marketplace.', 'web_url': 'https://www.nytimes.com/2013/11/18/business/media/disney-struggles-to-make-its-free-gaming-apps-pay.html', 'snippet': 'Mobile games are a major growth opportunity, and analysts say a recent flop underscores the challenges Disney faces in a shifting marketplace.', 'lead_paragraph': 'LOS ANGELES — Two months ago, Disney released a sequel to Where’s My Water?, a hit smartphone game about a showering alligator. Hopes were high: Disney had pointed to the original game as evidence of overdue traction in mobile gaming.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/18/business/disney1/disney1-articleLarge.jpg', 'height': 376, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/18/business/disney1/disney1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 376}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/18/business/disney1/disney1-jumbo.jpg', 'height': 626, 'width': 1000, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/18/business/disney1/disney1-superJumbo.jpg', 'height': 626, 'width': 1000, 'subType': 'superJumbo', 'crop_nam