mbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Familiar Drama Shines Among Guts and Gore', 'kicker': None, 'content_kicker': None, 'print_headline': 'Familiar Drama Shines Among Guts and Gore', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-11-08T19:16:50+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Mike Hale', 'person': [{'firstname': 'Mike', 'middlename': None, 'lastname': 'Hale', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9b5d3c85-a19b-54a2-97c9-5f7bc351ebc2', 'word_count': 1066, 'uri': 'nyt://article/9b5d3c85-a19b-54a2-97c9-5f7bc351ebc2'}, {'abstract': 'The cartoonist Garry Trudeau conceived the comedy “Alpha House,” with John Goodman, while on the road with Jonathan Alter.', 'web_url': 'https://www.nytimes.com/2013/11/10/arts/television/alpha-house-amazons-original-series-years-in-the-making.html', 'snippet': 'The cartoonist Garry Trudeau conceived the comedy “Alpha House,” with John Goodman, while on the road with Jonathan Alter.', 'lead_paragraph': '“Alpha House,” the first original series from Amazon, may be about four fictional scandal-clad senators living in a group house in Washington, but verisimilitude is a foundational element. The Russell Senate Office Building has been painstakingly recreated at Kaufman Astoria Studios in Queens, right down to the hideaways and mail slots. And while there are quite a few other shows set in the milieu of Beltway politics, there is none other in which Barack Obama is president and Mitch McConnell is the Senate minority leader, as they are here. But there is one dead giveaway that we are not in the version of Washington that we read about every day: The Republicans and Democrats on “Alpha House” actually speak to one another.', 'print_section': 'AR', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/10/arts/10ALPHA1_SPAN/10ALPHA1_SPAN-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/10/arts/10ALPHA1_SPAN/10ALPHA1_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/10/arts/10ALPHA1_SPAN/10ALPHA1_SPAN-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/10/arts/10ALPHA1_SPAN/10ALPHA1_SPAN-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/10/arts/10ALPHA1_SPAN/10ALPHA1_SPAN-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/10/arts/10ALPHA1_SPAN/10ALPHA1_SPAN-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/10/arts/10ALPHA1_SPAN/10ALPHA1_SPAN-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Animal House (Republican Style)', 'kicker': None, 'content_kicker': None, 'print_headline': 'Animal House (Republican Style)', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Carr, David', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Web-Original Programming', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'AMAZON.COM INC', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Trudeau, Garry', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Goodman, John', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Alter, Jonathan', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-11-08T19:18:59+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By David Carr', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Carr', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/41c11f71-3a5a-53c0-8b46-cbe750a074c5', 'word_count': 1586, 'uri': 'nyt://article/41c11f71-3a5a-53c0-8b46-cbe750a074c5'}, {'abstract': 'The comedian Jenny Slate, who has been an “SNL” regular, TV actress and the animating force behind the stop-motion hit “Marcel the Shell,” talks about her career on the eve of a stand-up gig in New York.', 'web_url': 'https://www.nytimes.com/2013/11/10/arts/television/jenny-slates-quirky-performance-hybrid.html', 'snippet': 'The comedian Jenny Slate, who has been an “SNL” regular, TV actress and the animating force behind the stop-motion hit “Marcel the Shell,” talks about her career on the eve of a stand-up gig in New York.', 'lead_paragraph': 'The comedian Jenny Slate specializes in terrifying, from the lunatic girlfriend of Aziz Ansari’s Tom Haverford on “Parks and Recreation” to the catty, hypercompetitive frenemy on the new HBO comedy “Hello Ladies.” But her ideal role is even scarier. “The lady that Ruth Gordon plays in ‘Rosemary’s Baby’ is kind of my dream job,” she said, giggling. “She’s strangely maternal, and very New York, and completely satanic.”', 'print_