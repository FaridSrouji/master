': 'image', 'url': 'images/2013/11/13/business/13fallon/13fallon-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/13/business/13fallon/13fallon-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/13/business/13fallon/13fallon-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/13/business/13fallon/13fallon-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/13/business/13fallon/13fallon-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Fallon, Nearing ‘Tonight’ Debut, Says He Has First Guest in Mind', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Fallon, Jimmy', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'National Broadcasting Co', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Tonight Show (TV Program)', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-11-12T23:32:27+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Bill Carter', 'person': [{'firstname': 'Bill', 'middlename': None, 'lastname': 'Carter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9149caa4-86c5-5e3f-ad63-6422132f5359', 'word_count': 621, 'uri': 'nyt://article/9149caa4-86c5-5e3f-ad63-6422132f5359'}, {'abstract': 'As researchers sift through data from a security breach at Adobe, they are discovering that people have may have inadvertently shown hackers passwords for bank accounts, email, Facebook and home garage door codes on the Adobe website.', 'web_url': 'https://bits.blogs.nytimes.com/2013/11/12/adobe-breach-inadvertently-tied-to-other-accounts/', 'snippet': 'As researchers sift through data from a security breach at Adobe, they are discovering that people have may have inadvertently shown hackers passwords for bank accounts, email, Facebook and home garage door codes on the Adobe website.', 'lead_paragraph': 'This week,\xa0Ammon Bartram, a software engineer and co-founder of SocialCam, was talking to a friend about a recent security breach at Adobe in which hackers were able to gain access to tens of millions of encrypted passwords and email addresses.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/12/technology/adobe/adobe-jumbo.jpg', 'height': 210, 'width': 592, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/12/technology/adobe/adobe-superJumbo.jpg', 'height': 210, 'width': 592, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/12/technology/adobe/adobe-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/12/technology/adobe/adobe-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'image