N'}], 'pub_date': '2013-11-14T02:07:16+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Pat Borzi', 'person': [{'firstname': 'Pat', 'middlename': None, 'lastname': 'Borzi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5eb7aedc-1145-50b0-afae-1aef19926100', 'word_count': 847, 'uri': 'nyt://article/5eb7aedc-1145-50b0-afae-1aef19926100'}, {'abstract': 'A court also released documents documents that painted a salacious picture of a combative, drunken mayor who assaulted staff members and entertained suspected prostitutes.', 'web_url': 'https://www.nytimes.com/2013/11/14/world/americas/council-asks-toronto-mayor-to-step-down-temporarily.html', 'snippet': 'A court also released documents documents that painted a salacious picture of a combative, drunken mayor who assaulted staff members and entertained suspected prostitutes.', 'lead_paragraph': 'OTTAWA — Shortly after Toronto’s City Council voted Wednesday to ask Mayor Rob Ford to step down temporarily, a court released documents that painted a salacious picture of a combative, drunken mayor who assaulted staff members and entertained suspected prostitutes. ', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Council Asks Toronto Mayor to Step Down Temporarily', 'kicker': None, 'content_kicker': None, 'print_headline': 'Council Asks Toronto Mayor To Step Down Temporarily', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Ford, Robert B', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Austen, Ian', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Toronto (Ontario)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Mayors', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Drug Abuse and