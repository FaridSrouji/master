ajor': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-11-22T03:26:50+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Ginia Bellafante', 'person': [{'firstname': 'Ginia', 'middlename': None, 'lastname': 'Bellafante', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/88936ebe-c990-5ca5-99b1-be31117d0823', 'word_count': 937, 'uri': 'nyt://article/88936ebe-c990-5ca5-99b1-be31117d0823'}, {'abstract': 'Xavier Cruz, 14, enjoys school, but found it hard to research topics without a computer at home. Now, through the Neediest Cases Fund, he has one.', 'web_url': 'https://www.nytimes.com/2013/11/22/nyregion/plans-for-college-made-more-likely-with-a-laptop.html', 'snippet': 'Xavier Cruz, 14, enjoys school, but found it hard to research topics without a computer at home. Now, through the Neediest Cases Fund, he has one.', 'lead_paragraph': 'The journey from home to school is an effortless walk for Xavier Cruz, 14, who just strolls around the corner and down the block. But considering where he is going, he may as well be traveling to another world.', 'print_section': 'A', 'print_page': '25', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/22/nyregion/neediest/neediest-articleLarge.jpg', 'height': 395, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/22/nyregion/neediest/neediest-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 395}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/22/nyregion/neediest/neediest-jumbo.jpg', 'height': 673, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumb