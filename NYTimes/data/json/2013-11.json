or': 'N'}, {'name': 'subject', 'value': 'Delays (Transportation)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Prices (Fares, Fees and Rates)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'Goldman Sachs Group Inc', 'rank': 10, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 11, 'major': 'N'}, {'name': 'subject', 'value': 'Metals and Minerals', 'rank': 12, 'major': 'N'}, {'name': 'subject', 'value': 'Commodities', 'rank': 13, 'major': 'N'}, {'name': 'organizations', 'value': 'London Metal Exchange', 'rank': 14, 'major': 'N'}], 'pub_date': '2013-11-08T01:41:06+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By David Kocieniewski', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Kocieniewski', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7331cd3c-db20-5559-8015-700773973603', 'word_count': 609, 'uri': 'nyt://article/7331cd3c-db20-5559-8015-700773973603'}, {'abstract': 'A trove of historic materials discovered after the fall of Saddam Hussein belongs in the United States.', 'web_url': 'https://www.nytimes.com/2013/11/08/opinion/keep-the-iraqi-jews-legacy-safe-in-america.html', 'snippet': 'A trove of historic materials discovered after the fall of Saddam Hussein belongs in the United States.', 'lead_paragraph': 'SEVENTY-FIVE years ago, about 120,000 Jews lived in Iraq. In Baghdad, they were prominent in business and the professions — doctors, lawyers, bankers, professors, musicians, writers, artists, engineers. Last summer, a visitor just back from Iraq told me he could account for only five Iraqi Jews alive in the country. Not 5,000. Not 500. Five. They are too old to leave. When they die, there will be none.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Keep the Iraqi Jews’ Legacy Safe — in America', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'Keep the Iraqi Jews’ Legacy Safe — in America', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Jews and Judaism', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Iraq', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Holocaust and the Nazi Era', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'ANTI-SEMITISM', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Discrimination', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-11-08T01:42:20+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Cynthia Kaplan Shamash', 'person': [{'firstname': 'Cynthia', 'middlename': 'Kaplan', 'lastname': 'Shamash', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/da774f1c-c9be-513f-b151-9c9f52333173', 'word_count': 1080, 'uri': 'nyt://article/da774f1c-c9be-513f-b151-9c9f52333173'}, {'abstract': 'The pervasive presence of government in French life, from workplace rules to health and education benefits, is now the subject of a great debate.', 'web_url': 'https://www.nytimes.com/2013/11/08/world/europe/as-costs-rise-french-grapple-with-their-safety-nets.html', 'snippet': 'The pervasive presence of government in French life, from workplace rules to health and education benefits, is now the subject of a great debate.', 'lead_paragraph': 'ST.-ÉTIENNE, France — Patrick Jouve, the owner of a game store on the Rue Louis Braille here, assails the government regulations that limit the size of the bright chess set and bouncing balls he has painted on his storefront. If the painting covers more than 36 feet, it constitutes advertising and he has to pay a fee of $1,350.', 'print_section': 'A', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/08/world/europe/france1/france1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/08/world/europe/france1/france1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/08/world/europe/france1/france1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/08/world/europe/france1/france1-superJumbo.jpg', 'height': 1367, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/08/world/europe/france1/france1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/08/world/europe/france1/france1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/08/world/europe/france1/france1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Under Strain, France Examines Its Safety Net', 'kicker': None, 'content_kicker': None, 'print_headline': 'Under Strain, France Examines Its Safety Net', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Rubin, Alissa Johannsen', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'France', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Pensions and Retirement Plans', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Social Conditions and Trends', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Unemployment Insurance', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-11-08T01:42:37+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Alissa J. Rubin', 'person': [{'firstname': 'Alissa', 'middlename': 'J.', 'lastname': 'Rubin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4f785959-d00b-51dd-8144-dda588feaf19', 'word_count': 1284, 'uri': 'nyt://article/4f785959-d00b-51dd-8144-dda588feaf19'}, {'abstract': 'The Horcón Tract was a chunk of territory that Americans forgot. Let’s make sure we don’t do that again in the name of border security.', 'web_url': 'https://www.nytimes.com/2013/11/08/opinion/a-bend-in-the-river.html', 'snippet': 'The Horcón Tract was a chunk of territory that Americans forgot. Let’s make sure we don’t do that again in the name of border security.', 'lead_paragraph': 'DURHAM, N.C. — IN 1970, the United States gave away 413 acres of American territory on the southern bank of the Rio Grande called the Horcón Tract. The handover was something of a formality, since for more than half a century everyone had thought that this remote patch of bottomland was actually part of Mexico. It wasn’t — it had just been forgotten after a Texas company illegally diverted the Rio Grande in 1906. ', 'print_section': 'A', 'print_page': '35', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Bend in the River', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'A Bend in the River', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Mexico', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Kelly, Stephen R', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States International Relations', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Fences', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Border Patrol (US)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-11-08T01:51:01+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Stephen R. Kelly', 'person': [{'firstname': 'Stephen', 'middlename': 'R.', 'lastname': 'Kelly', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/5999b6b9-bc9b-5050-8ff3-eb4f69fbbdf9', 'word_count': 1012, 'uri': 'nyt://article/5999b6b9-bc9b-5050-8ff3-eb4f69fbbdf9'}, {'abstract': 'Complaints with the state Department of Labor about wage and hour violations were stacked 14,000 high at the end of July.', 'web_url': 'https://www.nytimes.com/2013/11/08/nyregion/exhausted-workers-recall-minimal-efforts-to-enforce-a-minimum-wage-law.html', 'snippet': 'Complaints with the state Department of Labor about wage and hour violations were stacked 14,000 high at the end of July.', 'lead_paragraph': 'Two weeks ago, Pin Zhu Zheng, who says she worked 69 hours a week behind a steam table at a Chinatown restaurant on Centre Street, presented herself at a New York State office to report what seemed to be flagrant lawbreaking by her former bosses.', 'print_section': 'A', 'print_page': '28', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/08/nyregion/about/about-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 