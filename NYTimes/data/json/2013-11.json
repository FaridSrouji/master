11/04/sports/04VETS_ss-slide-17L2/04VETS_ss-slide-17L2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/04/sports/04VETS_ss-slide-17L2/04VETS_ss-slide-17L2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/04/sports/04VETS_ss-slide-17L2/04VETS_ss-slide-17L2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Recovery on the Roads', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Marathon Running', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'New York City Marathon', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Veterans', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-11-03T22:01:38+0000', 'document_type': 'multimedia', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/37cb0336-d36a-5ccc-9f83-e5e4df2445dd', 'word_count': 0, 'uri': 'nyt://slideshow/37cb0336-d36a-5ccc-9f83-e5e4df2445dd'}, {'abstract': 'Michel Fokine’s “Les Sylphides,” Twyla Tharp’s “Bach Partita” and Mark Morris’s “Gong” returned to American Ballet Theater’s repertory after long absences.', 'web_url': 'https://www.nytimes.com/2013/11/04/arts/dance/american-ballet-theaters-sylphides-and-gong.html', 'snippet': 'Michel Fokine’s “Les Sylphides,” Twyla Tharp’s “Bach Partita” and Mark Morris’s “Gong” returned to American Ballet Theater’s repertory after long absences.', 'lead_paragraph': 'All three works shown on Friday by American Ballet Theater at the David H. Koch Theater were making welcome returns to the company’s repertory after too-long absences. All three were pure dance; they made marvelously diverse fare. The opener was Michel Fokine’s “Les Sylphides” (1909), which used to be a signature work for Ballet Theater through most of its first five decades; when Fokine staged it for this company in 1940, it was his final version of what was already a classic. This revival was followed on Friday by two ballets created for this troupe: Twyla Tharp’s “Bach Partita” (1983) and Mark Morris’s “Gong” (2001). ', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/04/arts/abt-web/abt-1383510320447-articleLarge.jpg', 'height': 477, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/04/arts/abt-web/abt-1383510320447-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 477}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/04/arts/abt-web/abt-1383510320447-jumbo.jpg', 'height': 814, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/04/arts/abt-web/abt-1383510320447-superJumbo.jpg', 'height': 1628, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/04/arts/abt-web/abt-1383510320447-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/04/arts/abt-web/abt-1383510320447-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/04/arts/abt-web/abt-1383510320447-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Night of Revivals With Fokine, Tharp and Morris', 'kicker': 'Dance Review', 'content_kicker': None, 'print_headline': 'A Night of Revivals With Fokine, Tharp and Morris', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dancing', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'AMERICAN BALLET THEATER', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Fokine, Michel', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Morris, Mark', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Tharp, Twyla', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-11-03T22:01:43+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Alastair Macaulay', 'person': [{'firstname': 'Alastair', 'middlename': None, 'lastname': 'Macaulay', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/5b62d217-0764-57d9-89da-afdf7c3c7f80', 'word_count': 888, 'uri': 'nyt://article/5b62d217-0764-57d9-89da-afdf7c3c7f80'}, {'abstract': 'After losing a leg while serving in the Army in Afghanistan, Alfredo De Los Santos took up competing in marathons with a handcycle and finished second in New York.', 'web_url': 'https://www.nytimes.com/2013/11/04/sports/a-veterans-path-to-recovery-by-marathon-racing.html', 'snippet': 'After losing a leg while serving in the Army in Afghanistan, Alfredo De Los Santos took up competing in marathons with a handcycle and finished second in New York.', 'lead_paragraph': 'A light mist covered the hilly roads by Alfredo De Los Santos’s neighborhood in Hopewell Junction, N.Y., last week. The streets of his tidy development were quiet and deserted, except for Freddie, as he likes to be called, whizzing along the rain-slicked road, intensely pumping his handcycle.', 'print_section': 'F', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Veteran’s Path to Recovery by Marathon Racing', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Veteran’s Path to Recovery by Racing', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Gonzalez, David', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Veterans', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'New York City Marathon', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Disabilities', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-11-03T22:04:35+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By David Gonzalez', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Gonzalez', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5ceb2db4-b1f0-5440-9450-b2eed77910ff', 'word_count': 623, 'uri': 'nyt://article/5ceb2db4-b1f0-5440-9450-b2eed77910ff'}, {'abstract': 'Joe Sacco’s latest book, “The Great War,” is a 24-foot-long panoramic pen-and-ink imagining of the first day of World War I’s bloody Battle of the Somme.', 'web_url': 'https://www.nytimes.com/2013/11/04/books/joe-saccos-the-great-war-july-1-1916.html', 'snippet': 'Joe Sacco’s latest book, “The Great War,” is a 24-foot-long panoramic pen-and-ink imagining of the first day of World War I’s bloody Battle of the Somme.', 'lead_paragraph': 'Graphic novelists tend to be a little neurotic and obsessive, but in that fraternity, Joe Sacco has long been regarded as an exception. For one thing, Mr. Sacco, whose new book, “The Great War,” comes out on Monday, is completely well adjusted. “Of all of us, he’s far and away the most normal,” his colleague Art Spiegelman said recently. Mr. Sacco laughed when told of this and said, “I’m not sure that’s a good thing or not.”', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/04/arts/sacco-1/sacco-1-articleLarge.jpg', 'height': 376, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/04/arts/sacco-1/sacco-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 376}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/04/arts/sacco-1/sacco-1-jumbo.jpg', 'height': 643, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/04/arts/sacco-1/sacco-1-superJumbo.jpg', 'height': 1285, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/04/arts/sacco-1/sacco-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/04/arts/sacco-1/sacco-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/04/arts/sacco-1/sacco-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Solemn Panorama of Battle', 'kicker': None, 'content_kicker': None, 'print_headline': 'Solemn Panorama of Battle', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'McGrath, Charles', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Sacco, Joe', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'World War I (1914-18