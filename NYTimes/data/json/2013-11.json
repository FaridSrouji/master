: None, 'content_kicker': None, 'print_headline': 'Crime Boss Bulger Gets 2 Life Terms and Is Assailed by Judge for His ‘Depravity’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Sentences (Criminal)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bulger, James J', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Organized Crime', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Boston (Mass)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Casper, Denise J', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-11-14T15:48:53+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Katharine Q. Seelye', 'person': [{'firstname': 'Katharine', 'middlename': 'Q.', 'lastname': 'Seelye', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/08f05a8c-e575-55ae-b738-cc4ad50460d6', 'word_count': 518, 'uri': 'nyt://article/08f05a8c-e575-55ae-b738-cc4ad50460d6'}, {'abstract': 'The Great Bull Run, operated by two young lawyers who had wearied of their profession, offers thrill seekers opportunities to “grab life by the horns.”', 'web_url': 'https://www.nytimes.com/2013/11/17/sports/for-thrill-seekers-a-bull-run-with-a-different-hook.html', 'snippet': 'The Great Bull Run, operated by two young lawyers who had wearied of their profession, offers thrill seekers opportunities to “grab life by the horns.”', 'lead_paragraph': 'CONYERS, Ga. — The 600 runners were limbering up for what they had been assured would be “the most awesome adventure” of their lives. And what might that be? They were paying for the opportunity to be chased around a dusty, quarter-mile track by an angry herd of stampeding bulls.', 'print_section': 'D', 'print_page': '1', 'source': 'The New York Times'