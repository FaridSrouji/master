1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/aa377f7b-7a93-506c-ab05-a744d67c89e7', 'word_count': 671, 'uri': 'nyt://article/aa377f7b-7a93-506c-ab05-a744d67c89e7'}, {'abstract': 'The sale of fields on Russia’s Yamal Peninsula comes as other Western companies are moving in the opposite direction, seeking to explore in the far north.', 'web_url': 'https://www.nytimes.com/2013/11/21/business/energy-environment/italian-oil-giant-eni-plans-to-sell-gas-field-in-russia.html', 'snippet': 'The sale of fields on Russia’s Yamal Peninsula comes as other Western companies are moving in the opposite direction, seeking to explore in the far north.', 'lead_paragraph': 'MOSCOW — Eni, the Italian oil company, said on Wednesday that it intended to sell its stake in a natural gas field in the far north of Russia for about $2.9 billion and focus instead on a subsea pipeline and another Arctic Ocean venture.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Italian Oil Giant Eni Plans to Sell Gas Field in Russia', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Oil (Petroleum) and Gasoline', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Russia', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Eni SpA', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Gazprom', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Novatek', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-11-20T17:24:20+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Energy & Environment ', 'byline': {'original': 'By Andrew E. Kramer', 'person': [{'firstname': 'Andrew', 'middlename': 'E.', 'lastname': 'Kramer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://art