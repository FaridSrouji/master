en-superJumbo.jpg', 'height': 2048, 'width': 1167, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/16/business/economy/16economix-hansen/16economix-hansen-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/16/business/economy/16economix-hansen/16economix-hansen-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/16/business/economy/16economix-hansen/16economix-hansen-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Talk With Lars Peter Hansen, Nobel Laureate', 'kicker': 'Economix', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Economics (Theory and Philosophy)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Nobel Prizes', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Fama, Eugene F', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Hansen, Lars Peter', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Shiller, Robert J', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Chicago', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-11-16T20:22:59+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Jeff Sommer', 'person': [{'firstname': 'Jeff', 'middlename': None, 'lastname': 'Sommer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7b7e18e3-05ab-5897-bea6-15987be3f755', 'word_count': 1828, 'uri': 'nyt://article/7b7e18e3-05ab-5897-bea6-15987be3f755'}, {'abstract': 'The economist who shared this year’s Nobel in economic science with Eugene Fama and Robert Shiller will not let himself be drawn into the debate between them.', 'web_url': 'https://www.nytimes.com/2013/11/17/your-money/lars-peter-hansen-the-nobel-laureate-in-the-middle.html', 'snippet': 'The economist who shared this year’s Nobel in economic science with Eugene Fama and Robert Shiller will not let himself be drawn into the debate between them.', 'lead_paragraph': 'Lars Peter Hansen understands why he is being asked, but he isn’t comfortable with the question. “Are financial markets efficient or irrational?” repeats Professor Hansen, a University of Chicago economist. “I don’t really know how to answer that.”', 'print_section': 'BU', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/17/business/17-STRA/17-STRA-articleLarge.jpg', 'height': 890, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/17/business/17-STRA/17-STRA-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 890}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/17/business/17-STRA/17-STRA-jumbo.jpg', 'height': 1024, 'width': 691, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/17/business/17-STRA/17-STRA-superJumbo.jpg', 'height': 2048, 'width': 1381, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/17/business/17-STRA/17-STRA-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/17/business/17-STRA/17-STRA-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/17/business/17-STRA/17-STRA-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Lars Peter Hansen, the Nobel Laureate in the Middle', 'kicker': None, 'content_kicker': None, 'print_headline': 'And Now a Word From the Laureate in the Middle', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Hansen, Lars Peter', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Nobel Prizes', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Economics (Theory and Philosophy)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Fama, Eugene F', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Shiller, Robert J', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Stocks and Bonds', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-11-16T20:25:00+0000', 'document_type': 'article', 'news_desk': 'SundayBusiness', 'section_name': 'Your Money', 'byline': {'original': 'By Jeff Sommer', 'person': [{'firstname': 'Jeff', 'middlename': None, 'lastname': 'Sommer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cd4c763e-0818-5714-87c8-5f442c76bbc0', 'word_count': 1007, 'uri': 'nyt://article/cd4c763e-0818-5714-87c8-5f442c76bbc0'}, {'abstract': 'Readers comment on my column about the importance of food stamps to fight malnutrition and hunger right here in America.', 'web_url': 'https://kristof.blogs.nytimes.com/2013/11/16/why-food-stamps-are-a-great-investment/', 'snippet': 'Readers comment on my column about the importance of food stamps to fight malnutrition and hunger right here in America.', 'lead_paragraph': 'My Sunday column looks at the issue of food stamps, subject of a forthcoming battle on Capitol Hill. The program will be cut, but it’s unclear by how much. My column argues that it would be short-sighted, as well as cruel, to slash the program, for a couple of reasons. First, almost two-thirds of recipients are children, elderly or disabled. Second, particularly with the children who are recipients, the malnutrition is real and there is mounting evidence that it has long-term effects that leave those children less equipped to succeed at school and live productive lives. I’m particularly swayed by the NBER study that my column cites and links to, indicating that when children under five get food stamps, their long-term health outcomes are better, and they are less likely to end up on welfare. Read the column, but I’d also encourage you to read the study.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Why Food Stamps Are a Great Investment', 'kicker': 'Nicholas Kristof', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-11-16T20:34:25+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Nicholas Kristof', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'Kristof', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0d3afe9a-99eb-5006-9310-fb726a53c998', 'word_count': 358, 'uri': 'nyt://article/0d3afe9a-99eb-5006-9310-fb726a53c998'}, {'abstract': 'The successful maker of jackets and other outdoor gear keeps walking the tightrope between exclusivity and the mass market.', 'web_url': 'https://www.nytimes.com/2013/11/17/business/in-a-north-face-jacket-a-reversible-appeal.html', 'snippet': 'The successful maker of jackets and other outdoor gear keeps walking the tightrope between exclusivity and the mass market.', 'lead_paragraph': 'It started when