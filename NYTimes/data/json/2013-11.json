ion': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/17/books/review/Shortlist-SUB/Shortlist-SUB-articleLarge.jpg', 'height': 150, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/17/books/review/Shortlist-SUB/Shortlist-SUB-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 150}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/17/books/review/Shortlist-SUB/Shortlist-SUB-jumbo.jpg', 'height': 256, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/17/books/review/Shortlist-SUB/Shortlist-SUB-superJumbo.jpg', 'height': 511, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/17/books/review/Shortlist-SUB/Shortlist-SUB-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/17/books/review/Shortlist-SUB/Shortlist-SUB-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/17/books/review/Shortlist-SUB/Shortlist-SUB-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Jewish Identities', 'kicker': 'The Shortlist', 'content_kicker': None, 'print_headline': 'Jewish Identities', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Lipsky, Seth', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Gurock, Jeffrey S', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Ashton, Dianne', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Penslar, Derek J', 'rank': 9, 'major': 'N'}], 'pub_date': '2013-11-15T15:41:27+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Anna Altman', 'person': [{'firstname': 'Anna', 'middlename': None, 'lastname': 'Altman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/73d3a892-81f6-5143-8935-718aa2ea751e', 'word_count': 991, 'uri': 'nyt://article/73d3a892-81f6-5143-8935-718aa2ea751e'}, {'abstract': 'Paperback books of particular interest.', 'web_url': 'https://www.nytimes.com/2013/11/17/books/review/paperback-row.html', 'snippet': 'Paperback books of particular interest.', 'lead_paragraph': 'WHY READ MOBY-DICK?,  by Nathaniel Philbrick. (Penguin, $13.) Philbrick, whose “In the Heart of the Sea: The Tragedy of the Whaleship Essex” recounted the real-life inspiration for Herman Melville’s shipwreck, now gives readers an enthusiastic shove toward the “one book that deserves to be called our American bible.” He broaches the novel thematically, with compact, often quirky essays on topics like landlessness, sharks and chowder.', 'print_section': 'BR', 'print_page': '30', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Paperback Row', 'kicker': None, 'content_kicker': None, 'print_headline': 'Paperback Row', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-11-15T15:41:38+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Ihsan Taylor', 'person': [{'firstname': 'Ihsan', 'middlename': None, 'lastname': 'Taylor', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'List', '_id': 'nyt://article/ce27d30c-59d9-5dab-b165-2ca61942d4e2', 'word_count': 457, 'uri': 'nyt://article/ce27d30c-59d9-5dab-b165-2ca61942d4e2'}, {'abstract': 'Recently reviewed books of particular interest.', 'web_url': 'https://www.nytimes.com/2013/11/17/books/review/editors-choice.html', 'snippet': 'Recently reviewed books of particular interest.', 'lead_paragraph': 'THE LUMINARIES,  by Eleanor Catton. (Little, Brown, $27.) In her Booker Prize winner, a love story and mystery set in New Zealand, Catton has built a lively parody of a 19th-century novel, while creating something utterly new for the 21st.', 'print_section': 'BR', 'print_page': '28', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Editors’ Choice', 'kicker': None, 'content_kicker': None, 'print_headline': 'Editors’ Choice | Recent books of particular interest', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-11-15T15:41:43+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'List', '_id': 'nyt://article/92c4ac0a-16ac-5208-b878-f5b3fbfc7995', 'word_count': 276, 'uri': 'nyt://article/92c4ac0a-16ac-5208-b878-f5b3fbfc7995'}, {'abstract': 'Richard Rodriguez reckons with sexuality and religion in these soul-searching essays.', 'web_url': 'https://www.nytimes.com/2013/11/17/books/review/darling-by-richard-rodriguez.html', 'snippet': 'Richard Rodriguez reckons with sexuality and religion in these soul-searching essays.', 'lead_paragraph': 'In “Hunger of Memory,” the 1982 book that made him one of the most prominent Hispanic essayists in America, Richard Rodriguez wrote: “I wanted to forget that I had a body because I had a brown body.” In “Darling,” his new essay collection, he claims this body in all its difficulties. “Flesh is a complicated medium for grace,” he writes, exploring the importance of physical bodies in a digital era, the importance of brownness (“Brown has always been the sum of our breathing and eating and moving about”) as well as the importance of complication itself — the possibilities embedded in resistance, those experiences of refusal that shape our intimacies and our yearnings. ', 'print_section': 'BR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/17/books/review/17JAMISON/17JAMISON-articleLarge.jpg', 'height': 548, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/17/books/review/17JAMISON/17JAMISON-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 548}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/17/books/review/17JAMISON/17JAMISON-jumbo.jpg', 'height': 753, 'width': 824, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/17/books/review/17JAMISON/17JAMISON-superJumbo.jpg', 'height': 753, 'width': 824, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/17/books/review/17JAMISON/17JAMISON-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/17/books/review/17JAMISON/17JAMISON-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/17/books/review/17JAMISON/17JAMISON-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Twists of Faith', 'kicker': None, 'content_kicker': None, 'print_headline': 'Twists of Faith', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Jamison, Leslie', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Rodriguez, Richard', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Religion and Belief', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-11-15T15:43:01+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Leslie Jamison', 'person': [{'firstname': 'Leslie', 'middlename': None, 'lastname': 'Jamison', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/7c230698-8877-5e97-a73d-616b96535fbb', 'word_count': 843, 'uri': 'nyt://article/7c230698-8877-5e97-a73d-616b96535fbb'}, {'abstract': 'Arkady Renko turns to a translator’s cryptic notebook while investigating two deaths in Moscow.', 'web_url': 'https://www.nytimes.com/2013/11/17/books/review/tatiana-by-martin-cruz-smith.html', 'snippet': 'Arkady Renko turns to a translator’s cryptic notebook while investigating two deaths in Moscow.', 'lead_paragraph': 'It’s a spooky feeling, if you’re a translator who loves bicycling and word games and likes traveling to Russia, to open a book and encounter, in the very first chapter, a translating, cycling crossword fanatic who is plucked from a Kaliningrad beach by a homburg-hatted butcher, hurled into a carcass-strewn meat van and never heard from again. (Note to self: Avoid Kaliningrad.) At the time he was nabbed, the translator was carrying a notebook he’d used at a session of multilingual, high-stakes business negotiations. His abductor, flipping through the pages, was infuriated to find them filled with illegible doodles — stars, bugs, cats and spirals — the translator’s own private code. “Let the birds read it,” the butcher declared, flinging the notebook into the wind. Local children later found it in the sea grass. ', 'print_section': 'BR', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/17/books/review/1117-bks-Schillinger/1117-bks-Schillinger-articleLarge.jpg', 'height': 638, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/17/books/review/1117-bks-Schillinger/1117-bks-Schillinger-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 638}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/17/books/review/1117-bks-Schillinger/1117-bks-Schillinger-jumbo.jpg', 'height': 1024, 'width': 963, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/17/books/review/1117-bks-Schillinger/1117-bks-Schillinger-superJumbo.jpg', 'height': 1754, 'width': 1649, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/17/books/review/1117-bks-Schillinger/1117-bks-Schillinger-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/17/books/review/1117-bks-Schillinger/1117-bks-Schillinger-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/17/books/review/1117-bks-Schillinger/1117-bks-Schillinger-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Riddle Wrapped in a Mystery', 'kicker': None, 'content_kicker': None, 'print_headline': 'Riddle Wrapped in a Mystery', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Schillinger, Liesl', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Smith, Martin Cruz', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-11-15T15:49:45+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Liesl Schillinger', 'person': [{'firstname': 'Liesl', 'middlename': None, 'lastname': 'Schillinger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/bdfb7ce1-f866-5038-80e6-87c675ce0fe4', 'word_count': 1203, 'uri': 'nyt://article/bdfb7ce1-f866-5038-80e6-87c675ce0fe4'}, {'abstract': 'Four linked stories explore characters’ bottomless needs and stubborn weaknesses.', 'web_url': 'https://www.nytimes.com/2013/11/17/books/review/dirty-love-by-andre-dubus-iii.html', 'snippet': 'Four linked stories explore characters’ bottomless needs and stubborn weaknesses.', 'lead_paragraph': 'If folklorists are to be believed, the postnuptial tradition obliging the bridegroom to carry his bride over the threshold of their first home has less to do with ensuring the couple’s good luck and more to do with maintaining the bride’s good name. Apparently the custom spread from ancient Rome throughout medieval Europe as a politically fraught pantomime of chastity’s death at the marriage altar: The new wife, presumably reluctant to relinquish her virginity, had to be physically transported into her new matrimonial setting by her impatient husband.', 'print_section': 'BR', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/17/books/review/Turrentine-SUB/Turrentine-SUB-articleLarge.jpg', 'height': 527, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/17/books/review/Turrentine-SUB/Turrentine-SUB-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 527}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/17/books/review/Turrentine-SUB/Turrentine-SUB-jumbo.jpg', 'height': 900, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/17/books/review/Turrentine-SUB/Turrentine-SUB-superJumbo.jpg', 'height': 1722, 'width': 1959, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/17/books/review/Turrentine-SUB/Turrentine-SUB-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/17/books/review/Turrentine-SUB/Turrentine-SUB-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/17/books/review/Turrentine-SUB/Turrentine-SUB-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Compulsive Behavior', 'kicker': None, 'content_kicker': None, 'print_headline': 'Compulsive Behavior', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Dubus, Andre III', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-11-15T15:51:27+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Jeff Turrentine', 'person': [{'firstname': 'Jeff', 'middlename': None, 'lastname': 'Turrentine', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/f73f6edf-0fd0-529d-9d09-0aa0478f7550', 'word_count': 1324, 'uri': 'nyt://article/f73f6edf-0fd0-529d-9d09-0aa0478f7550'}, {'abstract': 'Pat Conroy’s family memoir centers on his father, the inspiration for “The Great Santini.”', 'web_url': 'https://www.nytimes.com/2013/11/17/books/review/pat-conroys-death-of-santini.html', 'snippet': 'Pat Conroy’s family memoir centers on his father, the inspiration for “The Great Santini.”', 'lead_paragraph': 'It’s a rare memoir that begins by telling you it’s been told several times before, but that’s the case with “The Death of Santini.” The very title of Pat Conroy’s latest book, alluding to his novel “The Great Santini,” affirms that the abusive fighter pilot at the center of that story and the father mourned here are essentially one and the same. To dispel any lingering doubt, Conroy announces at the outset that the fictions he has spun over his long, celebrated literary career aren’t really fictions. They’re diamonds hauled up to earth and into the light of day from the dark and bottomless mine of his Southern clan: the tyrannical patriarch, the wounded matriarch, their seven self-destructive sons and daughters. We’ve met their alter egos and avatars, those of us who’ve supped contentedly on Conroy’s big-flavored prose through the years. In “The Death of Santini,” he more or less acknowledges that we’ll simply be reintroduced to them by their real names.', 'print_section': 'BR', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/17/books/review/17SUBBRUNI/17SUBBRUNI-articleLarge.j