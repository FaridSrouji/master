: None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Citizens United v Federal Election Commission (Supreme Court Decision)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Hobby Lobby', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Freedom of Religion', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Patient Protection and Affordable Care Act (2010)', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Supreme Court (US)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Birth Control and Family Planning', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Health Insurance and Managed Care', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-11-25T02:26:34+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Adam Liptak', 'person': [{'firstname': 'Adam', 'middlename': None, 'lastname': 'Liptak', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/41089f92-537f-5751-be2f-e9033fa32707', 'word_count': 1133, 'uri': 'nyt://article/41089f92-537f-5751-be2f-e9033fa32707'}, {'abstract': 'The case for compromise on a path to citizenship.', 'web_url': 'https://www.nytimes.com/2013/11/25/opinion/keller-less-than-american.html', 'snippet': 'The case for compromise on a path to citizenship.', 'lead_paragraph': 'Not so long ago, it seemed the debate over immigration reform was all about borders. Politicians competed to offer the most draconian solutions — higher fences, longer fences, electrified fences, armies of guards, fleets of drones, moats and crocodiles. Never mind that the Border Patrol had already more than doubled in a decade. Never mind that many of those here illegally never hopped a fence but simply overstayed a student or tourist visa. The nativist mythology has us under siege from relentless hordes striding toward Arizona on, in the fevered imagination of Tea Party Congressman Steve King, “calves the size of cantaloupes because they’re hauling 75 pounds of marijuana across the desert.” To pacify the border neurotics, authors of the bill that passed the Senate last summer included $46.3 billion to militarize our southern flank.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/09/18/opinion/Keller_New/Keller_New-articleLarge.jpg', 'height': 900, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/09/18/opinion/Keller_New/Keller_New-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 900}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/09/18/opinion/Keller_New/Keller_New-jumbo.jpg', 'height': 500, 'width': 350, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/09/18/opinion/Keller_New/Keller_New-superJumbo.jpg', 'height': 2048, 'width': 1366, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/09/18/opinion/Keller_New/Keller_New-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/09/18/opinion/Keller_New/Keller_New-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/09/18/opinion/Keller_New/Keller_New-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Less Than American', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': 'Less Than American', 'n