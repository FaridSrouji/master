bo-v4.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/03/magazine/03lives1/03lives1-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/03/magazine/03lives1/03lives1-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/03/magazine/03lives1/03lives1-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'My Own Unprivate Little Italy', 'kicker': None, 'content_kicker': None, 'print_headline': 'My Own Unprivate Little Italy', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Kushner, Rachel', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Writing and Writers', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'SoHo (Manhattan, NY)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Little Italy (Manhattan, NY)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-11-01T15:14:35+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Rachel Kushner', 'person': [{'firstname': 'Rachel', 'middlename': None, 'lastname': 'Kushner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/00b9e23d-fd65-5a8e-812d-b8a4947bceb9', 'word_count': 799, 'uri': 'nyt://article/00b9e23d-fd65-5a8e-812d-b8a4947bceb9'}, {'abstract': 'Tape destroying; burglar fooling.', 'web_url': 'https://www.nytimes.com/2013/11/03/magazine/fahrenheit-45-fun.html', 'snippet': 'Tape destroying; burglar fooling.', 'lead_paragraph': 'I help run a college TV network that recently held a promotional event where we destroyed a large number of VHS tapes to celebrate an upgrade. The tapes were all either ours (and already digitized) or donated explicitly for the purpose of destroying them. Some people were upset, even publicly comparing it to a book burning. Does it make sense to see a book burning as wrong but a tape smashing as acceptable? Is there a moral component to destroying one’s own property? ETHAN GOLDSTEIN, WORCESTER, MASS.', 'print_section': 'MM', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/02/02/magazine/ethicist/ethicist-articleLarge.jpg', 'height': 1316, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/02/02/magazine/ethicist/ethicist-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 1316}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/02/02/magazine/ethicist/ethicist-jumbo.jpg', 'height': 1024, 'width': 467, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/02/02/magazine/ethicist/ethicist-superJumbo.jpg', 'height': 2048, 'width': 934, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/02/02/magazine/ethicist/ethicist-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/02/02/magazine/ethicist/ethicist-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'ima