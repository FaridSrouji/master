-articleLarge.jpg', 'height': 290, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/14/fashion/14VOLLMAN1_SPAN/14zVOLLMAN4-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 290}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/14/fashion/14VOLLMAN1_SPAN/14zVOLLMAN4-jumbo.jpg', 'height': 494, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/14/fashion/14VOLLMAN1_SPAN/14zVOLLMAN4-superJumbo.jpg', 'height': 989, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/14/fashion/14VOLLMAN1_SPAN/14zVOLLMAN4-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/14/fashion/14VOLLMAN1_SPAN/14zVOLLMAN4-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/14/fashion/14VOLLMAN1_SPAN/14zVOLLMAN4-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'William T. Vollmann: The Self Images of a Cross-Dresser', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Self Images of a Cross-Dresser', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Vollmann, William T', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Writing and Writers', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Transvestism', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-11-13T23:15:40+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'byline': {'original': 'By Stephen Heyman', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Heyman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2f253c71-a450-5e9c-9a9c-e76f1a8ecfcc', 'word_count': 1184, 'uri': 'nyt://article/2f253c71-a450-5e9c-9a9c-e76f1a8ecfcc'}, {'abstract': 'The new-music ensemble counter)induction opened its 15th season with a program titled “Correspondent.”', 'web_url': 'https://www.nytimes.com/2013/11/14/arts/music/counter-induction-at-the-tenri-cultural-institute.html', 'snippet': 'The new-music ensemble counter)induction opened its 15th season with a program titled “Correspondent.”', 'lead_paragraph': 'Character pieces, a staple of romantic repertory, traverse a range of often blissful or atmospheric moods and scenes. But there are no dreamy moments in Bernhard Gander’s “Schlechtecharakterstücke” (“Bad Character Pieces”), a savagely wry, contemporary take on the genre.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/13/arts/20131114COUNTER/20131114COUNTER-articleLarge.jpg', 'height': 331, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/13/arts/20131114COUNTER/20131114COUNTER-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 331}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/13/arts/20131114COUNTER/20131114COUNTER-jumbo.jpg', 'height': 564, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/13/arts/20131114COUNTER/20131114COUNTER-superJumbo.jpg', 'height': 1128, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/13/arts/20131114COUNTER/20131114COUNTER-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/13/arts/20131114COUNTER/20131114COUNTER-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/13/arts/20131114COUNTER/20131114COUNTER-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'An Ensemble, in Its 15th Season, Reimagines and Interprets', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'An Ensemble, in Its 15th Season, Reimagines and Interprets', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'counter)induction', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-11-13T23:15:50+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Vivien Schweitzer', 'person': [{'firstname': 'Vivien', 'middlename': None, 'lastname': 'Schweitzer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/2ab95463-fd85-598a-b4a8-85668335ab4d', 'word_count': 362, 'uri': 'nyt://article/2ab95463-fd85-598a-b4a8-85668335ab4d'}, {'abstract': 'George H. Marcus, an art historian, on the architect’s few but important house designs.', 'web_url': 'https://www.nytimes.com/2013/11/14/garden/the-homey-side-of-louis-kahn.html', 'snippet': 'George H. Marcus, an art historian, on the architect’s few but important house designs.', 'lead_paragraph': 'The architect Louis Kahn, who died in 1974, is known for his spare, geometric institutional work like the Salk Institute for Biological Study in the La Jolla section of San Diego and the Yale Center for British Art in New Haven. The 2003 documentary ”My Architect,” directed by his son, Nathaniel Kahn, highlighted those buildings, along with Kahn’s romantic life. The architect had three children, with three different women, two of whom were professional collaborators. A new book, “The Houses of Louis Kahn” (Yale University Press, $65), provides an architectural bridge between the personal and the professional stories, focusing on the nine houses Kahn completed, and designs for two dozen more. The story told by the authors, George H. Marcus and William Whitaker, is one of warm client relations, attention to the smallest domestic detail and a philosophical search for the best arrangement of rooms to call home. Mr. Marcus, an adjunct assistant professor in the history of art at the University of Pennsylvania, spoke about it by phone late last month. (This interview has been condensed and edited.)', 'print_section': 'D', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/14/garden/14QNA_SPAN-copy/14QNA_SPAN-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/14/garden/14QNA_SPAN-copy/14QNA_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/14/garden/14QNA_SPAN-copy/14QNA_SPAN-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/14/garden/14QNA_SPAN-copy/14QNA_SPAN-superJumbo.jpg', 'height': 1365, 'width':