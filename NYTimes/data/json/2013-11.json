ENJAMIN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 378}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/17/arts/20131118BENJAMIN/20131118BENJAMIN-jumbo.jpg', 'height': 645, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/17/arts/20131118BENJAMIN/20131118BENJAMIN-superJumbo.jpg', 'height': 1291, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/17/arts/20131118BENJAMIN/20131118BENJAMIN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/17/arts/20131118BENJAMIN/20131118BENJAMIN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/17/arts/20131118BENJAMIN/20131118BENJAMIN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Romantic Evening', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'A Romantic Evening', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Classical Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Ludwig, David', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Beilman, Benjamin', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Sunwoo, Yekwon', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-11-18T23:10:36+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Vivien Schweitzer', 'person': [{'firstname': 'Vivien', 'middlename': None, 'lastname': 'Schweitzer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/2e533957-af16-542c-a3de-21d574f7cc95', 'word_count': 346, 'uri': 'nyt://article/2e533957-af16-542c-a3de-21d574f7cc95'}, {'abstract': 'Monday’s highlights from around the web include a tale of Google’s quest to take the steering wheel out of your hand. Plus, reaction to YouTube’s site being down and an argument for why young people aren’t the harbingers of the next big thing.', 'web_url': 'https://bits.blogs.nytimes.com/2013/11/18/todays-scuttlebot-on-googles-driverless-car-and-poking-fun-at-downed-youtube/', 'snippet': 'Monday’s highlights from around the web include a tale of Google’s quest to take the steering wheel out of your hand. Plus, reaction to YouTube’s site being down and an argument for why young people aren’t the harbingers of the next big thing.', 'lead_paragraph': 'Every day, The New York Times’s staff scours the web for interesting and peculiar items.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/11/11/blogs/scuttlebot/scuttlebot-jumbo.jpg', 'height': 500, 'width': 500, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/11/11/blogs/scuttlebot/scuttlebot-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/11/11/blogs/scuttlebot/scuttlebot-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/11/11/blogs/scuttlebot/scuttlebot-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Today’s Scuttlebot: On Google’s Driverless Car, and Poking Fun at Downed YouTube', 'kicker': 'Bits', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-11-18T23:12:59+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/a20e81a0-3220-5977-9888-c4d3017b5929', 'word_count': 167, 'uri': 'nyt://article/a20e81a0-3220-5977-9888-c4d3017b5929'}, {'abstract': 'A typhoon prompted questions about a possible link between natural disasters and a warming planet. A mechanic comes up with a baby extricator. A new tool helps track the state of the forests.', 'web_url': 'https://www.nytimes.com/2013/11/19/science/hurricanes-and-climate-helping-stuck-babies-changing-forests.html', 'snippet': 'A typhoon prompted questions about a possible link between natural disasters and a warming planet. A mechanic comes up with a baby extricator. A new tool helps track the state of the forests.', 'lead_paragraph': 'The typhoon that struck the Philippines this month prompted questions about a possible link between natural disasters and a warming planet. Delegates at the United Nations talks in Warsaw on a global climate treaty were quick to make the connection. And the head of the United Nations’ meteorological agency cited Australia’s severe summer heat and raised water levels around the Philippines as among the effects, reported ABC News. Still, most scientists remained cautious, saying there was not enough data to draw a direct connection. ', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/14/world/jp-birth1/jp-birth1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy