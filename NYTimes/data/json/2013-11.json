': 'images/2013/11/07/sports/basketball/07cavs/07cavs-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/07/sports/basketball/07cavs/07cavs-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'First Draft Pick Finally Gets First Basket', 'kicker': None, 'content_kicker': None, 'print_headline': 'First Draft Pick Finally Gets First Basket', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Basketball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Taylor, Nate', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Cleveland Cavaliers', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Bennett, Anthony (1993- )', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-11-06T18:47:02+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Basketball', 'byline': {'original': 'By Nate Taylor', 'person': [{'firstname': 'Nate', 'middlename': None, 'lastname': 'Taylor', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a3bd2b6a-cd4b-5a3a-83be-2f33b5c03427', 'word_count': 658, 'uri': 'nyt://article/a3bd2b6a-cd4b-5a3a-83be-2f33b5c03427'}, {'abstract': 'The New Jersey governor has weaknesses, but so do his potential 2016 rivals.', 'web_url': 'https://douthat.blogs.nytimes.com/2013/11/06/who-beats-christie/', 'snippet': 'The New Jersey governor has weaknesses, but so do his potential 2016 rivals.', 'lead_paragraph': 'And now for the requisite “Chris Christie and 2016″ post, occasioned by all the other\xa0“Chris Christie and 2016″ posts that his landslide re-election have spawned. Mine is inspired by the skeptics — from the right, Henry Olsen; from the left, Jonathan Chait; from the media version of the center, Ron Fournier — who all offer reasons to doubt Christie’s presidential mojo, and spin out entirely plausible scenarios in which his liabilities cost him the G.O.P. nomination. Well, entirely plausible except for one thing, which I think Chait’s conclusion underplays:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Who Beats Christie?', 'kicker': 'Ross Douthat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bush, Jeb', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Christie, Christopher J', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Cruz, Ted', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Jindal, Bobby', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Paul, Rand', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Rubio, Marco', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Walker, Scott K', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Florida', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'Michigan', 'rank': 11, 'major': 'N'}, {'name': 'glocations', 'value': 'New Jersey', 'rank': 12, 'major': 'N'}, {'name': 'glocations', 'value': 'Ohio', 'rank': 13, 'major': 'N'}], 'pub_date': '2013-11-06T18:54:29+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Ross Douthat', 'person': [{'firstname': 'Ross', 'middlename': None, 'lastname': 'Douthat', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fd277bb1-b668-55ab-b5b7-b690840396c1', 'word_count': 717, 'uri': 'nyt://article/fd277bb1-b668-55ab-b5b7-b690840396c1'}, {'abstract': 'With his mantra “A Tale of Two Cities,” Bill de Blasio captured voters’ concerns about inequality in New York City. But he had to overcome far more famous rivals to get to City Hall.', 'web_url': 'https://www.nytimes.com/2013/11/07/nyregion/mayor-elect-bill-de-blasio.html', 'snippet': 'With his mantra “A Tale of Two Cities,” Bill de Blasio captured voters’ concerns about inequality in New York City. But he had to overcome far more famous rivals to get to City Hall.', 'lead_paragraph': 'When he began his mayoral campaign on a freezing cold January day outside his home in Brooklyn, Bill de Blasio was just one of several Democratic candidates all claiming to be the progressive voice of change for a post-Bloomberg New York. His Democratic and Republican opponents belittled his policy proposals, his record and his supposed lack of experience.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/07/nyregion/07deblasio-video/07deblasio-video-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/07/nyregion/07deblasio-video/07deblasio-video-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/07/nyregion/07deblasio-video/07deblasio-video-jumbo.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/07/nyregion/07deblasio-video/07deblasio-video-superJumbo.jpg', 'height': 1152, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/07/nyregion/07deblasio-video/07deblasio-video-thumbStandard.jpg