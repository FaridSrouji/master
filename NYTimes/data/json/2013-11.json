': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4da3fbd5-8647-5f86-9180-6be7965d2aeb', 'word_count': 687, 'uri': 'nyt://article/4da3fbd5-8647-5f86-9180-6be7965d2aeb'}, {'abstract': 'As Democrats get jittery over the troubled rollout of the health care law, President Obama traveled to Texas to defend it, in the largest state to refuse to participate.', 'web_url': 'https://www.nytimes.com/2013/11/07/us/politics/obama-affordable-care-act-texas.html', 'snippet': 'As Democrats get jittery over the troubled rollout of the health care law, President Obama traveled to Texas to defend it, in the largest state to refuse to participate.', 'lead_paragraph': 'DALLAS — President Obama strongly defended his signature health care law on Wednesday in the largest state that has refused to participate, as rattled Senate Democrats called for changing or delaying key parts of the new health coverage.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/07/us/SUB-OBAMA/SUB-OBAMA-articleLarge.jpg', 'height': 366, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/07/us/SUB-OBAMA/SUB-OBAMA-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 366}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/07/us/SUB-OBAMA/SUB-OBAMA-jumbo.jpg', 'height': 625, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/07/us/SUB-OBAMA/SUB-OBAMA-superJumbo.jpg', 'height': 1250, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'i