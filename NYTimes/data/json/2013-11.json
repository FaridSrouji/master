lassed-in counter.', 'print_section': 'A', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/11/nyregion/SIDE/SIDE-articleLarge.jpg', 'height': 397, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/11/nyregion/SIDE/SIDE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 397}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/11/nyregion/SIDE/SIDE-jumbo.jpg', 'height': 677, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/11/nyregion/SIDE/SIDE-superJumbo.jpg', 'height': 1355, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/11/nyregion/SIDE/SIDE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/11/nyregion/SIDE/SIDE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/11/nyregion/SIDE/SIDE-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Latino Comedian Returns to Where It All Began', 'kicker': 'Side Street', 'content_kicker': None, 'print_headline': 'Latino Comedian Returns To Where It All Began', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Gonzalez, David', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Comedy and Humor', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Hispanic-Americans', 'rank': 3, 'major': 'N'