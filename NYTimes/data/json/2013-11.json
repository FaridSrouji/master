73-522e-b4f2-d9393114c9b1', 'word_count': 1006, 'uri': 'nyt://article/29dec36d-bb73-522e-b4f2-d9393114c9b1'}, {'abstract': 'With positive noise from Tehran, this is not the time to impose new economic sanctions.', 'web_url': 'https://www.nytimes.com/2013/11/04/opinion/congress-can-help-on-iran.html', 'snippet': 'With positive noise from Tehran, this is not the time to impose new economic sanctions.', 'lead_paragraph': 'It is crucial that Congress work constructively with President Obama as he tries to lead the way in negotiating a nuclear agreement with Iran. But some lawmakers are so suspicious of Iran and so blindly committed to more sanctions that they could sabotage the best opportunity in years for a peaceful resolution of an issue that has long blocked any fundamental improvement in relations between the two countries while complicating the prospects for stability in the Middle East.', 'print_section': 'A', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Congress Can Help on Iran', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Congress Can Help on Iran', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Iran', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Embargoes and Economic Sanctions', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Nuclear Weapons', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States International Relations', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Rouhani, Hassan', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-11-04T02:15:38+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/415fd676-23a5-5694-8284-e6a6a8027ef7', 'word_count': 466, 'uri': 'nyt://article/415fd676-23a5-5694-8284-e6a6a8027ef7'}, {'abstract': 'Researchers point to a possible side benefit to the legalization of marijuana for medical use: reductions in heavy drinking by young people.', 'web_url': 'https://www.nytimes.com/2013/11/04/opinion/marijuana-and-alcohol.html', 'snippet': 'Researchers point to a possible side benefit to the legalization of marijuana for medical use: reductions in heavy drinking by young people.', 'lead_paragraph': 'Americans are growing more comfortable with marijuana, with 58 percent favoring legalization, according to the latest Gallup poll. At the same time, some researchers believe they have identified a side benefit to increasing availability of the drug: It could lead to decreased consumption of alcohol among young people. ', 'print_section': 'A', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Marijuana and Alcohol', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Marijuana and Alcohol', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Marijuana', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Alcohol Abuse', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Youth', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Anderson, D Mark', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Rees, Daniel I', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Drunken and Reckless Driving', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-11-04T02:17:40+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/f4e0b51b-ff55-5074-bdf9-882d1c1fc104', 'word_count': 249, 'uri': 'nyt://article/f4e0b51b-ff55-5074-bdf9-882d1c1fc104'}, {'abstract': 'The state should adopt a constitutional amendment that would provide relief for low-wage workers.', 'web_url': 'https://www.nytimes.com/2013/11/04/opinion/add-a-dollar-an-hour-in-new-jersey.html', 'snippet': 'The state should adopt a constitutional amendment that would provide relief for low-wage workers.', 'lead_paragraph': 'Ideally, Congress would raise the federal minimum wage above the paltry $7.25 an hour. But since there is little chance of that happening soon, it is up to the states to provide relief for low-wage workers. Nineteen states and the District of Columbia have so far increased the minimum wage above the federal level. Tuesday will be New Jersey’s chance to do the same.', 'print_section': 'A', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Add a Dollar an Hour in New Jersey', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Add a Dollar an Hour in New Jersey', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Minimum Wage', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'New Jersey', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Labor and Jobs', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Constitutional Amendments', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Christie, Christopher J', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-11-04T02:20:21+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/bbc3eb20-7e9e-5a85