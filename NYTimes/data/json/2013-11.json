: [], 'headline': {'main': 'Remixing a Pulitzer Prize-Winning Work', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Pulitzer Prizes', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Shaw, Caroline', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New Amsterdam Presents', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-11-13T20:20:00+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Allan Kozinn', 'person': [{'firstname': 'Allan', 'middlename': None, 'lastname': 'Kozinn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fca0ed6b-2cde-5d72-8f37-93aa76de6139', 'word_count': 175, 'uri': 'nyt://article/fca0ed6b-2cde-5d72-8f37-93aa76de6139'}, {'abstract': '“How to Make Friends and Then Kill Them” follows the uneasy interplay among three friends.', 'web_url': 'https://www.nytimes.com/2013/11/14/theater/reviews/how-to-make-friends-and-then-kill-them-by-halley-feiffer.html', 'snippet': '“How to Make Friends and Then Kill Them” follows the uneasy interplay among three friends.', 'lead_paragraph': 'Is it possible for the characters in a play to wrest control of it from the playwright? “How to Make Friends and Then Kill Them,” a very dark comedy by Halley Feiffer at Rattlestick Playwrights Theater, starts out intriguingly but eventually spirals out of control, the three characters in it seeming as if they are trying to make you regret attending.', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/14/theater/14howto-web/14howto-web-articleLarge.jpg', 'height': 900, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/14/theater/14howto-web/14howto-web-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 900}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/14/theater/14howto-web/14howto-web-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/14/theater/14howto-web/14howto-web-superJumbo.jpg', 'height': 2048, 'width': 1366, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/14/theater/14howto-web/14howto-web-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/14/theater/14howto-web/14howto-web-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/14/theater/14howto-web/14howto-web-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'We’re Buds, Right? It’s Hard to Tell.', 'kicker': 'Theater Review', 'content_kicker': None, 'print_headline': 'We’re Best Buds, Aren’t We?\r\nIt’s Sometimes Hard to Tell.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Rattlestick Playwrights Theater', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Feiffer, Halley', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Keeley, Keira', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-11-13T20:20:07+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Theater', 'subsection_name': 'Theater Reviews', 'byline': {'original': 'By Neil Genzlinger', 'person': [{'firstname': 'Neil', 'middlename': None, 'lastname': 'Genzlinger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/07d1a823-2d4d-5625-ac99-71a5cbbbd1b4', 'word_count': 323, 'uri': 'nyt://article/07d1a823-2d4d-5625-ac99-71a5cbbbd1b4'}, {'abstract': '“Ballerina Swan” is a stage adaptation of Allegra Kent’s children’s book about a swan who wants to dance.', 'web_url': 'https://www.nytimes.com/2013/11/13/theater/reviews/ballerina-swan-choreographed-by-michael-mcgowan.html', 'snippet': '“Ballerina Swan” is a stage adaptation of Allegra Kent’s children’s book about a swan who wants to dance.', 'lead_paragraph': 'A swan puppet makes an early appearance in certain versions of “Swan Lake,” illustrating the heroine’s ensnarement at the hands of an evil magician. It’s a big moment in the narrative, obviously, but that bird has it easy compared with Sophie, who carries on her feathered wings the entire production of “Ballerina Swan,” a children’s book by the former ballerina Allegra Kent that has been turned into a children’s dance-theater work by Making Books Sing.', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/13/theater/13ballerina-web/13ballerina-web-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/13/theater/13ballerina-web/13ballerina-web-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/13/theater/13ballerina-web/13ballerina-web-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name