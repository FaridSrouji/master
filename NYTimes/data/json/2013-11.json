words': [{'name': 'persons', 'value': 'Grcic, Konstantin', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Jongerius, Hella', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Maharam, Michael', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Morrison, Jasper', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Maharam', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-11-20T16:13:41+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Pilar Viladas', 'person': [{'firstname': 'Pilar', 'middlename': None, 'lastname': 'Viladas', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bb021560-d92b-5cc1-9a58-3263f3acb8fd', 'word_count': 218, 'uri': 'nyt://article/bb021560-d92b-5cc1-9a58-3263f3acb8fd'}, {'abstract': 'The story behind Gettysburg National Cemetery.', 'web_url': 'https://opinionator.blogs.nytimes.com/2013/11/20/consecrating-hallowed-ground/', 'snippet': 'The story behind Gettysburg National Cemetery.', 'lead_paragraph': 'On the morning of Tuesday, Nov. 19, 2013, a small army of Civil War re-enactors, a well-known Lincoln impersonator, federal government representatives, the governor of Pennsylvania and its two senators, its congressional representative and a host of municipal officials gathered at the Gettysburg National Cemetery to mark the 150th anniversary of Lincoln’s famous address.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Consecrating Hallowed Ground', 'kicker': 'Disunion', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cemeteries', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Civil War (US) (1861-65)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Lincoln, Abraham', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Gettysburg (Pa)', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-11-20T16:14:37+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Jeffrey B. Roth', 'person': [{'firstname': 'Jeffrey', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/312514fb-d602-5c6d-88b1-78d99706fdeb', 'word_count': 1056, 'uri': 'nyt://article/312514fb-d602-5c6d-88b1-78d99706fdeb'}, {'abstract': 'The University of Maryland will become the new home of the DeVos Institute of Arts Management next fall when Michael Kaiser, its founder and the current president of the Kennedy Center in Washington, relocates the organization to the university.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/11/20/devos-institute-of-arts-management-to-relocate-to-the-university-of-maryland/', 'snippet': 'The University of Maryland will become the new home of the DeVos Institute of Arts Management next fall when Michael Kaiser, its founder and the current president of the Kennedy Center in Washington, relocates the organization to the university.', 'lead_paragraph': 'Michael M. Kaiser’s arts management institute is moving from the Kennedy Center in Washington to the University of Maryland and Mr. Kaiser is moving with it — four months earlier than his originally announced departure.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'DeVos Institute of Arts Management to Relocate to the University of Maryland', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Kaiser, Michael M', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Kennedy, John F, Center for the Performing Arts', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Maryland', 'rank': 3, 'major': 'N'}], 