Large-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/21/sports/yVONN/yVONN-jumbo-v2.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/21/sports/yVONN/yVONN-superJumbo-v2.jpg', 'height': 1182, 'width': 1771, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/21/sports/yVONN/yVONN-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/21/sports/yVONN/yVONN-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/21/sports/yVONN/yVONN-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'After Another Knee Injury, Duration of Recovery for Vonn Is Uncertain', 'kicker': None, 'content_kicker': None, 'print_headline': 'Duration Of Recovery For Vonn Is Uncertain', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ALPINE SKIING', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Vonn, Lindsey', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Olympic Games (2014)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Skiing', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-11-20T20:51:47+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Olympics', 'byline': {'original': 'By Bill Pennington', 'person': [{'firstname': 'Bill', 'middlename': None, 'lastname': 'Pennington', 'qualifier': None, 'title': None, 