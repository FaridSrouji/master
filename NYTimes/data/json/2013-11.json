s', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Small Business Administration', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-11-12T12:00:21+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Entrepreneurship', 'byline': {'original': 'By Josh Patrick', 'person': [{'firstname': 'Josh', 'middlename': None, 'lastname': 'Patrick', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e9d11446-ab41-5692-8bc3-b3cbe512726d', 'word_count': 819, 'uri': 'nyt://article/e9d11446-ab41-5692-8bc3-b3cbe512726d'}, {'abstract': 'Mr. Gurlitt had 1,400 artworks, possibly looted during the Nazi era, stashed in his Munich home.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/11/12/cornelius-gurlitt-seen-headed-to-airport-in-munich/', 'snippet': 'Mr. Gurlitt had 1,400 artworks, possibly looted during the Nazi era, stashed in his Munich home.', 'lead_paragraph': 'MUNICH – Cornelius Gurlitt, the 80-year-old recluse who kept roughly 1,400 artworks hidden in his Munich home, left his apartment building Tuesday and took a taxi to the airport, witnesses said. It was not clear where he was heading. A woman who escorted Mr Gurlitt to the taxi and then drove off with him appeared to be Ozlem Gezer, an investigative journalist for Der Spiegel, Germany’s leading news magazine. The magazine declined to comment.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/13/arts/germanart-floater/germanart-floater-articleLarge.jpg', 'height': 380, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/13/arts/germanart-floater/germanart-floater-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 380}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image'