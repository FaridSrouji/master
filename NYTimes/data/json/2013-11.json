, 'multimedia': [], 'headline': {'main': 'More Style Choices', 'kicker': 'After Deadline', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-11-12T13:00:14+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Times Topics', 'byline': {'original': 'By PHILIP B. CORBETT', 'person': [{'firstname': 'Philip', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bc970017-2167-5b29-b4a7-9750652a2691', 'word_count': 1623, 'uri': 'nyt://article/bc970017-2167-5b29-b4a7-9750652a2691'}, {'abstract': 'The actor performs a scene from Sharr White’s new Broadway play at the Samuel J. Friedman Theater.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/11/12/in-performance-brian-cross-of-the-snow-geese/', 'snippet': 'The actor performs a scene from Sharr White’s new Broadway play at the Samuel J. Friedman Theater.', 'lead_paragraph': 'Sharr White’s new play “The Snow Geese” stars Mary-Louise Parker as a World War I-era widow dealing with her fractious family after the death of her husband. In this scene her 18-year-old son, Arnold, played by Brian Cross, chastises his mother for the family’s questionable financial decisions. The show, directed by Daniel Sullivan, continues through Dec. 15 at the Samuel J. Friedman Theater.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In Performance: Brian Cross of ‘The Snow Geese’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Cross, Brian', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'White, Sharr', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-11-12T13:00:36+0000', 'document_type': 'article', 'news_desk': '', '