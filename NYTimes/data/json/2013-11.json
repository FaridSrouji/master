y': {'thumbnail': 'images/2013/12/01/magazine/01wmt/01wmt-thumbStandard-v2.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/magazine/01wmt/01wmt-thumbLarge-v2.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Who Made That Spork?', 'kicker': None, 'content_kicker': None, 'print_headline': 'Who Made That? (Spork)', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Gross, Jessica', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Tableware', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Inventions and Patents', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-11-29T15:30:05+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Jessica Gross', 'person': [{'firstname': 'Jessica', 'middlename': None, 'lastname': 'Gross', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0e811488-c731-56ae-b98a-6f34e77ba7b1', 'word_count': 689, 'uri': 'nyt://article/0e811488-c731-56ae-b98a-6f34e77ba7b1'}, {'abstract': 'Black-market gray area; contribution conundrum.', 'web_url': 'https://www.nytimes.com/2013/12/01/magazine/did-i-fence-a-sign.html', 'snippet': 'Black-market gray area; contribution conundrum.', 'lead_paragraph': 'Looking for artwork for my home, I recently bought a used road sign online — a bright blue one advertising a campground ahead. I liked it and ended up buying a second one. Only after I purchased those two signs did it occur to me that they may have been stolen. Now I feel guilty. Throwing them in the recycling bin doesn’t really make the situation right. Selling them to someone else is no better. Reporting the sellers seems hypocritical — plus, I have no evidence. What is my obligation as an ethical citizen? BEVERLY BARTLETT, LOUISVILLE, KY.', 'print_section': 'MM', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/02/02/magazine/ethicist/ethicist-articleLarge.jpg', 'height': 1316, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/02/02/magazine/ethicist/ethicist-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 1316}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/02/02/magazine/ethicist/ethicist-jumbo.jpg', 'height': 1024, 'width': 467, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/02/02/magazine/ethicist/ethicist-superJumbo.jpg', 'height': 2048, 'width': 934, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/02/02/magazine/ethicist/ethicist-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/02/02/magazine/ethicist/ethicist-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/02/02/magazine/ethicist/ethicist-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Did I Fence a Sign?', 'kicker': None, 'content_kicker': None, 'print_headline': 'Did I Fence a Sign?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Klosterman, Chuck', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Ethics (Personal)', 'rank': 2, 'major': 'N'}, {'name': 'su