legacy': {}}], 'headline': {'main': 'Da Vinci and the Biblioteca Reale', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'da Vinci, Leonardo', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Morgan Library & Museum', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-11-07T21:53:32+0000', 'document_type': 'multimedia', 'news_desk': 'Arts', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/4b046947-7f2f-5b5b-9df4-fc8654287f0a', 'word_count': 0, 'uri': 'nyt://slideshow/4b046947-7f2f-5b5b-9df4-fc8654287f0a'}, {'abstract': 'An exhibition at the Morgan Library & Museum features a group of works by Leonardo da Vinci from the Biblioteca Reale in Turin, Italy, including one of his celebrated notebooks.', 'web_url': 'https://www.nytimes.com/2013/11/08/arts/design/morgan-show-spotlights-works-from-biblioteca-reale.html', 'snippet': 'An exhibition at the Morgan Library & Museum features a group of works by Leonardo da Vinci from the Biblioteca Reale in Turin, Italy, including one of his celebrated notebooks.', 'lead_paragraph': 'In 2003, the Metropolitan Museum mounted an exhibition of just under 100 drawings by Leonardo da Vinci and pulled in close to half a million visitors in just over two months. This fall, the Morgan Library & Museum is presenting a miniature — very miniature — version of that show called “Leonardo da Vinci: Treasures From the Biblioteca Reale, Turin,” and it, too, should generate serious traffic, particularly as it includes two outstanding items — a book and a drawing — that the Met didn’t have.', 'print_section': 'C', 'print_page': '38', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/08/arts/design/20131108-LEONARDO-slide-0FBD/20131108-LEONARDO-slide-0FBD-articleLarge-v2.jpg', 'height': 365, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/08/arts/design/20131108-LEONARDO-slide-0FBD/20131108-LEONARDO-slide-0FBD-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 365}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/08/arts/design/20131108-LEONARDO-slide-0FBD/20131108-LEONARDO-slide-0FBD-jumbo-v2.jpg', 'height': 623, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/08/arts/design/20131108-LEONARDO-slide-0FBD/20131108-LEONARDO-slide-0FBD-superJumbo-v2.jpg', 'height': 1246, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/08/arts/design/20131108-LEONARDO-slide-0FBD/20131108-LEONARDO-slide-0FBD-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/08/arts/design/20131108-LEONARDO-slide-0FBD/20131108-LEONARDO-slide-0FBD-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/08/arts/design/20131108-LEONARDO-slide-0FBD/20131108-LEONARDO-slide-0FBD-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Where a Little Dose of Leonardo Is Still a Lot', 'kicker': 'Art Review', 'content_kicker': None, 'print_headline': 'Where a Little Dose of Leonardo Is Still a Lot', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Cotter, Holland', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'da Vinci, Leonardo', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Morgan Library & Museum', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-11-07T21:56:15+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Holland Cotter', 'person': [{'firstname': 'Holland', 'middlename': None, 'lastname': 'Cotter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/6f87a21c-980f-5aef-adce-63b47da24ef2', 'word_count': 1225, 'uri': 'nyt://article/6f87a21c-980f-5aef-adce-63b47da24ef2'}, {'abstract': 'Mr. Hilburn’s new biography covers the many highs and lows of the Man in Black’s career.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/11/07/no-fairy-tale-robert-hilburn-talks-about-johnny-cash-the-life/', 'snippet': 'Mr. Hilburn’s new biography covers the many highs and lows of the Man in Black’s career.', 'lead_paragraph': 'Robert Hilburn’s new biography of Johnny Cash starts with Cash as a young boy in rural Arkansas, walking along a gravel road at night and singing to himself. The more than 600 pages that follow cover everything — from the famed concert in Folsom Prison (Mr. Hilburn was there that day) to the unlikely, celebrated records Cash made with the hip-hop producer Rick Rubin starting in 1994. As Stephen Holden wrote in his obituary of Cash when the singer died at 71 in 2003, he “was one of the few performers who outlasted trends to become a mythical figure rediscovered by each new generation.” In a recent e-mail interview, Mr. Hilburn, a former longtime music critic for The Los Angeles Times, discussed the biopic “Walk the Line,” Cash’s tumultuous marriage to June Carter, Cash’s influence today and more. Below are edited excerpts from the conversation:', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/07/books/07cash-1/07cash-1-articleLarge.jpg', 'height': 933, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/07/books/07cash-1/07cash-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 933}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/07/books/07cash-1/07cash-1-jumbo.jpg', 'height': 1024, 'width': 659, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/07/books/07cash-1/07cash-1-superJumbo.jpg', 'height': 2048, 'width': 1317, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/07/books/07cash-1/07cash-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/07/books/07cash-1/07cash-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/07/books/07cash-1/07cash-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'No Fairy Tale: Robert Hilburn Talks About ‘Johnny Cash: The Life’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Country Music', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'C