ument_type': 'multimedia', 'news_desk': 'New York', 'section_name': 'New York', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/1e20fb11-762a-5c9e-b94b-b146884763bf', 'word_count': 0, 'uri': 'nyt://slideshow/1e20fb11-762a-5c9e-b94b-b146884763bf'}, {'abstract': 'President Obama signed a bill removing a cap on spending for federally owned chimpanzees in sanctuaries. The change does not involve any budget increase.', 'web_url': 'https://www.nytimes.com/2013/11/28/us/retirement-secured-for-chimpanzees.html', 'snippet': 'President Obama signed a bill removing a cap on spending for federally owned chimpanzees in sanctuaries. The change does not involve any budget increase.', 'lead_paragraph': 'It’s a good Thanksgiving for about 300 research chimpanzees headed for retirement. President Obama signed a bill on Wednesday removing a cap on spending for federally owned chimpanzees in sanctuaries. The change does not involve any budget increase. But it allows the National Institutes of Health to spend money to support the chimps in retirement that would have been used to support them in research labs. The institutes announced in June that the 300 would be retired, leaving only about 50 for potential future research needs. ', 'print_section': 'A', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Retirement Secured for Chimpanzees', 'kicker': 'National Briefing | Health', 'content_kicker': None, 'print_headline': 'Retirement Secured For Chimpanzees', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Gorman, James', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Monkeys and Apes', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'National Institutes of Health', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Research', 'rank': 5, 'majo