k': 10, 'major': 'N'}, {'name': 'organizations', 'value': 'Fast Food Forward', 'rank': 11, 'major': 'N'}, {'name': 'organizations', 'value': 'Service Employees International Union', 'rank': 12, 'major': 'N'}, {'name': 'persons', 'value': 'Shoy, Eduardo', 'rank': 13, 'major': 'N'}, {'name': 'subject', 'value': 'Strikes', 'rank': 14, 'major': 'N'}], 'pub_date': '2013-11-28T21:46:40+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Alan Feuer', 'person': [{'firstname': 'Alan', 'middlename': None, 'lastname': 'Feuer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b2a4e8c7-e0a8-598e-819d-8bdd9d350580', 'word_count': 2563, 'uri': 'nyt://article/b2a4e8c7-e0a8-598e-819d-8bdd9d350580'}, {'abstract': 'Lauryn Hill gave old material new life as part of her re-emergence in a concert on the Lower East Side of Manhattan.', 'web_url': 'https://www.nytimes.com/2013/11/29/arts/music/lauryn-hill-re-emerges-at-the-bowery-ballroom.html', 'snippet': 'Lauryn Hill gave old material new life as part of her re-emergence in a concert on the Lower East Side of Manhattan.', 'lead_paragraph': 'It wasn’t just a club date and the start of a tour; it was also a video shoot. When Lauryn Hill performed at the Bowery Ballroom on Wednesday night, the camera swiveling over the heads of the audience suggested that the show was something more than Ms. Hill’s re-emergence after her recent three-month jail term for failing to file taxes. It was gathering the kind of material performers use to promote new releases — which, in Ms. Hill’s case, would be more than welcome.', 'print_section': 'C', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/29/arts/29LAURYN/29LAURYN-articleLarge.jpg', 'height': 400, 'width': 600,