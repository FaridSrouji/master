 'multimedia': [], 'headline': {'main': 'Obama Proposal Worries Insurers and Regulators', 'kicker': None, 'content_kicker': None, 'print_headline': 'Obama Proposal Worries Insurers and Regulators', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Abelson, Reed', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Health Insurance and Managed Care', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Patient Protection and Affordable Care Act (2010)', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-11-15T02:12:52+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Reed Abelson and Abby Goodnough', 'person': [{'firstname': 'Reed', 'middlename': None, 'lastname': 'Abelson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Abby', 'middlename': None, 'lastname': 'Goodnough', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6cac245f-1548-5b39-8b04-41e2d0d10456', 'word_count': 925, 'uri': 'nyt://article/6cac245f-1548-5b39-8b04-41e2d0d10456'}, {'abstract': 'Some of the blame for the slow relief efforts after Typhoon Haiyan is falling on Imelda Marcos and her family, who have long been revered in Tacloban, the Philippines.', 'web_url': 'https://www.nytimes.com/2013/11/15/world/asia/not-even-marcos-family-is-spared-residents-ire.html', 'snippet': 'Some of the blame for the slow relief efforts after Typhoon Haiyan is falling on Imelda Marcos and her family, who have long been revered in Tacloban, the Philippines.', 'lead_paragraph': 'TACLOBAN, the Philippines — Look around this once-gracious city by a horseshoe-shape bay and it is still possible to imagine it before the mass deaths and devastation of last Friday’s typhoon, when it was a jewel of the Pacific thanks in good part to a local girl who became a global celebrity: Imelda R. Marcos, the flamboyant former first lady of the Philippines.', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/15/world/IMELDA/IMELDA-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/15/world/IMELDA/IMELDA-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/15/world/IMELDA/IMELDA-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/15/world/IMELDA/IMELDA-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/15/world/IMELDA/IMELDA-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/15/world/IMELDA/IMELDA-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/15/world/IMELDA/IMELDA-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Not Even Marcos Family Is Spared Residents’ Ire', 'kicker': None, 'content_kicker': None, 'print_headline': 'Not Even Marcos Family Is Spared Residents’ Ire', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Bradsher, Keith', 'rank'