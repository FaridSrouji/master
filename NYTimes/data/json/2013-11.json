 600, 'xlargeheight': 450}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/26/travel/26ski/26ski-jumbo.jpg', 'height': 768, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/26/travel/26ski/26ski-superJumbo.jpg', 'height': 1536, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/26/travel/26ski/26ski-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/26/travel/26ski/26ski-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/26/travel/26ski/26ski-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Ski Spot That’s Remote, No Frills and Not for Profit', 'kicker': 'In Transit', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'AIR CANADA', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Canada', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-11-29T15:43:07+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Travel', 'byline': {'original': 'By Rachel Harris', 'person': [{'firstname': 'Rachel', 'middlename': None, 'lastname': 'Harris', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cd3ea46b-fe48-5f46-a3b2-78e0630f3a42', 'word_count': 338, 'uri': 'nyt://article/cd3ea46b-fe48-5f46-a3b2-78e0630f3a42'}, {'abstract': 'The Rolling Stones hated to be compared with the Beatles, but after 50 years they still are.', 'web_url': 'https://www.nytimes.com/2013/12/01/books/review/beatles-vs-stones-and-rocks-off.html', 'snippet': 'The Rolling Stones hated to be compared with the Beatles, but after 50 years they still are.', 'lead_paragraph': 'As the 50th-anniversary milestones for the Beatles and the Rolling Stones fly off like calendar pages in an old film, even the stuff of barroom debates gets elevated into book-length exegeses. At least that’s true on the evidence of “Beatles vs. Stones,” by John McMillian, and “Rocks Off: 50 Tracks That Tell the Story of the Rolling Stones,” by Bill Janovitz. The good news is that despite some flaws, each of them justifies its extended treatment of essentially irresolvable disputes. They manage to make their cases in balanced, informed, yet still passionate terms. And, best of all, when you’re done, you don’t need to worry about a crippling hangover. ', 'print_section': 'BR', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/01DECURTIS/01DECURTIS-articleLarge.jpg', 'height': 677, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/01/books/review/01DECURTIS/01DECURTIS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 677}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/01DECURTIS/01DECURTIS-jumbo.jpg', 'height': 1024, 'width': 908, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/01DECURTIS/01DECURTIS-superJumbo.jpg', 'height': 2048, 'width': 1816, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/01DECURTIS/01DECURTIS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/01/books/review/01DECURTIS/01DECURTIS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/01DECURTIS/01DECURTIS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Time Was on Their Side', 'kicker': None, 'content_kicker': None, 'print_headline': 'Time Was on Their Side', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'DeCurtis, Anthony', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Beatles, The', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Rolling Stones', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Rock Music', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'McMillian, John', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Janovitz, Bill', 'rank': 10, 'major': 'N'}], 'pub_date': '2013-11-29T15:43:30+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Anthony DeCurtis', 'person': [{'firstname': 'Anthony', 'middlename': None, 'lastname': 'DeCurtis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/cf272218-39a5-5abd-99b9-92e39beffa78', 'word_count': 1149, 'uri': 'nyt://article/cf272218-39a5-5abd-99b9-92e39beffa78'}, {'abstract': 'Ronald Frame reimagines the life of Miss Havisham, Charles Dickens’s jilted bride.', 'web_url': 'https://www.nytimes.com/2013/12/01/books/review/havisham-by-ronald-frame.html', 'snippet': 'Ronald Frame reimagines the life of Miss Havisham, Charles Dickens’s jilted bride.', 'lead_paragraph': 'Ronald Frame’s fast-moving new novel makes use of the eccentric Miss Havisham from “Great Expectations,” but the first two-thirds of it is much more Trollopian than Dickensian. Right from the start, Catherine Havisham suggests she was born into a world she might never understand: “I killed my mother.” That she was a breech birth, that the death of women in childbirth was a given in early 19th-century England, are simply facts. What is important is that the machine of her life is already operating full tilt, and the most she can do is keep her eyes open and attempt to understand its workings. ', 'print_section': 'BR', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/1201-bks-SMILEY/1201-bks-SMILEY-articleLarge.jpg', 'height': 830, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/01/books/review/1201-bks-SMILEY/1201-bks-SMILEY-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 830}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/1201-bks-SMILEY/1201-bks-SMILEY-jumbo.jpg', 'height': 1024, 'width': 741, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/1201-bks-SMILEY/1201-bks-SMILEY-superJumbo.jpg', 'height': 2048, 'width': 1481, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/1201-bks-SMILEY/1201-bks-SMILEY-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/01/books/review/1201-bks-SMILEY/1201-bks-SMILEY-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/1201-bks-SMILEY/1201-bks-SMILEY-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Twisted Spinster', 'kicker': None, 'content_kicker': None, 'print_headline': 'Twisted Spinster', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Frame, Ronald', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-11-29T15:43:43+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Jane Smiley', 'person': [{'firstname': 'Jane', 'middlename': None, 'lastname': 'Smiley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/e38c1123-2842-588b-b4a6-465c959548c8', 'word_count': 1131, 'uri': 'nyt://article/e38c1123-2842-588b-b4a6-465c959548c8'}, {'abstract': 'Selected poems of Rudyard Kipling combine the canonical with the never before published.', 'web_url': 'https://www.nytimes.com/2013/12/01/books/review/100-poems-old-and-new-by-rudyard-kipling.html', 'snippet': 'Selected poems of Rudyard Kipling combine the canonical with the never before published.', 'lead_paragraph': 'Kipling was a conundrum even to himself. One of the first modern writers to live in the fraught intersections of empire, he wrote between two worlds. Born in Bombay, named after the picturesque Staffordshire lake where his parents had courted, he enjoyed a pampered childhood among the Anglo-Indians, as they called themselves, with a native ayah and loads of Indian servants. At 5, he was banished from this paradise and sent back to the mother country to be raised by a placid English couple. The husband had the bad manners to die, leaving the boy in the charge of the wife, who was secretly a monster. Kipling suffered, as did Dickens, a Dickensian childhood whose cruelties could never be erased.', 'print_section': 'BR', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/01LOGAN/01LOGAN-articleLarge.jpg', 'height': 865, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/01/books/review/01LOGAN/01LOGAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 865}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/01LOGAN/01LOGAN-jumbo.jpg', 'height': 1024, 'width': 711, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/01LOGAN/01LOGAN-superJumbo.jpg', 'height': 1536, 'width': 1066, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/01LOGAN/01LOGAN-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/01/books/review/01LOGAN/01LOGAN-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/01LOGAN/01LOGAN-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Imperial Rhymes', 'kicker': None, 'content_kicker': None, 'print_headline': 'Imperial Rhymes', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Kipling, Rudyard', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Poetry and Poets', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Pinney, Thomas', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-11-29T15:44:01+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By William Logan', 'person': [{'firstname': 'William', 'middlename': None, 'lastname': 'Logan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/1d4368b1-71ad-51ac-9645-876093276f1b', 'word_count': 1642, 'uri': 'nyt://article/1d4368b1-71ad-51ac-9645-876093276f1b'}, {'abstract': 'A history of 100 years of domestic service in England and how it evolved.', 'web_url': 'https://www.nytimes.com/2013/12/01/books/review/servants-by-lucy-lethbridge.html', 'snippet': 'A history of 100 years of domestic service in England and how it evolved.', 'lead_paragraph': '“Downton Abbey” fans may be disappointed to find that Lucy Lethbridge’s lively history of British servants concludes with “Upstairs, Downstairs,” the 1971-75 television series created by the children of a housemaid and an under-\xadbutler. On-screen, this costume drama may have looked like a period piece, but behind the scenes, class tensions persisted. Upon arriving at the set, the actors playing the downstairs roles discovered they had been allotted inferior dressing rooms, with showers monopolized by the actors playing their masters.', 'print_section': 'BR', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/1201-bks-Price/1201-bks-Price-articleLarge.jpg', 'height': 2590, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/01/books/review/1201-bks-Price/1201-bks-Price-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 2590}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/1201-bks-Price/1201-bks-Price-jumbo.jpg', 'height': 1024, 'width': 238, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/1201-bks-Price/1201-bks-Price-superJumbo.jpg', 'height': 2048, 'width': 475, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/1201-bks-Price/1201-bks-Price-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/01/books/review/1201-bks-Price/1201-bks-Price-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/1201-bks-Price/1201-bks-Price-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Help and the Helped', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Help and the Helped', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Domestic Service', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Lethbridge, Lucy', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-11-29T15:44:46+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Leah Price', 'person': [{'firstname': 'Leah', 'middlename': None, 'lastname': 'Price', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/b618f83f-5f5d-5a17-b163-bb9bcd7acb39', 'word_count': 1234, 'uri': 'nyt://article/b618f83f-5f5d-5a17-b163-bb9bcd7acb39'}, {'abstract': 'An ode to the art of letter writing in the digital age.', 'web_url': 'https://www.nytimes.com/2013/12/01/books/review/to-the-letter-by-simon-garfield.html', 'snippet': 'An ode to the art of letter writing in the digital age.', 'lead_paragraph': 'Once there were letters: handwritten, typewritten, carefully crafted, dashed off, profound or mundane, tinged with expectancy. Correspondence required waiting. “I need you more and more, and the great world grows wider, and dear ones fewer and fewer, every day that you stay away,” Emily Dickinson wrote to her future sister-in-law, Susan Gilbert, in 1852. Were they alive today, would Dickinson and Gilbert merely G-chat?', 'print_section': 'BR', 'print_page': '25', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Kind Regards', 'kicker': None, 'content_kicker': None, 'print_headline': 'Kind Regards', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Ciuraru, Carmela', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Garfield, Simon', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Letters', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-11-29T15:45:01+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Carmela Ciuraru', 'person': [{'firstname': 'Carmela', 'middlename': None, 'lastname': 'Ciuraru', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/2fe87f5d-bb2e-5e2b-83b0-c04cb947600d', 'word_count': 651, 'uri': 'nyt://article/2fe87f5d-bb2e-5e2b-83b0-c04cb947600d'}, {'abstract': 'Alison Weir chronicles the life of the first Tudor queen.', 'web_url': 'https://www.nytimes.com/2013/12/01/books/review/elizabeth-of-york-by-alison-weir.html', 'snippet': 'Alison Weir chronicles the life of the first Tudor queen.', 'lead_paragraph': 'Alison Weir’s new biography documents the life of the Tudors’ other Queen Elizabeth. Weir has already produced biographies of Elizabeth I, Henry VIII and Eleanor of Aquitaine, all better known than Elizabeth of York, whose obscurity belies the high profile of her connections. She came of age during the Wars of the Roses, the dynastic rivalry between the Houses of York and Lancaster. As the daughter of a Yorkist king, Edward IV, and the wife of the first Tudor (Lancastrian) king, Henry VII, she united these warring houses. For this alone, she deserves a prominent place in English history. ', 'print_section': 'BR', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/1201-bks-BOYLAN/1201-bks-BOYLAN-articleLarge.jpg', 'height': 1018, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/01/books/review/1201-bks-BOYLAN/1201-bks-BOYLAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 1018}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/1201-bks-BOYLAN/1201-bks-BOYLAN-jumbo.jpg', 'height': 1024, 'width': 604, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/1201-bks-BOYLAN/1201-bks-BOYLAN-superJumbo.jpg', 'height': 2048, 'width': 1208, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/1201-bks-BOYLAN/1201-bks-BOYLAN-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/01/books/review/1201-bks-BOYLAN/1201-bks-BOYLAN-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/1201-bks-BOYLAN/1201-bks-BOYLAN-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Materfamilias', 'kicker': None, 'content_kicker': None, 'print_headline': 'Materfamilias', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Weir, Alison', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-11-29T15:45:25+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Roger Boylan', 'person': [{'firstname': 'Roger', 'middlename': None, 'lastname': 'Boylan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/290c5e5e-3da1-5d8e-8a13-d4c70bbde294', 'word_count': 639, 'uri': 'nyt://article/290c5e5e-3da1-5d8e-8a13-d4c70bbde294'}, {'abstract': 'In “No Man’s Nightingale,” by Ruth Rendell, Inspector Wexford investigates a murder case bungled by his old deputy.', 'web_url': 'https://www.nytimes.com/2013/12/01/books/review/no-mans-nightingale-by-ruth-rendell-and-more.html', 'snippet': 'In “No Man’s Nightingale,” by Ruth Rendell, Inspector Wexford investigates a murder case bungled by his old deputy.', 'lead_paragraph': 'NO MAN’S NIGHTINGALE (Scribner, $26) is Ruth Rendell’s 24th Inspector Wexford procedural mystery in almost 50 years, so we’re naturally curious about how that venerable detective may have mellowed in retirement. Well, his mind is still sharp enough to solve a murder case bungled by Mike Burden, his old deputy and now detective superintendent of the Kingsmarkham constabulary. Always a tolerant man, Wexford is ever more alarmed by the racism and bigotry that have taken root in his little patch of England and were a factor in the murder of the Rev. Sarah Hussain, a biracial single mother raising an out-of-wedlock child. And, if anything, he’s grown more caustic about barbaric insults to the mother tongue, like the Alternative Service Book that replaced the Book of Common Prayer in Anglican churches.', 'print_section': 'BR', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/1201-bks-CRIME/1201-bks-CRIME-articleLarge.jpg', 'height': 1059, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/01/books/review/1201-bks-CRIME/1201-bks-CRIME-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 1059}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/1201-bks-CRIME/1201-bks-CRIME-jumbo.jpg', 'height': 1024, 'width': 580, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/1201-bks-CRIME/1201-bks-CRIME-superJumbo.jpg', 'height': 1605, 'width': 909, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/1201-bks-CRIME/1201-bks-CRIME-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/01/books/review/1201-bks-CRIME/1201-bks-CRIME-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/1201-bks-CRIME/1201-bks-CRIME-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Murder at the Vicarage', 'kicker': None, 'content_kicker': None, 'print_headline': 'Murder at the Vicarage', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Rendell, Ruth', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Connelly, Michael', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Bruen, Ken', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-11-29T15:46:18+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Marilyn Stasio', 'person': [{'firstname': 'Marilyn', 'middlename': None, 'lastname': 'Stasio', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/e2a2a90b-2931-5f87-8a06-d5800097e26a', 'word_count': 911, 'uri': 'nyt://article/e2a2a90b-2931-5f87-8a06-d5800097e26a'}, {'abstract': 'Anthony Russell recalls holidays at grandmother’s house.', 'web_url': 'https://www.nytimes.com/2013/12/01/books/review/outrageous-fortune-by-anthony-russell.html', 'snippet': 'Anthony Russell recalls holidays at grandmother’s house.', 'lead_paragraph': 'Why are wealthy Britons so entertaining to read about? Maybe it has something to do with the collision of crisp formality and a kind of babyish loopiness — looming over every well-manicured herbaceous border and syntactically rigorous sentence is an eccentric uncle named Birtwhistle. Or, more darkly, maybe fans of the Patrick Melrose novels and “Downton Abbey” are drawn like moths to the flame of scandal: To learn of an illustrious family’s secret shame is to put a human face on a glamorous abstraction.', 'print_section': 'BR', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/01ALFORD/01ALFORD-articleLarge.jpg', 'height': 255, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/01/books/review/01ALFORD/01ALFORD-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 255}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/01ALFORD/01ALFORD-jumbo.jpg', 'height': 436, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/01ALFORD/01ALFORD-superJumbo.jpg', 'height': 871, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/01/books/review/01ALFORD/01ALFORD-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/01/books/review/01ALFORD/01ALFORD-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None