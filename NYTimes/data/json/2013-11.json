alifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e1724b47-d979-5a7c-82aa-c1dd7184ea29', 'word_count': 645, 'uri': 'nyt://article/e1724b47-d979-5a7c-82aa-c1dd7184ea29'}, {'abstract': 'The way the Pell grant program is designed makes it harder for low-income students to graduate on schedule.', 'web_url': 'https://www.nytimes.com/2013/11/13/opinion/stop-penalizing-poor-college-students.html', 'snippet': 'The way the Pell grant program is designed makes it harder for low-income students to graduate on schedule.', 'lead_paragraph': 'THE Pell grant program is the federal government’s main strategy for helping low-income students finish college, but the way the program is designed makes it harder for those same students to graduate on schedule. ', 'print_section': 'A', 'print_page': '31', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Stop Penalizing Poor College Students', 'kicker': 'Op-Ed Contributors', 'content_kicker': None, 'print_headline': 'Stop Penalizing Poor College Students', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Pell Grants', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Conklin, Kristin', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Financial Aid (Education)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Johnson, Nate', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Colleges and Universities', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Baum, Sandy', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Tuition', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Community Colleges', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'For-Profit Schools', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'Income', 'rank': 10, 'major': 'N'}], 'pub_date': '2013-11-13T02:03:40+0000', 'document_type': 'article', 'news_de