/22/business/dbpix-suisse/dbpix-suisse-articleLarge.jpg', 'height': 505, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/22/business/dbpix-suisse/dbpix-suisse-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 505}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/22/business/dbpix-suisse/dbpix-suisse-jumbo.jpg', 'height': 862, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/22/business/dbpix-suisse/dbpix-suisse-superJumbo.jpg', 'height': 1724, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/22/business/dbpix-suisse/dbpix-suisse-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/22/business/dbpix-suisse/dbpix-suisse-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/22/business/dbpix-suisse/dbpix-suisse-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Credit Suisse to Wall Off Swiss Banking Business', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': 'Separate Operations', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-11-21T09:42:42+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By CHAD BRAY', 'person': [{'firstname': 'Chad', 'middlename': None, 'lastname': 'BRAY', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bb2b7bed-1335-54c7-b457-775d69b579bf', 'word_count': 407, 'uri': 'nyt://article/bb2b7bed-1335-54c7-b457-775d69b579bf'}, {'abstract': 'Fifty years after the assassination of President John F. Kennedy, a new book showcases The Times’s coverage of his era.', 'web_url': 'https://lens.blogs.nytimes.com/2013/11/21/jfk-through-the-pages-of-the-new-york-times/', 'snippet': 'Fifty years after the assassination of President John F. Kennedy, a new book showcases The Times’s coverage of his era.', 'lead_paragraph': 'After the twin towers fell on Sept. 11, 2001, Todd Purdum, then one of the senior political reporters in the Washington bureau of The Times, began reciting, “America wept tonight, not alone for its dead young president, but for itself.” The words belonged not to him but to James Reston, who wrote them on deadline late in the day on Nov. 22, 1963. Reston, known as Scotty, had assembled some of the best talent ever known to journalism in The Times’s Washington bureau: Tom Wicker, Anthony Lewis, Max Frankel, Russell Baker and others, all of whom had covered the presidency of John F. Kennedy, when Washington was the epicenter of everything.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'J.F.K. Through the Pages of The Times', 'kicker': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'News and News Media', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Newspapers', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Nineteen Hundred Sixties', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Vietnam War', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Baker, Russell', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'John