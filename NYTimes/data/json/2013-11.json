mes', 'multimedia': [], 'headline': {'main': 'From G-Funk to Geometry', 'kicker': 'Wordplay', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Crossword Puzzles', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-11-16T03:00:13+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Crosswords & Games', 'byline': {'original': 'By Thomas Gaffney', 'person': [{'firstname': 'Thomas', 'middlename': None, 'lastname': 'Gaffney', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/35bf3b68-1a80-5cfd-b263-26ba0e89a603', 'word_count': 447, 'uri': 'nyt://article/35bf3b68-1a80-5cfd-b263-26ba0e89a603'}, {'abstract': 'Imposing more penalties on Tehran could cause negotiations to collapse and make war more likely.', 'web_url': 'https://www.nytimes.com/2013/11/16/opinion/not-the-time-to-squeeze-iran.html', 'snippet': 'Imposing more penalties on Tehran could cause negotiations to collapse and make war more likely.', 'lead_paragraph': 'A rare opportunity for a diplomatic resolution to the dispute over Iran’s nuclear program is at risk because many lawmakers, urged on by Prime Minister Benjamin Netanyahu of Israel, are insisting that Congress impose tougher economic sanctions, perhaps next week as an amendment to the defense bill. ', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Not the Time to Squeeze Iran', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Not the Time to Squeeze Iran', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Nuclear Weapons', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Iran', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Embargoes and Economic Sanctions', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Rouhani, H