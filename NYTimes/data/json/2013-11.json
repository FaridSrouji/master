ail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/03/books/review/1103-bks-Shortlist/1103-bks-Shortlist-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/03/books/review/1103-bks-Shortlist/1103-bks-Shortlist-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Subjective Lives', 'kicker': 'The Shortlist', 'content_kicker': None, 'print_headline': 'Subjective Lives', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Schillinger, Liesl', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-11-01T14:37:49+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Liesl Schillinger', 'person': [{'firstname': 'Liesl', 'middlename': None, 'lastname': 'Schillinger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/a07d0b5d-543c-53a9-99cb-21533afa732d', 'word_count': 965, 'uri': 'nyt://article/a07d0b5d-543c-53a9-99cb-21533afa732d'}, {'abstract': 'Daniel Goleman explores the link between mental focus and success.', 'web_url': 'https://www.nytimes.com/2013/11/03/books/review/focus-by-daniel-goleman.html', 'snippet': 'Daniel Goleman explores the link between mental focus and success.', 'lead_paragraph': '“Ineluctable modality of the visible.” So begin the musings of Stephen Dedalus as he walks along Sandymount Strand in the third chapter of James Joyce’s “Ulys\xadses.” “Signatures of all things I am here to read.” The chapter isn’t just a tour de force of prose writing. It’s an exquisitely sensitive depiction of a mind at play. Conscious of his own consciousness, Dedalus monitors his thoughts without reining them in. He’s at once focused and un\xadfocused. Seemingly scattered ideas, sensations and memories coalesce into patterns, into art.', 'print_section': 'BR', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/03/books/review/1103-bks-CARR/1103-bks-CARR-articleLarge.jpg', 'height': 356, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/03/books/review/1103-bks-CARR/1103-bks-CARR-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 356}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/03/books/review/1103-bks-CARR/1103-bks-CARR-jumbo.jpg', 'height': 608, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/03/books/review/1103-bks-CARR/1103-bks-CARR-superJumbo.jpg', 'height': 774, 'width': 1304, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/03/books/review/1103-bks-CARR/1103-bks-CARR-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/03/books/review/1103-bks-CARR/1103-bks-CARR-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/03/books/review/1103-bks-CARR/1103-bks-CARR-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Attention Must Be Paid', 'kicker': None, 'content_kicker': None, 'print_headline': 'Attention Must Be Paid