': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Bill De Blasio Votes With His Family', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Mayors', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Elections', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-11-05T17:10:39+0000', 'document_type': 'multimedia', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'Erica Berenstein', 'person': [{'firstname': 'Erica', 'middlename': None, 'lastname': 'Berenstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/5e285ff5-1f57-57ff-9348-dc36f96a2692', 'word_count': 0, 'uri': 'nyt://video/5e285ff5-1f57-57ff-9348-dc36f96a2692'}, {'abstract': 'Bill de Blasio’s daughter, Chiara, who had told him that she couldn’t make it back from college in California for Election Day because of tests, surprised him by showing up at their house this morning, causing the delay.', 'web_url': 'https://www.nytimes.com/news/election-2013/2013/11/05/new-york-an-election-day-surprise-for-de-blasio/', 'snippet': 'Bill de Blasio’s daughter, Chiara, who had told him that she couldn’t make it back from college in California for Election Day because of tests, surprised him by showing up at their house this morning, causing the delay.', 'lead_paragraph': 'Bill de Blasio arrived almost an hour behind schedule at his polling place at a library in Park Slope, Brooklyn. But Mr. de Blasio, who recently admitted that he was not a morning person, said that he had not overslept. Instead, his daughter, Chiara, who had told him that she couldn’t make it back from college in California for Election Day because of tests, had surprised him by showing up at their house this morning, causing the delay.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'New York: An Election Day Surprise for de Blasio', 'kicker': 'Election Day Coverage and Results', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-11-05T17:16:07+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Kate Taylor', 'person': [{'firstname': 'Kate', 'middlename': None, 'lastname': 'Taylor', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f95c4699-1333-5600-b56f-c18e05adc634', 'word_count': 225, 'uri': 'nyt://article/f95c4699-1333-5600-b56f-c18e05adc634'}, {'abstract': 'The Danish audio company Libratone has embraced a new shape for wireless speakers: round. Its latest, the Loop, resembles a large plate.', 'web_url': 'https://www.nytimes.com/2013/11/07/technology/personaltech/review-libratone-loop-wireless-speakers.html', 'snippet': 'The Danish audio company Libratone has embraced a new shape for wireless speakers: round. Its latest, the Loop, resembles a large plate.', 'lead_paragraph': 'Pity the poor audio speaker. So boxy and square.', 'print_section': 'B', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/07/technology/personaltech/GW-Libratone-Loop/GW-Libratone-Loop-articleLarge.jpg', 'height': 389, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/07/technology/personaltech/GW-Libratone-Loop/GW-Libratone-Loop-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 389}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/07/technology/personaltech/GW-Libratone-Loop/GW-Libratone-Loop-jumbo.jpg', 'height': 664