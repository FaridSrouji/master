AMA-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/15/us/JP-OBAMA/JP-OBAMA-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/15/us/JP-OBAMA/JP-OBAMA-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Health Law Rollout’s Stumbles Draw Parallels to Bush’s Hurricane Response', 'kicker': 'News Analysis', 'content_kicker': None, 'print_headline': 'As Troubles Pile Up, a Crisis of Confidence', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Obama, Barack', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Patient Protection and Affordable Care Act (2010)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Health Insurance and Managed Care', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Bush, George W', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Hurricane Katrina (2005)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-11-14T21:43:41+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Michael D. Shear', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News Analysis', '_id': 'nyt://article/6483ed51-dfbe-5233-917e-64fcd2f1453e', 'word_count': 1032, 'uri': 'nyt://article/6483ed51-dfbe-5233-917e-64fcd2f1453e'}, {'abstract': 'Mr. Oliver was widely praised this summer, when he filled in for Jon Stewart. His new show will have many of the same satirical elements.', 'web_url': 'h