: 'persons', 'value': 'Feinstein, Dianne', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Rogers, Michael J (1963- )', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Snowden, Edward J', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Der Spiegel', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'National Security Agency', 'rank': 10, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 11, 'major': 'N'}], 'pub_date': '2013-11-03T17:25:42+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Brian Knowlton', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Knowlton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ef0eb20d-a98d-5100-b6be-d4ee059c25b5', 'word_count': 616, 'uri': 'nyt://article/ef0eb20d-a98d-5100-b6be-d4ee059c25b5'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2013/11/03/arts/television/whats-on-sunday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '7 P.M. (BET) BLACK GIRLS ROCK! Black Girls Rock!, a nonprofit organization dedicated to the emotional development of young black women, joins forces with BET to pay tribute to role models in professional and public service. Tracee Ellis Ross and Regina King host this special, taped at the New Jersey Performing Arts Center in Newark, honoring women in business, politics, entertainment, sports and community service, including Queen Latifah, Patti LaBelle, Venus Williams, Misty Copeland, Marian Wright Edelman and Ameena Matthews. Performers include Ledisi, foreground above, and Jennifer Hudson, Kelly Rowland, Janelle Monáe, Sevyn Streeter and Amber Riley.', 'print_section': 'SP', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s on Sunday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On Sunday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-11-03T17:53:25+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/9f245ebb-b69b-5acd-81e2-87e153b76d29', 'word_count': 663, 'uri': 'nyt://article/9f245ebb-b69b-5acd-81e2-87e153b76d29'}, {'abstract': 'Julie Taymor takes on Shakespeare’s “Midsummer Night’s Dream” and inaugurates the Polonsky Shakespeare Center, the first proper home for the Theater for a New Audience.', 'web_url': 'https://www.nytimes.com/2013/11/04/theater/reviews/taymors-midsummer-nights-dream-opens-brooklyn-theater.html', 'snippet': 'Julie Taymor takes on Shakespeare’s “Midsummer Night’s Dream” and inaugurates the Polonsky Shakespeare Center, the first proper home for the Theater for a New Audience.', 'lead_paragraph': 'There was no way that Julie Taymor was ever going to dream a little “Dream.” The director who redefined spectacle on Broadway for better (“The Lion King”) and for worse (“Spider-Man: Turn Off the Dark”) has now given New York a “Midsummer Night’s Dream” that doesn’t so much reach for the heavens as roll around in them, with joyous but calculated abandon.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'When the Sky Is No Limit', 'kicker': 'Theater Review', 'content_kicker': None, 'print_headline': 'When the Sky Is No Limit', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': "A Midsummer Night's Dream (Play)", 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Taymor, Julie', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Theater for a New Audience', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Shakespeare, William', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Brooklyn (NYC)', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Casella, Max', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Horowitz, Jeffrey', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Benko, Tina', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Harewood, David', 'rank': 11, 'major': 'N'}, {'name': 'persons', 'value': 'Holder, Donald', 'rank': 12, 'major': 'N'}, {'name': 'persons', 'value': 'Hunter, Kathryn', 'rank': 13, 'major': 'N'}, {'name': 'persons', 'value': 'Goldenthal, Elliot', 'rank': 14, 'major': 'N'}, {'name': 'persons', 'value': 'Okpokwasili, Okwui', 'rank': 15, 'major': 'N'}, {'name': 'persons', 'value': 'Ortel, Sven', 'rank': 16, 'major': 'N'}, {'name': 'persons', 'value': 'Tierney, Matt', 'rank': 17, 'major': 'N'}, {'name': 'persons', 'value': 'Hoffman, Constance', 'rank': 18, 'major': 'N'}], 'pub_date': '2013-11-03T18:00:42+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Theater', 'subsection_name': 'Theater Reviews', 'byline': {'original': 'By Ben Brantley', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Brantley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/64919e42-1aa3-5f69-a334-a95ad08489ae', 'word_count': 1089, 'uri': 'nyt://article/64919e42-1aa3-5f69-a334-a95ad08489ae'}, {'abstract': 'The film took in $28 million at North American theaters over the weekend, which might not be enough to sustain a franchise.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/11/03/enders-game-is-no-1-with-a-caveat/', 'snippet': 'The film took in $28 million at North American theaters over the weekend, which might not be enough to sustain a franchise.', 'lead_paragraph': 'Summit Entertainment marketed “Ender’s Game” as “the motion picture event of the year,” but moviegoers — fresh off “Gravity” and looking ahead to “The Hunger Games: Catching Fire” — apparently saw through that: “Ender’s Game” took in a so-so $28 million at North American theaters over the weekend, winning the box-office race but probably ending studio hopes of introducing a new film franchise. A Summit spokesman called the total “solid” and “in line with the studio’s preweekend expectations.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '‘Ender’s Game’ Is No. 1, With a Caveat', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Card, Orson Scott', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Ford, Harrison', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-11-03T18:20:50+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Brooks Barnes', 'person': [{'firstname': 'Brooks', 'middlename': None, 'lastname': 'Barnes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/65393a4f-e19d-5092-af21-1c1909492fed', 'word_count': 266, 'uri': 'nyt://article/65393a4f-e19d-5092-af21-1c1909492fed'}, {'abstract': 'A new academic book tries to understand how technology influences and affects the way younger people relate to each other and how the public nature of interactions shapes their view of the world around them.', 'web_url': 'https://bits.blogs.nytimes.com/2013/11/03/are-we-too-dependent-on-apps/', 'snippet': 'A new academic book tries to understand how technology influences and affects the way younger people relate to each other and how the public nature of interactions shapes their view of the world around them.', 'lead_paragraph': 'How many times a day do you play a game on your phone, send messages through WhatsApp or Snapchat, post updates on Twitter and Facebook or upload a selfie to Instagram? A dozen? Two dozen?', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/03/books/review/01bits-bookreview/01bits-bookreview-articleLarge-v2.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/03/books/review/01bits-bookreview/01bits-bookreview-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/03/books/review/01bits-bookreview/01bits-bookreview-jumbo-v2.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/03/books/review/01bits-bookreview/01bits-bookreview-superJumbo-v2.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/03/books/review/01bits-bookreview/01bits-bookreview-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/03/books/review/01bits-bookreview/01bits-bookreview-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/03/books/review/01bits-bookreview/01bits-bookreview-thumbLarge-v2.jpg