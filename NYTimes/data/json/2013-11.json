ionships, studies show.', 'lead_paragraph': 'Natasha Gadinsky, 23, says she doesn’t have any regrets from her years in college. But the time she hooked up with a guy at Brown University does come close.', 'print_section': 'D', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/12/science/12SEX_SPAN/12SEX-articleLarge.jpg', 'height': 344, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/12/science/12SEX_SPAN/12SEX-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 344}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/12/science/12SEX_SPAN/12SEX-jumbo.jpg', 'height': 586, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/12/science/12SEX_SPAN/12SEX-superJumbo.jpg', 'height': 1123, 'width': 1961, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/12/science/12SEX_SPAN/12SEX-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/12/science/12SEX_SPAN/12SEX-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/12/science/12SEX_SPAN/12SEX-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In Hookups, Inequality Still Reigns', 'kicker': 'Well', 'content_kicker': None, 'print_headline': 'In Hookups, Inequality Still Reigns', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'valu