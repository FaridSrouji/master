imedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/22/technology/22bits-twitter-alt/22bits-twitter-alt-articleLarge-v2.jpg', 'height': 408, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/22/technology/22bits-twitter-alt/22bits-twitter-alt-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 408}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/22/technology/22bits-twitter-alt/22bits-twitter-alt-jumbo-v2.jpg', 'height': 697, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/22/technology/22bits-twitter-alt/22bits-twitter-alt-superJumbo-v2.jpg', 'height': 1394, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/22/technology/22bits-twitter-alt/22bits-twitter-alt-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/22/technology/22bits-twitter-alt/22bits-twitter-alt-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/22/technology/22bits-twitter-alt/22bits-twitter-alt-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Twitter Toughening Its Security to Thwart Government Snoops', 'kicker': 'Bits', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Computer Security', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Surveillance of Citizens by Government', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Twitter', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-11-22T21:22:38+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By Nicole Perlroth and Vindu Goel', 'person': [{'firstname': 'Nicole', 'middlename': None, 'lastname': 'Perlroth', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Vindu', 'middlename': None, 'lastname': 'Goel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/58be37ec-78f3-5a21-951e-29ebc95a81e6', 'word_count': 753, 'uri': 'nyt://article/58be37ec-78f3-5a21-951e-29ebc95a81e6'}, {'abstract': 'The city is about to begin clearing an area in Queens it calls blighted, but in the tangle of junkyards and auto shops, many people have made a life.', 'web_url': 'https://www.nytimes.com/2013/11/24/nyregion/the-end-of-willets-point.html', 'snippet': 'The city is about to begin clearing an area in Queens it calls blighted, but in the tangle of junkyards and auto shops, many people have made a life.', 'lead_paragraph': 'It is easy to drive past Willets Point, the 62-acre tangle of auto shops, car parts and grease-covered mechanics tinkering with automobiles, that sits hard by the Unisphere of Flushing Meadows-Corona Park. Passing by is far easier than driving through: The streets that cross each other at odd angles here in the glossy shadow of Citi Field look as if they had been blasted by land mines. They are pooled with dark, oil-slicked water or rutted with knee-deep holes that suck in a car’s tires. The chalkboard scrape of chassis meeting pavement sounds through the air here with the regularity of a bell tolling the hour.', 'print_section': 'MB', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The End of Willets Point', 'kicker': None, 'content_kicker': None, 'print_headline': 'The End of Willets Point', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Willets Point (Queens, NY)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Nir, Sarah Maslin', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Eminent Domain', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Willets Point United', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Labor and Jobs', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Relocation of Business', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Area Planning and Renewal', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-11-22T21:30:29+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Sarah Maslin Nir', 'person': [{'firstname': 'Sarah', 'middlename': 'Maslin', 'lastname': 'Nir', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5ac649a3-0688-566e-aafc-7129db03e6ef', 'word_count': 2718, 'uri': 'nyt://article/5ac649a3-0688-566e-aafc-7129db03e6ef'}, {'abstract': 'Alan Gilbert led the New York Philharmonic in a challenging Britten program on Thursday, with replacements related to a tenor’s illness creating some suspense.', 'web_url': 'https://www.nytimes.com/2013/11/23/arts/music/new-york-philharmonic-presents-a-britten-program.html', 'snippet': 'Alan Gilbert led the New York Philharmonic in a challenging Britten program on Thursday, with replacements related to a tenor’s illness creating some suspense.', 'lead_paragraph': 'Before beginning a Britten program on Thursday night with the New York Philharmonic, the conductor Alan Gilbert welcomed the audience at Avery Fisher Hall to what he called the orchestra’s “small part in the worldwide celebrations” of the towering British composer in the year of his centennial. The concert took place the day before what would have been the actual anniversary of his birth. Britten died in 1976. ', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/23/arts/23PHIL/23PHIL-articleLarge.jpg', 'height': 389, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/23/arts/23PHIL/23PHIL-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 389}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/23/arts/23PHIL/23PHIL-jumbo.jpg', 'height': 664, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/23/arts/23PHIL/23PHIL-superJumbo.jpg', 'height': 1329, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/23/arts/23PHIL/23PHIL-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/23/arts/23PHIL/23PHIL-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/23/arts/23PHIL/23PHIL-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Heart in Mouth, for a Taxing Rarity', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Heart in Mouth, for a Taxing Rarity', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'New York Philharmonic', 'rank': 