': 'image', 'url': 'images/2013/11/12/us/VIRGINIA-1/VIRGINIA-1-articleLarge.jpg', 'height': 777, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/12/us/VIRGINIA-1/VIRGINIA-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 777}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/12/us/VIRGINIA-1/VIRGINIA-1-jumbo.jpg', 'height': 997, 'width': 770, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/12/us/VIRGINIA-1/VIRGINIA-1-superJumbo.jpg', 'height': 997, 'width': 770, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/12/us/VIRGINIA-1/VIRGINIA-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/12/us/VIRGINIA-1/VIRGINIA-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/12/us/VIRGINIA-1/VIRGINIA-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Back and Forth in Undecided Virginia Attorney General Race', 'kicker': None, 'content_kicker': None, 'print_headline': 'Back and Forth in Undecided Virginia Attorney General Race', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Gabriel, Trip', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Virginia', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Elections, Attorneys General', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Obenshain, Mark D', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Herring, Mark