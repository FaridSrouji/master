bject', 'value': 'Banking and Financial Institutions', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Federal Taxes (US)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Tax Evasion', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Berman, Richard M', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Internal Revenue Service', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-11-12T23:20:29+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Lynnley Browning', 'person': [{'firstname': 'Lynnley', 'middlename': None, 'lastname': 'Browning', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8156cb13-cf94-5d85-91b2-4567889ef55f', 'word_count': 499, 'uri': 'nyt://article/8156cb13-cf94-5d85-91b2-4567889ef55f'}, {'abstract': 'A team headed by the New York design studio behind the High Line has won an international competition to build a park in the shadow of the Kremlin.', 'web_url': 'https://www.nytimes.com/2013/11/13/arts/design/a-park-for-moscow-with-new-york-roots.html', 'snippet': 'A team headed by the New York design studio behind the High Line has won an international competition to build a park in the shadow of the Kremlin.', 'lead_paragraph': 'A team headed by the New York design studio behind the High Line\xa0has won an international competition to build a park in the shadow of the Kremlin. The team, led by Diller Scofidio & Renfro, presented a concept for the park, in the Zaryadye neighborhood of Moscow, that was based on the theme of “wild urbanism,” with descending terraces reflecting Russia’s four typical land types: tundra, steppe, forest and\xa0wetlands. The renovation of the park is the latest in a series of beautification efforts under Mayor Sergei S. Sobyanin, who has invested heavily in expanding green space in the city amid demands from Moscow’s increasingly vocal middle class. The 13-acre lot has stood vacant since 2006, when the Rossiya Hotel, a landmark of Soviet Moscow, was demolished.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Park for Moscow With New York Roots', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Park for Moscow With New York Roots', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Parks and Other Recreation Areas', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Roth, Andrew', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Diller Scofidio & Renfro', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Moscow (Russia)', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-11-12T23:23:22+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Andrew Roth', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Roth', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/7db61111-cbdb-5228-9afa-5c034942cd3a', 'word_count': 126, 'uri': 'nyt://article/7db61111-cbdb-5228-9afa-5c034942cd3a'}, {'abstract': 'Gilles Vonsattel and the Danish String Quartet performed a complex Peter Lieberson work last Thursday at the Kaplan Penthouse for the Chamber Music Society of Lincoln Center.', 'web_url': 'https://www.nytimes.com/2013/11/13/arts/music/gilles-vonsattel-at-the-chamber-music-society.html', 'snippet': 'Gilles Vonsattel and the Danish String Quartet performed a complex Peter Lieberson work last Thursday at the Kaplan Penthouse for the Chamber Music Society of Lincoln Center.', 'lead_paragraph': 'During a postconcert talk in the Kaplan Penthouse, the pianist Gilles Vonsattel spoke about the difficulty of bringing character to complex and difficult music like Peter Lieberson’s Piano Quintet (2001). ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/12/arts/12chamber-web/12chamber-web-articleLarge.jpg', 'height': 401, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/12/arts/12chamber-web/12chamber-web-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 401}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/12/arts/12chamber-web/12chamber-web-jumbo.jpg', 'height': 684, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/12/arts/12chamber-web/12chamber-web-superJumbo.jpg', 'height': 1367, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/12/arts/12chamber-web/12chamber-web-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/12/arts/12chamber-web/12chamber-web-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/12/arts/12chamber-web/12chamber-web-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Fiddling That Inspired a Piano Quintet', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Fiddling That Inspired a Piano Quintet', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Classical Music', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Danish String Quartet', 'rank': 2, 'major': 'N'},