ame': None, 'lastname': 'Pogrebin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/25f81bc0-dc0e-5e4d-b9e6-09bdb43fcfdf', 'word_count': 179, 'uri': 'nyt://article/25f81bc0-dc0e-5e4d-b9e6-09bdb43fcfdf'}, {'abstract': 'The Sachal Jazz Ensemble and the Jazz at Lincoln Center Orchestra explored themes that cross cultures at the Rose Theater Saturday night.', 'web_url': 'https://www.nytimes.com/2013/11/26/arts/music/sachal-jazz-ensemble-joins-jazz-at-lincoln-center-orchestra.html', 'snippet': 'The Sachal Jazz Ensemble and the Jazz at Lincoln Center Orchestra explored themes that cross cultures at the Rose Theater Saturday night.', 'lead_paragraph': 'Jazz and Pakistani music aren’t complete strangers to each other, as long as you relate Pakistani music to the rest of South Asian music. Think about John Coltrane playing “India” in 1961, and consider that some of the most promising or accomplished improvisers in the United States today — Vijay Iyer, Rudresh Mahanthappa, Rafiq Bhatia and the Karachi-born Rez Abbasi, for instance — come from South Asian families. But musicians living in Pakistan and playing jazz, or something like it: that’s rarer.', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/26/arts/JALC/JALC-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/26/arts/JALC/JALC-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/26/arts/JALC/JALC-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/26/arts/JALC/JALC-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/26/arts/JALC/JALC-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/26/arts/JALC/JALC-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/26/arts/JALC/JALC-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Distant Cousins, Conferring in Different Dialects', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Distant Cousins, Conferring in Different Dialects', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Jazz', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Jazz at Lincoln Center Orchestra', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Sachal Jazz Ensemble', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-11-25T22:30:04+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Ben Ratliff', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Ratliff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/a8fc3fa6-7524-5392-adba-6e8ee4137412', 'word_count': 556, 'uri': 'nyt://article/a8fc3fa6-7524-5392-adba-6e8ee4137412'}, {'abstract': 'The playwright Tom Stoppard’s new work is a one-hour radio play, “Darkside,” for which he has written text to go over the music of “The Dark Side of the Moon.”', 'web_url': 'https://www.nytimes.com/2013/11/26/theater/tom-stoppard-gives-the-dark-side-of-the-moon-a-makeover.html', 'snippet': 'The playwright Tom Stoppard’s new work is a one-hour radio play, “Darkside,” for which he has written text to go over the music of “The Dark Side of the Moon.”', 'lead_paragraph': 'In his 2006 hit play, “Rock ’n’ Roll,” the British playwright Tom Stoppard examined the relationship between music and politics, shuttling back and forth between England and Czechoslovakia over a 25-year period. Now, in a new work, a one-hour radio play called “Darkside,” he has narrowed his focus to a single famous album, Pink Floyd’s “The Dark Side of the Moon.”', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/26/arts/SUB--26DARKSIDEjp/SUB--26DARKSIDEjp-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/26/arts/SUB--26DARKSIDEjp/SUB--26DARKSIDEjp-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/26/arts/SUB--26DARKSIDEjp/SUB--26DARKSIDEjp-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/26/arts/SUB--26DARKSIDEjp/SUB--26DARKSIDEjp-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/26/arts/SUB--26DARKSIDEjp/SUB--26DARKSIDEjp-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/20