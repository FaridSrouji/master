rds': [{'name': 'organizations', 'value': 'Brooklyn Nets', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Basketball', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Kidd, Jason', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-11-16T19:52:03+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Basketball', 'byline': {'original': 'By Andrew Keh', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Keh', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/248dfa0f-7b0a-50c3-b17d-693e87d1f6c2', 'word_count': 1012, 'uri': 'nyt://article/248dfa0f-7b0a-50c3-b17d-693e87d1f6c2'}, {'abstract': 'Let my soul remain twisted, but give me back the fiction of my face.', 'web_url': 'https://www.nytimes.com/2013/11/17/opinion/sunday/i-was-a-portrait-by-francis-bacon.html', 'snippet': 'Let my soul remain twisted, but give me back the fiction of my face.', 'lead_paragraph': 'MILAN — MY bookshelves have a bad habit: They eat books. Especially the books I care most about. My books seem to vanish, and where they’ve gone nobody knows. So I find myself buying the same book, once, twice, even three times in certain cases. One night not long ago, around midnight, I set out, unsuccessfully, to find the book of David Sylvester’s interviews with the painter Francis Bacon. I wanted to verify a quote I use frequently that I suspected might be his, a quote that exemplifies my view of life in general and, sadly, also the less-than-Apollonian way I run my own:', 'print_section': 'SR', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/17/sunday-review/17SUBFACE/17SUBFACE-articleLarge.jpg', 'height': 703, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': '