ge', 'legacy': {'xlarge': 'images/2013/11/22/us/Marines/Marines-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 869}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/22/us/Marines/Marines-jumbo.jpg', 'height': 1024, 'width': 708, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/22/us/Marines/Marines-superJumbo.jpg', 'height': 2048, 'width': 1415, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/22/us/Marines/Marines-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/22/us/Marines/Marines-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/22/us/Marines/Marines-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Once at Kennedy’s Side, Now at One Another’s', 'kicker': None, 'content_kicker': None, 'print_headline': 'Once at Kennedy’s Side, Now at One Another’s', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Kennedy, John Fitzgerald', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Winerip, Michael', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Assassinations and Attempted Assassinations', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'United States Marine Corps', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Funerals and Memorials', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-11-22T04:03:54+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Michael Winerip', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Winerip', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0a42a7fa-5a06-59ce-8c87-b43ca331b825', 'word_count': 1572, 'uri': 'nyt://article/0a42a7fa-5a06-59ce-8c87-b43ca331b825'}, {'abstract': 'Intel executives made a startling admission: that the company’s fixation on personal computers blinded it to the reality that transistors are getting more dense and computing intelligence is traveling to ever-smaller things.', 'web_url': 'https://bits.blogs.nytimes.com/2013/11/21/intels-recovery-realization/', 'snippet': 'Intel executives made a startling admission: that the company’s fixation on personal computers blinded it to the reality that transistors are getting more dense and computing intelligence is traveling to ever-smaller things.', 'lead_paragraph': 'SANTA CLARA, Calif. — In the temple of technology, Intel has confessed to straying from the true path. That may prove to be the start of salvation for the company, the world’s largest maker of semiconductors, but at a price that is yet to be known.', 'print_section': 'B', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/21/business/21bits-intel/21bits-intel-articleLarge.jpg', 'height': 407, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/21/business/21bits-intel/21bits-intel-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 407}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/21/business/21bits-intel/21bits-intel-jumbo.jpg', 'height': 695, 'width': 1024, 'subType': 'ju