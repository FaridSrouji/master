'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Buffalo Bills', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Jets', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Ryan, Rex', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Smith, Geno', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-11-17T22:02:22+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Ben Shpigel', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Shpigel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/44a2353c-614d-59ea-853f-768f8b7f7eb3', 'word_count': 1000, 'uri': 'nyt://article/44a2353c-614d-59ea-853f-768f8b7f7eb3'}, {'abstract': 'Restrictions on Chinese citizens’ ability to trade in their own currency, the renminbi, have contributed to the embrace of digital alternatives.', 'web_url': 'https://sinosphere.blogs.nytimes.com/2013/11/17/bitcoin-scandal-reflects-popularity-of-virtual-currency-in-china/', 'snippet': 'Restrictions on Chinese citizens’ ability to trade in their own currency, the renminbi, have contributed to the embrace of digital alternatives.', 'lead_paragraph': 'On Oct. 26, the website of Global Bond Limited, a Chinese exchange platform for bitcoins, the booming digital currency, suddenly went dead. Then, without warning, GBL’s roughly 500 remaining investors were kicked out of the company’s official QQ group, a social media platform that the company was using for investor relations. By nightfall, the scale of the swindle was made public – 25 million renminbi, or $4.1 million – making it one of the largest bitcoin fraud cases since the currency’s inception four years ago.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Bitcoin Scandal Reflects Popularity of Virtual Currency in China', 'kicker': 'Sinosphere', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'E-Commerce', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Frauds and Swindling', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Renminbi (Currency)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Bitcoin Project', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-11-17T22:05:59+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Adam Century', 'person': [{'firstname': 'Adam', 'middlename': None, 'lastname': 'Century', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e4ea4d64-af6c-57ea-a18c-77b2cdf0d9c1', 'word_count': 578, 'uri': 'nyt://article/e4ea4d64-af6c-57ea-a18c-77b2cdf0d9c1'}, {'abstract': 'Some players have an eye for a good deal for a column.', 'web_url': 'https://www.nytimes.com/2013/11/18/crosswords/bridge/playing-in-six-hearts-after-west-leads-a-diamond.html', 'snippet': 'Some players have an eye for a good deal for a column.', 'lead_paragraph': 'Some players have an eye for a good deal for a column. One is Karen Allison of Las Vegas, a winner of five national championships and a silver medal in the 1994 McConnell World Women’s Teams Championship.', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/18/crosswords/bridge/18card/18card-jumbo.gif', 'height': 500, 'width': 258, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'i