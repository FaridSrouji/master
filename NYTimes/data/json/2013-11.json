/2013/11/13/travel/13max/13max-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 397}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/13/travel/13max/13max-jumbo.jpg', 'height': 678, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/13/travel/13max/13max-superJumbo.jpg', 'height': 1356, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/13/travel/13max/13max-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/13/travel/13max/13max-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/13/travel/13max/13max-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Live Music Gains as a Hotel Amenity', 'kicker': 'In Transit', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Hotels and Travel Lodgings', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-11-13T16:28:14+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Travel', 'byline': {'original': 'By Elaine Glusac', 'person': [{'firstname': 'Elaine', 'middlename': None, 'lastname': 'Glusac', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/76b60656-db93-5c31-9e39-22e0b4fe76c5', 'word_count': 309, 'uri': 'nyt://article/76b60656-db93-5c31-9e39-22e0b4fe76c5'}, {'abstract': 'Punishing children for misbehavior they don’t know how to control only adds to their suffering.', 'web_url': 'https://opinionator.blogs.nytimes.com/2013/11/13/separating-the-child-from-the-trauma/', 'snippet': 'Punishing children for misbehavior they don’t know how to control only adds to their suffering.', 'lead_paragraph': 'Recently, I reported on the damaging effects that prolonged stress can have on young children who lack adequate protection from adults. Over the past 15 years, researchers have learned that highly stressful — and potentially traumatic — childhood experiences are more prevalent than previously understood. Now scientists are shedding light on the mechanisms by which they change the brain and body. These insights have far-reaching implications for schools, where it’s still standard practice to punish children for misbehavior that they often do not know how to control. This is comparable to punishing a child for having a seizure; it adds to the suffering and makes matters worse.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Schools That Separate the Child From the Trauma', 'kicker': 'Fixes', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Anxiety and Stress', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Children and Childhood', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Education (K-12)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Emotions', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'School Discipline (Students)', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-11-13T16:45:04+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By David Bornstein', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Bornstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 