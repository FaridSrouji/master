k': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Rock Music', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-11-04T17:00:07+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Dave Itzkoff', 'person': [{'firstname': 'Dave', 'middlename': None, 'lastname': 'Itzkoff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ecc7baf0-5793-5bf8-8452-563c288435a2', 'word_count': 427, 'uri': 'nyt://article/ecc7baf0-5793-5bf8-8452-563c288435a2'}, {'abstract': 'Many parents and experts encourage teenagers to postpone driving lessons until they’re older. I disagree. The way new drivers get to be good drivers is by driving.', 'web_url': 'https://parenting.blogs.nytimes.com/2013/11/04/teenagers-postpone-learning-to-drive-and-thats-not-good/', 'snippet': 'Many parents and experts encourage teenagers to postpone driving lessons until they’re older. I disagree. The way new drivers get to be good drivers is by driving.', 'lead_paragraph': 'More and more teenagers are putting the brakes on driving.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Teenagers Postpone Learning to Drive, and That’s Not Good', 'kicker': 'Motherlode', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Drivers Education', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Drivers Licenses', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Parenting', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Teenagers and Adolescence', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Traffic Accidents and Safety', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Los Angeles (Calif)', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-11-04T17:10:01+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Randye Hoder', 'person': [{'firstname': 'Randye', 'middlename': None, 'lastname': 'Hoder', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/89f79490-fc0c-52b6-9836-d84fd0e5778c', 'word_count': 649, 'uri': 'nyt://article/89f79490-fc0c-52b6-9836-d84fd0e5778c'}, {'abstract': 'Buckwheat flour provides a great backdrop for the chocolate in these cookies.', 'web_url': 'https://www.nytimes.com/2013/11/05/health/gluten-free-chocolate-buckwheat-biscotti.html', 'snippet': 'Buckwheat flour provides a great backdrop for the chocolate in these cookies.', 'lead_paragraph': 'These biscotti have a crumbly texture when they emerge from the first baking, so allow the logs to cool and cut them carefully, about 1/2 inch thick (if you cut them too thin they can fall apart). Buckwheat flour is a great backdrop for the chocolate; it doesn’t dominate but seems rather to show off the chocolate.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/05/science/05recipehealth/05recipehealth-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/05/science/05recipehealth/05recipehealth-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/05/science/05recipehealth/05recipehealth-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/05/science/05recipehealth/05recipehealth-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/05/science/05recipehealth/05recipehealth-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/05/science/05recipehealth/05recipehealth-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/05/science/05recipehealth/05recipehealth-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Gluten-Free Chocolate Buckwheat Biscotti', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Recipes', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Diet and Nutrition', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Desserts', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Cookies', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-11-04T17:14:51+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Health', 'byline': {'original': 'By Martha Rose Shulman', 'person': [{'firstname': 'Martha', 'middlename': 'Rose', 'lastname': 'Shulman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'recipe', '_id': 'nyt://article/65c94864-163f-59a2-97ce-557876c2488f', 'word_count': 493, 'uri': 'nyt://article/65c94864-163f-59a2-97ce-557876c2488f'}, {'abstract': 'Using a bit of butter results in a delicate cookie that is irresistible.', 'web_url': 'https://www.nytimes.com/2013/11/06/health/gluten-free-raisin-pistachio-biscotti.html', 'snippet': 'Using a bit of butter results in a delicate cookie that is irresistible.', 'lead_paragraph': 'I use a mix of almond flour and either millet flour or cornmeal for these. They are irresistible. If you soak the raisins in amaretto before you make the biscotti there will be a slightly bitter edge to the flavor. As in other whole grain biscotti I use some butter here, which makes for a more delicate cookie, requiring a slightly thicker slice than a wheat flour cookie.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/05/science/06recipehealth/06recipehealth-articleLarge.jpg', 'height': 389, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/05/science/06recipehealth/06recipehealth-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 389}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/05/science/06recipehealth/06recipehealth-jumbo.jpg', 'height': 664, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/05/science/06recipehealth/06recipehealth-superJumbo.jpg', 'height': 1328, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/05/science/06recipehealth/06recipehealth-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/05/science/06recipehealth/06recipehealth-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/05/science/06recipehealth/06recipehealth-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'lega