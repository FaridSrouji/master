', 'xlargewidth': 600, 'xlargeheight': 358}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/15/sports/Y-GIANTS/Y-GIANTS-jumbo.jpg', 'height': 611, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/15/sports/Y-GIANTS/Y-GIANTS-superJumbo.jpg', 'height': 1222, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/15/sports/Y-GIANTS/Y-GIANTS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/15/sports/Y-GIANTS/Y-GIANTS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/15/sports/Y-GIANTS/Y-GIANTS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Giants Cornerback Fighting the Image of Being Too Small', 'kicker': None, 'content_kicker': None, 'print_headline': 'Fighting the Image of Being Too Small', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Pedulla, Tom', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'McBride, Trumaine', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Giants', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-11-15T01:05:10+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Tom Pedulla', 'person': [{'firstname': 'Tom', 'middlename': None, 'lastname': 'Pedulla', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/50204fa9-9503-5337-abaf-6b4c44e1fa39', 'word_count': 649, 'uri': 'nyt://article/50204fa9-9503-5337-abaf-6b4c44e1fa39'}, {'abstract': 'A dispiriting conflict in Seattle shows exactly why the middle class is having trouble getting ahead.', 'web_url': 'https://www.nytimes.com/2013/11/15/opinion/egan-under-my-thumb.html', 'snippet': 'A dispiriting conflict in Seattle shows exactly why the middle class is having trouble getting ahead.', 'lead_paragraph': 'SEATTLE — This is how the middle class dies, not with a bang, but a forced squeeze. After a global corporation posts record profits, it asks the state that has long nurtured its growth for the nation’s biggest single tax break, and then tells the people who make its products that their pension plan will be frozen, their benefits slashed, their pay raises meager. Take it or we leave. And everyone caves.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/11/opinion/timothy-egan/timothy-egan-articleLarge.png', 'height': 300, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/05/11/opinion/timothy-egan/timothy-egan-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 300}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/11/opinion/timothy-egan/timothy-egan-jumbo.png', 'height': 512, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/11/opinion/timothy-egan/timothy-egan-superJumbo.png', 'height': 1000, 'width': 2000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'imag