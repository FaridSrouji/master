etwork', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-11-15T05:05:12+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By The Learning Network', 'person': [], 'organization': 'The Learning Network'}, 'type_of_material': 'News', '_id': 'nyt://article/a11d7f02-d214-5edb-9477-85458562e0e9', 'word_count': 286, 'uri': 'nyt://article/a11d7f02-d214-5edb-9477-85458562e0e9'}, {'abstract': 'Carmelo Anthony scored 45 points and grabbed 10 rebounds against the Rockets, but his potentially game-tying 3-pointer with five seconds remaining was waved off.', 'web_url': 'https://www.nytimes.com/2013/11/15/sports/basketball/last-minute-scramble-thwarts-knicks-anthony.html', 'snippet': 'Carmelo Anthony scored 45 points and grabbed 10 rebounds against the Rockets, but his potentially game-tying 3-pointer with five seconds remaining was waved off.', 'lead_paragraph': 'Over the course of a three-hour slugfest, Carmelo Anthony had done everything he could for the Knicks. He had scored on layups and on turnaround jumpers. He had rebounded and defended. At Madison Square Garden on Thursday night, nobody on the Houston Rockets could stop him. They tried, and they failed.', 'print_section': 'B', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/15/sports/basketball/15knicks-1/15knicks-1-articleLarge.jpg', 'height': 431, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/15/sports/basketball/15knicks-1/15knicks-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 431}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/15/sports/basketball/15knicks-1/15knicks-1-jumbo.jpg', 'height': 736, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'ju