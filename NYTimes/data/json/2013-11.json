one}, 'keywords': [{'name': 'subject', 'value': 'Radiators', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Interior Design and Furnishings', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Heating', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-11-06T23:10:40+0000', 'document_type': 'multimedia', 'news_desk': 'Home & Garden', 'section_name': 'Home & Garden', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/2ca3e8b3-61cc-53ef-94db-66cad3c2542e', 'word_count': 0, 'uri': 'nyt://slideshow/2ca3e8b3-61cc-53ef-94db-66cad3c2542e'}, {'abstract': 'Europeans are endlessly inventive when it comes to radiator design. Why are Americans lagging behind?', 'web_url': 'https://www.nytimes.com/2013/11/07/garden/a-radiance-all-their-own.html', 'snippet': 'Europeans are endlessly inventive when it comes to radiator design. Why are Americans lagging behind?', 'lead_paragraph': 'Several winters ago, Guus van Leeuwen, who was then an industrial design student, was riding with his girlfriend in a horse-drawn sleigh in Sweden. Wrapped in reindeer pelts, the couple watched steam rise from the bodies of the sweating animals in front of them. That’s when “it all came together,” Mr. van Leeuwen said.', 'print_section': 'D', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/07/garden/07RADIATORS_SPAN/07RADIATORS_SPAN-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/07/garden/07RADIATORS_SPAN/07RADIATORS_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/07/garden/07RADIATORS_SPAN/07RADIATORS_SPAN-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/07/garden/07RADIATORS_SPAN/07RADIATORS_SPAN-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/07/garden/07RADIATORS_SPAN/07RADIATORS_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/07/garden/07RADIATORS_SPAN/07RADIATORS_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/07/garden/07RADIATORS_SPAN/07RADIATORS_SPAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Radiance All Their Own', 'kicker': 'The Details', 'content_kicker': None, 'print_headline': 'A Radiance All Their Own', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Interior Design and Furnishings', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Radiators', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Heating', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-11-06T23:10:48+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Julie Lasky', 'person': [{'firstname': 'Julie', 'middlename': None, 'lastname': 'Lasky', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b45e131b-b5d7-5aaf-a313-9a569bd89a48', 'word_count': 1453, 'uri': 'nyt://article/b45e131b-b5d7-5aaf-a313-9a569bd89a48'}, {'abstract': 'Brandon Stanton’s new book of 400 photographic portraits, “Humans of New York,” has become a best seller.', 'web_url': 'https://www.nytimes.com/2013/11/07/business/media/humans-of-new-york-by-brandon-stanton.html', 'snippet': 'Brandon Stanton’s new book of 400 photographic portraits, “Humans of New York,” has become a best seller.', 'lead_paragraph': 'Here’s how Brandon Stanton spends several hours each day: He walks up to total strangers in New York City, requests permission to take their pictures and then asks questions so personal they might make Oprah Winfrey blush.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/07/arts/07PHOTOGRAPHER3/07PHOTOGRAPHER3-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/07/arts/07PHOTOGRAPHER3/07PHOTOGRAPHER3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/07/arts/07PHOTOGRAPHER3/07PHOTOGRAPHER3-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/07/arts/07PHOTOGRAPHER3/07PHOTOGRAPHER3-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/07/arts/07PHOTOGRAPHER3/07PHOTOGRAPHER3-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/07/arts/07PHOTOGRAPHER3/07PHOTOGRAPHER3-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/07/arts/07PHOTOGRAPHER3/07PH