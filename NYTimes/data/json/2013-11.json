ne': {'main': 'Movie Listings for Nov. 8-14', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Listings', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-11-07T22:28:28+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/6bde65e8-eb2c-5482-9457-84dc7804f31f', 'word_count': 3062, 'uri': 'nyt://article/6bde65e8-eb2c-5482-9457-84dc7804f31f'}, {'abstract': 'Addressing matters of families and gifts, an unwanted pass with a needed endorsement, a sour side note and sweet retribution, and a drink by any other name.', 'web_url': 'https://www.nytimes.com/2013/11/10/fashion/love-is-its-own-reward.html', 'snippet': 'Addressing matters of families and gifts, an unwanted pass with a needed endorsement, a sour side note and sweet retribution, and a drink by any other name.', 'lead_paragraph': 'For the last nine years, I have been raising an ex’s son as my own. I am about to become his legal guardian. I never married or had biological children, so this is probably the only official family event I will have in my life. I have gone to countless weddings, showers, brises, christenings — you name it — and have given generously and happily to my friends. If my family hosts a celebration for the guardianship, would it be wrong to strongly hint that equivalent, big occasion gifts are welcome?', 'print_section': 'ST', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-articleLarge-v2.jpg', 'height': 599, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/28/fashion/social_inline/social_inline-articleLarge-v2.jpg', 'xlargewidth': 600