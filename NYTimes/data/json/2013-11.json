ts his overtures.', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/14/arts/14FILMROUNDUP1/14FILMROUNDUP1-articleLarge.jpg', 'height': 366, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/14/arts/14FILMROUNDUP1/14FILMROUNDUP1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 366}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/14/arts/14FILMROUNDUP1/14FILMROUNDUP1-jumbo.jpg', 'height': 625, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/14/arts/14FILMROUNDUP1/14FILMROUNDUP1-superJumbo.jpg', 'height': 1251, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/14/arts/14FILMROUNDUP1/14FILMROUNDUP1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/14/arts/14FILMROUNDUP1/14FILMROUNDUP1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/14/arts/14FILMROUNDUP1/14FILMROUNDUP1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Dancer Tries Out Many Moves', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'Sex, Love & Salsa', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'Sex, Love & Salsa (Movie)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 2, 'major': 'N'}, 