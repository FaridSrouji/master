'credit': None, 'type': 'image', 'url': 'images/2013/11/12/arts/design/PREVIEW/PREVIEW-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/12/arts/design/PREVIEW/PREVIEW-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/12/arts/design/PREVIEW/PREVIEW-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'With Hard Sell, Big-Ticket Art Comes to Auction', 'kicker': None, 'content_kicker': None, 'print_headline': 'With Hard Sell, Big-Ticket Art Comes to Auction', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Vogel, Carol', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Auctions', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': "Sotheby's", 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': "Christie's", 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Bacon, Francis', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Brant, Peter M', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Cohen, Steven A', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Clapton, Eric', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'Dia Art Foundation', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Warhol, Andy', 'rank': 11, 'major': 'N'}], 'pub_date': '2013-11-12T05:50:16+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Carol Vogel', 'person': [{'firstname': 'Carol', 'middlename': None, 'lastname': 'Vogel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6fb0e663-e74c-5230-ad44-8004c9bbd469', 'word_count': 1123, 'uri': 'nyt://article/6fb0e663-e74c-5230-ad44-8004c9bbd469'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2013/11/12/arts/television/whats-on-tuesday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '1:30 A.M. (Sundance) SWIMMING POOL (2003) An icy English mystery writer (Charlotte Rampling, above) in a midcareer rut is plunged into hot water under the Mediterranean sun when her editor’s wanton teenage daughter (Ludivine Sagnier) and then a dead body show up at a vacation home in France in this thriller directed by François Ozon. “\xa0‘Swimming Pool,’ Mr. Ozon’s first English-language film (with a bit of French thrown in for local color), is simultaneously a thoroughly mannered, mischievously artificial confection and an acute piece of psychological realism,” A. O. Scott wrote in The New York Times. “Whose psychology, and which reality, remain ambiguous even after the tart, delicious final twist.” The movie, he added, “is alluringly insubstantial, like the light and air of the Luberon. You can’t hold onto it, but it lingers in your senses and plays tricks with your memory.”', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s on Tuesday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On Tuesday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-11-12T06:00:06+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/21efea12-f6fb-5ba2-9a20-9b103b303ff1', 'word_count': 742, 'uri': 'nyt://article/21efea12-f6fb-5ba2-9a20-9b103b303ff1'}, {'abstract': 'An autopsy report classified the fatal shooting of Renisha McBride in a Detroit suburb as a homicide. Her family believes she was seeking help after an accident when she was shot.', 'web_url': 'https://www.nytimes.com/2013/11/12/us/michigan-autopsy-shows-fatal-wound-to-the-face.html', 'snippet': 'An autopsy report classified the fatal shooting of Renisha McBride in a Detroit suburb as a homicide. Her family believes she was seeking help after an accident when she was shot.', 'lead_paragraph': 'Renisha McBride, a 19-year-old black woman whose death in a Detroit suburb has sparked protests from civil rights groups, was killed by a shotgun wound to the face, but not at close range, according to an autopsy report released\xa0Monday\xa0that ruled it a homicide. Ms. McBride was killed Nov. 2 on the porch of a home in Dearborn Heights. Her family believes she was seeking help after an accident. Demonstrators have called for the arrest of the homeowner, who is white, but no charges have been brought. The Wayne County prosecutor is expected to review evidence this week. ', 'print_section': 'A', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Michigan: Autopsy Shows Fatal Wound to the Face', 'kicker': 'National Briefing | Midwest', 'content_kicker': None, 'print_headline': 'Michigan: Autopsy Shows Fatal Wound To the Face', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Yaccino, Steven', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'McBride, Renisha Marie', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Detroit (Mich)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Blacks', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Discrimination', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Self-Defense', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Demonstrations, Protests, and Riots', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Dearborn Heights (Mich)', 'rank': 10, 'major': 'N'}], 'pub_date': '2013-11-12T06:08:52+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Steven Yaccino', 'person': [{'firstname': 'Steven', 'middlename': None, 'lastname': 'Yaccino', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/acae166b-5f90-5995-a519-08fc9c330c58', 'word_count': 97, 'uri': 'nyt://article/acae166b-5f90-5995-a519-08fc9c330c58'}, {'abstract': 'Glass can now be used to search for songs, scan through saved playlists and listen to music in high fidelity.', 'web_url': 'https://www.nytimes.com/2013/11/12/business/media/google-glass-will-expand-its-features-into-music.html', 'snippet': 'Glass can now be used to search for songs, scan through saved playlists and listen to music in high fidelity.', 'lead_paragraph': 'To sell Glass, its augmented-reality form of eyewear, Google has already tried to make it a fashion accessory and a must-have video device for any parent or sky diver. Now it is also presenting this $1,500 piece of wearable technology as a way to interact with music.', 'print_section': 'B', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/12/business/Google/Google-articleLarge.jpg', 'height': 337, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/12/business/Google/Google-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 337}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image'