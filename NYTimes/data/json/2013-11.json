arge.jpg', 'xlargewidth': 600, 'xlargeheight': 406}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/14/sports/CITY-BASEBALL/CITY-BASEBALL-jumbo.jpg', 'height': 692, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/14/sports/CITY-BASEBALL/CITY-BASEBALL-superJumbo.jpg', 'height': 1385, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Boras Has a Few Zingers, and a Few Free-Agent Stars, for the Mets', 'kicker': None, 'content_kicker': None, 'print_headline': 'Boras Has a Few Zingers, and a Few Free-Agent Stars, for the Mets', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Free Agents (Sports)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Mets', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Boras, Scott', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-11-14T03:57:28+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Tim Rohan', 'person': [{'firstname': 'Tim', 'middlename': None, 'lastname': 'Rohan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/30cbbe81-c6fd-5bb2-b4f0-23b1c6ce9501', 'word_count': 810, 'uri': 'nyt://article/30cbbe81-c6fd-5bb2-b4f0-23b1c6ce9501'}, {'abstract': 'Carmelo Anthony played 40 minutes and scored 25 points and Andrea Bargnani scored 20 points and had a season-high 11 rebounds as the Knicks beat the Hawks in Atlanta.', 'web_url': 'https://www.nytimes.com/2013/11/14/sports/basketball/shaking-up-their-strategy-knicks-shake-off-turmoil-and-beat-the-hawks.html', 'snippet': 'Carmelo Anthony played 40 minutes and scored 25 points and Andrea Bargnani scored 20 points and had a season-high 11 rebounds as the Knicks beat the Hawks in Atlanta.', 'lead_paragraph': 'ATLANTA — The Knicks arrived here accompanied by their usual turbulence. Starting guard Iman Shumpert, perhaps the player with the most upside on the roster, was mentioned in trade rumors. The team’s owner, James L. Dolan, guaranteed a win onstage with his blues band, and the team’s toughness on defense was questioned without the injured Tyson Chandler. Coach Mike Woodson was receiving blame for the team’s uneven start.', 'print_section': 'B', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/14/sports/CITY-KNICKS/CITY-KNICKS-articleLarge.jpg', 'height': 401, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/14/sports/CITY-KNICKS/CITY-KNICKS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 401}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/14/sports/CITY-KNICKS/CITY-KNICKS-jumbo.jpg', 'height': 684, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/14/sports/CITY-KNICKS/CITY-KNICKS-superJumbo.jpg', 'height': 1368, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/14/sports/CITY-KNICKS/CITY-KNICKS-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/14/sports/CITY-KNICKS/CITY-KNICKS-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge