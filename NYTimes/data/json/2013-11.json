p_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/01/arts/01RDP_BLUEVEIL_SPAN/BLUEVEIL-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/01/arts/01RDP_BLUEVEIL_SPAN/BLUEVEIL-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Way of Life, and Its Slow Death', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'Behind the Blue Veil', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Tuareg (Ethnic Group)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Documentary Films and Programs', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Symon, Robyn', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-11-01T02:36:53+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Anita Gates', 'person': [{'firstname': 'Anita', 'middlename': None, 'lastname': 'Gates', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/c3a7c6ba-de2f-5a82-a6fe-5937cb0adde9', 'word_count': 258, 'uri': 'nyt://article/c3a7c6ba-de2f-5a82-a6fe-5937cb0adde9'}, {'abstract': 'The Red Sox shortstop claims he does not follow in his brother J.D.’s footsteps, except that he wears a No.7 jersey and now has a Red Sox ring like him.', 'web_url': 'https://www.nytimes.com/2013/11/01/sports/baseball/just-like-his-brother-right-down-to-the-ring.html', 'snippet': 'The Red Sox shortstop claims he does not follow in his brother J.D.’s footsteps, except that he wears a No.7 jersey and now has a Red Sox ring like him.', 'lead_paragraph': 'BOSTON — During the mayhem in the Red Sox clubhouse after their third World Series championship in 10 seasons, Stephen Drew claimed that he does not follow in his older brother J. D.’s footsteps. But the evidence suggests otherwise; in the very next sentence he described how he wears the No. 7 jersey to honor J. D.', 'print_section': 'B', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/01/sports/CITY-BATS/CITY-BATS-articleLarge.jpg', 'height': 833, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/01/sports/CITY-BATS/CITY-BATS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 833}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/01/sports/CITY-BATS/CITY-BATS-jumbo.jpg', 'height': 1024, 'width': 738, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/01/sports/CITY-BATS/CITY-BATS-superJumbo.jpg', 'height': 2048, 'width': 1475, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/01/sports/CITY-BATS/CITY-BATS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/11/01/sports/CITY-BATS/CITY-BATS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/01/sports/CITY-BATS/CITY-BATS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Stephen Drew Is Just Like His Brother, Right Down to the Ring', 'kicker': None, 'content_kicker': None, 'print_headline': 'Just Like His Brother, Right Down to the Ring', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Waldstein, David', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Baseball', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'World Series', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Boston Red Sox', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Drew, Stephen (1983- )', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Drew, J D', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Lackey, John', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-11-01T02:47:11+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By David Waldstein', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Waldstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/289badf3-7ab2-5f1e-b06c-ef0a36f10e15', 'word_count': 744, 'uri': 'nyt://article/289badf3-7ab2-5f1e-b06c-ef0a36f10e15'}, {'abstract': '“Immigrant,” a tale of a Russian family’s move in the 1970s, shows the United States as anything but welcoming.', 'web_url': 'https://www.nytimes.com/2013/11/01/movies/in-immigrant-a-familys-hard-landing-in-the-us.html', 'snippet': '“Immigrant,” a tale of a Russian family’s move in the 1970s, shows the United States as anything but welcoming.', 'lead_paragraph': 'The immigrant couple in Barry Shurchin’s new film leave the Soviet Union in the late 1970s in hopes of finding religious freedom in the United States, so their son can “be a Jew.” What they experience is more like an American horror story, one filled with knives and guns, suicide, abuse and nefarious figures. It’s an unseemly pileup of misfortune resting on a rather weak foundation.', 'print_section': 'C', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [], 'headline':