'keywords': [], 'pub_date': '2013-11-08T17:21:41+0000', 'document_type': 'multimedia', 'news_desk': 'T Magazine', 'section_name': 'T Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/a1aae142-1117-5758-a909-7e1adf1d6908', 'word_count': 0, 'uri': 'nyt://interactive/a1aae142-1117-5758-a909-7e1adf1d6908'}, {'abstract': 'Ben Ratliff and Jon Pareles discuss new albums by two veteran pop provocateurs.', 'web_url': 'https://www.nytimes.com/audio/2013/12/08/arts/music/08popcast_pod.html', 'snippet': 'Ben Ratliff and Jon Pareles discuss new albums by two veteran pop provocateurs.', 'lead_paragraph': 'Ben Ratliff and Jon Pareles discuss new albums by two veteran pop provocateurs.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Eminem and Lady Gaga Aim to Reclaim Their Relevance', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-11-08T17:21:58+0000', 'document_type': 'audio', 'news_desk': '', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': '', '_id': 'nyt://audio/6c9c0c88-5988-5e1d-bb4a-5850f2ae3572', 'word_count': 0, 'uri': 'nyt://audio/6c9c0c88-5988-5e1d-bb4a-5850f2ae3572'}, {'abstract': 'The English billionaire takes on the final frontier with his Virgin Galactic SpaceShipTwo, which seats six and has been ten years in the making.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2013/11/08/by-the-numbers-richard-bransons-space-race/', 'snippet': 'The English billionaire takes on the final frontier with his Virgin Galactic SpaceShipTwo, which seats six and has been ten years in the making.', 'lead_paragraph': 'The irrepressible English billionaire industrialist Sir Richard Branson, who has built his Virgin brand into a global empire, is finally expanding into the only place left: outer space. His Virgin Galactic SpaceShipTwo is poised to become the first commercial aircraft to take civilians into the thermosphere. The six-passenger spaceliner, which has taken a decade and several hundred million dollars to go from fantasy to reality, has maintained a reservation list since 2005, with Leonardo DiCaprio and Katy Perry already claiming spots. But they’ll have to wait to take their turn after Branson, who plans to be the first to fly in 2014. It’s a moment he’s been waiting for since he was 19 and watched Neil Armstrong and Buzz Aldrin step onto the moon. “I was glued to the television,” he recalls, “and already dreaming of joining them in space.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Richard Branson’s Space Race', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Private Spaceflight', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Branson, Richard', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Virgin Galactic', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-11-08T17:24:10+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Jeff Oloizia', 'person': [{'firstname': 'Jeff', 'middlename': None, 'lastname': 'Oloizia', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/904dd140-fb45-5c09-8339-909cdd0a8b4a', 'word_count': 143, 'uri': 'nyt://article/904dd140-fb45-5c09-8339-909cdd0a8b4a'}, {'abstract': 'Readers solve the mystery of a 47-year-old woman with repeated bouts of nausea and abdominal pain that stumped many doctors in Chicago.', 'web_url': 'https://well.blogs.nytimes.com/2013/11/08/think-like-a-doctor-gut-feeling-solved/', 'snippet': 'Readers solve the mystery of a 47-year-old woman with repeated bouts of nausea and abdominal pain that stumped many doctors in Chicago.', 'lead_paragraph': 'On Thursday, we challenged Well readers to figure out why an otherwise healthy 47-year-old woman would suddenly be struck with abdominal pain, nausea and vomiting that seemed to come out of the blue every few months and resolved within days.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/02/29/health/29well_diagnosis/29well_diagnosis-jumbo.jpg', 'height': 280, 'width': 400, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/02/29/health/29well_diagnosis/29well_diagnosis-superJumbo.jpg', 'height': 280, 'width': 400, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/02/29/health/29well_diagnosis/29well_diagnosis-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/02/29/health/29well_diagnosis/29well_diagnosis-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/02/29/health/29well_diagnosis/29well_diagnosis-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Think Like a Doctor: Gut Feeling Solved!', 'kicker': 'Well', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Digestive Tract', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Doctors', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Pain', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-11-08T17:26:24+0000', 'document_type': 'artic