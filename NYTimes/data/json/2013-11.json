 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/30e4796f-c256-532e-9ac7-e92459e6d0b5', 'word_count': 658, 'uri': 'nyt://article/30e4796f-c256-532e-9ac7-e92459e6d0b5'}, {'abstract': 'Shaul Schwarz’s documentary examines the folk-style music that romanticizes Mexico’s drug trade, and visits the war-torn city Ciudad Juárez.', 'web_url': 'https://www.nytimes.com/2013/11/22/movies/narco-cultura-a-documentary-about-music-and-drug-cartels.html', 'snippet': 'Shaul Schwarz’s documentary examines the folk-style music that romanticizes Mexico’s drug trade, and visits the war-torn city Ciudad Juárez.', 'lead_paragraph': '“With an AK-47 and a bazooka on my shoulder/Cross my path and I’ll chop your head off/We’re bloodthirsty, crazy and we like to kill.”', 'print_section': 'C', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Singing of the Cartels, and Investigating Them', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'Singing of the Cartels, And Investigating Them', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Documentary Films and Programs', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Drug Abuse and Traffic', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'Narco Cultura (Movie)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Schwarz, Shaul', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-11-21T23:41:47+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Stephen Holden', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Holden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/67f0e49f-363f-5132-9981-2cb537832aeb', 'word_count': 439, 'uri': 'nyt://article/67f0e49f-363f-5132-9981-2cb537832aeb'}, {'abstract': 'Reaction to plans for an apartment house above Park Avenue Christian Church is a reminder of the neighborhood’s history.', 'web_url': 'https://www.nytimes.com/2013/11/24/realestate/lest-a-pesky-stable-move-in.html', 'snippet': 'Reaction to plans for an apartment house above Park Avenue Christian Church is a reminder of the neighborhood’s history.', 'lead_paragraph': 'Amos Pinchot would be indignant. So would Reginald De Koven and Lewis Gouverneur Morris and Edward Stettinius. They were all well-to-do townhouse owners at Park Avenue and 85th Street a century ago, and would have been dismayed by the prospect of an apartment house above the 1911 Park Avenue Christian Church, at the southwest corner of the intersection. They all relied on a network of deed restrictions designed to prevent just that kind of thing. ', 'print_section': 'RE', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/24/realestate/24STREETS_SPAN/24streets1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/11/24/realestate/24STREETS_SPAN/24streets1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/24/realestate/24STREETS_SPAN/24streets1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/11/24/realestate/24STREETS_SPAN/24streets1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'i