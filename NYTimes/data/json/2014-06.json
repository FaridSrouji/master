me': 'subject', 'value': 'Automobiles', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-06-27T20:37:17+0000', 'document_type': 'article', 'news_desk': 'Automobiles', 'section_name': 'Automobiles', 'subsection_name': 'New Cars', 'byline': {'original': 'By Lawrence Ulrich', 'person': [{'firstname': 'Lawrence', 'middlename': None, 'lastname': 'Ulrich', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/5fce85e1-69fb-5df0-9c3c-62db16261c51', 'word_count': 1234, 'uri': 'nyt://article/5fce85e1-69fb-5df0-9c3c-62db16261c51'}, {'abstract': 'What’s next for Russia, the United States, and Ukraine? A panel of former New York Times contributors debated the question this week.', 'web_url': 'https://op-talk.blogs.nytimes.com/2014/06/27/is-this-cold-war-ii/', 'snippet': 'What’s next for Russia, the United States, and Ukraine? A panel of former New York Times contributors debated the question this week.', 'lead_paragraph': 'On Wednesday June 25, the New York Times and Chatham House convened a panel of former New York Times op-ed contributors in London to debate the future of the West’s relations with Russia in the wake of the Ukraine crisis. The panel included John Mearsheimer, a professor of political science at the University of Chicago and the author of “The Tragedy of Great Power Politics”; Chrystia Freeland, a former Financial Times editor and now a member of the Canadian Parliament; Michael McFaul, the former American ambassador to Russia and now a professor at Stanford University; and Dmitri Trenin, the director of the Carnegie Moscow Center. Roger Cohen, a columnist for The New York Times, moderated. Panelists debated whether the recent crisis was caused by Vladimir Putin’s zero-sum view of geopolitics, whether the Ukrainian people will have a say in the eventual outcome and whether Russia is really a rival to the United States. An edited transcript follows.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/27/opinion/nyto-crimeariver/nyto-crimeariver-articleLarge.jpg', 'height': 595, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/27/opinion/nyto-crimeariver/nyto-crimeariver-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 595}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/27/opinion/nyto-crimeariver/nyto-crimeariver-jumbo.jpg', 'height': 1015, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/27/opinion/nyto-crimeariver/nyto-crimeariver-superJumbo.jpg', 'height': 2030, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/27/opinion/nyto-crimeariver/nyto-crimeariver-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/27/opinion/nyto-crimeariver/nyto-crimeariver-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/27/opinion/nyto-crimeariver/nyto-crimeariver-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '“Is This Cold War II?”', 'kicker': 'Op-Talk', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Cohen, Roger', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Putin, Vladimir V', 'rank': 3, 