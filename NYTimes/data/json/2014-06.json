.”', 'print_section': 'A', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Quotation of the Day for Friday, June 13, 2014', 'kicker': None, 'content_kicker': None, 'print_headline': 'Quotation of the Day', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-06-13T05:03:12+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Quote', '_id': 'nyt://article/92dd4ef0-dace-5536-8910-59c4310cd166', 'word_count': 48, 'uri': 'nyt://article/92dd4ef0-dace-5536-8910-59c4310cd166'}, {'abstract': 'David Wright quietly went 1 for 5 with a walk as the Mets lost to the Brewers, their eighth defeat in their last nine games.', 'web_url': 'https://www.nytimes.com/2014/06/13/sports/baseball/mets-brewers-david-wright-struggles.html', 'snippet': 'David Wright quietly went 1 for 5 with a walk as the Mets lost to the Brewers, their eighth defeat in their last nine games.', 'lead_paragraph': 'Often this season, when the Mets have started to slide, David Wright has stressed the importance of stopping it before it gets worse. He has sounded urgent and a tad desperate, perhaps because in each of the previous five seasons, he felt a sense of inevitability set in, like a man standing atop a leaky dam staring down a flood.', 'print_section': 'B', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/13/sports/CITY-METS/CITY-METS-articleLarge.jpg', 'height': 504, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/13/sports/CITY-METS/CITY-METS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 504}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/13/sports/CITY-METS/CITY-METS-jumbo.jpg', 