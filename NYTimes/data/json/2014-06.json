s that are imminent, others that are uncertain or inferred.', 'print_section': 'BR', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/08/books/review/08BROWNRIGG/08BROWNRIGG-articleLarge.jpg', 'height': 671, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/08/books/review/08BROWNRIGG/08BROWNRIGG-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 671}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/08/books/review/08BROWNRIGG/08BROWNRIGG-jumbo.jpg', 'height': 1024, 'width': 916, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/08/books/review/08BROWNRIGG/08BROWNRIGG-superJumbo.jpg', 'height': 1759, 'width': 1573, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/08/books/review/08BROWNRIGG/08BROWNRIGG-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/08/books/review/08BROWNRIGG/08BROWNRIGG-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/08/books/review/08BROWNRIGG/08BROWNRIGG-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Accident Prone', 'kicker': None, 'content_kicker': None, 'print_headline': 'Accident Prone', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'McCracken, Elizabeth', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literat