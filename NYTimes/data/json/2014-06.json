erson': [{'firstname': 'David', 'middlename': None, 'lastname': 'Jolly', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f61ecb73-664d-5a0a-a6bb-36f11863870f', 'word_count': 373, 'uri': 'nyt://article/f61ecb73-664d-5a0a-a6bb-36f11863870f'}, {'abstract': 'Times critics share what they’ve been listening to lately.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2014/06/11/classical-playlist-handel-george-benjamin-david-lang-and-others/', 'snippet': 'Times critics share what they’ve been listening to lately.', 'lead_paragraph': 'HANDEL: ‘Orlando’Bejun Mehta and other singers; René Jacobs, conductor; B’Rock Orchestra Ghent(Archiv Produktion; two CDs)For me, “Orlando” is Handel’s most innovative and psychologically astute opera, and one of his richest scores. The evocative story tells of Orlando, a renowned knight and crusader, who, weary of finding glory through combat, seeks meaning through love. He comes afoul of a magician who, determined to lead Orlando back to a life of valor, entices him into an enchanted forest where romantic involvements drive Orlando mad. Handel even gives us a mad scene in this opera. René Jacobs, the countertenor turned brilliant conductor, leads a crisp, stylish and immediate performance with the B’Rock Orchestra Ghent and an appealing cast, starring the countertenor Bejun Mehta in the title role, Sophie Karthäuser as his love interest Angelica, and Konstantin Wolff as the magician Zoroastro. (Anthony Tommasini)', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/12/arts/classical-jacobs/classical-jacobs-articleLarge.jpg', 'height': 389, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/12/arts/classical-jacobs/classical-jacobs-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 389}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/12/arts/classical-jacobs/classical-jacobs-jumbo.jpg', 'height': 663, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/12/arts/classical-jacobs/classical-jacobs-superJumbo.jpg', 'height': 1327, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/12/arts/classical-jacobs/classical-jacobs-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/12/arts/classical-jacobs/classical-jacobs-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/12/arts/classical-jacobs/classical-jacobs-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Classical Playlist: Handel, George Benjamin, David Lang and Others', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Classical Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Barenboim, Daniel', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Benjamin, George', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Camarena, Javier', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Fonseca, Juan Fernando', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Jacobs, Rene', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Lang, David', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Malkki, Susanna', 'rank': 8, 'major': 'N'}, {