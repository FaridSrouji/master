e': 'Education', 'byline': {'original': 'By Frank Longo', 'person': [{'firstname': 'Frank', 'middlename': None, 'lastname': 'Longo', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/165bbc20-0787-59c6-8fc2-d99be81bd8ed', 'word_count': 92, 'uri': 'nyt://article/165bbc20-0787-59c6-8fc2-d99be81bd8ed'}, {'abstract': 'Secretary of State John Kerry urged the president of Iraq’s Kurdish autonomous region not to seek his own state and instead help form a government in Baghdad.', 'web_url': 'https://www.nytimes.com/2014/06/25/world/middleeast/kerry-kurds-iraq.html', 'snippet': 'Secretary of State John Kerry urged the president of Iraq’s Kurdish autonomous region not to seek his own state and instead help form a government in Baghdad.', 'lead_paragraph': 'ERBIL, Iraq — Secretary of State John Kerry urged the president of Iraq’s Kurdish autonomous region on Tuesday not to seek his own state and instead help form a government in Baghdad.', 'print_section': 'A', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Kerry Implores Kurdish Leader to Join a Government and Not Break Away', 'kicker': None, 'content_kicker': None, 'print_headline': 'Kerry Implores Kurdish Leader to Join a Government and Not Break Away', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Kurds', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Gordon, Michael R', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Islamic State in Iraq and Syria (ISIS)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Barzani, Massoud', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Kerry, John', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Maliki, Nuri Kamal al-', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Erbil (Iraq)', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'I