092293-ce4d-5920-a5ba-3ec2c0ed1ab2', 'word_count': 30, 'uri': 'nyt://article/51092293-ce4d-5920-a5ba-3ec2c0ed1ab2'}, {'abstract': 'President Park Geun-hye reversed her decision to replace her current prime minister, after two successive appointees stepped aside amid controversies over their qualifications.', 'web_url': 'https://www.nytimes.com/2014/06/26/world/asia/south-korea-a-familiar-premier.html', 'snippet': 'President Park Geun-hye reversed her decision to replace her current prime minister, after two successive appointees stepped aside amid controversies over their qualifications.', 'lead_paragraph': 'President Park Geun-hye reversed her decision to replace her current prime minister, after two successive appointees stepped aside amid controversies over their qualifications. Prime Minister Chung Hong-won had offered to resign in late April, as the government came under fire for failing to prevent the sinking of a ferry on April 16 that left more than 300 people dead. Ms. Park accepted his resignation but asked him to stay in office while she looked for a replacement. But her first choice, a former Supreme Court justice named Ahn Dae-hee, was forced to withdraw his name amid questions over his earnings. Her second choice, Moon Chang-keuk, a retired conservative newspaper columnist, bowed out on Tuesday. Critics accused him of being unpatriotic after it was revealed that he said during a church lecture in 2011 that Korea’s colonization by Japan in the early 20th century was “God’s will.” This was the first time in South Korean history that a president retained a prime minister who had resigned. ', 'print_section': 'A', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'South Korea: A Familiar Premier', 'kicker': 'World Briefing', 'content_kicker': None, 'print_headline': 'South Korea: A Familiar Premier', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'South Korea', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Maritime Accidents and Safety', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Park Geun-hye', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Chung Hong-won', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Ahn Dae-hee', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Moon Chang-keuk', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-06-26T04:48:47+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Choe Sang-Hun', 'person': [{'firstname': 'Choe', 'middlename': None, 'lastname': 'Sang-Hun', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/7fae7d1c-fbf8-50fd-a5fd-c04e61f131ea', 'word_count': 165, 'uri': 'nyt://article/7fae7d1c-fbf8-50fd-a5fd-c04e61f131ea'}, {'abstract': 'Corrections appearing in print on June 26, 2014.', 'web_url': 'https://www.nytimes.com/2014/06/26/pageoneplus/corrections-june-26-2014.html', 'snippet': 'Corrections appearing in print on June 26, 2014.', 'lead_paragraph': 'FRONT PAGE', 'print_section': 'A', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Corrections: June 26, 2014', 'kicker': None, 'content_kicker': None, 'print_headline': 'Corrections', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-06-26T04:58:21+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/25c8314c-fb49-577b-a2ca-eb5570e9a922', 'word_count': 632, 'uri': 'nyt://article/25c8314c-fb49-577b-a2ca-eb5570e9a922'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2014/06/26/arts/television/whats-on-thursday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '9 P.M. (Logo) TRAILBLAZERS On the anniversary of the striking down of the Defense of Marriage Act, this special honors Edie Windsor, who challenged the act’s constitutionality, and the lawyer Roberta Kaplan, who took the case to the Supreme Court. Other honorees include the basketball player Jason Collins, the first openly gay male athlete in a major American sport; Netflix’s “Orange Is the New Black,” for its portrayal of rarely seen television characters; and John Abdallah Wambere, the Ugandan gay rights advocate and refugee. Former President Bill Clinton talks about Ms. Windsor and Ms. Kaplan in a taped message. Daniel Radcliffe, Adam Levine, Jared Leto, Macklemore & Ryan Lewis, Ed Sheeran, Nate Ruess, Demi Lovato and Iggy Azalea appear at this event, filmed on Monday at the Cathedral Church of St. John the Divine in New York. A Great Big World and Sia, with the New York City Gay Men’s Chorus, perform.', 'print_section': 'C', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s on Thursday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On Thursday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-06-26T05:00:03+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/ecaab1e5-0e00-5e50-bb30-483a3b80e436', 'word_count': 724, 'uri': 'nyt://article/ecaab1e5-0e00-5e50-bb30-483a3b80e436'}, {'abstract': 'This report raises warnings that other countries might adopt the same rationale as the United States has for carrying out lethal drone strikes outside of declared war zones.', 'web_url': 'https://www.nytimes.com/interactive/2014/06/26/world/DRONES-document.html', 'snippet': 'This report raises warnings that other countries might adopt the same rationale as the United States has for carrying out lethal drone strikes outside of declared war zones.', 'lead_paragraph': 'This report raises warnings that other countries might adopt the same rationale as the United States has for carrying out lethal drone strikes outside of declared war zones.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/world/drones-promo-doc/drones-promo-doc-jumbo.png', 'height': 353, 'width': 423, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/world/drones-promo-doc/drones-promo-doc-superJumbo.png', 'height': 353, 'width': 423, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/world/drones-promo-doc/drones-promo-doc-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/26/world/drones-promo-doc/drones-promo-doc-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/world/drones-promo-doc/drones-promo-doc-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Report of the Task Force on United States Drone Policy', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Drones (Pilotless Planes)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-06-26T05:09:11+0000', 'document_type': 'multimedia', 'news_desk': 'World', 'section_name': 'World', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/73385485-224a-5242-a785-ff4ab42c2588', 'word_count': 0, 'uri': 'nyt://interactive/73385485-224a-5242-a785-ff4ab42c2588'}, {'abstract': 'President Obama told environmental advocates that fighting global warming will require acknowledging Americans’ concerns about higher energy costs.', 'web_url': 'https://www.nytimes.com/2014/06/26/us/politics/obama-warns-climate-campaign-cant-be-deaf-to-economic-worries.html', 'snippet': 'President Obama told environmental advocates that fighting global warming will require acknowledging Americans’ concerns about higher energy costs.', 'lead_paragraph': 'WASHINGTON — President Obama acknowledged Wednesday that his efforts to combat climate change — in particular, Environmental Protection Agency regulations to slash carbon pollution from cars and coal-fired power plants — could raise fuel and electricity prices. And he told environmental advocates that in order to make a credible case for such climate policies, officials would need to acknowledge Americans’ worries about the economic effects.', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Climate Campaign Can’t Be Deaf to Economic Worries, Obama Warns', 'kicker': None, 'content_kicker': None, 'print_headline': 'Obama Acknowledges Costs of Climate Strategy', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Greenhouse Gas Emissions', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Global Warming', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'League of Conservation Voters', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Environmental Protection Agency', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Coal', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Electric Light and Power', 'rank': 9, 'major': 'N'}], 'pub_date': '2014-06-26T05:21:38+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Coral Davenport', 'person': [{'firstname': 'Coral', 'middlename': None, 'lastname': 'Davenport', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1361748e-e273-564d-8df1-302e2e8c66ad', 'word_count': 720, 'uri': 'nyt://article/1361748e-e273-564d-8df1-302e2e8c66ad'}, {'abstract': 'The Palestinian prime minister says he does not have enough money to pay both workers hired by Hamas and those employed by the Palestinian Authority.', 'web_url': 'https://www.nytimes.com/2014/06/27/world/middleeast/hamas-fatah-palestinian-salary.html', 'snippet': 'The Palestinian prime minister says he does not have enough money to pay both workers hired by Hamas and those employed by the Palestinian Authority.', 'lead_paragraph': 'GAZA CITY — Abu Raid al-Samouni, 46, a driver and office cleaner in the Foreign Ministry headquarters here, leaves for work before his 14 children wake up each morning, to avoid their pleas for spare change to buy candy. Like the other 42,000 workers hired while the militant Islamic group Hamas ran the Gaza government over the past seven years, Mr. Samouni has received only part of his $350 monthly salary since October; in April and May, there was no paycheck at all.', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Issue of Pay for 2 Sets of Workers Tugs at Palestinian Pact', 'kicker': None, 'content_kicker': None, 'print_headline': 'Issue of 