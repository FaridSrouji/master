ank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Apple Inc', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Google Inc', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Intel Corporation', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Silicon Valley (Calif)', 'rank': 8, 'major': 'N'}], 'pub_date': '2014-06-27T11:00:29+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'byline': {'original': 'By David Streitfeld', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Streitfeld', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8c1f2b57-a27c-566c-80b7-31880a02eef2', 'word_count': 627, 'uri': 'nyt://article/8c1f2b57-a27c-566c-80b7-31880a02eef2'}, {'abstract': 'Our Summer Reading Contest is in its third week. To participate, just write in below by 7 a.m. Eastern on July 4 and answer the question, “What interested you most in The Times this week?”', 'web_url': 'https://learning.blogs.nytimes.com/2014/06/27/summer-reading-contest-week-3-what-interested-you-most-in-the-times-this-week/', 'snippet': 'Our Summer Reading Contest is in its third week. To participate, just write in below by 7 a.m. Eastern on July 4 and answer the question, “What interested you most in The Times this week?”', 'lead_paragraph': 'In the news this week: Supreme Court rulings on abortion protests, cellphone searches and more.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/27/us/27mccullen1-LN/27mccullen1-articleLarge.jpg', 'height': 347, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/27/us/27mccullen1-LN/27mccullen1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 347}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'c