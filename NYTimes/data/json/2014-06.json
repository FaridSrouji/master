ages/2014/06/29/arts/29GUIDE2/29GUIDE2-jumbo.jpg', 'height': 800, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/29/arts/29GUIDE2/29GUIDE2-superJumbo.jpg', 'height': 1600, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/29/arts/29GUIDE2/29GUIDE2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/29/arts/29GUIDE2/29GUIDE2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/29/arts/29GUIDE2/29GUIDE2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'At 50, a Debut Keeps 4 Guys Young', 'kicker': 'The Week Ahead', 'content_kicker': None, 'print_headline': 'At 50, a Debut Keeps 4 Guys Young', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-06-27T22:14:24+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Movies', 'byline': {'original': 'By Neil Genzlinger', 'person': [{'firstname': 'Neil', 'middlename': None, 'lastname': 'Genzlinger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/76f3c451-6faa-5e9b-9f02-163bd34fbc42', 'word_count': 187, 'uri': 'nyt://article/76f3c451-6faa-5e9b-9f02-163bd34fbc42'}, {'abstract': '“I’m so tired of being alone,” cries Beck at the top of “Blue Moon,” the lead single from his muted and deliberative current album, “Morning Phase.”', 'web_url': 'https://www.nytimes.com/2014/06/29/arts/music/same-beck-different-mood.html', 'snippet': '“I’m so tired of being alone,” cries Beck at the top of “Blue Moon,” the lead single from his muted and deliberative current album, “Morning Phase.”', 'lead_paragraph': '“I’m so tired of being alone,” cries Beck at the top of “Blue Moon,” the lead single from his muted and deliberative current album, “Morning Phase” (Capitol). “I-so-lation,” he sings a couple of tracks later, in the existential refrain of “Wave.” The purity of the sentiment, and the completeness of his commitment, could easily give you an impression about his state of mind: desolate, draggy, half-numb, forlorn. The last time Beck made an album that felt like this —\xa0“Sea Change,” a dozen years ago —\xa0that impression might have been partly true.', 'print_section': 'AR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/29/arts/29GUIDE1/29GUIDE1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/29/arts/29GUIDE1/29GUIDE1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/29/arts/29GUIDE1/29GUIDE1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/29/arts/29GUIDE1/29GUIDE1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/29/arts/29GUIDE1/29GUIDE1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/29/arts/29GUIDE1/29GUIDE1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/29/arts/29GUIDE1/29GUIDE1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Same Beck, Different Mood', 'kicker': 'The Week Ahead', 'content_kicker': None, 'print_headline': 'Same Beck, Different Mood', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-06-27T22:15:07+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Nate Chinen', 'person': [{'firstname': 'Nate', 'middlename': None, 'lastname': 'Chinen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dd68feed-f225-5fe1-b4f2-002bac7653de', 'word_count': 192, 'uri': 'nyt://article/dd68feed-f225-5fe1-b4f2-002bac7653de'}, {'abstract': 'Inexorable laws of economics aren’t tearing us apart. Our policies are.', 'web_url': 'https://opinionator.blogs.nytimes.com/2014/06/27/inequality-is-not-inevitable/', 'snippet': 'Inexorable laws of economics aren’t tearing us apart. Our policies are.', 'lead_paragraph': 'AN insidious trend has developed over this past third of a century. A country that experienced shared growth after World War II began to tear apart, so much so that when the Great Recession hit in late 2007, one could no longer ignore the fissures that had come to define the American economic landscape. How did this “shining city on a hill” become the advanced country with the greatest level of inequality?', 'print_section': 'SR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/04/25/opinion/opinionator-pog-thegreatdivide/opinionator-pog-