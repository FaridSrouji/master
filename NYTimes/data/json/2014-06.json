': 410, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/05/world/04sino-tiananmen-1/04sino-tiananmen-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 410}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/world/04sino-tiananmen-1/04sino-tiananmen-1-jumbo.jpg', 'height': 700, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/world/04sino-tiananmen-1/04sino-tiananmen-1-superJumbo.jpg', 'height': 1401, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/world/04sino-tiananmen-1/04sino-tiananmen-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/05/world/04sino-tiananmen-1/04sino-tiananmen-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/world/04sino-tiananmen-1/04sino-tiananmen-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Live-Blogging the Tiananmen Square Anniversary', 'kicker': 'Sinosphere', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-06-04T01:43:26+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/294a7555-705b-5da3-a445-500ff2fa0a4a', 'word_count': 9597, 'uri': 'nyt://article/294a7555-705b-5da3-a445-500ff2fa0a4a'}, {'abstract': 'Nicholas Kristof reported for The Times on the violent crackdown of pro-democracy protesters in Beijing’s Tiananmen Square in 1989.', 'web_url': 'https://www.nytimes.com/2014/06/04/world/asia/times-coverage-of-tiananmen-square-25-years-ago.html', 'snippet': 'Nicholas Kristof reported for The Times on the violent crackdown of pro-democracy protesters in Beijing’s Tiananmen Square in 1989.', 'lead_paragraph': 'On June 4, 1989, Chinese troops conducted a bloody crackdown on thousands of pro-democracy demonstrators in Tiananmen Square. At the time, Nicholas Kristof, The New York Times’s Beijing bureau chief, reported that “by ordering soldiers to fire on the unarmed crowds, the Chinese leadership has created an incident that almost surely will haunt the government for years to come.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/03/world/04tiananmen-archive-1/04tiananmen-archive-1-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/03/world/04tiananmen-archive-1/04tiananmen-archive-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/03/world/04tiananmen-archive-1/04tiananmen-archive-1-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/03/world/04tiananmen-archive-1/04tiananmen-archive-1-superJumbo.jpg', 'height': 1362, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/03/world/04tiananmen-archive-1/04tiananmen-archi