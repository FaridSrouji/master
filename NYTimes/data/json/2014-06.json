ank': 5, 'major': 'N'}], 'pub_date': '2014-06-25T22:23:45+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Julie Lasky', 'person': [{'firstname': 'Julie', 'middlename': None, 'lastname': 'Lasky', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dee975b0-8e2a-5285-a884-e02ce2b735fd', 'word_count': 153, 'uri': 'nyt://article/dee975b0-8e2a-5285-a884-e02ce2b735fd'}, {'abstract': 'Discounts on glassware, seating, art, bedding and more.', 'web_url': 'https://www.nytimes.com/2014/06/26/garden/sales-at-fishs-eddy-ethan-allen-john-robshaw-and-dlv-designs.html', 'snippet': 'Discounts on glassware, seating, art, bedding and more.', 'lead_paragraph': 'Fishs Eddy is discounting some tabletop, glassware and accessories by 50 percent, in-store only, while supplies last (the Dog Decal tray, originally about $23, is about $11); 889 Broadway (East 19th Street), 212-420-9020.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/garden/26CURRDEALS/26CURR4-articleLarge.jpg', 'height': 594, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/26/garden/26CURRDEALS/26CURR4-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 594}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/garden/26CURRDEALS/26CURR4-jumbo.jpg', 'height': 859, 'width': 868, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/garden/26CURRDEALS/26CURR4-superJumbo.jpg', 'height': 859, 'width': 868, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, '