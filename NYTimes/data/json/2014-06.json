.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/24/science/23recipehealth/23recipehealth-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/24/science/23recipehealth/23recipehealth-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/24/science/23recipehealth/23recipehealth-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/24/science/23recipehealth/23recipehealth-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/24/science/23recipehealth/23recipehealth-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Spicy Quinoa Salad With Broccoli, Cilantro and Lime', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Diet and Nutrition', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Salads', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Quinoa', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-06-23T16:39:54+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Health', 'byline': {'original': 'By Martha Rose Shulman', 'person': [{'firstname': 'Martha', 'middlename': 'Rose', 'lastname': 'Shulman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'recipe', '_id': 'nyt://article/923ee559-e5c3-5134-a8d9-2b8984386029', 'word_count': 397, 'uri': 'nyt://article/923ee559-e5c3-5134-a8d9-2b8984386029'}, {'abstract': 'The Citywide Monuments Conservation Program is replacing swords stolen from monumental bronze statues in the Bronx and in Brooklyn.', 'web_url': 'https://www.nytimes.com/2014/06/24/nyregion/unarmed-for-decades-two-generals-will-be-reunited-with-their-swords.html', 'snippet': 'The Citywide Monuments Conservation Program is replacing swords stolen from monumental bronze statues in the Bronx and in Brooklyn.', 'lead_paragraph': 'The pen might be mightier than the sword for a politician or a journalist, but, except for when it ends a war, not for a general — even for two solitary Civil War sentinels who have been left unarmed in New York City parks for decades.', 'print_section': 'A', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/23/nyregion/SWORD/SWORD-articleLarge-v2.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/23/nyregion/SWORD/SWORD-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/23/nyregion/SWORD/SWORD-jumbo-v2.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/23/nyregion/SWORD/SWORD-superJumbo-v2.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/23/nyregion/SWORD/SWORD-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/23/nyregion/SWORD/SWORD-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/23/nyregion/SWORD/SWORD-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Long Unarmed, 2 Generals Will Be Reunited With Their Swords', 'kicker': None, 'content_kicker': None, 'print_headline': 'Rearming 2 Generals, but Not for War', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Restoration and Renovation', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Monuments and Memorials (Structures)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Grand Army Plaza (Brooklyn, NY)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Van Cortlandt Park (Bronx, NY)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-06-23T16:40:55+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Sam Roberts', 'person': [{'firstname': 'Sam', 'middlename': None, 'lastname': 'Roberts', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0ab76c8b-9ea7-575e-acd4-ddc7fc7c8d07', 'word_count': 556, 'uri': 'nyt://article/0ab76c8b-9ea7-575e-acd4-ddc7fc7c8d07'}, {'abstract': 'Chickpeas make this salad a substantial and comforting dish for a light supper.', 'web_url': 'https://www.nytimes.com/2014/06/24/health/chickpea-quinoa-and-celery-salad-with-middle-eastern-flavors.html', 'snippet': 'Chickpeas make this salad a substantial and comforting dish for a light supper.', 'lead_paragraph': 'It’s the sumac (available in Middle Eastern markets) and the herbs – dill, mint, chives – that give this salad its Middle Eastern accents. I love the texture and flavor of the chickpeas, which make for a substantial and comforting dish. It’s all you need for lunch and makes a delicious light supper. I love abundant, thinly sliced celery in just about any lemony salad; you will appreciate it for its texture as well as its flavor.\xa0 Of course, you can use canned chickpeas, but if you have the time, try cooking some dried chickpeas to see how good they taste.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/24/science/24recipehealthalt/24recipehealthalt-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/24/science/24recipehealthalt/24recipehealthalt-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/24/science/24recipehealthalt/24recipehealthalt-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/24/science/24recipehealthalt/24recipehealthalt-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/24/science/24recipehealthalt/24recipehealthalt-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/24/science/24recipehealthalt/24recipehealthalt-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'cr