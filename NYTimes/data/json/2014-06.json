285acdf', 'word_count': 327, 'uri': 'nyt://article/d3cee69d-15ac-520a-b919-226af285acdf'}, {'abstract': 'Readers respond to a recent editorial on the surge of young immigrants at the southern border.', 'web_url': 'https://takingnote.blogs.nytimes.com/2014/06/10/children-at-the-border/', 'snippet': 'Readers respond to a recent editorial on the surge of young immigrants at the southern border.', 'lead_paragraph': 'More than a few online commenters were annoyed, angered or exasperated by an editorial last week, “Children on the Run,” which told of the recent surge of tens of thousands young migrants being caught at the southern border. These children, many of them traveling alone, are straining the Border Patrol’s resources and prompting the Obama administration to take urgent steps to ease what looks to us\xa0 like a refugee crisis, but to others like an invasion.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Children at the Border', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Deferred Action for Childhood Arrivals', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Illegal Immigration', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Goodlatte, Robert W', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Border Patrol (US)', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-06-10T16:17:21+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Lawrence Downes', 'person': [{'firstname': 'Lawrence', 'middlename': None, 'lastname': 'Downes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1a4488f4-7b0d-57db-b9c5-501f97f878f5', 'word_count': 1114, 'uri': 'nyt://article/1a4488f4-7b0d-57db-b9c5-501f97f878f5'}, {'abstract': 'The polar bear’s view of its Arctic domain is captured by a novel camera.', 'web_url': 'https://dotearth.blogs.nytimes.com/2014/06/10/recording-the-polar-bears-view-of-its-changing-arctic-environment/', 'snippet': 'The polar bear’s view of its Arctic domain is captured by a novel camera.', 'lead_paragraph': 'I first encountered the wildlife filmmaker Adam Ravetch in 2007 when writing about “Arctic Tale,” a film on polar bears and walruses that he co-directed for National Geographic in 2007 and which meshed fictional storytelling and astonishing imagery.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Recording the Polar Bear’s View of its Changing Arctic Environment', 'kicker': 'Dot Earth', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Bears', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cameras', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Polar Bears', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Science and Technology', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Pagano, Anthony', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Ravetch, Adam', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'National Geographic', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'United States Geological Survey', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'World Wildlife Fund', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'ARCTIC OCEAN', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'ARCTIC REGIONS', 'rank': 11, 'major': 'N'}], 'pub_date': '2014-06-10T16:18:01+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Andrew C. Revkin', 'person': [{'firstname': 'Andrew', 'middlename': 'C.', 'lastname': 'Revkin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7826c6fa-56e3-5a89-8751-c543a1eadf89', 'word_count': 1096, 'uri': 'nyt://article/7826c6fa-56e3-5a89-8751-c543a1eadf89'}, {'abstract': 'Yes, we have choices.', 'web_url': 'https://krugman.blogs.nytimes.com/2014/06/10/incentives-and-technology/', 'snippet': 'Yes, we have choices.', 'lead_paragraph': 'The invaluable Mark Thoma leads me to this post attacking what I thought was a totally obvious takedown of Roger Pielke Jr.. In general, reading attacks on oneself should be done in very limited doses, but in this case I learned something — namely, that what I assumed was obvious apparently isn’t to everyone.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Incentives and Technology', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-06-10T16:19:41+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/65f8eb77-74b4-51e7-b685-553bf48e2439', 'word_count': 289, 'uri': 'nyt://article/65f8eb77-74b4-51e7-b685-553bf48e2439'}, {'abstract': 'Many people believe voter impersonation and other kinds of election fraud are much more widespread than they really are.', 'web_url': 'https://www.nytimes.com/2014/06/11/upshot/vote-fraud-is-rare-but-myth-is-widespread.html', 'snippet': 'Many people believe voter impersonation and other kinds of election fraud are much more widespread than they really are.', 'lead_paragraph': 'Is vote fraud common in American politics? Not according to United States District Judge Lynn Adelman, who examined the evidence from Wisconsin and ruled in late April that “virtually no voter impersonation occ