: 'glocations', 'value': 'Iraq', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-06-27T13:02:15+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Bree Feng', 'person': [{'firstname': 'Bree', 'middlename': None, 'lastname': 'Feng', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/954f6c21-8d6f-5eee-aed7-7855e0b8f811', 'word_count': 559, 'uri': 'nyt://article/954f6c21-8d6f-5eee-aed7-7855e0b8f811'}, {'abstract': 'The makers of the movie “Earth to Echo” drew inspiration from 1980s movies including “E. T.” and “Stand by Me.”', 'web_url': 'https://www.nytimes.com/2014/06/29/movies/the-film-earth-to-echo-is-a-child-of-the-80s.html', 'snippet': 'The makers of the movie “Earth to Echo” drew inspiration from 1980s movies including “E. T.” and “Stand by Me.”', 'lead_paragraph': 'For children of the 1980s, there was no shortage of opportunities to see kids like themselves being heroes, while also being kids, on the big screen. Movies like “E. T.” and “Stand by Me” were hallmarks, placing young people in extraordinary situations and giving them room to explore new worlds just a bike ride away. They showed boys and girls on adventures of their own making, with their parents often on the sidelines. If the new science-fiction film “Earth to Echo,” due in theaters on Wednesday, bears a resemblance to these ’80s movies, it’s because the men behind it were raised on them.', 'print_section': 'AR', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Reliving Childhood Excursions', 'kicker': None, 'content_kicker': None, 'print_headline': 'Reliving Childhood Excursions', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Murphy, Mekado', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'Earth to Echo (Movie)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Green, Dave', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Gayden, Henry', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Panay, Andrew', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-06-27T13:14:54+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Movies', 'byline': {'original': 'By Mekado Murphy', 'person': [{'firstname': 'Mekado', 'middlename': None, 'lastname': 'Murphy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ed2369bf-9ad0-5bd4-8a25-7860451b1e71', 'word_count': 1053, 'uri': 'nyt://article/ed2369bf-9ad0-5bd4-8a25-7860451b1e71'}, {'abstract': 'Scenes from the men’s fashion week photo diary of Barbara Anastacio.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2014/06/27/the-scene-paris-mens-fashion-week-junya-watanabe-springsummer-2015/', 'snippet': 'Scenes from the men’s fashion week photo diary of Barbara Anastacio.', 'lead_paragraph': 'Scenes from the men’s fashion week photo diary of Barbara Anastacio.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Paris Men’s Fashion Week: Junya Watanabe Spring/Summer 2015', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Men and Boys', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': "Men's Fashion Week", 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Paris Fashion Week', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Watanabe, Junya', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Paris (France)', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-06-27T13:15:19+0000', 'document_type': 'artic