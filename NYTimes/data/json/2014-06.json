/11/upshot/11up-socceroos/11up-socceroos-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 460}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/11/upshot/11up-socceroos/11up-socceroos-jumbo.jpg', 'height': 786, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/11/upshot/11up-socceroos/11up-socceroos-superJumbo.jpg', 'height': 1571, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/11/upshot/11up-socceroos/11up-socceroos-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/11/upshot/11up-socceroos/11up-socceroos-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/11/upshot/11up-socceroos/11up-socceroos-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Australia’s Odd World Cup Optimism', 'kicker': 'Upbeat Aussies', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Soccer', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'World Cup 2014 (Soccer)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Australia', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-06-10T22:33:09+0000', 'document_type': 'article', 'news_desk': 'Upshot', 'section_name': 'The Upshot', 'byline': {'original': 'By Justin Wolfers', 'person': [{'firstname': 'Justin', 'middlename': None, 'lastname': 'Wolfers', 'qualifier': None, 'title': None, 'role': 'reported', 'organization':