ne': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Health Insurance and Managed Care', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Patient Protection and Affordable Care Act (2010)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Small Business', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Health and Human Services Department', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-06-13T11:00:05+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Entrepreneurship', 'byline': {'original': 'By Robb Mandelbaum', 'person': [{'firstname': 'Robb', 'middlename': None, 'lastname': 'Mandelbaum', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4676fb43-a6d3-5240-a13e-ad9eb7bd405c', 'word_count': 1020, 'uri': 'nyt://article/4676fb43-a6d3-5240-a13e-ad9eb7bd405c'}, {'abstract': 'The outgoing House majority leader viewed reform conservatism as a political strategy, not a policy agenda.', 'web_url': 'https://www.nytimes.com/2014/06/14/upshot/eric-cantor-is-not-a-reform-conservative.html', 'snippet': 'The outgoing House majority leader viewed reform conservatism as a political strategy, not a policy agenda.', 'lead_paragraph': 'One thing we’re hearing about Eric Cantor’s primary defeat is that it’s bad for “reform conservatism.” That’s a term that means different things to different people, but for these purposes I’m talking about a different domestic agenda from the one the Republican Party has been pursuing in recent years and one that centers on middle-class economic concerns.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/13/upshot/13UP-REFORM/13UP-REFORM-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/13/upshot/13UP-REFORM/13UP-REFORM-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/13/upshot/13UP-REFORM/13UP-REFORM-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/13/upshot/13UP-REFORM/13UP-REFORM-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/13/upshot/13UP-REFORM/13UP-REFORM-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/13/upshot/13UP-REFORM/13UP-REFORM-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/13/upshot/13UP-REFORM/13UP-REFORM-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Eric Cantor Is Not a Reform Conservative', 'kicker': 'The Politics of the Right', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Cantor, Eric', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Conservatism (US Politics)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-06-13T11:25:44+0000', 'document_type': 'article', 'news_desk': 'Upshot', 'section_name': 'The Upshot', 'byline': {'original': 'By Josh Barro', 'person': [{'firstname': 'Josh', 'middlename': None, 'lastname': 'Barro', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4ff97950-d3c5-5678-a867-31af723d4488', 'word_count': 865, 'uri': 'nyt://article/4ff97950-d3c5-5678-a867-31af723d4488'}, {'abstract': 'Opinions on gun violence, the Common Core, N.G.O.s in India and Eric Cantor.', 'web_url': 'https://op-talk.blogs.nytimes.com/2014/06/13/morning-views-12/', 'snippet': 'Opinions on gun violence, the Common Core, N.G.O.s in India and Eric Cantor.', 'lead_paragraph': '“What’s happening in Iraq is a disaster and it is astonishing that the Iraqis and the Americans, who have been sharing intelligence, seem to have been caught flat-footed by the speed of the insurgent victories and the army defections.”\xa0The New York Times editorial board comments on the sudden capture of Mosul by Sunni militants, and the greater threat to Iraq and the Middle East region, noting there are few good options in resolving the crisis with ease or speed.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Morning Views', 'kicker': 'Op-Talk', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-06-13T11:29:44+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Jake Flanagin', 'person': [{'firstname': 'Jake', 'middlename': None, 'lastname': 'Flanagin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b0aada61-133d-59bb-b182-93ce6d41f2ae', 'word_count': 534, 'uri': 'nyt://article/b0aada61-133d-59bb-b182-93ce6d41f2ae'}, {'abstract': 'For a second day, prices are rising modestly as traders worry over instability in the Middle East.', 'web_url': 'https://www.nytimes.com/2014/06/14/business/intern