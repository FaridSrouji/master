or': 'N'}], 'pub_date': '2014-06-12T23:58:22+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Ben Kenigsberg', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Kenigsberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/300b5192-3b5b-581b-badc-ab6d70280e46', 'word_count': 250, 'uri': 'nyt://article/300b5192-3b5b-581b-badc-ab6d70280e46'}, {'abstract': 'Firing bad educators won’t close the achievement gap.', 'web_url': 'https://www.nytimes.com/2014/06/13/opinion/california-ruling-on-teacher-tenure-is-not-whole-picture.html', 'snippet': 'Firing bad educators won’t close the achievement gap.', 'lead_paragraph': 'BERKELEY, Calif. — IN his decision on Tuesday to strike down California’s teacher-tenure system, Judge Rolf M. Treu of Los Angeles Superior Court ruled that laws protecting teachers from dismissal violated the state’s constitutional commitment to provide “a basically equal opportunity to achieve a quality education” and drew parallels with prior cases concerning school desegregation and funding levels. ', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Taking On Teacher Tenure Backfires', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'Taking on Teacher Tenure Backfires', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Rothstein, Jesse', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Teachers and School Employees', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Tenure', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Education (K-12)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'California', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Treu, Rolf M', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-06-12T23:59:11+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Jesse Rothstein', 'person': [{'firstname': 'Jesse', 'middlename': None, 'lastname': 'Rothstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/15e32452-fbed-5f8f-8536-3c40ac939072', 'word_count': 869, 'uri': 'nyt://article/15e32452-fbed-5f8f-8536-3c40ac939072'}, {'abstract': 'Following the wishes of Cy Twombly, his foundation has donated paintings and sculptures to the Tate Modern in London.', 'web_url': 'https://www.nytimes.com/2014/06/13/arts/design/cy-twombly-works-donated-to-tate-modern.html', 'snippet': 'Following the wishes of Cy Twombly, his foundation has donated paintings and sculptures to the Tate Modern in London.', 'lead_paragraph': 'Since 2010, the Tate Modern in London has devoted a gallery to Cy Twombly, the postwar American painter who died in 2011. In it are three large paintings from his “Bacchus” series — enormous abstract canvases of drippy red spirals dating from 2006-8 — along with five bronze sculptures and assemblages of found objects, such as the top of an olive barrel, that were made between 1979 and 1991.', 'print_section': 'C', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/13/arts/13VOGEL1/13VOGEL1-articleLarge.jpg', 'height': 354, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/13/arts/13VOGEL1/13VOGEL1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 354}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/13/arts/13VOGEL1/13VOGEL1-jumbo.jpg', 'height': 605, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/13/arts/13VOGEL1/13VOGEL1-superJumbo.jpg', 'height': 1210, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/13/arts/13VOGEL1/13VOGEL1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/13/arts/13VOGEL1/13VOGEL1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/13/arts/13VOGEL1/13VOGEL1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Cy Twombly Works Donated to Tate Modern', 'kicker': None, 'content_kicker': None, 'print_headline': 'Twombly Works Donated to Tate Modern', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Vogel, Carol', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Twombly, Cy', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-06-13T00:00:03+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Carol Vogel', 'person': [{'firstname': 'Carol', 'middlename': None, 'lastname': 'Vogel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/256f3bf2-b7df-5d5a-82fd-fdd1289f179d', 'word_count': 1021, 'uri': 'nyt://article/256f3bf2-b7df-5d5a-82fd-fdd1289f179d'}, {'abstract': 'On Father’s Day, I would try to give him something practical, like a drill or an electric carving knife. But a few weeks later, he’d give it back.', 'web_url': 'https://www.nytimes.com/2014/06/13/opinion/timothy-egan-secrets-of-the-ordinary-dad.html', 'snippet': 'On Father’s Day, I would try to give him something practical, like a drill or an electric carving knife. But a few weeks later, he’d give it back.', 'lead_paragraph': 'His gut was a jellyroll or two over the belt line and he smoked these discount cigarettes he bought by the carton, but that didn’t keep him from showing me one of his more nimble tricks. We’d wait till just after kickoff at the football game, the Cougars of Washington State. Then he’d lead me around the side where we could sneak in by crawling under a small opening in a big chain-link fence. I was 6 or 7.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/egan-circular/egan-circular-jumbo-v2.png', 'height': 228, 'width': 228, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/egan-circular/egan-circular-superJumbo-v2.png', 'height': 228, 'width': 228, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/egan-circular/egan-circular-thumbStandard-v2.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/11/01/opinion/egan-circular/egan-circular-thumbStandard-v2.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/egan-circular/egan-circular-thumbLarge-v4.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Secrets of the Ordinary Dad', 'kicker': 'Contributing Op-Ed Writer', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': "Father's Day", 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Families and Family Life', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-06-13T00:00:33+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By Timothy Egan', 'person': [{'firstname': 'Timothy', 'middlename': None, 'lastname': 'Egan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/30f25257-eef7-564e-bd6b-b7173dcb2a8c', 'word_count': 910, 'uri': 'nyt://article/30f25257-eef7-564e-bd6b-b7173dcb2a8c'}, {'abstract': 'The Texas Turnpike Corporation of Dallas has proposed a private toll road to connect Greenville and Wylie.', 'web_url': 'https://www.nytimes.com/2014/06/13/us/private-toll-road-considered-to-counter-population-boom.html', 'snippet': 'The Texas Turnpike Corporation of Dallas has proposed a private toll road to connect Greenville and Wylie.', 'lead_paragraph': 'Facing traffic congestion that is only expected to get worse, officials in North Texas are weighing a proposal to build a toll road for commuters into Dallas. The Texas Turnpike Corporation of Dallas has proposed a private toll road, the only of its kind in the state, connecting Greenville and Wylie, and local transportation officials say they are keeping an open mind.', 'print_section': 'A', 'print_page': '23A', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Private Toll Road Considered to Counter Population Boom', 'kicker': 'Texas Tribune', 'content_kicker': None, 'print_headline': 'Private Toll Road Considered to Counter Population Boom', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Texas', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Dallas (Tex)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Tolls', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Roads and Traffic', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Infrastructure (Public Works)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Transportation', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-06-13T00:01:40+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Aman Batheja', 'person': [{'firstname': 'Aman', 'middlename': None, 'lastname': 'Batheja', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/46306c11-d800-5b17-9048-795f78036b95', 'word_count': 613, 'uri': 'nyt://article/46306c11-d800-5b17-9048-795f78036b95'}, {'abstract': 'The Iranian director Mohammad Rasoulof’s thriller “Manuscripts Don’t Burn” depicts a hunt by state assassins for a manuscript recounting an attempt to kill intellectuals.', 'web_url': 'https://www.nytimes.com/2014/06/13/movies/manuscripts-dont-burn-about-repression-in-iran.html', 'snippet': 'The Iranian director Mohammad Rasoulof’s thriller “Manuscripts Don’t Burn” depicts a hunt by state assassins for a manuscript recounting an attempt to kill intellectuals.', 'lead_paragraph': 'Depicting his combustible material with a cool head and a steady hand, the Iranian filmmaker Mohammad Rasoulof — defying a 20-year government ban on his work — makes “Manuscripts Don’t Burn” a slow-motion explosion of anti-authoritarian rage.', 'print_section': 'C', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/13/arts/13MANUSCRIPTS/13MANUSCRIPTS-articleLarge-v2.jpg', 'height': 337, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/13/arts/13MANUSCRIPTS/13MANUSCRIPTS-articleLarge-v2.jpg', 'xlargewi