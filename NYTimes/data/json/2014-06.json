firstname': 'Erica', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d94cfe22-1f60-5667-867b-7d81452ab607', 'word_count': 476, 'uri': 'nyt://article/d94cfe22-1f60-5667-867b-7d81452ab607'}, {'abstract': 'The New York Asian Film Festival, opening on Friday, features 60 feature films.', 'web_url': 'https://www.nytimes.com/2014/06/26/movies/the-new-york-asian-film-festival-returns.html', 'snippet': 'The New York Asian Film Festival, opening on Friday, features 60 feature films.', 'lead_paragraph': 'The New York Asian Film Festival, whose 13th edition begins on Friday, can kindly be described as eclectic. Other festivals may stick to a theme or reflect a particular curatorial vision. The Asian Film Festival is all over the place. (And it’s a very big place.).', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Little in Common, Save a Continent', 'kicker': 'Critic’s Notebook', 'content_kicker': None, 'print_headline': 'Little in Common, Save a Continent', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'New York Asian Film Festival', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-06-25T22:03:50+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Movies', 'byline': {'original': 'By Mike Hale', 'person': [{'firstname': 'Mike', 'middlename': None, 'lastname': 'Hale', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7b1b98f2-dfb1-5218-9b53-b8ece3e82ad0', 'word_count': 894, 'uri': 'nyt://article/7b1b98f2-dfb1-5218-9b53-b8ece3e82ad0'}, {'abstract': 'Published nearly 70 years ago in France, “The Diary of the Dark Years” captures a writer’s firsthand account of the Nazi occupation in Paris.', 'web_url': 'https://www.nytimes.com/2014/06/26/books/david-balls-translation-of-diary-of-the-dark-years.html', 'snippet': 'Published nearly 70 years ago in France, “The Diary of the Dark Years” captures a writer’s firsthand account of the Nazi occupation in Paris.', 'lead_paragraph': 'If Jean Guéhenno had never existed, France would surely have had to invent him. A model writer and intellectual who neither collaborated nor accommodated the enemy, he refused to publish a single word as long as his country was under Nazi control. A leading essayist of the Popular Front, regularly skewered by the far right, he vowed, as of July 1940, to confine his thoughts and feelings to a private journal. It is a mystery why “Diary of the Dark Years, 1940-1944,” first published in 1947 and still a standard reference in France, is only now appearing in English in a fine translation by David Ball. Is there something about our own political climate that allows us finally to hear Guéhenno’s voice clearly?', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/arts/BOOK1/BOOK1-articleLarge.jpg', 'height': 1096, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/26/arts/BOOK1/BOOK1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 1096}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/arts/BOOK1/BOOK1-jumbo.jpg', 'height': 1024, 'width': 561, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/arts/BOOK1/BOOK1-superJumbo.jpg', 'height': 1438, 'width': 787, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/arts/BOOK1/BOOK1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/26/arts/BOOK1/BOOK1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/arts/BOOK1/BOOK1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Shedding Light on Nazi-Occupied Paris', 'kicker': None, 'content_kicker': None, 'print_headline': 'Shedding Light on Nazi-Occupied Paris', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'World War II (1939-45)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Guehenno, Jean', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Ball, David (Translator)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-06-25T22:05:10+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By Alice Kaplan', 'person': [{'firstname': 'Alice', 'middlename': None, 'lastname': 'Kaplan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/96cae16e-e071-59f0-8032-b20534c95543', 'word_count': 1074, 'uri': 'nyt://article/96cae16e-e071-59f0-8032-b20534c95543'}, {'abstract': 'With a new ensemble, Tierney Sutton performed much of her recently released Joni Mitchell tribute album, “After Blue,” at Birdland on Tuesday.', 'web_url': 'https://www.nytimes.com/2014/06/26/arts/music/tierney-sutton-reimagines-joni-mitchell-songs.html', 'snippet': 'With a new ensemble, Tierney Sutton performed much of her recently released Joni Mitchell tribute album, “After Blue,” at Birdland on Tuesday.', 'lead_paragraph': 'The West Coast singer Tierney Sutton would seem to be an ideal translator of Joni Mitchell songs into a jazz idiom because so many of them traverse traditional boundaries of pop, rock and folk to be their own thing, whatever you want to call it. Ms. Sutton, who does her own version of the same thing, recently released a mildly experimental Mitchell tribute album, “After Blue” (BFM Jazz), that plays with the songs’ rhythms, inserts improvisatory vocal passages and takes other liberties without bending them out of shape.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Classic Folk, Tested for Signs of Jazz', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Classic Folk, Tested for Signs of Jazz', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Sutton, Tierney', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Birdland (Manhattan, NY)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-06-25T22:12:25+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Stephen Holden', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Holden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/7316f044-4f78-5e7c-bc21-701f2e3823d3', 'word_count': 304, 'uri': 'nyt://article/7316f044-4f78-5e7c-bc21-701f2e3823d3'}, {'abstract': 'The 34-year career of the violinist Glenn Dicterow as the New York Philharmonic’s concertmaster is concluding with his solo performance in Beethoven’s Triple Concerto.', 'web_url': 'https://www.nytimes.com/2014/06/26/arts/music/glenn-dicterows-finale-with-the-philharmonic-is-beethoven.html', 'snippet': 'The 34-year career of the violinist Glenn Dicterow as the New York Philharmonic’s concertmaster is concluding with his solo performance in Beethoven’s Triple Concerto.', 'lead_paragraph': 'A festival and a tribute are happily crossing paths in the last week of the New York Philharmonic’s subscription season at Avery Fisher Hall. This week’s program, first performed on Tuesday evening, is the third and last in the orchestra’s Beethoven festival built around the five piano concertos, with Yefim Bronfman as soloist and Alan Gilbert conducting.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/arts/26BEETHOVEN/26BEETHOVEN-articleLarge.jpg', 'height': 369, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/26/arts/26BEETHOVEN/26BEETHOVEN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 369}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/arts/26BEETHOVEN/26BEETHOVEN-jumbo.jpg', 'height': 631, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/arts/26BEETHOVEN/26BEETHOVEN-superJumbo.jpg', 'height': 1261, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/arts/26BEETHOVEN/26BEETHOVEN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/26/arts/26BEETHOVEN/26BEETHOVEN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/arts/26BEETHOVEN/26BEETHOVEN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Team Player Is Honored With a Solo', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Team Player Is Honored With a Solo', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Dicterow, Glenn', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Philharmonic', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Avery Fisher Hall', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-06-25T22:16:45+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By James R. Oestreich', 'person': [{'firstname': 'James', 'middlename': 'R.', 'lastname': 'Oestreich', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/40aa10ae-01fd-54c1-92a0-a57fdf26b59f', 'word_count': 693, 'uri': 'nyt://article/40aa10ae-01fd-54c1-92a0-a57fdf26b59f'}, {'abstract': 'Maybe the rare-instruments market is showing signs of coming back to earth a bit, or maybe Sotheby’s and Ingles & Hayday simply asked for too much money for a fiddle.Whatever the reason, the “Macdonald” viola — a rare Stradivari viola — failed to attract a buyer when a sealed-bid sale came to an end on Wednesday and no one had offered to pay the record $45 million asking price.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2014/06/25/rare-stradivari-viola-fails-to-attract-buyer/', 'snippet': 'Maybe the rare-instruments market is showing signs of coming back to earth a bit, or maybe Sotheby’s and Ingles & Hayday simply asked for too much money for a fiddle.Whatever the reason, the “Macdonald” viola — a rare Stradivari viola — failed to ...', 'lead_paragraph': 'Maybe the rare-instruments market is showing signs of coming back to earth a bit, or maybe Sotheby’s and Ingles & Hayday simply asked for too much money for a fiddle.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Rare Stradivari Viola Fails to Attract Buyer', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'Stradivari Fails to Sell', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Auctions', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Violins and Violas', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Stradivari, Antonio', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': "Christie's", 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': "Sotheby's", 'rank': 5, 'major': 'N'}], 'pub_date': '2014-06-25T22:17:37+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Michael Cooper', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Cooper', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ef421251-04fb-53e5-b4ef-933c3f5c976b', 'word_count': 230, 'uri': 'nyt://article/ef421251-04fb-53e5-b4ef-933c3f5c976b'}, {'abstract': 'The witnesses agreed that the current system — with various rules for radio, satellite and streaming — was unfair. But there was no consensus on improving it.', 'web_url': 'https://www.nytimes.com/2014/06/26/business/media/more-calls-to-fix-music-royalty-rules-but-no-accord.html', 'snippet': 'The witnesses agreed that the current system — with various rules for radio, satellite and streaming — was unfair. But there was no consensus on improving it.', 'lead_paragraph': 'Two weeks ago, a House Judiciary subcommittee heard from a group of music executives that the complex licensing system is broken, but no consensus emerged about how to fix it. On Wednesday, the same committee heard from a different group of executives that the licensing system is broken, and once again there was no agreement on how to fix it.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'More Calls to Fix Music Royalty Rules, but No Accord', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Radio', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Royalties', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Audio Recordings, Downloads and Streaming', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'AMERICAN SOCIETY OF COMPOSERS, AUTHORS AND PUBLISHERS', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Broadcast Music Inc', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Sirius XM Radio Inc', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'National Assn of Broadcasters', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Cash, Rosanne', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Sensenbrenner, F James Jr', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Williams, Paul (1940- )', 'rank': 10, 'major': 'N'}], 'pub_date': '2014-06-25T22:22:05+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Ben Sisario', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Sisario', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/472eb478-5d4a-515a-8c67-c9a7787de06b', 'word_count': 643, 'uri': 'nyt://article/472eb478-5d4a-515a-8c67-c9a7787de06b'}, {'abstract': 'The Public Theater pays tribute to “A Chorus Line” and its composer, Marvin Hamlisch, during its annual Shakespeare in the Park gala.', 'web_url': 'https://www.nytimes.com/2014/06/26/fashion/tribute-to-a-chorus-line-and-marvin-hamlisch-at-shakespeare-in-the-park-gala.html', 'snippet': 'The Public Theater pays tribute to “A Chorus Line” and its composer, Marvin Hamlisch, during its annual Shakespeare in the Park gala.', 'lead_paragraph': 'Few shows inspire the same level of nostalgia as “A Chorus Line” does. It opened at the Public Theater in April 1975, moved to the Shubert Theater on Broadway three months later and went on to play 6,137 performances. In the process, it won the Pulitzer Prize, seven Drama Desk awards and nine Tony Awards.', 'print_section': 'E', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Kicking Up Their Heels in Tribute', 'kicker': None, 'content_kicker': None, 'print_headline': 'Kicking Up Their Heels in Tribute', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bernstein, Jacob', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Parties (Social)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Public Theater', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Shakespeare in the Park', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Hamlisch, Marvin', 'rank': 6, 'major': 'N'}, {'name': 'creative_works', 'value': 'A Chorus Line (Movie)', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Central Park (Manhattan, NY)', 'rank': 8, 'major': 'N'}], 'pub_date': '2014-06-25T22:22:24+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'byline': {'original': 'By Jacob Bernstein', 'person': [{'firstname': 'Jacob', 'middlename': None, 'lastname': 'Bernstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d857ca3e-193a-527a-a182-5b5733c1b338', 'word_count': 508, 'uri': 'nyt://article/d857ca3e-193a-527a-a182-5b5733c1b338'}, {'abstract': 'Ladurée, a SoHo restaurant, opens a 2,600-square-foot French-accented garden.', 'web_url': 'https://www.nytimes.com/2014/06/26/garden/like-lunch-with-monet.html', 'snippet': 'Ladurée, a SoHo restaurant, opens a 2,600-square-foot French-accented garden.', 'lead_paragraph': 'The garden that opened last month at Ladurée, the restaurant and shop in SoHo, is a 2,600-square-foot oasis designed to evoke Paris. Elisabeth Holder, a president of Ladurée in the United States, said that the green powder-coated metal chairs are airy interpretations of their counterparts at the Luxembourg Garden and the Tuileries, while the black metal trellises on arched windows were inspired by the Hôtel Plaza Athénée. (Visitors will also note that an antique fountain burbles like a messenger from Proust.)', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/garden/26CURROUTDOORS/26CURR1-articleLarge.jpg', 'height': 911, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/26/garden/26CURROUTDOORS/26CURR1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 911}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/garden/26CURROUTDOORS/26CURR1-jumbo.jpg', 'height': 1024, 'width': 675, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/garden/26CURROUTDOORS/26CURR1-superJumbo.jpg', 'height': 2048, 'width': 1349, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/garden/26CURROUTDOORS/26CURROUTDOORS-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/26/garden/26CURROUTDOORS/26CURROUTDOORS-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/garden/26CURROUTDOORS/26CURROUTDOORS-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Like Lunch With Monet', 'kicker': 'Currents: Outdoors', 'content_kicker': None, 'print_headline': 'Like Lunch With Monet', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'SoHo (Manhattan, NY)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Louie, Elaine', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Restoration and Renovation', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Laduree', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Restaurants', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Gardens and Gardening', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-06-25T22:22:47+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Elaine Louie', 'person': [{'firstname': 'Elaine', 'middlename': None, 'lastname': 'Louie', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8a0415bc-c2f5-5fb6-a24a-751922e54541', 'word_count': 141, 'uri': 'nyt://article/8a0415bc-c2f5-5fb6-a24a-751922e54541'}, {'abstract': 'The utilitarian material has been finding its way into all manner of furniture and decorative objects.', 'web_url': 'https://www.nytimes.com/2014/06/26/garden/shopping-for-rope-home-accents.html', 'snippet': 'The utilitarian material has been finding its way into all manner of furniture and decorative objects.', 'lead_paragraph': 'At Thom Filicia’s weekend house, bathroom mirrors are framed in rope, chairs are made out of it and a thick length serves as a stair rail.', 'print_section': 'D', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/garden/20140626-SHOP-slide-KX4Q/20140626-SHOP-slide-KX4Q-articleLarge.jpg', 'height': 900, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/26/garden/20140626-SHOP-slide-KX4Q/20140626-SHOP-slide-KX4Q-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 900}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/garden/20140626-SHOP-slide-KX4Q/20140626-SHOP-slide-KX4Q-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/garden/20140626-SHOP-slide-KX4Q/20140626-SHOP-slide-KX4Q-superJumbo.jpg', 'height': 2000, 'width': 1333, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/garden/20140626-SHOP-slide-KX4Q/20140626-SHOP-slide-KX4Q-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/26/garden/20140626-SHOP-slide-KX4Q/20140626-SHOP-slide-KX4Q-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/garden/20140626-SHOP-slide-KX4Q/20140626-SHOP-slide-KX4Q-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Furnishings Made of Rope: Knotty but No Problem', 'kicker': 'Shopping With Thom Filicia', 'content_kicker': None, 'print_headline': 'Knotty but No Problem', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Rope and Twine', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'McKeough, Tim', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Interior Design and Furnishings', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Filicia, Thom', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Shopping and Retail', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-06-25T22:22:55+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Tim McKeough', 'person': [{'firstname': 'Tim', 'middlename': None, 'lastname': 'McKeough', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cfb4a2fd-50b6-5e00-b127-3ce3fd5c8a1a', 'word_count': 421, 'uri': 'nyt://article/cfb4a2fd-50b6-5e00-b127-3ce3fd5c8a1a'}, {'abstract': 'Gregory Holm, a photographer with no professional food experience, opens an Art Deco-style restaurant called Antietam in a city he knows very well.', 'web_url': 'https://www.nytimes.com/2014/06/26/garden/capturing-detroits-local-flavor.html', 'snippet': 'Gregory Holm, a photographer with no professional food experience, opens an Art Deco-style restaurant called Antietam in a city he knows very well.', 'lead_paragraph': 'In 2010, Gregory Holm, a photographer and filmmaker, and Matthew Radune, an architect, soaked and froze an abandoned home in Detroit creating a luminous ice sculpture that made a ticklish point about the city’s many foreclosures. The same year, Mr. Holm built a soundstage in an empty fire station and produced a concert with local composers, a youth choir and eccentric instruments like a fire-powered organ.', 'print_section': 'D', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/garden/26QNA1-copy/26QNA1-articleLarge.jpg', 'height': 388, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/26/garden/26QNA1-copy/26QNA1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 388}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/garden/26QNA1-copy/26QNA1-jumbo.jpg', 'height': 663, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/garden/26QNA1-copy/26QNA1-superJumbo.jpg', 'height': 1325, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/garden/26QNA1-copy/26QNA1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/26/garden/26QNA1-copy/26QNA1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/garden/26QNA1-copy/26QNA1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Capturing Detroit’s Local Flavor', 'kicker': 'Currents: Q&A', 'content_kicker': None, 'print_headline': 'Capturing the Local Flavor', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Restaurants', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Conlin, Jennifer', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Detroit (Mich)', 'rank': 3, 'major': '