': 'N'}, {'name': 'subject', 'value': 'Furniture', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-06-11T22:21:24+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Steven Kurutz', 'person': [{'firstname': 'Steven', 'middlename': None, 'lastname': 'Kurutz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f5a2d9ec-9ede-5d60-be01-ec410ca3f7da', 'word_count': 162, 'uri': 'nyt://article/f5a2d9ec-9ede-5d60-be01-ec410ca3f7da'}, {'abstract': 'The birdhouse’s resemblance to to a certain Olympics stadium was not intentional, its designer said.', 'web_url': 'https://www.nytimes.com/2014/06/12/garden/modernist-birds-can-roost-here.html', 'snippet': 'The birdhouse’s resemblance to to a certain Olympics stadium was not intentional, its designer said.', 'lead_paragraph': 'This artisanal birdhouse looks like a homage to Herzog & de Meuron’s “bird’s nest” Olympic Stadium in Beijing. But the resemblance “probably was subconscious,” said Joe Mansfield, a founder, with Ken Tomita, of Grovemade, a five-year-old woodworking company in Portland, Ore., that produces it. Mr. Mansfield said he started with an Adobe Illustrator plug-in, and then realized, “Oh, that’s like a bunch of branches in a tree.” Made of walnut and what Mr. Mansfield described as “responsibly harvested, domestic Eastern hard-rock maple,” the small birdhouse comes with a solid brass perch and costs $200. Grovemade’s wood iPhone case has already appeared in the cult TV series “Portlandia.” If that show were to do a full-bore Grovemade parody, what product would be required? “I guess they’d have us make a high-end bike-polo stick,” Mr. Mansfield said. “It’s all the rage in Portland.” Information: grovemade.com.\xa0', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/12/garden/12GOODS/12CURRENTS8-articleLarge.jpg', 'height': 381, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/12/garden/12GOODS/12CURRENTS8-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 381}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/12/garden/12GOODS/12CURRENTS8-jumbo.jpg', 'height': 650, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/12/garden/12GOODS/12CURRENTS8-superJumbo.jpg', 'height': 1299, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/12/garden/12GOODS/12CURRENTS8-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/12/garden/12GOODS/12CURRENTS8-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/12/garden/12GOODS/12CURRENTS8-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Modernist Birds Can Roost Here', 'kicker': 'Currents: Goods', 'content_kicker': None, 'print_headline': 'Modernist Birds Can Roost Here', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Lee, Linda', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Shopping and Retail', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Birds', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Wood and Wood Products', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Grovemade', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Tomita, Ken', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Mansfield, Joe', 'rank': 8, 'major': 'N'}], 'pub_date': '2014-06-11T22:22:20+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Linda Lee', 'person': [{'firstname': 'Linda', 'middlename': None, 'lastname': 'Lee', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/62267e79-cd28-57a7-909c-019a4469abae', 'word_count': 143, 'uri': 'nyt://article/62267e79-cd28-57a7-909c-019a4469abae'}, {'abstract': 'Joseph Sciorra, a folklorist, scours Brooklyn neighborhoods for pebbled pottery that stems from his own Italian heritage.', 'web_url': 'https://www.nytimes.com/2014/06/12/garden/italian-decor-rooted-in-pottery.html', 'snippet': 'Joseph Sciorra, a folklorist, scours Brooklyn neighborhoods for pebbled pottery that stems from his own Italian heritage.', 'lead_paragraph': 'Joseph Sciorra, 59, has spent three decades studying how Italian-Americans adapt traditions from their ancestral homelands. The folklorist has looked at, among other topics, the Americanized versions of Italian embroidery, Neapolitan music, ephemeral architecture built for street processions and lawn shrines with saint statues in grottoes. A director of the John D. Calandra Italian American Institute at Queens College, he has been roaming Brooklyn streets lately, documenting 1950s planters covered in beach pebbles and blogging about his finds at i-italy.org.', 'print_section': 'D', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/12/garden/12QNA4/12QNA4-articleLarge.jpg', 'height': 900, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/12/garden/12QNA4/12Q