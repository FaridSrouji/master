1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e3ed3dd4-17fb-5b80-a786-cb2546ce108a', 'word_count': 167, 'uri': 'nyt://article/e3ed3dd4-17fb-5b80-a786-cb2546ce108a'}, {'abstract': 'Mr. King was a San Antonio businessman and pilot who sketched out an idea with his lawyer for a low-cost airline for Texas businessmen.', 'web_url': 'https://www.nytimes.com/2014/06/28/business/rollin-king-who-helped-start-southwest-airlines-is-dead-at-83.html', 'snippet': 'Mr. King was a San Antonio businessman and pilot who sketched out an idea with his lawyer for a low-cost airline for Texas businessmen.', 'lead_paragraph': 'Rollin W. King, a co-founder of Southwest Airlines, the low-cost carrier that helped to change the way Americans travel, died Thursday in Dallas. He was 83. The cause was complications from a stroke he had a year ago, his son Edward King of Dallas said.', 'print_section': 'A', 'print_page': '25', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/29/business/29Rollin/29Rollin-articleLarge.jpg', 'height': 773, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/29/business/29Rollin/29Rollin-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 773}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/29/business/29Rollin/29Rollin-jumbo.jpg', 'height': 1024, 'width': 796, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/29/business/29Rollin/29Rollin-superJumbo.jpg', 'height': 1227, 'width': 953, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/29/business/29Rollin/29Rollin-thumbStandard.jpg', '