n': [{'firstname': 'Michael', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b402b996-cabd-5469-ba3a-9973ca433ae2', 'word_count': 899, 'uri': 'nyt://article/b402b996-cabd-5469-ba3a-9973ca433ae2'}, {'abstract': 'Quotation of the Day for Monday, June 30, 2014.', 'web_url': 'https://www.nytimes.com/2014/06/30/pageoneplus/quotation-of-the-day-for-monday-june-30-2014.html', 'snippet': 'Quotation of the Day for Monday, June 30, 2014.', 'lead_paragraph': '“It feels the same to us. The money that they have, we didn’t have it before. And we don’t have it now.”', 'print_section': 'A', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Quotation of the Day for Monday, June 30, 2014', 'kicker': None, 'content_kicker': None, 'print_headline': 'Quotation of the Day', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-06-30T03:17:41+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Quote', '_id': 'nyt://article/84ffb70d-56cb-5574-acca-37b41f159cfd', 'word_count': 37, 'uri': 'nyt://article/84ffb70d-56cb-5574-acca-37b41f159cfd'}, {'abstract': 'Mr. Brown wrote industrial musicals for American corporations, which were meant to rally employees, and used some of his earnings to support Harper Lee while she wrote “To Kill a Mockingbird.”', 'web_url': 'https://www.nytimes.com/2014/06/30/arts/music/michael-brown-whose-industrial-musicals-gave-wings-to-to-kill-a-mockingbird-dies-at-93.html', 'snippet': 'Mr. Brown wrote industrial musicals for American corporations, which were meant to rally employees, and used some of his earnings to support Harper Lee while she wrote “To Kill a Mockingbird.”', 'lead_paragraph': 'Michael Brown, a cabaret performer and songwriter known for his sprightly contributions to the industrial musical, an American entertainment genre that literally sang the praises of vacuums and zippers and autos and steel — and who, as an improbable result of this work, bestowed on his friend Harper Lee the wherewithal to write her only novel, “To Kill a Mockingbird” — died on June 11 at his home in Manhattan. He was 93.', 'print_section': 'A', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/29/arts/dog-brown-obit/dog-brown-obit-articleLarge-v2.jpg', 'height': 423, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/29/arts/dog-brown-obit/dog-brown-obit-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 423}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/29/arts/dog-brown-obit/dog-brown-obit-jumbo-v2.jpg', 'height': 722, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/29/arts/dog-brown-obit/dog-brown-obit-superJumbo-v2.jpg', 'height': 1443, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/29/arts/dog-brown-obit/dog-brown-obit-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/29/arts/dog-brown-obit/dog-brown-obit-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/29/arts/dog-brown-obit/dog-brown-obit-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 