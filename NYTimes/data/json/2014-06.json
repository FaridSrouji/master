me': 'Josh', 'middlename': None, 'lastname': 'Katz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'David', 'middlename': None, 'lastname': 'Leonhardt', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3cab4475-c003-5839-8114-c8710a205c4f', 'word_count': 314, 'uri': 'nyt://article/3cab4475-c003-5839-8114-c8710a205c4f'}, {'abstract': 'The Abstract Expressionist Raymond Spillenger was an underrecognized member of the New York School. His later work, which his sons unearthed, may have a second life.', 'web_url': 'https://www.nytimes.com/2014/06/08/arts/design/raymond-spillenger-of-the-new-york-school-gets-noticed.html', 'snippet': 'The Abstract Expressionist Raymond Spillenger was an underrecognized member of the New York School. His later work, which his sons unearthed, may have a second life.', 'lead_paragraph': 'Raymond Spillenger, who died in November at the age of 89, was among the very last of the first- and second-generation Abstract Expressionists. There can’t be many others remaining, and few more obscure than Mr. Spillenger, who left scant traces. Some of his paintings hang — or have hung — at the Hirshhorn Museum in Washington, at the Contemporary Arts Museum in Houston and at the Walker Art Center in Minneapolis, and his name is mentioned in a few of the reference books. That’s about it. Mr. Spillenger’s reputation, or lack of one, is a reminder that the great art movements rise and then fall — with Abstract Expressionism eased aside by Pop, in turn overtaken by Super-Realism, Minimalism and all the other isms — and that from any one moment, often only a handful of names survive, some for good reason, some just from luck or self-promotion.', 'print_section': 'AR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/08/arts/08SPILLENGER4/08JPSPILLENGER2-articleLarge.jpg', 'height': 618, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/08/arts/08SPILLENGER4/08JPSPILLENGER2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 618}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/08/arts/08SPILLENGER4/08JPSPILLENGER2-jumbo.jpg', 'height': 1024, 'width': 994, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/08/arts/08SPILLENGER4/08JPSPILLENGER2-superJumbo.jpg', 'height': 2048, 'width': 1987, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/08/arts/08SPILLENGER4/08JPSPILLENGER2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/08/arts/08SPILLENGER4/08JPSPILLENGER2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/08/arts/08SPILLENGER4/08JPSPILLENGER2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Abstract Painter’s Afterlife, Reborn', 'kicker': None, 'content_kicker': None, 'print_headline': 'Abstract Painter’s Afterlife, Reborn', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'McGrath, Charles', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'East Village (Manhattan, NY)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Institute of Contemporary Art', 'rank': 4, 'major': 