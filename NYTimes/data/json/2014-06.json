ame': 'persons', 'value': '50 CENT', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'Power (TV Program)', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-06-06T14:00:33+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Alessandra Stanley', 'person': [{'firstname': 'Alessandra', 'middlename': None, 'lastname': 'Stanley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/da2dbdba-8548-5e11-979d-6a049da4fec3', 'word_count': 684, 'uri': 'nyt://article/da2dbdba-8548-5e11-979d-6a049da4fec3'}, {'abstract': 'Eric Abraham, a former South African journalist, commissioned a play about a meeting between a black female psychologist and the convicted former leader of a pro-apartheid death squad.', 'web_url': 'https://www.nytimes.com/2014/06/08/theater/a-bit-of-south-africas-ugly-past-comes-to-the-stage.html', 'snippet': 'Eric Abraham, a former South African journalist, commissioned a play about a meeting between a black female psychologist and the convicted former leader of a pro-apartheid death squad.', 'lead_paragraph': 'LONDON — In 1997, in the newly democratic South Africa, a black female psychologist met a white male convict in Pretoria Central Prison. The psychologist, Pumla Gobodo-Madikizela, had just completed a doctoral fellowship at Harvard and had returned to the country to serve on the Truth and Reconciliation Commission. The man she had asked to meet was Eugene de Kock, a former policeman nicknamed “Prime Evil,” who had led a covert counterterrorism unit dedicated to the torture and killing of anti-apartheid activists.', 'print_section': 'AR', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'imag