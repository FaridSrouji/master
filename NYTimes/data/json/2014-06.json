e New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/egan-circular/egan-circular-jumbo-v2.png', 'height': 228, 'width': 228, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/egan-circular/egan-circular-superJumbo-v2.png', 'height': 228, 'width': 228, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/egan-circular/egan-circular-thumbStandard-v2.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/11/01/opinion/egan-circular/egan-circular-thumbStandard-v2.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/egan-circular/egan-circular-thumbLarge-v4.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Corporate Daddy', 'kicker': 'Contributing Op-Ed Writer', 'content_kicker': None, 'print_headline': 'Corporate Daddy', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Egan, Timothy', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Walmart Stores Inc', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Starbucks Corporation', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Income Inequality', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Corporations', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Minimum Wage', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Wages and Salaries', 'rank': 9, 'major': 'N'}], 'pub_date': '2014-06-20T00:14:47+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By Timothy Egan', 'person': [{'firstname': 'Timothy', 'middlename': None, 'lastname': 'Egan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/207e4f7f-ab4b-54dc-b4e5-e7f014036ebc', 'word_count': 997, 'uri': 'nyt://article/207e4f7f-ab4b-54dc-b4e5-e7f014036ebc'}, {'abstract': '“Norte, the End of History,” Lav Diaz’s reimagining of “Crime and Punishment,” explores the nature of evil through a double murder and wrongful imprisonment.', 'web_url': 'https://www.nytimes.com/2014/06/20/movies/norte-the-end-of-history-a-dostoyevskian-fable.html', 'snippet': '“Norte, the End of History,” Lav Diaz’s reimagining of “Crime and Punishment,” explores the nature of evil through a double murder and wrongful imprisonment.', 'lead_paragraph': 'More than four hours long, filmed in expansive takes with almost no close-ups and very few camera movements, Lav Diaz’s “Norte, the End of History” is a tour de force of slow cinema. The movie, something of a sensation at Cannes last year, is not difficult or obscure — there is a clear, dramatic story involving characters who solicit both empathy and curiosity — but it does require an adjustment of the usual viewing metabolism.', 'print_section': 'C', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/20/arts/20NORTE/NORTE-articleLarge.jpg', 'height': 257, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/20/arts/20NORTE/NORTE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 257}}, {'rank': 0, 'subtype'