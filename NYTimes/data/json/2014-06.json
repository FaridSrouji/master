ight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/31/business/norrispic/norrispic-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Global Rules for Auditors? Don’t Hold Your Breath', 'kicker': None, 'content_kicker': None, 'print_headline': 'Global Rules for Auditors? Don’t Hold Your Breath', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ACCOUNTING AND ACCOUNTANTS', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Securities and Exchange Commission', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'White, Mary Jo', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Cox, Christopher (1952- )', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-06-12T23:41:03+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Floyd Norris', 'person': [{'firstname': 'Floyd', 'middlename': None, 'lastname': 'Norris', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1b950665-1096-5846-8f6d-a515177b79b1', 'word_count': 1336, 'uri': 'nyt://article/1b950665-1096-5846-8f6d-a515177b79b1'}, {'abstract': 'An obnoxious young man learns life lessons as his father nears death in “Lullaby,” the directorial debut of Andrew Levitas.', 'web_url': 'https://www.nytimes.com/2014/06/13/movies/lullaby-features-richard-jenkins-and-amy-adams.html', 'snippet': 'An obnoxious young man learns life lessons as his father nears death in “Lullaby,” the directorial debut of Andrew Levitas.', 'lead_paragraph': 'Am I a hardhearted meanie because I watched “Lullaby,” a solemn, triple-hankie sobfest about assisted suicide, in a state of dry-eyed impatience? Maybe so. But “Lullaby,” the directorial debut of Andrew Levitas, a jack of all artistic trades, is the kind of manipulative, cliché-infested hokum that alienates moviegoers by its insistence on hogging all the tears. Its subliminal message — “I’m more sensitive than you could possibly be” — is exclusionary, and much of its stilted dialogue (“It’s hard to love someone who’s got an expiration date stamped on their forehead”) is cringe worthy.', 'print_section': 'C', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/13/arts/13LULLABY/LULLABY-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/13/arts/13LULLABY/LULLABY-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/13/arts/13LULLABY/LULLABY-jumbo.jpg', 'height': 680, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/13/arts/13LULLABY/LULLABY-superJumbo.jpg', 'height': 1360, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/13/arts/13LULLABY/13LULLABY-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/13/arts/13LULLABY/13LULLABY-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/