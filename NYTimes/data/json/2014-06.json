qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/504cb034-628c-55e0-889b-2866e254f520', 'word_count': 308, 'uri': 'nyt://article/504cb034-628c-55e0-889b-2866e254f520'}, {'abstract': 'It is unclear what the role of events like E3 will be as more of the games business shifts to digital distribution, away from physical stores.', 'web_url': 'https://bits.blogs.nytimes.com/2014/06/14/the-future-of-e3-as-video-games-go-digital/', 'snippet': 'It is unclear what the role of events like E3 will be as more of the games business shifts to digital distribution, away from physical stores.', 'lead_paragraph': 'LOS ANGELES — The Electronic Entertainment Expo, or E3, the video game industry’s annual convention, is very good at a certain ritual: building hype for big-budget games — more often than not for consoles — just before summer starts, so publishers can maximize their sales when games land on store shelves for the holidays. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/13/business/13bits-gaming1/13bits-gaming1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/13/business/13bits-gaming1/13bits-gaming1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/13/business/13bits-gaming1/13bits-gaming1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/13/business/13bits-gaming1/13bits-gaming1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 