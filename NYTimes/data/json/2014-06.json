ONFMAN/11BRONFMAN-articleLarge.jpg', 'height': 347, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/11/arts/11BRONFMAN/11BRONFMAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 347}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/11/arts/11BRONFMAN/11BRONFMAN-jumbo.jpg', 'height': 593, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/11/arts/11BRONFMAN/11BRONFMAN-superJumbo.jpg', 'height': 1186, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/11/arts/11BRONFMAN/11BRONFMAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/11/arts/11BRONFMAN/11BRONFMAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/11/arts/11BRONFMAN/11BRONFMAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Beethoven That’s Not for Bruisers', 'kicker': 'Critic’s Notebook', 'content_kicker': None, 'print_headline': 'Beethoven That’s Not for Bruisers', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Classical Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Woolfe, Zachary', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Bronfman, Yefim', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Beethoven, Ludwig van', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-06-10T21:22:14+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Zachary Woolfe', 'person': [{'firstname': 'Zachary', 'middlename': None, 'lastname': 'Woolfe', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fff0562d-32b1-5d1c-8535-7de90bbd23fa', 'word_count': 1021, 'uri': 'nyt://article/fff0562d-32b1-5d1c-8535-7de90bbd23fa'}, {'abstract': 'Nothing that has been announced this week at the Electronic Entertainment Expo has been as surprising or delightful as the recent emergence of a new Wolfenstein game.', 'web_url': 'https://www.nytimes.com/2014/06/11/arts/video-games/an-alternate-1960-in-wolfenstein-the-new-order.html', 'snippet': 'Nothing that has been announced this week at the Electronic Entertainment Expo has been as surprising or delightful as the recent emergence of a new Wolfenstein game.', 'lead_paragraph': 'LOS ANGELES — The Nazis, those perpetual video game villains who seemed to have been felled in recent years by a virulent zombie contagion, are back. Nothing that has been announced here this week at the Electronic Entertainment Expo, the annual video game trade show better known as E3, has been as surprising or delightful — granted, an odd word to apply to the return of National Socialism — as the recent emergence of a new Wolfenstein game as one of the very best releases of the year.', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/11/arts/11WOLFENSTEIN1/11WOLFENSTEIN1-articleLarge.jpg', 'height': 368, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/11/arts/11WOLFENSTEIN1/11WOLFENSTEIN1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 368}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/11/arts/11WOLFENSTEIN1/11WOLFENSTEIN1-jumbo.jpg', 'height': 628, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/11/arts/11WOLFENSTEIN1/11WOLFENSTEIN1-superJumbo.jpg', 'height': 1133, 'width': 1848, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/11/arts/11WOLFENSTEIN1/11WOLFENSTEIN1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/11/arts/11WOLFENSTEIN1/11WOLFENSTEIN1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/11/arts/11WOLFENSTEIN1/11WOLFENSTEIN1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Beatles Sing in German, and a Nazi Flag Waves', 'kicker': 'Video Game Review', 'content_kicker': None, 'print_headline': 'Beatles Sing in German, and a Nazi Flag Waves', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Suellentrop, Chris', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Computer and Video Games', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Bethesda Softworks', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'Wolfenstein: The New Order (Video Game)', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-06-10T21:25:19+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Video Games', 'byline': {'original': 'By Chris Suellentrop', 'person': [{'firstname': 'Chris', 'middlename': None, 'lastname': 'Suellentrop', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/2b0abbe6-16cd-50a8-953e-7ef50e185db3', 'word_count': 775, 'uri': 'nyt://article/2b0abbe6-16cd-50a8-953e-7ef50e185db3'}, {'abstract': 'Why I am ending The Gun Report.', 'web_url': 'https://nocera.blogs.nytimes.com/2014/06/10/the-last-gun-report/', 'snippet': 'Why I am ending The Gun Report.', 'lead_paragraph': 'Last Thursday, Jennifer Mascia and I posted our last Gun Report. It was my feeling that although it had been a useful tool — a daily statement about gun violence in America — The Gun Report had run its course. During the year and change that we published it, readers got a close-up look at the many forms gun violence takes — the horrifying incidents involving children shooting other children; the drive-by shootings; the shootings that result from a moment’s rage; and so on. There weren’t just one or two shootings each day; there were 30 or more. On weekends, the carnage was horrific. The Gun Report also became a place where gun proponents and gun opponents could voice their views in the comment section.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Last Gun Report', 'kicker': 'Joe Nocera', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-06-10T21:28:39+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Joe Nocera', 'person': [{'firstname': 'Joe', 'middlename': None, 'lastname': 'Nocera', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/942a302b-a1c3-536f-b045-cf09dd3cddd9', 'word_count': 205, 'uri': 'nyt://article/942a302b-a1c3-536f-b045-cf09dd3cddd9'}, {'abstract': 'This has been a year for anniversaries solemn and sublime in American history and culture. But where does O. J. Simpson and his murder case fit in?', 'web_url': 'https://www.nytimes.com/2014/06/11/arts/television/11simpson.html', 'snippet': 'This has been a year for anniversaries solemn and sublime in American history and culture. But where does O. J. Simpson and his murder case fit in?', 'lead_paragraph': 'Beginning last fall, we seem to have entered a 12-month period heavy with anniversaries, which allows us to pause and ask: Why observe them? Perhaps to note a traumatic moment in history (the 50th of President John F. Kennedy’s assassination) or a turning point (the 50th of the Civil Rights Act and Freedom Summer). Perhaps to commemorate heroism (the 70th of D-Day). Perhaps to relish a cultural sea change (the 50th of the Beatles on “The Ed Sullivan Show”; the 45th of Woodstock). ', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/11/arts/simpson/simpson-articleLarge.jpg', 'height': 383, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/11/arts/simpson/simpson-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 383}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/11/arts/simpson/simpson-jumbo.jpg', 'height': 654, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/11/arts/simpson/simpson-superJumbo.jpg', 'height': 1182, 'width': 1852, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/11/arts/simpson/simpson-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail':