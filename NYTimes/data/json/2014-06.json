ne, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/business/MEEHAN-obit/MEEHAN-obit-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/26/business/MEEHAN-obit/MEEHAN-obit-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/business/MEEHAN-obit/MEEHAN-obit-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Paula Kent Meehan, Co-Founder of a Hair-Care Giant, Dies at 82', 'kicker': None, 'content_kicker': None, 'print_headline': 'Paula Kent Meehan, 82, Hair-Care Entrepreneur', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Martin, Douglas', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Kent Meehan, Paula (1931-2014)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Shampoos and Hair Products', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Redding, Jheri', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-06-26T00:10:29+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Douglas Martin', 'person': [{'firstname': 'Douglas', 'middlename': None, 'lastname': 'Martin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/3c20daba-6ecf-5d28-975c-73ff007a4495', 'word_count': 896, 'uri': 'nyt://article/3c20daba-6ecf-5d28-975c-73ff007a4495'}, {'abstract': 'Trapped by apathy and bureaucracy, they wait in vain for visas.', 'web_url': 'https://www.nytimes.com/2014/06/26/opinion/the-iraqi-friends-we-abandoned.html', 'snippet': 'Trapped by apathy and bureaucracy, they wait in vain for visas.', 'lead_paragraph': 'LOS ANGELES — “LET’S be perfectly coldblooded about it,” President Richard M. Nixon mused to Henry A. Kissinger. “South Vietnam is probably never gonna survive anyway.” It was August 1972, and Nixon was worried about the inevitable collapse of South Vietnam after American forces withdrew. Mr. Kissinger concurred: “We’ve got to find some formula that holds the thing together a year or two. If we settle it, say, this October, by January ’74 no one will give a damn.” ', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/opinion/0626OPEDbarczyk/0626OPEDbarczyk-articleLarge.jpg', 'height': 609, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/26/opinion/0626OPEDbarczyk/0626OPEDbarczyk-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 609}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/opinion/0626OPEDbarczyk/0626OPEDbarczyk-jumbo.jpg', 'height': 1024, 'width': 1010, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/opinion/0626OPEDbarczyk/0626OPEDbarczyk-superJumbo.jpg', 'height': 2048, 'width': 2019, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/26/opinion/0626OPEDbarczyk/0626OPEDbarczyk-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/26/opinion/0626OPEDbarczyk/0626OPEDbarczyk-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight