, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/19/upshot/19up-yellen/19up-yellen-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/19/upshot/19up-yellen/19up-yellen-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/19/upshot/19up-yellen/19up-yellen-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What Janet Yellen Is Trying to Tell Us', 'kicker': 'Interpreting the Fed', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Yellen, Janet L', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Quantitative Easing', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Inflation (Economics)', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Federal Reserve System', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-06-18T20:11:57+0000', 'document_type': 'article', 'news_desk': 'Upshot', 'section_name': 'The Upshot', 'byline': {'original': 'By Neil Irwin', 'person': [{'firstname': 'Neil', 'middlename': None, 'lastname': 'Irwin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ff9f179d-18f0-5c67-90d8-356bbdcfdc66', 'word_count': 783, 'uri': 'nyt://article/ff9f179d-18f0-5c67-90d8-356bbdcfdc66'}, {'abstract': 'The New York City Ballet will go back to a two-week season at the Saratoga Performing Arts Center in 2015.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2014/06/18/city-ballet-to-add-a-week-to-its-saratoga-residency/', 'snippet': 'The New York City Ballet will go back to a two-week season at the Saratoga Performing Arts Center in 2015.', 'lead_paragraph': 'The Saratoga Performing Arts Center has found a way to stop the New York City Ballet’s slow disappearing act. Having seen the company’s residency dwindle from four weeks to three in 1978, then from three weeks to two in 2009 and then to a single week in 2013 and this year, mainly because the cost of presenting the company was outstripping the center’s ability to raise money to pay for it, the center’s board of directors announced on Tuesday that it would reverse that trend: when the City Ballet returns to Saratoga in 2015, it will be for a two-week season.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'City Ballet to Add a Week to Its Saratoga Residency', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'City Ballet to Add a Week To Its Saratoga Residency', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dancing', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York City Ballet', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Saratoga Performing Arts Center', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-06-18T20:15:29+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Allan Kozinn', 'person': [{'firstname': 'Allan', 'middlename': None, 'lastname': 'Kozinn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b80960e0-b4c1-58fa-96f3-d539aa0274df', 'word_count': 236, 'uri': 'nyt://article/b80960e0-b4c1-58fa-96f3-d539aa0274df'}, {'abstract': 'The Talea Ensemble is exploring sound through modern and contemporary music during its residency at the Stone.', 'web_url': 'https://www.nytimes.com/2014/06/19/arts/music/anthony-cheung-performs-in-talea-ensembles-residency.html', 'snippet': 'The Talea Ensemble is exploring sound through modern and contemporary music during its residency at the Stone.', 'lead_paragraph': 'All composers are interested in sound, but Anthony Cheung more than most. His orchestral work “Fog Mobiles” (2010) has its horn soloist create tones that suggest foghorns heard from various distances. “Lyra,” first performed last week by the New York Philharmonic, calls for shimmering transitions between a live ensemble and taped music.', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/19/arts/TALEA/TALEA-articleLarge.jpg', 'height': 402, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/19/arts/TALEA/TALEA-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 402}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/19/arts/TALEA/TALEA-jumbo.jpg', 'height': 686, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/19/arts/TALEA/TALEA-superJumbo.jpg', 'height': 1372, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/19/arts/TALEA/TALEA-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/19/arts/TALEA/TALEA-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/19/arts/TALEA/TALEA-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name':