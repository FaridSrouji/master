: [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/garden/05CURR4/05CURR4-jumbo.jpg', 'height': 587, 'width': 480, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/garden/05CURR4/05CURR4-superJumbo.jpg', 'height': 587, 'width': 480, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/garden/05CURR4/05CURR4-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/05/garden/05CURR4/05CURR4-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/garden/05CURR4/05CURR4-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Design Treasures Once Destined for Archives Now Can Be Yours', 'kicker': 'Currents: Open', 'content_kicker': None, 'print_headline': 'New Gallery Puts Design in Focus', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'ARCHITECTURE', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Museums', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Los Angeles (Calif)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Mount, Christopher W', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-06-04T22:50:13+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Steven Kurutz', 'person': [{'firstname': 'Steven', 'middlename': None, 'lastname': 'Kurutz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/563c5d81-5ffa-5ea0-9609-28b8da3cdd53', 'word_count': 157, 'uri': 'nyt://article/563c5d81-5ffa-5ea0-9609-28b8da3cdd53'}, {'abstract': 'The new Internet-based phones still have some major flaws.', 'web_url': 'https://www.nytimes.com/2014/06/05/opinion/when-the-landline-is-a-lifeline.html', 'snippet': 'The new Internet-based phones still have some major flaws.', 'lead_paragraph': 'AT&T and Verizon are pushing hard to shift traditional landline service, which has mostly operated over copper lines, to a system of Internet-based phones by around 2020. If the Federal Communications Commission approves the switch as is, it could come as a shock to the 96 million Americans who still rely on landlines.', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/opinion/0605OPEDmaida/0605OPEDmaida-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/05/opinion/0605OPEDmaida/0605OPEDmaida-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/opinion/0605OPEDmaida/0605OPEDmaida-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/opinion/0605OPEDmaida/0605OPEDmaida-superJumbo.jpg', 'height': 2048, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/opinion/0605OPEDmaida/0605OPEDmaida-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thum