 [{'name': 'subject', 'value': 'Hotels and Travel Lodgings', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Marriott International Inc.', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Business Travel', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Age, Chronological', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Youth', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-06-16T22:32:33+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Harriet Edleson', 'person': [{'firstname': 'Harriet', 'middlename': None, 'lastname': 'Edleson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/aabbe0d4-3a62-5965-b26d-d9b2987cae46', 'word_count': 939, 'uri': 'nyt://article/aabbe0d4-3a62-5965-b26d-d9b2987cae46'}, {'abstract': 'New York Times correspondents in Iraq respond to questions about the insurgency, sectarian strife and United States policy options.', 'web_url': 'https://www.nytimes.com/2014/06/17/world/middleeast/ask-a-question-about-iraq.html', 'snippet': 'New York Times correspondents in Iraq respond to questions about the insurgency, sectarian strife and United States policy options.', 'lead_paragraph': 'The conflict in Syria has escalated into a wider regional crisis, edging neighboring Iraq closer to all-out sectarian warfare, as Sunni militants led by the Islamic State in Iraq and Syria, or ISIS, have  declared a caliphate that stretches across eastern Syria and much of northern and western Iraq.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Questions and Answers About the Crisis in Iraq', 'kicker': None, 'content_kicker': None, 'print_headline': 'Your Iraq Questions, Answered', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glo