: [{'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Entrepreneurship', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Small Business', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-06-20T15:54:56+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Entrepreneurship', 'byline': {'original': 'By Gene Marks', 'person': [{'firstname': 'Gene', 'middlename': None, 'lastname': 'Marks', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3acfc734-fb43-514e-96b6-84d91e00a0d6', 'word_count': 504, 'uri': 'nyt://article/3acfc734-fb43-514e-96b6-84d91e00a0d6'}, {'abstract': 'He knew how to convey complicated emotions with the plainest of words.', 'web_url': 'https://takingnote.blogs.nytimes.com/2014/06/20/r-i-p-gerry-goffin-a-master-songwriter/', 'snippet': 'He knew how to convey complicated emotions with the plainest of words.', 'lead_paragraph': 'I used to give a class for New York Times interns on writing and editing. I would start by playing the Gerry Goffin and Carole King song “Will You Love Me Tomorrow?” (I used Ms. King’s version.) I wanted to make a point about brevity and beauty: to show how it’s possible to convey complicated emotions, deep feeling and intricate meanings with the tiniest and plainest of words. You can be short and sweet. You can also be short and heartbreaking.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'R.I.P. Gerry Goffin, a Master Songwriter', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'GOFFIN, GERRY', 'rank': 1, 'major': 'N'}], 'pub_date': '2014-06-20T15:57:49+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Lawrence Downes', 'person': [{'firstname': 'Lawrence', 'middlename': None, 'lastname': 'Downes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/357fd250-8f39-5127-9b06-79053813b32c', 'word_count': 221, 'uri': 'nyt://article/357fd250-8f39-5127-9b06-79053813b32c'}, {'abstract': 'Switzerland was much buzzed-about coming into the Cup, and after an initial struggle, it rallied to beat Ecuador.', 'web_url': 'https://sports.blogs.nytimes.com/2014/06/20/france-vs-switzerland-world-cup-2014-live-blog/', 'snippet': 'Switzerland was much buzzed-about coming into the Cup, and after an initial struggle, it rallied to beat Ecuador.', 'lead_paragraph': 'Switzerland was much buzzed-about coming into the Cup, and after an initial struggle, it rallied to beat Ecuador.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'France vs. Switzerland: World Cup 2014 Live Blog', 'kicker': 'Sports', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Soccer', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'World Cup 2014 (Soccer)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'France', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Switzerland', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-06-20T15:59:27+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Lawrie Mifflin', 'person': [{'firstname': 'Lawrie', 'middlename': None, 'lastname': 'Mifflin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7818bf11-bd8b-5a8a-a298-f2ea45dc5d8b', 'word_count': 2231, 'uri': 'nyt://article/7818bf11-bd8b-5a8a-a298-f2ea45dc5d8b'}, {'abstract': 'Michael Hersch’s new opera, “On the Threshold of Winter,” was inspired by a friend’s lost battle with ovarian cancer and a dying Romanian poet’s diary.', 'web_url': 'https://www.nytimes.com/2014/06/22/arts/music/michael-herschs-new-opera-reflects-on-a-friends-death.html', 'snippet': 'Michael Hersch’s new opera, “On the Threshold of Winter,” was inspired by a friend’s lost battle with ovarian cancer and a dying Romanian poet’s diary.', 'lead_paragraph': 'HAVERTOWN, Pa. — The visual artist Christopher Cairns’s sprawling studio near Philadelphia is filled with installations that include piles of skulls and forlorn figures slumped despairingly in chairs. Sculptures that evoke the victims of Pompeii are strewn across the floor near the white wall, which is made of crumbling bricks and shards of glass and will be replicated in the sets for “On the Threshold of Winter,” Michael Hersch’s new opera. Mr. Cairns’s eerie art seems an aptly somber pairing for the dark-hued monodrama, which will receive its premiere at the Brooklyn Academy of Music on Wednesday, Mr. Hersch’s birthday, with Tito Muñoz conducting the ensemble Nunc.', 'print_section': 'AR', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/22/arts/22HERSCH2/22HERSCH2-articleLarge-v2.jpg', 'height': 377, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/22/arts/22HERSCH2/22HERSCH2-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 377}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/22/arts/22HERSCH2/22HERSCH2-jumbo-v2.jpg', 'height': 643, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/22/arts/22HERSCH2/22HERSCH2-superJumbo-v2.jpg', 'height': 1285, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/22/arts/22HERSCH2/22HERSCH2-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/22/arts/22HERSCH2/22HERSCH2-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/22/arts/22HERSCH2/22HERSCH2-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Survivor, Inspired by Love and Loss', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Survivor, Inspired by Love and Loss ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Schweitzer, Vivien', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Opera', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Hersch, Michael', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'On the Threshold of Winter (Opera)', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-06-20T16:00:04+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Vivien Schweitzer', 'person': [{'firstname': 'Vivien', 'middlename': None, 'lastname': 'Schweitzer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b410dbf6-d844-504b-afc2-f01cb72fc75b', 'word_count': 1521, 'uri': 'nyt://article/b410dbf6-d844-504b-afc2-f01cb72fc75b'}, {'abstract': 'Cast in its day as “the war to end all wars,” World War I has instead become the war to which all subsequent wars and much else in modern life seem to refer, consciously or not.', 'web_url': 'https://www.nytimes.com/2014/06/22/arts/the-enduring-impact-of-world-war-i.html', 'snippet': 'Cast in its day as “the war to end all wars,” World War I has instead become the war to which all subsequent wars and much else in modern life seem to refer, consciously or not.', 'lead_paragraph': '“I feel like a soldier on the morning after the Somme.” This line of dialogue, from an episode in the second season of the BBC series “Call the Midwife,” caught my ear recently as an especially piquant morsel of period detail. It is uttered by a doctor to a nurse after they have just assisted in a grueling home birth, an experience that is compared to the four-month battle in a muddy stretch of Picardy beginning on July 1, 1916, that was, at the time, the bloodiest episode of combat in human history, generating 60,000 casualties in a single day of fighting on the British side alone. The doctor’s comparison is surely metaphorical overkill, but it also represents a familiar style of wit, a habit of linking the challenges we regularly endure with calamities we can scarcely imagine.', 'print_section': 'AR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/22/arts/22CROSSCUTS1/22CROSSCUTS1-articleLarge.jpg', 'height': 713, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/22/arts/22CROSSCUTS1/22CROSSCUTS1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 713}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/22/arts/22CROSSCUTS1/22CROSSCUTS1-jumbo.jpg', 'height': 1024, 'width': 862, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/22/arts/22CROSSCUTS1/22CROSSCUTS1-superJumbo.jpg', 'height': 2048, 'width': 1723, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/22/arts/22CROSSCUTS1/22CROSSCUTS1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/22/arts/22CROSSCUTS1/22CROSSCUTS1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/22/arts/22CROSSCUTS1/22CROSSCUTS1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A War to End All Innocence', 'kicker': 'Cross Cuts', 'content_kicker': None, 'print_headline': 'A War to End All Innocence ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'World War I (1914-18)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Culture (Arts)', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-06-20T16:00:18+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'byline': {'original': 'By A.O. Scott', 'person': [{'firstname': 'A.', 'middlename': 'O.', 'lastname': 'Scott', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/35b599d1-d2fe-5987-adf7-88c8f701d2bf', 'word_count': 2060, 'uri': 'nyt://article/35b599d1-d2fe-5987-adf7-88c8f701d2bf'}, {'abstract': 'TL Ventures improperly accepted fees from two public pension funds after a senior employee of the firm made campaign contributions in Pennsylvania, the S.E.C. said.', 'web_url': 'https://dealbook.nytimes.com/2014/06/20/venture-capital-firm-settles-s-e-c-charges-over-pay-to-play/', 'snippet': 'TL Ventures improperly accepted fees from two public pension funds after a senior employee of the firm made campaign contributions in Pennsylvania, the S.E.C. said.', 'lead_paragraph': 'Updated, 1:35 p.m. | ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Venture Capital Firm Settles S.E.C. Charges Over ‘Pay-to-Play’', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Campaign Finance', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Securities and Commodities Violations', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Securities and Exchange Commission', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'TL Ventures', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-06-20T16:01:56+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By William Alden', 'person': [{'firstname': 'William', 'middlename': None, 'lastname': 'Alden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cd2c89db-8475-5c46-97b9-b8eadb8cc68d', 'word_count': 429, 'uri': 'nyt://article/cd2c89db-8475-5c46-97b9-b8eadb8cc68d'}, {'abstract': 'Insurers are moving toward tiered offerings, with rewards in the form of better or cheaper coverage for healthier behavior.', 'web_url': 'https://www.nytimes.com/2014/06/22/your-money/health-insurance-plans-offering-gated-coverage.html', 'snippet': 'Insurers are moving toward tiered offerings, with rewards in the form of better or cheaper coverage for healthier behavior.', 'lead_paragraph': 'To get an idea of what your employer’s health plan may look like in the near future, consider the options the government of Manatee County, Fla., offers to its workers.', 'print_section': 'B', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Jumping Through Hoops for a Better Health Plan', 'kicker': 'Your Money Adviser', 'content_kicker': None, 'print_headline': 'Jumping Through Hoops for a Better Health Plan', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Carrns, Ann', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Health Insurance and Managed Care', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-06-20T16:09:32+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Your Money', 'byline': {'original': 'By Ann Carrns', 'person': [{'firstname': 'Ann', 'middlename': None, 'lastname': 'Carrns', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cc190f89-ec5b-5c8c-9120-3f3dbec54599', 'word_count': 817, 'uri': 'nyt://article/cc190f89-ec5b-5c8c-9120-3f3dbec54599'}, {'abstract': 'When an estate is parceled out in unequal shares, family members can turn on one another and no one benefits except the lawyers.', 'web_url': 'https://www.nytimes.com/2014/06/21/your-money/unequal-inheritances-may-ignite-family-squabbles.html', 'snippet': 'When an estate is parceled out in unequal shares, family members can turn on one another and no one benefits except the lawyers.', 'lead_paragraph': 'KATE’S father died when she was in college, but she stayed close to his side of the family. Although she moved to North Carolina after graduation, she and her three siblings returned to New Jersey a couple of times a year to visit her grandmother, aunts and cousins. She called her grandmother frequently until dementia made it impossible for them to communicate.', 'print_section': 'B', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/21/business/21wealth/21wealth-articleLarge.jpg', 'height': 381, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/21/business/21