byline': {'original': 'By David Leonhardt', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Leonhardt', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d6768262-80ec-5c18-8cd2-eaf488fb279d', 'word_count': 200, 'uri': 'nyt://article/d6768262-80ec-5c18-8cd2-eaf488fb279d'}, {'abstract': 'Within an hour of its publication online on Friday, a New York Times Magazine story had more than 1,000 comments.', 'web_url': 'https://www.nytimes.com/times-insider/2014/06/25/boomerang-kids-article-prompts-a-rich-range-of-views/', 'snippet': 'Within an hour of its publication online on Friday, a New York Times Magazine story had more than 1,000 comments.', 'lead_paragraph': 'Within an hour of its publication online on Friday, a New York Times Magazine story about “boomerang kids” – young adults who move back in with their parents after graduating from college – was a hit. During that morning’s news meeting, Karron Skog, the day editor, and Ian Fisher, an assistant managing editor, said they would give the story more prominent promotion based on its web traffic and comment numbers. By 5 p.m. the story had drawn nearly 1,000 comments; by Sunday, when the piece ran in print, it had 1,657 comments.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/25/blogs/boomerang/boomerang-jumbo.jpg', 'height': 720, 'width': 592, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/25/blogs/boomerang/boomerang-superJumbo.jpg', 'height': 720, 'width': 592, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/25/blogs/boomerang/boomerang-th