title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/82b94fd8-0953-5bb9-80c7-c31ac8afb1ef', 'word_count': 504, 'uri': 'nyt://article/82b94fd8-0953-5bb9-80c7-c31ac8afb1ef'}, {'abstract': 'Black voters crossed party lines to help Senator Thad Cochran defeat a Tea Party candidate. He should return the favor by supporting a stronger Voting Rights Act.', 'web_url': 'https://www.nytimes.com/2014/06/26/opinion/thad-cochrans-debt-to-mississippi.html', 'snippet': 'Black voters crossed party lines to help Senator Thad Cochran defeat a Tea Party candidate. He should return the favor by supporting a stronger Voting Rights Act.', 'lead_paragraph': 'The prospect of electing an intemperate Tea Party candidate who was openly nostalgic for Confederate days was so repellent to many black voters in Mississippi that they did a remarkable thing on Tuesday, crossing party lines to help give the Republican Senate nomination to Thad Cochran, in office for 36 years. Now it’s time for Mr. Cochran to return the favor by supporting a stronger Voting Rights Act and actively working to reduce his party’s extreme antigovernment policies.', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Thad Cochran’s Debt to Mississippi', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Senator Cochran’s Debt to Mississippi', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Mississippi', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Cochran, Thad', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Blacks', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'McDaniel, Chris (1972- )', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': '