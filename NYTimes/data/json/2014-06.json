rts/03LONNY/03LONNY-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/03/arts/03LONNY/03LONNY-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Lurking Just Beneath This Surface ...', 'kicker': 'Watch List', 'content_kicker': None, 'print_headline': 'Lurking Just Beneath This Surface ...', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Web-Original Programming', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Anfanger, Alex', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'YouTube.com', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'Next Time on Lonny (Web-Original Program)', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-06-02T20:17:12+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Mike Hale', 'person': [{'firstname': 'Mike', 'middlename': None, 'lastname': 'Hale', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/867229b7-1a68-5c21-8a5e-37cc3c516862', 'word_count': 314, 'uri': 'nyt://article/867229b7-1a68-5c21-8a5e-37cc3c516862'}, {'abstract': 'The legendary lensman’s first monograph, “The Way We Were,” captures the nostalgia — and darkness — of Hollywood in the ’60s, ’70s and ’80s.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2014/06/02/julian-wasser-the-way-we-were-photographs-of-the-california-dream-and-its-underbelly/', 'snippet': 'The legendary lensman’s first monograph, “The Way We Were,” captures the nostalgia — and darkness — of Hollywood in the ’60s, ’70s and ’80s.', 'lead_paragraph': 'On the cover of “The Way We Were” (Damiani Books, $60) — the first monograph by the legendary lensman Julian Wasser — a vast cloud of smoke issues from Steve McQueen’s pursed lips. Coming from a veneer so tough — collar starched, eyes concealed behind dark glasses — it’s the single note of expression, the breath the only proof the man is man and not made of wax. Herein lies the unreal reality of Wasser’s California: in this exhalation is all the nostalgia of a dream once dreamed. And despite the misty-eyed title of his book capturing the heyday of L.A. celebrity and counterculture, “the fact is, everything you heard about living in Los Angeles in the early ’60s was really true,” the photographer says. “It was a golden age and a hopeful time.”', 'print_section': 'ST', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/02/t-magazine/02wasser-bengal-slide-G00O/02wasser-bengal-slide-G00O-articleLarge.jpg', 'height': 768, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/02/t-magazine/02wasser-bengal-slide-G00O/02wasser-bengal-slide-G00O-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 768}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/02/t-magazine/02wasser-bengal-slide-G00O/02wasser-bengal-slide-G00O-jumbo.jpg', 'height': 1024, 'width': 800, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/02/t-magazine/02wasser-bengal-slide-G00O/02wasser-bengal-slide-G00O-superJumbo.jpg', 'height': 2048, 'width': 1600, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/02/t-magazine/02wasser-bengal-slide-G00O/02wasser-bengal-slide-G00O-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType'