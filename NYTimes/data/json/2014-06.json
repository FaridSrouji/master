middlename': None, 'lastname': 'Bray', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d388a918-770e-5f1d-afc6-87647c9c9a60', 'word_count': 279, 'uri': 'nyt://article/d388a918-770e-5f1d-afc6-87647c9c9a60'}, {'abstract': 'Representative John D. Dingell and the actor James Earl Jones were awarded the honor for exemplifying the legacy of the nation’s 16th president.', 'web_url': 'https://www.nytimes.com/2014/06/24/us/john-dingell-and-james-earl-jones-awarded-lincoln-medal.html', 'snippet': 'Representative John D. Dingell and the actor James Earl Jones were awarded the honor for exemplifying the legacy of the nation’s 16th president.', 'lead_paragraph': 'WASHINGTON — Representative John D. Dingell started his career as a congressional page, shuttling mail from one legislator to another and watching Franklin D. Roosevelt give speeches from the House floor. On Sunday, Mr. Dingell, the longest serving congressman in United States history with nearly 60 years in the House, was awarded the Lincoln Medal for exemplifying the legacy of the nation’s 16th president.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Longtime Politician and Veteran Actor Receive Lincoln Medals', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Awards, Decorations and Honors', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': "Ford's Theater Society", 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Jones, James Earl', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-06-24T08:15:02+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Jada F. Smith', 'person': [{'firstname': 'Jada', 'middlename': 'F.', 'lastname': 'Smith', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2923e9a5-5c3e-5e79-abb8-31024c7a7a39', 'word_count': 524, 'uri': 'nyt://article/2923e9a5-5c3e-5e79-abb8-31024c7a7a39'}, {'abstract': 'How has Martin Luther King Addo helped the seniors in the Southbridge Towers community?', 'web_url': 'https://learning.blogs.nytimes.com/2014/06/24/6-qs-about-the-news-a-chiseled-bodybuilder-frail-clients-and-a-fitness-story-for-the-ages/', 'snippet': 'How has Martin Luther King Addo helped the seniors in the Southbridge Towers community?', 'lead_paragraph': 'In “A Chiseled Bodybuilder, Frail Clients and a Fitness Story for the Ages,” Louie Lazar writes about a former champion bodybuilder from Ghana who opened a small gym in an affordable housing development in Lower Manhattan.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '6 Q’s About the News | A Chiseled Bodybuilder, Frail Clients and a Fitness Story for the Ages', 'kicker': 'The Learning Network', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-06-24T08:30:24+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By Michael Gonchar', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Gonchar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7576a5ab-9ac3-56da-8648-17f6ab093108', 'word_count': 125, 'uri': 'nyt://article/7576a5ab-9ac3-56da-8648-17f6ab093108'}, {'abstract': 'Alex Webb and his wife, Rebecca Norris Webb, went to Rochester to document the fabled, if worn, home of Kodak. They returned to explore a city with a rich history and culture.', 'web_url': 'https://lens.blogs.nytimes.com/2014/06/24/in-kodak-alex-webb-rochester-rebecca-norris-webb-photos-memory/', 'snippet': 'Alex Webb and his wife, Rebecca Norris Webb, went to Rochester to document the fabled, if worn, home of Kodak. They returned to explore a city with a rich history and culture.', 'lead_paragraph': 'Alex Webb and Rebecca Norris Webb, a husband and wife photography team, documented Rochester after Eastman Kodak’s bankruptcy in their new book, “Memory City,”\xa0published by\xa0Radius Books. Previously they published “Violet Isle,” a volume on modern-day Cuba. Ms. Norris Webb’s book “My Dakota” was featured on Lens in \xa02012, while Mr. Webb’s book “The Suffering of Light” was featured on Lens in 2011. He is a member of Magnum Photos. Their conversation with James Estrin has been edited.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/23/blogs/20140623-lens-webb-slide-YH6Z/20140623-lens-webb-slide-YH6Z-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/23/blogs/20140623-lens-webb-slide-YH6Z/20140623-lens-webb-slide-YH6Z-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/23/blogs/20140623-lens-webb-slide-YH6Z/20140623-lens-webb-slide-YH6Z-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/23/blogs/20140623-lens-webb-slide-YH6Z/20140623-lens-webb-slide-YH6Z-superJumbo.jpg', 'height': 997, 'width': 1500, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/23/blogs/20140623-lens-webb-slide-YH6Z/20140623-lens-webb-slide-YH6Z-thumbStandard.jpg', 'height': 75, 