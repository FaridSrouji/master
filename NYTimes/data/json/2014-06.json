ight': 1359, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/27/world/JUNCKER/JUNCKER-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/27/world/JUNCKER/JUNCKER-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/27/world/JUNCKER/JUNCKER-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In the Eye of a European Political Storm Stands a Quiet Enigma', 'kicker': None, 'content_kicker': None, 'print_headline': 'In the Eye of a European Political Storm Stands a Quiet Enigma', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Kanter, James', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Juncker, Jean-Claude', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Cameron, David', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'European Sovereign Debt Crisis (2010- )', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Merkel, Angela', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'European Union', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'European Commission', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Luxembourg', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Belgium', 'rank': 9, 'major': 'N'}], 'pub_date': '2014-06-27T01:41:36+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By James Kanter', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': 'Kanter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f22a9ee9-b98e-5102-bf85-d80f494f1d8c', 'word_count': 1061, 'uri': 'nyt://article/f22a9ee9-b98e-5102-bf85-d80f494f1d8c'}, {'abstract': 'Not since 1940 have the justices agreed so often.', 'web_url': 'https://www.nytimes.com/2014/06/27/opinion/the-supreme-courts-powerful-new-consensus.html', 'snippet': 'Not since 1940 have the justices agreed so often.', 'lead_paragraph': 'WASHINGTON — FOR years, particularly after the 2000 election, talk about the Supreme Court has centered on its bitter 5-to-4 divisions. Yet it is worth reflecting on a remarkable achievement: The court has agreed unanimously in more than 66 percent of its cases this term (and that figure holds even if Monday’s remaining two cases, on the Affordable Care Act’s contraceptive coverage and on public-sector unions, are not unanimous). The last year this happened was 1940.', 'print_section': 'A', 'print_page': '29', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Supreme Court’s Powerful New Consensus', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'The Court’s Powerful New Consensus', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Supreme Court (US)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Katyal, Neal K', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Roberts, John G Jr', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Decisions and Verdicts', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-06-27T01:44:31+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Neal K. Katyal', 'person': [{'firstname': 'Neal', 'middlename': 'K.', 'lastname': 'Katyal', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/d8489cf9-6635-53a