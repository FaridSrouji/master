title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b0c6d235-5411-5709-81b1-c56557d5cba3', 'word_count': 851, 'uri': 'nyt://article/b0c6d235-5411-5709-81b1-c56557d5cba3'}, {'abstract': 'A simmering political scandal took a dramatic turn when a judge forced Vice President Amado Boudou to appear in a Buenos Aires court to answer questions.', 'web_url': 'https://www.nytimes.com/2014/06/10/world/americas/argentina-vice-president-in-court-for-questioning-in-corruption-case.html', 'snippet': 'A simmering political scandal took a dramatic turn when a judge forced Vice President Amado Boudou to appear in a Buenos Aires court to answer questions.', 'lead_paragraph': 'A simmering political scandal took a dramatic turn on Monday when a judge forced Vice President Amado Boudou to appear in a Buenos Aires court to answer questions about whether he had used his influence as economy minister to take ownership of a company that printed the nation’s currency. Mr. Boudou, 51, is accused of using a frontman to purchase shares in the printing company, which was awarded a government contract and later nationalized. He has denied the allegations and has accused news organizations of conspiring against him. The judge, Ariel Lijo, rejected Mr. Boudou’s call for the session to be broadcast live on television. The judge is expected to announce his decision later this month on whether to file criminal charges against Mr. Boudou. ', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Argentina: Vice President in Court for Questioning in Corruption Case', 'kicker': 'World Briefing', 'content_kicker': None, 'print_headline': 'Argentina: Vice President in Court for Questioning in Corruption Case', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'ARGENTINA', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Boudou, Amado', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-06-10T00:48:31+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Americas', 'byline': {'original': 'By Jonathan Gilbert', 'person': [{'firstname': 'Jonathan', 'middlename': None, 'lastname': 'Gilbert', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/64e6b0b7-679b-5cb6-8596-08adcf15d709', 'word_count': 125, 'uri': 'nyt://article/64e6b0b7-679b-5cb6-8596-08adcf15d709'}, {'abstract': 'Time Warner and Vice Media are said to be in negotiations that could lead to a $1 billion deal and give Vice a television network.', 'web_url': 'https://www.nytimes.com/2014/06/10/business/media/time-warner-said-to-seek-big-stake-in-vice-media.html', 'snippet': 'Time Warner and Vice Media are said to be in negotiations that could lead to a $1 billion deal and give Vice a television network.', 'lead_paragraph': 'Time Warner is in talks to buy a large stake in Vice Media for as much as $1 billion, a deal that could include providing Vice with the television network HLN, people with knowledge of the negotiations said on Monday.', 'print_section': 'B', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Time Warner Said to Seek a Big Stake in Vice Media', 'kicker': None, 'content_kicker': None, 'print_headline': 'Time Warner Said to Seek a Big Stake in Vice Media', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Mergers, Acquisitions and Divestitures', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Vice Media Inc', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Time Warner Inc', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-06-10T00:49:23+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {