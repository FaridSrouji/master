y': {'xlarge': 'images/2014/06/24/science/26recipehealth/26recipehealth-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/24/science/26recipehealth/26recipehealth-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/24/science/26recipehealth/26recipehealth-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/24/science/26recipehealth/26recipehealth-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/24/science/26recipehealth/26recipehealth-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/24/science/26recipehealth/26recipehealth-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Green Bean Salad With Lime Vinaigrette and Red Quinoa', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Diet and Nutrition', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Salads', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Quinoa', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Vegetables', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-06-24T06:21:44+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Health', 'byline': {'original': 'By Martha Rose Shulman', 'person': [{'firstname': 'Martha', 'middlename': 'Rose', 'lastname': 'Shulman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'recipe', '_id': 'nyt://article/ea0b5f5b-1536-58de-85c9-b5ad7412ea77', 'word_count': 344, 'uri': 'nyt://article/ea0b5f5b-1536-58de-85c9-b5ad7412ea77'}, {'abstract': 'Red quinoa adds color and substance to a typically Mediterranean mix of yogurt and finely diced cucumber.', 'web_url': 'https://www.nytimes.com/2014/06/27/health/mediterranean-cucumber-and-yogurt-salad-with-red-or-black-quinoa.html', 'snippet': 'Red quinoa adds color and substance to a typically Mediterranean mix of yogurt and finely diced cucumber.', 'lead_paragraph': 'The idea of embellishing a yogurt soup or salad with quinoa comes from Deborah Madison, who uses black quinoa in a brilliant recipe for a soup in her book “Vegetable Literacy.” I used red quinoa to add texture, color and substance to this typical Mediterranean combination – finely diced cucumber, garlic, and thick plain yogurt. Use mint or dill, or a combination, and make sure to dice the cucumber very small.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/24/science/27recipehealth/27recipehealth-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/24/science/27recipehealth/27recipehealth-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/24/science/27recipehealth/27recipehealth-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/24/science/27recipehea