: None}, 'type_of_material': 'News', '_id': 'nyt://article/d344f051-c32b-589f-8d19-bafffe6cd010', 'word_count': 3768, 'uri': 'nyt://article/d344f051-c32b-589f-8d19-bafffe6cd010'}, {'abstract': 'The Financial Industry Regulatory Authority ordered Merrill Lynch to pay a fine and restitution for overcharging about 41,000 small businesses and 6,800 charities over upfront sales fees on certain mutual funds.', 'web_url': 'https://dealbook.nytimes.com/2014/06/16/merrill-lynch-to-pay-more-than-32-million-for-overcharging-clients/', 'snippet': 'The Financial Industry Regulatory Authority ordered Merrill Lynch to pay a fine and restitution for overcharging about 41,000 small businesses and 6,800 charities over upfront sales fees on certain mutual funds.', 'lead_paragraph': 'The Financial Industry Regulatory Authority has ordered Merrill Lynch to pay more than $32 million over sales fees it charged on certain mutual funds.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Merrill Lynch to Pay More than $32 Million for Overcharging Clients', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fines (Penalties)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mutual Funds', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Bank of America Corporation', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Financial Industry Regulatory Authority', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Merrill Lynch & Co', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-06-16T19:58:21+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Rachel Abrams', 'person': [{'firstname': 'Rachel', 'middlename': None, 'lastname': 'Abrams', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d37c7f1a-7700-594d-81c7-e2fd3b64970a', 'word_count': 401, 'uri': 'nyt://article/d37c7f1a-7700-594d-81c7-e2fd3b64970a'}, {'abstract': 'The vice president said he hoped to “rebuild trust” with President Dilma Rousseff, who was angered by reports that the N.S.A. had spied on her.', 'web_url': 'https://www.nytimes.com/2014/06/17/world/americas/for-biden-in-brazil-world-cup-and-diplomacy.html', 'snippet': 'The vice president said he hoped to “rebuild trust” with President Dilma Rousseff, who was angered by reports that the N.S.A. had spied on her.', 'lead_paragraph': 'RIO DE JANEIRO — Seeking an opening during the World Cup soccer tournament to thaw relations with Brazil, Vice President Joseph R. Biden Jr. arrived in Latin America’s largest country on Monday, expressing a desire to “rebuild trust” after the souring of ties over revelations of the National Security Agency’s surveillance practices.', 'print_section': 'A', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Diplomacy and Soccer for Biden in Brazil', 'kicker': None, 'content_kicker': None, 'print_headline': 'Diplomacy and Soccer for Biden in Brazil', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'World Cup 2014 (Soccer)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Romero, Simon', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States International Relations', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Espionage and Intelligence Services', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Biden, Joseph R Jr', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Rousseff, Dilma', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Brazil', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'National Security Agency', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Soccer', 'rank': 9, 'major': 'N'}], 'pub_date': '2014-06-16T20:00:33+0000',