on': [{'firstname': 'Diane', 'middlename': None, 'lastname': 'Cardwell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6bc84096-dca6-5a6f-9f55-9aac56d2a8e7', 'word_count': 498, 'uri': 'nyt://article/6bc84096-dca6-5a6f-9f55-9aac56d2a8e7'}, {'abstract': 'The playwrights David Henry Hwang and Lynn Nottage are joining the faculty of Columbia University’s School of the Arts.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2014/06/17/david-henry-hwang-and-lynn-nottage-joining-columbia-playwriting-faculty/', 'snippet': 'The playwrights David Henry Hwang and Lynn Nottage are joining the faculty of Columbia University’s School of the Arts.', 'lead_paragraph': 'The playwrights David Henry Hwang and Lynn Nottage will join the faculty of Columbia University’s School of the Arts, the school’s dean, Carol Becker, has announced, thus raising the profile of an M.F.A. program in playwriting that has existed since 1965 but in recent years has had only two professional playwrights, Charles L. Mee and Kelly Stuart, on its full-time faculty.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'David Henry Hwang and Lynn Nottage Joining Columbia Playwriting Faculty', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'Two Playwrights Join Columbia', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Writing and Writers', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Hwang, David Henry', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Nottage, Lynn', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Columbia University', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-06-17T20:33:24+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Jennifer Schuessler', 'person': [{'firstname': 'Jennifer', 'middlename': None, 'lastname': 'Schuessler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5d98983d-e13f-5c0b-83d8-57ac82b0832d', 'word_count': 228, 'uri': 'nyt://article/5d98983d-e13f-5c0b-83d8-57ac82b0832d'}, {'abstract': 'Egg, butter and American cheese take Roy Choi’s ramen to the next level.', 'web_url': 'https://www.nytimes.com/2014/06/18/dining/ramen-a-quick-fix-for-the-soul.html', 'snippet': 'Egg, butter and American cheese take Roy Choi’s ramen to the next level.', 'lead_paragraph': 'It tells you something about the philosophy of Roy Choi that one of the recipes in his 2013 book, “L.A. Son,” doesn’t seem at first glance like a recipe at all. You make some instant ramen. Slide an egg into the hot broth, then some butter.', 'print_section': 'D', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/18/dining/18JPCHOI9/18JPCHOI9-articleLarge-v3.jpg', 'height': 621, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/18/dining/18JPCHOI9/18JPCHOI9-articleLarge-v3.jpg', 'xlargewidth': 600, 'xlargeheight': 621}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/18/dining/18JPCHOI9/18JPCHOI9-jumbo-v3.jpg', 'height': 1024, 'width': 990, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/18/dining/18JPCHOI9/18JPCHOI9-superJumbo-v3.jpg', 'height': 2048, 'width': 1980, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/18/dining/1