TS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 550}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/15/business/15-BITS/15-BITS-jumbo.jpg', 'height': 938, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/15/business/15-BITS/15-BITS-superJumbo.jpg', 'height': 1794, 'width': 1958, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/15/business/15-BITS/15-BITS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/15/business/15-BITS/15-BITS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/15/business/15-BITS/15-BITS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Why That Phone Charger Took Two Years to Arrive', 'kicker': 'Bits', 'content_kicker': None, 'print_headline': 'Why That Phone Charger Took Two Years to Arrive', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'iPhone', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Start-ups', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Kickstarter', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-06-14T13:00:48+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'byline': {'original': 'By Jenna Wortham', 'person': [{'firstname': 'Jenna', 'middlename': None, 'lastname': 'Wortham', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cabcfd17-29e3-5595-91ab-b9a053907906', 'word_count': 1054, 'uri': 'nyt://article/cabcfd17-29e3-5595-91ab-b9a053907906'}, {'abstract': 'And Ahmed Chalabi is George Washington.', 'web_url': 'https://krugman.blogs.nytimes.com/2014/06/14/we-will-be-welcomed-as-liberators/', 'snippet': 'And Ahmed Chalabi is George Washington.', 'lead_paragraph': 'I’ve often noted that to a first approximation, nobody ever admits having been wrong about anything. My usual prime example is all the people who issued dire warnings five years ago that runaway inflation was imminent — and are issuing identical warnings to this day. But all of that is nothing as compared with the way the same people who assured us that the invasion of Iraq would be a splendid little war — remember “Everyone wants to go to Baghdad, real mean want to go to Tehran”? — are now insisting that we should go all in on behalf of a corrupt, incompetent regime that is basically Iran’s ally, not ours.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'We Will Be Welcomed As Liberators', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-06-14T13:12:36+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/827c8f0b-159b-5faa-b74b-bdb17b2915e6', 'word_count': 112, 'uri': 'nyt://article/827c8f0b-159b-5faa-b74b-bdb17b2915e6'}, {'abstract': 'Hollie Bonneville Barden, head designer at De Beers Diamond Jewelers, draws inspiration from a wall full of images in her London office.', 'web_url': 'https://www.nytimes.com/2014/06/15/business/workspace-at-de-beers-collecting-images-and-inspiratio