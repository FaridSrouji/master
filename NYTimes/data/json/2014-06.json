 Franz Kline).', 'print_section': 'C', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/20/arts/20CALLIGRAPHY1/CALLIGRAPHY1-articleLarge.jpg', 'height': 215, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/20/arts/20CALLIGRAPHY1/CALLIGRAPHY1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 215}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/20/arts/20CALLIGRAPHY1/CALLIGRAPHY1-jumbo.jpg', 'height': 367, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/20/arts/20CALLIGRAPHY1/CALLIGRAPHY1-superJumbo.jpg', 'height': 733, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/20/arts/20CALLIGRAPHY1/CALLIGRAPHY1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/20/arts/20CALLIGRAPHY1/CALLIGRAPHY1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/20/arts/20CALLIGRAPHY1/CALLIGRAPHY1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Calligraphic Answer to ‘I Like This’', 'kicker': 'Art Review', 'content_kicker': None, 'print_headline': 'A Calligraphic Answer to ‘I Like This’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Rosenberg, Karen', 'rank': 2, 'major': 'N'}, {'name':