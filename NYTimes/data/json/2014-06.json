erson': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Seibert', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/8041853c-4744-5368-80ac-fa2bd7a7439b', 'word_count': 459, 'uri': 'nyt://article/8041853c-4744-5368-80ac-fa2bd7a7439b'}, {'abstract': 'Lleyton Hewitt forced the 6-foot-8 Jerzy Janowicz out of his rhythm but ultimately lost in five sets in a match that consumed 3 hours 47 minutes over two days.', 'web_url': 'https://www.nytimes.com/2014/06/28/sports/tennis/hewitt-fails-in-bid-for-wimbledon-upset-against-janowicz.html', 'snippet': 'Lleyton Hewitt forced the 6-foot-8 Jerzy Janowicz out of his rhythm but ultimately lost in five sets in a match that consumed 3 hours 47 minutes over two days.', 'lead_paragraph': 'WIMBLEDON, England — It is often said that professional tennis does not have competitive contrast. Those objecting to that state of affairs should have appreciated Lleyton Hewitt’s attempt Friday afternoon to cut the goliath known as Jerzy Janowicz down to size, inch by tormented inch.', 'print_section': 'D', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/28/sports/28tennis1/28tennis1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/28/sports/28tennis1/28tennis1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/28/sports/28tennis1/28tennis1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/28/sports/28tennis1/28tennis1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/28/sports/28tennis1/28tennis1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/28/sports/28tennis1/28tennis1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/28/sports/28tennis1/28tennis1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Hewitt Grinds Back From Two Sets Down, but His Upset Bid Fails ', 'kicker': None, 'content_kicker': None, 'print_headline': 'Hewitt Grinds Back From Two Sets Down, but His Upset Bid Fails', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Wimbledon Tennis Tournament', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Tennis', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Hewitt, Lleyton', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Janowicz, Jerzy', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Djokovic, Novak', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Murray, Andy (1987- )', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-06-27T22:28:58+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By Harvey Araton', 'person': [{'firstname': 'Harvey', 'middlename': None, 'lastname': 'Araton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d04684c9-7f88-5874-99b1-de1bd980b4c3', 'word_count': 999, 'uri': 'nyt://article/d04684c9-7f88-5874-99b1-de1bd980b4c3'}, {'abstract': 'Billie Jean King and Jason Collins share a bond as gay athletes who hope to pave a path for those who follow.', 'web_url': 'https://www.nytimes.com/2014/06/29/fashion/billie-jean-king-and-jason-collins-on-being-gay-athletes.html', 'snippet': 'Billie Jean King and Jason Collins share a bond as gay athletes who hope to pave a path for those who follow.', 'lead_paragraph': 'Billie Jean King loves to connect.\xa0 The 70-year-old tennis legend — winner of 39 Grand Slam titles, the Presidential Medal of Freedom and, most famously, the “Battle of the Sexes” match against Bobby Riggs in 1973 — peppers questions like forehand volleys.\xa0 Within three minutes of walking into Boulud Sud, near Lincoln Center, Ms. King had learned that the restaurant manager’s mother rowed crew for Syracuse University; asked her interviewer’s partner’s name (and tossed it off casually through the afternoon); and compared notes on the French Open with the waiter.', 'print_section': 'ST', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/29/fashion/29TABLE-copy/29TABLE-articleLarge.jpg', 'height': 404, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/29/fashion/29TABLE-copy/29TABLE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 404}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/29/fashion/29TABLE-copy/29TABLE-jumbo.jpg', 'height': 689, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/29/fashion/29TABLE-copy/29TABLE-superJumbo.jpg', 'height': 1378, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/2