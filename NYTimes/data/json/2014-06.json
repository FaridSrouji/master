'_id': 'nyt://article/7f58bc40-24d5-5096-8536-0d887e7eb0b5', 'word_count': 1199, 'uri': 'nyt://article/7f58bc40-24d5-5096-8536-0d887e7eb0b5'}, {'abstract': 'Advisers and better intelligence could improve United States air power in an effort to assist the Nuri Kamal al-Maliki government.', 'web_url': 'https://www.nytimes.com/2014/06/14/us/politics/us-airstrikes-could-help-in-reversing-insurgent-offensive-experts-say.html', 'snippet': 'Advisers and better intelligence could improve United States air power in an effort to assist the Nuri Kamal al-Maliki government.', 'lead_paragraph': 'WASHINGTON — American air power could play an important role in reversing the Sunni insurgent offensive in Iraq, current and former American military officials said on Friday, but it would be most effective with improved intelligence about insurgent targets and if the United States were willing to deploy small teams of advisers to call in airstrikes.', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'U.S. Airstrikes Could Help in Reversing Insurgent Offensive, Experts Say', 'kicker': 'Military Analysis', 'content_kicker': None, 'print_headline': 'U.S. Airstrikes Could Help in Reversing Insurgent Offensive, Experts Say', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Gordon, Michael R', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Drones (Pilotless Planes)', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Islamic State in Iraq and Syria (ISIS)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Sunni Muslims', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Iraq', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 9, 'major': 'N'}], 'pub_date': '2014-06-14T04:27:07+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Michael R. Gordon and Helene Cooper', 'person': [{'firstname': 'Michael', 'middlename': 'R.', 'lastname': 'Gordon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Helene', 'middlename': None, 'lastname': 'Cooper', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'Military Analysis', '_id': 'nyt://article/a41b2568-b78d-5417-b721-29305f151571', 'word_count': 1031, 'uri': 'nyt://article/a41b2568-b78d-5417-b721-29305f151571'}, {'abstract': 'The Los Angeles Kings won their second Stanley Cup in three years with a four games to one series win over the Rangers.', 'web_url': 'https://www.nytimes.com/2014/06/14/sports/hockey/kings-beat-rangers-to-win-stanley-cup.html', 'snippet': 'The Los Angeles Kings won their second Stanley Cup in three years with a four games to one series win over the Rangers.', 'lead_paragraph': 'LOS ANGELES — Bad omens stared at Henrik Lundqvist at the start of Game 5 of the Stanley Cup finals. It was the 666th game of his Rangers career. A full moon — the first on Friday the 13th since 2000 — hung over Staples Center.', 'print_section': 'D', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/14/sports/14rangers13/14rangers13-articleLarge.jpg', 'height': 403, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/14/sports/14rangers13/14rangers13-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 403}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/14/sports/14rangers13/14rangers13-jumbo.jpg', 'height': 688, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/14/sports/14rangers13/14rangers13-superJumbo.jpg', 'height': 1376, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/14/sports/14rangers13/14rangers13-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/14/sports/14rangers13/14rangers13-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/14/sports/14rangers13/14rangers13-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Kings Beat Rangers for Cup, Ending Short Series of Long Games', 'kicker': 'Kings 3, Rangers 2, Double Overtime', 'content_kicker': None, 'print_headline': 'Kings Beat Rangers for Cup, Ending Short Series of Long Games', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Hockey, Ice', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Klein, Jeff Z', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Stanley Cup', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Los Angeles Kings', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Rangers', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-06-14T04:27:31+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Hockey', 'byline': {'original': 'By Jeff Z. Klein', 'person': [{'firstname': 'Jeff', 'middlename': 'Z.', 'lastname': 'Klein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ff3e3a8f-89cc-56b7-963c-97c8cdf5fab3', 'word_count': 910, 'uri': 'nyt://article/ff3e3a8f-89cc-56b7-963c-97c8cdf5fab3'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2014/06/14/arts/television/whats-on-saturday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '8 P.M. (HBO) THE CONJURING (2013) Patrick Wilson and Vera Farmiga, above, play Ed and Lorraine Warren, the real-life paranormal investigators who declared an infamous Dutch colonial-style house on Long Island haunted, leading to more than a dozen “Amityville” movies. Their target this time is a Rhode Island farmhouse, where the blissful dreams of Carolyn and Roger Perron (Lili Tayor and Ron Livingston) and their five daughters become a moaning, creaking nightmare when they find themselves playing cat-and-mouse with an evil force. The director, James Wan, “smartly keeps enough distance from the Warrens that you can see that these true believers are also hovering at the edge of dangerous fanaticism,” Manohla Dargis wrote in The New York Times. “That gives the movie a shiver of political currency, even if a greater, more sustaining pleasure of this particular haunted-house fantasy is how it works as a metaphor for moviegoing itself. When the Perrons first settle into their house, they’re facing the future with bright, anxious smiles that aren’t much different from those of the horror-film faithful who are waiting nervously, hopefully, to be jolted by the next great shocker. It’s here.” ', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s on Saturday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On Saturday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-06-14T05:00:03+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/01b3ac9b-31d1-5d99-9ff5-a1b29c279620', 'word_count': 735, 'uri': 'nyt://article/01b3ac9b-31d1-5d99-9ff5-a1b29c279620'}, {'abstract': 'The Kings rallied in the third period to force overtime and scored in the second extra period to beat the Rangers in Game 5 and win the Stanley Cup.', 'web_url': 'https://www.nytimes.com/slideshow/2014/06/13/sports/hockey/RANGERS-LA-KINGS.html', 'snippet': 'The Kings rallied in the third period to force overtime and scored in the second extra period to beat the Rangers in Game 5 and win the Stanley Cup.', 'lead_paragraph': 'The Kings rallied in the third period to force overtime and scored in the second extra period to beat the Rangers in Game 5 and win the Stanley Cup.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/13/sports/hockey/RANGERS-LA-KINGS-slide-JPIO/RANGERS-LA-KINGS-slide-JPIO-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/13/sports/hockey/RANGERS-LA-KINGS-slide-JPIO/RANGERS-LA-KINGS-slide-JPIO-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/13/sports/hockey/RANGERS-LA-KINGS-slide-JPIO/RANGERS-LA-KINGS-slide-JPIO-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/13/sports/hockey/RANGERS-LA-KINGS-slide-JPIO/RANGERS-LA-KINGS-slide-JPIO-superJumbo.jpg', 'height': 1363, 'width': 2048, 'subType': 'superJumbo',