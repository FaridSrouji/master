nion/0609OPEDmuradyan/0609OPEDmuradyan-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/09/opinion/0609OPEDmuradyan/0609OPEDmuradyan-superJumbo.jpg', 'height': 1800, 'width': 1800, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/09/opinion/0609OPEDmuradyan/0609OPEDmuradyan-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/09/opinion/0609OPEDmuradyan/0609OPEDmuradyan-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/09/opinion/0609OPEDmuradyan/0609OPEDmuradyan-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Peaceful Nonreconciliation Now', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'Peaceful Nonreconciliation Now', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Dayan, Dani', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Palestinians', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Israel', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'West Bank', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Palestinian Authority', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'International Relations', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-06-09T00:27:12+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Dani Dayan', 'person': [{'firstname': 'Dani', 'middlename': None, 'lastname': 'Dayan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/5bff7fb0-3da8-55c5-8a87-5fee9a7e21b7', 'word_count': 852, 'uri': 'nyt://article/5bff7fb0-3da8-55c5-8a87-5fee9a7e21b7'}, {'abstract': 'There are still too many gaps and quirks in the health care reform law that could prevent the most vulnerable groups from getting insurance.', 'web_url': 'https://www.nytimes.com/2014/06/09/opinion/shifts-in-charity-health-care.html', 'snippet': 'There are still too many gaps and quirks in the health care reform law that could prevent the most vulnerable groups from getting insurance.', 'lead_paragraph': 'Health care reform was supposed to relieve the financial strain on hospitals that have provided a lot of free charity care to poor and uninsured patients. The reform law, known as the Affordable Care Act, was expected to insure most of those patients either through expanded state Medicaid programs for the poor or through subsidized private insurance for middle-income patients, thereby funneling new revenues to hospitals that had previously absorbed the costs of uncompensated care.', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Shifts in Charity Health Care', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Shifts in Charity Health Care', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Health Insurance and Managed Care', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Patient Protection and Affordable Care Act (2010)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Medicaid', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Philanthropy', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Hospitals', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-06-09T00:34:54+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/79848717-2bae-54c8-a70e-c4c0d43f3ec9', 'word_count': 523, 'uri': 'nyt://article/79848717-2bae-54c8-a70e-c4c0d43f3ec9'}, {'abstract': 'The house at 18 West 11th Street has had its share of famous owners and, in 1970, was the site of an accidental bombing by the Weatherman group.', 'web_url': 'https://www.nytimes.com/2014/06/09/nyregion/new-life-for-greenwich-village-site-of-weatherman-bombing.html', 'snippet': 'The house at 18 West 11th Street has had its share of famous owners and, in 1970, was the site of an accidental bombing by the Weatherman group.', 'lead_paragraph': 'The house at 18 West 11th Street is one of Greenwich Village’s most famous. It has been a home to literary and Broadway royalty, the site of a deadly accidental bombing by Weatherman radicals and, once rebuilt, a sweet neighborhood fixture with a stuffed Paddington Bear wearing seasonal outfits in its angled picture window.', 'print_section': 'A', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/09/nyregion/09HOUSE1/09HOUSE1-articleLarge.jpg', 'height': 896, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/09/nyregion/09HOUSE1/09HOUSE1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 896}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/09/nyregion/09HOUSE1/09HOUSE1-jumbo.jpg', 'height': 1024, 'width': 686, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/09/nyregion/09HOUSE1/09HOUSE1-superJumbo.jpg', 'height': 2048, 'width': 1372, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/09/nyregion/09HOUSE1/09HOUSE1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/09/nyregion/09HOUSE1/09HOUSE1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/09/nyregion/09HOUSE1/09HOUSE1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Reconstruction Planned for Infamous Townhouse in Greenwich Village', 'kicker': None, 'content_kicker': None, 'print_headline': 'Infamous Village Townhouse Is to Be Modified', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Blumenthal, Ralph', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Historic Buildings and Sites', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Weather Underground', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Wilkerson, James', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Weathermen', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Greenwich Village (Manhattan, NY)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'ARCHITECTURE', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Korsant, Justin', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 10, 'major': 'N'}], 'pub_date': '2014-06-09T00:38:27+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Ralph Blumenthal', 'person': [{'firstname': 'Ralph', 'middlename': None, 'lastname': 'Blumenthal', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/10a749a8-7084-5606-ac98-b1c6a57d28ab', 'word_count': 976, 'uri': 'nyt://article/10a749a8-7084-5606-ac98-b1c6a57d28ab'}, {'abstract': 'Americans who work for tips have not received a raise in 20 years. Congress should give it to them.', 'web_url': 'https://www.nytimes.com/2014/06/09/opinion/tipped-into-poverty.html', 'snippet': 'Americans who work for tips have not received a raise in 20 years. Congress should give it to them.', 'lead_paragraph': 'When Senate Republicans recently blocked a vote to raise the federal minimum wage, they snubbed the estimated 27.8 million people who would earn more if the measure became law. The hardest hit are the roughly 3.3 million Americans who work for tips, nearly three out of four of whom are women. Workers in predominantly tipped jobs — including restaurant servers, bartenders, hairstylists — are twice as likely as other workers to live below the poverty line. They need a raise, and Congress should give it to them.', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Tipped Into Poverty', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Tipped Into Poverty', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Minimum Wage', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Wages and Salaries', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Waiters and Waitresses', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Tips and Tipping', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Suits and Litigation (Civil)', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 9, 'major': 'N'}], 'pub_date': '2014-06-09T00:40:01+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/58763648-ba9f-5d5b-ad7f-8ddf692c8aaa', 'word_count': 409, 'uri': 'nyt://article/58763648-ba9f-5d5b-ad7f-8ddf692c8aaa'}, {'abstract': 'The Justice Department’s recent settlement with Ohio, which will eventually end solitary confinement there, puts all states on notice.', 'web_url': 'https://www.nytimes.com/2014/06/09/opinion/a-model-for-juvenile-detention-reform.html', 'snippet': 'The Justice Department’s recent settlement with Ohio, which will eventually end solitary confinement there, puts all states on notice.', 'lead_paragraph': 'States are sending fewer and fewer children to juvenile correctional facilities, partly in response to research showing that locking up young people increases the risk that they will eventually drop out of school and become permanently entangled with the justice system. ', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Model for Juvenile Detention Reform', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'A Model for Juvenile Detention Reform', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Solitary Confinement', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Children and Childhood', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Mental Health and Disorders', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Suicides and Suicide Attempts', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Justice Department', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Ohio', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Juvenile Delinquency', 'rank': 8, 'major': 'N'}], 'pub_date': '2014-06-09T00:42:59+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/46b019b9-5a67-573f-b753-71eb1c93b47d', 'word_count': 324, 'uri': 'nyt://article/46b019b9-5a67-573f-b753-71eb1c93b47d'}, {'abstract': 'The owner and trainer of Tonalist, the Belmont Stakes winner, understood why Steve Coburn, a co-owner of California Chrome, was upset, but the reality was that they put their horse first.', 'web_url': 'https://www.nytimes.com/2014/06/09/sports/a-triple-crown-tradition-prevails-at-belmont-stakes-despite-sour-grapes.html', 'snippet': 'The owner and trainer of Tonalist, the Belmont Stakes winner, understood why Steve Coburn, a co-owner of California Chrome, was upset, but the reality was that they put their horse first.', 'lead_paragraph': 'California Chrome’s co-owner Steve Coburn was upset, and so were the multitudes who had their hearts set Saturday on a victory by the colt in the 146th running of the Belmont Stakes and the first Triple Crown in 36 years. But, like all of us who at one time or another need to heed the guiding, loving hand of a spouse, the voluble cowboy should have listened to his wife, Carolyn, and just zipped it when the cameras were in his face. ', 'print_section': 'D', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/09/sports/BELMONT/BELMONT-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/09/sports/BELMONT/BELMONT-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'sub