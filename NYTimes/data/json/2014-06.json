 around for a new home, a church was not their first choice. But then they counted the blessings.', 'lead_paragraph': 'When Ronald Olthof and his partner, Sofie Suiker, decided to buy a home, their first instinct was to find an old building they could renovate. An abandoned industrial space, maybe. ', 'print_section': 'D', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'And There Was Light', 'kicker': 'On Location: Haarlo, the Netherlands', 'content_kicker': None, 'print_headline': 'And There Was Light', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Amies, Nick', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Churches (Buildings)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Restoration and Renovation', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'AMSTERDAM (NETHERLANDS)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'ARCHITECTURE', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Interior Design and Furnishings', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-06-04T22:45:22+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Great Homes & Destinations', 'byline': {'original': 'By Nick Amies', 'person': [{'firstname': 'Nick', 'middlename': None, 'lastname': 'Amies', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b1a4d37f-096e-5009-8ec8-0209b4846d2c', 'word_count': 618, 'uri': 'nyt://article/b1a4d37f-096e-5009-8ec8-0209b4846d2c'}, {'abstract': 'An engineer with a detective’s eye ferrets out the story of his midcentury cottage in Maine.', 'web_url': 'https://www.nytimes.com/2014/06/05/garden/coaxing-a-history-from-board-and-beam.html', 'snippet': 'An engineer with a detective’s eye ferrets out the story of his midcentury cottage in Maine.', 'lead_paragraph': 'ARROWSIC, Me. — The flourish that most delights Henry Petroski about his handmade house here is the way its builder “eased” the edges of the boards that form the cabinets, lintels, doors and door bracings. These subtle details were among the clues that set Mr. Petroski on a quest to learn about the man who employed them. ', 'print_section': 'D', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/garden/05HENRY/05HENRY-articleLarge.jpg', 'height': 847, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/05/garden/05HENRY/05HENRY-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 847}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/garden/05HENRY/05HENRY-jumbo.jpg', 'height': 1024, 'width': 726, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/garden/05HENRY/05HENRY-superJumbo.jpg', 'height': 2048, 'width': 1452, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/garden/05HENRY/05HENRY-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/05/garden/05HENRY/05HENRY-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/garden/05HENRY/05HENRY-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Coaxing a History from Board and Beam', 'kicker': 'At Home With Henry Petroski', 'content_kicker': None, 'print_headline': 'Coaxing a History from Board and Beam', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Green, Penelope', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Petroski, Henry', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Maine', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Interior Design and Furnishings', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'ARCHITECTURE', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-06-04T22:45:52+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Penelope Green', 'person': [{'firstname': 'Penelope', 'middlename': None, 'lastname': 'Green', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ac6addef-1ffb-555a-89d3-a4f562365619', 'word_count': 1418, 'uri': 'nyt://article/ac6addef-1ffb-555a-89d3-a4f562365619'}, {'abstract': 'The right pulverizing tools make a difference in the taste and texture of your ingredients.', 'web_url': 'https://www.nytimes.com/2014/06/05/garden/mortars-and-pestles-developing-a-crush.html', 'snippet': 'The right pulverizing tools make a difference in the taste and texture of your ingredients.', 'lead_paragraph': 'Using a mortar and pestle “isn’t always that practical,” said Marc Meyer, the executive chef and co-owner of Cookshop and several other restaurants in Manhattan. Even so, he said: “I insist on it for certain things, like garlic. I like the way garlic comes out when it is completely smashed: It becomes a purée and seems to dissolve into whatever you’re making.”', 'print_section': 'D', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/garden/20140605-SHOP-slide-05Z3/20140605-SHOP-slide-05Z3-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/05/garden/20140605-SHOP-slide-05Z3/20140605-SHOP-slide-05Z3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/garden/20140605-SHOP-slide-05Z3/20140605-SHOP-slide-05Z3-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/garden/20140605-SHOP-slide-05Z3/20140605-SHOP-slide-05Z3-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/garden/20140605-SHOP-slide-05Z3/20140605-SHOP-slide-05Z3-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/05/garden/20140605-SHOP-slide-05Z3/20140605-SHOP-slide-05Z3-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/garden/20140605-SHOP-slide-05Z3/20140605-SHOP-slide-05Z3-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Mortars and Pestles: Developing a Crush', 'kicker': 'Shopping With Marc Meyer', 'content_kicker': None, 'print_headline': 'Developing a Crush', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Suqi, Rima', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Shopping and Retail', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Kitchens', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-06-04T22:46:40+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Rima Suqi', 'person': [{'firstname': 'Rima', 'middlename': None, 'lastname': 'Suqi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/11a393f2-2af3-5cc8-a564-c00fab1d93db', 'word_count': 445, 'uri': 'nyt://article/11a393f2-2af3-5cc8-a564-c00fab1d93db'}, {'abstract': 'A new book illuminates the dwellings of building superintendents.', 'web_url': 'https://www.nytimes.com/2014/06/05/garden/decorator-underground.html', 'snippet': 'A new book illuminates the dwellings of building superintendents.', 'lead_paragraph': 'Manhattan building superintendents are rarely asked about how they decorate their subterranean apartments, combining tenants’ castoffs and souvenirs of faraway homelands against backdrops of rusty pipes and industrial gray walls. When the photographer Gesche Würfel set out to interview the workers for a book, “Basement Sanctuaries” (Grey Matters/Schilt Publishing, $20), “They were very happy about the recognition, that somebody was interested in their life,” she said. In her images, houseplants and pet birds survive on little sunlight, and paintings and photos of tropical waterfronts and Paris landmarks are hung alongside trash cans, exercise equipment and laundry machines. The supers told her that the spaces can be tricky to protect. “Every time I maintain it, people steal my paintings from me,” one said. But another super has managed to attract tourists to his well-appointed home. “It brings them to tears to see the basement,” he said. Information: 31-20-528-69-12, schiltpublishing.com.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/garden/05CURR6/05CURR6-articleLarge.jpg', 'height': 642, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/05/garden/05CURR6/05CURR6-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 642}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/garden/05CURR6/05CURR6-jumbo.jpg', 'height': 1024, 'width': 957, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/garden/05CURR6/05CURR6-superJumbo.jpg', 'height': 2048, 'width': 1913, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/garden/05CURR6/05CURR6-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/05/garden/05CURR6/05CURR6-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/garden/05CURR6/05CURR6-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Decorator Underground', 'kicker': 'Currents: Books', 'content_kicker': None, 'print_headline': 'Decorator Underground', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Wurfel, Gesche', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Basements and Cellars', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Interior Design and Furnishings', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Flowers and Plants', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-06-04T22:46:40+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Eve M. Kahn', 'person': [{'firstname': 'Eve', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f4ddc2c1-6231-528f-a5d2-7f292e35db10', 'word_count': 148, 'uri': 'nyt://article/f4ddc2c1-6231-528f-a5d2-7f292e35db10'}, {'abstract': 'Roche Bobois has added a new designer to its stable. And — sacré bleu! — it is an American.', 'web_url': 'https://www.nytimes.com/2014/06/05/garden/not-really-an-ocean-apart.html', 'snippet': 'Roche Bobois has added a new designer to its stable. And — sacré bleu! — it is an American.', 'lead_paragraph': 'It has been 40 years since the French furniture company Roche Bobois planted a flag in the United States, but only recently did it invite an American to design for its collection. On Thursday, the company is introducing two chairs by Stephen Burks, a New Yorker, that riff on consumer tastes in different parts of the world. Called Traveler, the chairs come in a European version with a canopied tubular metal structure and leather upholstery ($11,800 with canopy) and an American version in wood and fabric ($11,800). Mr. Burks said the first chair expresses a “micro-architectural moment” and celebrates craft, whereas the second signals deep, satisfying comfort: “It’s like a giant pillow,” he said. But don’t take these ideas too literally, he added. “There is so much diversity within cultures, it would be a gross exaggeration to say, ‘I’ve summed up Europe in a chair, or summed up America.’\xa0” Available in September. Information: roche-bobois.com.\xa0', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/garden/05CURR2/05CURR2-articleLarge.jpg', 'height': 740, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/05/garden/05CURR2/05CURR2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 740}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/garden/05CURR2/05CURR2-jumbo.jpg', 'height': 1024, 'width': 831, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/garden/05CURR2/05CURR2-superJumbo.jpg', 'height': 2048, 'width': 1661, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/garden/05CURR2/05CURR2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/05/garden/05CURR2/05CURR2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/garden/05CURR2/05CURR2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Not Really an Ocean Apart', 'kicker': 'Currents: Furniture', 'content_kicker': None, 'print_headline': 'Not Really an Ocean Apart', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Chairs', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Roche Bobois', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Burks, Stephen', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Interior Design and Furnishings', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Furniture', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Shopping and Retail', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-06-04T22:47:07+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Julie Lasky', 'person': [{'firstname': 'Julie', 'middlename': None, 'lastname': 'Lasky', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/35b5ef33-3618-5e5d-8e5a-b265b52ed94a', 'word_count': 155, 'uri': 'nyt://article/35b5ef33-3618-5e5d-8e5a-b265b52ed94a'}, {'abstract': 'This week, the artist Hiroshi Sugimoto unveils a glass teahouse in Venice.', 'web_url': 'https://www.nytimes.com/2014/06/05/garden/tea-for-two-and-visible-to-all.html', 'snippet': 'This week, the artist Hiroshi Sugimoto unveils a glass teahouse in Venice.', 'lead_paragraph': 'Hiroshi Sugimoto is a celebrated chronicler of the monotonous, the frozen and the familiar. He has photographed seascapes, modernist buildings and wax figures of famous people. But the 66-year-old Tokyo artist, who maintains a second studio in Chelsea, where he sat down with a reporter last month, also has a deep feeling for the ritualized performances of his homeland. He has produced and directed his own versions of the traditional Japanese puppet theater called bunraku, and the building he designed for his multidisciplinary Odawara Art Foundation in Japan will have a noh theater stage perched 100 meters above the sea when it opens in 2016.', 'print_section': 'D', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/garden/05QNA2-copy/05QNA2-copy-articleLarge-v2.jpg', 'height': 489, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/05/garden/05QNA2-copy/05QNA2-copy-articleLarge-v2.