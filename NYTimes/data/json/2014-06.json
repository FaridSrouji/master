}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/08/magazine/08OPM-promo/08OPM-promo-superJumbo.png', 'height': 337, 'width': 500, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/08/magazine/08OPM-promo/08OPM-promo-thumbStandard-v2.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/08/magazine/08OPM-promo/08OPM-promo-thumbStandard-v2.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/08/magazine/08OPM-promo/08OPM-promo-thumbLarge-v2.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Sleep Now, Die Later', 'kicker': 'The One-Page Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-06-06T15:03:28+0000', 'document_type': 'multimedia', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/6f5aa80c-48b4-5cf8-8f32-48f78fa40c5b', 'word_count': 0, 'uri': 'nyt://interactive/6f5aa80c-48b4-5cf8-8f32-48f78fa40c5b'}, {'abstract': 'When to leave people — and trash — where they lie.', 'web_url': 'https://www.nytimes.com/2014/06/08/magazine/help-ive-fallen-and-i-dont-want-help.html', 'snippet': 'When to leave people — and trash — where they lie.', 'lead_paragraph': 'I was on the subway when another passenger passed out. The train made an emergency stop, and medical responders assisted the person, despite her screaming — after she came to — that she wanted to be left alone. If the woman was saying she did not want to be helped, even if in critical condition, is someone ethically allowed to obey her and let her suffer? Or would it be a crime to let her suffering continue? ELISABETH BUCHWALD, SCARSDALE, N.Y.', 'print_section': 'MM', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/08/magazine/08ethicist/08ethicist-articleLarge.jpg', 'height': 358, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/08/magazine/08ethicist/08ethicist-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 358}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/08/magazine/08ethicist/08ethicist-jumbo.jpg', 'height': 611, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/08/magazine/08ethicist/08ethicist-superJumbo.jpg', 'height': 1221, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/08/magazine/08ethicist/mag-08Ethicist-t_CA0-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/08/magazine/08ethicist/mag-08Ethicist-t_CA0-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/08/magazine/08ethicist/mag-08Ethicist-t_CA0-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Help! I’ve Fallen, and I Don’t Want Help', 'kicker': None, 'content_kicker': None, 'print_headline': 'Help! I’ve Fallen, and I Don’t Want Help', 'name': None, 'seo'