anizations', 'value': 'Bain Capital', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Michaels Stores Inc', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'The Blackstone Group', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-06-26T22:55:25+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By William Alden', 'person': [{'firstname': 'William', 'middlename': None, 'lastname': 'Alden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/843b6b75-49d0-59c9-be09-9be59dd2dc34', 'word_count': 391, 'uri': 'nyt://article/843b6b75-49d0-59c9-be09-9be59dd2dc34'}, {'abstract': 'The documentary “Bound by Flesh” recounts the lives of Violet and Daisy Hilton, conjoined twins who became a famous vaudeville act.', 'web_url': 'https://www.nytimes.com/2014/06/27/movies/bound-by-flesh-centers-on-the-hiltons-conjoined-twins.html', 'snippet': 'The documentary “Bound by Flesh” recounts the lives of Violet and Daisy Hilton, conjoined twins who became a famous vaudeville act.', 'lead_paragraph': 'Every few years, it seems, someone rediscovers the Hilton sisters, the conjoined twins who spent decades as a sideshow attraction and then a vaudeville act in the heart of the last century. They are having a moment again: A new production of “Side Show,” the stage musical inspired by their lives, has recently opened at the Kennedy Center in Washington, and now “Bound by Flesh,” a straightforward documentary by Leslie Zemeckis, is being given a theatrical release.', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/27/arts/BOUND/BOUND-articleLarge.jpg', 'height': 933, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/20