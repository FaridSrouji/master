or': 'N'}, {'name': 'subject', 'value': 'Parenting', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-06-13T13:56:08+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'U.S.', 'byline': {'original': 'By Aimee Phan', 'person': [{'firstname': 'Aimee', 'middlename': None, 'lastname': 'Phan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bb39925b-0def-5362-8c12-79fd5aed6457', 'word_count': 911, 'uri': 'nyt://article/bb39925b-0def-5362-8c12-79fd5aed6457'}, {'abstract': 'After collective settlement talks on collusion broke down, Bain Capital and Goldman Sachs broke ranks and struck their own deals, ratcheting up the pressure on the other firms.', 'web_url': 'https://dealbook.nytimes.com/2014/06/13/2-private-equity-settlements-followed-failure-of-broader-talks/', 'snippet': 'After collective settlement talks on collusion broke down, Bain Capital and Goldman Sachs broke ranks and struck their own deals, ratcheting up the pressure on the other firms.', 'lead_paragraph': 'For six years, the biggest private equity firms fought a lawsuit that accused them of illegal collusion during the buyout boom. Their strategy, through rounds of difficult settlement talks, was to stick together.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/12/business/dbpix-goldman-2/dbpix-goldman-2-articleLarge.jpg', 'height': 401, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/12/business/dbpix-goldman-2/dbpix-goldman-2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 401}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/12/business/dbpix-goldman-2/dbpix-goldman-2-jumbo.jpg', 'height': 684, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/12/business/dbpix-goldman-2/dbpix-goldman-2-superJumbo.jpg', 'height': 1368, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/12/business/dbpix-goldman-2/dbpix-goldman-2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/12/business/dbpix-goldman-2/dbpix-goldman-2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/12/business/dbpix-goldman-2/dbpix-goldman-2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '2 Private Equity Settlements Followed Failure of Broader Talks on Collusion Lawsuit', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Antitrust Laws and Competition Issues', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Private Equity', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Suits and Litigation (Civil)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Bain Capital', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Goldman Sachs Group Inc', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-06-13T13:59:44+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By William Alden', 'person': [{'firstname': 'William', 'middlename': None, 'lastname': 'Alden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt: