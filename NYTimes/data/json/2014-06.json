me': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/30/business/dealbook/dbpix-paint/dbpix-paint-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/30/business/dealbook/dbpix-paint/dbpix-paint-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'PPG to Buy Mexican Paint Maker Consorcio Comex for $2.3 Billion', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': 'New Acquirer', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-06-30T13:16:15+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Wiliam Alden', 'person': [{'firstname': 'Wiliam', 'middlename': None, 'lastname': 'Alden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4875d951-153e-5ffb-b8a0-b1370776a3d3', 'word_count': 357, 'uri': 'nyt://article/4875d951-153e-5ffb-b8a0-b1370776a3d3'}, {'abstract': 'I think a lot about divorce. Not because I want one, but because I want to avoid getting one.', 'web_url': 'https://parenting.blogs.nytimes.com/2014/06/30/i-think-about-divorce-a-lot-but-not-because-i-want-one/', 'snippet': 'I think a lot about divorce. Not because I want one, but because I want to avoid getting one.', 'lead_paragraph': 'I was driving home while listening to “Older Americans’ Breakups Are Causing A ‘Graying’ Divorce Trend” on NPR. A man was interviewed who left his wife after 34 years. When asked why he left, he said, “The best thing in common that my ex-wife and I had was raising kids.” When their two sons grew up, he said, “we just didn’t have enough activities, passions, interests that were in common. And when the boys were gone, that just became more and more — to me — obvious.” The story gave an alarming statistic: “Americans over 50 are twice as likely to get divorced as people of that age were 20 years ago.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/19/us/motherlode-divorce-illo/motherlode-divorce-illo-articleLarge.jpg', 'height': 393, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/19/us/motherlode-divorce-illo/motherlode-divorce-illo-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 393}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/19/us/motherlode-divorce-illo/motherlode-divorce-illo-jumbo.jpg', 'height': 670, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/19/us/motherlode-divorce-illo/motherlode-divorce-illo-superJumbo.jpg', 'height': 1309, 'width': 2000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/19/us/motherlode-divorce-illo/motherlode-divorce-illo-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/19/us/motherlode-divorce-illo/motherlode-divorce-illo-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/19/us/motherlode-divorce-illo/motherlode-divorce-illo-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'I Think About Divorce a Lot, but Not Because I Want One', 'kicker': 'Motherlode', 'content_kicker': None, 'print_headline': '',