A-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 416}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/22/business/22-SHANESHA/22-SHANESHA-jumbo.jpg', 'height': 709, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/22/business/22-SHANESHA/22-SHANESHA-superJumbo.jpg', 'height': 1418, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/22/business/22-SHANESHA/22-SHANESHA-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/22/business/22-SHANESHA/22-SHANESHA-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/22/business/22-SHANESHA/22-SHANESHA-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Job Seeker’s Desperate Choice', 'kicker': None, 'content_kicker': None, 'print_headline': 'Shanesha’s Choice', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Dewan, Shaila K', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Labor and Jobs', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Recession and Depression', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Child Care', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Taylor, Shanesha', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Child Abuse and Neglect', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Unemployment', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 8, 'majo