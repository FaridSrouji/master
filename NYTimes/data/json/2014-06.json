e': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Detroit (Mich)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Detroit Blight Removal Task Force', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Urban Areas', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Lakes', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Water Pollution', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Transportation', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-06-15T21:28:35+0000', 'document_type': 'article', 'news_desk': 'Letters', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/34eaf8a4-1b2c-59ff-9190-58031ac77eb5', 'word_count': 322, 'uri': 'nyt://article/34eaf8a4-1b2c-59ff-9190-58031ac77eb5'}, {'abstract': 'Mr. Franco will make his theatrical directorial debut as part of the Rattlestick Playwrights Theater’s coming 20th anniversary season.', 'web_url': 'https://www.nytimes.com/2014/06/16/theater/james-franco-to-direct-play.html', 'snippet': 'Mr. Franco will make his theatrical directorial debut as part of the Rattlestick Playwrights Theater’s coming 20th anniversary season.', 'lead_paragraph': 'James Franco, below, will soon add another occupation to his extensive cultural résumé when he makes his\xa0theatrical directorial debut for the premiere of “The Long Shrift” by the author Robert Boswell, presented as part of the Rattlestick Playwrights Theater’s coming 20th anniversary season. The play tells the story of a convict just released from jail who was accused of rape as a teenager. Performances at the Rattlestick are scheduled from July 7 to Aug. 23. Other world premieres in the 2014-15 season are “Pitbulls” by Keith Josef Adkins (“The Last Saint on Sugar Hill”), which is to run from Nov. 6 to Dec. 13, and “Shesh Yak” by Laith Nakli, scheduled for Jan. 15 to Feb. 19. The Rattlestick also announced that “Juárez: A Mythology Documentary” by Rubén Polendo, would be part of the second annual Theater: Village festival, in which a number of new works at West Village locations share a playwright or theme.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/16/arts/arts3/arts3-jumbo.jpg', 'height': 707, 'width': 533, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/16/arts/arts3/arts3-superJumbo.jpg', 'height': 707, 'width': 533, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/16/arts/arts3/arts3-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/16/arts/arts3/arts3-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/16/arts/arts3/arts3-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'James Franco to Direct Play', 'kicker': 'Arts, Briefly', 'content_kicker': None, 'print_headline': 'Franco to Direct Play', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Rattlestick Playwrights Theater', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Franco, James', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Polendo, Ruben', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Boswell, Robert', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Adkins, Keith Josef', 'rank': 6, 'majo