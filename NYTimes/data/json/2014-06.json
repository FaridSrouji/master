 'value': 'Hormones', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Federal Reserve System', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Biology and Biochemistry', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 8, 'major': 'N'}], 'pub_date': '2014-06-07T18:30:50+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By John Coates', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Coates', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/8e079335-de42-5276-8d9a-69c1ecce4893', 'word_count': 2191, 'uri': 'nyt://article/8e079335-de42-5276-8d9a-69c1ecce4893'}, {'abstract': 'The president explains in an interview why the new E.P.A. rules on carbon are so pivotal.', 'web_url': 'https://www.nytimes.com/2014/06/08/opinion/sunday/friedman-obama-on-obama-on-climate.html', 'snippet': 'The president explains in an interview why the new E.P.A. rules on carbon are so pivotal.', 'lead_paragraph': 'WHEN it comes to dealing with the world’s climate and energy challenges I have a simple rule: change America, change the world.', 'print_section': 'SR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/friedman-circular/friedman-circular-jumbo-v2.png', 'height': 228, 'width': 228, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/friedman-circular/friedman-circular-superJumbo-v2.png', 'height': 228, 'width': 228, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'typ