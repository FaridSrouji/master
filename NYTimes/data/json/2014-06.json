ubtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/17/science/20recipehealth/20recipehealth-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/17/science/20recipehealth/20recipehealth-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/17/science/20recipehealth/20recipehealth-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/17/science/20recipehealth/20recipehealth-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Spring Rolls With Shredded Broccoli Stems, Vermicelli and Red Pepper', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Vegetables', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Recipes', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Diet and Nutrition', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Broccoli', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Medicine and Health', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-06-16T15:48:20+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Health', 'byline': {'original': 'By Martha Rose Shulman', 'person': [{'firstname': 'Martha', 'middlename': 'Rose', 'lastname': 'Shulman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'recipe', '_id': 'nyt://article/073fc86c-fd02-5175-beee-a01170efdfdd', 'word_count': 626, 'uri': 'nyt://article/073fc86c-fd02-5175-beee-a01170efdfdd'}, {'abstract': 'Scientists at Brown University used Botox to discover evidence that bats’ muscles help shape their wings in flight.', 'web_url': 'https://www.nytimes.com/2014/06/16/science/new-insight-into-how-bats-conquer-the-air.html', 'snippet': 'Scientists at Brown University used Botox to discover evidence that bats’ muscles help shape their wings in flight.', 'lead_paragraph': 'Bats are an extraordinary evolutionary success, the only mammals to conquer the air. Their flying ability has long attracted the attention of engineers and biologists, and it comes through soft, flexible wings unlike those of birds or insects.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'New Insight Into How Bats Conquer the Air', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Bats', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Science and Technology', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Brown University', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-06-16T15:50:31+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Science', 'byline': {'original': 'By James Gorman', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': 'Gorman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a16b67d0-d125-59ac-8acf-19fdde90aea5', 'word_count': 280, 'uri': 'nyt://article/a16b67d0-d125-59ac-8acf-19fdde90aea5'}, {'abstract': 'Stents and sutures are not an obvious fit, Jeffrey Goldfarb and Robert Cyran of Reuters Breakingviews write, and the savings and benefits from such a merger do not appear to justify a premium of nearly $10 billion.', 'web_url': 'https://dealbook.nytimes.com/2014/06/16/medtronic-covidien-deal-is-a-marriage-of-convenience/', 'snippet': 'Stents and sutures are not an obvious fit, Jeffrey Goldfarb and Robert Cyran of Reuters Breakingviews write, and the savings and benefits from such a merger do not appear to justify a premium of nearly $10 billion.', 'lead_paragraph': 'The marriage of Medtronic and Covidien looks to be one of convenience. The $42.9 billion deal includes a premium that exceeds the estimated cost savings. Stents and sutures are not an obvious fit. And moving Medtronic’s headquarters from Minneapolis to Covidien’s Dublin base will not obviously cut the American company’s tax bill. Freeing up overseas cash is too shallow a reason to tie the knot.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Medtronic-Covidien Deal Is a Marriage of Convenience', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Corporate Taxes', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Medical Devices', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Mergers, Acquisitions and Divestitures', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'AstraZeneca PLC', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Covidien plc', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Medtronic Inc', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Pfizer Inc', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-06-16T15:53:11+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Jeffrey Goldfarb and Robert Cyran', 'person': [{'firstname': 'Jeffrey', 'middlename': None, 'lastname': 'Goldfarb', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Robert', 'middlename': None, 'lastname': 'Cyran', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'org