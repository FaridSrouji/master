heir own creators.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/23/arts/kirby/kirby-articleLarge.jpg', 'height': 764, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/23/arts/kirby/kirby-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 764}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/23/arts/kirby/kirby-jumbo.jpg', 'height': 1024, 'width': 804, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/23/arts/kirby/kirby-superJumbo.jpg', 'height': 1999, 'width': 1569, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/23/arts/kirby/kirby-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/23/arts/kirby/kirby-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/23/arts/kirby/kirby-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Amazing Adventures of Pencil Man', 'kicker': "Theater Review | 'King Kirby'", 'content_kicker': None, 'print_headline': 'The Amazing Adventures of Pencil Man', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Comic Books and Strips', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Kirby, Jack', 'rank': 4, 'major': 'N'}, {'name': 'creative_wo