/18/multimedia/gm-barra-house-hearing/gm-barra-house-hearing-articleLarge.jpg', 'height': 401, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/18/multimedia/gm-barra-house-hearing/gm-barra-house-hearing-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 401}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/18/multimedia/gm-barra-house-hearing/gm-barra-house-hearing-jumbo.jpg', 'height': 684, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/18/multimedia/gm-barra-house-hearing/gm-barra-house-hearing-superJumbo.jpg', 'height': 1367, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/18/multimedia/gm-barra-house-hearing/gm-barra-house-hearing-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/18/multimedia/gm-barra-house-hearing/gm-barra-house-hearing-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/18/multimedia/gm-barra-house-hearing/gm-barra-house-hearing-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'G.M.’s Chief on Staff and Restructuring', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'General Motors (GM/NYSE)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Barra, Mary T', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-06-18T19:15:27+0000', 'document_type': 'multimedia', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/87e0c91f-4ab7-55b5-abb6-7e9cf4f6b726', 'word_count': 0, 'uri': 'nyt://video/87e0c91f-4ab7-55b5-abb6-7e9cf4f6b726'}, {'abstract': 'The music that accompanied the collections and played at the parties ranged from late ’90s hip-hop to nostalgic tracks from current bands like Temples and Tame Impala.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2014/06/18/sounds-of-the-runway-a-retro-flavored-playlist-from-the-springsummer-2015-london-mens-shows/', 'snippet': 'The music that accompanied the collections and played at the parties ranged from late ’90s hip-hop to nostalgic tracks from current bands like Temples and Tame Impala.', 'lead_paragraph': 'During a typical show season, there is usually one genre-crossing Top 40 track that gets played ad nauseam — on the runways, during presentations, at parties — until it has been beaten into the brains of showgoers. Thankfully, the spring/summer 2015 London men’s shows offered a diverse and unexpected soundtrack. There was late ’90s and early ’00s R&B and hip-hop at Astrid Andersen, which used “Affirmative Action” by the short-lived super group the Firm, and at MAN, where the finale, “Freak Me” by Silk, was like bedroom music for the collection of duvet-worthy linens and pillowcase-shaped bags. At the Agi & Sam after-party, Black Rob’s 2000 track “Whoa” got everyone (including fellow designer Matthew Miller) onto the dance floor. At the other end of the sonic spectrum, Topman presented a trio of nostalgic songs by contemporary bands — Temples, Saint Etienne and Tame Impala — that fit the retro-inspired collection without making it feel dated.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/18/t-magazine/18sounds-rider/18sounds-rider-articleLarge.jpg', 