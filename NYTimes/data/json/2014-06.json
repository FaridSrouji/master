: 'nyt://article/c3b76365-a917-5bb4-935f-7cb8cef1f423', 'word_count': 401, 'uri': 'nyt://article/c3b76365-a917-5bb4-935f-7cb8cef1f423'}, {'abstract': 'In “Taxi Brooklyn,” an NBC cabby-and-cop buddy series starring Jacky Ido and Chyler Leigh, the taxi driver is the hero.', 'web_url': 'https://www.nytimes.com/2014/06/25/arts/television/taxi-brooklyn-features-savvy-cabby-and-curt-cop.html', 'snippet': 'In “Taxi Brooklyn,” an NBC cabby-and-cop buddy series starring Jacky Ido and Chyler Leigh, the taxi driver is the hero.', 'lead_paragraph': 'Leo Romba (Jacky Ido) is an expert body-language reader and a stunning tactical driver, can tell which part of Peru a dab of cocaine comes from, and can throw a perp up against a wall without wrinkling his shirt. In “Taxi Brooklyn,” a goofy tale of an unlikely alliance between cop and cabby, he is the seer and the center of all power, a hero for a troubled borough.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/25/arts/25TAXIBROOKLYNjp/25TAXIBROOKLYNjp-articleLarge.jpg', 'height': 380, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/25/arts/25TAXIBROOKLYNjp/25TAXIBROOKLYNjp-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 380}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/25/arts/25TAXIBROOKLYNjp/25TAXIBROOKLYNjp-jumbo.jpg', 'height': 648, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/25/arts/25TAXIBROOKLYNjp/25TAXIBROOKLYNjp-superJumbo.jpg', 'height': 1296, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/25/arts/25TAXIBROOKLYNjp/25TAXIBROOKLYNjp-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/25/arts/25TAXIBROOKLYNjp/25TAXIBROOKLYNjp-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/25/arts/25TAXIBROOKLYNjp/25TAXIBROOKLYNjp-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Odd Couple, Chic Borough', 'kicker': 'Television Review', 'content_kicker': None, 'print_headline': 'Odd Couple, Chic Borough', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'Taxi Brooklyn (TV Program)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Ido, Jacky', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Leigh, Chyler', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'National Broadcasting Co', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-06-24T19:42:36+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Jon Caramanica', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Caramanica', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/6719cc18-2d9c-54da-b2d2-599a4dc511ba', 'word_count': 639, 'uri': 'nyt://article/6719cc18-2d9c-54da-b2d2-599a4dc511ba'}, {'abstract': 'Pooling together Alstom’s and Siemens’s train-making units can create significant medium-term savings, Olaf Storbeck writes in Reuters Breakingviews.', 'web_url': 'https://dealbook.nytimes.com/2014/06/24/siemens-may-seek-another-alstom-tie-up/', 'snippet': 'Pooling together Alstom’s and Siemens’s train-making units can create significant medium-term savings, Olaf Storbeck writes in Reuters Breakingviews.', 'lead_paragraph': 'Once the dust settles over the Alstom bidding war, Siemens and its French rival may want to revisit the most compelling aspect of the German company’s losing bid: a merger of both groups’ train-making units. Such a union would create the train equivalent of Airbus, the European aircraft maker.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/25/business/dbpix-alstom-rail/dbpix-alstom-rail-articleLarge.jpg', 'height': 320, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/25/business/dbpix-alstom-rail/dbpix-alstom-rail-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 320}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/25/business/dbpix-alstom-rail/dbpix-alstom-rail-jumbo.jpg', 'height': 546, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/25/business/dbpix-alstom-rail/dbpix-alstom-rail-superJumbo.jpg', 'height': 1091, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/25/business/dbpix-alstom-rail/dbpix-alstom-rail-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/25/business/dbpix-alstom-rail/dbpix-alstom-rail-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/25/business/dbpix-alstom-rail/dbpix-alstom-rail-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Siemens May Seek Another Alstom Tie-Up', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Mergers, Acquisitions and Divestitures', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Railroads', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Kaeser, Joe', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'ALSTOM', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Siemens AG', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-06-24T19:43:35+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Olaf Storbeck', 'person': [{'firstname': 'Olaf', 'middlename': None, 'lastname': 'Storbeck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/03bf98c0-b424-5135-a5fd-ac28998bdd11', 'word_count': 355, 'uri': 'nyt://article/03bf98c0-b424-5135-a5fd-ac28998bdd11'}, {'abstract': 'The reason that so many apologies seem unsatisfying is that neither side really wants the apology, David Greenberg writes in an Apology Watch column. But there are strategies for reaching authenticity.', 'web_url': 'https://dealbook.nytimes.com/2014/06/24/apologies-become-a-tool-not-a-goal/', 'snippet': 'The reason that so many apologies seem unsatisfying is that neither side really wants the apology, David Greenberg writes in an Apology Watch column. But there are strategies for reaching authenticity.', 'lead_paragraph': 'In 35 years as a corporate insider, adviser and critic, I’ve been on both sides of dozens of apologies played out in the public domain — and the most striking common denominator is how few of those apologies were either genuinely given or received. In fact, I’d suggest that one reason for supporting Dov Seidman’s call for an apology cease-fire is that the modern apology has strayed far from its purpose — acknowledgment and redress of a wrong — and is simply a tactic played out in a larger zero-sum game of winners and losers. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/24/business/dealbook/dbpix-apology/dbpix-apology-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/24/business/dealbook/dbpix-apology/dbpix-apology-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/24/business/dealbook/dbpix-apology/dbpix-apology-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/24/business/dealbook/dbpix-apology/dbpix-apology-superJumbo.jpg', 'height': 1363, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/24/business/dealbook/dbpix-apology/dbpix-apology-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/24/business/dealbook/dbpix-apology/dbpix-apology-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/24/business/dealbook/dbpix-apology/dbpix-apology-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Apologies Become a Tool, Not a Goal', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Apologies', 'rank': 1, 'major': 'N'}], 'pub_date': '2014-06-24T19:44:26+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By David Greenberg', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Greenberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e89d4f10-1589-5aef-970e-2de0f1a2336b', 'word_count': 683, 'uri': 'nyt://article/e89d4f10-1589-5aef-970e-2de0f1a2336b'}, {'abstract': 'Explaining an alleged “deafening silence” on a difficult policy debate.', 'web_url': 'https://douthat.blogs.nytimes.com/2014/06/24/reform-conservatism-and-climate-change/', 'snippet': 'Explaining an alleged “deafening silence” on a difficult policy debate.', 'lead_paragraph': 'When the “Room to Grow” collection of reform conservative essays dropped last month, some of the most frequent criticisms from liberals focused on topics that the book did not address: In particular, comprehensive immigration reform (the subject of my last post) and climate change legislation. Vox’s Matt Yglesias, for instance, thought it noteworthy that a book “hailed as representing the best, freshest conservative thinking on the pressing issues of the day” has “nothing to say” on how American policymakers should tackle climate change, and he offered the following theory as to why:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Reform Conservatism and Climate Change', 'kicker': 'Ross Douthat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Conservatism (US Politics)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Global Warming', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Greenhouse Gas Emissions', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'McCain, John', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-06-24T19:46:28+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Ross Douthat', 'person': [{'firstname': 'Ross', 'middlename': None, 'lastname': 'Douthat', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4756848d-0c38-5e38-ac4f-c6ad831911ac', 'word_count': 1529, 'uri': 'nyt://article/4756848d-0c38-5e38-ac4f-c6ad831911ac'}, {'abstract': 'Andrew B. Balson, a longtime managing director at Bain Capital, has left to start a new investment fund to be based in Boston.', 'web_url': 'https://dealbook.nytimes.com/2014/06/24/bain-capitals-andrew-balson-starts-new-private-equity-fund/', 'snippet': 'Andrew B. Balson, a longtime managing director at Bain Capital, has left to start a new investment fund to be based in Boston.', 'lead_paragraph': 'Andrew B. Balson, a longtime managing director at the Boston-based private equity firm Bain Capital, has left to start a new investment fund.', 'print_section': 'B', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Bain Capital’s Andrew Balson Starts New Private Equity Fund', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': 'New Venture', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Appointments and Executive Changes', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Private Equity', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Balson, Andrew B', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Bain Capital', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-06-24T19:52:35+0000', 'document_typ