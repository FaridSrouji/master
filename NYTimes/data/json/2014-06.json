or': 'N'}], 'pub_date': '2014-06-06T00:48:58+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Steven Lee Myers', 'person': [{'firstname': 'Steven', 'middlename': 'Lee', 'lastname': 'Myers', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5bc1ec15-6a41-5814-88f8-8041641ac7db', 'word_count': 1234, 'uri': 'nyt://article/5bc1ec15-6a41-5814-88f8-8041641ac7db'}, {'abstract': 'In “The Sacrament,” written and directed by Ti West, two journalists accompany a man traveling to meet his sister, a recovering addict, at a compound in a foreign country.', 'web_url': 'https://www.nytimes.com/2014/06/06/movies/the-sacrament-invokes-jonestown.html', 'snippet': 'In “The Sacrament,” written and directed by Ti West, two journalists accompany a man traveling to meet his sister, a recovering addict, at a compound in a foreign country.', 'lead_paragraph': 'The director Ti West, whose credits include the very fine horror movie “The House of the Devil,” has a talent for dread. He’s so good at raising the little hairs on your neck and keeping them on alert that you can only feel let down when he doesn’t deliver a movie that makes good on his setup. That’s the case with his latest, “The Sacrament,” a neo-exploitation flick that shifts from the unnerving to the hollow after it becomes evident that Mr. West is more interested in showing how his characters die than how they lived. It doesn’t help that he seems to encourage you to wish the worst on at least some of them, notably a troika that serves as this tale’s metaphoric blind mice. ', 'print_section': 'C', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Horror Story Borrows From History', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'A Horror Story Borrows From History', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'West, Ti', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Seimetz, Amy', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Jones, Gene', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Swanberg, Joe', 'rank': 5, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Sacrament (Movie)', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-06-06T00:50:15+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Manohla Dargis', 'person': [{'firstname': 'Manohla', 'middlename': None, 'lastname': 'Dargis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/803575cf-d631-515e-a939-369ef51ed3cc', 'word_count': 494, 'uri': 'nyt://article/803575cf-d631-515e-a939-369ef51ed3cc'}, {'abstract': 'A scene from “The Sacrament,” directed by Ti West.', 'web_url': 'https://www.nytimes.com/video/movies/100000002923495/clip-8216the-sacrament8217.html', 'snippet': 'A scene from “The Sacrament,” directed by Ti West.', 'lead_paragraph': 'A scene from “The Sacrament,” directed by Ti West.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/multimedia/sacrament-clip/sacrament-clip-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/05/multimedia/sacrament-clip/sacrament-clip-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/multimedia/sacrament-clip/sacrament-clip-jumbo.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank'