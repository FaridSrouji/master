ors.', 'print_section': 'B', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/sports/05sandomir1/05sandomir1-articleLarge.jpg', 'height': 465, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/05/sports/05sandomir1/05sandomir1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 465}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/sports/05sandomir1/05sandomir1-jumbo.jpg', 'height': 794, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/sports/05sandomir1/05sandomir1-superJumbo.jpg', 'height': 1551, 'width': 2000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/sports/05sandomir1/05sandomir1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/05/sports/05sandomir1/05sandomir1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/05/sports/05sandomir1/05sandomir1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Bonus California Chrome Can’t Win', 'kicker': 'Sports Business', 'content_kicker': None, 'print_headline': 'A Bonus California Chrome Can’t Win', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'California Chrome (Race Horse)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Triple Crown (Horse Racing)', 'rank': 3, 'major': 