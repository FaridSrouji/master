 the timelines for how far they look back.', 'print_section': 'B', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/10/business/Adco/Adco-articleLarge.jpg', 'height': 336, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/10/business/Adco/Adco-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 336}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/10/business/Adco/Adco-jumbo.jpg', 'height': 573, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/10/business/Adco/Adco-superJumbo.jpg', 'height': 895, 'width': 1599, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/10/business/Adco/Adco-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/10/business/Adco/Adco-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/10/business/Adco/Adco-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Selling With Nostalgia, Post-Boomer', 'kicker': None, 'content_kicker': None, 'print_headline': 'Selling With Nostalgia, Post-Boomer', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Elliott, Stuart', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Nineteen Hundred Eighties', 'rank': 3, 'ma