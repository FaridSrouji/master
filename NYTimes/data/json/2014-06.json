/06/29/obituaries/30TAYLOR/30TAYLOR-jumbo-v2.jpg', 'height': 1024, 'width': 760, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/29/obituaries/30TAYLOR/30TAYLOR-superJumbo-v2.jpg', 'height': 2048, 'width': 1520, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/29/obituaries/30TAYLOR/30TAYLOR-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/29/obituaries/30TAYLOR/30TAYLOR-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/29/obituaries/30TAYLOR/30TAYLOR-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Meshach Taylor, an Actor on TV’s ‘Designing Women,’ Dies at 67', 'kicker': None, 'content_kicker': None, 'print_headline': 'Meshach Taylor, 67, an Actor on TV’s ‘Designing Women’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Fitzsimmons, Emma G', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Taylor, Meshach (1947-2014)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'Designing Women (TV Program)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-06-29T17:07:02+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Emma G. Fitzsimmons', 'person': [{'firstname': 'Emma', 'middlename': 'G.', 'lastname': 'Fitzsimmons', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/d760f5d0-1962-52a0-b557-f9ba99de52be', 'word_count': 547, 'uri': 'nyt://article/d760f5d0-1962-52a0-b557-f9ba99de52be'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2014/06/29/arts/television/whats-on-sunday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '10 P.M. (HBO) THE LEFTOVERS Three years after 2 percent of the world’s population suddenly disappeared on Oct. 14, for no discernible reason — Was it an act of God? A natural phenomenon? — the residents of the fictional Mapleton, N.Y., are still searching for answers in this dystopian series created by Tom Perrotta, adapted from his novel, and Damon Lindelof, a mastermind behind ABC’s “Lost.” Churches have closed while cults have formed, including the Guilty Remnant, whose followers wear white, take a vow of silence and chain smoke. One member is Laurie (Amy Brenneman), the mother of Jill (Margaret Qualley), a high schooler, and Tom (Chris Zylka), who has joined another cult led by a man who claims that he can hug the pain out of people. Laurie is also the wife of Kevin Garvey (Justin Theroux, the town’s chief of police, above, speaking with Amanda Warren), whose colleagues worry that he may be losing his mind as he tries to maintain order. The show “may never explain what happened to the people who disappeared, but the measure of its worth is that it may not have to,” Alessandra Stanley wrote in The New York Times. “As with any good drama, the mystery lies in human nature more than in the supernatural. Once the show gets going, and it takes more than one episode to do so, ‘The Leftovers’ bores into the characters and the fissures that crack their community so astutely that the cause is almost secondary.”', 'print_section': 'SP', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s On Sunday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On Sunday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-06-29T17:23:48+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/f5ea9aaa-2ad1-5d14-8461-0dec380a0d5e', 'word_count': 721, 'uri': 'nyt://article/f5ea9aaa-2ad1-5d14-8461-0dec380a0d5e'}, {'abstract': 'Scenes from the men’s fashion week photo diary of Kevin Tachman.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2014/06/29/the-scene-paris-mens-fashion-week-lanvin-spring-summer-2015/', 'snippet': 'Scenes from the men’s fashion week photo diary of Kevin Tachman.', 'lead_paragraph': 'Scenes from the men’s fashion week photo diary of Kevin Tachman.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Paris Men’s Fashion Week: Lanvin Spring/Summer 2015', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-06-29T17:30:40+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Kevin Tachman', 'person': [{'firstname': 'Kevin', 'middlename': None, 'lastname': 'Tachman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e33f8761-76f3-5042-b64c-48e7eaadd27c', 'word_count': 16, 'uri': 'nyt://article/e33f8761-76f3-5042-b64c-48e7eaadd27c'}, {'abstract': 'Paris', 'web_url': 'https://www.nytimes.com/slideshow/2014/06/29/fashion/runway-mens/umit-benan-spring-2015-menswear.html', 'snip