name': None, 'lastname': 'Rudoren', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a0bbff50-cd9a-51ee-89d4-68ec9f59591c', 'word_count': 1016, 'uri': 'nyt://article/a0bbff50-cd9a-51ee-89d4-68ec9f59591c'}, {'abstract': 'By cutting back on early voting, the state has taken another egregious step to impose barriers for citizens who tend to vote Democratic.', 'web_url': 'https://www.nytimes.com/2014/06/10/opinion/more-voting-games-in-ohio.html', 'snippet': 'By cutting back on early voting, the state has taken another egregious step to impose barriers for citizens who tend to vote Democratic.', 'lead_paragraph': 'Someday, after they figure out how to appeal to a broader swath of the electorate, Republicans will probably be embarrassed by how much time they have spent making it harder for Americans to vote. For now, though, the beat just goes on. In a misguided effort to hold on to power despite an ever-shrinking base of older white voters, Republican lawmakers around the country continue to impose all sorts of barriers to the ballot box. ', 'print_section': 'A', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'More Voting Games in Ohio', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'More Voting Games in Ohio', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Republican Party', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Ohio', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Voter Registration and Requirements', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Blacks', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-06-10T01:08:36+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/c5b0421a-ecd0-5ab1-b763-833c3ab4a7b0', 'word_count': 572, 'uri': 'nyt://article/c5b0421a-ecd0-5ab1-b763-833c3ab4a7b0'}, {'abstract': 'Though some call the taxi app’s valuation of $18.2 billion “insane,” it’s worth doing the basic math and taking a closer look.', 'web_url': 'https://dealbook.nytimes.com/2014/06/09/how-uber-pulls-in-billions-all-via-iphone/', 'snippet': 'Though some call the taxi app’s valuation of $18.2 billion “insane,” it’s worth doing the basic math and taking a closer look.', 'lead_paragraph': 'It was described as “nuts,” “insane” and “idiocy.”', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/02/us/dbpix-uber2/nytnow-uber-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/02/us/dbpix-uber2/nytnow-uber-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/02/us/dbpix-uber2/nytnow-uber-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/02/us/dbpix-uber2/nytnow-uber-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/02/us/dbpix-uber2/dbpix-uber2-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/02/us/dbpix-uber2/dbpix-uber2-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/02/us/dbpix-uber2/dbpix-uber2-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Why Uber Might Well Be Worth $18 Billion', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': 'Why Uber Might Well Be Worth $18 Billion', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Car Services and Livery Cabs', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mobile Applications', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Uber Technologies Inc', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-06-10T01:09:16+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Andrew Ross Sorkin', 'person': [{'firstname': 'Andrew', 'middlename': 'Ross', 'lastname': 'Sorkin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6fb95fb0-e72a-50bc-aeca-437b0acb6aec', 'word_count': 1020, 'uri': 'nyt://article/6fb95fb0-e72a-50bc-aeca-437b0acb6aec'}, {'abstract': 'A new manifesto from a group of reform conservatives is the most coherent and compelling policy agenda the American right has produced this century.', 'web_url': 'https://www.nytimes.com/2014/06/10/opinion/brooks-the-new-right.html', 'snippet': 'A new manifesto from a group of reform conservatives is the most coherent and compelling policy agenda the American right has produced this century.', 'lead_paragraph': 'Conservatives generally believe that capitalism is a machine that cures itself. Therefore, people on the right have been slow to recognize the deep structural problems that are making life harder in the new economy — that are