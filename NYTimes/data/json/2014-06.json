s', 'rank': 1, 'major': 'N'}], 'pub_date': '2014-06-16T03:02:23+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Eric Grode', 'person': [{'firstname': 'Eric', 'middlename': None, 'lastname': 'Grode', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d34076c7-dae5-55d7-b864-cef87d855fe3', 'word_count': 757, 'uri': 'nyt://article/d34076c7-dae5-55d7-b864-cef87d855fe3'}, {'abstract': 'When her second son was born, six weeks premature, Emily Guillermo recalled thinking, “You’re not supposed to be mine. You were not supposed to be made.”', 'web_url': 'https://www.nytimes.com/video/science/100000002891956/unexpected-unplanned-and-unwanted.html', 'snippet': 'When her second son was born, six weeks premature, Emily Guillermo recalled thinking, “You’re not supposed to be mine. You were not supposed to be made.”', 'lead_paragraph': 'When her second son was born, six weeks premature, Emily Guillermo recalled thinking, “You’re not supposed to be mine. You were not supposed to be made.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/20/multimedia/postpartum-emily/postpartum-emily-articleLarge.jpg', 'height': 406, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/20/multimedia/postpartum-emily/postpartum-emily-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 406}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/20/multimedia/postpartum-emily/postpartum-emily-jumbo.jpg', 'height': 693, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/20/multimedia/postpartum-emily/