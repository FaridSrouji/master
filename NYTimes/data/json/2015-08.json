': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/16/blogs/16iht-old1915/16iht-old1915-articleLarge.jpg', 'height': 455, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/16/blogs/16iht-old1915/16iht-old1915-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 455}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/16/blogs/16iht-old1915/16iht-old1915-jumbo.jpg', 'height': 759, 'width': 1000, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/16/blogs/16iht-old1915/16iht-old1915-superJumbo.jpg', 'height': 759, 'width': 1000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/16/blogs/16iht-old1915/16iht-old1915-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/16/blogs/16iht-old1915/16iht-old1915-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/16/blogs/16iht-old1915/16iht-old1915-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '1915: M. Venizelos Scores Triumph in Greek Chamber Election', 'kicker': 'IHT Retrospective', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Elections', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Athens (Greece)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Greece', 'rank': 3, 'major': 'N'}], 