'https://www.nytimes.com/politics/first-draft/2015/08/07/today-in-politics-debates-give-those-fighting-for-traction-a-chance-to-gain-a-footing/', 'snippet': 'It was a night of two debates, but in a way, Thursday evening’s marathon in Cleveland felt like three events.', 'lead_paragraph': 'Good Friday morning from Washington. It has been only a few hours since 17 Republicans gathered in two debates in an effort to stand apart. As expected, the big names remained big, but a few lesser-known candidates found a way to rise above the crowded field, at least for a night.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Today in Politics: Debates Give Those Fighting for Traction a Chance to Gain a Footing', 'kicker': 'First Draft', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Debates (Political)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Fiorina, Carleton S', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Fox News Channel', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-08-07T10:55:03+0000', 'document_type': 'article', 'news_desk': 'Politics', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/c717cd8b-7cfb-5ff8-9dc0-b68b7e9f505f', 'word_count': 1340, 'uri': 'nyt://article/c717cd8b-7cfb-5ff8-9dc0-b68b7e9f505f'}, {'abstract': 'Readers react.', 'web_url': 'https://www.nytimes.com/2015/08/09/magazine/the-7-26-15-issue.html', 'snippet': 'Readers react.', 'lead_paragraph': 'RE: CHRISTIANS', 'print_section': 'MM', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'cre