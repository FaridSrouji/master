s', 'value': 'Andreessen, Marc L', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Andreessen Horowitz', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'California', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-08-19T20:00:59+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'byline': {'original': 'By Steve Lohr', 'person': [{'firstname': 'Steve', 'middlename': None, 'lastname': 'Lohr', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/165d7999-74ca-5e04-a74c-b6cbcfb2eba8', 'word_count': 547, 'uri': 'nyt://article/165d7999-74ca-5e04-a74c-b6cbcfb2eba8'}, {'abstract': 'Filling in for the injured Mark Teixeira, Bird had two two-run blasts, the first homers of his career, helping the Yankees sweep the Twins.', 'web_url': 'https://www.nytimes.com/2015/08/20/sports/baseball/greg-bird-lifts-yankees-with-first-two-career-home-runs.html', 'snippet': 'Filling in for the injured Mark Teixeira, Bird had two two-run blasts, the first homers of his career, helping the Yankees sweep the Twins.', 'lead_paragraph': 'When Yankees General Manager Brian Cashman made inquiries into acquiring a starting pitcher before the July 31 trading deadline, he told his counterparts on other teams that three prospects were off-limits: pitcher Luis Severino, outfielder Aaron Judge and first baseman Greg Bird.', 'print_section': 'B', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/20/sports/20YANKEESweb1/20YANKEESweb1-articleLarge.jpg', 'height': 438, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/20/sports/20YANKEESweb1/20YANKEESweb1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 438}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit':