ail': 'images/2015/08/07/world/middleeast/07open_sisi/07open_sisi-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/07/world/middleeast/07open_sisi/07open_sisi-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'As Egypt Unveils Its ‘New Suez Canal,’ Dissenters Make Voices Heard Online', 'kicker': 'Open Source', 'content_kicker': None, 'print_headline': 'As Egypt Unveils Its ‘New Suez Canal,’ Some Dissenters Make Their Voices Heard Online', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Egypt', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Suez Canal', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Sisi, Abdel Fattah el-', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Social Media', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Middle East and North Africa Unrest (2010- )', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-08-06T22:42:24+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Robert Mackey', 'person': [{'firstname': 'Robert', 'middlename': None, 'lastname': 'Mackey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/13019f00-3fa3-5e84-aee7-c119d973bc76', 'word_count': 344, 'uri': 'nyt://article/13019f00-3fa3-5e84-aee7-c119d973bc76'}, {'abstract': 'Joining the parade of men’s boutiques in the Marais, Givenchy shows off its mix of haute history and sharp detailing.', 'web_url': 'https://www.nytimes.com/2015/08/07/fashion/mens-style/at-givenchys-mens-shop-in-paris-the-two-sides-of-riccardo-tisci.html', 'snippet': 'Joining the parade of men’s boutiques in the Marais, Givenchy shows off its mix of haute history and sharp detailing.', 'lead_paragraph': 'There is a certain, redoubtable logic to fishing where the fish are. Thus, the Marais — Paris’s gay mecca, the rough equivalent in demography (if not style) of New York’s Chelsea or West Hollywood in Los Angeles — has lately been filling with designer stores catering to the stylish men who fill its streets. Along the Rue des Archives are men’s boutiques from Gucci, Fendi, Moncler and, at No. 13, Givenchy.', 'print_section': 'D', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'At Givenchy’s Men’s Shop in Paris, the Two Sides of Riccardo Tisci', 'kicker': 'Global Shopper', 'content_kicker': None, 'print_headline': 'At Givenchy in Paris, Toughness and Light', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Schneier, Matthew', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Tisci, Riccardo', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Givenchy', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Paris (France)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Shoes and Boots', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Shopping and Retail', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-08-06T22:42:31+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'subsection_name': 'Men’s Style', 'byline': {'original': 'By Matthew Schneier', 'person': [{'firstname': 'Matthew', 'middlename': None, 'lastname': 'Schneier', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/099b6e85-f9b5-511b-843a-a7a57c5f625e', 'word_count': 427, 'uri': 'nyt://article/099b6e85-f9b5-511b-843a-a7a57c5f625e'}, {'abstract': 'Jon Watts’s film, in its self-consciousness and breezy, instrumental violence, ambitiously announces itself as the latest spawn of neo-exploitation artists like Quentin Tarantino.', 'web_url': 'https://www.nytimes.com/2015/08/07/movies/review-in-cop-car-a-joyride-by-2-runaway-boys-takes-a-wrong-turn.html', 'snippet': 'Jon Watts’s film, in its self-consciousness and breezy, instrumental violence, ambitiously announces itself as the latest spawn of neo-exploitation artists like Quentin Tarantino.', 'lead_paragraph': 'When the 10-year-old heroes of “Cop Car” first see the cruiser in question, it’s parked unattended in a field, ready to be plucked like a daisy. Travis (James Freedson-Jackson) and Harrison (Hays Wellford) make a fine pair of pipsqueaks, and they’re on a great journey when they find the car, having run away from home that same day. They have no real reason or complaint or plans, just a single piece of beef jerky and a boy’s own sense of adventure.', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/07/arts/07COPCAR1/07COPCAR1-articleLarge.jpg', 'height': 251, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/07/arts/07COPCAR1/07COPCAR1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 251}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/07/arts/07COPCAR1/07COPCAR1-jumbo.jpg', 'height': 429, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/07/arts/07COPCAR1/07COPCAR1-superJumbo.jpg', 'height': 858, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/07/arts/07COPCAR1/07COPCAR1-thumbSt