0-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Island of Decades Before', 'kicker': 'Lives', 'content_kicker': None, 'print_headline': 'The Island of Decades Before ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Hodgkinson, Will', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Families and Family Life', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Scotland', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-08-14T10:59:03+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Will Hodgkinson', 'person': [{'firstname': 'Will', 'middlename': None, 'lastname': 'Hodgkinson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/624d1668-aef7-5693-bb07-9a9e0ba934c9', 'word_count': 774, 'uri': 'nyt://article/624d1668-aef7-5693-bb07-9a9e0ba934c9'}, {'abstract': 'Because you never know when you might be on a plane to Tashkent.', 'web_url': 'https://www.nytimes.com/2015/08/16/magazine/letter-of-recommendation-uzbek.html', 'snippet': 'Because you never know when you might be on a plane to Tashkent.', 'lead_paragraph': 'Four years ago, the federal government paid me a large sum — a year of graduate-school tuition, plus a stipend — to study Uzbek at the University of Chicago. Uzbek is among the least commonly taught of the so-called Less Commonly Taught Languages, or L.C.T.L.s. So uncommonly is it taught, in fact, that without federal largess it would hardly be taught at all. Because I happened to speak decent Turkish, a cousin of Uzbek, and because I spent a week in Uzbekistan when I was 22, and because life is nothing if not a sequence of odd choices vaguely considered, for two years I sat in a room with two other students and produced some extremely literal translations.', 'print_section': 'MM', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/16/magazine/16lor/16mag-16lor-t_CA0-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/16/magazine/16lor/16mag-16lor-t_CA0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/16/magazine/16lor/16mag-16lor-t_CA0-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/16/magazine/16lor/16mag-16lor-t_CA0-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/16/magazine/16lor/16lor-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/16/magazine/16lor/16lor-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/16/magazine/16lor/16lor-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Letter of Recommendation: Uzbek', 'kicker': 'Letter of Recommendation', 'content_kicker': None, 'print_headline': 'Uzbek', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Uzbeks (Ethnic Group)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Kiesling, Lydia', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Language and Languages', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Uzbekistan', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-08-14T10:59:04+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Lydia Kiesling', 'person': [{'firstname': 'Lydia', 'middlename': None, 'lastname': 'Kiesling', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/246dea41-0375-5481-beb2-28a85448c4cc', 'word_count': 913, 'uri': 'nyt://article/246dea41-0375-5481-beb2-28a85448c4cc'}, {'abstract': 'A patient worries about his painful earaches and asymmetrical pupils.', 'web_url': 'https://www.nytimes.com/interactive/2015/08/16/magazine/16mag-diagnosis.html', 'snippet': 'A patient worries about his painful earaches and asymmetrical pupils.', 'lead_paragraph': 'A patient worries about his painful earaches and asymmetrical pupils.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/16/magazine/16diagnosis1/16mag-16diagnosis-t_CA0-articleLarge.jpg', 'height': 580, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/16/magazine/16diagnosis1/16mag-16diagnosis-t_CA0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 580}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/16/magazine/16diagnosis1/16mag-16diagnosis-t_CA0-jumbo.jpg', 'height': 989, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/16/magazine/16diagnosis1/16mag-16diagnosis-t_CA0-superJumbo.jpg', 'height': 1979, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/16/magazine/16diagnosis1/16mag-16diagnosis-t_CA0-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/16/magazine/16diagnosis1/16mag-16diagnosis-t_CA0-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/16/magazine/16diagnosis1/16mag-16diagnosis-t_CA0-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Why Did He Feel Like a Knife Was Stabbing His Head?', 'kicker': 'Diagnosis', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Medicine and Health', 'rank': 1, 'major': 'N'}], 'pub_date': '2015-08-14T10:59:04+0000', 'document_type': 'multimedia', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By LISA SANDERS, M.D', 'person': [{'firstname': 'Lisa', 'middlename': None, 'lastname': 'SANDERS', 'qualifier': 'M.D', 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/18a2b2d3-dcdd-5971-8443-09a6a8890ae7', 'word_count': 0, 'uri': 'nyt://interactive/18a2b2d3-dcdd-5971-8443-09a6a8890ae7'}, {'abstract': 'The subversive young Mexican-American artist paints homages to the Angelenos whom wealthy homeowners — and the art world — often fail to see.', 'web_url': 'https://www.nytimes.com/2015/08/16/magazine/ramiro-gomezs-domestic-disturbances.html', 'snippet': 'The subversive young Mexican-American artist paints homages to the Angelenos whom wealthy homeowners — and the art world — often fail to see.', 'lead_paragraph': 'I\u2009first noticed the work of the young Los Angeles artist Ramiro Gomez across a series of recent art fairs, on account of those Hockneys of his: that is, paintings that were dead ringers for Hockneys — same scale, same colors, same composition — except that something was always just slightly off. Take Gomez’s large-scale version of Hockney’s iconic ‘‘American Collectors’’ double portrait, for example, which Gomez’s Los Angeles dealer, Charlie James, exhibited at the most recent Expo Chicago. It looks almost exactly like the original portrait of the couple in question, clenched in a grim rictus amid the sculptures in their backyard garden, except that Gomez replaced the two collector protagonists with a pair of dark-skinned gardeners of the sort who regularly do the actual tending of such gardens. Into another Hockney, of one of those nondescript West Los Angeles apartment buildings with its wide front lawn, Gomez slotted a groundskeeper, rake extended. That was the genius of the whole series: how in much the same way that, back in the ’60s, the English transplant Hockney first opened our eyes to so much that we had previously overlooked in Los Angeles, rendering all sorts of things visible to us as if for the first time (those boxy apartment buildings, the distinctive street signs, the moderne furniture, that light), so Gomez seemed to be allowing us, indeed forcing us, to notice the very groundskeepers and housemaids and pool cleaners who make that look, the look of Los Angeles, possible, rendering visible a whole world of people, our fellow humans, who often go unseen (and who, for that matter, because they are sometimes ‘‘illegal,’’ often strive not to be seen).', 'print_section': 'MM', 'print_page': '32', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/16/magazine/16gomez1/16gomez1-articleLarge.jpg', 'height': 432, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/16/magazine/16gomez1/16gomez1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 432}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/16/magazine/16gomez1/16gomez1-jumbo.jpg', 'height': 737, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/16/magazine/16gomez1/16gomez1-superJumbo.jpg', 'height': 1474, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/16/magazine/16gomez1/16mag-16gomez-t_CA3-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/16/magazine/16gomez1/16mag-16gomez-t_CA3-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/16/magazine/16gomez1/16mag-16gomez-t_CA3-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Ramiro Gomez’s Domestic Disturbances', 'kicker': 'Feature', 'content_kicker': None, 'print_headline': 'Domestic Disturbances', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Weschler, Lawrence', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Mexican-Americans', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Los Angeles (Calif)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Hockney, David', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Gomez, Ramiro (1986- )', 'rank': 