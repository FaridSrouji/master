eaders-ukraine-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/24/multimedia/euro-leaders-ukraine/euro-leaders-ukraine-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/24/multimedia/euro-leaders-ukraine/euro-leaders-ukraine-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/24/multimedia/euro-leaders-ukraine/euro-leaders-ukraine-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/24/multimedia/euro-leaders-ukraine/euro-leaders-ukraine-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/24/multimedia/euro-leaders-ukraine/euro-leaders-ukraine-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/24/multimedia/euro-leaders-ukraine/euro-leaders-ukraine-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Euro Leaders Back Cease-Fire in Ukraine', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Organization for Security and Cooperation in Europe', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Hollande, Francois', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Merkel, Angela', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Poroshenko, Petro Olekseyevich', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Ukraine', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Russia', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-08-24T21:32:51+0000', 'document_type': 'multimedia', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By REUTERS and THE ASSOCIATED PRESS', 'person': [], 'organization': 'REUTERS'}, 'type_of_material': 'Video', '_id': 'nyt://video/dcfcdcb2-32cc-553a-9541-aeeca2ddcc80', 'word_count': 0, 'uri': 'nyt://video/dcfcdcb2-32cc-553a-9541-aeeca2ddcc80'}, {'abstract': 'Attendees wore jewel-encrusted lapels, masks and floral suits to see Grace Jones perform.', 'web_url': 'https://www.nytimes.com/2015/08/24/t-magazine/afropunk-festival-fancy-ball-photos.html', 'snippet': 'Attendees wore jewel-encrusted lapels, masks and floral suits to see Grace Jones perform.', 'lead_paragraph': 'Rules rarely spark a good time. Yet upon entering Commodore Barry Park for the Afropunk Festival’s inaugural Fancy Ball on Friday night — a fundraiser which opened the 11th annual music spectacle in Fort Greene, Brooklyn — attendees were greeted by eight commandments: no sexism, no racism, no ableism, no ageism, no homophobia, no fatphobia, no transphobia, no hatefulness. “It’s like the most polite people I’ve ever met,” said Manzell Glover, a male bartender in a sleeveless vintage dress who identified as a QPOC (Queer Person of Color). “There was a crowd, but when people have their tapestries down or their blankets down, nobody stepped on anyone’s anything. I’ve never heard ‘excuse me’ so many times,” he said. A retail fashion stylist seated on one of those blankets, Ramie Mitchell, said, “It feels like a no-judgment zone.” Amy Van Doran, a professional matchmaker in a Tang-colored wig, was more blunt in her assessment: “Everyone here is super kind because there is less white privilege,” she said. Headliner Grace Jones took the stage a very civilized 10 minutes early, though she did tell the crowd, drolly and with an expletive appended, “Put down your phones and clap your hands. Put it between your legs if you have to.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Scenes From the Afropunk Festival’s Fancy Ball', 'kicker': 'The Scene', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Rock Music', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Fort Greene (Brooklyn, NY)', 'rank': 2, 'major': 'N'}], 'pub_date': '2015-08-24T21:33:12+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Jenna Marotta', 'person': [{'firstname': 'Jenna', 'middlename': None, 'lastname': 'Marotta', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9172b0f6-7d24-5b6d-a650-8adedba9e21b', 'word_count': 538, 'uri': 'nyt://article/9172b0f6-7d24-5b6d-a650-8adedba9e21b'}, {'abstract': 'In two speeches, President Petro O. Poroshenko spoke of Ukraine’s tension with Russia, and the leaders of Germany and France again voiced support for a deal negotiated this year.', 'web_url': 'https://www.nytimes.com/2015/08/25/world/europe/european-leaders-make-a-show-of-support-for-ukraine-on-its-national-day.html', 'snippet': 'In two speeches, President Petro O. Poroshenko spoke of Ukraine’s tension with Russia, and the leaders of Germany and France again voiced support for a deal negotiated this year.', 'lead_paragraph': 'BERLIN — Clinging to a deal on Ukraine that has never been fully enacted, the leaders of Germany, France and Ukraine called on Monday — the 24th anniversary of Ukraine’s independence — for the bloodshed to end.', 'print_section': 'A', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'European Leaders Make a Show of Support for Ukraine on Its National Day', 'kicker': None, 'content_kicker': None, 'print_headline': 'World Briefing | Europe; Ukraine: Leaders Press for Cease-Fire', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Russia', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Ukraine', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'France', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Germany', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Poroshenko, Petro Olekseyevich', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Merkel, Angela', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Hollande, Francois', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Putin, Vladimir V', 'rank': 9, 'major': 'N'}], 'pub_date': '2015-08-24T21:40:48+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Alison Smale', 'person': [{'firstname': 'Alison', 'middlename': None, 'lastname': 'Smale', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5350a6af-c62b-5948-8ef2-2afe77c5644b', 'word_count': 550, 'uri': 'nyt://article/5350a6af-c62b-5948-8ef2-2afe77c5644b'}, {'abstract': 'The state police said Monday that a Louisiana trooper, Steven J. Vincent, had died after being shot in the head Sunday night during a traffic stop.', 'web_url': 'https://www.nytimes.com/video/us/100000003871595/louisiana-state-police-discuss-shooting.html', 'snippet': 'The state police said Monday that a Louisiana trooper, Steven J. Vincent, had died after being shot in the head Sunday night during a traffic stop.', 'lead_paragraph': 'The state police said Monday that a Louisiana trooper, Steven J. Vincent, had died after being shot in the head Sunday night during a traffic stop.', 'source': 'The New York T