rop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/13/health/13well_headshot/13well_headshot-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 729}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/13/health/13well_headshot/13well_headshot-jumbo.jpg', 'height': 1024, 'width': 844, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/13/health/13well_headshot/13well_headshot-superJumbo.jpg', 'height': 1319, 'width': 1086, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/13/health/13well_headshot/13well_headshot-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/13/health/13well_headshot/13well_headshot-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/13/health/13well_headshot/13well_headshot-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Doctors Fail to Address Patients’ Spiritual Needs', 'kicker': 'Well', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Clergy', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Doctors', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Medical Schools', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Religion and Belief', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-08-13T14:24:30+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Health', 'byline': {'original': 'By Robert Klitzman, M.D', 'person': [{'firstname': 'Robert', 'middlename': None, 'lastname': 'Klitzman', 'qualifier': 'M.D', 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4c1b1b27-39cf-592d-905f-9ec7ddb87620', 'word_count': 985, 'uri': 'nyt://article/4c1b1b27-39cf-592d-905f-9ec7ddb87620'}, {'abstract': 'Times Insider talked with two editors who were closely involved in live blogging the first G.O.P. debate using a chat tool called Slack.', 'web_url': 'https://www.nytimes.com/2015/08/12/insider/live-republican-debate-coverage-using-slack-discussed-using-slack.html', 'snippet': 'Times Insider talked with two editors who were closely involved in live blogging the first G.O.P. debate using a chat tool called Slack.', 'lead_paragraph': 'Last week, The Times’s political team experimented with live-blogging the first Republican debate by using the increasingly popular chat tool, Slack. Times Insider talked to Paul Volpe, editor in the Washington bureau, and Marc Lavallee, editor of Interactive News, about how it went, using, of course — a Slack chat room!', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/07/us/RepublicanDebate-slide-QF8U/RepublicanDebate-slide-QF8U-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/07/us/RepublicanDebate-slide-QF8U/RepublicanDebate-slide-QF8U-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/07/us/RepublicanDebate-slide-QF8U/RepublicanDebate-slide-QF8U-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/07/us/RepublicanDebate