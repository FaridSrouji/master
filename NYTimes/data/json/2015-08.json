ne': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Hamptons (NY)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 2, 'major': 'N'}], 'pub_date': '2015-08-29T12:58:13+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'byline': {'original': 'By John Ortved', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Ortved', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/31826390-efd4-5786-ac31-235dce4e0eae', 'word_count': 47, 'uri': 'nyt://article/31826390-efd4-5786-ac31-235dce4e0eae'}, {'abstract': 'Mr. Willkie is rare among major-party candidates: He was a political outsider whose main qualification was to have been the chief of a large company.', 'web_url': 'https://www.nytimes.com/2015/08/30/upshot/before-trump-or-fiorina-there-was-wendell-willkie.html', 'snippet': 'Mr. Willkie is rare among major-party candidates: He was a political outsider whose main qualification was to have been the chief of a large company.', 'lead_paragraph': 'If either Donald Trump or Carly Fiorina receives the 2016 Republication presidential nomination, it will be a rare achievement. Only once in American history has a major political party granted its prize to someone whose principal qualification was to have served as a corporate chief executive. That was in 1940, when Wendell Willkie was the Republican candidate against President Franklin Roosevelt, who was seeking a third term.', 'print_section': 'BU', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/29/upshot/30historysource/30historysource-articleLarge.jpg', 'height': 754, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/29/upshot/30historysource/30historysource-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 754}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/29/upshot/30historysource/30historysource-jumbo.jpg', 'height': 1024, 'width': 816, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/29/upshot/30historysource/30historysource-superJumbo.jpg', 'height': 2048, 'width': 1631, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/29/upshot/30historysource/30historysource-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/29/upshot/30historysource/30historysource-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/29/upshot/30historysource/30historysource-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Before Trump or Fiorina, There Was Wendell Willkie', 'kicker': 'HistorySource', 'content_kicker': None, 'print_headline': 'Before Trump or Fiorina, There Was Willkie  ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Elections (US)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Beschloss, Michael R', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Willkie, Wendell', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Fiorina, Carleton S', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': "New Deal (1930's)", 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Roosevelt, Franklin Delano', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'World War II (1939-45)', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Perot, Ross', 'rank': 10, 'major': 'N'}], 'pub_date': '2015-08-29T13:15:04+0000', 'document_type': 'article', 'news_desk': 'SundayBusiness', 'section_name': 'The Upshot', 'byline': {'original': 'By Michael Beschloss', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Beschloss', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/24f9a2c0-c6d3-51b1-bd16-f964e049d8ef', 'word_count': 1135, 'uri': 'nyt://article/24f9a2c0-c6d3-51b1-bd16-f964e049d8ef'}, {'abstract': 'Despairing thoughts on what passes for sophistication.', 'web_url': 'https://krugman.blogs.nytimes.com/2015/08/29/artificial-unintelligence/', 'snippet': 'Despairing thoughts on what passes for sophistication.', 'lead_paragraph': 'In the early stages of the Lesser Depression, those of us who knew a bit about the macroeconomic debates of the 1930s, and realized how relevant the hard-won insights of Keynes and Hicks were to the post-financial crisis world, often felt a sense of despair. Everywhere you looked, people who imagined themselves sophisticated and possessed of deep understanding were resurrecting 75-year-old fallacies and presenting them as deep insights.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/29/opinion/082915krugman1/082915krugman1-jumbo.png', 'height': 425, 'width': 501, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/29/opinion/082915krugman1/082915krugman1-supe