: 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Perry, Alex Ross', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Moss, Elizabeth', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Waterston, Katherine', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'Queen of Earth (Movie)', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-08-25T21:40:09+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Movies', 'byline': {'original': 'By Mekado Murphy', 'person': [{'firstname': 'Mekado', 'middlename': None, 'lastname': 'Murphy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d63e1a68-acff-510f-b47e-7f09fb514444', 'word_count': 522, 'uri': 'nyt://article/d63e1a68-acff-510f-b47e-7f09fb514444'}, {'abstract': 'Alex Ross Perry narrates a sequence from “Queen of Earth” with Elisabeth Moss.', 'web_url': 'https://www.nytimes.com/video/movies/100000003867931/anatomy-of-a-scene-queen-of-earth.html', 'snippet': 'Alex Ross Perry narrates a sequence from “Queen of Earth” with Elisabeth Moss.', 'lead_paragraph': 'Alex Ross Perry narrates a sequence from “Queen of Earth” with Elisabeth Moss.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/21/multimedia/queenofearth-anatomy/queenofearth-anatomy-articleLarge.jpg', 'height': 424, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/21/multimedia/queenofearth-anatomy/queenofearth-anatomy-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 424}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/21/multimedia/queenofearth-anatomy/queenofearth-anatomy-jumbo.jpg', 'height': 723, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0,