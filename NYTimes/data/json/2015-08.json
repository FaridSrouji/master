idth': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Your Weekend Briefing', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-08-16T01:42:24+0000', 'document_type': 'multimedia', 'news_desk': 'NYT Now', 'section_name': 'NYT Now', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/07f234ca-207c-50d9-b01a-5e8fa1614492', 'word_count': 0, 'uri': 'nyt://slideshow/07f234ca-207c-50d9-b01a-5e8fa1614492'}, {'abstract': 'Mickelson’s first subpar round of the week moved him into a tie for 24th place at the P.G.A. Championship, a jump of 37 spots.', 'web_url': 'https://www.nytimes.com/2015/08/16/sports/golf/a-6-under-round-for-phil-mickelson-bolsters-his-presidents-cup-bid.html', 'snippet': 'Mickelson’s first subpar round of the week moved him into a tie for 24th place at the P.G.A. Championship, a jump of 37 spots.', 'lead_paragraph': 'HAVEN, Wis. — Phil Mickelson has never depended on the kindness of Team USA captains, and he does not intend to start now. That is why his six-under 66 in the P.G.A. Championship on Saturday mattered. Mickelson’s first subpar round of the week not only catapulted him up the leaderboard into a tie for 24th from 61st, but also gave him hope that the payoff for all his hard work would come in time for him to make the United States team for the Presidents Cup in South Korea in October.', 'print_section': 'SP', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/16/sports/16mickelson-1/16mickelson-1-articleLarge.jpg', 'height': 403, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/16/sports/16mickelson-1/16mickelson-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 403}},