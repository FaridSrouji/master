tle': None, 'role': 'reported', 'organization': '', 'rank': 6}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/c9bba311-351a-555d-8564-a5cfc082366d', 'word_count': 0, 'uri': 'nyt://video/c9bba311-351a-555d-8564-a5cfc082366d'}, {'abstract': 'Although the private equity firms that own SunGard are selling it for less than what they paid, they can expect a modest return on their investment.', 'web_url': 'https://www.nytimes.com/2015/08/13/business/dealbook/sungard-sale-has-a-bright-side-for-owners.html', 'snippet': 'Although the private equity firms that own SunGard are selling it for less than what they paid, they can expect a modest return on their investment.', 'lead_paragraph': 'At first glance, it would appear that the $9.1 billion sale, including debt, of the financial software maker SunGard to Fidelity National Information Services would be a disappointment to the private equity firms that paid nearly $11 billion for Sungard.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'SunGard Sale Has a Bright Side for Owners', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Private Equity', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mergers, Acquisitions and Divestitures', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Fidelity National Information Services Inc', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Sungard Data Systems Inc', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-08-12T18:50:10+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'DealBook', 'byline': {'original': 'By Michael J. de la Merced', 'person': [{'firstname': 'Michael', 'middlename': 'J.', 'lastname': 'de la Merced', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/111726ae-adfa-5e96-98e2-8107c36b7fc2', 'word_count': 529, 'uri': 'nyt://article/111726ae-adfa-5e96-98e2-8107c36b7fc2'}, {'abstract': 'Summertime highlights, when Berliners head outdoors, include a boat tour, riverside restaurants and evenings enjoying the view from a rooftop playground.', 'web_url': 'https://www.nytimes.com/2015/08/16/travel/what-to-do-in-36-hours-in-berlin.html', 'snippet': 'Summertime highlights, when Berliners head outdoors, include a boat tour, riverside restaurants and evenings enjoying the view from a rooftop playground.', 'lead_paragraph': 'There are few cities in the world that transform themselves as profoundly from season to season as Berlin. The purgatorial winter, with its lightless days and frigid nights, gives way to four months of balmy intoxication. Cafe and gallery culture spills out into graffitied alleyways; the parks fill with techno D.J.s, nudists and picnicking families; and young people arrive by the planeload from Brooklyn, Copenhagen and East London to take part in an open-air night-life scene that is equal parts “Paris Is Burning” and “A Midsummer Night’s Dream.” But even as the hype of the last decade has made the city a magnet for tourists, Berlin remains a place for the strange and libertine, where the radical left still nips at the heels of neoliberalism, where snapping photos in public is often more taboo than smoking a joint, and where people seldom ask what it is you “do.”', 'print_section': 'TR', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '36 Hours in Berlin', 'kicker': '36 Hours', 'content_kicker': None, 'print_headline': '36 Hours in Berlin', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Wilder, Charly', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Berlin (Germany)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Holocaust and the Nazi Era', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Google Maps', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-08-12T18:54:25+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Charly Wilder', 'person': [{'firstname': 'Charly', 'middlename': None, 'lastname': 'Wilder', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6661793f-b312-5ec7-b5c2-8500fef00f08', 'word_count': 1594, 'uri': 'nyt://article/6661793f-b312-5ec7-b5c2-8500fef00f08'}, {'abstract': 'This original musical from the married team of Robert Lopez and Kristen Anderson-Lopez, who won an Oscar for their song “Let It Go,” is making its premiere at La Jolla Playhouse.', 'web_url': 'https://www.nytimes.com/2015/08/13/theater/review-in-up-here-boy-and-all-his-inner-demons-and-angels-meets-girl.html', 'snippet': 'This original musical from the married team of Robert Lopez and Kristen Anderson-Lopez, who won an Oscar for their song “Let It Go,” is making its premiere at La Jolla Playhouse.', 'lead_paragraph': 'SAN DIEGO, Calif. — Geek meets girl. Geek’s neuroses drive him batty. Geek loses girl.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/13/arts/13UPHERE2-1439404739703/13UPHERE2-1439404739703-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/13/arts/13UPHERE2-1439404739703/13UPHERE2-1439404739703-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/13/arts/13UPHERE2-1439404739703/13UPHERE2-1439404739703-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 