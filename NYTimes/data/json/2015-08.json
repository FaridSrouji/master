url': 'images/2015/08/13/us/13firstdraft-newsletter/13firstdraft-newsletter-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Today in Politics: A Full Field Takes a Bipartisan Trip to the Fair', 'kicker': 'First Draft', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Abedin, Huma', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Bush, Jeb', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Carson, Benjamin S', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Carter, Jimmy', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Clinton, Hillary Rodham', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Cruz, Ted', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Fiorina, Carleton S', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Kasich, John R', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 10, 'major': 'N'}], 'pub_date': '2015-08-13T10:54:34+0000', 'document_type': 'article', 'news_desk': 'Politics', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/bf312544-b77a-59f9-81fa-e38ef438a6a7', 'word_count': 1494, 'uri': 'nyt://article/bf312544-b77a-59f9-81fa-e38ef438a6a7'}, {'abstract': 'Saving wild animals — even just one — can be a way of pushing back against the harm that humans cause to the natural world.', 'web_url': 'https://www.nytimes.com/2015/08/16/magazine/rescuing-wildlife-is-futile-and-necessary.html', 'snippet': 'Saving wild animals — even just one — can be a way of pushing back against the harm that humans cause to the natural world.', 'lead_paragraph': 'In a plastic dishpan on Judith Wakelam’s kitchen table, six huge, dark eyes gaze up at me from a huddle of pale-fringed faces and dusty black feathers, bladelike wings projecting outward at a variety of unlikely angles. These are baby common swifts, insectivorous birds so exquisitely aerial that they eat, sleep and mate on the wing and spend the first two or three years of their lives migrating between Europe and Africa in continuous flight.', 'print_section': 'MM', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/16/magazine/16onnature1/16mag-16onnature-t_CA1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/16/magazine/16onnature1/16mag-16onnature-t_CA1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/16/magazine/16onnature1/16mag-16onnature-t_CA1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/16/magazine/16onnature1/16mag-16onnature-t_CA1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/16/magazine/16onnature1/16mag-16onnature-t_CA1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/16/magazine/16onnature1/16mag-16onnature-t_CA1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/16/magazine/16onnature1/16mag-16onnatur