arts/28ENDLESS/28ENDLESS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 490}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/28/arts/28ENDLESS/28ENDLESS-jumbo.jpg', 'height': 837, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/28/arts/28ENDLESS/28ENDLESS-superJumbo.jpg', 'height': 1673, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/28/arts/28ENDLESS/28ENDLESS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/28/arts/28ENDLESS/28ENDLESS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/28/arts/28ENDLESS/28ENDLESS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: ‘Endless House’ Expands the Definition of Home', 'kicker': 'Art Review', 'content_kicker': None, 'print_headline': 'Dwellings That Defy the Idea of Home ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Farago, Jason', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Museum of Modern Art', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'ARCHITECTURE', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Kiesler, Frederick', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Gadanho, Pedro', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-08-27T22