major': 'N'}, {'name': 'glocations', 'value': 'Louisiana', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-08-24T21:41:44+0000', 'document_type': 'multimedia', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By REUTERS', 'person': [], 'organization': 'REUTERS'}, 'type_of_material': 'Video', '_id': 'nyt://video/64c3d2a7-293c-552f-aa4f-b40b8ee98987', 'word_count': 0, 'uri': 'nyt://video/64c3d2a7-293c-552f-aa4f-b40b8ee98987'}, {'abstract': 'Ms. Moss discusses portraying Peggy on “Mad Men” for seven seasons, earning six Emmy nominations for the role.', 'web_url': 'https://www.nytimes.com/2015/08/25/arts/television/elisabeth-moss-on-her-emmy-nomination-and-how-to-follow-success-of-peggy-olson.html', 'snippet': 'Ms. Moss discusses portraying Peggy on “Mad Men” for seven seasons, earning six Emmy nominations for the role.', 'lead_paragraph': 'Over seven seasons, the character Peggy Olson on “Mad Men” grew from mousy secretary to advertising dynamo. While that AMC show may have started out focusing on the man in the corner office, in the end it was Peggy’s journey that captivated and compelled many viewers. While Don Draper battled inner demons, Peggy battled society, pushing the boundaries of what women could achieve in the work force of the 1960s. ', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/25/arts/25MOSS/25MOSS-articleLarge.jpg', 'height': 367, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/25/arts/25MOSS/25MOSS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 367}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/25/arts/25MOSS/25MOSS-jumbo.jpg', 'height': 626, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None