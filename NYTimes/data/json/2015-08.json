-review/at_sea/at_sea-articleLarge.gif', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/06/sunday-review/at_sea/at_sea-articleLarge.gif', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/06/sunday-review/at_sea/at_sea-jumbo.gif', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/06/sunday-review/at_sea/at_sea-superJumbo.gif', 'height': 1920, 'width': 1920, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/06/sunday-review/at_sea/at_sea-thumbStandard.gif', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/06/sunday-review/at_sea/at_sea-thumbStandard.gif', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/06/sunday-review/at_sea/at_sea-thumbLarge.gif', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'At Sea With Joseph Conrad', 'kicker': 'Opinion', 'content_kicker': None, 'print_headline': 'At Sea With Joseph Conrad', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Sailboats and Sailing', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Jasanoff, Maya', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Conrad, Joseph', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Oceans and Seas', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-08-07T21:08:29+0000', 'documen