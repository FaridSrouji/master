ltimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/20/upshot/25UP-Child/25UP-Child-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/20/upshot/25UP-Child/25UP-Child-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/20/upshot/25UP-Child/25UP-Child-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/20/upshot/25UP-Child/25UP-Child-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/20/upshot/25UP-Child/25UP-Child-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/20/upshot/25UP-Child/25UP-Child-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/20/upshot/25UP-Child/25UP-Child-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Federal Intervention in Schools? It Happens Less Than Critics Think', 'kicker': 'Education Reform', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Education (K-12)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'No Child Left Behind Act', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Charter Schools', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Tests and Examinations', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'States (US)', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-08-20T11:00:04+0000', 'document_type': 'article', 'news_desk': 'Upshot', 'section_name': 'The Upshot', 'byline': {'original': 'By Kevin Carey', 'person': [{'firstname': 'Kevin', 'middlename': None, 'lastname': 'Carey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b65f9460-47b2-5c70-8042-1d01af0035c0', 'word_count': 1233, 'uri': 'nyt://article/b65f9460-47b2-5c70-8042-1d01af0035c0'}, {'abstract': 'Harvesters in Quebec, who provide 70 percent of the world’s supply, must sell through a central system, but some flout the requirement.', 'web_url': 'https://www.nytimes.com/2015/08/23/business/international/canadian-maple-syrup-producers-clash-with-law.html', 'snippet': 'Harvesters in Quebec, who provide 70 percent of the world’s supply, must sell through a central system, but some flout the requirement.', 'lead_paragraph': 'The scenic and narrow lane that leads to Robert Hodge’s sugar camp is surrounded by a cat’s cradle of plastic piping that draws sap from 12,000 trees. At the end of the lane, a ramshackle hut contains reverse osmosis pumps to concentrate the harvest. A stainless steel evaporator, about the size of a truck, finishes the conversion into maple syrup.', 'print_section': 'BU', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Canadian Maple Syrup ‘Rebels’ Clash With Law', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Maple Syrup Mavericks', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Austen, Ian', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Maple Syrup and Sugar', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Quebec Province (Canada)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Agriculture and Farming', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Canada', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Federation of Quebec Maple Syrup Producers', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Prices (Fares, Fees and Rates)', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Fines (Penalties)', 'rank': 8, 'major': 'N'}], 'pub_date': '2015-08-20T11:00:05+0000', 'document_type': 'article', 'news_desk': 'SundayBusiness', 'section_name': 'Business Day', 'subsection_name': 'International Business', 'byline': {'original': 'By Ian Austen', 'person': [{'firstname': 'Ian', 'middlename': None, 'lastname': 'Austen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ae20563e-9bb8-5a2f-8f99-8dc843d79555', 'word_count': 2123, 'uri': 'nyt://article/ae20563e-9bb8-5a2f-8f99-8dc843d79555'}, {'abstract': 'The next generation of the country’s athlete-émigrés most likely will be ordinary rookies instead of runaways. But these major-league players got here the hard way.', 'web_url': 'https://www.nytimes.com/2015/08/23/magazine/baseballs-last-cuban-escapees.html', 'snippet': 'The next generation of the country’s athlete-émigrés most likely will be ordinary rookies instead of runaways. But these major-league players got here the hard way.', 'lead_paragraph': 'For foreign baseball players hoping to make it in America, just about every conceivable journey — the 1,300 miles from Venezuela, the 5,000 miles from Japan, the 7,000 miles from Australia — has been easier than the 90 short miles from Cuba. That trip, over the last 50 years, has involved almost mythic hardships: improvised rafts, drug lords, ransoms, death threats, forgery, machine guns on the high seas. And yet the Cuban players have come, drawn by the promise of freedom, glory and outrageous capitalist paydays.', 'print_section': 'MM', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/23/magazine/23cubans1/23cubans1-articleLarge-v2.jpg', 'height': 320, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/23/magazine/23cubans1/23cubans1-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 320}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/23/magazine/23cubans1/23cubans1-jumbo-v2.jpg', 'height': 547, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/23/magazine/23cubans1/23cubans1-superJumbo-v2.jpg', 'height': 1094, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/23/magazine/23cubans1/23cubans1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/23/magazine/23cubans1/23cubans1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/23/magazine/23cubans1/23cubans1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Baseball’s Last Cuban Escapees', 'kicker': 'Feature', 'content_kicker': None, 'print_headline': 'Home and Away', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Cuba', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Baseball', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Major League Baseball', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 