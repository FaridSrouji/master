': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/07/science/07quake-a/07quake-a-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/07/science/07quake-a/07quake-a-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/07/science/07quake-a/07quake-a-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/07/science/07quake-a/07quake-a-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/07/science/07quake-a/07quake-a-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/07/science/07quake-a/07quake-a-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/07/science/07quake-a/07quake-a-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Studies of Nepal Quake Raise Concern About Skyscrapers   ', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Earthquakes', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Geology', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Nepal', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Buildings (Structures)', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-08-06T22:01:00+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'Science', 'byline': {'original': 'By Kenneth Chang', 'person': [{'firstname': 'Kenneth', 'middlename': None, 'lastname': 'Chang', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/053c6cb5-2dfa-53a9-8e8f-ecdc21a4a196', 'word_count': 703, 'uri': 'nyt://article/053c6cb5-2dfa-53a9-8e8f-ecdc21a4a196'}, {'abstract': 'Diablo Cody wrote and Jonathan Demme directed this film about a rocker who returns to mend a crisis in the family she abandoned.', 'web_url': 'https://www.nytimes.com/2015/08/07/movies/review-ricki-and-the-flash-puts-meryl-streep-behind-a-telecaster.html', 'snippet': 'Diablo Cody wrote and Jonathan Demme directed this film about a rocker who returns to mend a crisis in the family she abandoned.', 'lead_paragraph': '“Ricki and the Flash,” a gentle-hearted baby boomer guilt-trip family drama directed by Jonathan Demme and written by Diablo Cody, is bookended by two musical performances from the rock ’n’ roll bar band that gives the movie its name. It would be a spoiler to say too much about the number that ends the movie, a Bruce Springsteen cover, but the opener, sung to a sparse, appreciative audience at a scruffy club in Tarzana, Calif., is a competent version of an old hit by Tom Petty. (If that name doesn’t ring a bell, go ask your dad.) Ricki, the lead singer, sporting a blue Telecaster, heavy eyeliner and half of Bo Derek’s haircut from “10” (ask your dad about that too), belts out the lyrics with perfect credibility, landing somewhere between Chrissie Hynde and Bonnie Raitt on the spectrum of available reference points. ', 'print_section': 'C', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/07/arts/07RICKI/07RICKI-articleLarge.jpg', 'height': 356,