icleLarge', 'legacy': {'xlarge': 'images/2015/08/06/t-magazine/06cobbler-donnelly-1/06cobbler-donnelly-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 444}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/06/t-magazine/06cobbler-donnelly-1/06cobbler-donnelly-1-jumbo.jpg', 'height': 675, 'width': 913, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/06/t-magazine/06cobbler-donnelly-1/06cobbler-donnelly-1-superJumbo.jpg', 'height': 675, 'width': 913, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/06/t-magazine/06cobbler-donnelly-1/06cobbler-donnelly-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/06/t-magazine/06cobbler-donnelly-1/06cobbler-donnelly-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/06/t-magazine/06cobbler-donnelly-1/06cobbler-donnelly-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'From an Unfussy New Orleans Cafe, a Summer Cobbler', 'kicker': 'Food Matters', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-08-07T04:00:00+0000', 'document_type': 'article', 'news_desk': 'TDesign', 'section_name': 'T Magazine', 'byline': {'original': 'By Kate Donnelly', 'person': [{'firstname': 'Kate', 'middlename': None, 'lastname': 'Donnelly', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_