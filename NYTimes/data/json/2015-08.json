'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Endowments', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Tuition', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Private Equity', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Hedge Funds', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Philanthropy', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Harvard University', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Yale University', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Texas', 'rank': 10, 'major': 'N'}, {'name': 'organizations', 'value': 'Stanford University', 'rank': 11, 'major': 'N'}, {'name': 'organizations', 'value': 'Princeton University', 'rank': 12, 'major': 'N'}], 'pub_date': '2015-08-19T07:21:04+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Victor Fleischer', 'person': [{'firstname': 'Victor', 'middlename': None, 'lastname': 'Fleischer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/f6104597-9e8b-5223-9f1b-33c283078e0e', 'word_count': 896, 'uri': 'nyt://article/f6104597-9e8b-5223-9f1b-33c283078e0e'}, {'abstract': 'My family is so assimilated that I had to research Chinese burial traditions online, but our heritage is passed down in other ways.', 'web_url': 'https://opinionator.blogs.nytimes.com/2015/08/19/for-my-father-resurrecting-the-ancient-rituals/', 'snippet': 'My family is so assimilated that I had to research Chinese burial traditions online, but our heritage is passed down in other ways.', 'lead_paragraph': 'Even after the Parkinson’s diagnosis, my father seemed invincible. When a truck sideswiped his car, flipping it over, he hung upside down by his seat belt, his glasses on and intact. He’d taken a taxi home from the hospital, rather than calling my mother for a ride and upsetting her. And he’d survived falls, cracked one kneecap, and then the other, bruised his face, and healed each time. Iron bones, to match an iron will.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/30/opinion/opinionator-theend-series-icon/opinionator-theend-series-icon-articleLarge.png', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/30/opinion/opinionator-theend-series-icon/opinionator-theend-series-icon-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/30/opinion/opinionator-theend-series-icon/opinionator-theend-series-icon-jumbo.png', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/30/opinion/opinionator-theend-series-icon/opinionator-theend-series-icon-superJumbo.png', 'height': 1024, 'width': 1024, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/30/opinion/opinionator-theend-series-icon/opinionator-theend-series-icon-thumbStandard-v2.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/30/opinion/opinionator-theend-series-icon/opinionator-theend-series-icon-thumbStandard-v2.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/30/opinion/opinionator-theend-series-icon/opinionator-theend-series-icon-thumbLarge-v2.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'lega