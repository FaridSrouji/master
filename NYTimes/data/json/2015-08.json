rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/801d80ca-3adc-554b-844f-ba2a261d9d99', 'word_count': 187, 'uri': 'nyt://article/801d80ca-3adc-554b-844f-ba2a261d9d99'}, {'abstract': 'The government said it stopped making contributions to a fund that would pay an additional $13 billion in bond debt.', 'web_url': 'https://www.nytimes.com/2015/08/05/business/dealbook/puerto-rico-has-another-debt-worry-on-horizon.html', 'snippet': 'The government said it stopped making contributions to a fund that would pay an additional $13 billion in bond debt.', 'lead_paragraph': 'While Puerto Rico’s first bond default in its history reverberated through the financial markets on Tuesday, another move by the cash-poor island may provide a clue to where the next trouble spot lies.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/05/business/05db-rico-web/05db-rico-web-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/05/business/05db-rico-web/05db-rico-web-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/05/business/05db-rico-web/05db-rico-web-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/05/business/05db-rico-web/05db-rico-web-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/05/business/05db-rico-web/05db-rico-web-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'th