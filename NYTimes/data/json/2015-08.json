ght': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Russian Pagans Continue Ancient Traditions', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-08-18T23:59:36+0000', 'document_type': 'multimedia', 'news_desk': 'Blogs', 'section_name': 'Blogs', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/590d6b85-795b-5c22-919d-cd105208e050', 'word_count': 0, 'uri': 'nyt://slideshow/590d6b85-795b-5c22-919d-cd105208e050'}, {'abstract': 'The organization called the problem “a growing challenge for countries seeking to close the immunization gap.”', 'web_url': 'https://www.nytimes.com/2015/08/19/world/who-calls-vaccine-hesitancy-an-increasing-concern-globally.html', 'snippet': 'The organization called the problem “a growing challenge for countries seeking to close the immunization gap.”', 'lead_paragraph': ' The World Health Organization warned Tuesday of what it called the growing problem of “vaccine hesitancy,” when people delay or refuse vaccines for themselves or their children. In a statement on its website, the organization called the problem “a growing challenge for countries seeking to close the immunization gap.” Globally, the organization said, one in five children still do not receive routine lifesaving immunizations, and 1.5 million children die each year of diseases that could have been thwarted by vaccines. ', 'print_section': 'A', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'W.H.O. Calls ‘Vaccine Hesitancy’ an Increasing Concern Globally', 'kicker': 'World Briefing', 'content_kicker': None, 'print_headline': 'W.H.O. Calls ‘Vaccine Hesitancy’ an Increasing Concern Globally', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Vaccination and Immunization', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Children and Childhood', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'World Health Organization', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-08-19T00:02:59+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'byline': {'original': 'By Rick Gladstone', 'person': [{'firstname': 'Rick', 'middlename': None, 'lastname': 'Gladstone', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/2c737df9-4487-56f2-ac6a-563bc09b249b', 'word_count': 80, 'uri': 'nyt://article/2c737df9-4487-56f2-ac6a-563bc09b249b'}, {'abstract': 'The team said Parnell had right shoulder tendinitis, but Terry Collins suggested the move was made so that Parnell could tweak his mechanics out of the spotlight of a playoff race.', 'web_url': 'https://www.nytimes.com/2015/08/19/sports/baseball/mets-orioles-bobby-parnell.html', 'snippet': 'The team said Parnell had right shoulder tendinitis, but Terry Collins suggested the move was made so that Parnell could tweak his mechanics out of the spotlight of a playoff race.', 'lead_paragraph': 'BALTIMORE — After Bobby Parnell was booed off the mound Sunday during an embarrassing Mets loss, his manager, Terry Collins, approached him about taking a break. Parnell was obviously still feeling the effects of Tommy John surgery. He might not feel pain, Collins told him, but it was natural for him to need time to regain his touch.', 'print_section': 'B', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/19/sports/CITY-METS/CITY-METS-articleLarge.jpg', 'height': 462, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/19/sports/CITY-METS/CITY-METS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 462}},