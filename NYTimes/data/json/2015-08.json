or': 'N'}, {'name': 'persons', 'value': 'Isaacs, Cheryl Boone', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-08-05T16:22:06+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Michael Cieply', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Cieply', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0f50e303-45ea-55f5-b6ce-2a651f26a3c6', 'word_count': 129, 'uri': 'nyt://article/0f50e303-45ea-55f5-b6ce-2a651f26a3c6'}, {'abstract': 'Who’s really being taken in?', 'web_url': 'https://krugman.blogs.nytimes.com/2015/08/05/style-substance-and-the-donald/', 'snippet': 'Who’s really being taken in?', 'lead_paragraph': 'Just about the entire political commentariat has been caught completely flatfooted by Donald Trump’s durable front-runner status; he was supposed to collapse after being nasty to St. John McCain, but nothing of the sort happened.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Style, Substance, and The Donald', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-08-05T16:28:20+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8307ee39-6782-567e-881c-0462764594a4', 'word_count': 311, 'uri': 'nyt://article/8307ee39-6782-567e-881c-0462764594a4'}, {'abstract': 'The activist, feminist art collective began protesting inequality at New York museums in 1985. Now, their work appears in them.', 'web_url': 'https://www.nytimes.com/2015/08/09/arts/design/the-guerrilla-girls-after-3-decades-still-rattling-art-world-cages.html', 'snippet': 'The activist, feminist art collective began protesting inequality at New York museums in 1985. Now, their work appears in them.', 'lead_paragraph': 'When you’ve spent 30 years wearing a gorilla mask, as the women known by the aliases Frida Kahlo and Käthe Kollwitz have, certain behavior becomes second nature. So there were Kahlo and Kollwitz, two of the pseudonymous founding members of the Guerrilla Girls, the activist, feminist art collective, preening and posing at their 30th anniversary party and retrospective in May. They sipped prosecco through straws (their gorilla lips wouldn’t allow much more) at the Abrons Arts Center on the Lower East Side, while guests gazed at walls lined with the posters protesting elitism and bias that first shook the art world in the 1980s. “Do Women Have to Be Naked to Get Into the Met Museum?” one provocatively asked. The Guerrillas’ name tags identified them as pioneering dead female artists (like Alice Neel, the portraitist, or Zubeida Agha, the Pakistani modernist) whose legacies they hope to continue.', 'print_section': 'AR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Guerrilla Girls, After 3 Decades, Still Rattling Art World Cages', 'kicker': None, 'content_kicker': None, 'print_headline': 'Still Rattling Cages', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Guerrilla Girls', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Museums', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Walker Art Center', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'MoMA PS1', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': "Women's Rights", 'rank': 8, 'major': 'N'