rson': [{'firstname': 'Laura', 'middlename': None, 'lastname': 'Collins-Hughes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/37d9100a-17c1-52c2-b3e7-8cae89cdbf1a', 'word_count': 1071, 'uri': 'nyt://article/37d9100a-17c1-52c2-b3e7-8cae89cdbf1a'}, {'abstract': 'Catrina McHugh’s “Key Change,” directed by Laura Lindow, was commissioned by a development company in England that specializes in work with prisoners.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2015/08/28/play-about-incarcerated-women-wins-best-of-edinburgh-award/', 'snippet': 'Catrina McHugh’s “Key Change,” directed by Laura Lindow, was commissioned by a development company in England that specializes in work with prisoners.', 'lead_paragraph': 'EDINBURGH — The real stories and experiences of women in a United Kingdom prison form the basis for “Key Change,” this year’s winner of the annual Carol Tambor Best of Edinburgh Award, to be announced here on Friday. The award is presented each year to a single theater production at the Edinburgh Festival Fringe that has never been presented in New York City, and the winning show is produced the following winter in New York. Past winners of the prize include “The Object Lesson,” written and performed by Geoff Sobelle, and David Greig’s “The Events.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Play About Incarcerated Women Wins Best of Edinburgh Award', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Edinburgh Festival Fringe', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Greig, David', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Sobelle, Geoff', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Tambor, Carol', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Theater W