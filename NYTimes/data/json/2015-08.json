eadline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-08-12T16:56:55+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1c57829b-7a07-59c5-9a23-00bd3797fb95', 'word_count': 482, 'uri': 'nyt://article/1c57829b-7a07-59c5-9a23-00bd3797fb95'}, {'abstract': 'Marco Rubio supports linking student loan repayments to borrowers’ incomes — but that’s not a solution to high college costs.', 'web_url': 'https://takingnote.blogs.nytimes.com/2015/08/12/paying-for-college-election-edition/', 'snippet': 'Marco Rubio supports linking student loan repayments to borrowers’ incomes — but that’s not a solution to high college costs.', 'lead_paragraph': 'The Editorial Board recently pointed out that the Democratic presidential candidates Hillary Clinton and Bernie Sanders have announced plans to make college more affordable, while the only rumbling from the Republican camp so far is Senator Marco Rubio’s support for linking loan repayments to borrowers’ incomes.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/12/opinion/12tritchWEB2/12tritchWEB2-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/12/opinion/12tritchWEB2/12tritchWEB2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/12/opinion/12tritchWEB2/12tritchWEB2-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo