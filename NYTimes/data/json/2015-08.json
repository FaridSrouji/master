egacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/27/nyregion/27summerlove1/27summerlove1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/27/nyregion/27summerlove1/27summerlove1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/27/nyregion/27summerlove1/27summerlove1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Gorilla Match (or 5) at the Bronx Zoo', 'kicker': 'Summer Love', 'content_kicker': None, 'print_headline': 'Ernie Loves Julia. And Layla. And Tuti and Kumi and Suki.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Monkeys and Apes', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Winerip, Michael', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Bronx Zoo Wildlife Conservation Park', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Breeding of Animals', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Love (Emotion)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Zoos', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Safina, Carl', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-08-26T21:10:08+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Michael Winerip', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Winerip', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6b864e03-a8fd-5483-bb54-c8864a4d1a38', 'word_count': 1272, 'uri': 'nyt://article/6b864e03-a8fd-5483-bb54-c8864a4d1a38'}, {'abstract': 'The former Hewlett-Packard CEO argues that CNN’s method for picking debate participants could unfairly leave her out.', 'web_url': 'https://takingnote.blogs.nytimes.com/2015/08/26/carly-fiorina-cries-foul-at-the-gop-debate-cutoff/', 'snippet': 'The former Hewlett-Packard CEO argues that CNN’s method for picking debate participants could unfairly leave her out.', 'lead_paragraph': 'Will Carly Fiorina manage to get on the big stage next month in the second Republican presidential debate? The question is in part a technical one involving how poll numbers are weighed in rating Mrs. Fiorina before and after the Fox News debate earlier this month, where she stood out as a considerable winner despite being relegated to the also-ran set of candidates. It is also a question of how sensitive Republican leaders are to charges that the party habitually treats women as second-class citizens. Mrs. Fiorina, despite rising significantly in recent polls, argues that the Republican National Committee and CNN, the debate sponsor, are using a mix of old and new polling numbers that could unfairly block her from the prime-time show next month.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/26/opinion/26clinesWEB/26clinesWEB-articleLarge.jpg', 'height': 428, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/26/opinion/26clinesWEB/26clinesWEB-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 428}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/26/opinion/26clinesWEB/26clinesWEB-jumbo.jpg', 'height': 730, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/26/opinion/26clinesWEB/26clinesWEB-superJumbo.jpg', 'height': 1460, 'width': 2048, 'subType': 