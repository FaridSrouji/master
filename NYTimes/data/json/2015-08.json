Large-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 835}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/09/books/review/09CLIFF/09CLIFF-jumbo-v2.jpg', 'height': 1024, 'width': 736, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/09/books/review/09CLIFF/09CLIFF-superJumbo-v2.jpg', 'height': 2048, 'width': 1472, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/09/books/review/09CLIFF/09cliff-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/09/books/review/09CLIFF/09cliff-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/09/books/review/09CLIFF/09cliff-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Hugh Thomas’s ‘World Without End: Spain, Philip II, and the First Global Empire’', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Reign in Spain', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Thomas, Hugh (1931- )', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'World Without End: Spain, Philip II, and the First Global Empire (Book)', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-08-07T13:14:03+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Nigel Cliff', 'person': [{'firstname': 'Nigel', 'middlename': None, 'lastname': 'Cliff', 