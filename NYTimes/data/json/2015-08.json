0809-BKS-New-OrleansCVR-revise2/0809-BKS-New-OrleansCVR-revise2-articleLarge.jpg', 'height': 651, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/09/books/review/0809-BKS-New-OrleansCVR-revise2/0809-BKS-New-OrleansCVR-revise2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 651}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/09/books/review/0809-BKS-New-OrleansCVR-revise2/0809-BKS-New-OrleansCVR-revise2-jumbo.jpg', 'height': 1024, 'width': 945, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/09/books/review/0809-BKS-New-OrleansCVR-revise2/0809-BKS-New-OrleansCVR-revise2-superJumbo.jpg', 'height': 2048, 'width': 1889, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/09/books/review/0809-BKS-New-OrleansCVR-revise2/0809-BKS-New-OrleansCVR-revise2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/09/books/review/0809-BKS-New-OrleansCVR-revise2/0809-BKS-New-OrleansCVR-revise2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/09/books/review/0809-BKS-New-OrleansCVR-revise2/0809-BKS-New-OrleansCVR-revise2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Gary Rivlin’s ‘Katrina: After the Flood’', 'kicker': None, 'content_kicker': None, 'print_headline': 'Hurricane’s Wake', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Rivlin, Gary', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Hurricane Katrina (2005)', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'Katrina: After the Flood (Book)', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-08-05T09:00:04+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Nathaniel Rich', 'person': [{'firstname': 'Nathaniel', 'middlename': None, 'lastname': 'Rich', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/a13a0157-2d1e-5ff9-a3d6-30649bab4067', 'word_count': 1402, 'uri': 'nyt://article/a13a0157-2d1e-5ff9-a3d6-30649bab4067'}, {'abstract': 'An urbanist tracks the post-Katrina road to recovery. ', 'web_url': 'https://www.nytimes.com/2015/08/09/books/review/were-still-here-ya-bastards-by-roberta-brandes-gratz.html', 'snippet': 'An urbanist tracks the post-Katrina road to recovery. ', 'lead_paragraph': 'When I first lived in New Orleans, during the spring of 2005, the unfinished work of Reconstruction was much on my mind. An obelisk near the \xadMississippi River commemorates a revolt against the Reconstruction government led by former Confederate soldiers. Half a mile away, where Canal Street meets North Rampart, I’d wait at a bus stop among people going home post-shift — hotel chambermaids and kitchen workers in their black-and-white checkered pants — waiting to be carried away from the city’s hallucinatory core to the New Orleans that lay beyond, a city whose racialized inequality was so entrenched it masqueraded as the natural order of things. During a public forum on gentrification at the historic St. Augustine Church, people spoke of being under siege. A neighbor told me, “If you cut the ground here, it will bleed black.” ', 'print_section': 'BR', 'print_page': '10', 'source': 'The New York Times', 'mul