dlename': None, 'lastname': 'Pardlo', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/df708b01-5739-5503-8fde-8b9749df9bbc', 'word_count': 64, 'uri': 'nyt://article/df708b01-5739-5503-8fde-8b9749df9bbc'}, {'abstract': 'Nothing exposes a man to more judgment and ridicule than wearing shorts, whether they’re Boy Scout cargo-style or fashion-designer formal.', 'web_url': 'https://www.nytimes.com/2015/08/09/magazine/hes-got-legs.html', 'snippet': 'Nothing exposes a man to more judgment and ridicule than wearing shorts, whether they’re Boy Scout cargo-style or fashion-designer formal.', 'lead_paragraph': 'Up above the hems of a proper pair of trousers — above the ankle-\xadbaring ends of high-\xadwaters and clam-\xaddiggers, above the shin-\xadskimming edges of pants named for the isle of Capri and for the gauchos of the Pampas — are the knees. Bared by shorts, they point us toward a few truths about social standards. Women’s legs are tangled in their own sex-\xadsegregated history of social control and gender politics; shorts are, first off, short pants, and it was not so very long ago that women were told wearing pants of any length was prima facie evidence of moral turpitude. The man in shorts, meanwhile, occupies a space that is more subtly strange. Year after year, as surely as tender spring yields to scalding summer, a season of dress-\xadcode controversies gives way to a running conversation about the unwritten rules of urban spaces, with arbiters of taste cringing at men’s legs in shorts as if wincing at a comedy of embarrassment.', 'print_section': 'MM', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/09/magazine/09onclothing1/09mag-09onclothing-t_CA1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/09/magazine/09onclothing1/09mag-09onclothing-t_CA1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/09/magazine/09onclothing1/09mag-09onclothing-t_CA1-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/09/magazine/09onclothing1/09mag-09onclothing-t_CA1-superJumbo.jpg', 'height': 1170, 'width': 1756, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/09/magazine/09onclothing1/09mag-09onclothing-t_CA1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/09/magazine/09onclothing1/09mag-09onclothing-t_CA1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/09/magazine/09onclothing1/09mag-09onclothing-t_CA1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'He’s Got Legs', 'kicker': 'On Clothing', 'content_kicker': None, 'print_headline': 'He’s Got Legs', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Men and Boys', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-08-07T11:00:04+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Troy Patterson', 'person': [{'firstname': 'Troy', 'middlename': None, 'lastname': 'Patterson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e2c16849-e849-5518-976c-aa691f5b6fe5', 'word_count': 1430, 'uri': 'nyt://article/e2c16849-e849-5518-976c-aa691f5b6fe5'}, {'abstract': 'The fortified wine — especially the fragrant Spanish variety — deserves more than a supporting role in cocktails.', 'web_url': 'https://www.nytimes.com/2015/08/09/magazine/starring-vermouth.html', 'snippet': 'The fortified wine — especially the fragrant Spanish variety — deserves more than a supporting role in cocktails.', 'lead_paragraph': 'A few years ago, my brother asked me where I would like to spend my 40th birthday. I chose Spain, and he generously presented me with a plane ticket to Barcelona. I booked a sunny apartment with an abundance of colorful tiles. I got a ticket for an FC Barcelona match at Camp Nou. But in the weeks leading up to my birthday, my mother’s health declined precipitously. I couldn’t leave New York under the circumstances, and canceled the trip.', 'print_section': 'MM', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/09/magazine/09drink1/09mag-09drink-t_CA0-articleLarge.jpg', 'height': 899, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/09/magazine/09drink1/09mag-09drink-t_CA0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 899}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/09/magazine/09drink1/09mag-09drink-t_CA0-jumbo.jpg', 'height': 1024, 'width': 684, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/09/magazine/09drink1/09mag-09drink-t_CA0-superJumbo.jpg', 'height': 2048, 'width': 1367, 'subType': 'superJumbo', 'crop_name