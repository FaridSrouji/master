: 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In a First, a Sudanese Migrant Nearly Crosses the English Channel on Foot', 'kicker': None, 'content_kicker': None, 'print_headline': 'In a First, a Migrant Nearly Crosses the English Channel on Foot', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Middle East and Africa Migrant Crisis', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Bridges and Tunnels', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Great Britain', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'France', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Haroun, Abdul Rahman', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Illegal Immigration', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Channel Tunnel', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Calais (France)', 'rank': 8, 'major': 'N'}], 'pub_date': '2015-08-07T13:47:34+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Dan Bilefsky', 'person': [{'firstname': 'Dan', 'middlename': None, 'lastname': 'Bilefsky', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1e285dfa-044f-5849-847c-82416e8bda97', 'word_count': 1157, 'uri': 'nyt://article/1e285dfa-044f-5849-847c-82416e8bda97'}, {'abstract': 'A young orphan and a widow run a charity scam amid the corruption of World War II London.', 'web_url': 'https://www.nytimes.com/2015/08/09/books/review/crooked-heart-by-lissa-evans.html', 'snippet': 'A young orphan and a widow run a charity scam amid the corruption of World War II London.', 'lead_paragraph': 'Show of hands: Was anybody here an odd-looking, precocious, misunderstood child? Oh. .\u2008.\u2008. Everybody? Maybe that’s why so many of the novels we love most, from Brontë’s “Jane Eyre” to Rowling’s Harry Potter series, feature some version of this small person. We are gutted not by Scout or Jem in “To Kill a Mockingbird,” but by Dill, the fatherless fantabulist; we may admire Sara Crewe when she’s a kind little heiress, but she’s truly a princess when she loses both her money and her dad. I’ll read anything that features an invisible, unloved child, an orphan either in reality or spirit, more resourceful than any wee one should have to be. Bonus points if the child finds ways to skirt the law. (I’m looking at you, Addie Pray.)', 'print_section': 'BR', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/09/books/review/09NEWMAN/09newman-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/09/books/review/09NEWMAN/09newman-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/09/books/review/09NEWMAN/09newman-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/09/books/review/09NEWMAN/09newman-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/09/books/review/09NEWMAN/09newman-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/09/books/review/09NEWMAN/09newman-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/09/books/review/09NEWMAN/09newman-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Crooked Heart,’ by Lissa Evans', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Grifters', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Newman, Judith', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Evans, Lissa', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'Crooked Heart (Book)', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-08-07T13:53:02+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Judith Newman', 'person': [{'firstname': 'Judith', 'middlename': None, 'lastname': 'Newman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/d070e7bd-4760-5df1-a4dd-7b054f05a5ce', 'word_count': 1012, 'uri': 'nyt://article/d070e7bd-4760-5df1-a4dd-7b054f05a5ce'}, {'abstract': 'A biography of the woman who married C.S. Lewis.', 'web_url': 'https://www.nytimes.com/2015/08/09/books/review/joy-poet-seeker-and-the-woman-who-captivated-cs-lewis.html', 'snippet': 'A biography of the woman who married C.S. Lewis.', 'lead_paragraph': 'Even if “Joy,” Abigail Santamaria’s life of C.S. Lewis’s wife, were a bad book, Lewis’s zealous admirers would read it, eager for another way to finger his shroud. Joy Davidman married Lewis, author of the beloved “Chronicles of Narnia,” at 41, and her late entrance into his bachelor existence is a cherished part of his legend. She soon died of bone cancer, but she had made him a husband and stepfather, adding an intimate touch to the genial but distant self-portrait that emerges from his grown-up books, tracts like “Mere Christianity.” Her death was also the subject of “A Grief Observed,” his classic book on mourning and how faith can survive it.', 'print_section': 'BR', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/09/books/review/09OPPENHEIMER/09oppenheimer-articleLarge.jpg', 'height': 868, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/09/books/review/09OPPENHEIMER/09oppenheimer-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 868}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/09/books/review/09OPPENHEIMER/09oppenheimer-jumbo.jpg', 'height': 1024, 'width': 708, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/09/books/review/09OPPENHEIMER/09oppenheimer-superJumbo.jpg', 'height': 1074, 'width': 742, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/09/books/review/09OPPENHEIMER/09oppenheimer-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/09/books/review/09OPPENHEIMER/09oppenheimer-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/09/books/review/09OPPENHEIMER/09oppenheimer-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Joy: Poet, Seeker, and the Woman Who Captivated C.S. Lewis’', 'kicker': None, 'content_kicker': None, 'print_headline': 'An Allegory of Love', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Santamaria, Abigail (1978- )', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Lewis, C S', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Poetry and Poets', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Writing and Writers', 'rank': 6, 'major': 'N'}, {'name': 'creative_works', 'value': 'Joy: Poet, Seeker, and the Woman Who Captivated C S Lewis (Book)', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-08-07T13:54:02+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Mark Oppenheimer', 'person': [{'firstname': 'Mark', 'middlename': None, 'lastname': 'Oppenheimer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/0085e7cf-7747-55c0-9c8d-752823400f28', 'word_count': 646, 'uri': 'nyt://article/0085e7cf-7747-55c0-9c8d-752823400f28'}, {'abstract': 'About that Obama disaster ….', 'web_url': 'https://krugman.blogs.nytimes.com/2015/08/07/the-economy-vanishes/', 'snippet': 'About that Obama disaster ….', 'lead_paragraph': 'There was almost no discussion of the economy in last night’s debate, which is actually weird if you consider the Republican self-image. These guys portray themselves as high priests of growth, the people who know how to bring prosperity. And remember all the crowing about how Obama was presiding over the worst recovery ever?', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Economy Vanishes', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-08-07T13:55:03+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/eebe3b54-e0ef-5cfa-bc51-401258cc34b1', 'word_count': 247, 'uri': 'nyt://article/eebe3b54-e0ef-5cfa-bc51-401258cc34b1'}, {'abstract': 'In addition to his well-known roles in films like “Dead Poets Society,” the actor worked on a wide range of less-celebrated films, from “Popeye” to “World’s Greatest Dad.”', 'web_url': 'https://www.nytimes.com/2015/08/09/movies/robin-williamss-underrated-roles-help-illustrate-his-major-talents.html', 'snippet': 'In addition to his well-known roles in films like “Dead Poets Society,” the actor worked on a wide range of less-celebrated films, from “Popeye” to “World’s Greatest Dad.”', 'lead_paragraph': 'This summer brings in close proximity two sad milestones for fans of Robin Williams: July 21 would have been the 64th birthday of this inventive comedian and Academy Award-winning actor, and Aug. 11 is the one-year anniversary of his death. It is a bittersweet occasion to reflect on the range of work that Williams created, as he bounded from classically trained stage actor to stand-up comedian, and from a star of sitcoms to a leading man in movies. While a full consideration of Williams’s career would naturally gravitate toward his sympathetic serio-comic roles in films like “Good Morning Vietnam,” “Dead Poets Society” and “Good Will Hunting,” these performances overshadow other, more idiosyncratic but equally vivid efforts — some from a time when his on-screen persona hadn’t completely coalesced, and others he was able to sneak in once his fame was assured. Here are five of Williams’s less celebrated performances.', 'print_section': 'AR', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/09/arts/09ROBIN1/09ROBIN1-articleLarge.jpg', 'height': 406, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/09/arts/09ROBIN1/09ROBIN1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 406}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/09/arts/09ROBIN1/09ROBIN1-jumbo.jpg', 'height': 693, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/09/arts/09ROBIN1/09ROBIN1-superJumbo.jpg', 'height': 1386, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/09/arts/09ROBIN1/09ROBIN1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/09/arts/09ROBIN1/09ROBIN1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/09/arts/09ROBIN1/09ROBIN1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Robin Williams’s Underrated Roles Help Illustrate His Major Talents', 'kicker': None, 'content_kicker': None, 'print_headline': 'Hidden Highlights in a Major Career ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Williams, Robin', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-08-07T14:00:04+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Movies', 'byline': {'original': 'By Dave Itzkoff', 'person': [{'firstname': 'Dave', 'middlename': None, 'lastna