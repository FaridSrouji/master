le': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/72853a3a-dc12-5375-8082-7c607a4a4e20', 'word_count': 886, 'uri': 'nyt://article/72853a3a-dc12-5375-8082-7c607a4a4e20'}, {'abstract': 'How Diplo and Skrillex turned a ballad by Justin Bieber into an E.D.M hit.', 'web_url': 'https://www.nytimes.com/2015/08/26/arts/music/justin-bieber-goes-electronic-with-skrillex-and-diplo-help.html', 'snippet': 'How Diplo and Skrillex turned a ballad by Justin Bieber into an E.D.M hit.', 'lead_paragraph': 'On the radio, where it has been ubiquitous all summer, the million-selling single “Where Are Ü Now” by Skrillex and Diplo with Justin Bieber is four minutes of high-tech bliss: a sweet-voiced mixture of longing and recrimination, a lonely plaint with a dance beat.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Inside History of ‘Where Are Ü Now’', 'kicker': 'Critic’s Notebook', 'content_kicker': None, 'print_headline': 'A Union of High Notes and Bass ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Dancing', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Bieber, Justin', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Skrillex', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Pentz, Thomas (Diplo)', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Boyd, Jason (Poo Bear)', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-08-25T12:36:08+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Jon Pareles', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Pareles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6cb2a7ae-932e-5133-ba40-45b678033e7f', 'word_count': 1636, 'uri': 'nyt://article/6cb2a7ae-932e-5133-ba40-45b678033e7f'}, {'abstract': 'Paying families to leave the school system won’t help low-income students, or their struggling families.', 'web_url': 'https://www.nytimes.com/2015/08/26/opinion/why-vouchers-wont-fix-vegas-schools.html', 'snippet': 'Paying families to leave the school system won’t help low-income students, or their struggling families.', 'lead_paragraph': 'LAS VEGAS — FOR the past year, I’ve lived next door to a public elementary school. With my windows open in the morning, I can hear children’s laughter on the playground, and at 9 a.m., the Pledge of Allegiance over the intercom. My afternoon commute takes me past the entrance, where I see a diverse group of parents collecting their children, from white moms in yoga pants to Muslim women in hijab guiding their kids carefully through the crosswalk.', 'print_section': 'A', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/26/opinion/26Bronson/26Bronson-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/26/opinion/26Bronson/26Bronson-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/26/opinion/26Bronson/26Bronson-jumbo.jpg', 'height': 597, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/26/opinion/26Bronson/26Bronson-superJumbo.jpg', 'height': 1194, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/26/opinion/26Bronson/26Bronson-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/26/opinion/26Bronson/26Bronson-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/26/opinion/26Bronson/26Bronson-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Why Vouchers Won’t Fix Vegas Schools', 'kicker': 'Contributing Op-Ed Writer', 'content_kicker': None, 'print_headline': 'Can Vouchers Fix Vegas’s Schools?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Bronson, Brittany', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Education (K-12)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Private and Sectarian Schools', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Income Inequality', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Vouchers', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Las Vegas (Nev)', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Nevada', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-08-25T12:45:03+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By Brittany Bronson', 'person': [{'firstname': 'Brittany', 'middlename': None, 'lastname': 'Bronson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/ea5b0a7d-2ec0-5c13-9c0e-c60947bf6a4f', 'word_count': 849, 'uri': 'nyt://article/ea5b0a7d-2ec0-5c13-9c0e-c60947bf6a4f'}, {'abstract': 'From the International Herald Tribune archives: A handkerchief collector is sent to an asylum in Vienna in 1890.', 'web_url': 'https://iht-retrospective.blogs.nytimes.com/2015/08/25/1890-kerchief-keeper-called-insane/', 'snippet': 'From the International Herald Tribune archives: A handkerchief collector is sent to an asylum in Vienna in 1890.', 'lead_paragraph': 'There is good news from Vienna. A man who has devoted himself to collecting ladies’ handkerchiefs has been decided to be insane and has been placed in an asylum. If the collector of handkerchiefs is adjudged to be a lunatic, how can the collector of postage stamps be regarded as sane? Handkerchiefs have an intrinsic value and ladies’ handkerchiefs may be full of poetic and sacred associations, whereas the used postage stamp is valueless, ugly and devoid of any associations worth mentioning. — The New York Herald, European Edition, August 26, 1890', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/25/blogs/25iht-oldaug25-kerchief/25iht-oldaug25-kerchief-jumbo.png', 'height': 827, 'width': 491, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/25/blogs/25iht-oldaug25-kerchief/25iht-oldaug25-kerchief-superJumbo.png', 'height': 827, 'width': 491, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/25/blogs/25iht-oldaug25-kerchief/25iht-oldaug25-kerchief-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/25/blogs/25iht-oldaug25-kerchief/25iht-oldaug25-kerchief-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/25/blogs/25iht-oldaug25-kerchief/25iht-oldaug25-kerchief-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_na