/14GALACTIC-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/14/arts/14GALACTIC/14GALACTIC-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/14/arts/14GALACTIC/14GALACTIC-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: Galactic, Paying Tribute to New Orleans and Its Sounds', 'kicker': None, 'content_kicker': None, 'print_headline': 'Repaying a Debt of Funk to Its Source', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Galactic (Music Group)', 'rank': 2, 'major': 'N'}], 'pub_date': '2015-08-13T22:20:37+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Nate Chinen', 'person': [{'firstname': 'Nate', 'middlename': None, 'lastname': 'Chinen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/9c47eb91-fd1e-5429-82d0-77b692469668', 'word_count': 503, 'uri': 'nyt://article/9c47eb91-fd1e-5429-82d0-77b692469668'}, {'abstract': 'Hubert Sauper’s documentary blends striking visuals with a pointed argument that outside investors seeking profits played a big role in the region’s independence movement.', 'web_url': 'https://www.nytimes.com/2015/08/14/movies/review-we-come-as-friends-explores-potential-exploitation-of-south-sudan.html', 'snippet': 'Hubert Sauper’s documentary blends striking visuals with a pointed argument that outside investors seeking profits played a big role in the region’s independence movement.', 'lead_paragraph': 'In “Darwin’s Nightmare” (2005), a searing Oscar-nominated documentary about economic exploitation in Tanzania, the director Hubert Sauper found a perfect microcosm for colonialism in the invasive Nile perch. The fish was artificially introduced into Lake Victoria in the 1950s and ’60s, ate all the other fish and then was exported as food for Europe and Japan. In the meantime, Tanzania suffered from a famine, and as the film repeatedly sought to demonstrate, the planes arriving to pick up the fish sometimes brought in weapons for use in the continent’s civil wars.', 'print_section': 'C', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/14/arts/14WECOME/14WECOME-articleLarge.jpg', 'height': 335, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/14/arts/14WECOME/14WECOME-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 335}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/14/arts/14WECOME/14WECOME-jumbo.jpg', 'height': 572, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/14/arts/14WECOME/14WECOME-superJumbo.jpg', 'height': 1145, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/14/arts/14WECOME/14WECOME-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/14/arts/14WECOME/14WECOME-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/14/arts/14WECOME/14WECOME-thumbLarge.jpg', 'height': 150, '