orts/Y-CROUSE/Y-CROUSE-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/14/sports/Y-CROUSE/Y-CROUSE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/14/sports/Y-CROUSE/Y-CROUSE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/14/sports/Y-CROUSE/Y-CROUSE-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Rory McIlroy Returns, and Is Tested Immediately', 'kicker': None, 'content_kicker': None, 'print_headline': 'Injury and Course Prompt McIlroy to Tread Carefully', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Crouse, Karen (Per)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Golf', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'McIlroy, Rory', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Spieth, Jordan', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'PGA Championship', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-08-14T01:45:28+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Golf', 'byline': {'original': 'By Karen Crouse', 'person': [{'firstname': 'Karen', 'middlename': None, 'lastname': 'Crouse', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bcb56551-7328-549b-b91c-7aa6e63b10d9', 'word_count': 1040, 'uri': 'nyt://article/bcb56551-7328-549b-b91c-7aa6e63b10d9'}, {'abstract': 'Natan Last and the J.A.S.A. class offer us a great entry into the weekend.', 'web_url': 'https://wordplay.blogs.nytimes.com/2015/08/13/storys-opening/', 'snippet': 'Natan Last and the J.A.S.A. class offer us a great entry into the weekend.', 'lead_paragraph': 'FRIDAY PUZZLE — The Jewish Association Serving the Aging, or J.A.S.A. as it’s popularly known, provides services for people age 55 and up in new York City, and one of the classes taught there is the fine art of crossword puzzle construction. The class has been taught by a variety of familiar constructor names, including Ian Livengood, Finn Vigeland and now Natan Last and, if the puzzle passes muster, it is published in The New York Times. If you live in New York City and would like to join the constructing class, the Fall 2015 catalog can be downloaded here.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Story’s Opening', 'kicker': 'Wordplay', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Crossword Puzzles', 'rank': 1, 'major': 'N'}], 'pub_date': '2015-08-14T02:00:49+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Crosswords & Games', 'byline': {'original': 'By Deb Amlen', 'person': [{'firstname': 'Deb', 'middlename': None, 'lastname': 'Amlen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b33612ab-6334-5113-aaed-c1ff8ded8ce5', 'word_count': 577, 'uri': 'nyt://article/b33612ab-6334-5113-aaed-c1ff8ded8ce5'}, {'abstract': 'James Bradley Miller, the police officer who was fired after the shooting death of a black man during a burglary, was a hairdresser who was searching for a path to success.', 'web_url': 'https://www.nytimes.com/2015/08/14/us/police-officer-james-bradley-miller-christian-taylor-texas-killing.html', 'snippet': 'James Bradley Miller, the police officer who was fired after the shooting death of a black man during a burglary, was a hairdresser who was searching for a path to success.', 'lead_paragraph': 'ARLINGTON, Tex. — Officer James Bradley Miller was not a typical rookie in the Police Department here. At 49, he was six years older than the chief. He discovered law enforcement relatively late in life, after struggling for decades in an array of jobs and careers.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/14/us/14texas-JP-01/14texas-JP-01-articleLarge.jpg', 'height': 833, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/14/us/14texas-JP-01/14texas-JP-01-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 833}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/14/us/14texas-JP-01/14texas-JP-01-jumbo.jpg', 'height': 1024, 'width': 738, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/14/us/14texas-JP-01/14texas-JP-01-superJumbo.jpg', 'height': 1661, 'width': 1196, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/14/us/14texas-JP-01/14texas-JP-01-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/14/us/14texas-JP-01/14texas-JP-01-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/14/us/14texas-JP-01/14texas-JP-01-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Before Texas Killing, Officer Took Unusual Path to Police Work', 'kicker': None, 'content_kicker': None, 'print_headline': 'Before Killing, Unusual Route to Police Work', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Police Brutality, Misconduct and Shootings', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Fernandez, Manny (Per)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Taylor, Christian James (1995-2015)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Miller, Brad (1966- )', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'ARLINGTON (TEX)', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-08-14T02:06:44+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Manny Fernandez and Patrick McGee', 'person': [{'firstname': 'Manny', 'middlename': None, 'lastname': 'Fernandez', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Patrick', 'middlename': None, 'lastname': 'McGee', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b4daa0d1-8854-5bb0-b24d-cd52cd5036f5', 'word_count': 1015, 'uri': 'nyt://article/b4daa0d1-8854-5bb0-b24d-cd52cd5036f5'}, {'abstract': 'A Croatian expatriate worker believed to have been beheaded by the Islamic State’s Egyptian affiliate was initially abducted by a different group that demanded a ransom.', 'web_url': 'https://www.nytimes.com/2015/08/14/world/middleeast/egypt-2-groups-handled-hostage-croatia-says.html', 'snippet': 'A Croatian expatriate worker believed to have been beheaded by the Islamic State’s Egyptian affiliate was initially abducted by a different group that demanded a ransom.', 'lead_paragraph': ' A Croatian expatriate worker believed to have been beheaded by the Islamic State’s Egyptian affiliate was initially abducted by a different group that demanded a ransom, Croatia’s foreign minister said Thursday. The worker, Tomislav Salopek, 30, was kidnapped on July 22 on the outskirts of Cairo, and on Wednesday, the affiliate, Sinai Province, released a picture of what it claimed was Mr. Salopek’s body. Foreign Minister Vesna Pusic said it was “very likely” that “two separate organizations” were involved in Mr. Salopek’s abduction, “one which kidnapped and the other which presented itself as ISIS, Sinai Province.” Sinai Province released a video of Mr. Salopek on Aug. 5, in which he conveyed the militants’ threat to kill him if Muslim women were not released from Egyptian jails. Ms. Pusic said that Egypt and Croatia had not yet been able to confirm Mr. Salopek’s death. ', 'print_section': 'A', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Egypt: 2 Groups Handled Hostage, Croatia Says', 'kicker': 'World Briefing', 'content_kicker': None, 'print_headline': 'Middle East; Egypt: 2 Groups Handled Hostage, Croatia Says', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Croatia', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Sinai Province of the Islamic State', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Salopek, Tomislav (d 2015)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Islamic State in Iraq and Syria (ISIS)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Egypt', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Kidnapping and Hostages', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'International Relations', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Murders, Attempted Murders and Homicides', 'rank': 8, 'major': 'N'}], 'pub_date': '2015-08-14T02:15:11+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Joseph Orovic', 'person': [{'firstname': 'Joseph', 'middlename': None, 'las