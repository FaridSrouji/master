2015/08/08/arts/08PIMMS/08PIMMS-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/08/arts/08PIMMS/08PIMMS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/08/arts/08PIMMS/08PIMMS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/08/arts/08PIMMS/08PIMMS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: In ‘Pimm’s Mission,’ Seeking Clues to a Deadly Blast', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Friendship Holds Clues After a Deadly Explosion', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Boal, Christopher Stetson', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': "O'Brien, Terrence (1953- )", 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Oberon Theater Ensemble', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': '59E59 THEATERS', 'rank': 6, 'major': 'N'}, {'name': 'creative_works', 'value': "Pimm's Mission (Play)", 'rank': 7, 'major': 'N'}], 'pub_date': '2015-08-07T23:04:11+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Theater', 'byline': {'original': 'By Daniel M. Gold', 'person': [{'firstname': 'Daniel', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/d9bf0e3e-427f-5989-a895-e587ec7b06f2', 'word_count': 342, 'uri': 'nyt://article/d9bf0e3e-427f-5989-a895-e587ec7b06f2'}, {'abstract': 'E.P.A. and contractor crews accidentally unleashed lead and arsenic from a Colorado mine into the Animas River.', 'web_url': 'https://www.nytimes.com/2015/08/08/us/colorado-heavy-metals-spill-into-river.html', 'snippet': 'E.P.A. and contractor crews accidentally unleashed lead and arsenic from a Colorado mine into the Animas River.', 'lead_paragraph': 'Environmental officials are working to clean up one million gallons of wastewater containing heavy metals that spilled from an abandoned mine, turning an adjoining river a mustard yellow. The Environmental Protection Agency caused the spill on Wednesday while it was investigating a leak at the Gold King Mine. The wastewater flowed into Cement Creek, a tributary of the Animas River in southwestern Colorado, and snaked through the river toward New Mexico. E.P.A. officials said the wastewater included lead and arsenic, but said it was too early to know whether there was a health risk. The river was closed for recreational and other uses, but officials said water sources should be safe. “The orange color is alarming to people, but that is not an indication in any way of a health risk,” said Joan Card, an official with the E.P.A. Testing continues, she said. ', 'print_section': 'A', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Colorado: Heavy Metals Spill Into River ', 'kicker': 'National Briefing | Rockies', 'content_kicker': None, 'print_headline': 'Colorado: Heavy Metals Spill Into River ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Water Pollution', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mines and Mining', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Colorado', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Hazardous and Toxic Substances', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Environmental Protection Agency', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Animas River (Colo-NM)', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Gold', 'rank': 8, 'major': 'N'}], 'pub_date': '2015-08-07T23:07:36+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Daniel Victor', 'person': [{'firstname': 'Daniel', 'middlename': None, 'lastname': 'Victor', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/1159fc55-5390-553a-8395-51c7e7d5f572', 'word_count': 143, 'uri': 'nyt://article/1159fc55-5390-553a-8395-51c7e7d5f572'}, {'abstract': 'The writers will join Writers Guild of America, East, the union that the websites Gawker and Salon recently chose for their unionization efforts.', 'web_url': 'https://www.nytimes.com/2015/08/08/business/media/vice-media-staff-latest-to-choose-unionizing.html', 'snippet': 'The writers will join Writers Guild of America, East, the union that the websites Gawker and Salon recently chose for their unionization efforts.', 'lead_paragraph': 'Some staff members at Vice Media have voted to unionize, according to two people familiar with the matter, joining other digital media outlets that have recently moved to organize. ', 'print_section': 'B', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/08/business/08VICE/08VICE-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/08/business/08VICE/08VICE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/08/business/08VICE/08VICE-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'su