ame': None, 'lastname': 'Sang-Hun', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/631c54c8-8049-516c-8225-32bee8520a26', 'word_count': 1171, 'uri': 'nyt://article/631c54c8-8049-516c-8225-32bee8520a26'}, {'abstract': 'Baffert said he was disappointed but satisfied with his colt’s gritty performance on Saturday and made it clear that he wanted him to race one last time, in the Breeders’ Cup Classic.', 'web_url': 'https://www.nytimes.com/2015/08/31/sports/after-american-pharoahs-close-loss-bob-baffert-has-plan-for-redemption.html', 'snippet': 'Baffert said he was disappointed but satisfied with his colt’s gritty performance on Saturday and made it clear that he wanted him to race one last time, in the Breeders’ Cup Classic.', 'lead_paragraph': 'SARATOGA SPRINGS, N.Y. — Neither American Pharoah nor his trainer, Bob Baffert, looked worn out or deflated the morning after the colt was run down by Keen Ice in the final strides of the 146th running of the Travers Stakes. The white-haired Baffert smiled as he led his big bay colt outside his barn here, stopping to let a little girl feed him carrots.', 'print_section': 'D', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/31/sports/31DRAPExxx/31DRAPE-1440976976913-articleLarge.jpg', 'height': 416, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/31/sports/31DRAPExxx/31DRAPE-1440976976913-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 416}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/31/sports/31DRAPExxx/31DRAPE-1440976976913-jumbo.jpg', 'height': 710, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None,