nk': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Feigen, Richard L, & Co', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Johnson, Ray (1927-95)', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-08-27T20:27:51+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Ken Johnson', 'person': [{'firstname': 'Ken', 'middlename': None, 'lastname': 'Johnson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/e7dddfa1-0af2-528d-92d4-8f30a0d0b937', 'word_count': 296, 'uri': 'nyt://article/e7dddfa1-0af2-528d-92d4-8f30a0d0b937'}, {'abstract': 'The Brooklyn-based chefs also share the perfect side dish.', 'web_url': 'https://www.nytimes.com/2015/08/27/t-magazine/lobster-boil-ceviche-recipe-max-eli-sussman.html', 'snippet': 'The Brooklyn-based chefs also share the perfect side dish.', 'lead_paragraph': 'Like many true New Yorkers, Eli and Max Sussman of Brooklyn’s Samesa are spending the summer in Montauk, as executive chefs at Ruschmeyer’s restaurant. “Working closely with Hamptons farms and fishermen has been an incredible experience — both the personal, daily relationships and the ability to obtain the freshest products possible,” Eli tells T. “And living this close to the beautiful beaches is a very solid way to spend the summer.” Here, the Sussmans (who are originally from Detroit) demonstrate how to make a lobster boil, Ruschmeyer’s style. And below, they share a recipe for the perfect starter or side dish, a light ceviche that plays on different flavors, “but fits perfectly into the seafood theme of an East Coast boil.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Ruschmeyer’s-Style Lobster Boil, Starring the Sussman Brothers', 'kicker': 'How To', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': Non