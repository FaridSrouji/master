ight': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/30/arts/30NARCOS2/30NARCOS2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/30/arts/30NARCOS2/30NARCOS2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Netflix Looks to ‘Narcos’ for a New Audience', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Drug War, and a Battle for Viewers', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Web-Original Programming', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Netflix Inc', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Moura, Wagner', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Padilha, Jose', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Pascal, Pedro', 'rank': 6, 'major': 'N'}, {'name': 'creative_works', 'value': 'Narcos (TV Program)', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Holbrook, Boyd (1981- )', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 9, 'major': 'N'}], 'pub_date': '2015-08-26T09:00:05+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Jeremy Egner', 'person': [{'firstname': 'Jeremy', 'middlename': None, 'lastname': 'Egner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ae22a377-752b-51ee-864e-ac7bfbc05a40', 'word_count': 1128, 'uri': 'nyt://article/ae22a377-752b-51ee-864e-ac7bfbc05a40'}, {'abstract': 'The novelist Susanna Moore explores the history and culture of Hawaii.', 'web_url': 'https://www.nytimes.com/2015/08/30/books/review/paradise-of-the-pacific-by-susanna-moore.html', 'snippet': 'The novelist Susanna Moore explores the history and culture of Hawaii.', 'lead_paragraph': 'The most peculiar place on this planet, as I see it from my vantage point in Wales, is the 50th state of the American union, the Pacific archipelago called Hawaii. Everything about it is peculiar. Its capital, Honolulu, is one of the remotest big cities on the face of the earth. Its geography is weird, consisting as it does of some 130 assorted islands and atolls, scattered across 1,500 miles of ocean. Its history is spectacularly unexpected, beginning with mass immigrations of Pacific canoeists and culminating in the virtual extinction of an American fleet by several hundred Japanese airplanes. Its indigenous culture is a marvel of intricate legends, faiths, musics and superstitions, and its native written language is a prodigy of alliterations. ', 'print_section': 'BR', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/30/books/review/30MORRIS/30MORRIS-articleLarge-v2.jpg', 'height': 851, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/30/books/review/30MORRIS/30MORRIS-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 851}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/30/books/review/30MORRIS/30MORRIS-jumbo-v2.jpg', 'height': 1024, 'width': 722, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/30/books/review/30MORRIS/30MORRIS-superJumbo-v2.jpg', 'height': 1762, 'width': 1242, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/30/books/review/30MORRIS/30MORRIS-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/30/books/review/30MORRIS/30MORRIS-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/30/books/review/30MORRIS/30MORRIS-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Paradise of the Pacific,’ by Susanna Moore', 'kicker': None, 'content_kicker': None, 'print_headline': 'From Tropical Kingdom to 50th State', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Moore, Susanna', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Hawaii', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': "Paradise of the Pacific: Approaching Hawai'i (Book)", 'rank': 4, 'major': 'N'}], 'pub_date': '2015-08-26T09:00:05+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Jan Morris', 'person': [{'firstname': 'Jan', 'middlename': None, 'lastname': 'Morris', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/c5272942-44b4-5533-90c5-264728dbc381', 'word_count': 937, 'uri': 'nyt://article/c5272942-44b4-5533-90c5-264728dbc381'}, {'abstract': 'In the fourth and final installment of Elena Ferrante’s Neapolitan series, we have arrived at the 21st century and Elena, its narrator, is growing old.', 'web_url': 'https://www.nytimes.com/2015/08/30/books/review/the-story-of-the-lost-child-by-elena-ferrante.html', 'snippet': 'In the fourth and final installment of Elena Ferrante’s Neapolitan series, we have arrived at the 21st century and Elena, its narrator, is growing old.', 'lead_paragraph': 'Elena Ferrante has written her story twice: once in a group of intense, highly modeled short novels whose action unfolds over a brief time span; and again in the four sprawling, rambunctious, decades-spanning works that compose her Neapolitan saga. That these two modes of storytelling — the compact and the commodious; the modern and the historical; the distilling of life into metaphor and its picaresque, riotous expansion — are so obviously the obverse of each other constitutes yet another narrative, the story of how an individual (more specifically, a woman) arrives, after the \xadvicissitudes of living, at a definition of self. “Do you want the long answer or the short?” is the customary divide between explanations versus outcomes in the retelling of events. Ferrante gives us both the long answer and the short, and in doing so adumbrates the mysterious beauty and brutality of personal experience.', 'print_section': 'BR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/30/books/review/0830-BKS-Cusk/0830-BKS-Cusk-articleLarge.jpg', 'height': 366, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/30/books/review/0830-BKS-Cusk/0830-BKS-Cusk-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 366}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/30/books/review/0830-BKS-Cusk/0830-BKS-Cusk-jumbo.jpg', 'height': 624, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/30/books/review/0830-BKS-Cusk/0830-BKS-Cusk-superJumbo.jpg', 'height': 1248, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo