_of_material': 'News', '_id': 'nyt://article/6e75fc4f-6ede-5088-9c40-7d3a8632e806', 'word_count': 259, 'uri': 'nyt://article/6e75fc4f-6ede-5088-9c40-7d3a8632e806'}, {'abstract': 'Quotation of the Day for Wednesday, August 5, 2015.', 'web_url': 'https://www.nytimes.com/2015/08/05/pageoneplus/quotation-of-the-day-for-wednesday-august-5-2015.html', 'snippet': 'Quotation of the Day for Wednesday, August 5, 2015.', 'lead_paragraph': '“It seems she’ll stay in the sea. I think she would like that.”', 'print_section': 'A', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Quotation of the Day for Wednesday, August 5, 2015', 'kicker': None, 'content_kicker': None, 'print_headline': 'Quotation of The Day ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-08-05T04:35:41+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Quote', '_id': 'nyt://article/1b63fd95-b067-58f2-992b-f4cb02f1d819', 'word_count': 41, 'uri': 'nyt://article/1b63fd95-b067-58f2-992b-f4cb02f1d819'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2015/08/05/arts/television/whats-on-tv-wednesday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '3:40 P.M. (HBO Signature) FOUR WEDDINGS AND A FUNERAL (1994) Hugh Grant portrays an Englishman with a fear of commitment who happens to be a favored best man among the marrying kind of his circle in this comedy, directed by Mike Newell and written by Richard Curtis. Andie MacDowell is the American beauty who just may change his mind — if only his friends (played by Kristin Scott Thomas, Simon Callow, James Fleet, John Hannah and Charlotte Coleman, among others) would stop getting in his way. Writing in The New York Times, Janet Maslin compared this “multitiered confection with a romantic spirit and an enchantingly pretty veneer” to a wedding cake, adding that it was “elegant, festive and very, very funny.”', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s on TV Wednesday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What&#8217;s On TV Wednesday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}], 'pub_date': '2015-08-05T05:00:04+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/47b12f0e-0de4-5a84-a706-fc27c6ad7e82', 'word_count': 720, 'uri': 'nyt://article/47b12f0e-0de4-5a84-a706-fc27c6ad7e82'}, {'abstract': 'Corrections appearing in print on August 5, 2015.', 'web_url': 'https://www.nytimes.com/2015/08/05/pageoneplus/corrections-august-5-2015.html', 'snippet': 'Corrections appearing in print on August 5, 2015.', 'lead_paragraph': 'FRONT PAGE', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Corrections: August 5, 2015', 'kicker': None, 'content_kicker': None, 'print_headline': 'Corrections', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-08-05T05:27:37+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Correction', '_id': 'nyt://article/e107685a-20ff-5547-b016-3cb5cf459d10', 'word_count': 624, 'uri': 'nyt://article/e107685a-20ff-5547-b016-3cb5cf459d10'}, {'abstract': 'The French bank said its quarterly results were bolstered by gains in its equity trading and its merger and acquisition advisory businesses.', 'web_url': 'http