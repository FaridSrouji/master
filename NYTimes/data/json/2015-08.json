, wet.”)', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/22/arts/22PERICLES1/22PERICLES1-articleLarge.jpg', 'height': 405, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/22/arts/22PERICLES1/22PERICLES1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 405}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/22/arts/22PERICLES1/22PERICLES1-jumbo.jpg', 'height': 692, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/22/arts/22PERICLES1/22PERICLES1-superJumbo.jpg', 'height': 1325, 'width': 1961, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/22/arts/22PERICLES1/22PERICLES1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/22/arts/22PERICLES1/22PERICLES1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/22/arts/22PERICLES1/22PERICLES1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: ‘Pericles,’ Lashed by Sorrows, at the Oregon Shakespeare Festival', 'kicker': None, 'content_kicker': None, 'print_headline': ' Lashed by Fate, the Storm-Tossed Prince', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Oregon Shakespeare Festival', 'rank': 3, 'major': 'N'}